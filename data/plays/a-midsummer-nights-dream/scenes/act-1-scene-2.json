      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nIt is the lady that Pyramus must love.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19330/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
