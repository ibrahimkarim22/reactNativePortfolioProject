          "start": 7,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4245474,
        "end": 4245570,
        "line": 157194,
        "column": 1,
        "path": "chap24/p@19410",
        "anchor": "sceneI_24.2"
      },
      "speakerLabel": "FLUTE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@19510",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nThat’s all one. You shall play it in a mask, and you may speak as small as you will.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19510/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19510/line-2",
          "start": 8,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4245574,
        "end": 4245697,
        "line": 157199,
        "column": 1,
        "path": "chap24/p@19510",
        "anchor": "sceneI_24.2"
      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@19637",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOTTOM.\nAnd I may hide my face, let me play Thisbe too. I’ll speak in a monstrous little voice; ‘Thisne, Thisne!’—‘Ah, Pyramus, my lover dear! thy Thisbe dear! and lady dear!’",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19637/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19637/line-2",
          "start": 8,
          "end": 175,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4245701,
        "end": 4245908,
        "line": 157205,
        "column": 1,
        "path": "chap24/p@19637",
        "anchor": "sceneI_24.2"
      },
      "speakerLabel": "BOTTOM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@19848",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nNo, no, you must play Pyramus; and, Flute, you Thisbe.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19848/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19848/line-2",
          "start": 8,
          "end": 62,
          "sourceLineNumber": null
