        "anchor": "sceneI_24.2"
      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@19944",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOTTOM.\nWell, proceed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19944/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
