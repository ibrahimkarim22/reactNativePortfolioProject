      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nRobin Starveling, the tailor.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@20000/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
