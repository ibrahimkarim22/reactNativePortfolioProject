          "start": 8,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4245394,
        "end": 4245470,
        "line": 157189,
        "column": 1,
        "path": "chap24/p@19330",
        "anchor": "sceneI_24.2"
      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@19410",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLUTE.\nNay, faith, let not me play a woman. I have a beard coming.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19410/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
