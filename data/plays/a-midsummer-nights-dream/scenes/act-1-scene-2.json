    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@19041",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nFrancis Flute, the bellows-mender.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19041/line-1",
