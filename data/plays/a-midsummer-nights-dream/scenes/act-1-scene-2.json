          "start": 8,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4246064,
        "end": 4246131,
        "line": 157222,
        "column": 1,
        "path": "chap24/p@20000",
        "anchor": "sceneI_24.2"
      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@20071",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "STARVELING.\nHere, Peter Quince.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@20071/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@20071/line-2",
          "start": 12,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4246135,
        "end": 4246196,
        "line": 157227,
        "column": 1,
        "path": "chap24/p@20071",
        "anchor": "sceneI_24.2"
      },
      "speakerLabel": "STARVELING.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@20136",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nRobin Starveling, you must play Thisbe’s mother.\nTom Snout, the tinker.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@20136/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@20136/line-2",
          "start": 8,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@20136/line-3",
          "start": 57,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
