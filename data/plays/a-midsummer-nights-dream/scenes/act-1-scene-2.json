      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@19117",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLUTE.\nHere, Peter Quince.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19117/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19117/line-2",
          "start": 7,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4245181,
        "end": 4245237,
        "line": 157174,
        "column": 1,
        "path": "chap24/p@19117",
        "anchor": "sceneI_24.2"
      },
      "speakerLabel": "FLUTE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@19177",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nFlute, you must take Thisbe on you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19177/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneI_24.2/p@19177/line-2",
          "start": 8,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4245241,
        "end": 4245314,
        "line": 157179,
        "column": 1,
        "path": "chap24/p@19177",
        "anchor": "sceneI_24.2"
      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneI_24.2/p@19254",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLUTE.\nWhat is Thisbe? A wandering knight?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
