    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@100766",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Quince, Flute, Snout and Starveling.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 26,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 31,
          "end": 41,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@100766/line-1",
          "start": 0,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4326830,
        "end": 4326958,
        "line": 160046,
        "column": 1,
        "path": "chap24/p@100766",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@100898",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nHave you sent to Bottom’s house? Is he come home yet?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@100898/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@100898/line-2",
          "start": 8,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4326962,
        "end": 4327053,
        "line": 160049,
        "column": 1,
        "path": "chap24/p@100898",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@100993",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "STARVELING.\nHe cannot be heard of. Out of doubt he is transported.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@100993/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@100993/line-2",
          "start": 12,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4327057,
        "end": 4327153,
        "line": 160054,
        "column": 1,
        "path": "chap24/p@100993",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "STARVELING.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101093",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLUTE.\nIf he come not, then the play is marred. It goes not forward, doth it?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101093/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101093/line-2",
          "start": 7,
          "end": 77,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4327157,
        "end": 4327264,
        "line": 160059,
        "column": 1,
        "path": "chap24/p@101093",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "FLUTE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101204",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nIt is not possible. You have not a man in all Athens able to discharge Pyramus but he.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101204/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101204/line-2",
          "start": 8,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4327268,
        "end": 4327393,
        "line": 160064,
        "column": 1,
        "path": "chap24/p@101204",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101333",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLUTE.\nNo, he hath simply the best wit of any handicraft man in Athens.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101333/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101333/line-2",
          "start": 7,
          "end": 71,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4327397,
        "end": 4327498,
        "line": 160070,
        "column": 1,
        "path": "chap24/p@101333",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "FLUTE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101438",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nYea, and the best person too, and he is a very paramour for a sweet voice.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101438/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101438/line-2",
          "start": 8,
          "end": 82,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101438/line-3",
          "start": 83,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4327502,
        "end": 4327620,
        "line": 160075,
        "column": 1,
        "path": "chap24/p@101438",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101560",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLUTE.\nYou must say paragon. A paramour is, God bless us, a thing of naught.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101560/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101560/line-2",
          "start": 7,
          "end": 76,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4327624,
        "end": 4327730,
        "line": 160081,
        "column": 1,
        "path": "chap24/p@101560",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "FLUTE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101670",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Snug.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 10,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101670/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4327734,
        "end": 4327800,
        "line": 160086,
        "column": 1,
        "path": "chap24/p@101670",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101740",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SNUG\nMasters, the Duke is coming from the temple, and there is two or three lords and ladies more married. If our sport had gone forward, we had all been made men.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101740/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101740/line-2",
          "start": 5,
          "end": 163,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4327804,
        "end": 4327999,
        "line": 160088,
        "column": 1,
        "path": "chap24/p@101740",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "SNUG",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101939",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLUTE.\nO sweet bully Bottom! Thus hath he lost sixpence a day during his life; he could not have ’scaped sixpence a day. An the Duke had not given him sixpence a day for playing Pyramus, I’ll be hanged. He would have deserved it: sixpence a day in Pyramus, or nothing.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101939/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@101939/line-2",
          "start": 7,
          "end": 268,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4328003,
        "end": 4328304,
        "line": 160095,
        "column": 1,
        "path": "chap24/p@101939",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "FLUTE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102244",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Bottom.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 12,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102244/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4328308,
        "end": 4328376,
        "line": 160103,
        "column": 1,
        "path": "chap24/p@102244",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102316",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOTTOM.\nWhere are these lads? Where are these hearts?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102316/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102316/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4328380,
        "end": 4328463,
        "line": 160105,
        "column": 1,
        "path": "chap24/p@102316",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "BOTTOM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102403",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nBottom! O most courageous day! O most happy hour!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102403/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102403/line-2",
          "start": 8,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4328467,
        "end": 4328554,
        "line": 160110,
        "column": 1,
        "path": "chap24/p@102403",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102494",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOTTOM.\nMasters, I am to discourse wonders: but ask me not what; for if I tell you, I am not true Athenian. I will tell you everything, right as it fell out.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102494/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102494/line-2",
          "start": 8,
          "end": 157,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4328558,
        "end": 4328746,
        "line": 160115,
        "column": 1,
        "path": "chap24/p@102494",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "BOTTOM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102686",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUINCE.\nLet us hear, sweet Bottom.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102686/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102686/line-2",
          "start": 8,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4328750,
        "end": 4328814,
        "line": 160121,
        "column": 1,
        "path": "chap24/p@102686",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "QUINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102754",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOTTOM.\nNot a word of me. All that I will tell you is, that the Duke hath dined. Get your apparel together, good strings to your beards, new ribbons to your pumps; meet presently at the palace; every man look o’er his part. For the short and the long is, our play is preferred. In any case, let Thisbe have clean linen; and let not him that plays the lion pare his nails, for they shall hang out for the lion’s claws. And most dear actors, eat no onions nor garlick, for we are to utter sweet breath; and I do not doubt but to hear them say it is a sweet comedy. No more words. Away! Go, away!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102754/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "a-midsummer-nights-dream/sceneIV_24.2/p@102754/line-2",
          "start": 8,
          "end": 593,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4328818,
        "end": 4329448,
        "line": 160126,
        "column": 1,
        "path": "chap24/p@102754",
        "anchor": "sceneIV_24.2"
      },
      "speakerLabel": "BOTTOM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "a-midsummer-nights-dream/sceneIV_24.2/p@103388",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 8
        }
      ],
      "lines": [
