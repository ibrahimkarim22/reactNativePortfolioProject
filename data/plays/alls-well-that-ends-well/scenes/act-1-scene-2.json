    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@21939",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nIf he were living, I would try him yet;—\nLend me an arm;—the rest have worn me out\nWith several applications; nature and sickness\nDebate it at their leisure. Welcome, Count;\nMy son’s no dearer.",
      "separatorAfter": "\n\n",
      "spans": [],
