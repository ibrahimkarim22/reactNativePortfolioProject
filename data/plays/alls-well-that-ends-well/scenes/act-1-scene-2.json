    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@17753",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nThe Florentines and Senoys are by th’ ears;\nHave fought with equal fortune, and continue\nA braving war.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17753/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17753/line-2",
          "start": 6,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17753/line-3",
          "start": 50,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17753/line-4",
          "start": 95,
          "end": 109,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 142868,
        "end": 143017,
        "line": 3705,
        "column": 1,
        "path": "chap02/p@17753",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": "KING.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@17906",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nSo ’tis reported, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17906/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17906/line-2",
          "start": 12,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 143021,
        "end": 143085,
        "line": 3712,
        "column": 1,
        "path": "chap02/p@17906",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@17974",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nNay, ’tis most credible, we here receive it,\nA certainty, vouch’d from our cousin Austria,\nWith caution, that the Florentine will move us\nFor speedy aid; wherein our dearest friend\nPrejudicates the business, and would seem\nTo have us make denial.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17974/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17974/line-2",
          "start": 6,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17974/line-3",
          "start": 51,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17974/line-4",
          "start": 97,
          "end": 143,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17974/line-5",
          "start": 144,
          "end": 186,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17974/line-6",
          "start": 187,
          "end": 228,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@17974/line-7",
          "start": 229,
          "end": 252,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 143089,
        "end": 143396,
        "line": 3717,
        "column": 1,
        "path": "chap02/p@17974",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": "KING.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@18285",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nHis love and wisdom,\nApprov’d so to your majesty, may plead\nFor amplest credence.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18285/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18285/line-2",
          "start": 12,
          "end": 32,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18285/line-3",
          "start": 33,
          "end": 71,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18285/line-4",
          "start": 72,
          "end": 93,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 143400,
        "end": 143533,
        "line": 3727,
        "column": 1,
        "path": "chap02/p@18285",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@18422",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nHe hath arm’d our answer,\nAnd Florence is denied before he comes:\nYet, for our gentlemen that mean to see\nThe Tuscan service, freely have they leave\nTo stand on either part.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18422/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18422/line-2",
          "start": 6,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18422/line-3",
          "start": 32,
          "end": 71,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18422/line-4",
          "start": 72,
          "end": 111,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18422/line-5",
          "start": 112,
          "end": 154,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18422/line-6",
          "start": 155,
          "end": 179,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 143537,
        "end": 143766,
        "line": 3734,
        "column": 1,
        "path": "chap02/p@18422",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": "KING.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@18655",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nIt well may serve\nA nursery to our gentry, who are sick\nFor breathing and exploit.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18655/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18655/line-2",
          "start": 13,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18655/line-3",
          "start": 31,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18655/line-4",
          "start": 69,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 143770,
        "end": 143905,
        "line": 3743,
        "column": 1,
        "path": "chap02/p@18655",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
