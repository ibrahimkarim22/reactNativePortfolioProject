    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@20602",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nHis good remembrance, sir,\nLies richer in your thoughts than on his tomb;\nSo in approof lives not his epitaph\nAs in your royal speech.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@20602/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
