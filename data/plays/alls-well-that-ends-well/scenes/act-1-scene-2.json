      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nI fill a place, I know’t. How long is’t, Count,\nSince the physician at your father’s died?\nHe was much fam’d.",
      "separatorAfter": "\n\n",
      "spans": [],
