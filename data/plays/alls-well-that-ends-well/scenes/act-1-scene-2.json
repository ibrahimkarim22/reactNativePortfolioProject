    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@18794",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nWhat’s he comes here?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18794/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18794/line-2",
          "start": 6,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 143909,
        "end": 143966,
        "line": 3750,
        "column": 1,
        "path": "chap02/p@18794",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": "KING.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@18855",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Bertram, Lafew and Parolles.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 20,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 25,
          "end": 33,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18855/line-1",
          "start": 0,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 143970,
        "end": 144093,
        "line": 3755,
        "column": 1,
        "path": "chap02/p@18855",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@18982",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nIt is the Count Rossillon, my good lord,\nYoung Bertram.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18982/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18982/line-2",
          "start": 12,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@18982/line-3",
          "start": 53,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 144097,
        "end": 144199,
        "line": 3759,
        "column": 1,
        "path": "chap02/p@18982",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@19088",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nYouth, thou bear’st thy father’s face;\nFrank nature, rather curious than in haste,\nHath well compos’d thee. Thy father’s moral parts\nMayst thou inherit too! Welcome to Paris.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@19088/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@19088/line-2",
          "start": 6,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@19088/line-3",
          "start": 45,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@19088/line-4",
          "start": 89,
          "end": 138,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@19088/line-5",
          "start": 139,
          "end": 180,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 144203,
        "end": 144428,
        "line": 3765,
        "column": 1,
        "path": "chap02/p@19088",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": "KING.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@19317",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nMy thanks and duty are your majesty’s.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@19317/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@19317/line-2",
          "start": 9,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 144432,
        "end": 144509,
        "line": 3773,
        "column": 1,
        "path": "chap02/p@19317",
        "anchor": "sceneI_2.2"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneI_2.2/p@19398",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nI would I had that corporal soundness now,\nAs when thy father and myself in friendship\nFirst tried our soldiership. He did look far\nInto the service of the time, and was\nDiscipled of the bravest. He lasted long,\nBut on us both did haggish age steal on,\nAnd wore us out of act. It much repairs me\nTo talk of your good father; in his youth\nHe had the wit which I can well observe\nToday in our young lords; but they may jest\nTill their own scorn return to them unnoted\nEre they can hide their levity in honour\nSo like a courtier, contempt nor bitterness\nWere in his pride or sharpness; if they were,\nHis equal had awak’d them, and his honour,\nClock to itself, knew the true minute when\nException bid him speak, and at this time\nHis tongue obey’d his hand. Who were below him\nHe us’d as creatures of another place,\nAnd bow’d his eminent top to their low ranks,\nMaking them proud of his humility,\nIn their poor praise he humbled. Such a man\nMight be a copy to these younger times;\nWhich, followed well, would demonstrate them now\nBut goers backward.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneI_2.2/p@19398/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
