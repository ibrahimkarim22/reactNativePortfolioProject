    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@50301",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Countess and Clown.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 19,
          "end": 24,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@50301/line-1",
          "start": 0,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 175416,
        "end": 175530,
        "line": 4903,
        "column": 1,
        "path": "chap02/p@50301",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@50419",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nCome on, sir; I shall now put you to the height of your breeding.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@50419/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@50419/line-2",
          "start": 10,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 175534,
        "end": 175639,
        "line": 4907,
        "column": 1,
        "path": "chap02/p@50419",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@50528",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nI will show myself highly fed and lowly taught. I know my business is but to the court.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@50528/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@50528/line-2",
          "start": 7,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 175643,
        "end": 175768,
        "line": 4912,
        "column": 1,
        "path": "chap02/p@50528",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@50657",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nTo the court! Why, what place make you special, when you put off that with such contempt? But to the court!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@50657/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@50657/line-2",
          "start": 10,
          "end": 117,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 175772,
        "end": 175920,
        "line": 4918,
        "column": 1,
        "path": "chap02/p@50657",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@50809",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nTruly, madam, if God have lent a man any manners, he may easily put it off at court: he that cannot make a leg, put off’s cap, kiss his hand, and say nothing, has neither leg, hands, lip, nor cap; and indeed such a fellow, to say precisely, were not for the court; but for me, I have an answer will serve all men.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@50809/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@50809/line-2",
          "start": 7,
          "end": 320,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 175924,
        "end": 176278,
        "line": 4924,
        "column": 1,
        "path": "chap02/p@50809",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@51167",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nMarry, that’s a bountiful answer that fits all questions.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@51167/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@51167/line-2",
          "start": 10,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 176282,
        "end": 176379,
        "line": 4933,
        "column": 1,
        "path": "chap02/p@51167",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@51268",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nIt is like a barber’s chair, that fits all buttocks—the pin-buttock, the quatch-buttock, the brawn-buttock, or any buttock.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@51268/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@51268/line-2",
          "start": 7,
          "end": 130,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 176383,
        "end": 176544,
        "line": 4938,
        "column": 1,
        "path": "chap02/p@51268",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@51433",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nWill your answer serve fit to all questions?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@51433/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@51433/line-2",
          "start": 10,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 176548,
        "end": 176632,
        "line": 4944,
        "column": 1,
        "path": "chap02/p@51433",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@51521",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nAs fit as ten groats is for the hand of an attorney, as your French crown for your taffety punk, as Tib’s rush for Tom’s forefinger, as a pancake for Shrove-Tuesday, a morris for May-day, as the nail to his hole, the cuckold to his horn, as a scolding quean to a wrangling knave, as the nun’s lip to the friar’s mouth; nay, as the pudding to his skin.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@51521/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@51521/line-2",
          "start": 7,
          "end": 358,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 176636,
        "end": 177028,
        "line": 4949,
        "column": 1,
        "path": "chap02/p@51521",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@51917",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nHave you, I say, an answer of such fitness for all questions?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@51917/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@51917/line-2",
          "start": 10,
          "end": 71,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 177032,
        "end": 177133,
        "line": 4958,
        "column": 1,
        "path": "chap02/p@51917",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@52022",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nFrom below your duke to beneath your constable, it will fit any question.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52022/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52022/line-2",
          "start": 7,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 177137,
        "end": 177247,
        "line": 4963,
        "column": 1,
        "path": "chap02/p@52022",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@52136",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nIt must be an answer of most monstrous size that must fit all demands.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52136/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52136/line-2",
          "start": 10,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 177251,
        "end": 177361,
        "line": 4968,
        "column": 1,
        "path": "chap02/p@52136",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@52250",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nBut a trifle neither, in good faith, if the learned should speak truth of it. Here it is, and all that belongs to’t. Ask me if I am a courtier; it shall do you no harm to learn.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52250/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52250/line-2",
          "start": 7,
          "end": 184,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 177365,
        "end": 177581,
        "line": 4973,
        "column": 1,
        "path": "chap02/p@52250",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@52470",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nTo be young again, if we could: I will be a fool in question, hoping to be the wiser by your answer. I pray you, sir, are you a courtier?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52470/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52470/line-2",
          "start": 10,
          "end": 147,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 177585,
        "end": 177763,
        "line": 4980,
        "column": 1,
        "path": "chap02/p@52470",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@52652",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nO Lord, sir! There’s a simple putting off. More, more, a hundred of them.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52652/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52652/line-2",
          "start": 7,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 177767,
        "end": 177877,
        "line": 4986,
        "column": 1,
        "path": "chap02/p@52652",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@52766",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nSir, I am a poor friend of yours, that loves you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52766/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52766/line-2",
          "start": 10,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 177881,
        "end": 177970,
        "line": 4991,
        "column": 1,
        "path": "chap02/p@52766",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@52859",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nO Lord, sir! Thick, thick; spare not me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52859/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52859/line-2",
          "start": 7,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 177974,
        "end": 178051,
        "line": 4996,
        "column": 1,
        "path": "chap02/p@52859",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@52940",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nI think, sir, you can eat none of this homely meat.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52940/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@52940/line-2",
          "start": 10,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 178055,
        "end": 178146,
        "line": 5001,
        "column": 1,
        "path": "chap02/p@52940",
        "anchor": "sceneII_2.2"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.2/p@53035",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nO Lord, sir! Nay, put me to’t, I warrant you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@53035/line-1",
