      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nO Lord, sir! Spare not me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.2/p@53206/line-1",
