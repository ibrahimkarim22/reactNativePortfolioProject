      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 12,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 17,
          "end": 22,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73081/line-1",
          "start": 0,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 198196,
        "end": 198308,
        "line": 5836,
        "column": 1,
        "path": "chap02/p@73081",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@73197",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nMy mother greets me kindly: is she well?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73197/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73197/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 198312,
        "end": 198390,
        "line": 5840,
        "column": 1,
        "path": "chap02/p@73197",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "HELENA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@73279",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nShe is not well, but yet she has her health; she’s very merry, but yet she is not well. But thanks be given, she’s very well, and wants nothing i’ the world; but yet she is not well.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73279/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73279/line-2",
          "start": 7,
          "end": 189,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 198394,
        "end": 198615,
        "line": 5845,
        "column": 1,
        "path": "chap02/p@73279",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@73504",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nIf she be very well, what does she ail that she’s not very well?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73504/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73504/line-2",
          "start": 8,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 198619,
        "end": 198721,
        "line": 5852,
        "column": 1,
        "path": "chap02/p@73504",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "HELENA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@73610",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nTruly, she’s very well indeed, but for two things.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73610/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73610/line-2",
          "start": 7,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 198725,
        "end": 198812,
        "line": 5857,
        "column": 1,
        "path": "chap02/p@73610",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@73701",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nWhat two things?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73701/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73701/line-2",
          "start": 8,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 198816,
        "end": 198870,
        "line": 5862,
        "column": 1,
        "path": "chap02/p@73701",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "HELENA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@73759",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nOne, that she’s not in heaven, whither God send her quickly! The other, that she’s in earth, from whence God send her quickly!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73759/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73759/line-2",
          "start": 7,
          "end": 133,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 198874,
        "end": 199038,
        "line": 5867,
        "column": 1,
        "path": "chap02/p@73759",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@73927",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Parolles.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@73927/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 199042,
        "end": 199116,
        "line": 5873,
        "column": 1,
        "path": "chap02/p@73927",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@74005",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nBless you, my fortunate lady!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74005/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74005/line-2",
          "start": 10,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 199120,
        "end": 199189,
        "line": 5877,
        "column": 1,
        "path": "chap02/p@74005",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@74078",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nI hope, sir, I have your good will to have mine own good fortune.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74078/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74078/line-2",
          "start": 8,
          "end": 73,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 199193,
        "end": 199296,
        "line": 5882,
        "column": 1,
        "path": "chap02/p@74078",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "HELENA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@74185",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nYou had my prayers to lead them on; and to keep them on, have them still. O, my knave how does my old lady?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74185/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74185/line-2",
          "start": 10,
          "end": 117,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 199300,
        "end": 199448,
        "line": 5887,
        "column": 1,
        "path": "chap02/p@74185",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@74337",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nSo that you had her wrinkles and I her money, I would she did as you say.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74337/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74337/line-2",
          "start": 7,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 199452,
        "end": 199562,
        "line": 5893,
        "column": 1,
        "path": "chap02/p@74337",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@74451",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nWhy, I say nothing.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74451/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74451/line-2",
          "start": 10,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 199566,
        "end": 199625,
        "line": 5898,
        "column": 1,
        "path": "chap02/p@74451",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@74514",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nMarry, you are the wiser man; for many a man’s tongue shakes out his master’s undoing. To say nothing, to do nothing, to know nothing, and to have nothing, is to be a great part of your title; which is within a very little of nothing.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74514/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74514/line-2",
          "start": 7,
          "end": 241,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 199629,
        "end": 199902,
        "line": 5903,
        "column": 1,
        "path": "chap02/p@74514",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@74791",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nAway! Thou art a knave.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74791/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74791/line-2",
          "start": 10,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 199906,
        "end": 199969,
        "line": 5910,
        "column": 1,
        "path": "chap02/p@74791",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@74858",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nYou should have said, sir, before a knave thou art a knave; that is before me thou art a knave. This had been truth, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74858/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@74858/line-2",
          "start": 7,
          "end": 128,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 199973,
        "end": 200132,
        "line": 5915,
        "column": 1,
        "path": "chap02/p@74858",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@75021",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nGo to, thou art a witty fool; I have found thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@75021/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@75021/line-2",
          "start": 10,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 200136,
        "end": 200224,
        "line": 5921,
        "column": 1,
        "path": "chap02/p@75021",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@75113",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nDid you find me in yourself, sir? or were you taught to find me? The search, sir, was profitable; and much fool may you find in you, even to the world’s pleasure and the increase of laughter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@75113/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneII_2.4/p@75113/line-2",
          "start": 7,
          "end": 198,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 200228,
        "end": 200458,
        "line": 5926,
        "column": 1,
        "path": "chap02/p@75113",
        "anchor": "sceneII_2.4"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneII_2.4/p@75347",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nA good knave, i’ faith, and well fed.\nMadam, my lord will go away tonight;\nA very serious business calls on him.\nThe great prerogative and right of love,\nWhich, as your due, time claims, he does acknowledge;\nBut puts it off to a compell’d restraint;\nWhose want, and whose delay, is strew’d with sweets;\nWhich they distil now in the curbed time,\nTo make the coming hour o’erflow with joy\nAnd pleasure drown the brim.",
      "separatorAfter": "\n\n",
      "spans": [],
