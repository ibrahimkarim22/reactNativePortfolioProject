      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nThat, having this obtain’d, you presently\nAttend his further pleasure.",
      "separatorAfter": "\n\n",
      "spans": [],
