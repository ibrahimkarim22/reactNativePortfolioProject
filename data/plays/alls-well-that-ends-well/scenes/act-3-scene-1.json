      "id": "alls-well-that-ends-well/sceneIII_2.1/p@83008",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Flourish. Enter the Duke of Florence attended; two French Lords, and Soldiers.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 20,
          "end": 36,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83008/line-1",
          "start": 0,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 208123,
        "end": 208261,
        "line": 6283,
        "column": 1,
