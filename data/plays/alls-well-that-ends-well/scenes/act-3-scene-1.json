      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.1/p@83150",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nSo that, from point to point, now have you heard\nThe fundamental reasons of this war,\nWhose great decision hath much blood let forth,\nAnd more thirsts after.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83150/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
