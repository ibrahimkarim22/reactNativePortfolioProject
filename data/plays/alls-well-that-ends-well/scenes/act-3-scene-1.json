    {
      "id": "alls-well-that-ends-well/sceneIII_2.1/p@84028",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nBe it his pleasure.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@84028/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@84028/line-2",
          "start": 6,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 209143,
        "end": 209198,
        "line": 6322,
        "column": 1,
        "path": "chap02/p@84028",
        "anchor": "sceneIII_2.1"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.1/p@84087",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nBut I am sure the younger of our nature,\nThat surfeit on their ease, will day by day\nCome here for physic.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@84087/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@84087/line-2",
          "start": 12,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@84087/line-3",
          "start": 53,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@84087/line-4",
          "start": 97,
          "end": 118,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 209202,
        "end": 209360,
        "line": 6327,
        "column": 1,
        "path": "chap02/p@84087",
        "anchor": "sceneIII_2.1"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.1/p@84249",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nWelcome shall they be;\nAnd all the honours that can fly from us\nShall on them settle. You know your places well;\nWhen better fall, for your avails they fell.\nTomorrow to the field.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@84249/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@84249/line-2",
          "start": 6,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@84249/line-3",
          "start": 29,
          "end": 69,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@84249/line-4",
          "start": 70,
          "end": 118,
          "sourceLineNumber": null
        },
        {
