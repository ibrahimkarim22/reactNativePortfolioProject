          "start": 6,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83150/line-3",
          "start": 55,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83150/line-4",
          "start": 92,
          "end": 139,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83150/line-5",
          "start": 140,
          "end": 163,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 208265,
        "end": 208473,
        "line": 6288,
        "column": 1,
        "path": "chap02/p@83150",
        "anchor": "sceneIII_2.1"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.1/p@83362",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nHoly seems the quarrel\nUpon your Grace’s part; black and fearful\nOn the opposer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83362/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83362/line-2",
          "start": 12,
          "end": 34,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83362/line-3",
          "start": 35,
          "end": 76,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83362/line-4",
          "start": 77,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 208477,
        "end": 208609,
        "line": 6296,
        "column": 1,
        "path": "chap02/p@83362",
        "anchor": "sceneIII_2.1"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.1/p@83498",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nTherefore we marvel much our cousin France\nWould, in so just a business, shut his bosom\nAgainst our borrowing prayers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83498/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83498/line-2",
          "start": 6,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83498/line-3",
          "start": 49,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83498/line-4",
          "start": 94,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 208613,
        "end": 208777,
        "line": 6303,
        "column": 1,
        "path": "chap02/p@83498",
        "anchor": "sceneIII_2.1"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.1/p@83666",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nGood my lord,\nThe reasons of our state I cannot yield,\nBut like a common and an outward man\nThat the great figure of a council frames\nBy self-unable motion; therefore dare not\nSay what I think of it, since I have found\nMyself in my incertain grounds to fail\nAs often as I guess’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83666/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.1/p@83666/line-2",
          "start": 13,
          "end": 26,
          "sourceLineNumber": null
        },
        {
