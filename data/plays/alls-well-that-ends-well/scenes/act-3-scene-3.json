    {
      "id": "alls-well-that-ends-well/sceneIII_2.3/p@93166",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nThe general of our horse thou art, and we,\nGreat in our hope, lay our best love and credence\nUpon thy promising fortune.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93166/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93166/line-2",
          "start": 6,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93166/line-3",
          "start": 49,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93166/line-4",
          "start": 99,
          "end": 126,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 218281,
        "end": 218447,
        "line": 6686,
        "column": 1,
        "path": "chap02/p@93166",
        "anchor": "sceneIII_2.3"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.3/p@93336",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nSir, it is\nA charge too heavy for my strength; but yet\nWe’ll strive to bear it for your worthy sake\nTo th’extreme edge of hazard.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93336/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93336/line-2",
          "start": 9,
          "end": 19,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93336/line-3",
          "start": 20,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93336/line-4",
          "start": 64,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93336/line-5",
          "start": 109,
          "end": 138,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 218451,
        "end": 218634,
        "line": 6693,
        "column": 1,
        "path": "chap02/p@93336",
