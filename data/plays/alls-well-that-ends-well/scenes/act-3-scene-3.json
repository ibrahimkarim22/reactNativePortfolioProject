          "start": 26,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93523/line-4",
          "start": 69,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 218638,
        "end": 218774,
        "line": 6701,
        "column": 1,
        "path": "chap02/p@93523",
        "anchor": "sceneIII_2.3"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
