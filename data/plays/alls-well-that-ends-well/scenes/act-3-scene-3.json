      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.3/p@93663",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nThis very day,\nGreat Mars, I put myself into thy file;\nMake me but like my thoughts, and I shall prove\nA lover of thy drum, hater of love.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
