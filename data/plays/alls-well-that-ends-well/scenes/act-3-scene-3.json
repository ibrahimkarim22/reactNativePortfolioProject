      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.3/p@93523",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nThen go thou forth;\nAnd fortune play upon thy prosperous helm,\nAs thy auspicious mistress!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93523/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.3/p@93523/line-2",
          "start": 6,
          "end": 25,
          "sourceLineNumber": null
        },
        {
