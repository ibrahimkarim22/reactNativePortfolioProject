    {
      "id": "alls-well-that-ends-well/sceneIII_2.4/p@95309",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "STEWARD.\nPardon me, madam;\nIf I had given you this at over-night,\nShe might have been o’erta’en; and yet she writes\nPursuit would be but vain.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
