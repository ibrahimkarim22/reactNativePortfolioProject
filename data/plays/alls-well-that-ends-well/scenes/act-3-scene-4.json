    {
      "id": "alls-well-that-ends-well/sceneIII_2.4/p@94124",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nAlas! and would you take the letter of her?\nMight you not know she would do as she has done,\nBy sending me a letter? Read it again.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
