    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@103677",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Bertram and the two French Lords.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 33,
          "end": 38,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@103677/line-1",
          "start": 0,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 228792,
        "end": 228920,
        "line": 7125,
        "column": 1,
        "path": "chap02/p@103677",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@103809",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nNay, good my lord, put him to’t; let him have his way.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@103809/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@103809/line-2",
          "start": 12,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 228924,
        "end": 229020,
        "line": 7129,
        "column": 1,
        "path": "chap02/p@103809",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@103909",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nIf your lordship find him not a hilding, hold me no more in your respect.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@103909/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@103909/line-2",
          "start": 13,
          "end": 86,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 229024,
        "end": 229140,
        "line": 7134,
        "column": 1,
        "path": "chap02/p@103909",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@104029",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nOn my life, my lord, a bubble.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104029/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104029/line-2",
          "start": 12,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 229144,
        "end": 229216,
        "line": 7139,
        "column": 1,
        "path": "chap02/p@104029",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@104105",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nDo you think I am so far deceived in him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104105/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104105/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 229220,
        "end": 229300,
        "line": 7144,
        "column": 1,
        "path": "chap02/p@104105",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@104189",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nBelieve it, my lord, in mine own direct knowledge, without any malice, but to speak of him as my kinsman, he’s a most notable coward, an infinite and endless liar, an hourly promise-breaker, the owner of no one good quality worthy your lordship’s entertainment.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104189/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104189/line-2",
          "start": 12,
          "end": 273,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 229304,
        "end": 229610,
        "line": 7149,
        "column": 1,
        "path": "chap02/p@104189",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@104499",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nIt were fit you knew him; lest, reposing too far in his virtue, which he hath not, he might at some great and trusty business, in a main danger fail you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104499/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104499/line-2",
          "start": 13,
          "end": 166,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 229614,
        "end": 229811,
        "line": 7157,
        "column": 1,
        "path": "chap02/p@104499",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@104700",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nI would I knew in what particular action to try him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104700/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104700/line-2",
          "start": 9,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 229815,
        "end": 229906,
        "line": 7163,
        "column": 1,
        "path": "chap02/p@104700",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@104795",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nNone better than to let him fetch off his drum, which you hear him so confidently undertake to do.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104795/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104795/line-2",
          "start": 13,
          "end": 111,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 229910,
        "end": 230052,
        "line": 7168,
        "column": 1,
        "path": "chap02/p@104795",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@104941",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nI with a troop of Florentines will suddenly surprise him; such I will have whom I am sure he knows not from the enemy; we will bind and hoodwink him so that he shall suppose no other but that he is carried into the leaguer of the adversaries when we bring him to our own tents. Be but your lordship present at his examination; if he do not for the promise of his life, and in the highest compulsion of base fear, offer to betray you, and deliver all the intelligence in his power against you, and that with the divine forfeit of his soul upon oath, never trust my judgment in anything.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104941/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@104941/line-2",
          "start": 12,
          "end": 597,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 230056,
        "end": 230690,
        "line": 7174,
        "column": 1,
        "path": "chap02/p@104941",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@105579",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nO, for the love of laughter, let him fetch his drum; he says he has a stratagem for’t. When your lordship sees the bottom of his success in’t, and to what metal this counterfeit lump of ore will be melted, if you give him not John Drum’s entertainment, your inclining cannot be removed. Here he comes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@105579/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@105579/line-2",
          "start": 13,
          "end": 314,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 230694,
        "end": 231041,
        "line": 7186,
        "column": 1,
        "path": "chap02/p@105579",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@105930",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Parolles.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@105930/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 231045,
        "end": 231119,
        "line": 7194,
        "column": 1,
        "path": "chap02/p@105930",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@106008",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nO, for the love of laughter, hinder not the honour of his design: let him fetch off his drum in any hand.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106008/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106008/line-2",
          "start": 12,
          "end": 117,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 231123,
        "end": 231271,
        "line": 7198,
        "column": 1,
        "path": "chap02/p@106008",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@106160",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nHow now, monsieur! This drum sticks sorely in your disposition.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106160/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106160/line-2",
          "start": 9,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 231275,
        "end": 231377,
        "line": 7204,
        "column": 1,
        "path": "chap02/p@106160",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@106266",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nA pox on ’t; let it go; ’tis but a drum.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106266/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106266/line-2",
          "start": 13,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 231381,
        "end": 231464,
        "line": 7209,
        "column": 1,
        "path": "chap02/p@106266",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@106353",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nBut a drum! Is’t but a drum? A drum so lost! There was excellent command, to charge in with our horse upon our own wings, and to rend our own soldiers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106353/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106353/line-2",
          "start": 10,
          "end": 161,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 231468,
        "end": 231660,
        "line": 7214,
        "column": 1,
        "path": "chap02/p@106353",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@106549",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nThat was not to be blam’d in the command of the service; it was a disaster of war that Caesar himself could not have prevented, if he had been there to command.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106549/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106549/line-2",
          "start": 13,
          "end": 173,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 231664,
        "end": 231869,
        "line": 7220,
        "column": 1,
        "path": "chap02/p@106549",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@106758",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nWell, we cannot greatly condemn our success: some dishonour we had in the loss of that drum, but it is not to be recovered.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106758/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106758/line-2",
          "start": 9,
          "end": 132,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 231873,
        "end": 232036,
        "line": 7227,
        "column": 1,
        "path": "chap02/p@106758",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@106925",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nIt might have been recovered.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106925/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106925/line-2",
          "start": 10,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 232040,
        "end": 232109,
        "line": 7233,
        "column": 1,
        "path": "chap02/p@106925",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@106998",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nIt might, but it is not now.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106998/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@106998/line-2",
          "start": 9,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 232113,
        "end": 232180,
        "line": 7238,
        "column": 1,
        "path": "chap02/p@106998",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@107069",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nIt is to be recovered. But that the merit of service is seldom attributed to the true and exact performer, I would have that drum or another, or hic jacet.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 155,
          "end": 164
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@107069/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@107069/line-2",
          "start": 10,
          "end": 165,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 232184,
        "end": 232388,
        "line": 7243,
        "column": 1,
        "path": "chap02/p@107069",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@107277",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nWhy, if you have a stomach, to’t, monsieur, if you think your mystery in stratagem can bring this instrument of honour again into his native quarter, be magnanimous in the enterprise, and go on; I will grace the attempt for a worthy exploit; if you speed well in it, the duke shall both speak of it and extend to you what further becomes his greatness, even to the utmost syllable of your worthiness.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@107277/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@107277/line-2",
          "start": 9,
          "end": 409,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 232392,
        "end": 232836,
        "line": 7250,
        "column": 1,
        "path": "chap02/p@107277",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@107725",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nBy the hand of a soldier, I will undertake it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@107725/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@107725/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 232840,
        "end": 232926,
        "line": 7260,
        "column": 1,
        "path": "chap02/p@107725",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@107815",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nBut you must not now slumber in it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@107815/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@107815/line-2",
          "start": 9,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 232930,
        "end": 233004,
        "line": 7265,
        "column": 1,
        "path": "chap02/p@107815",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@107893",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nI’ll about it this evening; and I will presently pen down my dilemmas, encourage myself in my certainty, put myself into my mortal preparation; and by midnight look to hear further from me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@107893/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@107893/line-2",
          "start": 10,
          "end": 199,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 233008,
        "end": 233239,
        "line": 7270,
        "column": 1,
        "path": "chap02/p@107893",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@108128",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nMay I be bold to acquaint his grace you are gone about it?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108128/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108128/line-2",
          "start": 9,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 233243,
        "end": 233340,
        "line": 7277,
        "column": 1,
        "path": "chap02/p@108128",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@108229",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nI know not what the success will be, my lord, but the attempt I vow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108229/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108229/line-2",
          "start": 10,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 233344,
        "end": 233452,
        "line": 7282,
        "column": 1,
        "path": "chap02/p@108229",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@108341",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nI know th’art valiant; and to the possibility of thy soldiership, will subscribe for thee. Farewell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108341/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108341/line-2",
          "start": 9,
          "end": 109,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 233456,
        "end": 233596,
        "line": 7287,
        "column": 1,
        "path": "chap02/p@108341",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@108485",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nI love not many words.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108485/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108485/line-2",
          "start": 10,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 233600,
        "end": 233662,
        "line": 7293,
        "column": 1,
        "path": "chap02/p@108485",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@108551",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 6
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108551/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 233666,
        "end": 233705,
        "line": 7298,
        "column": 1,
        "path": "chap02/p@108551",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@108594",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nNo more than a fish loves water. Is not this a strange fellow, my lord, that so confidently seems to undertake this business, which he knows is not to be done; damns himself to do, and dares better be damn’d than to do’t.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108594/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108594/line-2",
          "start": 12,
          "end": 233,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 233709,
        "end": 233974,
        "line": 7302,
        "column": 1,
        "path": "chap02/p@108594",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@108863",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nYou do not know him, my lord, as we do; certain it is that he will steal himself into a man’s favour, and for a week escape a great deal of discoveries, but when you find him out, you have him ever after.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108863/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@108863/line-2",
          "start": 13,
          "end": 217,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 233978,
        "end": 234227,
        "line": 7309,
        "column": 1,
        "path": "chap02/p@108863",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@109116",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nWhy, do you think he will make no deed at all of this, that so seriously he does address himself unto?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109116/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109116/line-2",
          "start": 9,
          "end": 111,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 234231,
        "end": 234373,
        "line": 7316,
        "column": 1,
        "path": "chap02/p@109116",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@109262",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nNone in the world; but return with an invention, and clap upon you two or three probable lies; but we have almost embossed him; you shall see his fall tonight; for indeed he is not for your lordship’s respect.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109262/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109262/line-2",
          "start": 12,
          "end": 221,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 234377,
        "end": 234630,
        "line": 7322,
        "column": 1,
        "path": "chap02/p@109262",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@109519",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nWe’ll make you some sport with the fox ere we case him. He was first smok’d by the old Lord Lafew; when his disguise and he is parted, tell me what a sprat you shall find him; which you shall see this very night.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109519/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109519/line-2",
          "start": 13,
          "end": 225,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 234634,
        "end": 234891,
        "line": 7329,
        "column": 1,
        "path": "chap02/p@109519",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@109780",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nI must go look my twigs. He shall be caught.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109780/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109780/line-2",
          "start": 12,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 234895,
        "end": 234981,
        "line": 7336,
        "column": 1,
        "path": "chap02/p@109780",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@109870",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nYour brother, he shall go along with me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109870/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109870/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 234985,
        "end": 235064,
        "line": 7341,
        "column": 1,
        "path": "chap02/p@109870",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.6/p@109953",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nAs’t please your lordship. I’ll leave you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109953/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.6/p@109953/line-2",
          "start": 12,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 235068,
        "end": 235152,
        "line": 7346,
        "column": 1,
        "path": "chap02/p@109953",
        "anchor": "sceneIII_2.6"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
