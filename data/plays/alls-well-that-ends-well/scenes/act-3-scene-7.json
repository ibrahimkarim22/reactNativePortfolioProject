{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "alls-well-that-ends-well",
    "title": "All'S Well That Ends Well",
    "author": "William Shakespeare",
    "genre": "Comedy"
  },
  "source": {
    "name": "Project Gutenberg",
