    {
      "id": "alls-well-that-ends-well/sceneIII_2.7/p@111592",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WIDOW.\nI should believe you,\nFor you have show’d me that which well approves\nY’are great in fortune.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111592/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111592/line-2",
          "start": 7,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111592/line-3",
          "start": 29,
          "end": 76,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111592/line-4",
          "start": 77,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 236707,
        "end": 236847,
        "line": 7417,
        "column": 1,
        "path": "chap02/p@111592",
        "anchor": "sceneIII_2.7"
      },
      "speakerLabel": "WIDOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.7/p@111736",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nTake this purse of gold,\nAnd let me buy your friendly help thus far,\nWhich I will over-pay, and pay again\nWhen I have found it. The count he woos your daughter\nLays down his wanton siege before her beauty,\nResolv’d to carry her; let her in fine consent,\nAs we’ll direct her how ’tis best to bear it.\nNow his important blood will naught deny\nThat she’ll demand; a ring the county wears,\nThat downward hath succeeded in his house\nFrom son to son, some four or five descents\nSince the first father wore it. This ring he holds\nIn most rich choice; yet, in his idle fire,\nTo buy his will, it would not seem too dear,\nHowe’er repented after.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111736/line-1",
