    {
      "id": "alls-well-that-ends-well/sceneIII_2.7/p@113297",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nWhy then tonight\nLet us assay our plot; which, if it speed,\nIs wicked meaning in a lawful deed,\nAnd lawful meaning in a lawful act,\nWhere both not sin, and yet a sinful fact.\nBut let’s about it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
