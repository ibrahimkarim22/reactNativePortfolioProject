    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.7/p@111100",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WIDOW.\nThough my estate be fall’n, I was well born,\nNothing acquainted with these businesses,\nAnd would not put my reputation now\nIn any staining act.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111100/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111100/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111100/line-3",
          "start": 52,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111100/line-4",
          "start": 94,
          "end": 129,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111100/line-5",
          "start": 130,
          "end": 150,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 236215,
        "end": 236410,
        "line": 7399,
        "column": 1,
        "path": "chap02/p@111100",
        "anchor": "sceneIII_2.7"
      },
      "speakerLabel": "WIDOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.7/p@111299",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nNor would I wish you.\nFirst give me trust, the count he is my husband,\nAnd what to your sworn counsel I have spoken\nIs so from word to word; and then you cannot,\nBy the good aid that I of you shall borrow,\nErr in bestowing it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111299/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111299/line-2",
          "start": 8,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111299/line-3",
          "start": 30,
          "end": 78,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111299/line-4",
          "start": 79,
          "end": 123,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@111299/line-5",
          "start": 124,
          "end": 169,
          "sourceLineNumber": null
        },
        {
