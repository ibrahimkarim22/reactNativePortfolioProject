    {
      "id": "alls-well-that-ends-well/sceneIII_2.7/p@112483",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WIDOW.\nNow I see\nThe bottom of your purpose.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@112483/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@112483/line-2",
          "start": 7,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@112483/line-3",
          "start": 17,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 237598,
        "end": 237677,
        "line": 7443,
        "column": 1,
        "path": "chap02/p@112483",
        "anchor": "sceneIII_2.7"
      },
      "speakerLabel": "WIDOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIII_2.7/p@112566",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nYou see it lawful then; it is no more\nBut that your daughter, ere she seems as won,\nDesires this ring; appoints him an encounter;\nIn fine, delivers me to fill the time,\nHerself most chastely absent. After,\nTo marry her, I’ll add three thousand crowns\nTo what is pass’d already.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@112566/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
