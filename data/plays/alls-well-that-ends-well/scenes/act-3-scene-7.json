    {
      "id": "alls-well-that-ends-well/sceneIII_2.7/p@112915",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WIDOW.\nI have yielded.\nInstruct my daughter how she shall persever,\nThat time and place with this deceit so lawful\nMay prove coherent. Every night he comes\nWith musics of all sorts, and songs compos’d\nTo her unworthiness: it nothing steads us\nTo chide him from our eaves; for he persists\nAs if his life lay on ’t.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@112915/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
