    {
      "id": "alls-well-that-ends-well/sceneIII_2.7/p@110926",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nIf you misdoubt me that I am not she,\nI know not how I shall assure you further,\nBut I shall lose the grounds I work upon.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@110926/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@110926/line-2",
          "start": 8,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@110926/line-3",
          "start": 46,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIII_2.7/p@110926/line-4",
          "start": 89,
          "end": 130,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 236041,
        "end": 236211,
        "line": 7392,
        "column": 1,
        "path": "chap02/p@110926",
        "anchor": "sceneIII_2.7"
      },
      "speakerLabel": "HELENA.",
      "attribution": {
