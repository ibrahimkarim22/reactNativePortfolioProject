  "scene": {
    "id": "alls-well-that-ends-well-3-7",
    "act": 3,
    "scene": 7,
    "label": "Act 3, Scene 7",
    "title": "SCENE VII. Florence. A room in the Widow's house.",
    "location": "Florence. A room in the Widow's house.",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "alls-well-that-ends-well-3-7-stage-001",
      "type": "stage",
      "text": "Enter Helena and Widow."
    },
    {
      "id": "alls-well-that-ends-well-3-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "If you misdoubt me that I am not she,",
          "plainText": "If you misdoubt me that I am not she",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "I know not how I shall assure you further,",
          "plainText": "I know not how I shall assure you further",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "But I shall lose the grounds I work upon.",
          "plainText": "But I shall lose the grounds I work upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "widow",
        "name": "WIDOW",
        "displayName": "Widow"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-7-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Though my estate be fall'n, I was well born,",
          "plainText": "Though my estate be fall'n I was well born",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Nothing acquainted with these businesses,",
          "plainText": "Nothing acquainted with these businesses",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "And would not put my reputation now",
          "plainText": "And would not put my reputation now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "In any staining act.",
          "plainText": "In any staining act",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-7-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Nor would I wish you.",
          "plainText": "Nor would I wish you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "First give me trust, the count he is my husband,",
          "plainText": "First give me trust the count he is my husband",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "And what to your sworn counsel I have spoken",
          "plainText": "And what to your sworn counsel I have spoken",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Is so from word to word; and then you cannot,",
          "plainText": "Is so from word to word and then you cannot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "By the good aid that I of you shall borrow,",
          "plainText": "By the good aid that I of you shall borrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "Err in bestowing it.",
          "plainText": "Err in bestowing it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-7-speech-004",
      "type": "speech",
      "speaker": {
        "id": "widow",
        "name": "WIDOW",
        "displayName": "Widow"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-7-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "I should believe you,",
          "plainText": "I should believe you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "For you have show'd me that which well approves",
          "plainText": "For you have show'd me that which well approves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "Y'are great in fortune.",
          "plainText": "Y'are great in fortune",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-7-speech-005",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-7-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Take this purse of gold,",
          "plainText": "Take this purse of gold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "And let me buy your friendly help thus far,",
          "plainText": "And let me buy your friendly help thus far",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Which I will over-pay, and pay again",
          "plainText": "Which I will overpay and pay again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "When I have found it. The count he woos your daughter",
          "plainText": "When I have found it The count he woos your daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Lays down his wanton siege before her beauty,",
          "plainText": "Lays down his wanton siege before her beauty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "Resolv'd to carry her; let her in fine consent,",
          "plainText": "Resolv'd to carry her let her in fine consent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0023",
          "number": 23,
          "speechLineNumber": 7,
          "text": "As we'll direct her how 'tis best to bear it.",
          "plainText": "As we'll direct her how 'tis best to bear it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0024",
          "number": 24,
          "speechLineNumber": 8,
          "text": "Now his important blood will naught deny",
          "plainText": "Now his important blood will naught deny",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0025",
          "number": 25,
          "speechLineNumber": 9,
          "text": "That she'll demand; a ring the county wears,",
          "plainText": "That she'll demand a ring the county wears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0026",
          "number": 26,
          "speechLineNumber": 10,
          "text": "That downward hath succeeded in his house",
          "plainText": "That downward hath succeeded in his house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0027",
          "number": 27,
          "speechLineNumber": 11,
          "text": "From son to son, some four or five descents",
          "plainText": "From son to son some four or five descents",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0028",
          "number": 28,
          "speechLineNumber": 12,
          "text": "Since the first father wore it. This ring he holds",
          "plainText": "Since the first father wore it This ring he holds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0029",
          "number": 29,
          "speechLineNumber": 13,
          "text": "In most rich choice; yet, in his idle fire,",
          "plainText": "In most rich choice yet in his idle fire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0030",
          "number": 30,
          "speechLineNumber": 14,
          "text": "To buy his will, it would not seem too dear,",
          "plainText": "To buy his will it would not seem too dear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0031",
          "number": 31,
          "speechLineNumber": 15,
          "text": "Howe'er repented after.",
          "plainText": "Howe'er repented after",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-7-speech-006",
      "type": "speech",
      "speaker": {
        "id": "widow",
        "name": "WIDOW",
        "displayName": "Widow"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-7-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Now I see",
          "plainText": "Now I see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "The bottom of your purpose.",
          "plainText": "The bottom of your purpose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-7-speech-007",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-7-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "You see it lawful then; it is no more",
          "plainText": "You see it lawful then it is no more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "But that your daughter, ere she seems as won,",
          "plainText": "But that your daughter ere she seems as won",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Desires this ring; appoints him an encounter;",
          "plainText": "Desires this ring appoints him an encounter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "In fine, delivers me to fill the time,",
          "plainText": "In fine delivers me to fill the time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "Herself most chastely absent. After,",
          "plainText": "Herself most chastely absent After",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0039",
          "number": 39,
          "speechLineNumber": 6,
          "text": "To marry her, I'll add three thousand crowns",
          "plainText": "To marry her I'll add three thousand crowns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0040",
          "number": 40,
          "speechLineNumber": 7,
          "text": "To what is pass'd already.",
          "plainText": "To what is pass'd already",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-7-speech-008",
      "type": "speech",
      "speaker": {
        "id": "widow",
        "name": "WIDOW",
        "displayName": "Widow"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-7-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "I have yielded.",
          "plainText": "I have yielded",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Instruct my daughter how she shall persever,",
          "plainText": "Instruct my daughter how she shall persever",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "That time and place with this deceit so lawful",
          "plainText": "That time and place with this deceit so lawful",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "May prove coherent. Every night he comes",
          "plainText": "May prove coherent Every night he comes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "With musics of all sorts, and songs compos'd",
          "plainText": "With musics of all sorts and songs compos'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "To her unworthiness: it nothing steads us",
          "plainText": "To her unworthiness it nothing steads us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0047",
          "number": 47,
          "speechLineNumber": 7,
          "text": "To chide him from our eaves; for he persists",
          "plainText": "To chide him from our eaves for he persists",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0048",
          "number": 48,
          "speechLineNumber": 8,
          "text": "As if his life lay on 't.",
          "plainText": "As if his life lay on 't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-7-speech-009",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-7-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Why then tonight",
          "plainText": "Why then tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Let us assay our plot; which, if it speed,",
          "plainText": "Let us assay our plot which if it speed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "Is wicked meaning in a lawful deed,",
          "plainText": "Is wicked meaning in a lawful deed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "And lawful meaning in a lawful act,",
          "plainText": "And lawful meaning in a lawful act",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-3-7-line-0053",
          "number": 53,
          "speechLineNumber": 5,
          "text": "Where both not sin, and yet a sinful fact.",
