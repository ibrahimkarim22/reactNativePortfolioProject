      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nI’ll lend it thee, my dear, but have no power\nTo give it from me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122819/line-1",
          "start": 0,
