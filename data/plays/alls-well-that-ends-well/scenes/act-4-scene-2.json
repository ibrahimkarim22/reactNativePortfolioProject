          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122819/line-3",
          "start": 55,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 247934,
        "end": 248043,
        "line": 7876,
        "column": 1,
        "path": "chap02/p@122819",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@122932",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIANA.\nWill you not, my lord?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122932/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122932/line-2",
          "start": 7,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 248047,
        "end": 248106,
        "line": 7882,
        "column": 1,
        "path": "chap02/p@122932",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "DIANA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@122995",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nIt is an honour ’longing to our house,\nBequeathed down from many ancestors,\nWhich were the greatest obloquy i’ the world\nIn me to lose.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122995/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122995/line-2",
          "start": 9,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122995/line-3",
          "start": 48,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122995/line-4",
          "start": 85,
          "end": 129,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122995/line-5",
          "start": 130,
          "end": 144,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 248110,
        "end": 248299,
        "line": 7887,
        "column": 1,
        "path": "chap02/p@122995",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@123188",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIANA.\nMine honour’s such a ring;\nMy chastity’s the jewel of our house,\nBequeathed down from many ancestors,\nWhich were the greatest obloquy i’ the world\nIn me to lose. Thus your own proper wisdom\nBrings in the champion honour on my part\nAgainst your vain assault.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@123188/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
