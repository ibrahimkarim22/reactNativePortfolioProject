    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@123516",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nHere, take my ring;\nMy house, mine honour, yea, my life be thine,\nAnd I’ll be bid by thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@123516/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@123516/line-2",
          "start": 9,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@123516/line-3",
          "start": 29,
          "end": 74,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@123516/line-4",
          "start": 75,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 248631,
        "end": 248770,
        "line": 7906,
        "column": 1,
        "path": "chap02/p@123516",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@123659",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIANA.\nWhen midnight comes, knock at my chamber window;\nI’ll order take my mother shall not hear.\nNow will I charge you in the band of truth,\nWhen you have conquer’d my yet maiden-bed,\nRemain there but an hour, nor speak to me.\nMy reasons are most strong; and you shall know them\nWhen back again this ring shall be deliver’d;\nAnd on your finger in the night, I’ll put\nAnother ring, that what in time proceeds\nMay token to the future our past deeds.\nAdieu till then; then fail not. You have won\nA wife of me, though there my hope be done.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
