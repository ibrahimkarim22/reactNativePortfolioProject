          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121763/line-12",
          "start": 470,
          "end": 493,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 246878,
        "end": 247451,
        "line": 7844,
        "column": 1,
        "path": "chap02/p@121763",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "DIANA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@122340",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nChange it, change it.\nBe not so holy-cruel. Love is holy;\nAnd my integrity ne’er knew the crafts\nThat you do charge men with. Stand no more off,\nBut give thyself unto my sick desires,\nWho then recovers. Say thou art mine, and ever\nMy love as it begins shall so persever.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122340/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122340/line-2",
          "start": 9,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122340/line-3",
          "start": 31,
          "end": 66,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122340/line-4",
          "start": 67,
          "end": 105,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122340/line-5",
          "start": 106,
          "end": 153,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122340/line-6",
          "start": 154,
          "end": 192,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122340/line-7",
          "start": 193,
          "end": 239,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122340/line-8",
          "start": 240,
          "end": 279,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 247455,
        "end": 247794,
        "line": 7859,
        "column": 1,
        "path": "chap02/p@122340",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
