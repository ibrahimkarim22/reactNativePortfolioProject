      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIANA.\nShe then was honest.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121020/line-1",
