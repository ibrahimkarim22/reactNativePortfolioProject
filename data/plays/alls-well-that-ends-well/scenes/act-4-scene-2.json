      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@121081",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nSo should you be.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121081/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121081/line-2",
          "start": 9,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 246196,
        "end": 246252,
        "line": 7810,
        "column": 1,
        "path": "chap02/p@121081",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@121141",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIANA.\nNo.\nMy mother did but duty; such, my lord,\nAs you owe to your wife.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121141/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121141/line-2",
          "start": 7,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121141/line-3",
          "start": 11,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121141/line-4",
          "start": 50,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 246256,
        "end": 246370,
        "line": 7815,
        "column": 1,
        "path": "chap02/p@121141",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "DIANA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@121259",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nNo more a’ that!\nI pr’ythee do not strive against my vows;\nI was compell’d to her; but I love thee\nBy love’s own sweet constraint, and will for ever\nDo thee all rights of service.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121259/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121259/line-2",
          "start": 9,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121259/line-3",
          "start": 26,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121259/line-4",
          "start": 68,
          "end": 107,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121259/line-5",
          "start": 108,
          "end": 157,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121259/line-6",
          "start": 158,
          "end": 188,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 246374,
        "end": 246612,
        "line": 7822,
        "column": 1,
        "path": "chap02/p@121259",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@121501",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIANA.\nAy, so you serve us\nTill we serve you; but when you have our roses,\nYou barely leave our thorns to prick ourselves,\nAnd mock us with our bareness.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121501/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121501/line-2",
          "start": 7,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121501/line-3",
          "start": 27,
          "end": 74,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121501/line-4",
          "start": 75,
          "end": 122,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121501/line-5",
          "start": 123,
          "end": 153,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 246616,
        "end": 246814,
        "line": 7831,
