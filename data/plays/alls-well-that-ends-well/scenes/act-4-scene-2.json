          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122683/line-3",
          "start": 49,
          "end": 97,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 247798,
        "end": 247930,
        "line": 7870,
        "column": 1,
        "path": "chap02/p@122683",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "DIANA.",
