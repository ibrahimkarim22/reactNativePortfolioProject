        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@121703",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BERTRAM.\nHow have I sworn?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121703/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121703/line-2",
          "start": 9,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 246818,
        "end": 246874,
        "line": 7839,
        "column": 1,
        "path": "chap02/p@121703",
        "anchor": "sceneIV_2.2"
      },
      "speakerLabel": "BERTRAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@121763",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIANA.\n’Tis not the many oaths that makes the truth,\nBut the plain single vow that is vow’d true.\nWhat is not holy, that we swear not by,\nBut take the highest to witness: then, pray you, tell me,\nIf I should swear by Jove’s great attributes\nI lov’d you dearly, would you believe my oaths\nWhen I did love you ill? This has no holding,\nTo swear by him whom I protest to love\nThat I will work against him. Therefore your oaths\nAre words and poor conditions; but unseal’d,—\nAt least in my opinion.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121763/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121763/line-2",
          "start": 7,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121763/line-3",
          "start": 53,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121763/line-4",
          "start": 98,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121763/line-5",
          "start": 138,
          "end": 195,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121763/line-6",
          "start": 196,
          "end": 240,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121763/line-7",
          "start": 241,
          "end": 287,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@121763/line-8",
