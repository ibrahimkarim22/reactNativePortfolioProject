      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIANA.\nNo, my good lord, Diana.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@120530/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
