      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.2/p@122683",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIANA.\nI see that men make hopes in such a case,\nThat we’ll forsake ourselves. Give me that ring.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.2/p@122683/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
