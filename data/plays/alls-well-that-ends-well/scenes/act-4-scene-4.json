    {
      "id": "alls-well-that-ends-well/sceneIV_2.4/p@147411",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nYet, I pray you;\nBut with the word the time will bring on summer,\nWhen briers shall have leaves as well as thorns,\nAnd be as sweet as sharp. We must away;\nOur waggon is prepar’d, and time revives us.\nAll’s well that ends well; still the fine’s the crown.\nWhate’er the course, the end is the renown.",
      "separatorAfter": "\n\n",
      "spans": [],
