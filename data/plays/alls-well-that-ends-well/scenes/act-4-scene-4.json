    {
      "id": "alls-well-that-ends-well/sceneIV_2.4/p@147276",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIANA.\nLet death and honesty\nGo with your impositions, I am yours\nUpon your will to suffer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
