    {
      "id": "alls-well-that-ends-well/sceneIV_2.4/p@146509",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WIDOW.\nGentle madam,\nYou never had a servant to whose trust\nYour business was more welcome.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.4/p@146509/line-1",
