  "content": [
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/h3@147826",
      "type": "heading",
      "tag": "h3",
      "classes": [],
      "text": "SCENE V. Rossillon. A room in the Countess’s palace.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "b",
          "start": 0,
          "end": 52
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/h3@147826/line-1",
          "start": 0,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 272941,
        "end": 273035,
        "line": 8812,
        "column": 1,
        "path": "chap02/h3@147826",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@147924",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Clown, Countess and Lafew.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 21,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 26,
          "end": 31,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@147924/line-1",
          "start": 0,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 273039,
        "end": 273160,
        "line": 8815,
        "column": 1,
        "path": "chap02/p@147924",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@148049",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nNo, no, no, your son was misled with a snipt-taffeta fellow there, whose villanous saffron would have made all the unbak’d and doughy youth of a nation in his colour. Your daughter-in-law had been alive at this hour, and your son here at home, more advanc’d by the king than by that red-tail’d humble-bee I speak of.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@148049/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@148049/line-2",
          "start": 7,
          "end": 323,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 273164,
        "end": 273521,
        "line": 8819,
        "column": 1,
        "path": "chap02/p@148049",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@148410",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nI would I had not known him; it was the death of the most virtuous gentlewoman that ever nature had praise for creating. If she had partaken of my flesh and cost me the dearest groans of a mother, I could not have owed her a more rooted love.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@148410/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@148410/line-2",
          "start": 10,
          "end": 252,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 273525,
        "end": 273810,
        "line": 8828,
        "column": 1,
        "path": "chap02/p@148410",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@148699",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\n’Twas a good lady, ’twas a good lady. We may pick a thousand salads ere we light on such another herb.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@148699/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@148699/line-2",
          "start": 7,
          "end": 109,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 273814,
        "end": 273954,
        "line": 8836,
        "column": 1,
        "path": "chap02/p@148699",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@148843",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nIndeed, sir, she was the sweet marjoram of the salad, or, rather, the herb of grace.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@148843/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@148843/line-2",
          "start": 7,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 273958,
        "end": 274080,
        "line": 8842,
        "column": 1,
        "path": "chap02/p@148843",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@148969",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nThey are not herbs, you knave; they are nose-herbs.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@148969/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@148969/line-2",
          "start": 7,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274084,
        "end": 274172,
        "line": 8848,
        "column": 1,
        "path": "chap02/p@148969",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149061",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nI am no great Nebuchadnezzar, sir; I have not much skill in grass.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149061/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149061/line-2",
          "start": 7,
          "end": 73,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274176,
        "end": 274279,
        "line": 8853,
        "column": 1,
        "path": "chap02/p@149061",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149168",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nWhether dost thou profess thyself,—a knave or a fool?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149168/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149168/line-2",
          "start": 7,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274283,
        "end": 274373,
        "line": 8858,
        "column": 1,
        "path": "chap02/p@149168",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149262",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nA fool, sir, at a woman’s service, and a knave at a man’s.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149262/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149262/line-2",
          "start": 7,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274377,
        "end": 274472,
        "line": 8863,
        "column": 1,
        "path": "chap02/p@149262",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149361",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nYour distinction?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149361/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149361/line-2",
          "start": 7,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274476,
        "end": 274530,
        "line": 8868,
        "column": 1,
        "path": "chap02/p@149361",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149419",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nI would cozen the man of his wife, and do his service.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149419/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149419/line-2",
          "start": 7,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274534,
        "end": 274625,
        "line": 8873,
        "column": 1,
        "path": "chap02/p@149419",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149514",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nSo you were a knave at his service indeed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149514/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149514/line-2",
          "start": 7,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274629,
        "end": 274708,
        "line": 8878,
        "column": 1,
        "path": "chap02/p@149514",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149597",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nAnd I would give his wife my bauble, sir, to do her service.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149597/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149597/line-2",
          "start": 7,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274712,
        "end": 274809,
        "line": 8883,
        "column": 1,
        "path": "chap02/p@149597",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149698",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nI will subscribe for thee; thou art both knave and fool.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149698/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149698/line-2",
          "start": 7,
          "end": 63,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274813,
        "end": 274906,
        "line": 8888,
        "column": 1,
        "path": "chap02/p@149698",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149795",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nAt your service.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149795/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149795/line-2",
          "start": 7,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274910,
        "end": 274963,
        "line": 8893,
        "column": 1,
        "path": "chap02/p@149795",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149852",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nNo, no, no.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149852/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149852/line-2",
          "start": 7,
          "end": 18,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 274967,
        "end": 275015,
        "line": 8898,
        "column": 1,
        "path": "chap02/p@149852",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@149904",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nWhy, sir, if I cannot serve you, I can serve as great a prince as you are.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149904/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@149904/line-2",
          "start": 7,
          "end": 81,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 275019,
        "end": 275130,
        "line": 8903,
        "column": 1,
        "path": "chap02/p@149904",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@150019",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nWho’s that? a Frenchman?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150019/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150019/line-2",
          "start": 7,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 275134,
        "end": 275195,
        "line": 8908,
        "column": 1,
        "path": "chap02/p@150019",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@150084",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nFaith, sir, ’a has an English name; but his phisnomy is more hotter in France than there.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150084/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150084/line-2",
          "start": 7,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 275199,
        "end": 275326,
        "line": 8913,
        "column": 1,
        "path": "chap02/p@150084",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@150215",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nWhat prince is that?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150215/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150215/line-2",
          "start": 7,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 275330,
        "end": 275387,
        "line": 8919,
        "column": 1,
        "path": "chap02/p@150215",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@150276",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nThe black prince, sir; alias the prince of darkness; alias the devil.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150276/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150276/line-2",
          "start": 7,
          "end": 76,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 275391,
        "end": 275497,
        "line": 8924,
        "column": 1,
        "path": "chap02/p@150276",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@150386",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nHold thee, there’s my purse. I give thee not this to suggest thee from thy master thou talk’st of; serve him still.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150386/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150386/line-2",
          "start": 7,
          "end": 122,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 275501,
        "end": 275654,
        "line": 8929,
        "column": 1,
        "path": "chap02/p@150386",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@150543",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nI am a woodland fellow, sir, that always loved a great fire, and the master I speak of ever keeps a good fire. But sure he is the prince of the world; let his nobility remain in’s court. I am for the house with the narrow gate, which I take to be too little for pomp to enter: some that humble themselves may, but the many will be too chill and tender, and they’ll be for the flow’ry way that leads to the broad gate and the great fire.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150543/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@150543/line-2",
          "start": 7,
          "end": 443,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 275658,
        "end": 276136,
        "line": 8935,
        "column": 1,
        "path": "chap02/p@150543",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@151025",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nGo thy ways, I begin to be a-weary of thee; and I tell thee so before, because I would not fall out with thee. Go thy ways; let my horses be well look’d to, without any tricks.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151025/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151025/line-2",
          "start": 7,
          "end": 183,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 276140,
        "end": 276355,
        "line": 8945,
        "column": 1,
        "path": "chap02/p@151025",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@151244",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nIf I put any tricks upon ’em, sir, they shall be jades’ tricks, which are their own right by the law of nature.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151244/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151244/line-2",
          "start": 7,
          "end": 118,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 276359,
        "end": 276508,
        "line": 8952,
        "column": 1,
        "path": "chap02/p@151244",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@151397",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 6
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151397/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 276512,
        "end": 276551,
        "line": 8958,
        "column": 1,
        "path": "chap02/p@151397",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@151440",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nA shrewd knave, and an unhappy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151440/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151440/line-2",
          "start": 7,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 276555,
        "end": 276623,
        "line": 8962,
        "column": 1,
        "path": "chap02/p@151440",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@151512",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nSo he is. My lord that’s gone made himself much sport out of him; by his authority he remains here, which he thinks is a patent for his sauciness; and indeed he has no pace, but runs where he will.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151512/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151512/line-2",
          "start": 10,
          "end": 207,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 276627,
        "end": 276866,
        "line": 8967,
        "column": 1,
        "path": "chap02/p@151512",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@151755",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nI like him well; ’tis not amiss. And I was about to tell you, since I heard of the good lady’s death, and that my lord your son was upon his return home, I moved the king my master to speak in the behalf of my daughter; which, in the minority of them both, his majesty out of a self-gracious remembrance did first propose. His highness hath promis’d me to do it; and, to stop up the displeasure he hath conceived against your son, there is no fitter matter. How does your ladyship like it?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151755/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@151755/line-2",
          "start": 7,
          "end": 496,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 276870,
        "end": 277402,
        "line": 8974,
        "column": 1,
        "path": "chap02/p@151755",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@152291",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nWith very much content, my lord, and I wish it happily effected.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@152291/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@152291/line-2",
          "start": 10,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 277406,
        "end": 277510,
        "line": 8985,
        "column": 1,
        "path": "chap02/p@152291",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@152399",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nHis highness comes post from Marseilles, of as able body as when he number’d thirty; he will be here tomorrow, or I am deceived by him that in such intelligence hath seldom fail’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@152399/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@152399/line-2",
          "start": 7,
          "end": 187,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 277514,
        "end": 277733,
        "line": 8990,
        "column": 1,
        "path": "chap02/p@152399",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@152622",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nIt rejoices me that I hope I shall see him ere I die. I have letters that my son will be here tonight. I shall beseech your lordship to remain with me till they meet together.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@152622/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@152622/line-2",
          "start": 10,
          "end": 185,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 277737,
        "end": 277954,
        "line": 8997,
        "column": 1,
        "path": "chap02/p@152622",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@152843",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nMadam, I was thinking with what manners I might safely be admitted.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@152843/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@152843/line-2",
          "start": 7,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 277958,
        "end": 278062,
        "line": 9004,
        "column": 1,
        "path": "chap02/p@152843",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@152951",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nYou need but plead your honourable privilege.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@152951/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@152951/line-2",
          "start": 10,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 278066,
        "end": 278151,
        "line": 9009,
        "column": 1,
        "path": "chap02/p@152951",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@153040",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nLady, of that I have made a bold charter; but, I thank my God, it holds yet.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@153040/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@153040/line-2",
          "start": 7,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 278155,
        "end": 278268,
        "line": 9014,
        "column": 1,
        "path": "chap02/p@153040",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@153157",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Clown.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 11,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@153157/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 278272,
        "end": 278343,
        "line": 9019,
        "column": 1,
        "path": "chap02/p@153157",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@153232",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nO madam, yonder’s my lord your son with a patch of velvet on’s face; whether there be a scar under’t or no, the velvet knows; but ’tis a goodly patch of velvet. His left cheek is a cheek of two pile and a half, but his right cheek is worn bare.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@153232/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@153232/line-2",
          "start": 7,
          "end": 251,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 278347,
        "end": 278631,
        "line": 9023,
        "column": 1,
        "path": "chap02/p@153232",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@153520",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nA scar nobly got, or a noble scar, is a good livery of honour; so belike is that.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@153520/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneIV_2.5/p@153520/line-2",
          "start": 7,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 278635,
        "end": 278754,
        "line": 9031,
        "column": 1,
        "path": "chap02/p@153520",
        "anchor": "sceneIV_2.5"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneIV_2.5/p@153643",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nBut it is your carbonado’d face.",
      "separatorAfter": "\n\n",
      "spans": [],
