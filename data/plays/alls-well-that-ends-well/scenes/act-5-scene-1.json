  "scene": {
    "id": "alls-well-that-ends-well-5-1",
    "act": 5,
    "scene": 1,
    "label": "Act 5, Scene 1",
    "title": "SCENE I. Marseilles. A street.",
    "location": "Marseilles. A street.",
    "orderInPlay": 21
  },
  "content": [
    {
      "id": "alls-well-that-ends-well-5-1-stage-001",
      "type": "stage",
      "text": "Enter Helena, Widow and Diana with two Attendants."
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "But this exceeding posting day and night",
          "plainText": "But this exceeding posting day and night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Must wear your spirits low. We cannot help it.",
          "plainText": "Must wear your spirits low We cannot help it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "But since you have made the days and nights as one,",
          "plainText": "But since you have made the days and nights as one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "To wear your gentle limbs in my affairs,",
          "plainText": "To wear your gentle limbs in my affairs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Be bold you do so grow in my requital",
          "plainText": "Be bold you do so grow in my requital",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "As nothing can unroot you. In happy time;—",
          "plainText": "As nothing can unroot you In happy time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-stage-002",
      "type": "stage",
      "text": "Enter a Gentleman."
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "And you.",
          "plainText": "And you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Sir, I have seen you in the court of France.",
          "plainText": "Sir I have seen you in the court of France",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "I have been sometimes there.",
          "plainText": "I have been sometimes there",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "I do presume, sir, that you are not fallen",
          "plainText": "I do presume sir that you are not fallen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "From the report that goes upon your goodness;",
          "plainText": "From the report that goes upon your goodness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "And therefore, goaded with most sharp occasions,",
          "plainText": "And therefore goaded with most sharp occasions",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "Which lay nice manners by, I put you to",
          "plainText": "Which lay nice manners by I put you to",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 5,
          "text": "The use of your own virtues, for the which",
          "plainText": "The use of your own virtues for the which",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 6,
          "text": "I shall continue thankful.",
          "plainText": "I shall continue thankful",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "What's your will?",
          "plainText": "What's your will",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "That it will please you",
          "plainText": "That it will please you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "To give this poor petition to the king,",
          "plainText": "To give this poor petition to the king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "And aid me with that store of power you have",
          "plainText": "And aid me with that store of power you have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "To come into his presence.",
          "plainText": "To come into his presence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "The king's not here.",
          "plainText": "The king's not here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Not here, sir?",
          "plainText": "Not here sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Not indeed.",
          "plainText": "Not indeed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "He hence remov'd last night, and with more haste",
          "plainText": "He hence remov'd last night and with more haste",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "Than is his use.",
          "plainText": "Than is his use",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "widow",
        "name": "WIDOW",
        "displayName": "Widow"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Lord, how we lose our pains!",
          "plainText": "Lord how we lose our pains",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "All's well that ends well yet,",
          "plainText": "All's well that ends well yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Though time seem so adverse and means unfit.",
          "plainText": "Though time seem so adverse and means unfit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "I do beseech you, whither is he gone?",
          "plainText": "I do beseech you whither is he gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Marry, as I take it, to Rossillon;",
          "plainText": "Marry as I take it to Rossillon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "Whither I am going.",
          "plainText": "Whither I am going",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "I do beseech you, sir,",
          "plainText": "I do beseech you sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Since you are like to see the king before me,",
          "plainText": "Since you are like to see the king before me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "Commend the paper to his gracious hand,",
          "plainText": "Commend the paper to his gracious hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "Which I presume shall render you no blame,",
          "plainText": "Which I presume shall render you no blame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "But rather make you thank your pains for it.",
          "plainText": "But rather make you thank your pains for it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "I will come after you with what good speed",
          "plainText": "I will come after you with what good speed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "Our means will make us means.",
          "plainText": "Our means will make us means",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "This I'll do for you.",
          "plainText": "This I'll do for you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-5-1-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "And you shall find yourself to be well thank'd,",
          "plainText": "And you shall find yourself to be well thank'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Whate'er falls more. We must to horse again.",
          "plainText": "Whate'er falls more We must to horse again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "alls-well-that-ends-well-5-1-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Go, go, provide.",
          "plainText": "Go go provide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-5-1-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}