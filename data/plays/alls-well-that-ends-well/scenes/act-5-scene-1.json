      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Helena, Widow and Diana with two Attendants.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 19,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 24,
          "end": 29,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.1/p@154203/line-1",
          "start": 0,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 279318,
        "end": 279457,
        "line": 9066,
        "column": 1,
        "path": "chap02/p@154203",
        "anchor": "sceneV_2.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.1/p@154346",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELENA.\nBut this exceeding posting day and night\nMust wear your spirits low. We cannot help it.\nBut since you have made the days and nights as one,\nTo wear your gentle limbs in my affairs,\nBe bold you do so grow in my requital\nAs nothing can unroot you. In happy time;—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.1/p@154346/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.1/p@154346/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.1/p@154346/line-3",
          "start": 49,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.1/p@154346/line-4",
          "start": 96,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.1/p@154346/line-5",
          "start": 148,
          "end": 188,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.1/p@154346/line-6",
