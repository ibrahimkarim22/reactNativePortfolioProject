      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@156970",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Clown and Parolles.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 11,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 16,
          "end": 24,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@156970/line-1",
          "start": 0,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 282085,
        "end": 282199,
        "line": 9192,
        "column": 1,
        "path": "chap02/p@156970",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@157088",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nGood Monsieur Lavache, give my Lord Lafew this letter; I have ere now, sir, been better known to you, when I have held familiarity with fresher clothes; but I am now, sir, muddied in Fortune’s mood, and smell somewhat strong of her strong displeasure.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157088/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157088/line-2",
          "start": 10,
          "end": 261,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 282203,
        "end": 282497,
        "line": 9196,
        "column": 1,
        "path": "chap02/p@157088",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@157386",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nTruly, Fortune’s displeasure is but sluttish, if it smell so strongly as thou speak’st of. I will henceforth eat no fish of Fortune’s buttering. Pr’ythee, allow the wind.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157386/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157386/line-2",
          "start": 7,
          "end": 177,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 282501,
        "end": 282710,
        "line": 9204,
        "column": 1,
        "path": "chap02/p@157386",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@157599",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nNay, you need not to stop your nose, sir. I spake but by a metaphor.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157599/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157599/line-2",
          "start": 10,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 282714,
        "end": 282822,
        "line": 9211,
        "column": 1,
        "path": "chap02/p@157599",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@157711",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nIndeed, sir, if your metaphor stink, I will stop my nose, or against any man’s metaphor. Pr’ythee, get thee further.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157711/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157711/line-2",
          "start": 7,
          "end": 123,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 282826,
        "end": 282980,
        "line": 9216,
        "column": 1,
        "path": "chap02/p@157711",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@157869",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nPray you, sir, deliver me this paper.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157869/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157869/line-2",
          "start": 10,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 282984,
        "end": 283061,
        "line": 9222,
        "column": 1,
        "path": "chap02/p@157869",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@157950",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nFoh, pr’ythee stand away. A paper from Fortune’s close-stool to give to a nobleman! Look here he comes himself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157950/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@157950/line-2",
          "start": 7,
          "end": 118,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 283065,
        "end": 283214,
        "line": 9227,
        "column": 1,
        "path": "chap02/p@157950",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@158103",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Lafew.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 11,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@158103/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 283218,
        "end": 283289,
        "line": 9233,
        "column": 1,
        "path": "chap02/p@158103",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@158178",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Here is a pur of Fortune’s, sir, or of Fortune’s cat, but not a musk-cat, that has fallen into the unclean fishpond of her displeasure, and as he says, is muddied withal. Pray you, sir, use the carp as you may, for he looks like a poor, decayed, ingenious, foolish, rascally knave. I do pity his distress in my similes of comfort, and leave him to your lordship.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@158178/line-1",
          "start": 0,
          "end": 362,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 283293,
        "end": 283684,
        "line": 9237,
        "column": 1,
        "path": "chap02/p@158178",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@158573",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 6
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@158573/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 283688,
        "end": 283727,
        "line": 9245,
        "column": 1,
        "path": "chap02/p@158573",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@158616",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nMy lord, I am a man whom Fortune hath cruelly scratch’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@158616/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@158616/line-2",
          "start": 10,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 283731,
        "end": 283827,
        "line": 9249,
        "column": 1,
        "path": "chap02/p@158616",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@158716",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nAnd what would you have me to do? ’Tis too late to pare her nails now. Wherein have you played the knave with Fortune that she should scratch you, who of herself is a good lady, and would not have knaves thrive long under her? There’s a quart d’ecu for you. Let the justices make you and Fortune friends; I am for other business.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@158716/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@158716/line-2",
          "start": 7,
          "end": 336,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 283831,
        "end": 284201,
        "line": 9254,
        "column": 1,
        "path": "chap02/p@158716",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@159090",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nI beseech your honour to hear me one single word.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159090/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159090/line-2",
          "start": 10,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 284205,
        "end": 284294,
        "line": 9263,
        "column": 1,
        "path": "chap02/p@159090",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@159183",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nYou beg a single penny more. Come, you shall ha’t; save your word.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159183/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159183/line-2",
          "start": 7,
          "end": 73,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 284298,
        "end": 284401,
        "line": 9268,
        "column": 1,
        "path": "chap02/p@159183",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@159290",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nMy name, my good lord, is Parolles.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159290/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159290/line-2",
          "start": 10,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 284405,
        "end": 284480,
        "line": 9273,
        "column": 1,
        "path": "chap02/p@159290",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@159369",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nYou beg more than word then. Cox my passion! Give me your hand. How does your drum?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159369/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159369/line-2",
          "start": 7,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 284484,
        "end": 284605,
        "line": 9278,
        "column": 1,
        "path": "chap02/p@159369",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@159494",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nO my good lord, you were the first that found me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159494/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159494/line-2",
          "start": 10,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 284609,
        "end": 284698,
        "line": 9284,
        "column": 1,
        "path": "chap02/p@159494",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "PAROLLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@159587",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAFEW.\nWas I, in sooth? And I was the first that lost thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159587/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/p@159587/line-2",
          "start": 7,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 284702,
        "end": 284791,
        "line": 9289,
        "column": 1,
        "path": "chap02/p@159587",
        "anchor": "sceneV_2.2"
      },
      "speakerLabel": "LAFEW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "alls-well-that-ends-well/sceneV_2.2/p@159680",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAROLLES.\nIt lies in you, my lord, to bring me in some grace, for you did bring me out.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
