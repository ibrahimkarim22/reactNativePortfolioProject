      "type": "heading",
      "tag": "h3",
      "classes": [],
      "text": "SCENE II. Rossillon. The inner court of the Countess’s palace.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "b",
          "start": 0,
          "end": 62
        }
      ],
      "lines": [
        {
          "id": "alls-well-that-ends-well/sceneV_2.2/h3@156863/line-1",
          "start": 0,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 281978,
        "end": 282081,
        "line": 9189,
        "column": 1,
        "path": "chap02/h3@156863",
