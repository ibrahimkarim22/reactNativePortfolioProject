    {
      "id": "alls-well-that-ends-well/sceneV_2.3/p@182191",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "The king’s a beggar, now the play is done;\nAll is well ended if this suit be won,\nThat you express content; which we will pay\nWith strife to please you, day exceeding day.\nOurs be your patience then, and yours our parts;\nYour gentle hands lend us, and take our hearts.",
