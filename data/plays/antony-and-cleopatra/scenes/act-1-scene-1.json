      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nGrates me, the sum.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8272/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8272/line-2",
          "start": 8,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 316011,
        "end": 316068,
        "line": 10556,
        "column": 1,
        "path": "chap03/p@8272",
        "anchor": "sceneI_3.1"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@8333",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nNay, hear them, Antony.\nFulvia perchance is angry; or who knows\nIf the scarce-bearded Caesar have not sent\nHis powerful mandate to you: “Do this or this;\nTake in that kingdom and enfranchise that.\nPerform’t, or else we damn thee.”",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8333/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8333/line-2",
          "start": 11,
          "end": 34,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8333/line-3",
          "start": 35,
          "end": 74,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8333/line-4",
          "start": 75,
          "end": 117,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8333/line-5",
          "start": 118,
          "end": 164,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8333/line-6",
          "start": 165,
          "end": 207,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8333/line-7",
          "start": 208,
          "end": 241,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 316072,
        "end": 316368,
        "line": 10561,
        "column": 1,
        "path": "chap03/p@8333",
        "anchor": "sceneI_3.1"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
