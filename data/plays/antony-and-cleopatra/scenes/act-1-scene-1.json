          "start": 8,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 315586,
        "end": 315673,
        "line": 10532,
        "column": 1,
        "path": "chap03/p@7847",
        "anchor": "sceneI_3.1"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@7938",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nI’ll set a bourn how far to be beloved.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
