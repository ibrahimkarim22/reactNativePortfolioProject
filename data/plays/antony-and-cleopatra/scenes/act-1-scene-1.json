        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@8633",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nHow, my love?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8633/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8633/line-2",
          "start": 8,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 316372,
        "end": 316423,
        "line": 10571,
        "column": 1,
        "path": "chap03/p@8633",
        "anchor": "sceneI_3.1"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@8688",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nPerchance! Nay, and most like.\nYou must not stay here longer; your dismission\nIs come from Caesar; therefore hear it, Antony.\nWhere’s Fulvia’s process?—Caesar’s I would say? Both?\nCall in the messengers. As I am Egypt’s queen,\nThou blushest, Antony, and that blood of thine\nIs Caesar’s homager; else so thy cheek pays shame\nWhen shrill-tongued Fulvia scolds. The messengers!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8688/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8688/line-2",
          "start": 11,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8688/line-3",
          "start": 42,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8688/line-4",
          "start": 89,
          "end": 136,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8688/line-5",
          "start": 137,
          "end": 190,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8688/line-6",
          "start": 191,
          "end": 237,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8688/line-7",
          "start": 238,
          "end": 284,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8688/line-8",
          "start": 285,
          "end": 334,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@8688/line-9",
          "start": 335,
          "end": 385,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 316427,
        "end": 316877,
        "line": 10576,
        "column": 1,
        "path": "chap03/p@8688",
        "anchor": "sceneI_3.1"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
