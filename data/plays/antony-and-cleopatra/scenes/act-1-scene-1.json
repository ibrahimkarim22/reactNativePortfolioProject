    },
    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@9729",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nBut stirred by Cleopatra.\nNow, for the love of Love and her soft hours,\nLet’s not confound the time with conference harsh.\nThere’s not a minute of our lives should stretch\nWithout some pleasure now. What sport tonight?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
