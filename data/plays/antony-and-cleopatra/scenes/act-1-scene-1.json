    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@9553",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nExcellent falsehood!\nWhy did he marry Fulvia, and not love her?\nI’ll seem the fool I am not. Antony\nWill be himself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@9553/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
