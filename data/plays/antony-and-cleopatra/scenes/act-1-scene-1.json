    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@7570",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Look where they come:\nTake but good note, and you shall see in him\nThe triple pillar of the world transform’d\nInto a strumpet’s fool. Behold and see.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
