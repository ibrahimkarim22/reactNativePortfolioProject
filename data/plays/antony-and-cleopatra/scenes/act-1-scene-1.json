      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nHear the ambassadors.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@10009/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@10009/line-2",
          "start": 11,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 317748,
        "end": 317810,
        "line": 10617,
        "column": 1,
        "path": "chap03/p@10009",
        "anchor": "sceneI_3.1"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@10075",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nFie, wrangling queen!\nWhom everything becomes—to chide, to laugh,\nTo weep; whose every passion fully strives\nTo make itself, in thee fair and admired!\nNo messenger but thine, and all alone\nTonight we’ll wander through the streets and note\nThe qualities of people. Come, my queen,\nLast night you did desire it. Speak not to us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@10075/line-1",
          "start": 0,
          "end": 7,
