    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@7847",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nThere’s beggary in the love that can be reckoned.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@7847/line-1",
