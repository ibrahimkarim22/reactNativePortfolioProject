    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@10619",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DEMETRIUS.\nIs Caesar with Antonius prized so slight?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@10619/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@10619/line-2",
          "start": 11,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 318358,
        "end": 318440,
        "line": 10638,
        "column": 1,
        "path": "chap03/p@10619",
        "anchor": "sceneI_3.1"
      },
      "speakerLabel": "DEMETRIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@10705",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PHILO.\nSir, sometimes when he is not Antony,\nHe comes too short of that great property\nWhich still should go with Antony.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@10705/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@10705/line-2",
          "start": 7,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@10705/line-3",
          "start": 45,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@10705/line-4",
          "start": 87,
          "end": 121,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 318444,
        "end": 318605,
        "line": 10643,
        "column": 1,
        "path": "chap03/p@10705",
        "anchor": "sceneI_3.1"
      },
      "speakerLabel": "PHILO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.1/p@10870",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DEMETRIUS.\nI am full sorry\nThat he approves the common liar who\nThus speaks of him at Rome, but I will hope\nOf better deeds tomorrow. Rest you happy!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
