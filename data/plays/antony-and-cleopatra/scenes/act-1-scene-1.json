          "start": 11,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@9553/line-3",
          "start": 32,
          "end": 74,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@9553/line-4",
          "start": 75,
          "end": 110,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.1/p@9553/line-5",
          "start": 111,
          "end": 127,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 317292,
        "end": 317464,
        "line": 10600,
        "column": 1,
