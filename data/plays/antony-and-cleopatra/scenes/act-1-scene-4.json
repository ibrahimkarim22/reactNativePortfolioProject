    {
      "id": "antony-and-cleopatra/sceneI_3.4/p@32298",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEPIDUS.\nI must not think there are\nEvils enough to darken all his goodness.\nHis faults in him seem as the spots of heaven,\nMore fiery by night’s blackness; hereditary\nRather than purchased; what he cannot change\nThan what he chooses.",
