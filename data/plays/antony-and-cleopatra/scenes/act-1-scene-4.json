      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEPIDUS.\nTomorrow, Caesar,\nI shall be furnished to inform you rightly\nBoth what by sea and land I can be able\nTo front this present time.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
