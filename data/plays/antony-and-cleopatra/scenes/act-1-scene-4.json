      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nTill which encounter\nIt is my business too. Farewell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
