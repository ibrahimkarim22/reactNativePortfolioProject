    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@37870",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nIndeed?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@37870/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
