          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 347738,
        "end": 347805,
        "line": 11904,
        "column": 1,
        "path": "chap03/p@39999",
        "anchor": "sceneI_3.5"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
