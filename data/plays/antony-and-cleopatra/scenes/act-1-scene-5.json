      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nMine ear must pluck it thence.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39478/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39478/line-2",
          "start": 11,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 347217,
        "end": 347288,
        "line": 11886,
        "column": 1,
        "path": "chap03/p@39478",
        "anchor": "sceneI_3.5"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@39553",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALEXAS.\n“Good friend,” quoth he,\n“Say, the firm Roman to great Egypt sends\nThis treasure of an oyster; at whose foot,\nTo mend the petty present, I will piece\nHer opulent throne with kingdoms. All the east,\nSay thou, shall call her mistress.” So he nodded\nAnd soberly did mount an arm-gaunt steed,\nWho neighed so high that what I would have spoke\nWas beastly dumbed by him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39553/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
