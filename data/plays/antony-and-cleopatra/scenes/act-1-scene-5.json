      ],
      "sourceRef": {
        "start": 345609,
        "end": 345657,
        "line": 11828,
        "column": 1,
        "path": "chap03/p@37870",
        "anchor": "sceneI_3.5"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@37922",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARDIAN.\nNot in deed, madam, for I can do nothing\nBut what indeed is honest to be done.\nYet have I fierce affections, and think\nWhat Venus did with Mars.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@37922/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@37922/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@37922/line-3",
          "start": 50,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@37922/line-4",
          "start": 88,
          "end": 127,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@37922/line-5",
          "start": 128,
          "end": 153,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 345661,
        "end": 345859,
        "line": 11833,
        "column": 1,
        "path": "chap03/p@37922",
        "anchor": "sceneI_3.5"
      },
      "speakerLabel": "MARDIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@38124",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nO, Charmian,\nWhere think’st thou he is now? Stands he, or sits he?\nOr does he walk? Or is he on his horse?\nO happy horse, to bear the weight of Antony!\nDo bravely, horse, for wot’st thou whom thou mov’st?\nThe demi-Atlas of this earth, the arm\nAnd burgonet of men. He’s speaking now,\nOr murmuring “Where’s my serpent of old Nile?”\nFor so he calls me. Now I feed myself\nWith most delicious poison. Think on me\nThat am with Phœbus’ amorous pinches black,\nAnd wrinkled deep in time? Broad-fronted Caesar,\nWhen thou wast here above the ground, I was\nA morsel for a monarch. And great Pompey\nWould stand and make his eyes grow in my brow;\nThere would he anchor his aspect, and die\nWith looking on his life.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@38124/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
