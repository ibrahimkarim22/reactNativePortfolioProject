        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@40209",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nO well-divided disposition!—Note him,\nNote him, good Charmian, ’tis the man; but note him:\nHe was not sad, for he would shine on those\nThat make their looks by his; he was not merry,\nWhich seemed to tell them his remembrance lay\nIn Egypt with his joy; but between both.\nO heavenly mingle!—Be’st thou sad or merry,\nThe violence of either thee becomes,\nSo does it no man else.—Met’st thou my posts?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40209/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40209/line-2",
          "start": 11,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40209/line-3",
          "start": 49,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40209/line-4",
          "start": 102,
          "end": 145,
          "sourceLineNumber": null
        },
        {
