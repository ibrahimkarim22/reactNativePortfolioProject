    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@39092",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nHow much unlike art thou Mark Antony!\nYet, coming from him, that great medicine hath\nWith his tinct gilded thee.\nHow goes it with my brave Mark Antony?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39092/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39092/line-2",
          "start": 11,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39092/line-3",
          "start": 49,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39092/line-4",
          "start": 96,
          "end": 123,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39092/line-5",
          "start": 124,
          "end": 162,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 346831,
        "end": 347038,
        "line": 11871,
        "column": 1,
        "path": "chap03/p@39092",
        "anchor": "sceneI_3.5"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@39303",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALEXAS.\nLast thing he did, dear queen,\nHe kissed—the last of many doubled kisses—\nThis orient pearl. His speech sticks in my heart.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39303/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39303/line-2",
          "start": 8,
          "end": 38,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39303/line-3",
          "start": 39,
          "end": 81,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39303/line-4",
          "start": 82,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 347042,
        "end": 347213,
        "line": 11879,
        "column": 1,
        "path": "chap03/p@39303",
        "anchor": "sceneI_3.5"
      },
      "speakerLabel": "ALEXAS.",
      "attribution": {
