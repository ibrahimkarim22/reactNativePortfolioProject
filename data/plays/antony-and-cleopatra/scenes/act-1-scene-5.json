      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALEXAS.\nSovereign of Egypt, hail!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39025/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39025/line-2",
          "start": 8,
          "end": 33,
          "sourceLineNumber": null
