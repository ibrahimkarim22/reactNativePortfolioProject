      "sourceRef": {
        "start": 345230,
        "end": 345300,
        "line": 11810,
        "column": 1,
        "path": "chap03/p@37491",
        "anchor": "sceneI_3.5"
      },
      "speakerLabel": "MARDIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@37565",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nNot now to hear thee sing. I take no pleasure\nIn aught an eunuch has. ’Tis well for thee\nThat, being unseminared, thy freer thoughts\nMay not fly forth of Egypt. Hast thou affections?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
