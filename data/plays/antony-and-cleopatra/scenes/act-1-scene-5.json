    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@40690",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALEXAS.\nAy, madam, twenty several messengers.\nWhy do you send so thick?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40690/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40690/line-2",
          "start": 8,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40690/line-3",
          "start": 46,
          "end": 71,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 348429,
        "end": 348535,
        "line": 11928,
        "column": 1,
        "path": "chap03/p@40690",
        "anchor": "sceneI_3.5"
      },
      "speakerLabel": "ALEXAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@40800",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nWho’s born that day\nWhen I forget to send to Antony\nShall die a beggar.—Ink and paper, Charmian.—\nWelcome, my good Alexas.—Did I, Charmian,\nEver love Caesar so?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40800/line-1",
          "start": 0,
          "end": 10,
