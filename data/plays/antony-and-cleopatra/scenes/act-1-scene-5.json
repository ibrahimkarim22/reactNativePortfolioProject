      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARDIAN.\nWhat’s your highness’ pleasure?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@37491/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
