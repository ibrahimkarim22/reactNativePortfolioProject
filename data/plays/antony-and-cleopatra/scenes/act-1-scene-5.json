        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneI_3.5/p@40070",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALEXAS.\nLike to the time o’ th’ year between the extremes\nOf hot and cold, he was nor sad nor merry.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40070/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40070/line-2",
          "start": 8,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@40070/line-3",
          "start": 58,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 347809,
        "end": 347944,
        "line": 11909,
        "column": 1,
        "path": "chap03/p@40070",
        "anchor": "sceneI_3.5"
      },
      "speakerLabel": "ALEXAS.",
      "attribution": {
