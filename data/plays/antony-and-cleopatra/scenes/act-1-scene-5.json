      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nWhat, was he sad or merry?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@39999/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
