      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARMIAN.\nBy your most gracious pardon,\nI sing but after you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneI_3.5/p@41405/line-1",
