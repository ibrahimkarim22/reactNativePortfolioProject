        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.1/p@43792",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Varrius.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@43792/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 351531,
        "end": 351604,
        "line": 12066,
        "column": 1,
        "path": "chap03/p@43792",
        "anchor": "sceneII_3.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.1/p@43869",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "How now, Varrius!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@43869/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 351608,
        "end": 351650,
        "line": 12070,
        "column": 1,
        "path": "chap03/p@43869",
        "anchor": "sceneII_3.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.1/p@43915",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VARRIUS.\nThis is most certain that I shall deliver:\nMark Antony is every hour in Rome\nExpected. Since he went from Egypt ’tis\nA space for farther travel.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@43915/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@43915/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@43915/line-3",
          "start": 52,
          "end": 85,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@43915/line-4",
          "start": 86,
          "end": 125,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@43915/line-5",
          "start": 126,
          "end": 153,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 351654,
        "end": 351852,
        "line": 12074,
        "column": 1,
        "path": "chap03/p@43915",
        "anchor": "sceneII_3.1"
      },
      "speakerLabel": "VARRIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.1/p@44117",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "POMPEY.\nI could have given less matter\nA better ear.—Menas, I did not think\nThis amorous surfeiter would have donned his helm\nFor such a petty war. His soldiership\nIs twice the other twain. But let us rear\nThe higher our opinion, that our stirring\nCan from the lap of Egypt’s widow pluck\nThe ne’er lust-wearied Antony.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@44117/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@44117/line-2",
          "start": 8,
          "end": 38,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@44117/line-3",
          "start": 39,
          "end": 75,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@44117/line-4",
          "start": 76,
          "end": 125,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@44117/line-5",
