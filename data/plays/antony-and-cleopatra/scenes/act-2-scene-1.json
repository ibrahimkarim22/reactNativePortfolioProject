    {
      "id": "antony-and-cleopatra/sceneII_3.1/p@44504",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENAS.\nI cannot hope\nCaesar and Antony shall well greet together.\nHis wife that’s dead did trespasses to Caesar;\nHis brother warred upon him, although I think,\nNot moved by Antony.",
