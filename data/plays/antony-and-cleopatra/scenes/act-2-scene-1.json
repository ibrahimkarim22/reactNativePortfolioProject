          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.1/p@43330/line-10",
          "start": 359,
          "end": 388,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 351069,
        "end": 351527,
        "line": 12053,
