      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OCTAVIA.\nAll which time\nBefore the gods my knee shall bow my prayers\nTo them for you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@61229/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
