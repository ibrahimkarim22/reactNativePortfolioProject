    },
    {
      "id": "antony-and-cleopatra/sceneII_3.3/p@61358",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nGood night, sir.—My Octavia,\nRead not my blemishes in the world’s report.\nI have not kept my square, but that to come\nShall all be done by th’ rule. Good night, dear lady.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
