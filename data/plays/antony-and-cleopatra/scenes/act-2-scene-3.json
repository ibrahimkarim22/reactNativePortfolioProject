    {
      "id": "antony-and-cleopatra/sceneII_3.3/p@61902",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nNow, sirrah, you do wish yourself in Egypt?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@61902/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@61902/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 369641,
        "end": 369722,
        "line": 12830,
        "column": 1,
        "path": "chap03/p@61902",
        "anchor": "sceneII_3.3"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.3/p@61987",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOOTHSAYER.\nWould I had never come from thence, nor you thither!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@61987/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@61987/line-2",
          "start": 12,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 369726,
        "end": 369820,
        "line": 12835,
        "column": 1,
        "path": "chap03/p@61987",
        "anchor": "sceneII_3.3"
      },
      "speakerLabel": "SOOTHSAYER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.3/p@62085",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nIf you can, your reason.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62085/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62085/line-2",
          "start": 8,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 369824,
        "end": 369886,
        "line": 12840,
        "column": 1,
        "path": "chap03/p@62085",
        "anchor": "sceneII_3.3"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.3/p@62151",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOOTHSAYER.\nI see it in my motion, have it not in my tongue.\nBut yet hie you to Egypt again.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62151/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62151/line-2",
          "start": 12,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62151/line-3",
          "start": 61,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 369890,
        "end": 370017,
        "line": 12845,
        "column": 1,
        "path": "chap03/p@62151",
        "anchor": "sceneII_3.3"
      },
      "speakerLabel": "SOOTHSAYER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.3/p@62282",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nSay to me,\nWhose fortunes shall rise higher, Caesar’s or mine?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62282/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62282/line-2",
          "start": 8,
          "end": 18,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62282/line-3",
          "start": 19,
          "end": 70,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 370021,
        "end": 370126,
        "line": 12851,
        "column": 1,
        "path": "chap03/p@62282",
        "anchor": "sceneII_3.3"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.3/p@62391",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOOTHSAYER.\nCaesar’s.\nTherefore, O Antony, stay not by his side.\nThy dæmon—that thy spirit which keeps thee—is\nNoble, courageous, high, unmatchable,\nWhere Caesar’s is not. But near him, thy angel\nBecomes afeard, as being o’erpowered. Therefore\nMake space enough between you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62391/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62391/line-2",
          "start": 12,
          "end": 21,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62391/line-3",
          "start": 22,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62391/line-4",
          "start": 65,
          "end": 110,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62391/line-5",
          "start": 111,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62391/line-6",
          "start": 149,
          "end": 195,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62391/line-7",
          "start": 196,
          "end": 243,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62391/line-8",
          "start": 244,
          "end": 274,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 370130,
        "end": 370464,
        "line": 12857,
        "column": 1,
        "path": "chap03/p@62391",
        "anchor": "sceneII_3.3"
      },
      "speakerLabel": "SOOTHSAYER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.3/p@62729",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nSpeak this no more.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62729/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62729/line-2",
          "start": 8,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 370468,
        "end": 370525,
        "line": 12868,
        "column": 1,
        "path": "chap03/p@62729",
        "anchor": "sceneII_3.3"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.3/p@62790",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOOTHSAYER.\nTo none but thee; no more but when to thee.\nIf thou dost play with him at any game,\nThou art sure to lose; and of that natural luck\nHe beats thee ’gainst the odds. Thy lustre thickens\nWhen he shines by. I say again, thy spirit\nIs all afraid to govern thee near him;\nBut, he away, ’tis noble.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62790/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62790/line-2",
          "start": 12,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62790/line-3",
          "start": 56,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62790/line-4",
          "start": 96,
          "end": 143,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62790/line-5",
          "start": 144,
          "end": 195,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.3/p@62790/line-6",
