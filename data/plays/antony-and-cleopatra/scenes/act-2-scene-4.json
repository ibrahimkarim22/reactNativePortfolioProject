  "content": [
    {
      "id": "antony-and-cleopatra-2-4-stage-001",
      "type": "stage",
      "text": "Enter Lepidus, Maecenas and Agrippa."
    },
    {
      "id": "antony-and-cleopatra-2-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lepidus",
        "name": "LEPIDUS",
        "displayName": "Lepidus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Trouble yourselves no further. Pray you hasten",
          "plainText": "Trouble yourselves no further Pray you hasten",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Your generals after.",
          "plainText": "Your generals after",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Sir, Mark Antony",
          "plainText": "Sir Mark Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-4-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Will e'en but kiss Octavia, and we'll follow.",
          "plainText": "Will e'en but kiss Octavia and we'll follow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lepidus",
        "name": "LEPIDUS",
        "displayName": "Lepidus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Till I shall see you in your soldier's dress,",
          "plainText": "Till I shall see you in your soldier's dress",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-4-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Which will become you both, farewell.",
          "plainText": "Which will become you both farewell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "maecenas",
        "name": "MAECENAS",
        "displayName": "Maecenas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "We shall,",
          "plainText": "We shall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-4-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "As I conceive the journey, be at the Mount",
          "plainText": "As I conceive the journey be at the Mount",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-4-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Before you, Lepidus.",
          "plainText": "Before you Lepidus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lepidus",
        "name": "LEPIDUS",
        "displayName": "Lepidus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Your way is shorter;",
          "plainText": "Your way is shorter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-4-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "My purposes do draw me much about.",
          "plainText": "My purposes do draw me much about",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-4-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "You'll win two days upon me.",
          "plainText": "You'll win two days upon me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "both",
        "name": "BOTH",
        "displayName": "Both"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Sir, good success!",
          "plainText": "Sir good success",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lepidus",
        "name": "LEPIDUS",
        "displayName": "Lepidus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Farewell.",
          "plainText": "Farewell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
