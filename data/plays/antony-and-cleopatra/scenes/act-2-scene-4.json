    {
      "id": "antony-and-cleopatra/sceneII_3.4/p@64248",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEPIDUS.\nTrouble yourselves no further. Pray you hasten\nYour generals after.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64248/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64248/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64248/line-3",
          "start": 56,
          "end": 76,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 371987,
        "end": 372098,
        "line": 12926,
        "column": 1,
        "path": "chap03/p@64248",
        "anchor": "sceneII_3.4"
      },
      "speakerLabel": "LEPIDUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.4/p@64363",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AGRIPPA.\nSir, Mark Antony\nWill e’en but kiss Octavia, and we’ll follow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64363/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64363/line-2",
          "start": 9,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64363/line-3",
          "start": 26,
          "end": 71,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 372102,
        "end": 372208,
        "line": 12932,
        "column": 1,
        "path": "chap03/p@64363",
        "anchor": "sceneII_3.4"
      },
      "speakerLabel": "AGRIPPA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.4/p@64473",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEPIDUS.\nTill I shall see you in your soldier’s dress,\nWhich will become you both, farewell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64473/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64473/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64473/line-3",
          "start": 55,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 372212,
        "end": 372339,
        "line": 12938,
        "column": 1,
        "path": "chap03/p@64473",
        "anchor": "sceneII_3.4"
      },
      "speakerLabel": "LEPIDUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.4/p@64604",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MAECENAS.\nWe shall,\nAs I conceive the journey, be at the Mount\nBefore you, Lepidus.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64604/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
