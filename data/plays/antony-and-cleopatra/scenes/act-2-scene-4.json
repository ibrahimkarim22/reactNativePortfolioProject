        "end": 372603,
        "line": 12951,
        "column": 1,
        "path": "chap03/p@64731",
        "anchor": "sceneII_3.4"
      },
      "speakerLabel": "LEPIDUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
