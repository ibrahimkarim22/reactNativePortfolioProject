          "start": 20,
          "end": 62,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64604/line-4",
          "start": 63,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 372343,
        "end": 372466,
        "line": 12944,
        "column": 1,
        "path": "chap03/p@64604",
        "anchor": "sceneII_3.4"
      },
      "speakerLabel": "MAECENAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "antony-and-cleopatra/sceneII_3.4/p@64731",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEPIDUS.\nYour way is shorter;\nMy purposes do draw me much about.\nYou’ll win two days upon me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneII_3.4/p@64731/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
