    {
      "id": "antony-and-cleopatra/sceneIII_3.1/p@96089",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VENTIDIUS.\nHe purposeth to Athens, whither, with what haste\nThe weight we must convey with ’s will permit,\nWe shall appear before him.—On there, pass along!",
      "separatorAfter": "\n\n",
