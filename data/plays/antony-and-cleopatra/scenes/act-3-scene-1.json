    {
      "id": "antony-and-cleopatra/sceneIII_3.1/p@95593",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SILIUS.\nThou hast, Ventidius, that\nWithout the which a soldier and his sword\nGrants scarce distinction. Thou wilt write to Antony?",
