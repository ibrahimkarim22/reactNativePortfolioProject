    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@123781",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Alarum. Enter Enobarbus.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 14,
          "end": 23,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@123781/line-1",
          "start": 0,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 431520,
        "end": 431603,
        "line": 15667,
        "column": 1,
        "path": "chap03/p@123781",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@123868",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nNaught, naught, all naught! I can behold no longer.\nTh’ Antoniad, the Egyptian admiral,\nWith all their sixty, fly and turn the rudder.\nTo see ’t mine eyes are blasted.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@123868/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@123868/line-2",
          "start": 11,
          "end": 62,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@123868/line-3",
          "start": 63,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@123868/line-4",
          "start": 99,
          "end": 145,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@123868/line-5",
          "start": 146,
          "end": 178,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 431607,
        "end": 431830,
        "line": 15671,
        "column": 1,
        "path": "chap03/p@123868",
