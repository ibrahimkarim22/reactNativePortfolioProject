      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCARUS.\n’Tis easy to’t, and there I will attend\nWhat further comes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
