      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@124095",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Scarus.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 12,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124095/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 431834,
        "end": 431906,
        "line": 15679,
        "column": 1,
        "path": "chap03/p@124095",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@124171",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCARUS.\nGods and goddesses,\nAll the whole synod of them!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124171/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124171/line-2",
          "start": 8,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124171/line-3",
          "start": 28,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 431910,
        "end": 432001,
        "line": 15683,
        "column": 1,
        "path": "chap03/p@124171",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": "SCARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@124266",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nWhat’s thy passion?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124266/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124266/line-2",
          "start": 11,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 432005,
        "end": 432065,
        "line": 15689,
        "column": 1,
        "path": "chap03/p@124266",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@124330",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCARUS.\nThe greater cantle of the world is lost\nWith very ignorance. We have kissed away\nKingdoms and provinces.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124330/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124330/line-2",
          "start": 8,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124330/line-3",
          "start": 48,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124330/line-4",
          "start": 89,
          "end": 112,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 432069,
        "end": 432221,
        "line": 15694,
        "column": 1,
        "path": "chap03/p@124330",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": "SCARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@124486",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nHow appears the fight?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124486/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124486/line-2",
          "start": 11,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 432225,
        "end": 432288,
        "line": 15701,
        "column": 1,
        "path": "chap03/p@124486",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@124553",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCARUS.\nOn our side, like the tokened pestilence,\nWhere death is sure. Yon ribaudred nag of Egypt,\nWhom leprosy o’ertake, i’ th’ midst o’ th’ fight,\nWhen vantage like a pair of twins appeared,\nBoth as the same—or, rather, ours the elder—\nThe breeze upon her, like a cow in June,\nHoists sails and flies.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124553/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124553/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124553/line-3",
          "start": 50,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124553/line-4",
          "start": 99,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124553/line-5",
          "start": 149,
          "end": 192,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124553/line-6",
          "start": 193,
          "end": 237,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124553/line-7",
          "start": 238,
          "end": 278,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124553/line-8",
          "start": 279,
          "end": 302,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 432292,
        "end": 432654,
        "line": 15706,
        "column": 1,
        "path": "chap03/p@124553",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": "SCARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@124919",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nThat I beheld.\nMine eyes did sicken at the sight and could not\nEndure a further view.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124919/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124919/line-2",
          "start": 11,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124919/line-3",
          "start": 26,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@124919/line-4",
          "start": 74,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 432658,
        "end": 432794,
        "line": 15717,
        "column": 1,
        "path": "chap03/p@124919",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@125059",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCARUS.\nShe once being loofed,\nThe noble ruin of her magic, Antony,\nClaps on his sea-wing and, like a doting mallard,\nLeaving the fight in height, flies after her.\nI never saw an action of such shame.\nExperience, manhood, honour, ne’er before\nDid violate so itself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125059/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125059/line-2",
          "start": 8,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125059/line-3",
          "start": 31,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125059/line-4",
          "start": 68,
          "end": 117,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125059/line-5",
          "start": 118,
          "end": 163,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125059/line-6",
          "start": 164,
          "end": 200,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125059/line-7",
          "start": 201,
          "end": 242,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125059/line-8",
          "start": 243,
          "end": 265,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 432798,
        "end": 433123,
        "line": 15724,
        "column": 1,
        "path": "chap03/p@125059",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": "SCARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@125388",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nAlack, alack!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125388/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125388/line-2",
          "start": 11,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 433127,
        "end": 433181,
        "line": 15735,
        "column": 1,
        "path": "chap03/p@125388",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@125446",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Canidius.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125446/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 433185,
        "end": 433259,
        "line": 15740,
        "column": 1,
        "path": "chap03/p@125446",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@125524",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CANIDIUS.\nOur fortune on the sea is out of breath\nAnd sinks most lamentably. Had our general\nBeen what he knew himself, it had gone well.\nO, he has given example for our flight\nMost grossly by his own!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125524/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125524/line-2",
          "start": 10,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125524/line-3",
          "start": 50,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125524/line-4",
          "start": 93,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125524/line-5",
          "start": 138,
          "end": 176,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125524/line-6",
          "start": 177,
          "end": 201,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 433263,
        "end": 433514,
        "line": 15744,
        "column": 1,
        "path": "chap03/p@125524",
        "anchor": "sceneIII_3.10"
      },
      "speakerLabel": "CANIDIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.10/p@125779",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nAy, are you thereabouts?\nWhy, then, good night indeed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@125779/line-1",
