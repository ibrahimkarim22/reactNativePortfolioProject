          "end": 72,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 91,
          "end": 98,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.10/p@123471/line-1",
