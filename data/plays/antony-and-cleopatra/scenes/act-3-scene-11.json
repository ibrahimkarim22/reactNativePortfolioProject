      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nThe Queen, my lord, the Queen!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129082/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129082/line-2",
          "start": 6,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 436821,
        "end": 436887,
        "line": 15905,
        "column": 1,
        "path": "chap03/p@129082",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@129152",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IRAS.\nGo to him, madam; speak to him.\nHe is unqualitied with very shame.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129152/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129152/line-2",
          "start": 6,
          "end": 37,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129152/line-3",
          "start": 38,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 436891,
        "end": 436998,
        "line": 15910,
        "column": 1,
        "path": "chap03/p@129152",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "IRAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@129263",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nWell then, sustain me. O!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129263/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129263/line-2",
          "start": 11,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 437002,
        "end": 437068,
        "line": 15916,
        "column": 1,
        "path": "chap03/p@129263",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@129333",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nMost noble sir, arise. The Queen approaches.\nHer head’s declined, and death will seize her but\nYour comfort makes the rescue.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129333/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129333/line-2",
          "start": 6,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129333/line-3",
          "start": 51,
          "end": 100,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129333/line-4",
          "start": 101,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 437072,
        "end": 437243,
        "line": 15921,
        "column": 1,
        "path": "chap03/p@129333",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@129508",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nI have offended reputation,\nA most unnoble swerving.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129508/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129508/line-2",
          "start": 8,
          "end": 35,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129508/line-3",
          "start": 36,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 437247,
        "end": 437342,
        "line": 15928,
        "column": 1,
        "path": "chap03/p@129508",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@129607",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nSir, the Queen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129607/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129607/line-2",
          "start": 6,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 437346,
        "end": 437397,
        "line": 15934,
        "column": 1,
        "path": "chap03/p@129607",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@129662",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nO, whither hast thou led me, Egypt? See\nHow I convey my shame out of thine eyes\nBy looking back what I have left behind\n’Stroyed in dishonour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129662/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129662/line-2",
          "start": 8,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129662/line-3",
          "start": 48,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129662/line-4",
          "start": 88,
          "end": 127,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129662/line-5",
          "start": 128,
          "end": 150,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 437401,
        "end": 437596,
        "line": 15939,
        "column": 1,
        "path": "chap03/p@129662",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@129861",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nO my lord, my lord,\nForgive my fearful sails! I little thought\nYou would have followed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129861/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129861/line-2",
          "start": 11,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129861/line-3",
          "start": 31,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@129861/line-4",
          "start": 74,
          "end": 98,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 437600,
        "end": 437738,
        "line": 15947,
        "column": 1,
        "path": "chap03/p@129861",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@130003",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nEgypt, thou knew’st too well\nMy heart was to thy rudder tied by th’ strings,\nAnd thou shouldst tow me after. O’er my spirit\nThy full supremacy thou knew’st, and that\nThy beck might from the bidding of the gods\nCommand me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130003/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130003/line-2",
          "start": 8,
          "end": 36,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130003/line-3",
          "start": 37,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130003/line-4",
          "start": 85,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130003/line-5",
          "start": 132,
          "end": 173,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130003/line-6",
          "start": 174,
          "end": 217,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130003/line-7",
          "start": 218,
          "end": 229,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 437742,
        "end": 438026,
        "line": 15954,
        "column": 1,
        "path": "chap03/p@130003",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@130291",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nO, my pardon!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130291/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130291/line-2",
          "start": 11,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 438030,
        "end": 438084,
        "line": 15964,
        "column": 1,
        "path": "chap03/p@130291",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@130349",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nNow I must\nTo the young man send humble treaties, dodge\nAnd palter in the shifts of lowness, who\nWith half the bulk o’ th’ world played as I pleased,\nMaking and marring fortunes. You did know\nHow much you were my conqueror, and that\nMy sword, made weak by my affection, would\nObey it on all cause.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130349/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130349/line-2",
          "start": 8,
          "end": 18,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130349/line-3",
          "start": 19,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130349/line-4",
          "start": 64,
          "end": 104,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130349/line-5",
          "start": 105,
          "end": 157,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130349/line-6",
          "start": 158,
          "end": 199,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130349/line-7",
          "start": 200,
          "end": 240,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130349/line-8",
          "start": 241,
          "end": 283,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130349/line-9",
          "start": 284,
          "end": 305,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 438088,
        "end": 438458,
        "line": 15969,
        "column": 1,
        "path": "chap03/p@130349",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@130723",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nPardon, pardon!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130723/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130723/line-2",
          "start": 11,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 438462,
        "end": 438518,
        "line": 15981,
        "column": 1,
        "path": "chap03/p@130723",
        "anchor": "sceneIII_3.11"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@130783",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nFall not a tear, I say; one of them rates\nAll that is won and lost. Give me a kiss.\nEven this repays me.\nWe sent our schoolmaster. Is he come back?\nLove, I am full of lead. Some wine\nWithin there, and our viands! Fortune knows\nWe scorn her most when most she offers blows.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130783/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@130783/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
