          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@128704/line-3",
          "start": 47,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@128704/line-4",
          "start": 92,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@128704/line-5",
          "start": 135,
          "end": 170,
          "sourceLineNumber": null
        },
