    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.11/p@128704",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nYes, my lord, yes. He at Philippi kept\nHis sword e’en like a dancer, while I struck\nThe lean and wrinkled Cassius, and ’twas I\nThat the mad Brutus ended. He alone\nDealt on lieutenantry, and no practice had\nIn the brave squares of war. Yet now—no matter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@128704/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.11/p@128704/line-2",
