    {
      "id": "antony-and-cleopatra/sceneIII_3.12/p@133105",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "[To Thidias.] To try thy eloquence now ’tis time. Dispatch.\nFrom Antony win Cleopatra. Promise,\nAnd in our name, what she requires; add more,\nFrom thine invention, offers. Women are not\nIn their best fortunes strong, but want will perjure\nThe ne’er-touch’d vestal. Try thy cunning, Thidias;\nMake thine own edict for thy pains, which we\nWill answer as a law.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 11
        }
      ],
      "lines": [
