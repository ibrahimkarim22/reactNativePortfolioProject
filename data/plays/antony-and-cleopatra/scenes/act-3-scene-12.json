          "start": 46,
          "end": 80,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@131862/line-4",
          "start": 81,
          "end": 118,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@131862/line-5",
          "start": 119,
          "end": 136,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 439601,
        "end": 439782,
        "line": 16031,
        "column": 1,
        "path": "chap03/p@131862",
        "anchor": "sceneIII_3.12"
      },
