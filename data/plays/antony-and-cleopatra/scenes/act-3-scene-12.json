          "start": 54,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@132119/line-4",
          "start": 100,
          "end": 141,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@132119/line-5",
          "start": 142,
          "end": 191,
          "sourceLineNumber": null
        },
        {
