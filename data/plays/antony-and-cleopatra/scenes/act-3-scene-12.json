      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.12/p@132047",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nBe’t so. Declare thine office.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@132047/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@132047/line-2",
          "start": 8,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 439786,
        "end": 439854,
        "line": 16039,
        "column": 1,
        "path": "chap03/p@132047",
        "anchor": "sceneIII_3.12"
      },
      "speakerLabel": "CAESAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.12/p@132119",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AMBASSADOR.\nLord of his fortunes he salutes thee, and\nRequires to live in Egypt, which not granted,\nHe lessens his requests, and to thee sues\nTo let him breathe between the heavens and earth,\nA private man in Athens. This for him.\nNext, Cleopatra does confess thy greatness,\nSubmits her to thy might, and of thee craves\nThe circle of the Ptolemies for her heirs,\nNow hazarded to thy grace.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@132119/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@132119/line-2",
          "start": 12,
          "end": 53,
          "sourceLineNumber": null
        },
        {
