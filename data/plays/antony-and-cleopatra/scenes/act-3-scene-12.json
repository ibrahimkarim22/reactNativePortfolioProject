      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nLet him appear that’s come from Antony.\nKnow you him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@131362/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@131362/line-2",
          "start": 8,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@131362/line-3",
          "start": 48,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
