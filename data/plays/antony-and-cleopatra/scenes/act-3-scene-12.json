  "scene": {
    "id": "antony-and-cleopatra-3-12",
    "act": 3,
    "scene": 12,
    "label": "Act 3, Scene 12",
    "title": "SCENE XII. Caesar's camp in Egypt.",
    "location": "Caesar's camp in Egypt.",
    "orderInPlay": 24
  },
  "content": [
    {
      "id": "antony-and-cleopatra-3-12-stage-001",
      "type": "stage",
      "text": "Enter Caesar, Agrippa, Dolabella with others."
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-001",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Let him appear that's come from Antony.",
          "plainText": "Let him appear that's come from Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Know you him?",
          "plainText": "Know you him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-002",
      "type": "speech",
      "speaker": {
        "id": "dolabella",
        "name": "DOLABELLA",
        "displayName": "Dolabella"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Caesar, 'tis his schoolmaster—",
          "plainText": "Caesar 'tis his schoolmaster",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "An argument that he is plucked, when hither",
          "plainText": "An argument that he is plucked when hither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "He sends so poor a pinion of his wing,",
          "plainText": "He sends so poor a pinion of his wing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "Which had superfluous kings for messengers",
          "plainText": "Which had superfluous kings for messengers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0007",
          "number": 7,
          "speechLineNumber": 5,
          "text": "Not many moons gone by.",
          "plainText": "Not many moons gone by",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-stage-002",
      "type": "stage",
      "text": "Enter Ambassador from Anthony."
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-003",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Approach, and speak.",
          "plainText": "Approach and speak",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-004",
      "type": "speech",
      "speaker": {
        "id": "ambassador",
        "name": "AMBASSADOR",
        "displayName": "Ambassador"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Such as I am, I come from Antony.",
          "plainText": "Such as I am I come from Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "I was of late as petty to his ends",
          "plainText": "I was of late as petty to his ends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "As is the morn-dew on the myrtle leaf",
          "plainText": "As is the morndew on the myrtle leaf",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "To his grand sea.",
          "plainText": "To his grand sea",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-005",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Be't so. Declare thine office.",
          "plainText": "Be't so Declare thine office",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-006",
      "type": "speech",
      "speaker": {
        "id": "ambassador",
        "name": "AMBASSADOR",
        "displayName": "Ambassador"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Lord of his fortunes he salutes thee, and",
          "plainText": "Lord of his fortunes he salutes thee and",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Requires to live in Egypt, which not granted,",
          "plainText": "Requires to live in Egypt which not granted",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "He lessens his requests, and to thee sues",
          "plainText": "He lessens his requests and to thee sues",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "To let him breathe between the heavens and earth,",
          "plainText": "To let him breathe between the heavens and earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "A private man in Athens. This for him.",
          "plainText": "A private man in Athens This for him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0019",
          "number": 19,
          "speechLineNumber": 6,
          "text": "Next, Cleopatra does confess thy greatness,",
          "plainText": "Next Cleopatra does confess thy greatness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0020",
          "number": 20,
          "speechLineNumber": 7,
          "text": "Submits her to thy might, and of thee craves",
          "plainText": "Submits her to thy might and of thee craves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0021",
          "number": 21,
          "speechLineNumber": 8,
          "text": "The circle of the Ptolemies for her heirs,",
          "plainText": "The circle of the Ptolemies for her heirs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0022",
          "number": 22,
          "speechLineNumber": 9,
          "text": "Now hazarded to thy grace.",
          "plainText": "Now hazarded to thy grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-007",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "For Antony,",
          "plainText": "For Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "I have no ears to his request. The queen",
          "plainText": "I have no ears to his request The queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "Of audience nor desire shall fail, so she",
          "plainText": "Of audience nor desire shall fail so she",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "From Egypt drive her all-disgraced friend,",
          "plainText": "From Egypt drive her alldisgraced friend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "Or take his life there. This if she perform,",
          "plainText": "Or take his life there This if she perform",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0028",
          "number": 28,
          "speechLineNumber": 6,
          "text": "She shall not sue unheard. So to them both.",
          "plainText": "She shall not sue unheard So to them both",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-008",
      "type": "speech",
      "speaker": {
        "id": "ambassador",
        "name": "AMBASSADOR",
        "displayName": "Ambassador"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Fortune pursue thee!",
          "plainText": "Fortune pursue thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-009",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Bring him through the bands.",
          "plainText": "Bring him through the bands",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-stage-003",
      "type": "stage",
      "text": "[Exit Ambassador, attended.]"
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-010",
      "type": "speech",
      "speaker": {
        "id": "thidias",
        "name": "THIDIAS",
        "displayName": "Thidias"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Caesar, I go.",
          "plainText": "Caesar I go",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-011",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Observe how Antony becomes his flaw,",
          "plainText": "Observe how Antony becomes his flaw",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "And what thou think'st his very action speaks",
          "plainText": "And what thou think'st his very action speaks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-12-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "In every power that moves.",
          "plainText": "In every power that moves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-speech-012",
      "type": "speech",
      "speaker": {
        "id": "thidias",
        "name": "THIDIAS",
        "displayName": "Thidias"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-12-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Caesar, I shall.",
          "plainText": "Caesar I shall",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-12-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}