        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.12/p@131862",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AMBASSADOR.\nSuch as I am, I come from Antony.\nI was of late as petty to his ends\nAs is the morn-dew on the myrtle leaf\nTo his grand sea.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@131862/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.12/p@131862/line-2",
          "start": 12,
          "end": 45,
          "sourceLineNumber": null
        },
        {
