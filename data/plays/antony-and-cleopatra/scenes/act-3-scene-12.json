          "start": 8,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 439539,
        "end": 439597,
        "line": 16026,
        "column": 1,
        "path": "chap03/p@131800",
        "anchor": "sceneIII_3.12"
      },
      "speakerLabel": "CAESAR.",
      "attribution": {
        "status": "explicit",
