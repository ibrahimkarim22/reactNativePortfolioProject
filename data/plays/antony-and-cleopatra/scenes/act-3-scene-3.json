      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARMIAN.\nHath he seen majesty? Isis else defend,\nAnd serving you so long!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@105594/line-1",
