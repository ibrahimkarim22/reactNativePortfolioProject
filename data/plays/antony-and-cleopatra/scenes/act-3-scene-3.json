        "end": 409948,
        "line": 14709,
        "column": 1,
        "path": "chap03/p@102122",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@102213",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Come hither, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102213/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 409952,
        "end": 409994,
        "line": 14713,
        "column": 1,
        "path": "chap03/p@102213",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@102259",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALEXAS.\nGood majesty,\nHerod of Jewry dare not look upon you\nBut when you are well pleased.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102259/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102259/line-2",
          "start": 8,
          "end": 21,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102259/line-3",
          "start": 22,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102259/line-4",
          "start": 60,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 409998,
        "end": 410128,
        "line": 14717,
        "column": 1,
        "path": "chap03/p@102259",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "ALEXAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@102393",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nThat Herod’s head\nI’ll have! But how, when Antony is gone,\nThrough whom I might command it?—Come thou near.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102393/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102393/line-2",
          "start": 11,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102393/line-3",
          "start": 29,
          "end": 69,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102393/line-4",
          "start": 70,
          "end": 118,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 410132,
        "end": 410290,
        "line": 14724,
        "column": 1,
        "path": "chap03/p@102393",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@102555",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nMost gracious majesty!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102555/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102555/line-2",
          "start": 11,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 410294,
        "end": 410357,
        "line": 14731,
        "column": 1,
        "path": "chap03/p@102555",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@102622",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nDidst thou behold Octavia?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102622/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102622/line-2",
          "start": 11,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 410361,
        "end": 410428,
        "line": 14736,
        "column": 1,
        "path": "chap03/p@102622",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@102693",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nAy, dread queen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102693/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102693/line-2",
          "start": 11,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 410432,
        "end": 410489,
        "line": 14741,
        "column": 1,
        "path": "chap03/p@102693",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@102754",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nWhere?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102754/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102754/line-2",
          "start": 11,
          "end": 17,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 410493,
        "end": 410540,
        "line": 14746,
        "column": 1,
        "path": "chap03/p@102754",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@102805",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nMadam, in Rome\nI looked her in the face, and saw her led\nBetween her brother and Mark Antony.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102805/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102805/line-2",
          "start": 11,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102805/line-3",
          "start": 26,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102805/line-4",
          "start": 68,
          "end": 104,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 410544,
        "end": 410688,
        "line": 14751,
        "column": 1,
        "path": "chap03/p@102805",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@102953",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nIs she as tall as me?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102953/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@102953/line-2",
          "start": 11,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 410692,
        "end": 410754,
        "line": 14758,
        "column": 1,
        "path": "chap03/p@102953",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@103019",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nShe is not, madam.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103019/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103019/line-2",
          "start": 11,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 410758,
        "end": 410817,
        "line": 14763,
        "column": 1,
        "path": "chap03/p@103019",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@103082",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nDidst hear her speak? Is she shrill-tongued or low?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103082/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103082/line-2",
          "start": 11,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 410821,
        "end": 410913,
        "line": 14768,
        "column": 1,
        "path": "chap03/p@103082",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@103178",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nMadam, I heard her speak. She is low-voiced.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103178/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103178/line-2",
          "start": 11,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 410917,
        "end": 411002,
        "line": 14773,
        "column": 1,
        "path": "chap03/p@103178",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@103267",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nThat’s not so good. He cannot like her long.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103267/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103267/line-2",
          "start": 11,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 411006,
        "end": 411091,
        "line": 14778,
        "column": 1,
        "path": "chap03/p@103267",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@103356",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARMIAN.\nLike her? O Isis! ’Tis impossible.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103356/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103356/line-2",
          "start": 10,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 411095,
        "end": 411169,
        "line": 14783,
        "column": 1,
        "path": "chap03/p@103356",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CHARMIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@103434",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nI think so, Charmian: dull of tongue and dwarfish!\nWhat majesty is in her gait? Remember,\nIf e’er thou look’dst on majesty.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103434/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103434/line-2",
          "start": 11,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103434/line-3",
          "start": 62,
          "end": 100,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103434/line-4",
          "start": 101,
          "end": 134,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 411173,
        "end": 411347,
        "line": 14788,
        "column": 1,
        "path": "chap03/p@103434",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@103612",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nShe creeps.\nHer motion and her station are as one.\nShe shows a body rather than a life,\nA statue than a breather.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103612/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103612/line-2",
          "start": 11,
          "end": 22,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103612/line-3",
          "start": 23,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103612/line-4",
          "start": 62,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103612/line-5",
          "start": 99,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 411351,
        "end": 411520,
        "line": 14795,
        "column": 1,
        "path": "chap03/p@103612",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@103785",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nIs this certain?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103785/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103785/line-2",
          "start": 11,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 411524,
        "end": 411581,
        "line": 14803,
        "column": 1,
        "path": "chap03/p@103785",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@103846",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nOr I have no observance.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103846/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103846/line-2",
          "start": 11,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 411585,
        "end": 411650,
        "line": 14808,
        "column": 1,
        "path": "chap03/p@103846",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@103915",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARMIAN.\nThree in Egypt\nCannot make better note.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103915/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103915/line-2",
          "start": 10,
          "end": 24,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@103915/line-3",
          "start": 25,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 411654,
        "end": 411738,
        "line": 14813,
        "column": 1,
        "path": "chap03/p@103915",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CHARMIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104003",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nHe’s very knowing;\nI do perceive’t. There’s nothing in her yet.\nThe fellow has good judgment.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104003/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104003/line-2",
          "start": 11,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104003/line-3",
          "start": 30,
          "end": 74,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104003/line-4",
          "start": 75,
          "end": 104,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 411742,
        "end": 411886,
        "line": 14819,
        "column": 1,
        "path": "chap03/p@104003",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104151",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARMIAN.\nExcellent.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104151/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104151/line-2",
          "start": 10,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 411890,
        "end": 411940,
        "line": 14826,
        "column": 1,
        "path": "chap03/p@104151",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CHARMIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104205",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nGuess at her years, I prithee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104205/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104205/line-2",
          "start": 11,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 411944,
        "end": 412015,
        "line": 14831,
        "column": 1,
        "path": "chap03/p@104205",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104280",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nMadam,\nShe was a widow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104280/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104280/line-2",
          "start": 11,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104280/line-3",
          "start": 18,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 412019,
        "end": 412088,
        "line": 14836,
        "column": 1,
        "path": "chap03/p@104280",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104353",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nWidow! Charmian, hark!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104353/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104353/line-2",
          "start": 11,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 412092,
        "end": 412155,
        "line": 14842,
        "column": 1,
        "path": "chap03/p@104353",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104420",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nAnd I do think she’s thirty.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104420/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104420/line-2",
          "start": 11,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 412159,
        "end": 412228,
        "line": 14847,
        "column": 1,
        "path": "chap03/p@104420",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104493",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nBear’st thou her face in mind? Is’t long or round?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104493/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104493/line-2",
          "start": 11,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 412232,
        "end": 412323,
        "line": 14852,
        "column": 1,
        "path": "chap03/p@104493",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104588",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nRound even to faultiness.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104588/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104588/line-2",
          "start": 11,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 412327,
        "end": 412393,
        "line": 14857,
        "column": 1,
        "path": "chap03/p@104588",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104658",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nFor the most part, too, they are foolish that are so.\nHer hair, what colour?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104658/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104658/line-2",
          "start": 11,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104658/line-3",
          "start": 65,
          "end": 87,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 412397,
        "end": 412519,
        "line": 14862,
        "column": 1,
        "path": "chap03/p@104658",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104784",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nBrown, madam, and her forehead\nAs low as she would wish it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104784/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104784/line-2",
          "start": 11,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104784/line-3",
          "start": 42,
          "end": 70,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 412523,
        "end": 412628,
        "line": 14868,
        "column": 1,
        "path": "chap03/p@104784",
        "anchor": "sceneIII_3.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@104893",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nThere’s gold for thee.\nThou must not take my former sharpness ill.\nI will employ thee back again; I find thee\nMost fit for business. Go make thee ready;\nOur letters are prepared.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104893/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104893/line-2",
          "start": 11,
          "end": 33,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104893/line-3",
          "start": 34,
          "end": 77,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104893/line-4",
          "start": 78,
          "end": 120,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104893/line-5",
          "start": 121,
          "end": 163,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@104893/line-6",
          "start": 164,
          "end": 189,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 412632,
        "end": 412871,
        "line": 14874,
        "column": 1,
