        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@105136",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit Messenger.]",
      "separatorAfter": "\n\n",
      "spans": [
