      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nThe man hath seen some majesty, and should know.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
