    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.3/p@105219",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARMIAN.\nA proper man.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.3/p@105219/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
