    {
      "id": "antony-and-cleopatra/sceneIII_3.4/p@107652",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OCTAVIA.\nThanks to my lord.\nThe Jove of power make me, most weak, most weak,\nYour reconciler! Wars ’twixt you twain would be\nAs if the world should cleave, and that slain men\nShould solder up the rift.",
