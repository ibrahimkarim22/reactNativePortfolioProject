        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108358/line-1",
          "start": 0,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 416097,
        "end": 416219,
        "line": 15006,
        "column": 1,
        "path": "chap03/p@108358",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@108484",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nHow now, friend Eros?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108484/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108484/line-2",
          "start": 11,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 416223,
        "end": 416285,
        "line": 15010,
        "column": 1,
        "path": "chap03/p@108484",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@108550",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nThere’s strange news come, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108550/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108550/line-2",
          "start": 6,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 416289,
        "end": 416356,
        "line": 15015,
        "column": 1,
        "path": "chap03/p@108550",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@108621",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nWhat, man?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108621/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108621/line-2",
          "start": 11,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 416360,
        "end": 416411,
        "line": 15020,
        "column": 1,
        "path": "chap03/p@108621",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@108676",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nCaesar and Lepidus have made wars upon Pompey.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108676/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108676/line-2",
          "start": 6,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 416415,
        "end": 416497,
        "line": 15025,
        "column": 1,
        "path": "chap03/p@108676",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@108762",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nThis is old. What is the success?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108762/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108762/line-2",
          "start": 11,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 416501,
        "end": 416575,
        "line": 15030,
        "column": 1,
        "path": "chap03/p@108762",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@108840",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nCaesar, having made use of him in the wars ’gainst Pompey, presently denied him rivality; would not let him partake in the glory of the action, and, not resting here, accuses him of letters he had formerly wrote to Pompey; upon his own appeal, seizes him. So the poor third is up, till death enlarge his confine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108840/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@108840/line-2",
          "start": 6,
          "end": 318,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 416579,
        "end": 416931,
        "line": 15035,
        "column": 1,
        "path": "chap03/p@108840",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@109196",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nThen, world, thou hast a pair of chaps, no more,\nAnd throw between them all the food thou hast,\nThey’ll grind the one the other. Where’s Antony?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109196/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109196/line-2",
          "start": 11,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109196/line-3",
          "start": 60,
          "end": 106,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109196/line-4",
          "start": 107,
          "end": 155,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 416935,
        "end": 417130,
        "line": 15044,
        "column": 1,
        "path": "chap03/p@109196",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@109395",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nHe’s walking in the garden, thus, and spurns\nThe rush that lies before him; cries “Fool Lepidus!”\nAnd threats the throat of that his officer\nThat murdered Pompey.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109395/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109395/line-2",
          "start": 6,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109395/line-3",
          "start": 51,
          "end": 103,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109395/line-4",
          "start": 104,
          "end": 146,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109395/line-5",
          "start": 147,
          "end": 168,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 417134,
        "end": 417347,
        "line": 15051,
        "column": 1,
        "path": "chap03/p@109395",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@109612",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nOur great navy’s rigged.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109612/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109612/line-2",
          "start": 11,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 417351,
        "end": 417416,
        "line": 15059,
        "column": 1,
        "path": "chap03/p@109612",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@109681",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nFor Italy and Caesar. More, Domitius:\nMy lord desires you presently. My news\nI might have told hereafter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109681/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109681/line-2",
          "start": 6,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109681/line-3",
          "start": 44,
          "end": 82,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109681/line-4",
          "start": 83,
          "end": 111,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 417420,
        "end": 417571,
        "line": 15064,
        "column": 1,
        "path": "chap03/p@109681",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@109836",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\n’Twill be naught,\nBut let it be. Bring me to Antony.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109836/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109836/line-2",
          "start": 11,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109836/line-3",
          "start": 29,
          "end": 63,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 417575,
        "end": 417673,
        "line": 15071,
        "column": 1,
        "path": "chap03/p@109836",
        "anchor": "sceneIII_3.5"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.5/p@109938",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nCome, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109938/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.5/p@109938/line-2",
          "start": 6,
          "end": 16,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 417677,
        "end": 417723,
        "line": 15077,
