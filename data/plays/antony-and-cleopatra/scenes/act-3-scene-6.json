        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@111236",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MAECENAS.\nLet Rome be thus informed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111236/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111236/line-2",
          "start": 10,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 418975,
        "end": 419041,
        "line": 15125,
        "column": 1,
        "path": "chap03/p@111236",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": "MAECENAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@111306",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AGRIPPA.\nWho, queasy with his insolence already,\nWill their good thoughts call from him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111306/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111306/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111306/line-3",
          "start": 49,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 419045,
        "end": 419168,
        "line": 15130,
        "column": 1,
        "path": "chap03/p@111306",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": "AGRIPPA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@111433",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nThe people knows it and have now received\nHis accusations.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111433/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111433/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111433/line-3",
          "start": 50,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 419172,
        "end": 419273,
        "line": 15136,
        "column": 1,
        "path": "chap03/p@111433",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": "CAESAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@111538",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AGRIPPA.\nWho does he accuse?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111538/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111538/line-2",
          "start": 9,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 419277,
        "end": 419335,
        "line": 15142,
        "column": 1,
        "path": "chap03/p@111538",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": "AGRIPPA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@111600",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nCaesar, and that, having in Sicily\nSextus Pompeius spoiled, we had not rated him\nHis part o’ th’ isle. Then does he say he lent me\nSome shipping, unrestored. Lastly, he frets\nThat Lepidus of the triumvirate\nShould be deposed and, being, that we detain\nAll his revenue.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111600/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111600/line-2",
          "start": 8,
          "end": 42,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111600/line-3",
          "start": 43,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111600/line-4",
          "start": 89,
          "end": 138,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111600/line-5",
          "start": 139,
          "end": 182,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111600/line-6",
          "start": 183,
          "end": 214,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111600/line-7",
          "start": 215,
          "end": 259,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111600/line-8",
          "start": 260,
          "end": 276,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 419339,
        "end": 419675,
        "line": 15147,
        "column": 1,
        "path": "chap03/p@111600",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": "CAESAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@111940",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AGRIPPA.\nSir, this should be answered.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111940/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@111940/line-2",
          "start": 9,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 419679,
        "end": 419747,
        "line": 15158,
        "column": 1,
        "path": "chap03/p@111940",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": "AGRIPPA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@112012",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\n’Tis done already, and messenger gone.\nI have told him Lepidus was grown too cruel,\nThat he his high authority abused,\nAnd did deserve his change. For what I have conquered\nI grant him part; but then in his Armenia\nAnd other of his conquered kingdoms, I\nDemand the like.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112012/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112012/line-2",
          "start": 8,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112012/line-3",
          "start": 47,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112012/line-4",
          "start": 92,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112012/line-5",
          "start": 127,
          "end": 180,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112012/line-6",
          "start": 181,
          "end": 222,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112012/line-7",
          "start": 223,
          "end": 261,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112012/line-8",
          "start": 262,
          "end": 278,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 419751,
        "end": 420089,
        "line": 15163,
        "column": 1,
        "path": "chap03/p@112012",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": "CAESAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@112354",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MAECENAS.\nHe’ll never yield to that.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112354/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112354/line-2",
          "start": 10,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 420093,
        "end": 420159,
        "line": 15174,
        "column": 1,
        "path": "chap03/p@112354",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": "MAECENAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@112424",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nNor must not then be yielded to in this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112424/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@112424/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 420163,
        "end": 420241,
        "line": 15179,
        "column": 1,
        "path": "chap03/p@112424",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": "CAESAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
