    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@110775",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MAECENAS.\nThis in the public eye?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110775/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110775/line-2",
          "start": 10,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 418514,
        "end": 418577,
        "line": 15108,
        "column": 1,
        "path": "chap03/p@110775",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": "MAECENAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@110842",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nI’ th’ common showplace where they exercise.\nHis sons he there proclaimed the kings of kings:\nGreat Media, Parthia, and Armenia\nHe gave to Alexander; to Ptolemy he assigned\nSyria, Cilicia, and Phoenicia. She\nIn th’ habiliments of the goddess Isis\nThat day appeared, and oft before gave audience,\nAs ’tis reported, so.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110842/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110842/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110842/line-3",
          "start": 53,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110842/line-4",
          "start": 102,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110842/line-5",
          "start": 136,
          "end": 180,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110842/line-6",
          "start": 181,
          "end": 215,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110842/line-7",
          "start": 216,
          "end": 254,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110842/line-8",
          "start": 255,
          "end": 303,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110842/line-9",
          "start": 304,
          "end": 325,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 418581,
        "end": 418971,
        "line": 15113,
