    {
      "id": "antony-and-cleopatra/sceneIII_3.6/p@113571",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OCTAVIA.\nGood my lord,\nTo come thus was I not constrained, but did it\nOn my free will. My lord, Mark Antony,\nHearing that you prepared for war, acquainted\nMy grieved ear withal, whereon I begged\nHis pardon for return.",
      "separatorAfter": "\n\n",
      "spans": [],
