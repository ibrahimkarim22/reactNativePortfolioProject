        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIII_3.6/p@110121/line-1",
          "start": 0,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 417860,
        "end": 417984,
        "line": 15089,
        "column": 1,
        "path": "chap03/p@110121",
        "anchor": "sceneIII_3.6"
      },
      "speakerLabel": null,
