    {
      "id": "antony-and-cleopatra/sceneIV_3.1/p@148373",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MAECENAS.\nCaesar must think,\nWhen one so great begins to rage, he’s hunted\nEven to falling. Give him no breath, but now\nMake boot of his distraction. Never anger\nMade good guard for itself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
