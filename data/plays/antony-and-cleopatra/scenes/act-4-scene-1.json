    {
      "id": "antony-and-cleopatra/sceneIV_3.1/p@148062",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nHe calls me boy, and chides as he had power\nTo beat me out of Egypt. My messenger\nHe hath whipped with rods; dares me to personal combat,\nCaesar to Antony. Let the old ruffian know\nI have many other ways to die; meantime\nLaugh at his challenge.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
