        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.10/p@169872",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCARUS.\nFor both, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.10/p@169872/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
