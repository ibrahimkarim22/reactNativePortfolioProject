          "start": 8,
          "end": 42,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.10/p@169763/line-3",
          "start": 43,
          "end": 70,
          "sourceLineNumber": null
        }
      ],
