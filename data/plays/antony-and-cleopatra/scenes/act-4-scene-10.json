          "start": 8,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 477611,
        "end": 477667,
        "line": 17693,
        "column": 1,
        "path": "chap03/p@169872",
        "anchor": "sceneIV_3.10"
      },
      "speakerLabel": "SCARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.10/p@169932",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nI would they’d fight i’ th’ fire or i’ th’ air;\nWe’d fight there too. But this it is: our foot\nUpon the hills adjoining to the city\nShall stay with us—order for sea is given;\nThey have put forth the haven—\nWhere their appointment we may best discover\nAnd look on their endeavour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
