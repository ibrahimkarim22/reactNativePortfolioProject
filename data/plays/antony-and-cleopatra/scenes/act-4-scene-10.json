    {
      "id": "antony-and-cleopatra/sceneIV_3.10/p@169763",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nTheir preparation is today by sea;\nWe please them not by land.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.10/p@169763/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
