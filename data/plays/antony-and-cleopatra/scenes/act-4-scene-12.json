          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 480665,
        "end": 480746,
        "line": 17807,
        "column": 1,
        "path": "chap03/p@172926",
        "anchor": "sceneIV_3.12"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.12/p@173011",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nVanish, or I shall give thee thy deserving\nAnd blemish Caesar’s triumph. Let him take thee\nAnd hoist thee up to the shouting plebeians!\nFollow his chariot, like the greatest spot\nOf all thy sex; most monster-like be shown\nFor poor’st diminutives, for dolts, and let\nPatient Octavia plough thy visage up\nWith her prepared nails.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
