    {
      "id": "antony-and-cleopatra/sceneIV_3.12/p@171642",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nAll is lost!\nThis foul Egyptian hath betrayed me.\nMy fleet hath yielded to the foe, and yonder\nThey cast their caps up and carouse together\nLike friends long lost. Triple-turned whore! ’Tis thou\nHast sold me to this novice, and my heart\nMakes only wars on thee. Bid them all fly;\nFor when I am revenged upon my charm,\nI have done all. Bid them all fly! Be gone!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
