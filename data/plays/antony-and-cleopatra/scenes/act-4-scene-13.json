          "start": 11,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.13/p@174313/line-3",
          "start": 48,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.13/p@174313/line-4",
          "start": 98,
          "end": 120,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 482052,
        "end": 482212,
        "line": 17853,
        "column": 1,
        "path": "chap03/p@174313",
        "anchor": "sceneIV_3.13"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.13/p@174477",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARMIAN.\nTo th’ monument!\nThere lock yourself and send him word you are dead.\nThe soul and body rive not more in parting\nThan greatness going off.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
