        {
          "id": "antony-and-cleopatra/sceneIV_3.13/p@174477/line-5",
          "start": 122,
          "end": 147,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 482216,
        "end": 482408,
        "line": 17860,
        "column": 1,
        "path": "chap03/p@174477",
