    {
      "id": "antony-and-cleopatra/sceneIV_3.13/p@174313",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nHelp me, my women! O, he is more mad\nThan Telamon for his shield; the boar of Thessaly\nWas never so embossed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
