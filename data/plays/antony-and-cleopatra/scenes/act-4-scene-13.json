    {
      "id": "antony-and-cleopatra/sceneIV_3.13/p@174673",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nTo th’ monument!\nMardian, go tell him I have slain myself.\nSay that the last I spoke was “Antony”,\nAnd word it, prithee, piteously. Hence, Mardian,\nAnd bring me how he takes my death.—To th’ monument!",
      "separatorAfter": "\n\n",
      "spans": [],
