      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@150049",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Give me thy hand.\nThou has been rightly honest; so hast thou,\nThou, and thou, and thou. You have served me well,\nAnd kings have been your fellows.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150049/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150049/line-2",
          "start": 18,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150049/line-3",
          "start": 62,
          "end": 112,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150049/line-4",
          "start": 113,
          "end": 146,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 457788,
        "end": 457974,
        "line": 16784,
        "column": 1,
        "path": "chap03/p@150049",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@150239",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\n[Aside to Enobarbus.] What means this?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 12,
          "end": 30
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150239/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150239/line-2",
          "start": 11,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 457978,
        "end": 458064,
        "line": 16791,
        "column": 1,
        "path": "chap03/p@150239",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@150329",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\n[Aside to Cleopatra.] ’Tis one of those odd tricks which sorrow shoots\nOut of the mind.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 12,
          "end": 30
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150329/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150329/line-2",
          "start": 11,
          "end": 81,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150329/line-3",
          "start": 82,
          "end": 98,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 458068,
        "end": 458209,
        "line": 16796,
        "column": 1,
        "path": "chap03/p@150329",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@150474",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nAnd thou art honest too.\nI wish I could be made so many men,\nAnd all of you clapped up together in\nAn Antony, that I might do you service\nSo good as you have done.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150474/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150474/line-2",
          "start": 8,
          "end": 32,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150474/line-3",
          "start": 33,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150474/line-4",
          "start": 69,
          "end": 106,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150474/line-5",
          "start": 107,
          "end": 145,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150474/line-6",
          "start": 146,
          "end": 171,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 458213,
        "end": 458434,
        "line": 16803,
        "column": 1,
        "path": "chap03/p@150474",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@150699",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALL THE SERVANTS.\nThe gods forbid!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150699/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150699/line-2",
          "start": 18,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 458438,
        "end": 458502,
        "line": 16812,
        "column": 1,
        "path": "chap03/p@150699",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "ALL THE SERVANTS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 17
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@150767",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nWell, my good fellows, wait on me tonight.\nScant not my cups, and make as much of me\nAs when mine empire was your fellow too\nAnd suffered my command.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150767/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150767/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150767/line-3",
          "start": 51,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150767/line-4",
          "start": 93,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@150767/line-5",
          "start": 133,
          "end": 157,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 458506,
        "end": 458708,
        "line": 16817,
        "column": 1,
        "path": "chap03/p@150767",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
