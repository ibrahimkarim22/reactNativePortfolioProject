        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@149359",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nWhy should he not?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149359/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149359/line-2",
          "start": 8,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 457098,
        "end": 457154,
        "line": 16749,
        "column": 1,
        "path": "chap03/p@149359",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@149419",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nHe thinks, being twenty times of better fortune,\nHe is twenty men to one.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149419/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149419/line-2",
          "start": 11,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149419/line-3",
          "start": 60,
          "end": 84,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 457158,
        "end": 457277,
        "line": 16754,
        "column": 1,
        "path": "chap03/p@149419",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@149542",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nTomorrow, soldier,\nBy sea and land I’ll fight. Or I will live,\nOr bathe my dying honour in the blood\nShall make it live again. Woo’t thou fight well?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149542/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149542/line-2",
          "start": 8,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149542/line-3",
          "start": 27,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149542/line-4",
          "start": 71,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149542/line-5",
          "start": 109,
          "end": 157,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 457281,
        "end": 457483,
        "line": 16760,
        "column": 1,
        "path": "chap03/p@149542",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@149748",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nI’ll strike, and cry “Take all.”",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149748/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149748/line-2",
          "start": 11,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 457487,
        "end": 457560,
        "line": 16768,
        "column": 1,
        "path": "chap03/p@149748",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "ENOBARBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@149825",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nWell said. Come on.\nCall forth my household servants. Let’s tonight\nBe bounteous at our meal.—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149825/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149825/line-2",
          "start": 8,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149825/line-3",
          "start": 28,
          "end": 75,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149825/line-4",
          "start": 76,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 457564,
        "end": 457706,
        "line": 16773,
        "column": 1,
        "path": "chap03/p@149825",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
