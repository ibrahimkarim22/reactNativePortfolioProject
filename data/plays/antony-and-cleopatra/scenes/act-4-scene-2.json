    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@151636",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nWhat mean you, sir,\nTo give them this discomfort? Look, they weep,\nAnd I, an ass, am onion-eyed. For shame,\nTransform us not to women.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
