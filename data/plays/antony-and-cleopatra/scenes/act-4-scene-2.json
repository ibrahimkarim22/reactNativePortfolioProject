      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\n[Aside to Cleopatra.] To make his followers weep.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 12,
          "end": 30
        }
      ],
      "lines": [
