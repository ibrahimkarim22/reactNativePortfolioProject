    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@149233",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nHe will not fight with me, Domitius?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149233/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.2/p@149233/line-2",
          "start": 8,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 456972,
        "end": 457046,
        "line": 16739,
        "column": 1,
        "path": "chap03/p@149233",
        "anchor": "sceneIV_3.2"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.2/p@149311",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nNo.",
      "separatorAfter": "\n\n",
      "spans": [],
