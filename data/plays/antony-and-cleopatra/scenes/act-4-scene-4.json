          "end": 293,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156218/line-9",
          "start": 294,
          "end": 309,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
