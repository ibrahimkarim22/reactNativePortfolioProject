    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@155437",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Eros with armour.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 10,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155437/line-1",
          "start": 0,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 463176,
        "end": 463258,
        "line": 17055,
        "column": 1,
        "path": "chap03/p@155437",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@155523",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Come, good fellow, put thine iron on.\nIf fortune be not ours today, it is\nBecause we brave her. Come.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155523/line-1",
          "start": 0,
          "end": 37,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155523/line-2",
          "start": 38,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155523/line-3",
          "start": 74,
          "end": 101,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 463262,
        "end": 463398,
        "line": 17059,
        "column": 1,
        "path": "chap03/p@155523",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@155663",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nNay, I’ll help too.\nWhat’s this for?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155663/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155663/line-2",
          "start": 11,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155663/line-3",
          "start": 31,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 463402,
        "end": 463484,
        "line": 17065,
        "column": 1,
        "path": "chap03/p@155663",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@155749",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nAh, let be, let be! Thou art\nThe armourer of my heart. False, false. This, this!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155749/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155749/line-2",
          "start": 8,
          "end": 36,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155749/line-3",
          "start": 37,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 463488,
        "end": 463611,
        "line": 17071,
        "column": 1,
        "path": "chap03/p@155749",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@155876",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nSooth, la, I’ll help. Thus it must be.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155876/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155876/line-2",
          "start": 11,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 463615,
        "end": 463694,
        "line": 17077,
        "column": 1,
        "path": "chap03/p@155876",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@155959",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nWell, well,\nWe shall thrive now. Seest thou, my good fellow?\nGo put on thy defences.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155959/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155959/line-2",
          "start": 8,
          "end": 19,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155959/line-3",
          "start": 20,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@155959/line-4",
          "start": 69,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 463698,
        "end": 463830,
        "line": 17082,
        "column": 1,
        "path": "chap03/p@155959",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@156095",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nBriefly, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156095/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156095/line-2",
          "start": 6,
          "end": 19,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 463834,
        "end": 463883,
        "line": 17089,
        "column": 1,
        "path": "chap03/p@156095",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@156148",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nIs not this buckled well?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156148/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156148/line-2",
          "start": 11,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 463887,
        "end": 463953,
        "line": 17094,
        "column": 1,
        "path": "chap03/p@156148",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": "CLEOPATRA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@156218",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nRarely, rarely.\nHe that unbuckles this, till we do please\nTo daff’t for our repose, shall hear a storm.\nThou fumblest, Eros, and my queen’s a squire\nMore tight at this than thou. Dispatch. O love,\nThat thou couldst see my wars today, and knew’st\nThe royal occupation, thou shouldst see\nA workman in’t.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156218/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156218/line-2",
          "start": 8,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156218/line-3",
          "start": 24,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156218/line-4",
          "start": 66,
          "end": 111,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156218/line-5",
          "start": 112,
          "end": 156,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156218/line-6",
          "start": 157,
          "end": 204,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156218/line-7",
          "start": 205,
          "end": 253,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156218/line-8",
