    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@156596",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter an Officer, armed.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 9,
          "end": 17,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156596/line-1",
          "start": 0,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 464335,
        "end": 464418,
        "line": 17111,
        "column": 1,
        "path": "chap03/p@156596",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@156683",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Good morrow to thee. Welcome.\nThou look’st like him that knows a warlike charge.\nTo business that we love we rise betime\nAnd go to’t with delight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156683/line-1",
          "start": 0,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156683/line-2",
          "start": 30,
          "end": 80,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156683/line-3",
          "start": 81,
          "end": 120,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156683/line-4",
          "start": 121,
          "end": 146,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 464422,
        "end": 464608,
        "line": 17115,
        "column": 1,
        "path": "chap03/p@156683",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@156873",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OFFICER.\nA thousand, sir,\nEarly though’t be, have on their riveted trim\nAnd at the port expect you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156873/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156873/line-2",
          "start": 9,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156873/line-3",
          "start": 26,
          "end": 71,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.4/p@156873/line-4",
          "start": 72,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 464612,
        "end": 464751,
        "line": 17122,
        "column": 1,
        "path": "chap03/p@156873",
        "anchor": "sceneIV_3.4"
      },
      "speakerLabel": "OFFICER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.4/p@157016",
