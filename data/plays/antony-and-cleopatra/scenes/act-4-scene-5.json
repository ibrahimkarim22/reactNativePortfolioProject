    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@158547",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLDIER.\nThe gods make this a happy day to Antony!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158547/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158547/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 466286,
        "end": 466366,
        "line": 17192,
        "column": 1,
        "path": "chap03/p@158547",
        "anchor": "sceneIV_3.5"
      },
      "speakerLabel": "SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@158631",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nWould thou and those thy scars had once prevailed\nTo make me fight at land!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158631/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158631/line-2",
          "start": 8,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158631/line-3",
          "start": 58,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 466370,
        "end": 466488,
        "line": 17197,
        "column": 1,
        "path": "chap03/p@158631",
        "anchor": "sceneIV_3.5"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@158753",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLDIER.\nHadst thou done so,\nThe kings that have revolted and the soldier\nThat has this morning left thee would have still\nFollowed thy heels.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158753/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158753/line-2",
          "start": 9,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158753/line-3",
          "start": 29,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158753/line-4",
          "start": 74,
          "end": 122,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158753/line-5",
          "start": 123,
          "end": 142,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 466492,
        "end": 466679,
        "line": 17203,
        "column": 1,
        "path": "chap03/p@158753",
        "anchor": "sceneIV_3.5"
      },
      "speakerLabel": "SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@158944",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nWho’s gone this morning?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158944/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@158944/line-2",
          "start": 8,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 466683,
        "end": 466745,
        "line": 17211,
        "column": 1,
        "path": "chap03/p@158944",
        "anchor": "sceneIV_3.5"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@159010",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLDIER.\nWho?\nOne ever near thee. Call for Enobarbus,\nHe shall not hear thee, or from Caesar’s camp\nSay “I am none of thine.”",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159010/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159010/line-2",
          "start": 9,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159010/line-3",
          "start": 14,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159010/line-4",
          "start": 54,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159010/line-5",
          "start": 100,
          "end": 125,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 466749,
        "end": 466919,
        "line": 17216,
        "column": 1,
        "path": "chap03/p@159010",
        "anchor": "sceneIV_3.5"
      },
      "speakerLabel": "SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@159184",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nWhat sayest thou?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159184/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159184/line-2",
          "start": 8,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 466923,
        "end": 466978,
        "line": 17224,
        "column": 1,
        "path": "chap03/p@159184",
        "anchor": "sceneIV_3.5"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@159243",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLDIER.\nSir,\nHe is with Caesar.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159243/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159243/line-2",
          "start": 9,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159243/line-3",
          "start": 14,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 466982,
        "end": 467049,
        "line": 17229,
        "column": 1,
        "path": "chap03/p@159243",
        "anchor": "sceneIV_3.5"
      },
      "speakerLabel": "SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@159314",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nSir, his chests and treasure\nHe has not with him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159314/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159314/line-2",
          "start": 6,
          "end": 34,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159314/line-3",
          "start": 35,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 467053,
        "end": 467143,
        "line": 17235,
        "column": 1,
        "path": "chap03/p@159314",
        "anchor": "sceneIV_3.5"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@159408",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nIs he gone?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159408/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159408/line-2",
          "start": 8,
          "end": 19,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 467147,
        "end": 467196,
        "line": 17241,
        "column": 1,
        "path": "chap03/p@159408",
        "anchor": "sceneIV_3.5"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@159461",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLDIER.\nMost certain.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159461/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159461/line-2",
          "start": 9,
          "end": 22,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 467200,
        "end": 467252,
        "line": 17246,
        "column": 1,
        "path": "chap03/p@159461",
        "anchor": "sceneIV_3.5"
      },
      "speakerLabel": "SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.5/p@159517",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nGo, Eros, send his treasure after. Do it.\nDetain no jot, I charge thee. Write to him—\nI will subscribe—gentle adieus and greetings.\nSay that I wish he never find more cause\nTo change a master. O, my fortunes have\nCorrupted honest men! Dispatch.—Enobarbus!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159517/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.5/p@159517/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
