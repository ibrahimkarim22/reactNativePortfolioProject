          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 471494,
        "end": 471564,
        "line": 17432,
        "column": 1,
        "path": "chap03/p@163755",
        "anchor": "sceneIV_3.7"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.7/p@163829",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EROS.\nThey are beaten, sir, and our advantage serves\nFor a fair victory.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163829/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163829/line-2",
          "start": 6,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163829/line-3",
          "start": 53,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 471568,
        "end": 471675,
        "line": 17436,
        "column": 1,
        "path": "chap03/p@163829",
        "anchor": "sceneIV_3.7"
      },
      "speakerLabel": "EROS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.7/p@163940",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCARUS.\nLet us score their backs\nAnd snatch ’em up as we take hares, behind.\n’Tis sport to maul a runner.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163940/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163940/line-2",
          "start": 8,
          "end": 32,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163940/line-3",
          "start": 33,
          "end": 76,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163940/line-4",
          "start": 77,
          "end": 105,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 471679,
        "end": 471824,
        "line": 17442,
        "column": 1,
        "path": "chap03/p@163940",
        "anchor": "sceneIV_3.7"
      },
      "speakerLabel": "SCARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.7/p@164089",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nI will reward thee\nOnce for thy sprightly comfort, and tenfold\nFor thy good valour. Come thee on.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@164089/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@164089/line-2",
          "start": 8,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@164089/line-3",
          "start": 27,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@164089/line-4",
          "start": 71,
          "end": 105,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 471828,
        "end": 471973,
        "line": 17449,
        "column": 1,
        "path": "chap03/p@164089",
        "anchor": "sceneIV_3.7"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
