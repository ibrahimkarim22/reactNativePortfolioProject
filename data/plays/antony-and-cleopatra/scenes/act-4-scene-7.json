          "start": 8,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 471093,
        "end": 471151,
        "line": 17408,
        "column": 1,
        "path": "chap03/p@163354",
        "anchor": "sceneIV_3.7"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.7/p@163416",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCARUS.\nI had a wound here that was like a T,\nBut now ’tis made an H.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163416/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
