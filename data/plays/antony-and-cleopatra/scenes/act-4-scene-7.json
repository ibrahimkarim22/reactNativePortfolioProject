          "start": 8,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163416/line-3",
          "start": 46,
          "end": 69,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 471155,
        "end": 471259,
        "line": 17413,
        "column": 1,
        "path": "chap03/p@163416",
        "anchor": "sceneIV_3.7"
      },
      "speakerLabel": "SCARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.7/p@163524",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "Sounds retreat far off.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 0,
          "end": 23
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163524/line-1",
          "start": 0,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
