    {
      "id": "antony-and-cleopatra/sceneIV_3.7/p@163046",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Alarums. Enter Antony and Scarus wounded.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 15,
          "end": 21,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 26,
          "end": 32,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163046/line-1",
          "start": 0,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 470785,
        "end": 470915,
        "line": 17397,
        "column": 1,
        "path": "chap03/p@163046",
        "anchor": "sceneIV_3.7"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.7/p@163180",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCARUS.\nO my brave emperor, this is fought indeed!\nHad we done so at first, we had droven them home\nWith clouts about their heads.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163180/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163180/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163180/line-3",
          "start": 51,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163180/line-4",
          "start": 100,
          "end": 130,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 470919,
        "end": 471089,
        "line": 17401,
        "column": 1,
        "path": "chap03/p@163180",
        "anchor": "sceneIV_3.7"
      },
      "speakerLabel": "SCARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
