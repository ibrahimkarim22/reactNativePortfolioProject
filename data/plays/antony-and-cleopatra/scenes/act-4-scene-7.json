      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nThou bleed’st apace.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163354/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
