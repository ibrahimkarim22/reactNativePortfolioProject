      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AGRIPPA.\nRetire! We have engaged ourselves too far.\nCaesar himself has work, and our oppression\nExceeds what we expected.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@162836/line-1",
