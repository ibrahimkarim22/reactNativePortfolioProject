    {
      "id": "antony-and-cleopatra/sceneIV_3.7/p@163580",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nThey do retire.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163580/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163580/line-2",
          "start": 8,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 471319,
        "end": 471372,
        "line": 17421,
        "column": 6,
        "path": "chap03/p@163580",
        "anchor": "sceneIV_3.7"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.7/p@163637",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCARUS.\nWe’ll beat ’em into bench-holes. I have yet\nRoom for six scotches more.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163637/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163637/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.7/p@163637/line-3",
          "start": 52,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 471376,
        "end": 471490,
        "line": 17426,
        "column": 1,
        "path": "chap03/p@163637",
        "anchor": "sceneIV_3.7"
      },
      "speakerLabel": "SCARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.7/p@163755",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
