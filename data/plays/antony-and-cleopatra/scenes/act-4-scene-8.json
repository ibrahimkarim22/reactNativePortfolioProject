    {
      "id": "antony-and-cleopatra/sceneIV_3.8/p@165567",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOPATRA.\nLord of lords!\nO infinite virtue, com’st thou smiling from\nThe world’s great snare uncaught?",
