      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.9/p@167634",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ENOBARBUS.\nBe witness to me, O thou blessed moon,\nWhen men revolted shall upon record\nBear hateful memory, poor Enobarbus did\nBefore thy face repent.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
