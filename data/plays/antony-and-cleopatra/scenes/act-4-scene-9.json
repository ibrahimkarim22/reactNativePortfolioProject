      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND WATCH.\nLet’s do so. But he sleeps.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.9/p@168723/line-1",
          "start": 0,
          "end": 13,
