    {
      "id": "antony-and-cleopatra/sceneIV_3.9/p@167884",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND WATCH.\nPeace! Hark further.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.9/p@167884/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
