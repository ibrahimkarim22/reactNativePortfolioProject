      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.9/p@167562",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST WATCH.\nStand close and list him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
