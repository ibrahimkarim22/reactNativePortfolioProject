          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneIV_3.9/p@168798/line-3",
          "start": 50,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
