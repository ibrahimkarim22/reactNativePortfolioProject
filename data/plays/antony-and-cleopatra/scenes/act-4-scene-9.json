    {
      "id": "antony-and-cleopatra/sceneIV_3.9/p@167125",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SENTRY.\nIf we be not relieved within this hour,\nWe must return to th’ court of guard. The night\nIs shiny, and they say we shall embattle\nBy th’ second hour i’ th’ morn.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
