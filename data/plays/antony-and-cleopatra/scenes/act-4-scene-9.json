        "end": 476533,
        "line": 17629,
        "column": 1,
        "path": "chap03/p@168723",
        "anchor": "sceneIV_3.9"
      },
      "speakerLabel": "SECOND WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "antony-and-cleopatra/sceneIV_3.9/p@168798",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SENTRY.\nSwoons rather, for so bad a prayer as his\nWas never yet for sleep.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneIV_3.9/p@168798/line-1",
          "start": 0,
          "end": 7,
