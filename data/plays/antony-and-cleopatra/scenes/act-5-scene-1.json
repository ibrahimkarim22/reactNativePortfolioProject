      }
    },
    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@193857",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AGRIPPA.\nA rarer spirit never\nDid steer humanity, but you gods will give us\nSome faults to make us men. Caesar is touched.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
