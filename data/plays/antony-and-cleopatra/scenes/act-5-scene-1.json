      }
    },
    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@195061",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EGYPTIAN.\nA poor Egyptian yet. The queen, my mistress,\nConfined in all she has, her monument,\nOf thy intents desires instruction,\nThat she preparedly may frame herself\nTo the way she’s forced to.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@195061/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@195061/line-2",
          "start": 10,
          "end": 54,
          "sourceLineNumber": null
        },
        {
