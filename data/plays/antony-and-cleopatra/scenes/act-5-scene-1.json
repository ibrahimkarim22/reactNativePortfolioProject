    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@196447",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nLet him alone, for I remember now\nHow he’s employed. He shall in time be ready.\nGo with me to my tent, where you shall see\nHow hardly I was drawn into this war,\nHow calm and gentle I proceeded still\nIn all my writings. Go with me and see\nWhat I can show in this.",
