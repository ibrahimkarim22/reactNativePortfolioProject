    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@195310",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nBid her have good heart.\nShe soon shall know of us, by some of ours,\nHow honourable and how kindly we\nDetermine for her. For Caesar cannot lean\nTo be ungentle.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
