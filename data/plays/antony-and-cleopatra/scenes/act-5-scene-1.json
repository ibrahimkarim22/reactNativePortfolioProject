    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@195644",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nCome hither, Proculeius. Go and say\nWe purpose her no shame. Give her what comforts\nThe quality of her passion shall require,\nLest, in her greatness, by some mortal stroke\nShe do defeat us, for her life in Rome\nWould be eternal in our triumph. Go,\nAnd with your speediest bring us what she says\nAnd how you find of her.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
