    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@192676",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nWhat is’t thou say’st?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192676/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192676/line-2",
          "start": 8,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 500415,
        "end": 500475,
        "line": 18649,
        "column": 1,
        "path": "chap03/p@192676",
        "anchor": "sceneV_3.1"
      },
      "speakerLabel": "CAESAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@192740",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DERCETUS.\nI say, O Caesar, Antony is dead.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192740/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192740/line-2",
          "start": 10,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 500479,
        "end": 500551,
        "line": 18654,
        "column": 1,
        "path": "chap03/p@192740",
        "anchor": "sceneV_3.1"
      },
      "speakerLabel": "DERCETUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@192816",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nThe breaking of so great a thing should make\nA greater crack. The round world\nShould have shook lions into civil streets,\nAnd citizens to their dens. The death of Antony\nIs not a single doom; in the name lay\nA moiety of the world.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192816/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192816/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192816/line-3",
          "start": 53,
          "end": 85,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192816/line-4",
          "start": 86,
          "end": 129,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192816/line-5",
          "start": 130,
          "end": 177,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192816/line-6",
          "start": 178,
          "end": 215,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192816/line-7",
          "start": 216,
          "end": 238,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 500555,
        "end": 500848,
        "line": 18659,
        "column": 1,
        "path": "chap03/p@192816",
        "anchor": "sceneV_3.1"
      },
      "speakerLabel": "CAESAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@193113",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DERCETUS.\nHe is dead, Caesar,\nNot by a public minister of justice,\nNor by a hired knife, but that self hand\nWhich writ his honour in the acts it did\nHath, with the courage which the heart did lend it,\nSplitted the heart. This is his sword.\nI robbed his wound of it. Behold it stained\nWith his most noble blood.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193113/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193113/line-2",
          "start": 10,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193113/line-3",
          "start": 30,
          "end": 66,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193113/line-4",
          "start": 67,
          "end": 107,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193113/line-5",
          "start": 108,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193113/line-6",
          "start": 149,
          "end": 200,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193113/line-7",
          "start": 201,
          "end": 239,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193113/line-8",
          "start": 240,
          "end": 283,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193113/line-9",
          "start": 284,
          "end": 310,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 500852,
        "end": 501227,
        "line": 18669,
        "column": 1,
        "path": "chap03/p@193113",
