    "title": "SCENE I. Caesar's Camp before Alexandria.",
    "location": "Caesar's Camp before Alexandria.",
    "orderInPlay": 41
  },
  "content": [
    {
      "id": "antony-and-cleopatra-5-1-stage-001",
      "type": "stage",
      "text": "Enter Caesar, Agrippa, Dolabella, Maecenas, Gallus, Proculeius with his council of war."
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Go to him, Dolabella, bid him yield.",
          "plainText": "Go to him Dolabella bid him yield",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Being so frustrate, tell him, he mocks",
          "plainText": "Being so frustrate tell him he mocks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "The pauses that he makes.",
          "plainText": "The pauses that he makes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "dolabella",
        "name": "DOLABELLA",
        "displayName": "Dolabella"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Caesar, I shall.",
          "plainText": "Caesar I shall",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "antony-and-cleopatra-5-1-stage-003",
      "type": "stage",
      "text": "Enter Dercetus with the sword of Antony."
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Wherefore is that? And what art thou that dar'st",
          "plainText": "Wherefore is that And what art thou that dar'st",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Appear thus to us?",
          "plainText": "Appear thus to us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "dercetus",
        "name": "DERCETUS",
        "displayName": "Dercetus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "I am called Dercetus.",
          "plainText": "I am called Dercetus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Mark Antony I served, who best was worthy",
          "plainText": "Mark Antony I served who best was worthy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Best to be served. Whilst he stood up and spoke,",
          "plainText": "Best to be served Whilst he stood up and spoke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "He was my master, and I wore my life",
          "plainText": "He was my master and I wore my life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "To spend upon his haters. If thou please",
          "plainText": "To spend upon his haters If thou please",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "To take me to thee, as I was to him",
          "plainText": "To take me to thee as I was to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 7,
          "text": "I'll be to Caesar; if thou pleasest not,",
          "plainText": "I'll be to Caesar if thou pleasest not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 8,
          "text": "I yield thee up my life.",
          "plainText": "I yield thee up my life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "What is't thou say'st?",
          "plainText": "What is't thou say'st",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "dercetus",
        "name": "DERCETUS",
        "displayName": "Dercetus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "I say, O Caesar, Antony is dead.",
          "plainText": "I say O Caesar Antony is dead",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "The breaking of so great a thing should make",
          "plainText": "The breaking of so great a thing should make",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "A greater crack. The round world",
          "plainText": "A greater crack The round world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Should have shook lions into civil streets,",
          "plainText": "Should have shook lions into civil streets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "And citizens to their dens. The death of Antony",
          "plainText": "And citizens to their dens The death of Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Is not a single doom; in the name lay",
          "plainText": "Is not a single doom in the name lay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "A moiety of the world.",
          "plainText": "A moiety of the world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "dercetus",
        "name": "DERCETUS",
        "displayName": "Dercetus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "He is dead, Caesar,",
          "plainText": "He is dead Caesar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Not by a public minister of justice,",
          "plainText": "Not by a public minister of justice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "Nor by a hired knife, but that self hand",
          "plainText": "Nor by a hired knife but that self hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "Which writ his honour in the acts it did",
          "plainText": "Which writ his honour in the acts it did",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "Hath, with the courage which the heart did lend it,",
          "plainText": "Hath with the courage which the heart did lend it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 6,
          "text": "Splitted the heart. This is his sword.",
          "plainText": "Splitted the heart This is his sword",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 7,
          "text": "I robbed his wound of it. Behold it stained",
          "plainText": "I robbed his wound of it Behold it stained",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0030",
          "number": 30,
          "speechLineNumber": 8,
          "text": "With his most noble blood.",
          "plainText": "With his most noble blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Look you sad, friends?",
          "plainText": "Look you sad friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "The gods rebuke me, but it is tidings",
          "plainText": "The gods rebuke me but it is tidings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "To wash the eyes of kings.",
          "plainText": "To wash the eyes of kings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "And strange it is",
          "plainText": "And strange it is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "That nature must compel us to lament",
          "plainText": "That nature must compel us to lament",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Our most persisted deeds.",
          "plainText": "Our most persisted deeds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "maecenas",
        "name": "MAECENAS",
        "displayName": "Maecenas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "His taints and honours",
          "plainText": "His taints and honours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Waged equal with him.",
          "plainText": "Waged equal with him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "A rarer spirit never",
          "plainText": "A rarer spirit never",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "Did steer humanity, but you gods will give us",
          "plainText": "Did steer humanity but you gods will give us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "Some faults to make us men. Caesar is touched.",
          "plainText": "Some faults to make us men Caesar is touched",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "maecenas",
        "name": "MAECENAS",
        "displayName": "Maecenas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "When such a spacious mirror's set before him,",
          "plainText": "When such a spacious mirror's set before him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "He needs must see himself.",
          "plainText": "He needs must see himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "O Antony,",
          "plainText": "O Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "I have followed thee to this, but we do lance",
          "plainText": "I have followed thee to this but we do lance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "Diseases in our bodies. I must perforce",
          "plainText": "Diseases in our bodies I must perforce",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "Have shown to thee such a declining day",
          "plainText": "Have shown to thee such a declining day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0048",
          "number": 48,
          "speechLineNumber": 5,
          "text": "Or look on thine. We could not stall together",
          "plainText": "Or look on thine We could not stall together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0049",
          "number": 49,
          "speechLineNumber": 6,
          "text": "In the whole world. But yet let me lament",
          "plainText": "In the whole world But yet let me lament",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0050",
          "number": 50,
          "speechLineNumber": 7,
          "text": "With tears as sovereign as the blood of hearts,",
          "plainText": "With tears as sovereign as the blood of hearts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0051",
          "number": 51,
          "speechLineNumber": 8,
          "text": "That thou, my brother, my competitor",
          "plainText": "That thou my brother my competitor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0052",
          "number": 52,
          "speechLineNumber": 9,
          "text": "In top of all design, my mate in empire,",
          "plainText": "In top of all design my mate in empire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0053",
          "number": 53,
          "speechLineNumber": 10,
          "text": "Friend and companion in the front of war,",
          "plainText": "Friend and companion in the front of war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0054",
          "number": 54,
          "speechLineNumber": 11,
          "text": "The arm of mine own body, and the heart",
          "plainText": "The arm of mine own body and the heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0055",
          "number": 55,
          "speechLineNumber": 12,
          "text": "Where mine his thoughts did kindle, that our stars,",
          "plainText": "Where mine his thoughts did kindle that our stars",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0056",
          "number": 56,
          "speechLineNumber": 13,
          "text": "Unreconciliable, should divide",
          "plainText": "Unreconciliable should divide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0057",
          "number": 57,
          "speechLineNumber": 14,
          "text": "Our equalness to this. Hear me, good friends—",
          "plainText": "Our equalness to this Hear me good friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-stage-004",
      "type": "stage",
      "text": "Enter an Egyptian."
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "egyptian",
        "name": "EGYPTIAN",
        "displayName": "Egyptian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "A poor Egyptian yet. The queen, my mistress,",
          "plainText": "A poor Egyptian yet The queen my mistress",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "Confined in all she has, her monument,",
          "plainText": "Confined in all she has her monument",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "Of thy intents desires instruction,",
          "plainText": "Of thy intents desires instruction",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0061",
          "number": 61,
          "speechLineNumber": 4,
          "text": "That she preparedly may frame herself",
          "plainText": "That she preparedly may frame herself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0062",
          "number": 62,
          "speechLineNumber": 5,
          "text": "To the way she's forced to.",
          "plainText": "To the way she's forced to",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Bid her have good heart.",
          "plainText": "Bid her have good heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "She soon shall know of us, by some of ours,",
          "plainText": "She soon shall know of us by some of ours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "How honourable and how kindly we",
          "plainText": "How honourable and how kindly we",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "Determine for her. For Caesar cannot lean",
          "plainText": "Determine for her For Caesar cannot lean",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0067",
          "number": 67,
          "speechLineNumber": 5,
          "text": "To be ungentle.",
          "plainText": "To be ungentle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "egyptian",
        "name": "EGYPTIAN",
        "displayName": "Egyptian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "So the gods preserve thee!",
          "plainText": "So the gods preserve thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-stage-005",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Come hither, Proculeius. Go and say",
          "plainText": "Come hither Proculeius Go and say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "We purpose her no shame. Give her what comforts",
          "plainText": "We purpose her no shame Give her what comforts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0071",
          "number": 71,
          "speechLineNumber": 3,
          "text": "The quality of her passion shall require,",
          "plainText": "The quality of her passion shall require",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0072",
          "number": 72,
          "speechLineNumber": 4,
          "text": "Lest, in her greatness, by some mortal stroke",
          "plainText": "Lest in her greatness by some mortal stroke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0073",
          "number": 73,
          "speechLineNumber": 5,
          "text": "She do defeat us, for her life in Rome",
          "plainText": "She do defeat us for her life in Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0074",
          "number": 74,
          "speechLineNumber": 6,
          "text": "Would be eternal in our triumph. Go,",
          "plainText": "Would be eternal in our triumph Go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0075",
          "number": 75,
          "speechLineNumber": 7,
          "text": "And with your speediest bring us what she says",
          "plainText": "And with your speediest bring us what she says",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0076",
          "number": 76,
          "speechLineNumber": 8,
          "text": "And how you find of her.",
          "plainText": "And how you find of her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "proculeius",
        "name": "PROCULEIUS",
        "displayName": "Proculeius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Caesar, I shall.",
          "plainText": "Caesar I shall",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-stage-006",
      "type": "stage",
      "text": "[Exit Proculeius.]"
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "Gallus, go you along.",
          "plainText": "Gallus go you along",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-stage-007",
      "type": "stage",
      "text": "[Exit Gallus.]"
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Dolabella!",
          "plainText": "Dolabella",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-5-1-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "Let him alone, for I remember now",
          "plainText": "Let him alone for I remember now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0081",
          "number": 81,
          "speechLineNumber": 2,
          "text": "How he's employed. He shall in time be ready.",
          "plainText": "How he's employed He shall in time be ready",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0082",
          "number": 82,
          "speechLineNumber": 3,
          "text": "Go with me to my tent, where you shall see",
          "plainText": "Go with me to my tent where you shall see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0083",
          "number": 83,
          "speechLineNumber": 4,
          "text": "How hardly I was drawn into this war,",
          "plainText": "How hardly I was drawn into this war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0084",
          "number": 84,
          "speechLineNumber": 5,
          "text": "How calm and gentle I proceeded still",
          "plainText": "How calm and gentle I proceeded still",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0085",
          "number": 85,
          "speechLineNumber": 6,
          "text": "In all my writings. Go with me and see",
          "plainText": "In all my writings Go with me and see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-5-1-line-0086",
          "number": 86,
          "speechLineNumber": 7,
          "text": "What I can show in this.",
          "plainText": "What I can show in this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-5-1-stage-008",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}