    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@192191",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nWherefore is that? And what art thou that dar’st\nAppear thus to us?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192191/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192191/line-2",
          "start": 8,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192191/line-3",
          "start": 57,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 499930,
        "end": 500040,
        "line": 18631,
        "column": 1,
        "path": "chap03/p@192191",
        "anchor": "sceneV_3.1"
      },
      "speakerLabel": "CAESAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@192305",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DERCETUS.\nI am called Dercetus.\nMark Antony I served, who best was worthy\nBest to be served. Whilst he stood up and spoke,\nHe was my master, and I wore my life\nTo spend upon his haters. If thou please\nTo take me to thee, as I was to him\nI’ll be to Caesar; if thou pleasest not,\nI yield thee up my life.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192305/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192305/line-2",
          "start": 10,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192305/line-3",
          "start": 32,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192305/line-4",
          "start": 74,
          "end": 122,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192305/line-5",
          "start": 123,
          "end": 159,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@192305/line-6",
