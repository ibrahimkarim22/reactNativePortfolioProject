      }
    },
    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@193492",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAESAR.\nLook you sad, friends?\nThe gods rebuke me, but it is tidings\nTo wash the eyes of kings.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193492/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193492/line-2",
          "start": 8,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193492/line-3",
          "start": 31,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193492/line-4",
          "start": 69,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 501231,
        "end": 501366,
        "line": 18681,
        "column": 1,
        "path": "chap03/p@193492",
        "anchor": "sceneV_3.1"
      },
      "speakerLabel": "CAESAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@193631",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AGRIPPA.\nAnd strange it is\nThat nature must compel us to lament\nOur most persisted deeds.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193631/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193631/line-2",
          "start": 9,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193631/line-3",
          "start": 27,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193631/line-4",
          "start": 64,
          "end": 89,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 501370,
        "end": 501499,
        "line": 18688,
        "column": 1,
        "path": "chap03/p@193631",
        "anchor": "sceneV_3.1"
      },
      "speakerLabel": "AGRIPPA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@193764",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MAECENAS.\nHis taints and honours\nWaged equal with him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@193764/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
