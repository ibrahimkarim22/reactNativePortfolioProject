    {
      "id": "antony-and-cleopatra/sceneV_3.1/p@194892",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "But I will tell you at some meeter season.\nThe business of this man looks out of him;\nWe’ll hear him what he says. Whence are you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "antony-and-cleopatra/sceneV_3.1/p@194892/line-1",
