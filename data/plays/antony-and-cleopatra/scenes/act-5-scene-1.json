      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MAECENAS.\nWhen such a spacious mirror’s set before him,\nHe needs must see himself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
