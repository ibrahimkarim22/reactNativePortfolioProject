        "cueEnd": 11
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.2/p@44935",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nMy lord, the roynish clown, at whom so oft\nYour grace was wont to laugh, is also missing.\nHesperia, the princess’ gentlewoman,\nConfesses that she secretly o’erheard\nYour daughter and her cousin much commend\nThe parts and graces of the wrestler\nThat did but lately foil the sinewy Charles;\nAnd she believes wherever they are gone\nThat youth is surely in their company.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.2/p@44935/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
