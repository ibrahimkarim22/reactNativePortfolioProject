          "start": 57,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.2/p@44525/line-4",
          "start": 97,
          "end": 135,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 574900,
        "end": 575075,
        "line": 21636,
        "column": 1,
        "path": "chap04/p@44525",
        "anchor": "sceneII_4.2"
      },
      "speakerLabel": "DUKE FREDERICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.2/p@44704",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nI cannot hear of any that did see her.\nThe ladies, her attendants of her chamber,\nSaw her abed, and in the morning early\nThey found the bed untreasured of their mistress.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.2/p@44704/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.2/p@44704/line-2",
          "start": 12,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.2/p@44704/line-3",
          "start": 51,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.2/p@44704/line-4",
          "start": 94,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.2/p@44704/line-5",
          "start": 133,
          "end": 182,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 575079,
        "end": 575306,
        "line": 21643,
        "column": 1,
        "path": "chap04/p@44704",
        "anchor": "sceneII_4.2"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
