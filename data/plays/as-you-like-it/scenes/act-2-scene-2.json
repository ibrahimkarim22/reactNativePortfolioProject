    {
      "id": "as-you-like-it/sceneII_4.2/p@44525",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE FREDERICK.\nCan it be possible that no man saw them?\nIt cannot be! Some villains of my court\nAre of consent and sufferance in this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.2/p@44525/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
