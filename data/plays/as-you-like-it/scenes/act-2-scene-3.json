    {
      "id": "as-you-like-it/sceneII_4.3/p@47502",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ORLANDO.\nWhat, wouldst thou have me go and beg my food,\nOr with a base and boisterous sword enforce\nA thievish living on the common road?\nThis I must do, or know not what to do.\nYet this I will not do, do how I can.\nI rather will subject me to the malice\nOf a diverted blood and bloody brother.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
