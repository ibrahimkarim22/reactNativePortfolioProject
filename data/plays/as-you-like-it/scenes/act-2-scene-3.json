  },
  "content": [
    {
      "id": "as-you-like-it-2-3-stage-001",
      "type": "stage",
      "text": "Enter Orlando and Adam, meeting."
    },
    {
      "id": "as-you-like-it-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Who's there?",
          "plainText": "Who's there",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "adam",
        "name": "ADAM",
        "displayName": "Adam"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "What, my young master? O my gentle master,",
          "plainText": "What my young master O my gentle master",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "O my sweet master, O you memory",
          "plainText": "O my sweet master O you memory",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "Of old Sir Rowland! Why, what make you here?",
          "plainText": "Of old Sir Rowland Why what make you here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "Why are you virtuous? Why do people love you?",
          "plainText": "Why are you virtuous Why do people love you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 5,
          "text": "And wherefore are you gentle, strong, and valiant?",
          "plainText": "And wherefore are you gentle strong and valiant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 6,
          "text": "Why would you be so fond to overcome",
          "plainText": "Why would you be so fond to overcome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 7,
          "text": "The bonny prizer of the humorous Duke?",
          "plainText": "The bonny prizer of the humorous Duke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 8,
          "text": "Your praise is come too swiftly home before you.",
          "plainText": "Your praise is come too swiftly home before you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 9,
          "text": "Know you not, master, to some kind of men",
          "plainText": "Know you not master to some kind of men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 10,
          "text": "Their graces serve them but as enemies?",
          "plainText": "Their graces serve them but as enemies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 11,
          "text": "No more do yours. Your virtues, gentle master,",
          "plainText": "No more do yours Your virtues gentle master",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 12,
          "text": "Are sanctified and holy traitors to you.",
          "plainText": "Are sanctified and holy traitors to you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 13,
          "text": "O, what a world is this, when what is comely",
          "plainText": "O what a world is this when what is comely",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 14,
          "text": "Envenoms him that bears it!",
          "plainText": "Envenoms him that bears it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Why, what's the matter?",
          "plainText": "Why what's the matter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "adam",
        "name": "ADAM",
        "displayName": "Adam"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "O unhappy youth,",
          "plainText": "O unhappy youth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Come not within these doors! Within this roof",
          "plainText": "Come not within these doors Within this roof",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "The enemy of all your graces lives.",
          "plainText": "The enemy of all your graces lives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "Your brother—no, no brother, yet the son—",
          "plainText": "Your brotherno no brother yet the son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Yet not the son; I will not call him son—",
          "plainText": "Yet not the son I will not call him son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "Of him I was about to call his father,",
          "plainText": "Of him I was about to call his father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 7,
          "text": "Hath heard your praises, and this night he means",
          "plainText": "Hath heard your praises and this night he means",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 8,
          "text": "To burn the lodging where you use to lie,",
          "plainText": "To burn the lodging where you use to lie",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 9,
          "text": "And you within it. If he fail of that,",
          "plainText": "And you within it If he fail of that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 10,
          "text": "He will have other means to cut you off;",
          "plainText": "He will have other means to cut you off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 11,
          "text": "I overheard him and his practices.",
          "plainText": "I overheard him and his practices",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 12,
          "text": "This is no place; this house is but a butchery.",
          "plainText": "This is no place this house is but a butchery",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 13,
          "text": "Abhor it, fear it, do not enter it.",
          "plainText": "Abhor it fear it do not enter it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Why, whither, Adam, wouldst thou have me go?",
          "plainText": "Why whither Adam wouldst thou have me go",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "adam",
        "name": "ADAM",
        "displayName": "Adam"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "No matter whither, so you come not here.",
          "plainText": "No matter whither so you come not here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "What, wouldst thou have me go and beg my food,",
          "plainText": "What wouldst thou have me go and beg my food",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Or with a base and boisterous sword enforce",
          "plainText": "Or with a base and boisterous sword enforce",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "A thievish living on the common road?",
          "plainText": "A thievish living on the common road",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "This I must do, or know not what to do.",
          "plainText": "This I must do or know not what to do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "Yet this I will not do, do how I can.",
          "plainText": "Yet this I will not do do how I can",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "I rather will subject me to the malice",
          "plainText": "I rather will subject me to the malice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "Of a diverted blood and bloody brother.",
          "plainText": "Of a diverted blood and bloody brother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "adam",
        "name": "ADAM",
        "displayName": "Adam"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "But do not so. I have five hundred crowns,",
          "plainText": "But do not so I have five hundred crowns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "The thrifty hire I saved under your father,",
          "plainText": "The thrifty hire I saved under your father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "Which I did store to be my foster-nurse,",
          "plainText": "Which I did store to be my fosternurse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0042",
          "number": 42,
          "speechLineNumber": 4,
          "text": "When service should in my old limbs lie lame,",
          "plainText": "When service should in my old limbs lie lame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0043",
          "number": 43,
          "speechLineNumber": 5,
          "text": "And unregarded age in corners thrown.",
          "plainText": "And unregarded age in corners thrown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0044",
          "number": 44,
          "speechLineNumber": 6,
          "text": "Take that, and He that doth the ravens feed,",
          "plainText": "Take that and He that doth the ravens feed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0045",
          "number": 45,
          "speechLineNumber": 7,
          "text": "Yea, providently caters for the sparrow,",
          "plainText": "Yea providently caters for the sparrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0046",
          "number": 46,
          "speechLineNumber": 8,
          "text": "Be comfort to my age. Here is the gold.",
          "plainText": "Be comfort to my age Here is the gold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0047",
          "number": 47,
          "speechLineNumber": 9,
          "text": "All this I give you. Let me be your servant.",
          "plainText": "All this I give you Let me be your servant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0048",
          "number": 48,
          "speechLineNumber": 10,
          "text": "Though I look old, yet I am strong and lusty,",
          "plainText": "Though I look old yet I am strong and lusty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0049",
          "number": 49,
          "speechLineNumber": 11,
          "text": "For in my youth I never did apply",
          "plainText": "For in my youth I never did apply",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0050",
          "number": 50,
          "speechLineNumber": 12,
          "text": "Hot and rebellious liquors in my blood,",
          "plainText": "Hot and rebellious liquors in my blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0051",
          "number": 51,
          "speechLineNumber": 13,
          "text": "Nor did not with unbashful forehead woo",
          "plainText": "Nor did not with unbashful forehead woo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0052",
          "number": 52,
          "speechLineNumber": 14,
          "text": "The means of weakness and debility.",
          "plainText": "The means of weakness and debility",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0053",
          "number": 53,
          "speechLineNumber": 15,
          "text": "Therefore my age is as a lusty winter,",
          "plainText": "Therefore my age is as a lusty winter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0054",
          "number": 54,
          "speechLineNumber": 16,
          "text": "Frosty but kindly. Let me go with you.",
          "plainText": "Frosty but kindly Let me go with you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0055",
          "number": 55,
          "speechLineNumber": 17,
          "text": "I'll do the service of a younger man",
          "plainText": "I'll do the service of a younger man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0056",
          "number": 56,
          "speechLineNumber": 18,
          "text": "In all your business and necessities.",
          "plainText": "In all your business and necessities",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-3-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "O good old man, how well in thee appears",
          "plainText": "O good old man how well in thee appears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "The constant service of the antique world,",
          "plainText": "The constant service of the antique world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0059",
          "number": 59,
          "speechLineNumber": 3,
          "text": "When service sweat for duty, not for meed.",
          "plainText": "When service sweat for duty not for meed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0060",
          "number": 60,
          "speechLineNumber": 4,
          "text": "Thou art not for the fashion of these times,",
          "plainText": "Thou art not for the fashion of these times",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0061",
          "number": 61,
          "speechLineNumber": 5,
          "text": "Where none will sweat but for promotion,",
          "plainText": "Where none will sweat but for promotion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0062",
          "number": 62,
          "speechLineNumber": 6,
          "text": "And having that do choke their service up",
          "plainText": "And having that do choke their service up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0063",
          "number": 63,
          "speechLineNumber": 7,
          "text": "Even with the having. It is not so with thee.",
          "plainText": "Even with the having It is not so with thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0064",
          "number": 64,
          "speechLineNumber": 8,
          "text": "But, poor old man, thou prun'st a rotten tree,",
          "plainText": "But poor old man thou prun'st a rotten tree",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0065",
          "number": 65,
          "speechLineNumber": 9,
          "text": "That cannot so much as a blossom yield",
          "plainText": "That cannot so much as a blossom yield",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0066",
          "number": 66,
          "speechLineNumber": 10,
          "text": "In lieu of all thy pains and husbandry.",
          "plainText": "In lieu of all thy pains and husbandry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0067",
          "number": 67,
          "speechLineNumber": 11,
          "text": "But come thy ways, we'll go along together,",
          "plainText": "But come thy ways we'll go along together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0068",
          "number": 68,
          "speechLineNumber": 12,
          "text": "And ere we have thy youthful wages spent",
          "plainText": "And ere we have thy youthful wages spent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0069",
          "number": 69,
          "speechLineNumber": 13,
          "text": "We'll light upon some settled low content.",
          "plainText": "We'll light upon some settled low content",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "adam",
        "name": "ADAM",
        "displayName": "Adam"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-3-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Master, go on and I will follow thee",
          "plainText": "Master go on and I will follow thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "To the last gasp with truth and loyalty.",
          "plainText": "To the last gasp with truth and loyalty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0072",
          "number": 72,
          "speechLineNumber": 3,
          "text": "From seventeen years till now almost fourscore",
          "plainText": "From seventeen years till now almost fourscore",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0073",
          "number": 73,
          "speechLineNumber": 4,
          "text": "Here lived I, but now live here no more.",
          "plainText": "Here lived I but now live here no more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0074",
          "number": 74,
          "speechLineNumber": 5,
          "text": "At seventeen years many their fortunes seek,",
          "plainText": "At seventeen years many their fortunes seek",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0075",
          "number": 75,
          "speechLineNumber": 6,
          "text": "But at fourscore it is too late a week.",
          "plainText": "But at fourscore it is too late a week",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0076",
          "number": 76,
          "speechLineNumber": 7,
          "text": "Yet fortune cannot recompense me better",
          "plainText": "Yet fortune cannot recompense me better",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-3-line-0077",
          "number": 77,
          "speechLineNumber": 8,
          "text": "Than to die well and not my master's debtor.",
          "plainText": "Than to die well and not my master's debtor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}