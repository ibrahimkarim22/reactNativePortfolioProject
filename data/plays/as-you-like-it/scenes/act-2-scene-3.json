      ],
      "text": "ORLANDO.\nWho’s there?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.3/p@45914/line-1",
          "start": 0,
