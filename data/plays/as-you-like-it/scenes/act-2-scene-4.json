        },
        {
          "tag": "span",
          "start": 49,
          "end": 59,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@49898/line-1",
          "start": 0,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 580273,
        "end": 580454,
        "line": 21803,
        "column": 1,
        "path": "chap04/p@49898",
