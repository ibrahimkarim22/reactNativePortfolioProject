      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nThou speak’st wiser than thou art ware of.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@53229/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
