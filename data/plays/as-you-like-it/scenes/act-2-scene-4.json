      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nJove, Jove, this shepherd’s passion\nIs much upon my fashion.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@53437/line-1",
