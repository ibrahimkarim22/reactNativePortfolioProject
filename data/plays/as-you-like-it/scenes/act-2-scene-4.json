      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TOUCHSTONE.\nAnd mine, but it grows something stale with me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
