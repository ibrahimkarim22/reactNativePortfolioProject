      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@50083",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nO Jupiter, how weary are my spirits!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@50083/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@50083/line-2",
          "start": 10,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 580458,
        "end": 580534,
        "line": 21809,
        "column": 1,
        "path": "chap04/p@50083",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@50163",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TOUCHSTONE.\nI care not for my spirits, if my legs were not weary.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@50163/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@50163/line-2",
          "start": 12,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 580538,
        "end": 580633,
        "line": 21814,
        "column": 1,
        "path": "chap04/p@50163",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "TOUCHSTONE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@50262",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nI could find in my heart to disgrace my man’s apparel, and to cry like a woman, but I must comfort the weaker vessel, as doublet and hose ought to show itself courageous to petticoat. Therefore, courage, good Aliena.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@50262/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@50262/line-2",
          "start": 10,
          "end": 226,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 580637,
        "end": 580895,
        "line": 21819,
        "column": 1,
        "path": "chap04/p@50262",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@50524",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nI pray you bear with me, I cannot go no further.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@50524/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@50524/line-2",
          "start": 7,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 580899,
        "end": 580984,
        "line": 21826,
        "column": 1,
        "path": "chap04/p@50524",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@50613",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TOUCHSTONE.\nFor my part, I had rather bear with you than bear you. Yet I should bear no cross if I did bear you, for I think you have no money in your purse.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@50613/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@50613/line-2",
          "start": 12,
          "end": 157,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 580988,
        "end": 581176,
        "line": 21831,
        "column": 1,
        "path": "chap04/p@50613",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "TOUCHSTONE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@50805",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nWell, this is the forest of Arden.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@50805/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@50805/line-2",
          "start": 10,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 581180,
        "end": 581254,
        "line": 21837,
        "column": 1,
        "path": "chap04/p@50805",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@50883",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TOUCHSTONE.\nAy, now am I in Arden, the more fool I! When I was at home I was in a better place, but travellers must be content.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@50883/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@50883/line-2",
          "start": 12,
          "end": 127,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 581258,
        "end": 581416,
        "line": 21842,
        "column": 1,
        "path": "chap04/p@50883",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "TOUCHSTONE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@51045",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Corin and Silvius.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 11,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 16,
          "end": 23,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@51045/line-1",
          "start": 0,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 581420,
        "end": 581534,
        "line": 21848,
        "column": 1,
        "path": "chap04/p@51045",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@51163",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nAy, be so, good Touchstone. Look you, who comes here? A young man and an old in solemn talk.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@51163/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51163/line-2",
          "start": 10,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 581538,
        "end": 581671,
        "line": 21853,
        "column": 1,
        "path": "chap04/p@51163",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@51300",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIN.\nThat is the way to make her scorn you still.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@51300/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51300/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 581675,
        "end": 581756,
        "line": 21859,
        "column": 1,
        "path": "chap04/p@51300",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "CORIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@51385",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SILVIUS.\nO Corin, that thou knew’st how I do love her!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@51385/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51385/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 581760,
        "end": 581844,
        "line": 21864,
        "column": 1,
        "path": "chap04/p@51385",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "SILVIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@51473",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIN.\nI partly guess, for I have loved ere now.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@51473/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51473/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 581848,
        "end": 581926,
        "line": 21869,
        "column": 1,
        "path": "chap04/p@51473",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "CORIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@51555",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SILVIUS.\nNo, Corin, being old, thou canst not guess,\nThough in thy youth thou wast as true a lover\nAs ever sighed upon a midnight pillow.\nBut if thy love were ever like to mine—\nAs sure I think did never man love so—\nHow many actions most ridiculous\nHast thou been drawn to by thy fantasy?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@51555/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51555/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51555/line-3",
          "start": 53,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51555/line-4",
          "start": 99,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51555/line-5",
          "start": 138,
          "end": 177,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51555/line-6",
          "start": 178,
          "end": 216,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51555/line-7",
          "start": 217,
          "end": 249,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51555/line-8",
          "start": 250,
          "end": 289,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 581930,
        "end": 582279,
        "line": 21874,
        "column": 1,
        "path": "chap04/p@51555",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "SILVIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@51908",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIN.\nInto a thousand that I have forgotten.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@51908/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51908/line-2",
          "start": 7,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 582283,
        "end": 582358,
        "line": 21885,
        "column": 1,
        "path": "chap04/p@51908",
        "anchor": "sceneII_4.4"
      },
      "speakerLabel": "CORIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.4/p@51987",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SILVIUS.\nO, thou didst then never love so heartily!\nIf thou rememb’rest not the slightest folly\nThat ever love did make thee run into,\nThou hast not loved.\nOr if thou hast not sat as I do now,\nWearing thy hearer in thy mistress’ praise,\nThou hast not loved.\nOr if thou hast not broke from company\nAbruptly, as my passion now makes me,\nThou hast not loved.\nO Phoebe, Phoebe, Phoebe!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@51987/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.4/p@51987/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        },
        {
