      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TOUCHSTONE.\nNay, I shall ne’er be ware of mine own wit till I break my shins against it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
