      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIN.\nAnd to you, gentle sir, and to you all.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.4/p@54201/line-1",
