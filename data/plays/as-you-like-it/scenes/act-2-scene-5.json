    {
      "id": "as-you-like-it/sceneII_4.5/p@56234",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "        Under the greenwood tree,\n        Who loves to lie with me\n        And turn his merry note\n        Unto the sweet bird’s throat,\n    Come hither, come hither, come hither!\n        Here shall he see\n        No enemy\n    But winter and rough weather.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
