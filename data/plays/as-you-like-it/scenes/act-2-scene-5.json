    {
      "id": "as-you-like-it/sceneII_4.5/p@56554",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAQUES.\nMore, more, I prithee, more.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@56554/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@56554/line-2",
          "start": 8,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 586929,
        "end": 586995,
        "line": 22069,
        "column": 1,
        "path": "chap04/p@56554",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "JAQUES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@56624",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AMIENS.\nIt will make you melancholy, Monsieur Jaques.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@56624/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@56624/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 586999,
        "end": 587082,
        "line": 22074,
        "column": 1,
        "path": "chap04/p@56624",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "AMIENS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@56711",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAQUES.\nI thank it. More, I prithee, more. I can suck melancholy out of a song as a weasel sucks eggs. More, I prithee, more.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@56711/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@56711/line-2",
          "start": 8,
          "end": 125,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 587086,
        "end": 587242,
        "line": 22079,
        "column": 1,
        "path": "chap04/p@56711",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "JAQUES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@56871",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AMIENS.\nMy voice is ragged. I know I cannot please you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@56871/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@56871/line-2",
          "start": 8,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 587246,
        "end": 587331,
        "line": 22085,
        "column": 1,
        "path": "chap04/p@56871",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "AMIENS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@56960",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAQUES.\nI do not desire you to please me; I do desire you to sing. Come, more, another stanzo. Call you ’em stanzos?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 87,
          "end": 93
        },
        {
          "tag": "i",
          "start": 108,
          "end": 116
        }
      ],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@56960/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@56960/line-2",
          "start": 8,
          "end": 116,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 587335,
        "end": 587496,
        "line": 22090,
        "column": 1,
        "path": "chap04/p@56960",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "JAQUES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@57125",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AMIENS.\nWhat you will, Monsieur Jaques.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@57125/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@57125/line-2",
          "start": 8,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 587500,
        "end": 587569,
        "line": 22096,
        "column": 1,
        "path": "chap04/p@57125",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "AMIENS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@57198",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAQUES.\nNay, I care not for their names. They owe me nothing. Will you sing?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@57198/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@57198/line-2",
          "start": 8,
          "end": 76,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 587573,
        "end": 587679,
        "line": 22101,
        "column": 1,
        "path": "chap04/p@57198",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "JAQUES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@57308",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AMIENS.\nMore at your request than to please myself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@57308/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@57308/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 587683,
        "end": 587764,
        "line": 22106,
        "column": 1,
        "path": "chap04/p@57308",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "AMIENS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@57393",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAQUES.\nWell then, if ever I thank any man, I’ll thank you; but that they call compliment is like th’ encounter of two dog-apes. And when a man thanks me heartily, methinks I have given him a penny and he renders me the beggarly thanks. Come, sing; and you that will not, hold your tongues.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@57393/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@57393/line-2",
          "start": 8,
          "end": 290,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 587768,
        "end": 588091,
        "line": 22111,
        "column": 1,
        "path": "chap04/p@57393",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "JAQUES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@57720",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AMIENS.\nWell, I’ll end the song.—Sirs, cover the while. The Duke will drink under this tree; he hath been all this day to look you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@57720/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@57720/line-2",
          "start": 8,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 588095,
        "end": 588257,
        "line": 22119,
        "column": 1,
        "path": "chap04/p@57720",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "AMIENS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@57886",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAQUES.\nAnd I have been all this day to avoid him. He is too disputable for my company. I think of as many matters as he, but I give heaven thanks and make no boast of them. Come, warble, come.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@57886/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@57886/line-2",
          "start": 8,
          "end": 193,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 588261,
        "end": 588486,
        "line": 22125,
        "column": 1,
        "path": "chap04/p@57886",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "JAQUES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@58115",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AMIENS.\n[Sings.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 9,
          "end": 14
        }
      ],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@58115/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@58115/line-2",
          "start": 8,
          "end": 16,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 588490,
        "end": 588543,
        "line": 22132,
        "column": 1,
        "path": "chap04/p@58115",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": "AMIENS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@58172",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "        Who doth ambition shun\n        And loves to live i’ th’ sun,\n        Seeking the food he eats\n        And pleased with what he gets,\n    Come hither, come hither, come hither.\n        Here shall he see\n        No enemy\n    But winter and rough weather.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneII_4.5/p@58172/line-1",
          "start": 0,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@58172/line-2",
          "start": 31,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@58172/line-3",
          "start": 69,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@58172/line-4",
          "start": 102,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@58172/line-5",
          "start": 141,
          "end": 183,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@58172/line-6",
          "start": 184,
          "end": 209,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@58172/line-7",
          "start": 210,
          "end": 226,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneII_4.5/p@58172/line-8",
          "start": 227,
          "end": 260,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 588547,
        "end": 588867,
        "line": 22137,
        "column": 1,
        "path": "chap04/p@58172",
        "anchor": "sceneII_4.5"
      },
      "speakerLabel": null,
