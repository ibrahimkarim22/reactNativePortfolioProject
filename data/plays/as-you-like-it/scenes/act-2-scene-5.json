        "status": "source-unlabelled"
      }
    },
    {
      "id": "as-you-like-it/sceneII_4.5/p@58496",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAQUES.\nI’ll give you a verse to this note that I made yesterday in despite of my invention.",
      "separatorAfter": "\n\n",
      "spans": [],
