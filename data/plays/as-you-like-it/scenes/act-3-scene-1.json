      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OLIVER.\nO that your highness knew my heart in this:\nI never loved my brother in my life.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
