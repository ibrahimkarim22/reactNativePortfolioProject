    {
      "id": "as-you-like-it/sceneIII_4.1/p@73227",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE FREDERICK.\nMore villain thou. Well, push him out of doors,\nAnd let my officers of such a nature\nMake an extent upon his house and lands.\nDo this expediently, and turn him going.",
