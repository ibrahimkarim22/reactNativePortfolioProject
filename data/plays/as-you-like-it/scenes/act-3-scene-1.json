  "scene": {
    "id": "as-you-like-it-3-1",
    "act": 3,
    "scene": 1,
    "label": "Act 3, Scene 1",
    "title": "SCENE I. A Room in the Palace",
    "location": "A Room in the Palace",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "as-you-like-it-3-1-stage-001",
      "type": "stage",
      "text": "Enter Duke Frederick, Lords and Oliver."
    },
    {
      "id": "as-you-like-it-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "duke-frederick",
        "name": "DUKE FREDERICK",
        "displayName": "Duke Frederick"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Not see him since? Sir, sir, that cannot be.",
          "plainText": "Not see him since Sir sir that cannot be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "But were I not the better part made mercy,",
          "plainText": "But were I not the better part made mercy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "I should not seek an absent argument",
          "plainText": "I should not seek an absent argument",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Of my revenge, thou present. But look to it:",
          "plainText": "Of my revenge thou present But look to it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Find out thy brother wheresoe'er he is.",
          "plainText": "Find out thy brother wheresoe'er he is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Seek him with candle. Bring him dead or living",
          "plainText": "Seek him with candle Bring him dead or living",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Within this twelvemonth, or turn thou no more",
          "plainText": "Within this twelvemonth or turn thou no more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "To seek a living in our territory.",
          "plainText": "To seek a living in our territory",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Thy lands, and all things that thou dost call thine",
          "plainText": "Thy lands and all things that thou dost call thine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Worth seizure, do we seize into our hands,",
          "plainText": "Worth seizure do we seize into our hands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Till thou canst quit thee by thy brother's mouth",
          "plainText": "Till thou canst quit thee by thy brother's mouth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "Of what we think against thee.",
          "plainText": "Of what we think against thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "oliver",
        "name": "OLIVER",
        "displayName": "Oliver"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "O that your highness knew my heart in this:",
          "plainText": "O that your highness knew my heart in this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "I never loved my brother in my life.",
          "plainText": "I never loved my brother in my life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duke-frederick",
        "name": "DUKE FREDERICK",
        "displayName": "Duke Frederick"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "More villain thou. Well, push him out of doors,",
          "plainText": "More villain thou Well push him out of doors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "And let my officers of such a nature",
          "plainText": "And let my officers of such a nature",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "Make an extent upon his house and lands.",
          "plainText": "Make an extent upon his house and lands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "Do this expediently, and turn him going.",
          "plainText": "Do this expediently and turn him going",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-1-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}