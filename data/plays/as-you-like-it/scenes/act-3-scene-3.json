    {
      "id": "as-you-like-it/sceneIII_4.3/p@104311",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTEXT.\n’Tis no matter. Ne’er a fantastical knave of them all shall flout me out of my calling.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.3/p@104311/line-1",
