    },
    {
      "id": "as-you-like-it/sceneIII_4.3/p@104175",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt Touchstone, Audrey and Jaques.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 26,
          "className": "charname"
        },
