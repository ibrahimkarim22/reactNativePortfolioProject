      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Corin.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 11,
          "className": "charname"
        }
