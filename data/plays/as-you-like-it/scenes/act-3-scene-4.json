      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nWell, and what of him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107602/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107602/line-2",
          "start": 7,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 637977,
        "end": 638036,
        "line": 23926,
        "column": 1,
        "path": "chap04/p@107602",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@107665",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIN.\nIf you will see a pageant truly played\nBetween the pale complexion of true love\nAnd the red glow of scorn and proud disdain,\nGo hence a little, and I shall conduct you,\nIf you will mark it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107665/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107665/line-2",
          "start": 7,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107665/line-3",
          "start": 46,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107665/line-4",
          "start": 87,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107665/line-5",
          "start": 132,
          "end": 175,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107665/line-6",
          "start": 176,
          "end": 196,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 638040,
        "end": 638286,
        "line": 23931,
        "column": 1,
        "path": "chap04/p@107665",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CORIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@107915",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nO, come, let us remove.\nThe sight of lovers feedeth those in love.\nBring us to this sight, and you shall say\nI’ll prove a busy actor in their play.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
