    {
      "id": "as-you-like-it/sceneIII_4.4/p@107351",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIN.\nMistress and master, you have oft enquired\nAfter the shepherd that complained of love,\nWho you saw sitting by me on the turf,\nPraising the proud disdainful shepherdess\nThat was his mistress.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107351/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107351/line-2",
          "start": 7,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107351/line-3",
          "start": 50,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107351/line-4",
          "start": 94,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107351/line-5",
          "start": 133,
          "end": 174,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@107351/line-6",
