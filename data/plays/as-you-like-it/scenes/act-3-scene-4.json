        "status": "not-applicable"
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@104700",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nNever talk to me, I will weep.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@104700/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@104700/line-2",
          "start": 10,
          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 635075,
        "end": 635145,
        "line": 23804,
        "column": 1,
        "path": "chap04/p@104700",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@104774",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nDo, I prithee, but yet have the grace to consider that tears do not become a man.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@104774/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@104774/line-2",
          "start": 7,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 635149,
        "end": 635268,
        "line": 23809,
        "column": 1,
        "path": "chap04/p@104774",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@104897",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nBut have I not cause to weep?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@104897/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@104897/line-2",
          "start": 10,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 635272,
        "end": 635341,
        "line": 23815,
        "column": 1,
        "path": "chap04/p@104897",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@104970",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nAs good cause as one would desire; therefore weep.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@104970/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@104970/line-2",
          "start": 7,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 635345,
        "end": 635432,
        "line": 23820,
        "column": 1,
        "path": "chap04/p@104970",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@105061",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nHis very hair is of the dissembling colour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105061/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105061/line-2",
          "start": 10,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 635436,
        "end": 635519,
        "line": 23825,
        "column": 1,
        "path": "chap04/p@105061",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@105148",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nSomething browner than Judas’s. Marry, his kisses are Judas’s own children.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105148/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105148/line-2",
          "start": 7,
          "end": 82,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 635523,
        "end": 635635,
        "line": 23830,
        "column": 1,
        "path": "chap04/p@105148",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@105264",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nI’ faith, his hair is of a good colour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105264/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105264/line-2",
          "start": 10,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 635639,
        "end": 635718,
        "line": 23835,
        "column": 1,
        "path": "chap04/p@105264",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@105347",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nAn excellent colour. Your chestnut was ever the only colour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105347/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105347/line-2",
          "start": 7,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 635722,
        "end": 635819,
        "line": 23840,
        "column": 1,
        "path": "chap04/p@105347",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@105448",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nAnd his kissing is as full of sanctity as the touch of holy bread.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105448/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105448/line-2",
          "start": 10,
          "end": 76,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 635823,
        "end": 635929,
        "line": 23845,
        "column": 1,
        "path": "chap04/p@105448",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@105558",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nHe hath bought a pair of cast lips of Diana. A nun of winter’s sisterhood kisses not more religiously; the very ice of chastity is in them.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105558/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105558/line-2",
          "start": 7,
          "end": 146,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 635933,
        "end": 636110,
        "line": 23850,
        "column": 1,
        "path": "chap04/p@105558",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@105739",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nBut why did he swear he would come this morning, and comes not?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105739/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105739/line-2",
          "start": 10,
          "end": 73,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 636114,
        "end": 636217,
        "line": 23856,
        "column": 1,
        "path": "chap04/p@105739",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@105846",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nNay, certainly, there is no truth in him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105846/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105846/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 636221,
        "end": 636299,
        "line": 23861,
        "column": 1,
        "path": "chap04/p@105846",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@105928",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nDo you think so?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105928/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105928/line-2",
          "start": 10,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 636303,
        "end": 636359,
        "line": 23866,
        "column": 1,
        "path": "chap04/p@105928",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@105988",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nYes. I think he is not a pick-purse nor a horse-stealer, but for his verity in love, I do think him as concave as a covered goblet or a worm-eaten nut.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105988/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@105988/line-2",
          "start": 7,
          "end": 158,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 636363,
        "end": 636552,
        "line": 23871,
        "column": 1,
        "path": "chap04/p@105988",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@106181",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nNot true in love?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106181/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106181/line-2",
          "start": 10,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 636556,
        "end": 636613,
        "line": 23877,
        "column": 1,
        "path": "chap04/p@106181",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@106242",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nYes, when he is in, but I think he is not in.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106242/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106242/line-2",
          "start": 7,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 636617,
        "end": 636699,
        "line": 23882,
        "column": 1,
        "path": "chap04/p@106242",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@106328",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nYou have heard him swear downright he was.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106328/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106328/line-2",
          "start": 10,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 636703,
        "end": 636785,
        "line": 23887,
        "column": 1,
        "path": "chap04/p@106328",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@106414",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\n“Was” is not “is”. Besides, the oath of a lover is no stronger than the word of a tapster. They are both the confirmer of false reckonings. He attends here in the forest on the Duke your father.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106414/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106414/line-2",
          "start": 7,
          "end": 201,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 636789,
        "end": 637022,
        "line": 23892,
        "column": 1,
        "path": "chap04/p@106414",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "CELIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@106651",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSALIND.\nI met the Duke yesterday, and had much question with him. He asked me of what parentage I was. I told him, of as good as he, so he laughed and let me go. But what talk we of fathers when there is such a man as Orlando?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106651/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106651/line-2",
          "start": 10,
          "end": 228,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 637026,
        "end": 637286,
        "line": 23899,
        "column": 1,
        "path": "chap04/p@106651",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": "ROSALIND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "as-you-like-it/sceneIII_4.4/p@106915",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CELIA.\nO, that’s a brave man! He writes brave verses, speaks brave words, swears brave oaths, and breaks them bravely, quite traverse, athwart the heart of his lover, as a puny tilter, that spurs his horse but on one side, breaks his staff like a noble goose. But all’s brave that youth mounts and folly guides. Who comes here?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106915/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIII_4.4/p@106915/line-2",
          "start": 7,
          "end": 327,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
