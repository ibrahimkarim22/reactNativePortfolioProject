    "location": "Another part of the Forest. Before a Cottage",
    "orderInPlay": 14
  },
  "content": [
    {
      "id": "as-you-like-it-3-4-stage-001",
      "type": "stage",
      "text": "Enter Rosalind and Celia."
    },
    {
      "id": "as-you-like-it-3-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Never talk to me, I will weep.",
          "plainText": "Never talk to me I will weep",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Do, I prithee, but yet have the grace to consider that tears do not become a man.",
          "plainText": "Do I prithee but yet have the grace to consider that tears do not become a man",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "But have I not cause to weep?",
          "plainText": "But have I not cause to weep",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "As good cause as one would desire; therefore weep.",
          "plainText": "As good cause as one would desire therefore weep",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "His very hair is of the dissembling colour.",
          "plainText": "His very hair is of the dissembling colour",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Something browner than Judas's. Marry, his kisses are Judas's own children.",
          "plainText": "Something browner than Judas's Marry his kisses are Judas's own children",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "I' faith, his hair is of a good colour.",
          "plainText": "I' faith his hair is of a good colour",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "An excellent colour. Your chestnut was ever the only colour.",
          "plainText": "An excellent colour Your chestnut was ever the only colour",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "And his kissing is as full of sanctity as the touch of holy bread.",
          "plainText": "And his kissing is as full of sanctity as the touch of holy bread",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "He hath bought a pair of cast lips of Diana. A nun of winter's sisterhood kisses not more religiously; the very ice of chastity is in them.",
          "plainText": "He hath bought a pair of cast lips of Diana A nun of winter's sisterhood kisses not more religiously the very ice of chastity is in them",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "But why did he swear he would come this morning, and comes not?",
          "plainText": "But why did he swear he would come this morning and comes not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Nay, certainly, there is no truth in him.",
          "plainText": "Nay certainly there is no truth in him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Do you think so?",
          "plainText": "Do you think so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Yes. I think he is not a pick-purse nor a horse-stealer, but for his verity in love, I do think him as concave as a covered goblet or a worm-eaten nut.",
          "plainText": "Yes I think he is not a pickpurse nor a horsestealer but for his verity in love I do think him as concave as a covered goblet or a wormeaten nut",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Not true in love?",
          "plainText": "Not true in love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Yes, when he is in, but I think he is not in.",
          "plainText": "Yes when he is in but I think he is not in",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "You have heard him swear downright he was.",
          "plainText": "You have heard him swear downright he was",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "\"Was\" is not \"is\". Besides, the oath of a lover is no stronger than the word of a tapster. They are both the confirmer of false reckonings. He attends here in the forest on the Duke your father.",
          "plainText": "Was is not is Besides the oath of a lover is no stronger than the word of a tapster They are both the confirmer of false reckonings He attends here in the forest on the Duke your father",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I met the Duke yesterday, and had much question with him. He asked me of what parentage I was. I told him, of as good as he, so he laughed and let me go. But what talk we of fathers when there is such a man as Orlando?",
          "plainText": "I met the Duke yesterday and had much question with him He asked me of what parentage I was I told him of as good as he so he laughed and let me go But what talk we of fathers when there is such a man as Orlando",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "O, that's a brave man! He writes brave verses, speaks brave words, swears brave oaths, and breaks them bravely, quite traverse, athwart the heart of his lover, as a puny tilter, that spurs his horse but on one side, breaks his staff like a noble goose. But all's brave that youth mounts and folly guides. Who comes here?",
          "plainText": "O that's a brave man He writes brave verses speaks brave words swears brave oaths and breaks them bravely quite traverse athwart the heart of his lover as a puny tilter that spurs his horse but on one side breaks his staff like a noble goose But all's brave that youth mounts and folly guides Who comes here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-stage-002",
      "type": "stage",
      "text": "Enter Corin."
    },
    {
      "id": "as-you-like-it-3-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Mistress and master, you have oft enquired",
          "plainText": "Mistress and master you have oft enquired",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "After the shepherd that complained of love,",
          "plainText": "After the shepherd that complained of love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "Who you saw sitting by me on the turf,",
          "plainText": "Who you saw sitting by me on the turf",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "Praising the proud disdainful shepherdess",
          "plainText": "Praising the proud disdainful shepherdess",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "That was his mistress.",
          "plainText": "That was his mistress",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Well, and what of him?",
          "plainText": "Well and what of him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "If you will see a pageant truly played",
          "plainText": "If you will see a pageant truly played",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Between the pale complexion of true love",
          "plainText": "Between the pale complexion of true love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "And the red glow of scorn and proud disdain,",
          "plainText": "And the red glow of scorn and proud disdain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "Go hence a little, and I shall conduct you,",
          "plainText": "Go hence a little and I shall conduct you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "If you will mark it.",
          "plainText": "If you will mark it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-3-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "O, come, let us remove.",
          "plainText": "O come let us remove",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "The sight of lovers feedeth those in love.",
          "plainText": "The sight of lovers feedeth those in love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "Bring us to this sight, and you shall say",
          "plainText": "Bring us to this sight and you shall say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-3-4-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "I'll prove a busy actor in their play.",
          "plainText": "I'll prove a busy actor in their play",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-3-4-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}