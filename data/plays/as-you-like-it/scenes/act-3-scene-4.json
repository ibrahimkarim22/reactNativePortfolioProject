      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Rosalind and Celia.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 19,
          "end": 24,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "as-you-like-it/sceneIII_4.4/p@104581/line-1",
          "start": 0,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 634956,
        "end": 635071,
        "line": 23799,
        "column": 1,
        "path": "chap04/p@104581",
        "anchor": "sceneIII_4.4"
      },
      "speakerLabel": null,
