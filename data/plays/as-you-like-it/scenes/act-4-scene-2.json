      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAQUES.\nWhich is he that killed the deer?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIV_4.2/p@129035/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIV_4.2/p@129035/line-2",
          "start": 8,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 659410,
        "end": 659481,
        "line": 24718,
        "column": 1,
        "path": "chap04/p@129035",
        "anchor": "sceneIV_4.2"
      },
      "speakerLabel": "JAQUES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneIV_4.2/p@129110",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nSir, it was I.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIV_4.2/p@129110/line-1",
