          "start": 12,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 659485,
        "end": 659541,
        "line": 24723,
        "column": 1,
        "path": "chap04/p@129110",
        "anchor": "sceneIV_4.2"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "as-you-like-it/sceneIV_4.2/p@129170",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAQUES.\nLet’s present him to the Duke, like a Roman conqueror, and it would do well to set the deer’s horns upon his head for a branch of victory. Have you no song, forester, for this purpose?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIV_4.2/p@129170/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneIV_4.2/p@129170/line-2",
          "start": 8,
          "end": 192,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 659545,
        "end": 659769,
        "line": 24728,
        "column": 1,
        "path": "chap04/p@129170",
        "anchor": "sceneIV_4.2"
      },
      "speakerLabel": "JAQUES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneIV_4.2/p@129398",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nYes, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
