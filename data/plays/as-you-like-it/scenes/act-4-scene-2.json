      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAQUES.\nSing it. ’Tis no matter how it be in tune, so it make noise enough.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneIV_4.2/p@129454/line-1",
