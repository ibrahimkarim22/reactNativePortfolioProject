      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TOUCHSTONE.\nWe shall find a time, Audrey; patience, gentle Audrey.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneV_4.1/p@141340/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
