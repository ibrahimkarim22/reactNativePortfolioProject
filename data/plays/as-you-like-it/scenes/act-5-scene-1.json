          "start": 8,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 671815,
        "end": 671923,
        "line": 25187,
        "column": 1,
        "path": "chap04/p@141440",
        "anchor": "sceneV_4.1"
      },
      "speakerLabel": "AUDREY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "as-you-like-it/sceneV_4.1/p@141552",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TOUCHSTONE.\nA most wicked Sir Oliver, Audrey, a most vile Martext. But Audrey, there is a youth here in the forest lays claim to you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneV_4.1/p@141552/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneV_4.1/p@141552/line-2",
          "start": 12,
          "end": 133,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 671927,
        "end": 672091,
        "line": 25192,
        "column": 1,
        "path": "chap04/p@141552",
        "anchor": "sceneV_4.1"
      },
      "speakerLabel": "TOUCHSTONE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "as-you-like-it/sceneV_4.1/p@141720",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AUDREY.\nAy, I know who ’tis. He hath no interest in me in the world.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneV_4.1/p@141720/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneV_4.1/p@141720/line-2",
          "start": 8,
          "end": 68,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 672095,
        "end": 672193,
        "line": 25198,
        "column": 1,
        "path": "chap04/p@141720",
        "anchor": "sceneV_4.1"
      },
      "speakerLabel": "AUDREY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
