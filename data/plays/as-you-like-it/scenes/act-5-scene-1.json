      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TOUCHSTONE.\nTrip, Audrey, trip, Audrey! I attend, I attend.",
      "separatorAfter": "\n\n",
      "spans": [],
