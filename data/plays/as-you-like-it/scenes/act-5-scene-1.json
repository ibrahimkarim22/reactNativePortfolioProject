          "start": 12,
          "end": 120,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 672713,
        "end": 672864,
        "line": 25230,
        "column": 1,
        "path": "chap04/p@142338",
        "anchor": "sceneV_4.1"
      },
      "speakerLabel": "TOUCHSTONE.",
