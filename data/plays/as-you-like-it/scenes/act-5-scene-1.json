        "end": 672709,
        "line": 25225,
        "column": 1,
        "path": "chap04/p@142269",
        "anchor": "sceneV_4.1"
      },
      "speakerLabel": "WILLIAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
