      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Here comes the man you mean.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneV_4.1/p@141895/line-1",
          "start": 0,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 672270,
        "end": 672323,
        "line": 25205,
        "column": 1,
        "path": "chap04/p@141895",
        "anchor": "sceneV_4.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "as-you-like-it/sceneV_4.1/p@141952",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TOUCHSTONE.\nIt is meat and drink to me to see a clown. By my troth, we that have good wits have much to answer for. We shall be flouting; we cannot hold.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneV_4.1/p@141952/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "as-you-like-it/sceneV_4.1/p@141952/line-2",
          "start": 12,
          "end": 153,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 672327,
        "end": 672511,
        "line": 25209,
        "column": 1,
        "path": "chap04/p@141952",
        "anchor": "sceneV_4.1"
      },
      "speakerLabel": "TOUCHSTONE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "as-you-like-it/sceneV_4.1/p@142140",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
