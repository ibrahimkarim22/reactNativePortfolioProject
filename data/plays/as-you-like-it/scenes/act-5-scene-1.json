    {
      "id": "as-you-like-it/sceneV_4.1/p@141440",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AUDREY.\nFaith, the priest was good enough, for all the old gentleman’s saying.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneV_4.1/p@141440/line-1",
          "start": 0,
          "end": 7,
