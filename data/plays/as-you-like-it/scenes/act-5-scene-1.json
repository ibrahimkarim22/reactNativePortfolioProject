          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 672197,
        "end": 672266,
        "line": 25203,
        "column": 1,
        "path": "chap04/p@141822",
        "anchor": "sceneV_4.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
