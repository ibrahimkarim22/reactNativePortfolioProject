        {
          "id": "as-you-like-it/sceneV_4.1/p@141340/line-2",
          "start": 12,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 671715,
        "end": 671811,
        "line": 25182,
        "column": 1,
        "path": "chap04/p@141340",
        "anchor": "sceneV_4.1"
      },
      "speakerLabel": "TOUCHSTONE.",
