      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TOUCHSTONE.\nGood ev’n, gentle friend. Cover thy head, cover thy head. Nay, prithee, be covered. How old are you, friend?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "as-you-like-it/sceneV_4.1/p@142338/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
