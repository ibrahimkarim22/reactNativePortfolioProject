    {
      "id": "coriolanus/sceneI_6.10/p@56396",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AUFIDIUS.\nI am attended at the cypress grove. I pray you—\n’Tis south the city mills,—bring me word thither\nHow the world goes, that to the pace of it\nI may spur on my journey.",
