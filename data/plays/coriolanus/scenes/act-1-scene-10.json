    {
      "id": "coriolanus/sceneI_6.10/p@54855",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLDIER.\n’Twill be delivered back on good condition.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.10/p@54855/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.10/p@54855/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 874567,
        "end": 874649,
        "line": 32965,
        "column": 1,
        "path": "chap06/p@54855",
        "anchor": "sceneI_6.10"
      },
      "speakerLabel": "SOLDIER.",
