          "end": 267,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23404/line-8",
          "start": 268,
          "end": 294,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 843116,
        "end": 843470,
        "line": 31762,
        "column": 1,
        "path": "chap06/p@23404",
        "anchor": "sceneI_6.2"
