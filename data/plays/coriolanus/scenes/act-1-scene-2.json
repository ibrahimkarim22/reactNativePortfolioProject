    {
      "id": "coriolanus/sceneI_6.2/p@23762",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SENATOR.\nNoble Aufidius,\nTake your commission; hie you to your bands.\nLet us alone to guard Corioles.\nIf they set down before’s, for the remove\nBring up your army. But I think you’ll find\nThey’ve not prepared for us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.2/p@23762/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23762/line-2",
          "start": 16,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23762/line-3",
          "start": 32,
          "end": 76,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23762/line-4",
          "start": 77,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23762/line-5",
          "start": 109,
          "end": 150,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23762/line-6",
          "start": 151,
          "end": 194,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23762/line-7",
          "start": 195,
          "end": 223,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
