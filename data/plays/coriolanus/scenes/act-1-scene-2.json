    {
      "id": "coriolanus/sceneI_6.2/p@23264",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SENATOR.\nOur army’s in the field.\nWe never yet made doubt but Rome was ready\nTo answer us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.2/p@23264/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23264/line-2",
          "start": 15,
          "end": 39,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23264/line-3",
          "start": 40,
          "end": 82,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23264/line-4",
          "start": 83,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 842976,
        "end": 843112,
        "line": 31755,
        "column": 1,
        "path": "chap06/p@23264",
        "anchor": "sceneI_6.2"
      },
      "speakerLabel": "FIRST SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "coriolanus/sceneI_6.2/p@23404",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AUFIDIUS.\nNor did you think it folly\nTo keep your great pretences veiled till when\nThey needs must show themselves, which, in the hatching,\nIt seemed, appeared to Rome. By the discovery\nWe shall be shortened in our aim, which was\nTo take in many towns ere almost Rome\nShould know we were afoot.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.2/p@23404/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23404/line-2",
          "start": 10,
          "end": 36,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23404/line-3",
          "start": 37,
          "end": 82,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23404/line-4",
          "start": 83,
          "end": 139,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23404/line-5",
          "start": 140,
          "end": 185,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.2/p@23404/line-6",
          "start": 186,
          "end": 229,
          "sourceLineNumber": null
