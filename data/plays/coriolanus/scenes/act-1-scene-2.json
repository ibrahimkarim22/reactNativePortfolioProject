    },
    {
      "id": "coriolanus/sceneI_6.2/p@24044",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AUFIDIUS.\nO, doubt not that;\nI speak from certainties. Nay, more,\nSome parcels of their power are forth already,\nAnd only hitherward. I leave your Honours.\nIf we and Caius Martius chance to meet,\n’Tis sworn between us we shall ever strike\nTill one can do no more.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
