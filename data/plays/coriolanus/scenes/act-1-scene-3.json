        "end": 848019,
        "line": 31933,
        "column": 1,
        "path": "chap06/p@28140",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VALERIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
