      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\nHeavens bless my lord from fell Aufidius!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@27595/line-1",
          "start": 0,
