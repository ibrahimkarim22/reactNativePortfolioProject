    },
    {
      "id": "coriolanus/sceneI_6.3/p@29152",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\nA crack, madam.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@29152/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@29152/line-2",
          "start": 10,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 848864,
        "end": 848919,
        "line": 31969,
        "column": 1,
        "path": "chap06/p@29152",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VIRGILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@29211",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VALERIA.\nCome, lay aside your stitchery. I must have you play the idle huswife with me this afternoon.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@29211/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@29211/line-2",
          "start": 9,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 848923,
        "end": 849056,
        "line": 31974,
        "column": 1,
        "path": "chap06/p@29211",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VALERIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@29348",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\nNo, good madam, I will not out of doors.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@29348/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@29348/line-2",
          "start": 10,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 849060,
        "end": 849140,
        "line": 31980,
        "column": 1,
        "path": "chap06/p@29348",
