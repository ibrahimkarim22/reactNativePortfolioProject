    {
      "id": "coriolanus/sceneI_6.3/p@28065",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\nI am glad to see your Ladyship.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
