        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@29078",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VALERIA.\nIndeed, la, ’tis a noble child.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@29078/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@29078/line-2",
          "start": 9,
          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 848790,
        "end": 848860,
        "line": 31964,
        "column": 1,
