    {
      "id": "coriolanus/sceneI_6.3/p@29492",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLUMNIA.\nShe shall, she shall.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@29492/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@29492/line-2",
          "start": 10,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 849204,
        "end": 849265,
        "line": 31990,
        "column": 1,
        "path": "chap06/p@29492",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VOLUMNIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@29557",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\nIndeed, no, by your patience. I’ll not over the threshold till my lord return from the wars.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@29557/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@29557/line-2",
          "start": 10,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 849269,
        "end": 849402,
        "line": 31995,
        "column": 1,
        "path": "chap06/p@29557",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VIRGILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@29694",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VALERIA.\nFie, you confine yourself most unreasonably. Come, you must go visit the good lady that lies in.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@29694/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@29694/line-2",
          "start": 9,
          "end": 105,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 849406,
        "end": 849542,
        "line": 32001,
        "column": 1,
        "path": "chap06/p@29694",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VALERIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@29834",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\nI will wish her speedy strength and visit her with my prayers, but I cannot go thither.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@29834/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@29834/line-2",
          "start": 10,
          "end": 97,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 849546,
        "end": 849674,
        "line": 32007,
        "column": 1,
        "path": "chap06/p@29834",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VIRGILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@29966",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLUMNIA.\nWhy, I pray you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@29966/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@29966/line-2",
          "start": 10,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 849678,
        "end": 849734,
        "line": 32013,
        "column": 1,
        "path": "chap06/p@29966",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VOLUMNIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@30026",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\n’Tis not to save labour, nor that I want love.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@30026/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@30026/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 849738,
        "end": 849824,
        "line": 32018,
        "column": 1,
        "path": "chap06/p@30026",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VIRGILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@30116",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VALERIA.\nYou would be another Penelope. Yet they say all the yarn she spun in Ulysses’ absence did but fill Ithaca full of moths. Come, I would your cambric were sensible as your finger, that you might leave pricking it for pity. Come, you shall go with us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@30116/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@30116/line-2",
          "start": 9,
          "end": 257,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 849828,
        "end": 850118,
        "line": 32023,
        "column": 1,
        "path": "chap06/p@30116",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VALERIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@30410",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\nNo, good madam, pardon me; indeed, I will not forth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@30410/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@30410/line-2",
          "start": 10,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 850122,
        "end": 850214,
        "line": 32031,
        "column": 1,
        "path": "chap06/p@30410",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VIRGILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@30506",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VALERIA.\nIn truth, la, go with me, and I’ll tell you excellent news of your husband.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@30506/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@30506/line-2",
          "start": 9,
          "end": 84,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 850218,
        "end": 850332,
        "line": 32036,
        "column": 1,
        "path": "chap06/p@30506",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VALERIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@30624",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\nO, good madam, there can be none yet.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@30624/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@30624/line-2",
          "start": 10,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 850336,
        "end": 850413,
        "line": 32041,
        "column": 1,
        "path": "chap06/p@30624",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VIRGILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@30705",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VALERIA.\nVerily, I do not jest with you. There came news from him last night.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@30705/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
