    {
      "id": "coriolanus/sceneI_6.3/p@27112",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\nHis bloody brow? O Jupiter, no blood!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@27112/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@27112/line-2",
          "start": 10,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 846824,
        "end": 846901,
        "line": 31885,
        "column": 1,
        "path": "chap06/p@27112",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VIRGILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@27193",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLUMNIA.\nAway, you fool! It more becomes a man\nThan gilt his trophy. The breasts of Hecuba,\nWhen she did suckle Hector, looked not lovelier\nThan Hector’s forehead when it spit forth blood\nAt Grecian sword, contemning.—Tell Valeria\nWe are fit to bid her welcome.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
