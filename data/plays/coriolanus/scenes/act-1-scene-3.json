      "sourceRef": {
        "start": 847777,
        "end": 847848,
        "line": 31928,
        "column": 1,
        "path": "chap06/p@28065",
        "anchor": "sceneI_6.3"
      },
      "speakerLabel": "VIRGILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.3/p@28140",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VALERIA.\nHow do you both? You are manifest housekeepers. What are you sewing here? A fine spot, in good faith. How does your little son?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.3/p@28140/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.3/p@28140/line-2",
          "start": 9,
          "end": 136,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
