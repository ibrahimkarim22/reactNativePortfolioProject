      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nThey lie in view but have not spoke as yet.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.4/p@32556/line-1",
