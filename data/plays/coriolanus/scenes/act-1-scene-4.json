      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter two Senators with others on the walls of Corioles.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 10,
          "end": 18,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.4/p@33369/line-1",
          "start": 0,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
