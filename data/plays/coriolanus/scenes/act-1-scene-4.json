      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "So, now the gates are ope. Now prove good seconds!\n’Tis for the followers fortune widens them,\nNot for the fliers. Mark me, and do the like.",
      "separatorAfter": "\n\n",
      "spans": [],
