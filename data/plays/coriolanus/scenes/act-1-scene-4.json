    {
      "id": "coriolanus/sceneI_6.4/p@32713",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nI’ll buy him of you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.4/p@32713/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.4/p@32713/line-2",
          "start": 9,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 852425,
        "end": 852484,
        "line": 32136,
        "column": 1,
        "path": "chap06/p@32713",
        "anchor": "sceneI_6.4"
      },
      "speakerLabel": "MARTIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.4/p@32776",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LARTIUS.\nNo, I’ll nor sell nor give him. Lend you him I will\nFor half a hundred years.—Summon the town.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.4/p@32776/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.4/p@32776/line-2",
          "start": 9,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.4/p@32776/line-3",
          "start": 61,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 852488,
        "end": 852626,
        "line": 32141,
        "column": 1,
        "path": "chap06/p@32776",
        "anchor": "sceneI_6.4"
      },
      "speakerLabel": "LARTIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.4/p@32918",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nHow far off lie these armies?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.4/p@32918/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.4/p@32918/line-2",
          "start": 9,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 852630,
        "end": 852698,
        "line": 32147,
        "column": 1,
        "path": "chap06/p@32918",
        "anchor": "sceneI_6.4"
      },
      "speakerLabel": "MARTIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.4/p@32990",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nWithin this mile and half.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.4/p@32990/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.4/p@32990/line-2",
          "start": 11,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 852702,
        "end": 852769,
        "line": 32152,
        "column": 1,
        "path": "chap06/p@32990",
        "anchor": "sceneI_6.4"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "coriolanus/sceneI_6.4/p@33061",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nThen shall we hear their ’larum, and they ours.\nNow, Mars, I prithee, make us quick in work,\nThat we with smoking swords may march from hence\nTo help our fielded friends!—Come, blow thy blast.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
