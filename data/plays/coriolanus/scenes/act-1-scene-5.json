      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit Martius.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        },
