        "end": 858727,
        "line": 32370,
        "column": 1,
        "path": "chap06/p@38711",
        "anchor": "sceneI_6.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "coriolanus/sceneI_6.5/p@39019",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LARTIUS.\nWorthy sir, thou bleed’st.\nThy exercise hath been too violent\nFor a second course of fight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.5/p@39019/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39019/line-2",
          "start": 9,
          "end": 35,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39019/line-3",
          "start": 36,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39019/line-4",
          "start": 71,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 858731,
        "end": 858871,
        "line": 32379,
        "column": 1,
        "path": "chap06/p@39019",
        "anchor": "sceneI_6.5"
      },
      "speakerLabel": "LARTIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.5/p@39163",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nSir, praise me not.\nMy work hath yet not warmed me. Fare you well.\nThe blood I drop is rather physical\nThan dangerous to me. To Aufidius thus\nI will appear and fight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.5/p@39163/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39163/line-2",
          "start": 9,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39163/line-3",
          "start": 29,
          "end": 75,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39163/line-4",
          "start": 76,
          "end": 111,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39163/line-5",
          "start": 112,
          "end": 150,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39163/line-6",
          "start": 151,
          "end": 175,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 858875,
        "end": 859100,
        "line": 32386,
        "column": 1,
        "path": "chap06/p@39163",
        "anchor": "sceneI_6.5"
      },
      "speakerLabel": "MARTIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.5/p@39392",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LARTIUS.\nNow the fair goddess Fortune\nFall deep in love with thee, and her great charms\nMisguide thy opposers’ swords! Bold gentleman,\nProsperity be thy page!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.5/p@39392/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39392/line-2",
          "start": 9,
          "end": 37,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39392/line-3",
          "start": 38,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39392/line-4",
          "start": 88,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39392/line-5",
          "start": 135,
          "end": 158,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 859104,
        "end": 859307,
        "line": 32395,
        "column": 1,
        "path": "chap06/p@39392",
        "anchor": "sceneI_6.5"
      },
      "speakerLabel": "LARTIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.5/p@39599",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nThy friend no less\nThan those she placeth highest! So farewell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.5/p@39599/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39599/line-2",
          "start": 9,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@39599/line-3",
          "start": 28,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
