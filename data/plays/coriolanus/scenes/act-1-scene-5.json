    {
      "id": "coriolanus/sceneI_6.5/p@39853",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Go sound thy trumpet in the marketplace.\nCall thither all the officers o’ th’ town,\nWhere they shall know our mind. Away!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.5/p@39853/line-1",
          "start": 0,
