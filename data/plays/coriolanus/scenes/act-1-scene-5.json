    },
    {
      "id": "coriolanus/sceneI_6.5/p@38711",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "And hark, what noise the General makes! To him!\nThere is the man of my soul’s hate, Aufidius,\nPiercing our Romans. Then, valiant Titus, take\nConvenient numbers to make good the city,\nWhilst I, with those that have the spirit, will haste\nTo help Cominius.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.5/p@38711/line-1",
          "start": 0,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@38711/line-2",
          "start": 48,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@38711/line-3",
          "start": 94,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@38711/line-4",
          "start": 141,
          "end": 182,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@38711/line-5",
          "start": 183,
          "end": 236,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@38711/line-6",
          "start": 237,
          "end": 254,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
