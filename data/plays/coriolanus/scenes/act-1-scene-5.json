      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Martius and Titus Lartius with a Trumpet.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 18,
          "end": 31,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.5/p@38137/line-1",
          "start": 0,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 857849,
        "end": 857986,
        "line": 32352,
        "column": 1,
        "path": "chap06/p@38137",
        "anchor": "sceneI_6.5"
      },
      "speakerLabel": null,
