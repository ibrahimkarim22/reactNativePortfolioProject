      }
    },
    {
      "id": "coriolanus/sceneI_6.5/p@38278",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nSee here these movers that do prize their hours\nAt a cracked drachma. Cushions, leaden spoons,\nIrons of a doit, doublets that hangmen would\nBury with those that wore them, these base slaves,\nEre yet the fight be done, pack up. Down with them!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.5/p@38278/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@38278/line-2",
          "start": 9,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@38278/line-3",
          "start": 57,
          "end": 103,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@38278/line-4",
          "start": 104,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@38278/line-5",
          "start": 149,
          "end": 199,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.5/p@38278/line-6",
          "start": 200,
          "end": 251,
          "sourceLineNumber": null
        }
