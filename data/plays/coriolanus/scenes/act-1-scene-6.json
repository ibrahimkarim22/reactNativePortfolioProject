    {
      "id": "coriolanus/sceneI_6.6/p@40819",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Thy news?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@40819/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 860531,
        "end": 860565,
        "line": 32447,
        "column": 1,
        "path": "chap06/p@40819",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@40857",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nThe citizens of Corioles have issued,\nAnd given to Lartius and to Martius battle.\nI saw our party to their trenches driven,\nAnd then I came away.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@40857/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@40857/line-2",
          "start": 11,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@40857/line-3",
          "start": 49,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@40857/line-4",
          "start": 93,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@40857/line-5",
          "start": 135,
          "end": 156,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 860569,
        "end": 860770,
        "line": 32451,
        "column": 1,
        "path": "chap06/p@40857",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@41062",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nThough thou speakest truth,\nMethinks thou speak’st not well. How long is’t since?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@41062/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41062/line-2",
          "start": 10,
          "end": 37,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41062/line-3",
          "start": 38,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 860774,
        "end": 860900,
        "line": 32459,
        "column": 1,
        "path": "chap06/p@41062",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": "COMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@41192",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nAbove an hour, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@41192/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41192/line-2",
          "start": 11,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 860904,
        "end": 860968,
        "line": 32465,
        "column": 1,
        "path": "chap06/p@41192",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@41260",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\n’Tis not a mile; briefly we heard their drums.\nHow couldst thou in a mile confound an hour\nAnd bring thy news so late?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@41260/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41260/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41260/line-3",
          "start": 57,
          "end": 100,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41260/line-4",
          "start": 101,
          "end": 128,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 860972,
        "end": 861140,
        "line": 32470,
        "column": 1,
        "path": "chap06/p@41260",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": "COMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@41432",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nSpies of the Volsces\nHeld me in chase, that I was forced to wheel\nThree or four miles about; else had I, sir,\nHalf an hour since brought my report.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@41432/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41432/line-2",
          "start": 11,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41432/line-3",
          "start": 32,
          "end": 76,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41432/line-4",
          "start": 77,
          "end": 120,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41432/line-5",
          "start": 121,
          "end": 158,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 861144,
        "end": 861347,
        "line": 32477,
        "column": 1,
        "path": "chap06/p@41432",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
