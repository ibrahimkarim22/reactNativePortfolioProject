    {
      "id": "coriolanus/sceneI_6.6/p@45153",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[He waves his sword.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 20
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@45153/line-1",
          "start": 0,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 864865,
