      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@45210",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[They all shout and wave their swords, take him up in their arms, and cast up their caps.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 89
        }
      ],
