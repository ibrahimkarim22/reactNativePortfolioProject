      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter a Messenger.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 17,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@40738/line-1",
