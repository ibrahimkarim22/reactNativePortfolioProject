      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@41718",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Martius, bloody.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@41718/line-1",
          "start": 0,
          "end": 22,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 861430,
        "end": 861511,
        "line": 32487,
        "column": 1,
        "path": "chap06/p@41718",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@41803",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nWho’s yonder,\nThat does appear as he were flayed? O gods,\nHe has the stamp of Martius, and I have\nBefore-time seen him thus.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@41803/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41803/line-2",
          "start": 10,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41803/line-3",
          "start": 24,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41803/line-4",
          "start": 68,
          "end": 107,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41803/line-5",
          "start": 108,
          "end": 134,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 861515,
        "end": 861694,
        "line": 32491,
        "column": 1,
        "path": "chap06/p@41803",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": "COMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@41986",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nCome I too late?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@41986/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@41986/line-2",
          "start": 9,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 861698,
        "end": 861753,
        "line": 32499,
        "column": 1,
        "path": "chap06/p@41986",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": "MARTIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@42045",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nThe shepherd knows not thunder from a tabor\nMore than I know the sound of Martius’ tongue\nFrom every meaner man.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@42045/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@42045/line-2",
          "start": 10,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@42045/line-3",
          "start": 54,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@42045/line-4",
          "start": 100,
          "end": 122,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 861757,
        "end": 861919,
        "line": 32504,
        "column": 1,
        "path": "chap06/p@42045",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": "COMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@42211",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nCome I too late?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@42211/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@42211/line-2",
          "start": 9,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 861923,
        "end": 861978,
        "line": 32511,
        "column": 1,
        "path": "chap06/p@42211",
        "anchor": "sceneI_6.6"
      },
      "speakerLabel": "MARTIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.6/p@42270",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nAy, if you come not in the blood of others,\nBut mantled in your own.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.6/p@42270/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@42270/line-2",
          "start": 10,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.6/p@42270/line-3",
          "start": 54,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 861982,
        "end": 862095,
        "line": 32516,
        "column": 1,
        "path": "chap06/p@42270",
