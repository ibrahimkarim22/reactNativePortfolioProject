  "scene": {
    "id": "coriolanus-1-6",
    "act": 1,
    "scene": 6,
    "label": "Act 1, Scene 6",
    "title": "SCENE VI. Near the camp of Cominius",
    "location": "Near the camp of Cominius",
    "orderInPlay": 6
  },
  "content": [
    {
      "id": "coriolanus-1-6-stage-001",
      "type": "stage",
      "text": "Enter Cominius as it were in retire, with Soldiers."
    },
    {
      "id": "coriolanus-1-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Breathe you, my friends. Well fought! We are come off",
          "plainText": "Breathe you my friends Well fought We are come off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Like Romans, neither foolish in our stands",
          "plainText": "Like Romans neither foolish in our stands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Nor cowardly in retire. Believe me, sirs,",
          "plainText": "Nor cowardly in retire Believe me sirs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "We shall be charged again. Whiles we have struck,",
          "plainText": "We shall be charged again Whiles we have struck",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "By interims and conveying gusts we have heard",
          "plainText": "By interims and conveying gusts we have heard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "The charges of our friends. The Roman gods",
          "plainText": "The charges of our friends The Roman gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Lead their successes as we wish our own,",
          "plainText": "Lead their successes as we wish our own",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "That both our powers, with smiling fronts encount'ring,",
          "plainText": "That both our powers with smiling fronts encount'ring",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "May give you thankful sacrifice!",
          "plainText": "May give you thankful sacrifice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-stage-002",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "coriolanus-1-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "The citizens of Corioles have issued,",
          "plainText": "The citizens of Corioles have issued",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "And given to Lartius and to Martius battle.",
          "plainText": "And given to Lartius and to Martius battle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "I saw our party to their trenches driven,",
          "plainText": "I saw our party to their trenches driven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "And then I came away.",
          "plainText": "And then I came away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Though thou speakest truth,",
          "plainText": "Though thou speakest truth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Methinks thou speak'st not well. How long is't since?",
          "plainText": "Methinks thou speak'st not well How long is't since",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Above an hour, my lord.",
          "plainText": "Above an hour my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "'Tis not a mile; briefly we heard their drums.",
          "plainText": "'Tis not a mile briefly we heard their drums",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "How couldst thou in a mile confound an hour",
          "plainText": "How couldst thou in a mile confound an hour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "And bring thy news so late?",
          "plainText": "And bring thy news so late",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Spies of the Volsces",
          "plainText": "Spies of the Volsces",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Held me in chase, that I was forced to wheel",
          "plainText": "Held me in chase that I was forced to wheel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "Three or four miles about; else had I, sir,",
          "plainText": "Three or four miles about else had I sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Half an hour since brought my report.",
          "plainText": "Half an hour since brought my report",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-stage-003",
      "type": "stage",
      "text": "[Exit Messenger.]"
    },
    {
      "id": "coriolanus-1-6-stage-004",
      "type": "stage",
      "text": "Enter Martius, bloody."
    },
    {
      "id": "coriolanus-1-6-speech-007",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Who's yonder,",
          "plainText": "Who's yonder",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "That does appear as he were flayed? O gods,",
          "plainText": "That does appear as he were flayed O gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "He has the stamp of Martius, and I have",
          "plainText": "He has the stamp of Martius and I have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "Before-time seen him thus.",
          "plainText": "Beforetime seen him thus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-008",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Come I too late?",
          "plainText": "Come I too late",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "The shepherd knows not thunder from a tabor",
          "plainText": "The shepherd knows not thunder from a tabor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "More than I know the sound of Martius' tongue",
          "plainText": "More than I know the sound of Martius' tongue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "From every meaner man.",
          "plainText": "From every meaner man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-010",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Come I too late?",
          "plainText": "Come I too late",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-011",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Ay, if you come not in the blood of others,",
          "plainText": "Ay if you come not in the blood of others",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "But mantled in your own.",
          "plainText": "But mantled in your own",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-012",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "O, let me clip you",
          "plainText": "O let me clip you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "In arms as sound as when I wooed, in heart",
          "plainText": "In arms as sound as when I wooed in heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "As merry as when our nuptial day was done",
          "plainText": "As merry as when our nuptial day was done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0038",
          "number": 38,
          "speechLineNumber": 4,
          "text": "And tapers burned to bedward!",
          "plainText": "And tapers burned to bedward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Flower of warriors, how is't with Titus Lartius?",
          "plainText": "Flower of warriors how is't with Titus Lartius",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-014",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "As with a man busied about decrees,",
          "plainText": "As with a man busied about decrees",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Condemning some to death and some to exile;",
          "plainText": "Condemning some to death and some to exile",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Ransoming him or pitying, threat'ning the other;",
          "plainText": "Ransoming him or pitying threat'ning the other",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "Holding Corioles in the name of Rome",
          "plainText": "Holding Corioles in the name of Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0044",
          "number": 44,
          "speechLineNumber": 5,
          "text": "Even like a fawning greyhound in the leash,",
          "plainText": "Even like a fawning greyhound in the leash",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0045",
          "number": 45,
          "speechLineNumber": 6,
          "text": "To let him slip at will.",
          "plainText": "To let him slip at will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Where is that slave",
          "plainText": "Where is that slave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Which told me they had beat you to your trenches?",
          "plainText": "Which told me they had beat you to your trenches",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "Where's he? Call him hither.",
          "plainText": "Where's he Call him hither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-016",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Let him alone.",
          "plainText": "Let him alone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "He did inform the truth. But for our gentlemen,",
          "plainText": "He did inform the truth But for our gentlemen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "The common file—a plague! Tribunes for them!—",
          "plainText": "The common filea plague Tribunes for them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "The mouse ne'er shunned the cat as they did budge",
          "plainText": "The mouse ne'er shunned the cat as they did budge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0053",
          "number": 53,
          "speechLineNumber": 5,
          "text": "From rascals worse than they.",
          "plainText": "From rascals worse than they",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "But how prevailed you?",
          "plainText": "But how prevailed you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-018",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Will the time serve to tell? I do not think.",
          "plainText": "Will the time serve to tell I do not think",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "Where is the enemy? Are you lords o' th' field?",
          "plainText": "Where is the enemy Are you lords o' th' field",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "If not, why cease you till you are so?",
          "plainText": "If not why cease you till you are so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Martius, we have at disadvantage fought,",
          "plainText": "Martius we have at disadvantage fought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "And did retire to win our purpose.",
          "plainText": "And did retire to win our purpose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-020",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "How lies their battle? Know you on which side",
          "plainText": "How lies their battle Know you on which side",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "They have placed their men of trust?",
          "plainText": "They have placed their men of trust",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "As I guess, Martius,",
          "plainText": "As I guess Martius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "Their bands i' th' vaward are the Antiates,",
          "plainText": "Their bands i' th' vaward are the Antiates",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "Of their best trust; o'er them Aufidius,",
          "plainText": "Of their best trust o'er them Aufidius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "Their very heart of hope.",
          "plainText": "Their very heart of hope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-022",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "I do beseech you,",
          "plainText": "I do beseech you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "By all the battles wherein we have fought,",
          "plainText": "By all the battles wherein we have fought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0068",
          "number": 68,
          "speechLineNumber": 3,
          "text": "By th' blood we have shed together, by th' vows we have made",
          "plainText": "By th' blood we have shed together by th' vows we have made",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0069",
          "number": 69,
          "speechLineNumber": 4,
          "text": "To endure friends, that you directly set me",
          "plainText": "To endure friends that you directly set me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0070",
          "number": 70,
          "speechLineNumber": 5,
          "text": "Against Aufidius and his Antiates,",
          "plainText": "Against Aufidius and his Antiates",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0071",
          "number": 71,
          "speechLineNumber": 6,
          "text": "And that you not delay the present, but,",
          "plainText": "And that you not delay the present but",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0072",
          "number": 72,
          "speechLineNumber": 7,
          "text": "Filling the air with swords advanced and darts,",
          "plainText": "Filling the air with swords advanced and darts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0073",
          "number": 73,
          "speechLineNumber": 8,
          "text": "We prove this very hour.",
          "plainText": "We prove this very hour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-023",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Though I could wish",
          "plainText": "Though I could wish",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "You were conducted to a gentle bath",
          "plainText": "You were conducted to a gentle bath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "And balms applied to you, yet dare I never",
          "plainText": "And balms applied to you yet dare I never",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0077",
          "number": 77,
          "speechLineNumber": 4,
          "text": "Deny your asking. Take your choice of those",
          "plainText": "Deny your asking Take your choice of those",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0078",
          "number": 78,
          "speechLineNumber": 5,
          "text": "That best can aid your action.",
          "plainText": "That best can aid your action",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-speech-024",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Those are they",
          "plainText": "Those are they",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0080",
          "number": 80,
          "speechLineNumber": 2,
          "text": "That most are willing. If any such be here—",
          "plainText": "That most are willing If any such be here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0081",
          "number": 81,
          "speechLineNumber": 3,
          "text": "As it were sin to doubt—that love this painting",
          "plainText": "As it were sin to doubtthat love this painting",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0082",
          "number": 82,
          "speechLineNumber": 4,
          "text": "Wherein you see me smeared; if any fear",
          "plainText": "Wherein you see me smeared if any fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0083",
          "number": 83,
          "speechLineNumber": 5,
          "text": "Lesser his person than an ill report;",
          "plainText": "Lesser his person than an ill report",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0084",
          "number": 84,
          "speechLineNumber": 6,
          "text": "If any think brave death outweighs bad life,",
          "plainText": "If any think brave death outweighs bad life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0085",
          "number": 85,
          "speechLineNumber": 7,
          "text": "And that his country's dearer than himself;",
          "plainText": "And that his country's dearer than himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0086",
          "number": 86,
          "speechLineNumber": 8,
          "text": "Let him alone, or so many so minded,",
          "plainText": "Let him alone or so many so minded",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0087",
          "number": 87,
          "speechLineNumber": 9,
          "text": "Wave thus to express his disposition",
          "plainText": "Wave thus to express his disposition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0088",
          "number": 88,
          "speechLineNumber": 10,
          "text": "And follow Martius.",
          "plainText": "And follow Martius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-stage-005",
      "type": "stage",
      "text": "[He waves his sword.]"
    },
    {
      "id": "coriolanus-1-6-stage-006",
      "type": "stage",
      "text": "[They all shout and wave their swords, take him up in their arms, and cast up their caps.]"
    },
    {
      "id": "coriolanus-1-6-speech-025",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-6-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "March on, my fellows.",
          "plainText": "March on my fellows",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0090",
          "number": 90,
          "speechLineNumber": 2,
          "text": "Make good this ostentation, and you shall",
          "plainText": "Make good this ostentation and you shall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-6-line-0091",
          "number": 91,
          "speechLineNumber": 3,
          "text": "Divide in all with us.",
          "plainText": "Divide in all with us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-6-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}