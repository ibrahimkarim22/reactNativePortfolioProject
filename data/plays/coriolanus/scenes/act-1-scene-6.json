      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 15,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 16
        }
      ],
      "lines": [
        {
