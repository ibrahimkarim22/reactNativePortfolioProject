    "title": "SCENE VII. The gates of Corioles",
    "location": "The gates of Corioles",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "coriolanus-1-7-stage-001",
      "type": "stage",
      "text": "Titus Lartius, having set a guard upon Corioles, going with drum and trumpet toward Cominius and Caius Martius, enters with a Lieutenant, other Soldiers, and a Scout."
    },
    {
      "id": "coriolanus-1-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "So, let the ports be guarded. Keep your duties",
          "plainText": "So let the ports be guarded Keep your duties",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-7-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "As I have set them down. If I do send, dispatch",
          "plainText": "As I have set them down If I do send dispatch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-7-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Those centuries to our aid; the rest will serve",
          "plainText": "Those centuries to our aid the rest will serve",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-7-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "For a short holding. If we lose the field,",
          "plainText": "For a short holding If we lose the field",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-7-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "We cannot keep the town.",
          "plainText": "We cannot keep the town",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lieutenant",
        "name": "LIEUTENANT",
        "displayName": "Lieutenant"
      },
      "lines": [
        {
          "id": "coriolanus-1-7-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Fear not our care, sir.",
          "plainText": "Fear not our care sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-1-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-7-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Hence, and shut your gates upon's.",
          "plainText": "Hence and shut your gates upon's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-7-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Our guider, come. To th' Roman camp conduct us.",
          "plainText": "Our guider come To th' Roman camp conduct us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-7-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}