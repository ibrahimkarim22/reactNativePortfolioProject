    {
      "id": "coriolanus/sceneI_6.7/p@46408",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LARTIUS.\nSo, let the ports be guarded. Keep your duties\nAs I have set them down. If I do send, dispatch\nThose centuries to our aid; the rest will serve\nFor a short holding. If we lose the field,\nWe cannot keep the town.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
