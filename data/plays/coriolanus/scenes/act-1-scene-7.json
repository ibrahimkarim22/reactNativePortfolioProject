    {
      "id": "coriolanus/sceneI_6.7/p@46750",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LARTIUS.\nHence, and shut your gates upon’s.\nOur guider, come. To th’ Roman camp conduct us.",
      "separatorAfter": "\n\n",
      "spans": [],
