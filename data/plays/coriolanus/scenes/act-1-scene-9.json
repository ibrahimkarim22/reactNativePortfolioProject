        },
        {
          "id": "coriolanus/sceneI_6.9/p@54363/line-3",
          "start": 29,
          "end": 72,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@54363/line-4",
          "start": 73,
          "end": 102,
