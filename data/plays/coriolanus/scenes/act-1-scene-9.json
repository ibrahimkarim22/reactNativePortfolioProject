          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@50458/line-3",
          "start": 52,
          "end": 82,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 870170,
        "end": 870287,
        "line": 32806,
        "column": 1,
        "path": "chap06/p@50458",
        "anchor": "sceneI_6.9"
      },
      "speakerLabel": "MARTIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "coriolanus/sceneI_6.9/p@50579",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nShould they not,\nWell might they fester ’gainst ingratitude\nAnd tent themselves with death. Of all the horses—\nWhereof we have ta’en good and good store—of all\nThe treasure in this field achieved and city,\nWe render you the tenth, to be ta’en forth\nBefore the common distribution\nAt your only choice.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
