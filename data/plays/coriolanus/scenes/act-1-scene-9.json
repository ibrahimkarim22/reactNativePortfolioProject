    {
      "id": "coriolanus/sceneI_6.9/p@53721",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIOLANUS.\nI sometime lay here in Corioles\nAt a poor man’s house; he used me kindly.\nHe cried to me; I saw him prisoner;\nBut then Aufidius was within my view,\nAnd wrath o’erwhelmed my pity. I request you\nTo give my poor host freedom.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.9/p@53721/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@53721/line-2",
          "start": 12,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@53721/line-3",
          "start": 44,
          "end": 85,
          "sourceLineNumber": null
        },
        {
