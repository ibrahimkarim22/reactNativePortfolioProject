      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nI have some wounds upon me, and they smart\nTo hear themselves remembered.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.9/p@50458/line-1",
