    {
      "id": "coriolanus/sceneI_6.9/p@50958",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nI thank you, general,\nBut cannot make my heart consent to take\nA bribe to pay my sword. I do refuse it;\nAnd stand upon my common part with those\nThat have beheld the doing.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.9/p@50958/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
