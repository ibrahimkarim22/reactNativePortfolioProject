          "start": 9,
          "end": 19,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@49548/line-3",
          "start": 20,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@49548/line-4",
          "start": 57,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 869260,
        "end": 869375,
        "line": 32775,
        "column": 1,
        "path": "chap06/p@49548",
        "anchor": "sceneI_6.9"
      },
      "speakerLabel": "LARTIUS.",
      "attribution": {
