      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nTake’t, ’tis yours. What is’t?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.9/p@53647/line-1",
          "start": 0,
