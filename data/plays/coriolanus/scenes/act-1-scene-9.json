    {
      "id": "coriolanus/sceneI_6.9/p@54014",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nO, well begged!\nWere he the butcher of my son, he should\nBe free as is the wind.—Deliver him, Titus.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
