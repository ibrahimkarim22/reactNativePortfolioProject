    {
      "id": "coriolanus/sceneI_6.9/p@49548",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LARTIUS.\nO general,\nHere is the steed, we the caparison.\nHadst thou beheld—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.9/p@49548/line-1",
          "start": 0,
