    {
      "id": "coriolanus/sceneI_6.9/p@49667",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARTIUS.\nPray now, no more. My mother,\nWho has a charter to extol her blood,\nWhen she does praise me grieves me. I have done\nAs you have done—that’s what I can;\nInduced as you have been—that’s for my country.\nHe that has but effected his good will\nHath overta’en mine act.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.9/p@49667/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@49667/line-2",
          "start": 9,
          "end": 38,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@49667/line-3",
