    {
      "id": "coriolanus/sceneI_6.9/p@53151",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nSo, to our tent,\nWhere, ere we do repose us, we will write\nTo Rome of our success.—You, Titus Lartius,\nMust to Corioles back. Send us to Rome\nThe best, with whom we may articulate\nFor their own good and ours.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
