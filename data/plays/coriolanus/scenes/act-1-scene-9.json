      }
    },
    {
      "id": "coriolanus/sceneI_6.9/p@54229",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIOLANUS.\nBy Jupiter, forgot!\nI am weary; yea, my memory is tired.\nHave we no wine here?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneI_6.9/p@54229/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@54229/line-2",
          "start": 12,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@54229/line-3",
          "start": 32,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneI_6.9/p@54229/line-4",
          "start": 69,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
