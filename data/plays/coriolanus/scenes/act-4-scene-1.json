    {
      "id": "coriolanus/sceneIV_6.1/p@147600",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nI’ll follow thee a month, devise with thee\nWhere thou shalt rest, that thou mayst hear of us\nAnd we of thee; so if the time thrust forth\nA cause for thy repeal, we shall not send\nO’er the vast world to seek a single man\nAnd lose advantage, which doth ever cool\nI’ th’ absence of the needer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
