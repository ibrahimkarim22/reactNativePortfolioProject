    "scene": 1,
    "label": "Act 4, Scene 1",
    "title": "SCENE I. Rome. Before a gate of the city",
    "location": "Rome. Before a gate of the city",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "coriolanus-4-1-stage-001",
      "type": "stage",
      "text": "Enter Coriolanus, Volumnia, Virgilia, Menenius, Cominius with the young nobility of Rome."
    },
    {
      "id": "coriolanus-4-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-4-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Come, leave your tears. A brief farewell. The beast",
          "plainText": "Come leave your tears A brief farewell The beast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "With many heads butts me away. Nay, mother,",
          "plainText": "With many heads butts me away Nay mother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Where is your ancient courage? You were used",
          "plainText": "Where is your ancient courage You were used",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "To say extremities was the trier of spirits;",
          "plainText": "To say extremities was the trier of spirits",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "That common chances common men could bear;",
          "plainText": "That common chances common men could bear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "That when the sea was calm, all boats alike",
          "plainText": "That when the sea was calm all boats alike",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Showed mastership in floating; fortune's blows",
          "plainText": "Showed mastership in floating fortune's blows",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "When most struck home, being gentle wounded craves",
          "plainText": "When most struck home being gentle wounded craves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "A noble cunning. You were used to load me",
          "plainText": "A noble cunning You were used to load me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "With precepts that would make invincible",
          "plainText": "With precepts that would make invincible",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "The heart that conned them.",
          "plainText": "The heart that conned them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "virgilia",
        "name": "VIRGILIA",
        "displayName": "Virgilia"
      },
      "lines": [
        {
          "id": "coriolanus-4-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "O heavens! O heavens!",
          "plainText": "O heavens O heavens",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-4-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Nay, I prithee, woman—",
          "plainText": "Nay I prithee woman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Now the red pestilence strike all trades in Rome,",
          "plainText": "Now the red pestilence strike all trades in Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "And occupations perish!",
          "plainText": "And occupations perish",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-4-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "What, what, what!",
          "plainText": "What what what",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "I shall be loved when I am lacked. Nay, mother,",
          "plainText": "I shall be loved when I am lacked Nay mother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Resume that spirit when you were wont to say",
          "plainText": "Resume that spirit when you were wont to say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "If you had been the wife of Hercules,",
          "plainText": "If you had been the wife of Hercules",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "Six of his labours you'd have done and saved",
          "plainText": "Six of his labours you'd have done and saved",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0021",
          "number": 21,
          "speechLineNumber": 6,
          "text": "Your husband so much sweat.—Cominius,",
          "plainText": "Your husband so much sweatCominius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0022",
          "number": 22,
          "speechLineNumber": 7,
          "text": "Droop not. Adieu.—Farewell, my wife, my mother.",
          "plainText": "Droop not AdieuFarewell my wife my mother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0023",
          "number": 23,
          "speechLineNumber": 8,
          "text": "I'll do well yet.—Thou old and true Menenius,",
          "plainText": "I'll do well yetThou old and true Menenius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0024",
          "number": 24,
          "speechLineNumber": 9,
          "text": "Thy tears are salter than a younger man's",
          "plainText": "Thy tears are salter than a younger man's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0025",
          "number": 25,
          "speechLineNumber": 10,
          "text": "And venomous to thine eyes.—My sometime general,",
          "plainText": "And venomous to thine eyesMy sometime general",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0026",
          "number": 26,
          "speechLineNumber": 11,
          "text": "I have seen thee stern, and thou hast oft beheld",
          "plainText": "I have seen thee stern and thou hast oft beheld",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0027",
          "number": 27,
          "speechLineNumber": 12,
          "text": "Heart-hard'ning spectacles. Tell these sad women",
          "plainText": "Hearthard'ning spectacles Tell these sad women",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0028",
          "number": 28,
          "speechLineNumber": 13,
          "text": "'Tis fond to wail inevitable strokes",
          "plainText": "'Tis fond to wail inevitable strokes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0029",
          "number": 29,
          "speechLineNumber": 14,
          "text": "As 'tis to laugh at 'em.—My mother, you wot well",
          "plainText": "As 'tis to laugh at 'emMy mother you wot well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0030",
          "number": 30,
          "speechLineNumber": 15,
          "text": "My hazards still have been your solace, and—",
          "plainText": "My hazards still have been your solace and",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0031",
          "number": 31,
          "speechLineNumber": 16,
          "text": "Believe't not lightly—though I go alone,",
          "plainText": "Believe't not lightlythough I go alone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0032",
          "number": 32,
          "speechLineNumber": 17,
          "text": "Like to a lonely dragon that his fen",
          "plainText": "Like to a lonely dragon that his fen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0033",
          "number": 33,
          "speechLineNumber": 18,
          "text": "Makes feared and talked of more than seen, your son",
          "plainText": "Makes feared and talked of more than seen your son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0034",
          "number": 34,
          "speechLineNumber": 19,
          "text": "Will or exceed the common or be caught",
          "plainText": "Will or exceed the common or be caught",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0035",
          "number": 35,
          "speechLineNumber": 20,
          "text": "With cautelous baits and practice.",
          "plainText": "With cautelous baits and practice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-1-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "My first son,",
          "plainText": "My first son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "Whither wilt thou go? Take good Cominius",
          "plainText": "Whither wilt thou go Take good Cominius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0038",
          "number": 38,
          "speechLineNumber": 3,
          "text": "With thee awhile. Determine on some course",
          "plainText": "With thee awhile Determine on some course",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0039",
          "number": 39,
          "speechLineNumber": 4,
          "text": "More than a wild exposture to each chance",
          "plainText": "More than a wild exposture to each chance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0040",
          "number": 40,
          "speechLineNumber": 5,
          "text": "That starts i' th' way before thee.",
          "plainText": "That starts i' th' way before thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "virgilia",
        "name": "VIRGILIA",
        "displayName": "Virgilia"
      },
      "lines": [
        {
          "id": "coriolanus-4-1-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "O the gods!",
          "plainText": "O the gods",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-4-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "I'll follow thee a month, devise with thee",
          "plainText": "I'll follow thee a month devise with thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "Where thou shalt rest, that thou mayst hear of us",
          "plainText": "Where thou shalt rest that thou mayst hear of us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "And we of thee; so if the time thrust forth",
          "plainText": "And we of thee so if the time thrust forth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0045",
          "number": 45,
          "speechLineNumber": 4,
          "text": "A cause for thy repeal, we shall not send",
          "plainText": "A cause for thy repeal we shall not send",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0046",
          "number": 46,
          "speechLineNumber": 5,
          "text": "O'er the vast world to seek a single man",
          "plainText": "O'er the vast world to seek a single man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0047",
          "number": 47,
          "speechLineNumber": 6,
          "text": "And lose advantage, which doth ever cool",
          "plainText": "And lose advantage which doth ever cool",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0048",
          "number": 48,
          "speechLineNumber": 7,
          "text": "I' th' absence of the needer.",
          "plainText": "I' th' absence of the needer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-4-1-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Fare ye well.",
          "plainText": "Fare ye well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Thou hast years upon thee, and thou art too full",
          "plainText": "Thou hast years upon thee and thou art too full",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "Of the wars' surfeits to go rove with one",
          "plainText": "Of the wars' surfeits to go rove with one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "That's yet unbruised. Bring me but out at gate.—",
          "plainText": "That's yet unbruised Bring me but out at gate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0053",
          "number": 53,
          "speechLineNumber": 5,
          "text": "Come, my sweet wife, my dearest mother, and",
          "plainText": "Come my sweet wife my dearest mother and",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0054",
          "number": 54,
          "speechLineNumber": 6,
          "text": "My friends of noble touch. When I am forth,",
          "plainText": "My friends of noble touch When I am forth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0055",
          "number": 55,
          "speechLineNumber": 7,
          "text": "Bid me farewell, and smile. I pray you, come.",
