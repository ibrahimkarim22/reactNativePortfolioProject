          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-1-line-0057",
          "number": 57,
          "speechLineNumber": 9,
          "text": "Hear from me still, and never of me aught",
