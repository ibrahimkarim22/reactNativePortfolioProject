    {
      "id": "coriolanus/sceneIV_6.1/p@147306",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLUMNIA.\nMy first son,\nWhither wilt thou go? Take good Cominius\nWith thee awhile. Determine on some course\nMore than a wild exposture to each chance\nThat starts i’ th’ way before thee.",
