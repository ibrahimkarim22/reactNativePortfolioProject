      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@149677",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Volumnia, Virgilia and Menenius.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 24,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 29,
          "end": 37,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@149677/line-1",
          "start": 0,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 969389,
        "end": 969517,
        "line": 36825,
        "column": 1,
        "path": "chap06/p@149677",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@149809",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SICINIUS.\nLet’s not meet her.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@149809/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149809/line-2",
          "start": 10,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 969521,
        "end": 969580,
        "line": 36830,
        "column": 1,
        "path": "chap06/p@149809",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "SICINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@149872",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nWhy?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@149872/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149872/line-2",
          "start": 8,
          "end": 12,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 969584,
        "end": 969626,
        "line": 36835,
        "column": 1,
        "path": "chap06/p@149872",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "BRUTUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@149918",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SICINIUS.\nThey say she’s mad.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@149918/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149918/line-2",
          "start": 10,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 969630,
        "end": 969689,
        "line": 36840,
        "column": 1,
        "path": "chap06/p@149918",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "SICINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@149981",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nThey have ta’en note of us. Keep on your way.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@149981/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149981/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 969693,
        "end": 969776,
        "line": 36845,
        "column": 1,
        "path": "chap06/p@149981",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "BRUTUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@150068",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLUMNIA.\nO, you’re well met. The hoarded plague o’ th’ gods\nRequite your love!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@150068/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150068/line-2",
          "start": 10,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150068/line-3",
          "start": 61,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 969780,
        "end": 969894,
        "line": 36850,
        "column": 1,
        "path": "chap06/p@150068",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "VOLUMNIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@150186",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nPeace, peace! Be not so loud.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@150186/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150186/line-2",
          "start": 10,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 969898,
        "end": 969967,
        "line": 36856,
        "column": 1,
        "path": "chap06/p@150186",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@150259",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLUMNIA.\nIf that I could for weeping, you should hear—\nNay, and you shall hear some. [To Sicinius.] Will you be gone?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 87,
          "end": 98
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@150259/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150259/line-2",
          "start": 10,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150259/line-3",
          "start": 56,
          "end": 118,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 969971,
        "end": 970131,
        "line": 36861,
        "column": 1,
        "path": "chap06/p@150259",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "VOLUMNIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@150423",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIRGILIA.\n[To Brutus.] You shall stay too. I would I had the power\nTo say so to my husband.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 11,
          "end": 20
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@150423/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150423/line-2",
          "start": 10,
          "end": 66,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150423/line-3",
          "start": 67,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 970135,
        "end": 970268,
        "line": 36867,
        "column": 1,
        "path": "chap06/p@150423",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "VIRGILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@150560",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SICINIUS.\nAre you mankind?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@150560/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150560/line-2",
          "start": 10,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 970272,
        "end": 970328,
        "line": 36873,
        "column": 1,
        "path": "chap06/p@150560",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "SICINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@150620",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLUMNIA.\nAy, fool, is that a shame? Note but this, fool.\nWas not a man my father? Hadst thou foxship\nTo banish him that struck more blows for Rome\nThan thou hast spoken words?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@150620/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150620/line-2",
          "start": 10,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150620/line-3",
          "start": 58,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@150620/line-4",
          "start": 102,
          "end": 147,
          "sourceLineNumber": null
        },
        {
