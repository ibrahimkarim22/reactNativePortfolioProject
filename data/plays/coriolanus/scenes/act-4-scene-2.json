      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@149039",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SICINIUS.\nBid them all home. He’s gone, and we’ll no further.\nThe nobility are vexed, whom we see have sided\nIn his behalf.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@149039/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149039/line-2",
          "start": 10,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149039/line-3",
          "start": 62,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149039/line-4",
          "start": 109,
          "end": 123,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 968751,
        "end": 968914,
        "line": 36793,
        "column": 1,
        "path": "chap06/p@149039",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "SICINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@149206",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nNow we have shown our power,\nLet us seem humbler after it is done\nThan when it was a-doing.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@149206/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149206/line-2",
          "start": 8,
          "end": 36,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149206/line-3",
          "start": 37,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149206/line-4",
          "start": 74,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 968918,
        "end": 969057,
        "line": 36800,
        "column": 1,
        "path": "chap06/p@149206",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "BRUTUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.2/p@149349",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SICINIUS.\nBid them home.\nSay their great enemy is gone, and they\nStand in their ancient strength.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@149349/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149349/line-2",
          "start": 10,
          "end": 24,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149349/line-3",
          "start": 25,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.2/p@149349/line-4",
          "start": 65,
          "end": 97,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 969061,
        "end": 969198,
        "line": 36807,
        "column": 1,
        "path": "chap06/p@149349",
        "anchor": "sceneIV_6.2"
      },
      "speakerLabel": "SICINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
