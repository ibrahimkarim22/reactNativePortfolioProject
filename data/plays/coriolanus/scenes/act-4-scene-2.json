      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Here comes his mother.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.2/p@149626/line-1",
          "start": 0,
          "end": 22,
          "sourceLineNumber": null
        }
      ],
