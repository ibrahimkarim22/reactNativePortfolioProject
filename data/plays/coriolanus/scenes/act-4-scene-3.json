      "text": "SCENE III. A highway between Rome and Antium",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "b",
          "start": 0,
          "end": 44
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/h3@153326/line-1",
