  "scene": {
    "id": "coriolanus-4-3",
    "act": 4,
    "scene": 3,
    "label": "Act 4, Scene 3",
    "title": "SCENE III. A highway between Rome and Antium",
    "location": "A highway between Rome and Antium",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "coriolanus-4-3-stage-001",
      "type": "stage",
      "text": "Enter a Roman and a Volsce."
    },
    {
      "id": "coriolanus-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "roman",
        "name": "ROMAN",
        "displayName": "Roman"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I know you well, sir, and you know me. Your name I think is Adrian.",
          "plainText": "I know you well sir and you know me Your name I think is Adrian",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "volsce",
        "name": "VOLSCE",
        "displayName": "Volsce"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "It is so, sir. Truly, I have forgot you.",
          "plainText": "It is so sir Truly I have forgot you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "roman",
        "name": "ROMAN",
        "displayName": "Roman"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "I am a Roman, and my services are, as you are, against 'em. Know you me yet?",
          "plainText": "I am a Roman and my services are as you are against 'em Know you me yet",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "volsce",
        "name": "VOLSCE",
        "displayName": "Volsce"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Nicanor, no?",
          "plainText": "Nicanor no",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "roman",
        "name": "ROMAN",
        "displayName": "Roman"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "The same, sir.",
          "plainText": "The same sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "volsce",
        "name": "VOLSCE",
        "displayName": "Volsce"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "You had more beard when I last saw you, but your favour is well approved by your tongue. What's the news in Rome? I have a note from the Volscian state to find you out there. You have well saved me a day's journey.",
          "plainText": "You had more beard when I last saw you but your favour is well approved by your tongue What's the news in Rome I have a note from the Volscian state to find you out there You have well saved me a day's journey",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "roman",
        "name": "ROMAN",
        "displayName": "Roman"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "There hath been in Rome strange insurrections, the people against the senators, patricians, and nobles.",
          "plainText": "There hath been in Rome strange insurrections the people against the senators patricians and nobles",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "volsce",
        "name": "VOLSCE",
        "displayName": "Volsce"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Hath been? Is it ended, then? Our state thinks not so. They are in a most warlike preparation and hope to come upon them in the heat of their division.",
          "plainText": "Hath been Is it ended then Our state thinks not so They are in a most warlike preparation and hope to come upon them in the heat of their division",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "roman",
        "name": "ROMAN",
        "displayName": "Roman"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "The main blaze of it is past, but a small thing would make it flame again; for the nobles receive so to heart the banishment of that worthy Coriolanus that they are in a ripe aptness to take all power from the people and to pluck from them their tribunes for ever. This lies glowing, I can tell you, and is almost mature for the violent breaking out.",
          "plainText": "The main blaze of it is past but a small thing would make it flame again for the nobles receive so to heart the banishment of that worthy Coriolanus that they are in a ripe aptness to take all power from the people and to pluck from them their tribunes for ever This lies glowing I can tell you and is almost mature for the violent breaking out",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "volsce",
        "name": "VOLSCE",
        "displayName": "Volsce"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Coriolanus banished?",
          "plainText": "Coriolanus banished",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "roman",
        "name": "ROMAN",
        "displayName": "Roman"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Banished, sir.",
          "plainText": "Banished sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "volsce",
        "name": "VOLSCE",
        "displayName": "Volsce"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "You will be welcome with this intelligence, Nicanor.",
          "plainText": "You will be welcome with this intelligence Nicanor",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "roman",
        "name": "ROMAN",
        "displayName": "Roman"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "The day serves well for them now. I have heard it said the fittest time to corrupt a man's wife is when she's fallen out with her husband. Your noble Tullus Aufidius will appear well in these wars, his great opposer Coriolanus being now in no request of his country.",
          "plainText": "The day serves well for them now I have heard it said the fittest time to corrupt a man's wife is when she's fallen out with her husband Your noble Tullus Aufidius will appear well in these wars his great opposer Coriolanus being now in no request of his country",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "volsce",
        "name": "VOLSCE",
        "displayName": "Volsce"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "He cannot choose. I am most fortunate thus accidentally to encounter you. You have ended my business, and I will merrily accompany you home.",
          "plainText": "He cannot choose I am most fortunate thus accidentally to encounter you You have ended my business and I will merrily accompany you home",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "roman",
        "name": "ROMAN",
        "displayName": "Roman"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "I shall between this and supper tell you most strange things from Rome, all tending to the good of their adversaries. Have you an army ready, say you?",
          "plainText": "I shall between this and supper tell you most strange things from Rome all tending to the good of their adversaries Have you an army ready say you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "volsce",
        "name": "VOLSCE",
        "displayName": "Volsce"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "A most royal one. The centurions and their charges, distinctly billeted, already in th' entertainment, and to be on foot at an hour's warning.",
          "plainText": "A most royal one The centurions and their charges distinctly billeted already in th' entertainment and to be on foot at an hour's warning",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "roman",
        "name": "ROMAN",
        "displayName": "Roman"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "I am joyful to hear of their readiness and am the man, I think, that shall set them in present action. So, sir, heartily well met, and most glad of your company.",
          "plainText": "I am joyful to hear of their readiness and am the man I think that shall set them in present action So sir heartily well met and most glad of your company",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "volsce",
        "name": "VOLSCE",
        "displayName": "Volsce"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "You take my part from me, sir. I have the most cause to be glad of yours.",
          "plainText": "You take my part from me sir I have the most cause to be glad of yours",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "roman",
        "name": "ROMAN",
        "displayName": "Roman"
      },
      "lines": [
        {
          "id": "coriolanus-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Well, let us go together.",
          "plainText": "Well let us go together",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}