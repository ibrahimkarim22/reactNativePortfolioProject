    },
    {
      "id": "coriolanus/sceneIV_6.3/p@153415",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter a Roman and a Volsce.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 13,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 20,
          "end": 26,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@153415/line-1",
          "start": 0,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 973127,
        "end": 973244,
        "line": 37004,
        "column": 1,
        "path": "chap06/p@153415",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@153536",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMAN.\nI know you well, sir, and you know me. Your name I think is Adrian.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@153536/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@153536/line-2",
          "start": 7,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 973248,
        "end": 973352,
        "line": 37009,
        "column": 1,
        "path": "chap06/p@153536",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "ROMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@153644",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLSCE.\nIt is so, sir. Truly, I have forgot you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@153644/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@153644/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 973356,
        "end": 973434,
        "line": 37014,
        "column": 1,
        "path": "chap06/p@153644",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "VOLSCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@153726",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMAN.\nI am a Roman, and my services are, as you are, against ’em. Know you me yet?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@153726/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@153726/line-2",
          "start": 7,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 973438,
        "end": 973551,
        "line": 37019,
        "column": 1,
        "path": "chap06/p@153726",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "ROMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@153843",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLSCE.\nNicanor, no?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@153843/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@153843/line-2",
          "start": 8,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 973555,
        "end": 973605,
        "line": 37024,
        "column": 1,
        "path": "chap06/p@153843",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "VOLSCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@153897",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMAN.\nThe same, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@153897/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@153897/line-2",
          "start": 7,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 973609,
        "end": 973660,
        "line": 37029,
        "column": 1,
        "path": "chap06/p@153897",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "ROMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@153952",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLSCE.\nYou had more beard when I last saw you, but your favour is well approved by your tongue. What’s the news in Rome? I have a note from the Volscian state to find you out there. You have well saved me a day’s journey.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@153952/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@153952/line-2",
          "start": 8,
          "end": 222,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 973664,
        "end": 973918,
        "line": 37034,
        "column": 1,
        "path": "chap06/p@153952",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "VOLSCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@154210",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMAN.\nThere hath been in Rome strange insurrections, the people against the senators, patricians, and nobles.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@154210/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@154210/line-2",
          "start": 7,
          "end": 110,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 973922,
        "end": 974063,
        "line": 37041,
        "column": 1,
        "path": "chap06/p@154210",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "ROMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@154355",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLSCE.\nHath been? Is it ended, then? Our state thinks not so. They are in a most warlike preparation and hope to come upon them in the heat of their division.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@154355/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@154355/line-2",
          "start": 8,
          "end": 159,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 974067,
        "end": 974257,
        "line": 37047,
        "column": 1,
        "path": "chap06/p@154355",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "VOLSCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@154549",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMAN.\nThe main blaze of it is past, but a small thing would make it flame again; for the nobles receive so to heart the banishment of that worthy Coriolanus that they are in a ripe aptness to take all power from the people and to pluck from them their tribunes for ever. This lies glowing, I can tell you, and is almost mature for the violent breaking out.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@154549/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@154549/line-2",
          "start": 7,
          "end": 357,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 974261,
        "end": 974652,
        "line": 37053,
        "column": 1,
        "path": "chap06/p@154549",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "ROMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@154944",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLSCE.\nCoriolanus banished?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@154944/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@154944/line-2",
          "start": 8,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 974656,
        "end": 974714,
        "line": 37062,
        "column": 1,
        "path": "chap06/p@154944",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "VOLSCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@155006",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMAN.\nBanished, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@155006/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@155006/line-2",
          "start": 7,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 974718,
        "end": 974769,
        "line": 37067,
        "column": 1,
        "path": "chap06/p@155006",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "ROMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@155061",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLSCE.\nYou will be welcome with this intelligence, Nicanor.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@155061/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@155061/line-2",
          "start": 8,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 974773,
        "end": 974863,
        "line": 37072,
        "column": 1,
        "path": "chap06/p@155061",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "VOLSCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@155155",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMAN.\nThe day serves well for them now. I have heard it said the fittest time to corrupt a man’s wife is when she’s fallen out with her husband. Your noble Tullus Aufidius will appear well in these wars, his great opposer Coriolanus being now in no request of his country.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@155155/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@155155/line-2",
          "start": 7,
          "end": 273,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 974867,
        "end": 975173,
        "line": 37077,
        "column": 1,
        "path": "chap06/p@155155",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "ROMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@155465",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLSCE.\nHe cannot choose. I am most fortunate thus accidentally to encounter you. You have ended my business, and I will merrily accompany you home.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@155465/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@155465/line-2",
          "start": 8,
          "end": 148,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 975177,
        "end": 975356,
        "line": 37085,
        "column": 1,
        "path": "chap06/p@155465",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "VOLSCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@155648",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMAN.\nI shall between this and supper tell you most strange things from Rome, all tending to the good of their adversaries. Have you an army ready, say you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@155648/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@155648/line-2",
          "start": 7,
          "end": 157,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 975360,
        "end": 975548,
        "line": 37091,
        "column": 1,
        "path": "chap06/p@155648",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "ROMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@155840",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLSCE.\nA most royal one. The centurions and their charges, distinctly billeted, already in th’ entertainment, and to be on foot at an hour’s warning.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@155840/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@155840/line-2",
          "start": 8,
          "end": 150,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 975552,
        "end": 975733,
        "line": 37097,
        "column": 1,
        "path": "chap06/p@155840",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "VOLSCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@156025",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMAN.\nI am joyful to hear of their readiness and am the man, I think, that shall set them in present action. So, sir, heartily well met, and most glad of your company.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@156025/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@156025/line-2",
          "start": 7,
          "end": 168,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 975737,
        "end": 975937,
        "line": 37103,
        "column": 1,
        "path": "chap06/p@156025",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "ROMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "coriolanus/sceneIV_6.3/p@156229",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VOLSCE.\nYou take my part from me, sir. I have the most cause to be glad of yours.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.3/p@156229/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.3/p@156229/line-2",
          "start": 8,
          "end": 81,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 975941,
        "end": 976052,
        "line": 37110,
        "column": 1,
        "path": "chap06/p@156229",
        "anchor": "sceneIV_6.3"
      },
      "speakerLabel": "VOLSCE.",
      "attribution": {
        "status": "explicit",
