    {
      "id": "coriolanus/sceneIV_6.4/p@156657",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIOLANUS.\nA goodly city is this Antium. City,\n’Tis I that made thy widows. Many an heir\nOf these fair edifices ’fore my wars\nHave I heard groan and drop. Then know me not,\nLest that thy wives with spits and boys with stones\nIn puny battle slay me.",
      "separatorAfter": "\n\n",
