      "id": "coriolanus/sceneIV_6.4/p@157138",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIOLANUS.\nDirect me, if it be your will,\nWhere great Aufidius lies. Is he in Antium?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.4/p@157138/line-1",
          "start": 0,
          "end": 11,
