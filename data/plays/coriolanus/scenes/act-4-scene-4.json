      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CITIZEN.\nHe is, and feasts the nobles of the state\nAt his house this night.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
