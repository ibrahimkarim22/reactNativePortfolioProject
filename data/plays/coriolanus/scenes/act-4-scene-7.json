    {
      "id": "coriolanus/sceneIV_6.7/p@185605",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AUFIDIUS.\nDo they still fly to th’ Roman?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.7/p@185605/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185605/line-2",
          "start": 10,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1005317,
        "end": 1005388,
        "line": 38334,
        "column": 1,
        "path": "chap06/p@185605",
