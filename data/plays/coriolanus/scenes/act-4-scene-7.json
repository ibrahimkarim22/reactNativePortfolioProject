    {
      "id": "coriolanus/sceneIV_6.7/p@186278",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LIEUTENANT.\nYet I wish, sir—\nI mean for your particular—you had not\nJoined in commission with him, but either\nHad borne the action of yourself or else\nTo him had left it solely.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.7/p@186278/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@186278/line-2",
          "start": 12,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@186278/line-3",
          "start": 29,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@186278/line-4",
          "start": 68,
          "end": 109,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@186278/line-5",
          "start": 110,
          "end": 150,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@186278/line-6",
          "start": 151,
          "end": 177,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1005990,
        "end": 1006217,
        "line": 38359,
        "column": 1,
        "path": "chap06/p@186278",
