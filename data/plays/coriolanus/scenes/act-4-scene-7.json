          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@186509/line-4",
          "start": 100,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@186509/line-5",
