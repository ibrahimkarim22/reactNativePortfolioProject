    },
    {
      "id": "coriolanus/sceneIV_6.7/p@185680",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LIEUTENANT.\nI do not know what witchcraft’s in him, but\nYour soldiers use him as the grace ’fore meat,\nTheir talk at table, and their thanks at end;\nAnd you are dark’ned in this action, sir,\nEven by your own.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.7/p@185680/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185680/line-2",
          "start": 12,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185680/line-3",
          "start": 56,
          "end": 102,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185680/line-4",
          "start": 103,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185680/line-5",
          "start": 149,
          "end": 190,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185680/line-6",
          "start": 191,
          "end": 208,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1005392,
        "end": 1005650,
        "line": 38339,
        "column": 1,
        "path": "chap06/p@185680",
        "anchor": "sceneIV_6.7"
      },
      "speakerLabel": "LIEUTENANT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "coriolanus/sceneIV_6.7/p@185942",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AUFIDIUS.\nI cannot help it now,\nUnless by using means I lame the foot\nOf our design. He bears himself more proudlier,\nEven to my person, than I thought he would\nWhen first I did embrace him. Yet his nature\nIn that’s no changeling, and I must excuse\nWhat cannot be amended.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneIV_6.7/p@185942/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185942/line-2",
          "start": 10,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185942/line-3",
          "start": 32,
          "end": 69,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185942/line-4",
          "start": 70,
          "end": 117,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185942/line-5",
          "start": 118,
          "end": 160,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185942/line-6",
          "start": 161,
          "end": 205,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185942/line-7",
          "start": 206,
          "end": 248,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneIV_6.7/p@185942/line-8",
          "start": 249,
          "end": 272,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1005654,
        "end": 1005986,
        "line": 38348,
        "column": 1,
        "path": "chap06/p@185942",
        "anchor": "sceneIV_6.7"
      },
      "speakerLabel": "AUFIDIUS.",
      "attribution": {
