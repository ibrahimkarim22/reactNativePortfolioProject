        "end": 1012196,
        "line": 38570,
        "column": 1,
        "path": "chap06/p@192375",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "BRUTUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@192488",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nGood faith, I’ll prove him,\nSpeed how it will. I shall ere long have knowledge\nOf my success.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
