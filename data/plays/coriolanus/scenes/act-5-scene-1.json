    {
      "id": "coriolanus/sceneV_6.1/p@188806",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Menenius, Cominius, Sicinius, Brutus (the two Tribunes), with others.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 42,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@188806/line-1",
          "start": 0,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1008518,
        "end": 1008653,
        "line": 38431,
        "column": 1,
        "path": "chap06/p@188806",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@188945",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nNo, I’ll not go. You hear what he hath said\nWhich was sometime his general, who loved him\nIn a most dear particular. He called me father,\nBut what o’ that? Go you that banished him;\nA mile before his tent, fall down, and knee\nThe way into his mercy. Nay, if he coyed\nTo hear Cominius speak, I’ll keep at home.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@188945/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@188945/line-2",
          "start": 10,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@188945/line-3",
          "start": 54,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@188945/line-4",
          "start": 100,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@188945/line-5",
          "start": 148,
          "end": 191,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@188945/line-6",
          "start": 192,
          "end": 235,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@188945/line-7",
          "start": 236,
          "end": 276,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@188945/line-8",
          "start": 277,
          "end": 319,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1008657,
        "end": 1009036,
        "line": 38436,
        "column": 1,
        "path": "chap06/p@188945",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@189328",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nHe would not seem to know me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@189328/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189328/line-2",
          "start": 10,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1009040,
        "end": 1009109,
        "line": 38447,
        "column": 1,
        "path": "chap06/p@189328",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "COMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@189401",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nDo you hear?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@189401/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189401/line-2",
          "start": 10,
          "end": 22,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1009113,
        "end": 1009165,
        "line": 38452,
        "column": 1,
        "path": "chap06/p@189401",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@189457",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nYet one time he did call me by my name.\nI urged our old acquaintance, and the drops\nThat we have bled together. “Coriolanus”\nHe would not answer to, forbade all names.\nHe was a kind of nothing, titleless,\nTill he had forged himself a name i’ th’ fire\nOf burning Rome.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@189457/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189457/line-2",
          "start": 10,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189457/line-3",
          "start": 50,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189457/line-4",
          "start": 94,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189457/line-5",
          "start": 135,
          "end": 177,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189457/line-6",
          "start": 178,
          "end": 214,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189457/line-7",
          "start": 215,
          "end": 260,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189457/line-8",
          "start": 261,
          "end": 277,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1009169,
        "end": 1009506,
        "line": 38457,
        "column": 1,
        "path": "chap06/p@189457",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "COMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@189798",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nWhy, so; you have made good work!\nA pair of tribunes that have wracked Rome\nTo make coals cheap! A noble memory!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@189798/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189798/line-2",
          "start": 10,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189798/line-3",
          "start": 44,
          "end": 85,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189798/line-4",
          "start": 86,
          "end": 122,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1009510,
        "end": 1009672,
        "line": 38468,
        "column": 1,
        "path": "chap06/p@189798",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@189964",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nI minded him how royal ’twas to pardon\nWhen it was less expected. He replied\nIt was a bare petition of a state\nTo one whom they had punished.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@189964/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189964/line-2",
          "start": 10,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189964/line-3",
          "start": 49,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189964/line-4",
          "start": 87,
          "end": 120,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@189964/line-5",
          "start": 121,
          "end": 151,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1009676,
        "end": 1009872,
        "line": 38475,
        "column": 1,
        "path": "chap06/p@189964",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "COMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@190164",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nVery well.\nCould he say less?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@190164/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190164/line-2",
          "start": 10,
          "end": 20,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190164/line-3",
          "start": 21,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1009876,
        "end": 1009950,
        "line": 38483,
        "column": 1,
        "path": "chap06/p@190164",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@190242",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COMINIUS.\nI offered to awaken his regard\nFor’s private friends. His answer to me was\nHe could not stay to pick them in a pile\nOf noisome musty chaff. He said ’twas folly\nFor one poor grain or two to leave unburnt\nAnd still to nose th’ offence.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@190242/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190242/line-2",
          "start": 10,
          "end": 40,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190242/line-3",
          "start": 41,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190242/line-4",
          "start": 85,
          "end": 125,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190242/line-5",
          "start": 126,
          "end": 169,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190242/line-6",
          "start": 170,
          "end": 212,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190242/line-7",
          "start": 213,
          "end": 243,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1009954,
        "end": 1010252,
        "line": 38489,
        "column": 1,
        "path": "chap06/p@190242",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "COMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@190544",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nFor one poor grain or two!\nI am one of those! His mother, wife, his child,\nAnd this brave fellow too, we are the grains;\nYou are the musty chaff, and you are smelt\nAbove the moon. We must be burnt for you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@190544/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190544/line-2",
          "start": 10,
          "end": 36,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190544/line-3",
          "start": 37,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190544/line-4",
          "start": 85,
          "end": 130,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190544/line-5",
          "start": 131,
          "end": 173,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190544/line-6",
          "start": 174,
          "end": 215,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1010256,
        "end": 1010521,
        "line": 38499,
        "column": 1,
        "path": "chap06/p@190544",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@190813",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SICINIUS.\nNay, pray, be patient. If you refuse your aid\nIn this so-never-needed help, yet do not\nUpbraid’s with our distress. But sure, if you\nWould be your country’s pleader, your good tongue,\nMore than the instant army we can make,\nMight stop our countryman.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@190813/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190813/line-2",
          "start": 10,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190813/line-3",
          "start": 56,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190813/line-4",
          "start": 97,
          "end": 142,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190813/line-5",
          "start": 143,
          "end": 193,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190813/line-6",
          "start": 194,
          "end": 233,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@190813/line-7",
          "start": 234,
          "end": 260,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1010525,
        "end": 1010840,
        "line": 38508,
        "column": 1,
        "path": "chap06/p@190813",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "SICINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@191132",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nNo, I’ll not meddle.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@191132/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@191132/line-2",
          "start": 10,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1010844,
        "end": 1010904,
        "line": 38518,
        "column": 1,
        "path": "chap06/p@191132",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@191196",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SICINIUS.\nPray you, go to him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@191196/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@191196/line-2",
          "start": 10,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1010908,
        "end": 1010968,
        "line": 38523,
        "column": 1,
        "path": "chap06/p@191196",
        "anchor": "sceneV_6.1"
      },
      "speakerLabel": "SICINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.1/p@191260",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nWhat should I do?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@191260/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.1/p@191260/line-2",
          "start": 10,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
