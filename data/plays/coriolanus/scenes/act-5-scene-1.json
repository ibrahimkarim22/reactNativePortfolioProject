    {
      "id": "coriolanus/sceneV_6.1/p@192375",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nYou know the very road into his kindness\nAnd cannot lose your way.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.1/p@192375/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
