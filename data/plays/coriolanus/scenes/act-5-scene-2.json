      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND WATCH.\nWhat cause do you think I have to swoon?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@199795/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
