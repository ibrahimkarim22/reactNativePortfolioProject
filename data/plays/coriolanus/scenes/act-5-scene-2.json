  "content": [
    {
      "id": "coriolanus-5-2-stage-001",
      "type": "stage",
      "text": "Enter Menenius to the Watch, or Guard."
    },
    {
      "id": "coriolanus-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Stay! Whence are you?",
          "plainText": "Stay Whence are you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Stand, and go back.",
          "plainText": "Stand and go back",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "You guard like men; 'tis well. But by your leave,",
          "plainText": "You guard like men 'tis well But by your leave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "I am an officer of state and come",
          "plainText": "I am an officer of state and come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "To speak with Coriolanus.",
          "plainText": "To speak with Coriolanus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "From whence?",
          "plainText": "From whence",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "From Rome.",
          "plainText": "From Rome",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "You may not pass; you must return. Our general",
          "plainText": "You may not pass you must return Our general",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Will no more hear from thence.",
          "plainText": "Will no more hear from thence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "You'll see your Rome embraced with fire before",
          "plainText": "You'll see your Rome embraced with fire before",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "You'll speak with Coriolanus.",
          "plainText": "You'll speak with Coriolanus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Good my friends,",
          "plainText": "Good my friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "If you have heard your general talk of Rome",
          "plainText": "If you have heard your general talk of Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "And of his friends there, it is lots to blanks",
          "plainText": "And of his friends there it is lots to blanks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "My name hath touched your ears. It is Menenius.",
          "plainText": "My name hath touched your ears It is Menenius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Be it so; go back. The virtue of your name",
          "plainText": "Be it so go back The virtue of your name",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Is not here passable.",
          "plainText": "Is not here passable",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "I tell thee, fellow,",
          "plainText": "I tell thee fellow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Thy general is my lover. I have been",
          "plainText": "Thy general is my lover I have been",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "The book of his good acts, whence men have read",
          "plainText": "The book of his good acts whence men have read",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "His fame unparalleled happily amplified;",
          "plainText": "His fame unparalleled happily amplified",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0022",
          "number": 22,
          "speechLineNumber": 5,
          "text": "For I have ever verified my friends—",
          "plainText": "For I have ever verified my friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0023",
          "number": 23,
          "speechLineNumber": 6,
          "text": "Of whom he's chief—with all the size that verity",
          "plainText": "Of whom he's chiefwith all the size that verity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0024",
          "number": 24,
          "speechLineNumber": 7,
          "text": "Would without lapsing suffer. Nay, sometimes,",
          "plainText": "Would without lapsing suffer Nay sometimes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0025",
          "number": 25,
          "speechLineNumber": 8,
          "text": "Like to a bowl upon a subtle ground,",
          "plainText": "Like to a bowl upon a subtle ground",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0026",
          "number": 26,
          "speechLineNumber": 9,
          "text": "I have tumbled past the throw, and in his praise",
          "plainText": "I have tumbled past the throw and in his praise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0027",
          "number": 27,
          "speechLineNumber": 10,
          "text": "Have almost stamped the leasing. Therefore, fellow,",
          "plainText": "Have almost stamped the leasing Therefore fellow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0028",
          "number": 28,
          "speechLineNumber": 11,
          "text": "I must have leave to pass.",
          "plainText": "I must have leave to pass",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Faith, sir, if you had told as many lies in his behalf as you have uttered words in your own, you should not pass here, no, though it were as virtuous to lie as to live chastely. Therefore, go back.",
          "plainText": "Faith sir if you had told as many lies in his behalf as you have uttered words in your own you should not pass here no though it were as virtuous to lie as to live chastely Therefore go back",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Prithee, fellow, remember my name is Menenius, always factionary on the party of your general.",
          "plainText": "Prithee fellow remember my name is Menenius always factionary on the party of your general",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Howsoever you have been his liar, as you say you have, I am one that, telling true under him, must say you cannot pass. Therefore go back.",
          "plainText": "Howsoever you have been his liar as you say you have I am one that telling true under him must say you cannot pass Therefore go back",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Has he dined, can'st thou tell? For I would not speak with him till after dinner.",
          "plainText": "Has he dined can'st thou tell For I would not speak with him till after dinner",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "You are a Roman, are you?",
          "plainText": "You are a Roman are you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "I am, as thy general is.",
          "plainText": "I am as thy general is",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Then you should hate Rome as he does. Can you, when you have pushed out your gates the very defender of them, and, in a violent popular ignorance given your enemy your shield, think to front his revenges with the easy groans of old women, the virginal palms of your daughters, or with the palsied intercession of such a decayed dotant as you seem to be? Can you think to blow out the intended fire your city is ready to flame in with such weak breath as this? No, you are deceived. Therefore back to Rome and prepare for your execution. You are condemned. Our general has sworn you out of reprieve and pardon.",
          "plainText": "Then you should hate Rome as he does Can you when you have pushed out your gates the very defender of them and in a violent popular ignorance given your enemy your shield think to front his revenges with the easy groans of old women the virginal palms of your daughters or with the palsied intercession of such a decayed dotant as you seem to be Can you think to blow out the intended fire your city is ready to flame in with such weak breath as this No you are deceived Therefore back to Rome and prepare for your execution You are condemned Our general has sworn you out of reprieve and pardon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Sirrah, if thy captain knew I were here, he would use me with estimation.",
          "plainText": "Sirrah if thy captain knew I were here he would use me with estimation",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Come, my captain knows you not.",
          "plainText": "Come my captain knows you not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "I mean thy general.",
          "plainText": "I mean thy general",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "My general cares not for you. Back, I say, go, lest I let forth your half pint of blood. Back! That's the utmost of your having. Back!",
          "plainText": "My general cares not for you Back I say go lest I let forth your half pint of blood Back That's the utmost of your having Back",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Nay, but fellow, fellow—",
          "plainText": "Nay but fellow fellow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-stage-002",
      "type": "stage",
      "text": "Enter Coriolanus with Aufidius."
    },
    {
      "id": "coriolanus-5-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "What's the matter?",
          "plainText": "What's the matter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Now, you companion, I'll say an errand for you. You shall know now that I am in estimation; you shall perceive that a Jack guardant cannot office me from my son Coriolanus. Guess but by my entertainment with him if thou stand'st not i' th' state of hanging or of some death more long in spectatorship and crueller in suffering; behold now presently, and swoon for what's to come upon thee. [to Coriolanus.] The glorious gods sit in hourly synod about thy particular prosperity and love thee no worse than thy old father Menenius does! O my son, my son! Thou art preparing fire for us; look thee, here's water to quench it. I was hardly moved to come to thee; but being assured none but myself could move thee, I have been blown out of your gates with sighs, and conjure thee to pardon Rome and thy petitionary countrymen. The good gods assuage thy wrath and turn the dregs of it upon this varlet here, this, who, like a block, hath denied my access to thee.",
          "plainText": "Now you companion I'll say an errand for you You shall know now that I am in estimation you shall perceive that a Jack guardant cannot office me from my son Coriolanus Guess but by my entertainment with him if thou stand'st not i' th' state of hanging or of some death more long in spectatorship and crueller in suffering behold now presently and swoon for what's to come upon thee to Coriolanus The glorious gods sit in hourly synod about thy particular prosperity and love thee no worse than thy old father Menenius does O my son my son Thou art preparing fire for us look thee here's water to quench it I was hardly moved to come to thee but being assured none but myself could move thee I have been blown out of your gates with sighs and conjure thee to pardon Rome and thy petitionary countrymen The good gods assuage thy wrath and turn the dregs of it upon this varlet here this who like a block hath denied my access to thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Away!",
          "plainText": "Away",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "How? Away?",
          "plainText": "How Away",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Wife, mother, child, I know not. My affairs",
          "plainText": "Wife mother child I know not My affairs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "Are servanted to others. Though I owe",
          "plainText": "Are servanted to others Though I owe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "My revenge properly, my remission lies",
          "plainText": "My revenge properly my remission lies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "In Volscian breasts. That we have been familiar,",
          "plainText": "In Volscian breasts That we have been familiar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0049",
          "number": 49,
          "speechLineNumber": 5,
          "text": "Ingrate forgetfulness shall poison rather",
          "plainText": "Ingrate forgetfulness shall poison rather",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0050",
          "number": 50,
          "speechLineNumber": 6,
          "text": "Than pity note how much. Therefore begone.",
          "plainText": "Than pity note how much Therefore begone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0051",
          "number": 51,
          "speechLineNumber": 7,
          "text": "Mine ears against your suits are stronger than",
          "plainText": "Mine ears against your suits are stronger than",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0052",
          "number": 52,
          "speechLineNumber": 8,
          "text": "Your gates against my force. Yet, for I loved thee,",
          "plainText": "Your gates against my force Yet for I loved thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-2-line-0053",
          "number": 53,
          "speechLineNumber": 9,
          "text": "Take this along; I writ it for thy sake,",
          "plainText": "Take this along I writ it for thy sake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-stage-003",
      "type": "stage",
      "text": "[He gives Menenius a paper.]"
    },
    {
      "id": "coriolanus-5-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "aufidius",
        "name": "AUFIDIUS",
        "displayName": "Aufidius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "You keep a constant temper.",
          "plainText": "You keep a constant temper",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-stage-004",
      "type": "stage",
      "text": "[They exit.]"
    },
    {
      "id": "coriolanus-5-2-stage-005",
      "type": "stage",
      "text": "[The Guard and Menenius remain.]"
    },
    {
      "id": "coriolanus-5-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Now, sir, is your name Menenius?",
          "plainText": "Now sir is your name Menenius",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "'Tis a spell, you see, of much power. You know the way home again.",
          "plainText": "'Tis a spell you see of much power You know the way home again",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Do you hear how we are shent for keeping your Greatness back?",
          "plainText": "Do you hear how we are shent for keeping your Greatness back",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "What cause do you think I have to swoon?",
          "plainText": "What cause do you think I have to swoon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-033",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "I neither care for th' world nor your general. For such things as you, I can scarce think there's any, you're so slight. He that hath a will to die by himself fears it not from another. Let your general do his worst. For you, be that you are, long; and your misery increase with your age! I say to you, as I was said to, away!",
          "plainText": "I neither care for th' world nor your general For such things as you I can scarce think there's any you're so slight He that hath a will to die by himself fears it not from another Let your general do his worst For you be that you are long and your misery increase with your age I say to you as I was said to away",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "coriolanus-5-2-speech-034",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "A noble fellow, I warrant him.",
          "plainText": "A noble fellow I warrant him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-speech-035",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "coriolanus-5-2-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "The worthy fellow is our general. He is the rock, the oak not to be wind-shaken.",
          "plainText": "The worthy fellow is our general He is the rock the oak not to be windshaken",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-2-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
