      },
      "speakerLabel": "SECOND WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@199883",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nI neither care for th’ world nor your general. For such things as you, I can scarce think there’s any, you’re so slight. He that hath a will to die by himself fears it not from another. Let your general do his worst. For you, be that you are, long; and your misery increase with your age! I say to you, as I was said to, away!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@199883/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
