      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Menenius to the Watch, or Guard.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@193540/line-1",
          "start": 0,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1013252,
        "end": 1013349,
        "line": 38615,
        "column": 1,
        "path": "chap06/p@193540",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@193641",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST WATCH.\nStay! Whence are you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@193641/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@193641/line-2",
          "start": 13,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1013353,
        "end": 1013417,
        "line": 38619,
        "column": 1,
        "path": "chap06/p@193641",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "FIRST WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@193709",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND WATCH.\nStand, and go back.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@193709/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@193709/line-2",
          "start": 14,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1013421,
        "end": 1013484,
        "line": 38624,
        "column": 1,
        "path": "chap06/p@193709",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "SECOND WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@193776",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nYou guard like men; ’tis well. But by your leave,\nI am an officer of state and come\nTo speak with Coriolanus.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@193776/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@193776/line-2",
          "start": 10,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@193776/line-3",
          "start": 60,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@193776/line-4",
          "start": 94,
          "end": 119,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1013488,
        "end": 1013647,
        "line": 38629,
        "column": 1,
        "path": "chap06/p@193776",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@193939",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST WATCH.\nFrom whence?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@193939/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@193939/line-2",
          "start": 13,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1013651,
        "end": 1013706,
        "line": 38636,
        "column": 1,
        "path": "chap06/p@193939",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "FIRST WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@193998",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nFrom Rome.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@193998/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@193998/line-2",
          "start": 10,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1013710,
        "end": 1013760,
        "line": 38641,
        "column": 1,
        "path": "chap06/p@193998",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@194052",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST WATCH.\nYou may not pass; you must return. Our general\nWill no more hear from thence.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@194052/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194052/line-2",
          "start": 13,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194052/line-3",
          "start": 60,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1013764,
        "end": 1013889,
        "line": 38646,
        "column": 1,
        "path": "chap06/p@194052",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "FIRST WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@194181",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND WATCH.\nYou’ll see your Rome embraced with fire before\nYou’ll speak with Coriolanus.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@194181/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194181/line-2",
          "start": 14,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194181/line-3",
          "start": 61,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1013893,
        "end": 1014018,
        "line": 38652,
        "column": 1,
        "path": "chap06/p@194181",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "SECOND WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@194310",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nGood my friends,\nIf you have heard your general talk of Rome\nAnd of his friends there, it is lots to blanks\nMy name hath touched your ears. It is Menenius.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@194310/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194310/line-2",
          "start": 10,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194310/line-3",
          "start": 27,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194310/line-4",
          "start": 71,
          "end": 117,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194310/line-5",
          "start": 118,
          "end": 165,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1014022,
        "end": 1014232,
        "line": 38658,
        "column": 1,
        "path": "chap06/p@194310",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@194524",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST WATCH.\nBe it so; go back. The virtue of your name\nIs not here passable.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@194524/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194524/line-2",
          "start": 13,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194524/line-3",
          "start": 56,
          "end": 77,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1014236,
        "end": 1014348,
        "line": 38666,
        "column": 1,
        "path": "chap06/p@194524",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "FIRST WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@194640",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nI tell thee, fellow,\nThy general is my lover. I have been\nThe book of his good acts, whence men have read\nHis fame unparalleled happily amplified;\nFor I have ever verified my friends—\nOf whom he’s chief—with all the size that verity\nWould without lapsing suffer. Nay, sometimes,\nLike to a bowl upon a subtle ground,\nI have tumbled past the throw, and in his praise\nHave almost stamped the leasing. Therefore, fellow,\nI must have leave to pass.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-2",
          "start": 10,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-3",
          "start": 31,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-4",
          "start": 68,
          "end": 115,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-5",
          "start": 116,
          "end": 156,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-6",
          "start": 157,
          "end": 193,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-7",
          "start": 194,
          "end": 242,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-8",
          "start": 243,
          "end": 288,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-9",
          "start": 289,
          "end": 325,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-10",
          "start": 326,
          "end": 374,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-11",
          "start": 375,
          "end": 426,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@194640/line-12",
          "start": 427,
          "end": 453,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1014352,
        "end": 1014885,
        "line": 38672,
        "column": 1,
        "path": "chap06/p@194640",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@195177",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST WATCH.\nFaith, sir, if you had told as many lies in his behalf as you have uttered words in your own, you should not pass here, no, though it were as virtuous to lie as to live chastely. Therefore, go back.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@195177/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@195177/line-2",
          "start": 13,
          "end": 211,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1014889,
        "end": 1015132,
        "line": 38687,
        "column": 1,
        "path": "chap06/p@195177",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "FIRST WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@195424",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nPrithee, fellow, remember my name is Menenius, always factionary on the party of your general.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@195424/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@195424/line-2",
          "start": 10,
          "end": 104,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1015136,
        "end": 1015271,
        "line": 38694,
        "column": 1,
        "path": "chap06/p@195424",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@195563",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND WATCH.\nHowsoever you have been his liar, as you say you have, I am one that, telling true under him, must say you cannot pass. Therefore go back.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@195563/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@195563/line-2",
          "start": 14,
          "end": 152,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1015275,
        "end": 1015458,
        "line": 38700,
        "column": 1,
        "path": "chap06/p@195563",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "SECOND WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@195750",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nHas he dined, can’st thou tell? For I would not speak with him till after dinner.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@195750/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@195750/line-2",
          "start": 10,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1015462,
        "end": 1015584,
        "line": 38706,
        "column": 1,
        "path": "chap06/p@195750",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@195876",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST WATCH.\nYou are a Roman, are you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@195876/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "coriolanus/sceneV_6.2/p@195876/line-2",
          "start": 13,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1015588,
        "end": 1015656,
        "line": 38712,
        "column": 1,
        "path": "chap06/p@195876",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "FIRST WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@195948",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nI am, as thy general is.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
