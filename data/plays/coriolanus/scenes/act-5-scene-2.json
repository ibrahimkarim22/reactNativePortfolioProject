      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST WATCH.\nDo you hear how we are shent for keeping your Greatness back?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
