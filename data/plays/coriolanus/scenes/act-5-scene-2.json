        "end": 1018210,
        "line": 38792,
        "column": 1,
        "path": "chap06/p@198448",
        "anchor": "sceneV_6.2"
      },
      "speakerLabel": "MENENIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@198502",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORIOLANUS.\nWife, mother, child, I know not. My affairs\nAre servanted to others. Though I owe\nMy revenge properly, my remission lies\nIn Volscian breasts. That we have been familiar,\nIngrate forgetfulness shall poison rather\nThan pity note how much. Therefore begone.\nMine ears against your suits are stronger than\nYour gates against my force. Yet, for I loved thee,\nTake this along; I writ it for thy sake,",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@198502/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
