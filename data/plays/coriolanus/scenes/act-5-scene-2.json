    {
      "id": "coriolanus/sceneV_6.2/p@199072",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "And would have sent it. Another word, Menenius,\nI will not hear thee speak.—This man, Aufidius,\nWas my beloved in Rome; yet thou behold’st.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
