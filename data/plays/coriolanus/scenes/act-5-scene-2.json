        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "coriolanus/sceneV_6.2/p@199573",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND WATCH.\n’Tis a spell, you see, of much power. You know the way home again.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "coriolanus/sceneV_6.2/p@199573/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
