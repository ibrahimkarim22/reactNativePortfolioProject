    {
      "id": "coriolanus/sceneV_6.4/p@216238",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND MESSENGER.\nAs certain as I know the sun is fire.\nWhere have you lurked that you make doubt of it?\nNe’er through an arch so hurried the blown tide\nAs the recomforted through th’ gates. Why, hark you!",
      "separatorAfter": "\n\n",
      "spans": [],
