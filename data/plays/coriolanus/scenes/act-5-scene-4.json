      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "The trumpets, sackbuts, psalteries, and fifes,\nTabors and cymbals, and the shouting Romans\nMake the sun dance. Hark you!",
      "separatorAfter": "\n\n",
      "spans": [],
