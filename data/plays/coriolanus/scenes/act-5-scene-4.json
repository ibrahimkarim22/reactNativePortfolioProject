    {
      "id": "coriolanus/sceneV_6.4/p@216779",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENENIUS.\nThis is good news.\nI will go meet the ladies. This Volumnia\nIs worth of consuls, senators, patricians\nA city full; of tribunes such as you\nA sea and land full. You have prayed well today.\nThis morning for ten thousand of your throats\nI’d not have given a doit. Hark, how they joy!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
