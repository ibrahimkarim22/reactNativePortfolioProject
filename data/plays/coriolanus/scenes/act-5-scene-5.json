      "type": "speech",
      "speaker": {
        "id": "senator",
        "name": "SENATOR",
        "displayName": "Senator"
      },
      "lines": [
        {
          "id": "coriolanus-5-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Behold our patroness, the life of Rome!",
          "plainText": "Behold our patroness the life of Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Call all your tribes together, praise the gods,",
          "plainText": "Call all your tribes together praise the gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And make triumphant fires. Strew flowers before them,",
          "plainText": "And make triumphant fires Strew flowers before them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Unshout the noise that banished Martius,",
          "plainText": "Unshout the noise that banished Martius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-5-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Repeal him with the welcome of his mother.",
          "plainText": "Repeal him with the welcome of his mother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-5-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Cry \"Welcome, ladies, welcome!\"",
          "plainText": "Cry Welcome ladies welcome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
