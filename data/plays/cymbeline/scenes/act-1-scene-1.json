    "label": "Act 1, Scene 1",
    "title": "SCENE I. Britain. The garden of Cymbeline's palace.",
    "location": "Britain. The garden of Cymbeline's palace.",
    "orderInPlay": 1
  },
  "content": [
    {
      "id": "cymbeline-1-1-stage-001",
      "type": "stage",
      "text": "Enter two Gentlemen."
    },
    {
      "id": "cymbeline-1-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "You do not meet a man but frowns; our bloods",
          "plainText": "You do not meet a man but frowns our bloods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "No more obey the heavens than our courtiers",
          "plainText": "No more obey the heavens than our courtiers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Still seem as does the King's.",
          "plainText": "Still seem as does the King's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "But what's the matter?",
          "plainText": "But what's the matter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "His daughter, and the heir of's kingdom, whom",
          "plainText": "His daughter and the heir of's kingdom whom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "He purpos'd to his wife's sole son—a widow",
          "plainText": "He purpos'd to his wife's sole sona widow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "That late he married—hath referr'd herself",
          "plainText": "That late he marriedhath referr'd herself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "Unto a poor but worthy gentleman. She's wedded;",
          "plainText": "Unto a poor but worthy gentleman She's wedded",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0009",
          "number": 9,
          "speechLineNumber": 5,
          "text": "Her husband banish'd; she imprison'd. All",
          "plainText": "Her husband banish'd she imprison'd All",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0010",
          "number": 10,
          "speechLineNumber": 6,
          "text": "Is outward sorrow, though I think the King",
          "plainText": "Is outward sorrow though I think the King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0011",
          "number": 11,
          "speechLineNumber": 7,
          "text": "Be touch'd at very heart.",
          "plainText": "Be touch'd at very heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "None but the King?",
          "plainText": "None but the King",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "He that hath lost her too. So is the Queen,",
          "plainText": "He that hath lost her too So is the Queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "That most desir'd the match. But not a courtier,",
          "plainText": "That most desir'd the match But not a courtier",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "Although they wear their faces to the bent",
          "plainText": "Although they wear their faces to the bent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "Of the King's looks, hath a heart that is not",
          "plainText": "Of the King's looks hath a heart that is not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0017",
          "number": 17,
          "speechLineNumber": 5,
          "text": "Glad at the thing they scowl at.",
          "plainText": "Glad at the thing they scowl at",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "And why so?",
          "plainText": "And why so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "He that hath miss'd the Princess is a thing",
          "plainText": "He that hath miss'd the Princess is a thing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Too bad for bad report; and he that hath her—",
          "plainText": "Too bad for bad report and he that hath her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "I mean that married her, alack, good man!",
          "plainText": "I mean that married her alack good man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "And therefore banish'd—is a creature such",
          "plainText": "And therefore banish'dis a creature such",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "As, to seek through the regions of the earth",
          "plainText": "As to seek through the regions of the earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "For one his like, there would be something failing",
          "plainText": "For one his like there would be something failing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0025",
          "number": 25,
          "speechLineNumber": 7,
          "text": "In him that should compare. I do not think",
          "plainText": "In him that should compare I do not think",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0026",
          "number": 26,
          "speechLineNumber": 8,
          "text": "So fair an outward and such stuff within",
          "plainText": "So fair an outward and such stuff within",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0027",
          "number": 27,
          "speechLineNumber": 9,
          "text": "Endows a man but he.",
          "plainText": "Endows a man but he",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "You speak him far.",
          "plainText": "You speak him far",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I do extend him, sir, within himself;",
          "plainText": "I do extend him sir within himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "Crush him together rather than unfold",
          "plainText": "Crush him together rather than unfold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "His measure duly.",
          "plainText": "His measure duly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "What's his name and birth?",
          "plainText": "What's his name and birth",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "I cannot delve him to the root; his father",
          "plainText": "I cannot delve him to the root his father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Was call'd Sicilius, who did join his honour",
          "plainText": "Was call'd Sicilius who did join his honour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Against the Romans with Cassibelan,",
          "plainText": "Against the Romans with Cassibelan",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "But had his titles by Tenantius, whom",
          "plainText": "But had his titles by Tenantius whom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0037",
          "number": 37,
          "speechLineNumber": 5,
          "text": "He serv'd with glory and admir'd success,",
          "plainText": "He serv'd with glory and admir'd success",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0038",
          "number": 38,
          "speechLineNumber": 6,
          "text": "So gain'd the sur-addition Leonatus;",
          "plainText": "So gain'd the suraddition Leonatus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0039",
          "number": 39,
          "speechLineNumber": 7,
          "text": "And had, besides this gentleman in question,",
          "plainText": "And had besides this gentleman in question",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0040",
          "number": 40,
          "speechLineNumber": 8,
          "text": "Two other sons, who, in the wars o' th' time,",
          "plainText": "Two other sons who in the wars o' th' time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0041",
          "number": 41,
          "speechLineNumber": 9,
          "text": "Died with their swords in hand; for which their father,",
          "plainText": "Died with their swords in hand for which their father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0042",
          "number": 42,
          "speechLineNumber": 10,
          "text": "Then old and fond of issue, took such sorrow",
          "plainText": "Then old and fond of issue took such sorrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0043",
          "number": 43,
          "speechLineNumber": 11,
          "text": "That he quit being; and his gentle lady,",
          "plainText": "That he quit being and his gentle lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0044",
          "number": 44,
          "speechLineNumber": 12,
          "text": "Big of this gentleman, our theme, deceas'd",
          "plainText": "Big of this gentleman our theme deceas'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0045",
          "number": 45,
          "speechLineNumber": 13,
          "text": "As he was born. The King he takes the babe",
          "plainText": "As he was born The King he takes the babe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0046",
          "number": 46,
          "speechLineNumber": 14,
          "text": "To his protection, calls him Posthumus Leonatus,",
          "plainText": "To his protection calls him Posthumus Leonatus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0047",
          "number": 47,
          "speechLineNumber": 15,
          "text": "Breeds him and makes him of his bed-chamber,",
          "plainText": "Breeds him and makes him of his bedchamber",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0048",
          "number": 48,
          "speechLineNumber": 16,
          "text": "Puts to him all the learnings that his time",
          "plainText": "Puts to him all the learnings that his time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0049",
          "number": 49,
          "speechLineNumber": 17,
          "text": "Could make him the receiver of; which he took,",
          "plainText": "Could make him the receiver of which he took",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0050",
          "number": 50,
          "speechLineNumber": 18,
          "text": "As we do air, fast as 'twas minist'red,",
          "plainText": "As we do air fast as 'twas minist'red",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0051",
          "number": 51,
          "speechLineNumber": 19,
          "text": "And in's spring became a harvest, liv'd in court—",
          "plainText": "And in's spring became a harvest liv'd in court",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0052",
          "number": 52,
          "speechLineNumber": 20,
          "text": "Which rare it is to do—most prais'd, most lov'd,",
          "plainText": "Which rare it is to domost prais'd most lov'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0053",
          "number": 53,
          "speechLineNumber": 21,
          "text": "A sample to the youngest; to th' more mature",
          "plainText": "A sample to the youngest to th' more mature",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0054",
          "number": 54,
          "speechLineNumber": 22,
          "text": "A glass that feated them; and to the graver",
          "plainText": "A glass that feated them and to the graver",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0055",
          "number": 55,
          "speechLineNumber": 23,
          "text": "A child that guided dotards. To his mistress,",
          "plainText": "A child that guided dotards To his mistress",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0056",
          "number": 56,
          "speechLineNumber": 24,
          "text": "For whom he now is banish'd, her own price",
          "plainText": "For whom he now is banish'd her own price",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0057",
          "number": 57,
          "speechLineNumber": 25,
          "text": "Proclaims how she esteem'd him and his virtue;",
          "plainText": "Proclaims how she esteem'd him and his virtue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0058",
          "number": 58,
          "speechLineNumber": 26,
          "text": "By her election may be truly read",
          "plainText": "By her election may be truly read",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0059",
          "number": 59,
          "speechLineNumber": 27,
          "text": "What kind of man he is.",
          "plainText": "What kind of man he is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "I honour him",
          "plainText": "I honour him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "Even out of your report. But pray you tell me,",
          "plainText": "Even out of your report But pray you tell me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0062",
          "number": 62,
          "speechLineNumber": 3,
          "text": "Is she sole child to th' King?",
          "plainText": "Is she sole child to th' King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "His only child.",
          "plainText": "His only child",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "He had two sons—if this be worth your hearing,",
          "plainText": "He had two sonsif this be worth your hearing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "Mark it—the eldest of them at three years old,",
          "plainText": "Mark itthe eldest of them at three years old",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "I' th' swathing clothes the other, from their nursery",
          "plainText": "I' th' swathing clothes the other from their nursery",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0067",
          "number": 67,
          "speechLineNumber": 5,
          "text": "Were stol'n; and to this hour no guess in knowledge",
          "plainText": "Were stol'n and to this hour no guess in knowledge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0068",
          "number": 68,
          "speechLineNumber": 6,
          "text": "Which way they went.",
          "plainText": "Which way they went",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "How long is this ago?",
          "plainText": "How long is this ago",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Some twenty years.",
          "plainText": "Some twenty years",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "That a king's children should be so convey'd,",
          "plainText": "That a king's children should be so convey'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "So slackly guarded, and the search so slow",
          "plainText": "So slackly guarded and the search so slow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "That could not trace them!",
          "plainText": "That could not trace them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Howsoe'er 'tis strange,",
          "plainText": "Howsoe'er 'tis strange",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "Or that the negligence may well be laugh'd at,",
          "plainText": "Or that the negligence may well be laugh'd at",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-1-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "Yet is it true, sir.",
          "plainText": "Yet is it true sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
