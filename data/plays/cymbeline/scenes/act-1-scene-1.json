        "end": 1054634,
        "line": 40123,
        "column": 1,
        "path": "chap07/p@5729",
        "anchor": "sceneI_7.1"
      },
      "speakerLabel": "SECOND GENTLEMAN.",
      "attribution": {
        "status": "explicit",
