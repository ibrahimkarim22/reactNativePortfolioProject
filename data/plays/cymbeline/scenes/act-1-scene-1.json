    {
      "id": "cymbeline/sceneI_7.1/p@8261",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND GENTLEMAN.\nI honour him\nEven out of your report. But pray you tell me,\nIs she sole child to th’ King?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@8261/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@8261/line-2",
          "start": 18,
          "end": 30,
          "sourceLineNumber": null
        },
        {
