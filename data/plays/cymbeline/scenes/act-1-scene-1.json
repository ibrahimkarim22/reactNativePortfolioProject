    {
      "id": "cymbeline/sceneI_7.1/p@5104",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nYou do not meet a man but frowns; our bloods\nNo more obey the heavens than our courtiers\nStill seem as does the King’s.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@5104/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
