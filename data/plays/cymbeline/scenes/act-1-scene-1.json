      ],
      "sourceRef": {
        "start": 1057100,
        "end": 1057248,
        "line": 40203,
        "column": 1,
        "path": "chap07/p@8261",
        "anchor": "sceneI_7.1"
      },
      "speakerLabel": "SECOND GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 17
      }
    },
    {
      "id": "cymbeline/sceneI_7.1/p@8413",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nHis only child.\nHe had two sons—if this be worth your hearing,\nMark it—the eldest of them at three years old,\nI’ th’ swathing clothes the other, from their nursery\nWere stol’n; and to this hour no guess in knowledge\nWhich way they went.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@8413/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
