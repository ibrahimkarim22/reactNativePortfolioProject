      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nSome twenty years.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@8798/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
