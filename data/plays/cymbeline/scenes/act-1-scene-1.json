      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND GENTLEMAN.\nAnd why so?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@6084/line-1",
          "start": 0,
