      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "I do well believe you.",
          "plainText": "I do well believe you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
