        "end": 1057879,
        "line": 40230,
        "column": 1,
        "path": "chap07/p@8867",
        "anchor": "sceneI_7.1"
      },
      "speakerLabel": "SECOND GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 17
      }
    },
    {
      "id": "cymbeline/sceneI_7.1/p@9044",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nHowsoe’er ’tis strange,\nOr that the negligence may well be laugh’d at,\nYet is it true, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@9044/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@9044/line-2",
          "start": 17,
          "end": 40,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@9044/line-3",
          "start": 41,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@9044/line-4",
          "start": 88,
          "end": 108,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1057883,
        "end": 1058031,
        "line": 40237,
        "column": 1,
        "path": "chap07/p@9044",
        "anchor": "sceneI_7.1"
      },
      "speakerLabel": "FIRST GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "cymbeline/sceneI_7.1/p@9196",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND GENTLEMAN.\nI do well believe you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@9196/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@9196/line-2",
          "start": 18,
          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1058035,
        "end": 1058105,
        "line": 40244,
        "column": 1,
        "path": "chap07/p@9196",
        "anchor": "sceneI_7.1"
      },
      "speakerLabel": "SECOND GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 17
      }
    },
    {
      "id": "cymbeline/sceneI_7.1/p@9270",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nWe must forbear; here comes the gentleman,\nThe Queen, and Princess.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@9270/line-1",
          "start": 0,
