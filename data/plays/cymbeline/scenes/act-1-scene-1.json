        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "cymbeline-1-1-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "We must forbear; here comes the gentleman,",
          "plainText": "We must forbear here comes the gentleman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
