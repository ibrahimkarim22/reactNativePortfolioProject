    {
      "id": "cymbeline/sceneI_7.1/p@5799",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nHe that hath lost her too. So is the Queen,\nThat most desir’d the match. But not a courtier,\nAlthough they wear their faces to the bent\nOf the King’s looks, hath a heart that is not\nGlad at the thing they scowl at.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@5799/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
