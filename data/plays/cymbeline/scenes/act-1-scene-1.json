        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "cymbeline/sceneI_7.1/p@8867",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND GENTLEMAN.\nThat a king’s children should be so convey’d,\nSo slackly guarded, and the search so slow\nThat could not trace them!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@8867/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@8867/line-2",
          "start": 18,
          "end": 63,
          "sourceLineNumber": null
        },
        {
