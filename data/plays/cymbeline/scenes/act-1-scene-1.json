          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@6084/line-2",
          "start": 18,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1054923,
        "end": 1054982,
        "line": 40137,
        "column": 1,
        "path": "chap07/p@6084",
        "anchor": "sceneI_7.1"
      },
      "speakerLabel": "SECOND GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 17
      }
    },
    {
      "id": "cymbeline/sceneI_7.1/p@6147",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nHe that hath miss’d the Princess is a thing\nToo bad for bad report; and he that hath her—\nI mean that married her, alack, good man!\nAnd therefore banish’d—is a creature such\nAs, to seek through the regions of the earth\nFor one his like, there would be something failing\nIn him that should compare. I do not think\nSo fair an outward and such stuff within\nEndows a man but he.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@6147/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
