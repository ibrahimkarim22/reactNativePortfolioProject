      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND GENTLEMAN.\nBut what’s the matter?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@5284/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@5284/line-2",
          "start": 18,
          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1054123,
        "end": 1054193,
        "line": 40107,
        "column": 1,
        "path": "chap07/p@5284",
        "anchor": "sceneI_7.1"
      },
      "speakerLabel": "SECOND GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 17
      }
    },
    {
      "id": "cymbeline/sceneI_7.1/p@5358",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nHis daughter, and the heir of’s kingdom, whom\nHe purpos’d to his wife’s sole son—a widow\nThat late he married—hath referr’d herself\nUnto a poor but worthy gentleman. She’s wedded;\nHer husband banish’d; she imprison’d. All\nIs outward sorrow, though I think the King\nBe touch’d at very heart.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@5358/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
