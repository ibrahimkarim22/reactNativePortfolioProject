    {
      "id": "cymbeline/sceneI_7.1/p@6682",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nI do extend him, sir, within himself;\nCrush him together rather than unfold\nHis measure duly.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@6682/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@6682/line-2",
          "start": 17,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@6682/line-3",
          "start": 55,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@6682/line-4",
          "start": 93,
          "end": 110,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1055521,
        "end": 1055671,
        "line": 40160,
        "column": 1,
        "path": "chap07/p@6682",
