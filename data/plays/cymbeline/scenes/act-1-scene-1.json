    {
      "id": "cymbeline/sceneI_7.1/p@6612",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND GENTLEMAN.\nYou speak him far.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@6612/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@6612/line-2",
          "start": 18,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
