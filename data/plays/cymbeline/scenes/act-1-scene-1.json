        {
          "id": "cymbeline/sceneI_7.1/p@5104/line-2",
          "start": 17,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@5104/line-3",
          "start": 62,
          "end": 105,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.1/p@5104/line-4",
          "start": 106,
          "end": 136,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
