      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND GENTLEMAN.\nHow long is this ago?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.1/p@8725/line-1",
          "start": 0,
