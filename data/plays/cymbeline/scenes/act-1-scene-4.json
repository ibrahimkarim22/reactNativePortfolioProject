    {
      "id": "cymbeline/sceneI_7.4/p@21122",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PISANIO.\nMadam, so I did.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@21122/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@21122/line-2",
          "start": 9,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1069961,
        "end": 1070016,
        "line": 40759,
        "column": 1,
        "path": "chap07/p@21122",
        "anchor": "sceneI_7.4"
      },
      "speakerLabel": "PISANIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "cymbeline/sceneI_7.4/p@21181",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\nI would have broke mine eyestrings, crack’d them but\nTo look upon him, till the diminution\nOf space had pointed him sharp as my needle;\nNay, followed him till he had melted from\nThe smallness of a gnat to air, and then\nHave turn’d mine eye and wept. But, good Pisanio,\nWhen shall we hear from him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@21181/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@21181/line-2",
          "start": 8,
          "end": 60,
          "sourceLineNumber": null
        },
        {
