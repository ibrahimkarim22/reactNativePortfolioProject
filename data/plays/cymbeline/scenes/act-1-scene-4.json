      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PISANIO.\nIt was: his queen, his queen!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@20337/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20337/line-2",
          "start": 9,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1069176,
