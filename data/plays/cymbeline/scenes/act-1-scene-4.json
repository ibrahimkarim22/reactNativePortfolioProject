    {
      "id": "cymbeline/sceneI_7.4/p@20479",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PISANIO.\nAnd kiss’d it, madam.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@20479/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
