    {
      "id": "cymbeline/sceneI_7.4/p@22378",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LADY.\nThe Queen, madam,\nDesires your Highness’ company.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@22378/line-1",
