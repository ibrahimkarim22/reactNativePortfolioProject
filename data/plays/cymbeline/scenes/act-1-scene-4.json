    {
      "id": "cymbeline/sceneI_7.4/p@20073",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\nI would thou grew’st unto the shores o’ th’ haven,\nAnd questioned’st every sail; if he should write,\nAnd I not have it, ’twere a paper lost,\nAs offer’d mercy is. What was the last\nThat he spake to thee?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@20073/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20073/line-2",
          "start": 8,
          "end": 58,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20073/line-3",
          "start": 59,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20073/line-4",
          "start": 109,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20073/line-5",
          "start": 149,
          "end": 187,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20073/line-6",
