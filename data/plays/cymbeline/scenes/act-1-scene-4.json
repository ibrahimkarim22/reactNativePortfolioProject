    {
      "id": "cymbeline/sceneI_7.4/p@21550",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PISANIO.\nBe assur’d, madam,\nWith his next vantage.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@21550/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@21550/line-2",
          "start": 9,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@21550/line-3",
          "start": 28,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1070389,
        "end": 1070474,
        "line": 40775,
        "column": 1,
        "path": "chap07/p@21550",
        "anchor": "sceneI_7.4"
      },
      "speakerLabel": "PISANIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "cymbeline/sceneI_7.4/p@21639",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\nI did not take my leave of him, but had\nMost pretty things to say. Ere I could tell him\nHow I would think on him at certain hours\nSuch thoughts and such; or I could make him swear\nThe shes of Italy should not betray\nMine interest and his honour; or have charg’d him,\nAt the sixth hour of morn, at noon, at midnight,\nT’ encounter me with orisons, for then\nI am in heaven for him; or ere I could\nGive him that parting kiss which I had set\nBetwixt two charming words, comes in my father,\nAnd like the tyrannous breathing of the north\nShakes all our buds from growing.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@21639/line-1",
          "start": 0,
          "end": 7,
