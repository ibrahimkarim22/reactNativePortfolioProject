        "line": 40720,
        "column": 1,
        "path": "chap07/p@20337",
        "anchor": "sceneI_7.4"
      },
      "speakerLabel": "PISANIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "cymbeline/sceneI_7.4/p@20409",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\nThen wav’d his handkerchief?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@20409/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
