        "end": 1069378,
        "line": 40730,
        "column": 1,
        "path": "chap07/p@20479",
        "anchor": "sceneI_7.4"
      },
      "speakerLabel": "PISANIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "cymbeline/sceneI_7.4/p@20543",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\nSenseless linen, happier therein than I!\nAnd that was all?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@20543/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20543/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20543/line-3",
          "start": 49,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1069382,
        "end": 1069483,
        "line": 40735,
        "column": 1,
        "path": "chap07/p@20543",
        "anchor": "sceneI_7.4"
      },
      "speakerLabel": "IMOGEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "cymbeline/sceneI_7.4/p@20648",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PISANIO.\nNo, madam; for so long\nAs he could make me with his eye, or ear\nDistinguish him from others, he did keep\nThe deck, with glove, or hat, or handkerchief,\nStill waving, as the fits and stirs of’s mind\nCould best express how slow his soul sail’d on,\nHow swift his ship.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@20648/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20648/line-2",
          "start": 9,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20648/line-3",
          "start": 32,
          "end": 72,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20648/line-4",
          "start": 73,
          "end": 113,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20648/line-5",
          "start": 114,
          "end": 160,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20648/line-6",
          "start": 161,
          "end": 206,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20648/line-7",
