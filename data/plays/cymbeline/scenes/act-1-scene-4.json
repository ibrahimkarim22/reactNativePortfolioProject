    {
      "id": "cymbeline/sceneI_7.4/p@20986",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\nThou shouldst have made him\nAs little as a crow, or less, ere left\nTo after-eye him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneI_7.4/p@20986/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20986/line-2",
          "start": 8,
          "end": 35,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20986/line-3",
          "start": 36,
          "end": 74,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneI_7.4/p@20986/line-4",
          "start": 75,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
