  "scene": {
    "id": "cymbeline-1-4",
    "act": 1,
    "scene": 4,
    "label": "Act 1, Scene 4",
    "title": "SCENE IV. Britain. Cymbeline's palace.",
    "location": "Britain. Cymbeline's palace.",
    "orderInPlay": 4
  },
  "content": [
    {
      "id": "cymbeline-1-4-stage-001",
      "type": "stage",
      "text": "Enter Imogen and Pisanio."
    },
    {
      "id": "cymbeline-1-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I would thou grew'st unto the shores o' th' haven,",
          "plainText": "I would thou grew'st unto the shores o' th' haven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And questioned'st every sail; if he should write,",
          "plainText": "And questioned'st every sail if he should write",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And I not have it, 'twere a paper lost,",
          "plainText": "And I not have it 'twere a paper lost",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "As offer'd mercy is. What was the last",
          "plainText": "As offer'd mercy is What was the last",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "That he spake to thee?",
          "plainText": "That he spake to thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "It was: his queen, his queen!",
          "plainText": "It was his queen his queen",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Then wav'd his handkerchief?",
          "plainText": "Then wav'd his handkerchief",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "And kiss'd it, madam.",
          "plainText": "And kiss'd it madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Senseless linen, happier therein than I!",
          "plainText": "Senseless linen happier therein than I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "And that was all?",
          "plainText": "And that was all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "No, madam; for so long",
          "plainText": "No madam for so long",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "As he could make me with his eye, or ear",
          "plainText": "As he could make me with his eye or ear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Distinguish him from others, he did keep",
          "plainText": "Distinguish him from others he did keep",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "The deck, with glove, or hat, or handkerchief,",
          "plainText": "The deck with glove or hat or handkerchief",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "Still waving, as the fits and stirs of's mind",
          "plainText": "Still waving as the fits and stirs of's mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0016",
          "number": 16,
          "speechLineNumber": 6,
          "text": "Could best express how slow his soul sail'd on,",
          "plainText": "Could best express how slow his soul sail'd on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0017",
          "number": 17,
          "speechLineNumber": 7,
          "text": "How swift his ship.",
          "plainText": "How swift his ship",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Thou shouldst have made him",
          "plainText": "Thou shouldst have made him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "As little as a crow, or less, ere left",
          "plainText": "As little as a crow or less ere left",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "To after-eye him.",
          "plainText": "To aftereye him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Madam, so I did.",
          "plainText": "Madam so I did",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I would have broke mine eyestrings, crack'd them but",
          "plainText": "I would have broke mine eyestrings crack'd them but",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "To look upon him, till the diminution",
          "plainText": "To look upon him till the diminution",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "Of space had pointed him sharp as my needle;",
          "plainText": "Of space had pointed him sharp as my needle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Nay, followed him till he had melted from",
          "plainText": "Nay followed him till he had melted from",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "The smallness of a gnat to air, and then",
          "plainText": "The smallness of a gnat to air and then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0027",
          "number": 27,
          "speechLineNumber": 6,
          "text": "Have turn'd mine eye and wept. But, good Pisanio,",
          "plainText": "Have turn'd mine eye and wept But good Pisanio",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0028",
          "number": 28,
          "speechLineNumber": 7,
          "text": "When shall we hear from him?",
          "plainText": "When shall we hear from him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Be assur'd, madam,",
          "plainText": "Be assur'd madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "With his next vantage.",
          "plainText": "With his next vantage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "I did not take my leave of him, but had",
          "plainText": "I did not take my leave of him but had",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Most pretty things to say. Ere I could tell him",
          "plainText": "Most pretty things to say Ere I could tell him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "How I would think on him at certain hours",
          "plainText": "How I would think on him at certain hours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "Such thoughts and such; or I could make him swear",
          "plainText": "Such thoughts and such or I could make him swear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0035",
          "number": 35,
          "speechLineNumber": 5,
          "text": "The shes of Italy should not betray",
          "plainText": "The shes of Italy should not betray",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0036",
          "number": 36,
          "speechLineNumber": 6,
          "text": "Mine interest and his honour; or have charg'd him,",
          "plainText": "Mine interest and his honour or have charg'd him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0037",
          "number": 37,
          "speechLineNumber": 7,
          "text": "At the sixth hour of morn, at noon, at midnight,",
          "plainText": "At the sixth hour of morn at noon at midnight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0038",
          "number": 38,
          "speechLineNumber": 8,
          "text": "T' encounter me with orisons, for then",
          "plainText": "T' encounter me with orisons for then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0039",
          "number": 39,
          "speechLineNumber": 9,
          "text": "I am in heaven for him; or ere I could",
          "plainText": "I am in heaven for him or ere I could",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0040",
          "number": 40,
          "speechLineNumber": 10,
          "text": "Give him that parting kiss which I had set",
          "plainText": "Give him that parting kiss which I had set",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0041",
          "number": 41,
          "speechLineNumber": 11,
          "text": "Betwixt two charming words, comes in my father,",
          "plainText": "Betwixt two charming words comes in my father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0042",
          "number": 42,
          "speechLineNumber": 12,
          "text": "And like the tyrannous breathing of the north",
          "plainText": "And like the tyrannous breathing of the north",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0043",
          "number": 43,
          "speechLineNumber": 13,
          "text": "Shakes all our buds from growing.",
          "plainText": "Shakes all our buds from growing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-stage-002",
      "type": "stage",
      "text": "Enter a Lady."
    },
    {
      "id": "cymbeline-1-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "lady",
        "name": "LADY",
        "displayName": "Lady"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "The Queen, madam,",
          "plainText": "The Queen madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "Desires your Highness' company.",
          "plainText": "Desires your Highness' company",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Those things I bid you do, get them dispatch'd.",
          "plainText": "Those things I bid you do get them dispatch'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-4-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "I will attend the Queen.",
          "plainText": "I will attend the Queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-1-4-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Madam, I shall.",
          "plainText": "Madam I shall",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-4-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}