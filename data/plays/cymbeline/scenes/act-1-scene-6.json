    {
      "id": "cymbeline/sceneI_7.6/p@37839",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "A sly and constant knave,\nNot to be shak’d; the agent for his master,\nAnd the remembrancer of her to hold\nThe hand-fast to her lord. I have given him that\nWhich, if he take, shall quite unpeople her\nOf liegers for her sweet; and which she after,\nExcept she bend her humour, shall be assur’d\nTo taste of too.",
      "separatorAfter": "\n\n",
