    {
      "id": "cymbeline/sceneI_7.6/p@33644",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "But I beseech your Grace, without offence,\n(My conscience bids me ask) wherefore you have\nCommanded of me these most poisonous compounds\nWhich are the movers of a languishing death,\nBut, though slow, deadly?",
      "separatorAfter": "\n\n",
