          "end": 30,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@51518/line-1",
          "start": 0,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1100357,
        "end": 1100475,
        "line": 41851,
        "column": 1,
        "path": "chap07/p@51518",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@51640",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOTEN.\nWas there ever man had such luck! When I kiss’d the jack, upon an upcast to be hit away! I had a hundred pound on’t; and then a whoreson jackanapes must take me up for swearing, as if I borrowed mine oaths of him, and might not spend them at my pleasure.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@51640/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@51640/line-2",
          "start": 8,
          "end": 262,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1100479,
        "end": 1100774,
        "line": 41854,
        "column": 1,
        "path": "chap07/p@51640",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "CLOTEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@51939",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nWhat got he by that? You have broke his pate with your bowl.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@51939/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@51939/line-2",
          "start": 12,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1100778,
        "end": 1100880,
        "line": 41862,
        "column": 1,
        "path": "chap07/p@51939",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@52045",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\n[Aside.] If his wit had been like him that broke it, it would have run all out.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 14,
          "end": 20
        }
      ],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@52045/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@52045/line-2",
          "start": 13,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1100884,
        "end": 1101014,
        "line": 41867,
        "column": 1,
        "path": "chap07/p@52045",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@52179",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOTEN.\nWhen a gentleman is dispos’d to swear, it is not for any standers-by to curtail his oaths. Ha?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@52179/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@52179/line-2",
          "start": 8,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1101018,
        "end": 1101151,
        "line": 41873,
        "column": 1,
        "path": "chap07/p@52179",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "CLOTEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@52316",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nNo, my lord; [Aside.] nor crop the ears of them.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 27,
          "end": 33
        }
      ],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@52316/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@52316/line-2",
          "start": 13,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1101155,
        "end": 1101253,
        "line": 41879,
        "column": 1,
        "path": "chap07/p@52316",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@52418",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOTEN.\nWhoreson dog! I gave him satisfaction. Would he had been one of my rank!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@52418/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@52418/line-2",
          "start": 8,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1101257,
        "end": 1101367,
        "line": 41884,
        "column": 1,
        "path": "chap07/p@52418",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "CLOTEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@52532",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\n[Aside.] To have smell’d like a fool.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 14,
          "end": 20
        }
      ],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@52532/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@52532/line-2",
          "start": 13,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1101371,
        "end": 1101458,
        "line": 41889,
        "column": 1,
        "path": "chap07/p@52532",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@52623",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOTEN.\nI am not vex’d more at anything in th’ earth. A pox on’t! I had rather not be so noble as I am; they dare not fight with me, because of the Queen my mother. Every jackslave hath his bellyful of fighting, and I must go up and down like a cock that nobody can match.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@52623/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@52623/line-2",
          "start": 8,
          "end": 272,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1101462,
        "end": 1101767,
        "line": 41894,
        "column": 1,
        "path": "chap07/p@52623",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "CLOTEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@52932",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\n[Aside.] You are cock and capon too; and you crow, cock, with your comb on.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 14,
          "end": 20
        }
      ],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@52932/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@52932/line-2",
          "start": 13,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1101771,
        "end": 1101897,
        "line": 41902,
        "column": 1,
        "path": "chap07/p@52932",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@53062",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOTEN.\nSayest thou?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@53062/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@53062/line-2",
          "start": 8,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1101901,
        "end": 1101951,
        "line": 41908,
        "column": 1,
        "path": "chap07/p@53062",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "CLOTEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@53116",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nIt is not fit your lordship should undertake every companion that you give offence to.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@53116/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@53116/line-2",
          "start": 13,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1101955,
        "end": 1102085,
        "line": 41913,
        "column": 1,
        "path": "chap07/p@53116",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@53250",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOTEN.\nNo, I know that; but it is fit I should commit offence to my inferiors.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@53250/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@53250/line-2",
          "start": 8,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1102089,
        "end": 1102198,
        "line": 41919,
        "column": 1,
        "path": "chap07/p@53250",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "CLOTEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@53363",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nAy, it is fit for your lordship only.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@53363/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@53363/line-2",
          "start": 13,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1102202,
        "end": 1102282,
        "line": 41924,
        "column": 1,
        "path": "chap07/p@53363",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@53447",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOTEN.\nWhy, so I say.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@53447/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@53447/line-2",
          "start": 8,
          "end": 22,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1102286,
        "end": 1102338,
        "line": 41929,
        "column": 1,
        "path": "chap07/p@53447",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "CLOTEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@53503",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nDid you hear of a stranger that’s come to court tonight?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@53503/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@53503/line-2",
          "start": 12,
          "end": 68,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1102342,
        "end": 1102440,
        "line": 41934,
        "column": 1,
        "path": "chap07/p@53503",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@53605",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOTEN.\nA stranger, and I not known on’t?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@53605/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@53605/line-2",
          "start": 8,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1102444,
        "end": 1102515,
        "line": 41939,
        "column": 1,
        "path": "chap07/p@53605",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "CLOTEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@53680",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\n[Aside.] He’s a strange fellow himself, and knows it not.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 14,
          "end": 20
        }
      ],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@53680/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@53680/line-2",
          "start": 13,
          "end": 70,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1102519,
        "end": 1102626,
        "line": 41944,
        "column": 1,
        "path": "chap07/p@53680",
        "anchor": "sceneII_7.1"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "cymbeline/sceneII_7.1/p@53791",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nThere’s an Italian come, and, ’tis thought, one of Leonatus’ friends.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneII_7.1/p@53791/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneII_7.1/p@53791/line-2",
          "start": 12,
          "end": 81,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1102630,
        "end": 1102742,
        "line": 41949,
        "column": 1,
        "path": "chap07/p@53791",
        "anchor": "sceneII_7.1"
      },
