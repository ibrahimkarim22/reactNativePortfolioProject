    {
      "id": "cymbeline/sceneIII_7.1/p@86332",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOTEN.\nHis majesty bids you welcome. Make pastime with us a day or two, or longer. If you seek us afterwards in other terms, you shall find us in our salt-water girdle. If you beat us out of it, it is yours; if you fall in the adventure, our crows shall fare the better for you; and there’s an end.",
      "separatorAfter": "\n\n",
      "spans": [],
