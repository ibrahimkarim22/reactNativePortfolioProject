    {
      "id": "cymbeline/sceneIII_7.1/p@82103",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CYMBELINE.\nNow say, what would Augustus Cæsar with us?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIII_7.1/p@82103/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.1/p@82103/line-2",
          "start": 11,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1130942,
        "end": 1131026,
        "line": 43030,
        "column": 1,
        "path": "chap07/p@82103",
        "anchor": "sceneIII_7.1"
      },
      "speakerLabel": "CYMBELINE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "cymbeline/sceneIII_7.1/p@82191",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nWhen Julius Cæsar, (whose remembrance yet\nLives in men’s eyes, and will to ears and tongues\nBe theme and hearing ever) was in this Britain,\nAnd conquer’d it, Cassibelan, thine uncle,\nFamous in Cæsar’s praises no whit less\nThan in his feats deserving it, for him\nAnd his succession granted Rome a tribute,\nYearly three thousand pounds, which by thee lately\nIs left untender’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIII_7.1/p@82191/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.1/p@82191/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.1/p@82191/line-3",
          "start": 50,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.1/p@82191/line-4",
          "start": 100,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.1/p@82191/line-5",
          "start": 148,
          "end": 190,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.1/p@82191/line-6",
          "start": 191,
          "end": 229,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.1/p@82191/line-7",
          "start": 230,
          "end": 269,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.1/p@82191/line-8",
          "start": 270,
          "end": 312,
          "sourceLineNumber": null
        },
