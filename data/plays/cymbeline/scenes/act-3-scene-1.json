    {
      "id": "cymbeline/sceneIII_7.1/p@85458",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nI am sorry, Cymbeline,\nThat I am to pronounce Augustus Cæsar\n(Cæsar, that hath moe kings his servants than\nThyself domestic officers) thine enemy.\nReceive it from me, then: war and confusion\nIn Cæsar’s name pronounce I ’gainst thee; look\nFor fury not to be resisted. Thus defied,\nI thank thee for myself.",
      "separatorAfter": "\n\n",
      "spans": [],
