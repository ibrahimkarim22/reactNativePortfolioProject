    {
      "id": "cymbeline/sceneIII_7.2/p@90778",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PISANIO.\nOne score ’twixt sun and sun,\nMadam, ’s enough for you, and too much too.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIII_7.2/p@90778/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
