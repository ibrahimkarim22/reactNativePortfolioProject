    {
      "id": "cymbeline/sceneIII_7.2/p@91394",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\nI see before me, man. Nor here, nor here,\nNor what ensues, but have a fog in them\nThat I cannot look through. Away, I prithee;\nDo as I bid thee. There’s no more to say.\nAccessible is none but Milford way.",
      "separatorAfter": "\n\n",
      "spans": [],
