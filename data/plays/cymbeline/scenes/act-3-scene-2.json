  "scene": {
    "id": "cymbeline-3-2",
    "act": 3,
    "scene": 2,
    "label": "Act 3, Scene 2",
    "title": "SCENE II. Britain. Another room in Cymbeline's palace.",
    "location": "Britain. Another room in Cymbeline's palace.",
    "orderInPlay": 14
  },
  "content": [
    {
      "id": "cymbeline-3-2-stage-001",
      "type": "stage",
      "text": "Enter Pisanio reading of a letter."
    },
    {
      "id": "cymbeline-3-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-3-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "How? of adultery? Wherefore write you not",
          "plainText": "How of adultery Wherefore write you not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "What monsters her accuse? Leonatus!",
          "plainText": "What monsters her accuse Leonatus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "O master, what a strange infection",
          "plainText": "O master what a strange infection",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Is fall'n into thy ear! What false Italian",
          "plainText": "Is fall'n into thy ear What false Italian",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "(As poisonous-tongu'd as handed) hath prevail'd",
          "plainText": "As poisonoustongu'd as handed hath prevail'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "On thy too ready hearing? Disloyal? No.",
          "plainText": "On thy too ready hearing Disloyal No",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "She's punish'd for her truth, and undergoes,",
          "plainText": "She's punish'd for her truth and undergoes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "More goddess-like than wife-like, such assaults",
          "plainText": "More goddesslike than wifelike such assaults",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "As would take in some virtue. O my master,",
          "plainText": "As would take in some virtue O my master",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Thy mind to her is now as low as were",
          "plainText": "Thy mind to her is now as low as were",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Thy fortunes. How? that I should murder her?",
          "plainText": "Thy fortunes How that I should murder her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "Upon the love, and truth, and vows, which I",
          "plainText": "Upon the love and truth and vows which I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "Have made to thy command? I, her? Her blood?",
          "plainText": "Have made to thy command I her Her blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "If it be so to do good service, never",
          "plainText": "If it be so to do good service never",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "Let me be counted serviceable. How look I",
          "plainText": "Let me be counted serviceable How look I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "That I should seem to lack humanity",
          "plainText": "That I should seem to lack humanity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "So much as this fact comes to?",
          "plainText": "So much as this fact comes to",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-2-stage-002",
      "type": "stage",
      "text": "[Reads.]"
    },
    {
      "id": "cymbeline-3-2-stage-003",
      "type": "stage",
      "text": "Enter Imogen."
    },
    {
      "id": "cymbeline-3-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "How now, Pisanio?",
          "plainText": "How now Pisanio",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-3-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Madam, here is a letter from my lord.",
          "plainText": "Madam here is a letter from my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Who? thy lord? That is my lord, Leonatus?",
          "plainText": "Who thy lord That is my lord Leonatus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "O, learn'd indeed were that astronomer",
          "plainText": "O learn'd indeed were that astronomer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "That knew the stars as I his characters;",
          "plainText": "That knew the stars as I his characters",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "He'd lay the future open. You good gods,",
          "plainText": "He'd lay the future open You good gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "Let what is here contain'd relish of love,",
          "plainText": "Let what is here contain'd relish of love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0025",
          "number": 25,
          "speechLineNumber": 6,
          "text": "Of my lord's health, of his content; yet not",
          "plainText": "Of my lord's health of his content yet not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0026",
          "number": 26,
          "speechLineNumber": 7,
          "text": "That we two are asunder; let that grieve him!",
          "plainText": "That we two are asunder let that grieve him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0027",
          "number": 27,
          "speechLineNumber": 8,
          "text": "Some griefs are med'cinable; that is one of them,",
          "plainText": "Some griefs are med'cinable that is one of them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0028",
          "number": 28,
          "speechLineNumber": 9,
          "text": "For it doth physic love: of his content,",
          "plainText": "For it doth physic love of his content",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0029",
          "number": 29,
          "speechLineNumber": 10,
          "text": "All but in that. Good wax, thy leave. Blest be",
          "plainText": "All but in that Good wax thy leave Blest be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0030",
          "number": 30,
          "speechLineNumber": 11,
          "text": "You bees that make these locks of counsel! Lovers",
          "plainText": "You bees that make these locks of counsel Lovers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0031",
          "number": 31,
          "speechLineNumber": 12,
          "text": "And men in dangerous bonds pray not alike;",
          "plainText": "And men in dangerous bonds pray not alike",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0032",
          "number": 32,
          "speechLineNumber": 13,
          "text": "Though forfeiters you cast in prison, yet",
          "plainText": "Though forfeiters you cast in prison yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0033",
          "number": 33,
          "speechLineNumber": 14,
          "text": "You clasp young Cupid's tables. Good news, gods!",
          "plainText": "You clasp young Cupid's tables Good news gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-2-stage-004",
      "type": "stage",
      "text": "[Reads.]"
    },
    {
      "id": "cymbeline-3-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-3-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "One score 'twixt sun and sun,",
          "plainText": "One score 'twixt sun and sun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Madam, 's enough for you, and too much too.",
          "plainText": "Madam 's enough for you and too much too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Why, one that rode to's execution, man,",
          "plainText": "Why one that rode to's execution man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "Could never go so slow. I have heard of riding wagers",
          "plainText": "Could never go so slow I have heard of riding wagers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0038",
          "number": 38,
          "speechLineNumber": 3,
          "text": "Where horses have been nimbler than the sands",
          "plainText": "Where horses have been nimbler than the sands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0039",
          "number": 39,
          "speechLineNumber": 4,
          "text": "That run i' th' clock's behalf. But this is fool'ry.",
          "plainText": "That run i' th' clock's behalf But this is fool'ry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0040",
          "number": 40,
          "speechLineNumber": 5,
          "text": "Go bid my woman feign a sickness; say",
          "plainText": "Go bid my woman feign a sickness say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0041",
          "number": 41,
          "speechLineNumber": 6,
          "text": "She'll home to her father; and provide me presently",
          "plainText": "She'll home to her father and provide me presently",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0042",
          "number": 42,
          "speechLineNumber": 7,
          "text": "A riding suit, no costlier than would fit",
          "plainText": "A riding suit no costlier than would fit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0043",
          "number": 43,
          "speechLineNumber": 8,
          "text": "A franklin's huswife.",
          "plainText": "A franklin's huswife",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-3-2-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Madam, you're best consider.",
          "plainText": "Madam you're best consider",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-2-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "I see before me, man. Nor here, nor here,",
          "plainText": "I see before me man Nor here nor here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "Nor what ensues, but have a fog in them",
          "plainText": "Nor what ensues but have a fog in them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "That I cannot look through. Away, I prithee;",
          "plainText": "That I cannot look through Away I prithee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "Do as I bid thee. There's no more to say.",
          "plainText": "Do as I bid thee There's no more to say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-2-line-0049",
          "number": 49,
          "speechLineNumber": 5,
          "text": "Accessible is none but Milford way.",
          "plainText": "Accessible is none but Milford way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-2-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}