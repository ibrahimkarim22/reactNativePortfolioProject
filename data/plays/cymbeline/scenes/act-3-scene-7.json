    },
    {
      "id": "cymbeline/sceneIII_7.7/p@125482",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\n[Aside.] Great men,\nThat had a court no bigger than this cave,\nThat did attend themselves, and had the virtue\nWhich their own conscience seal’d them, laying by\nThat nothing-gift of differing multitudes,\nCould not out-peer these twain. Pardon me, gods!\nI’d change my sex to be companion with them,\nSince Leonatus false.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 9,
          "end": 15
        }
      ],
      "lines": [
        {
