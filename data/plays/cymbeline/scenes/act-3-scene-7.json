        "end": 1173492,
        "line": 44434,
        "column": 1,
        "path": "chap07/p@124504",
        "anchor": "sceneIII_7.7"
      },
      "speakerLabel": "GUIDERIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "cymbeline/sceneIII_7.7/p@124657",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARVIRAGUS.\nI’ll make’t my comfort\nHe is a man. I’ll love him as my brother;\nAnd such a welcome as I’d give to him\nAfter long absence, such is yours. Most welcome!\nBe sprightly, for you fall ’mongst friends.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIII_7.7/p@124657/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@124657/line-2",
          "start": 11,
          "end": 33,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@124657/line-3",
          "start": 34,
          "end": 75,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@124657/line-4",
          "start": 76,
          "end": 113,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@124657/line-5",
          "start": 114,
          "end": 162,
          "sourceLineNumber": null
        },
        {
