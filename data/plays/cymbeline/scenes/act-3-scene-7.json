    {
      "id": "cymbeline/sceneIII_7.7/p@124504",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GUIDERIUS.\nWere you a woman, youth,\nI should woo hard but be your groom. In honesty\nI bid for you as I’d buy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIII_7.7/p@124504/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@124504/line-2",
          "start": 11,
          "end": 35,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@124504/line-3",
          "start": 36,
          "end": 83,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@124504/line-4",
          "start": 84,
          "end": 109,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
