          "start": 10,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1172770,
        "end": 1172827,
        "line": 44411,
        "column": 1,
        "path": "chap07/p@123931",
        "anchor": "sceneIII_7.7"
      },
      "speakerLabel": "BELARIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "cymbeline/sceneIII_7.7/p@123992",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\nFidele, sir. I have a kinsman who\nIs bound for Italy; he embark’d at Milford;\nTo whom being going, almost spent with hunger,\nI am fall’n in this offence.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIII_7.7/p@123992/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@123992/line-2",
          "start": 8,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@123992/line-3",
          "start": 42,
          "end": 85,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@123992/line-4",
          "start": 86,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@123992/line-5",
          "start": 133,
          "end": 161,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1172831,
        "end": 1173037,
        "line": 44416,
        "column": 1,
        "path": "chap07/p@123992",
        "anchor": "sceneIII_7.7"
      },
      "speakerLabel": "IMOGEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "cymbeline/sceneIII_7.7/p@124202",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BELARIUS.\nPrithee, fair youth,\nThink us no churls, nor measure our good minds\nBy this rude place we live in. Well encounter’d!\n’Tis almost night; you shall have better cheer\nEre you depart, and thanks to stay and eat it.\nBoys, bid him welcome.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIII_7.7/p@124202/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIII_7.7/p@124202/line-2",
          "start": 10,
          "end": 30,
          "sourceLineNumber": null
        },
        {
