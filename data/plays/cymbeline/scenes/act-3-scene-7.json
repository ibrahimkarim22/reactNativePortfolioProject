    {
      "id": "cymbeline/sceneIII_7.7/p@125884",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BELARIUS.\nIt shall be so.\nBoys, we’ll go dress our hunt. Fair youth, come in.\nDiscourse is heavy, fasting; when we have supp’d,\nWe’ll mannerly demand thee of thy story,\nSo far as thou wilt speak it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIII_7.7/p@125884/line-1",
          "start": 0,
          "end": 9,
