    {
      "id": "cymbeline/sceneIII_7.7/p@122578",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BELARIUS.\n[Looking into the cave.] Stay, come not in.\nBut that it eats our victuals, I should think\nHere were a fairy.",
      "separatorAfter": "\n\n",
      "spans": [
        {
