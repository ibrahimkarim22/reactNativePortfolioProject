    {
      "id": "cymbeline/sceneIII_7.7/p@123034",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\nGood masters, harm me not.\nBefore I enter’d here I call’d, and thought\nTo have begg’d or bought what I have took. Good troth,\nI have stol’n nought; nor would not though I had found\nGold strew’d i’ th’ floor. Here’s money for my meat.\nI would have left it on the board, so soon\nAs I had made my meal, and parted\nWith pray’rs for the provider.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
