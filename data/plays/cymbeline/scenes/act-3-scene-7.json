      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BELARIUS.\nWhat’s your name?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIII_7.7/p@123931/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
