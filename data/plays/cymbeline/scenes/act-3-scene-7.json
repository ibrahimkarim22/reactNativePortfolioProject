    {
      "id": "cymbeline/sceneIII_7.7/p@125297",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARVIRAGUS.\nOr I, whate’er it be,\nWhat pain it cost, what danger! Gods!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
