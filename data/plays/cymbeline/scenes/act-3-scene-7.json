      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BELARIUS.\n[Whispering.] Hark, boys.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 11,
          "end": 22
        }
      ],
      "lines": [
