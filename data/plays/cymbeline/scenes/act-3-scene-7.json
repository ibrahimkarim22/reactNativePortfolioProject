      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IMOGEN.\nI see you’re angry.\nKnow, if you kill me for my fault, I should\nHave died had I not made it.",
      "separatorAfter": "\n\n",
      "spans": [],
