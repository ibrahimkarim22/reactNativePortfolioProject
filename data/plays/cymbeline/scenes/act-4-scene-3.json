    {
      "id": "cymbeline/sceneIV_7.3/p@158295",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORD.\nGood my liege,\nYour preparation can affront no less\nThan what you hear of. Come more, for more you’re ready.\nThe want is but to put those pow’rs in motion\nThat long to move.",
      "separatorAfter": "\n\n",
      "spans": [],
