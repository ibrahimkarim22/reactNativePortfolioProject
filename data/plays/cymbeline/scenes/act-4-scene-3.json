    {
      "id": "cymbeline/sceneIV_7.3/p@157274",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PISANIO.\nSir, my life is yours;\nI humbly set it at your will; but for my mistress,\nI nothing know where she remains, why gone,\nNor when she purposes return. Beseech your Highness,\nHold me your loyal servant.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
