    },
    {
      "id": "cymbeline/sceneIV_7.3/p@158528",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CYMBELINE.\nI thank you. Let’s withdraw,\nAnd meet the time as it seeks us. We fear not\nWhat can from Italy annoy us; but\nWe grieve at chances here. Away!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
