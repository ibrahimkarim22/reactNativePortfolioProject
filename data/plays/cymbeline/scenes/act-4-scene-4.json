    {
      "id": "cymbeline/sceneIV_7.4/p@160560",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GUIDERIUS.\nThis is, sir, a doubt\nIn such a time nothing becoming you\nNor satisfying us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIV_7.4/p@160560/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160560/line-2",
          "start": 11,
          "end": 32,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160560/line-3",
          "start": 33,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160560/line-4",
          "start": 69,
          "end": 87,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1209399,
        "end": 1209526,
        "line": 45792,
        "column": 1,
        "path": "chap07/p@160560",
        "anchor": "sceneIV_7.4"
      },
      "speakerLabel": "GUIDERIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "cymbeline/sceneIV_7.4/p@160691",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARVIRAGUS.\nIt is not likely\nThat when they hear the Roman horses neigh,\nBehold their quarter’d fires, have both their eyes\nAnd ears so cloy’d importantly as now,\nThat they will waste their time upon our note,\nTo know from whence we are.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIV_7.4/p@160691/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160691/line-2",
          "start": 11,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160691/line-3",
          "start": 28,
          "end": 71,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160691/line-4",
          "start": 72,
          "end": 122,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160691/line-5",
          "start": 123,
          "end": 161,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160691/line-6",
          "start": 162,
          "end": 208,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160691/line-7",
          "start": 209,
          "end": 236,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1209530,
        "end": 1209821,
        "line": 45799,
        "column": 1,
        "path": "chap07/p@160691",
        "anchor": "sceneIV_7.4"
      },
      "speakerLabel": "ARVIRAGUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "cymbeline/sceneIV_7.4/p@160986",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BELARIUS.\nO, I am known\nOf many in the army. Many years,\nThough Cloten then but young, you see, not wore him\nFrom my remembrance. And, besides, the King\nHath not deserv’d my service nor your loves,\nWho find in my exile the want of breeding,\nThe certainty of this hard life; aye hopeless\nTo have the courtesy your cradle promis’d,\nBut to be still hot summer’s tanlings and\nThe shrinking slaves of winter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIV_7.4/p@160986/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160986/line-2",
          "start": 10,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160986/line-3",
          "start": 24,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160986/line-4",
          "start": 57,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160986/line-5",
          "start": 109,
          "end": 152,
          "sourceLineNumber": null
        },
        {
