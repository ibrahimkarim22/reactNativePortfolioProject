    },
    {
      "id": "cymbeline/sceneIV_7.4/p@162170",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GUIDERIUS.\nBy heavens, I’ll go!\nIf you will bless me, sir, and give me leave,\nI’ll take the better care; but if you will not,\nThe hazard therefore due fall on me by\nThe hands of Romans!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIV_7.4/p@162170/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@162170/line-2",
          "start": 11,
          "end": 31,
          "sourceLineNumber": null
