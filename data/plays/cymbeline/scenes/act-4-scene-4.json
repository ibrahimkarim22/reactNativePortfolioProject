          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1208588,
        "end": 1208643,
        "line": 45760,
        "column": 1,
        "path": "chap07/p@159749",
        "anchor": "sceneIV_7.4"
      },
      "speakerLabel": "BELARIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "cymbeline/sceneIV_7.4/p@159808",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARVIRAGUS.\nWhat pleasure, sir, find we in life, to lock it\nFrom action and adventure?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIV_7.4/p@159808/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@159808/line-2",
          "start": 11,
          "end": 58,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@159808/line-3",
          "start": 59,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1208647,
        "end": 1208767,
        "line": 45765,
        "column": 1,
        "path": "chap07/p@159808",
        "anchor": "sceneIV_7.4"
      },
      "speakerLabel": "ARVIRAGUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "cymbeline/sceneIV_7.4/p@159932",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GUIDERIUS.\nNay, what hope\nHave we in hiding us? This way the Romans\nMust or for Britons slay us, or receive us\nFor barbarous and unnatural revolts\nDuring their use, and slay us after.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIV_7.4/p@159932/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@159932/line-2",
          "start": 11,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@159932/line-3",
          "start": 26,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@159932/line-4",
          "start": 68,
          "end": 110,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@159932/line-5",
          "start": 111,
          "end": 146,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@159932/line-6",
          "start": 147,
          "end": 183,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1208771,
        "end": 1209004,
        "line": 45771,
        "column": 1,
        "path": "chap07/p@159932",
        "anchor": "sceneIV_7.4"
      },
      "speakerLabel": "GUIDERIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "cymbeline/sceneIV_7.4/p@160169",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BELARIUS.\nSons,\nWe’ll higher to the mountains; there secure us.\nTo the King’s party there’s no going. Newness\nOf Cloten’s death (we being not known, not muster’d\nAmong the bands) may drive us to a render\nWhere we have liv’d, and so extort from’s that\nWhich we have done, whose answer would be death,\nDrawn on with torture.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIV_7.4/p@160169/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160169/line-2",
          "start": 10,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160169/line-3",
          "start": 16,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160169/line-4",
          "start": 64,
          "end": 109,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160169/line-5",
          "start": 110,
          "end": 161,
          "sourceLineNumber": null
        },
        {
          "id": "cymbeline/sceneIV_7.4/p@160169/line-6",
          "start": 162,
          "end": 203,
          "sourceLineNumber": null
        },
        {
