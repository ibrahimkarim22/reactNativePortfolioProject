      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BELARIUS.\nLet us from it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneIV_7.4/p@159749/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
