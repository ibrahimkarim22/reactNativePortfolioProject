  "scene": {
    "id": "cymbeline-5-1",
    "act": 5,
    "scene": 1,
    "label": "Act 5, Scene 1",
    "title": "SCENE I. Britain. The Roman camp.",
    "location": "Britain. The Roman camp.",
    "orderInPlay": 25
  },
  "content": [
    {
      "id": "cymbeline-5-1-stage-001",
      "type": "stage",
      "text": "Enter Posthumus alone, with a bloody handkerchief."
    },
    {
      "id": "cymbeline-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "posthumus",
        "name": "POSTHUMUS",
        "displayName": "Posthumus"
      },
      "lines": [
        {
          "id": "cymbeline-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Yea, bloody cloth, I'll keep thee; for I wish'd",
          "plainText": "Yea bloody cloth I'll keep thee for I wish'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Thou shouldst be colour'd thus. You married ones,",
          "plainText": "Thou shouldst be colour'd thus You married ones",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "If each of you should take this course, how many",
          "plainText": "If each of you should take this course how many",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Must murder wives much better than themselves",
          "plainText": "Must murder wives much better than themselves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "For wrying but a little! O Pisanio!",
          "plainText": "For wrying but a little O Pisanio",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Every good servant does not all commands;",
          "plainText": "Every good servant does not all commands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "No bond but to do just ones. Gods! if you",
          "plainText": "No bond but to do just ones Gods if you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Should have ta'en vengeance on my faults, I never",
          "plainText": "Should have ta'en vengeance on my faults I never",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Had liv'd to put on this; so had you saved",
          "plainText": "Had liv'd to put on this so had you saved",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "The noble Imogen to repent, and struck",
          "plainText": "The noble Imogen to repent and struck",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Me, wretch more worth your vengeance. But alack,",
          "plainText": "Me wretch more worth your vengeance But alack",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "You snatch some hence for little faults; that's love,",
          "plainText": "You snatch some hence for little faults that's love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "To have them fall no more. You some permit",
          "plainText": "To have them fall no more You some permit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "To second ills with ills, each elder worse,",
          "plainText": "To second ills with ills each elder worse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "And make them dread it, to the doers' thrift.",
          "plainText": "And make them dread it to the doers' thrift",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "But Imogen is your own. Do your best wills,",
          "plainText": "But Imogen is your own Do your best wills",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "And make me blest to obey. I am brought hither",
          "plainText": "And make me blest to obey I am brought hither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Among th' Italian gentry, and to fight",
          "plainText": "Among th' Italian gentry and to fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "Against my lady's kingdom. 'Tis enough",
          "plainText": "Against my lady's kingdom 'Tis enough",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "That, Britain, I have kill'd thy mistress; peace!",
          "plainText": "That Britain I have kill'd thy mistress peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "I'll give no wound to thee. Therefore, good heavens,",
          "plainText": "I'll give no wound to thee Therefore good heavens",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "Hear patiently my purpose. I'll disrobe me",
          "plainText": "Hear patiently my purpose I'll disrobe me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "Of these Italian weeds, and suit myself",
          "plainText": "Of these Italian weeds and suit myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "As does a Britain peasant. So I'll fight",
          "plainText": "As does a Britain peasant So I'll fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 25,
          "text": "Against the part I come with; so I'll die",
          "plainText": "Against the part I come with so I'll die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 26,
          "text": "For thee, O Imogen, even for whom my life",
          "plainText": "For thee O Imogen even for whom my life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 27,
          "text": "Is every breath a death. And thus unknown,",
          "plainText": "Is every breath a death And thus unknown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 28,
          "text": "Pitied nor hated, to the face of peril",
          "plainText": "Pitied nor hated to the face of peril",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 29,
          "text": "Myself I'll dedicate. Let me make men know",
          "plainText": "Myself I'll dedicate Let me make men know",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0030",
          "number": 30,
          "speechLineNumber": 30,
          "text": "More valour in me than my habits show.",
          "plainText": "More valour in me than my habits show",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0031",
          "number": 31,
          "speechLineNumber": 31,
          "text": "Gods, put the strength o' th' Leonati in me!",
          "plainText": "Gods put the strength o' th' Leonati in me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0032",
          "number": 32,
          "speechLineNumber": 32,
          "text": "To shame the guise o' th' world, I will begin",
          "plainText": "To shame the guise o' th' world I will begin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-1-line-0033",
          "number": 33,
          "speechLineNumber": 33,
          "text": "The fashion less without and more within.",
          "plainText": "The fashion less without and more within",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-5-1-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}