  "scene": {
    "id": "cymbeline-5-2",
    "act": 5,
    "scene": 2,
    "label": "Act 5, Scene 2",
    "title": "SCENE II. Britain. A field of battle between the British and Roman camps.",
    "location": "Britain. A field of battle between the British and Roman camps.",
    "orderInPlay": 26
  },
  "content": [
    {
      "id": "cymbeline-5-2-stage-001",
      "type": "stage",
      "text": "Enter Lucius, Iachimo and the Roman army at one door, and the British army at another, Leonatus Posthumus following like a poor soldier. They march over and go out. Alarums. Then enter again, in skirmish, Iachimo and Posthumus. He vanquisheth and disarmeth Iachimo and then leaves him."
    },
    {
      "id": "cymbeline-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "iachimo",
        "name": "IACHIMO",
        "displayName": "Iachimo"
      },
      "lines": [
        {
          "id": "cymbeline-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The heaviness and guilt within my bosom",
          "plainText": "The heaviness and guilt within my bosom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Takes off my manhood. I have belied a lady,",
          "plainText": "Takes off my manhood I have belied a lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "The Princess of this country, and the air on't",
          "plainText": "The Princess of this country and the air on't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Revengingly enfeebles me; or could this carl,",
          "plainText": "Revengingly enfeebles me or could this carl",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "A very drudge of nature's, have subdu'd me",
          "plainText": "A very drudge of nature's have subdu'd me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "In my profession? Knighthoods and honours borne",
          "plainText": "In my profession Knighthoods and honours borne",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "As I wear mine are titles but of scorn.",
          "plainText": "As I wear mine are titles but of scorn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "If that thy gentry, Britain, go before",
          "plainText": "If that thy gentry Britain go before",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "This lout as he exceeds our lords, the odds",
          "plainText": "This lout as he exceeds our lords the odds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Is that we scarce are men, and you are gods.",
          "plainText": "Is that we scarce are men and you are gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-5-2-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "cymbeline-5-2-stage-003",
      "type": "stage",
      "text": "The battle continues; the Britons fly; Cymbeline is taken. Then enter to his rescue Belarius, Guiderius and Arviragus."
    },
    {
      "id": "cymbeline-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "belarius",
        "name": "BELARIUS",
        "displayName": "Belarius"
      },
      "lines": [
        {
          "id": "cymbeline-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Stand, stand! We have th' advantage of the ground;",
          "plainText": "Stand stand We have th' advantage of the ground",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "The lane is guarded; nothing routs us but",
          "plainText": "The lane is guarded nothing routs us but",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "The villainy of our fears.",
          "plainText": "The villainy of our fears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-5-2-stage-004",
      "type": "stage",
      "text": "Enter Posthumus and seconds the Britons; they rescue Cymbeline and exeunt. Then re-enter Lucius and Iachimo with Imogen."
    },
    {
      "id": "cymbeline-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "cymbeline-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Away, boy, from the troops, and save thyself;",
          "plainText": "Away boy from the troops and save thyself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "For friends kill friends, and the disorder's such",
          "plainText": "For friends kill friends and the disorder's such",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "As war were hoodwink'd.",
          "plainText": "As war were hoodwink'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "iachimo",
        "name": "IACHIMO",
        "displayName": "Iachimo"
      },
      "lines": [
        {
          "id": "cymbeline-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "'Tis their fresh supplies.",
          "plainText": "'Tis their fresh supplies",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "cymbeline-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "It is a day turn'd strangely. Or betimes",
          "plainText": "It is a day turn'd strangely Or betimes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Let's reinforce or fly.",
          "plainText": "Let's reinforce or fly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-5-2-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}