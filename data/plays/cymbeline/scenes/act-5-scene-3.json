          "start": 6,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1217102,
        "end": 1217158,
        "line": 46026,
        "column": 1,
        "path": "chap07/p@168263",
        "anchor": "sceneV_7.3"
      },
      "speakerLabel": "LORD.",
      "attribution": {
        "status": "explicit",
