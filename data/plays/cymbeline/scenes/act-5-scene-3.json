    {
      "id": "cymbeline/sceneV_7.3/p@170825",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "POSTHUMUS.\n’Lack, to what end?\nWho dares not stand his foe I’ll be his friend;\nFor if he’ll do as he is made to do,\nI know he’ll quickly fly my friendship too.\nYou have put me into rhyme.",
      "separatorAfter": "\n\n",
      "spans": [],
