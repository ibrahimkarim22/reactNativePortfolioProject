      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CAPTAIN.\nGreat Jupiter be prais’d! Lucius is taken.\n’Tis thought the old man and his sons were angels.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
