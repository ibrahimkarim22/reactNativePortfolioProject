      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORD.\nWhere was this lane?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "cymbeline/sceneV_7.3/p@168263/line-1",
          "start": 0,
