      "id": "cymbeline/sceneV_7.3/p@170622",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "        ‘Two boys, an old man (twice a boy), a lane,\n        Preserv’d the Britons, was the Romans’ bane.’",
      "separatorAfter": "\n\n",
      "spans": [],
