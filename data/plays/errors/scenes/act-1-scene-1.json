    {
      "id": "errors/sceneI_5.1/p@3800",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nWell, Syracusian, say in brief the cause\nWhy thou departedst from thy native home,\nAnd for what cause thou cam’st to Ephesus.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
