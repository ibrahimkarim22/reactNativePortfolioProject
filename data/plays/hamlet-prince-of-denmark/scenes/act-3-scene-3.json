    {
      "id": "hamlet-prince-of-denmark/sceneIII_8.3/p@140194",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nArm you, I pray you, to this speedy voyage;\nFor we will fetters put upon this fear,\nWhich now goes too free-footed.\n",
