      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GUILDENSTERN.\nWe will ourselves provide.\nMost holy and religious fear it is\nTo keep those many many bodies safe\nThat live and feed upon your Majesty.\n",
      "separatorAfter": "\n\n",
      "spans": [],
