    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@159937",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN.\nTo draw apart the body he hath kill’d,\nO’er whom his very madness, like some ore\nAmong a mineral of metals base,\nShows itself pure. He weeps for what is done.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
