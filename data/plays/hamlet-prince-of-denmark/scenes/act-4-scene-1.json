          "start": 6,
          "end": 38,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@158978/line-3",
          "start": 39,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1423821,
        "end": 1423893,
        "line": 53696,
        "column": 1,
        "path": "chap08/p@158978",
        "anchor": "sceneIV_8.1"
      },
      "speakerLabel": "KING.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@159054",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN.\nMad as the sea and wind, when both contend\nWhich is the mightier. In his lawless fit\nBehind the arras hearing something stir,\nWhips out his rapier, cries ‘A rat, a rat!’\nAnd in this brainish apprehension kills\nThe unseen good old man.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@159054/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@159054/line-2",
          "start": 7,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@159054/line-3",
          "start": 50,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@159054/line-4",
          "start": 92,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@159054/line-5",
          "start": 133,
          "end": 176,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@159054/line-6",
          "start": 177,
          "end": 216,
          "sourceLineNumber": null
        },
        {
