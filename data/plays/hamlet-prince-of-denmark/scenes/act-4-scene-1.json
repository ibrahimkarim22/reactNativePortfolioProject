    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@158978",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nWhat, Gertrude? How does Hamlet?\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@158978/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
