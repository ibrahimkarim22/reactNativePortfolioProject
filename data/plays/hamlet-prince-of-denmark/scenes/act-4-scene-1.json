          "start": 242,
          "end": 242,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1423897,
        "end": 1424197,
        "line": 53701,
        "column": 1,
        "path": "chap08/p@159054",
        "anchor": "sceneIV_8.1"
