    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.1/p@160549",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Friends both, go join you with some further aid:\nHamlet in madness hath Polonius slain,\nAnd from his mother’s closet hath he dragg’d him.\nGo seek him out, speak fair, and bring the body\nInto the chapel. I pray you haste in this.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
