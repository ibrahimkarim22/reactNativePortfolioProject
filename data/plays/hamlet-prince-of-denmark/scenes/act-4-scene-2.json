    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@161968",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSENCRANTZ.\nWhat have you done, my lord, with the dead body?\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@161968/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@161968/line-2",
          "start": 13,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@161968/line-3",
          "start": 62,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1426811,
        "end": 1426906,
        "line": 53801,
        "column": 1,
        "path": "chap08/p@161968",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "ROSENCRANTZ.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162067",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HAMLET.\nCompounded it with dust, whereto ’tis kin.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162067/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162067/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162067/line-3",
          "start": 51,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1426910,
        "end": 1426994,
        "line": 53806,
        "column": 1,
        "path": "chap08/p@162067",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "HAMLET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162155",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSENCRANTZ.\nTell us where ’tis, that we may take it thence,\nAnd bear it to the chapel.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162155/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162155/line-2",
          "start": 13,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162155/line-3",
          "start": 61,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162155/line-4",
          "start": 88,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1426998,
        "end": 1427124,
        "line": 53811,
        "column": 1,
        "path": "chap08/p@162155",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "ROSENCRANTZ.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162285",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HAMLET.\nDo not believe it.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162285/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162285/line-2",
          "start": 8,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162285/line-3",
          "start": 27,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1427128,
        "end": 1427188,
        "line": 53817,
        "column": 1,
        "path": "chap08/p@162285",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "HAMLET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162349",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSENCRANTZ.\nBelieve what?\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162349/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162349/line-2",
          "start": 13,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162349/line-3",
          "start": 27,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1427192,
        "end": 1427252,
        "line": 53822,
        "column": 1,
        "path": "chap08/p@162349",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "ROSENCRANTZ.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162413",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HAMLET.\nThat I can keep your counsel, and not mine own. Besides, to be demanded of a sponge—what replication should be made by the son of a king?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162413/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162413/line-2",
          "start": 8,
          "end": 145,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1427256,
        "end": 1427432,
        "line": 53827,
        "column": 1,
        "path": "chap08/p@162413",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "HAMLET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162593",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSENCRANTZ.\nTake you me for a sponge, my lord?\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162593/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162593/line-2",
          "start": 13,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162593/line-3",
          "start": 48,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1427436,
        "end": 1427517,
        "line": 53833,
        "column": 1,
        "path": "chap08/p@162593",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "ROSENCRANTZ.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162678",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HAMLET.\nAy, sir; that soaks up the King’s countenance, his rewards, his authorities. But such officers do the King best service in the end: he keeps them, like an ape, in the corner of his jaw; first mouthed, to be last swallowed: when he needs what you have gleaned, it is but squeezing you, and, sponge, you shall be dry again.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162678/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@162678/line-2",
          "start": 8,
          "end": 329,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1427521,
        "end": 1427884,
        "line": 53838,
        "column": 1,
        "path": "chap08/p@162678",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "HAMLET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163045",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSENCRANTZ.\nI understand you not, my lord.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163045/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163045/line-2",
          "start": 13,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163045/line-3",
          "start": 44,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1427888,
        "end": 1427965,
        "line": 53847,
        "column": 1,
        "path": "chap08/p@163045",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "ROSENCRANTZ.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163126",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HAMLET.\nI am glad of it. A knavish speech sleeps in a foolish ear.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163126/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163126/line-2",
          "start": 8,
          "end": 66,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163126/line-3",
          "start": 67,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1427969,
        "end": 1428069,
        "line": 53852,
        "column": 1,
        "path": "chap08/p@163126",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "HAMLET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163230",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSENCRANTZ.\nMy lord, you must tell us where the body is and go with us to the King.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163230/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163230/line-2",
          "start": 13,
          "end": 84,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1428073,
        "end": 1428187,
        "line": 53857,
        "column": 1,
        "path": "chap08/p@163230",
        "anchor": "sceneIV_8.2"
      },
      "speakerLabel": "ROSENCRANTZ.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@163348",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
