      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "What have you done, my lord, with the dead body?",
          "plainText": "What have you done my lord with the dead body",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Compounded it with dust, whereto 'tis kin.",
          "plainText": "Compounded it with dust whereto 'tis kin",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "rosencrantz",
        "name": "ROSENCRANTZ",
        "displayName": "Rosencrantz"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Tell us where 'tis, that we may take it thence,",
          "plainText": "Tell us where 'tis that we may take it thence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "And bear it to the chapel.",
          "plainText": "And bear it to the chapel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Do not believe it.",
          "plainText": "Do not believe it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "rosencrantz",
        "name": "ROSENCRANTZ",
        "displayName": "Rosencrantz"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Believe what?",
          "plainText": "Believe what",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "That I can keep your counsel, and not mine own. Besides, to be demanded of a sponge—what replication should be made by the son of a king?",
          "plainText": "That I can keep your counsel and not mine own Besides to be demanded of a spongewhat replication should be made by the son of a king",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "rosencrantz",
        "name": "ROSENCRANTZ",
        "displayName": "Rosencrantz"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Take you me for a sponge, my lord?",
          "plainText": "Take you me for a sponge my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Ay, sir; that soaks up the King's countenance, his rewards, his authorities. But such officers do the King best service in the end: he keeps them, like an ape, in the corner of his jaw; first mouthed, to be last swallowed: when he needs what you have gleaned, it is but squeezing you, and, sponge, you shall be dry again.",
          "plainText": "Ay sir that soaks up the King's countenance his rewards his authorities But such officers do the King best service in the end he keeps them like an ape in the corner of his jaw first mouthed to be last swallowed when he needs what you have gleaned it is but squeezing you and sponge you shall be dry again",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "rosencrantz",
        "name": "ROSENCRANTZ",
        "displayName": "Rosencrantz"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "I understand you not, my lord.",
          "plainText": "I understand you not my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "I am glad of it. A knavish speech sleeps in a foolish ear.",
          "plainText": "I am glad of it A knavish speech sleeps in a foolish ear",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "rosencrantz",
        "name": "ROSENCRANTZ",
        "displayName": "Rosencrantz"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "My lord, you must tell us where the body is and go with us to the King.",
          "plainText": "My lord you must tell us where the body is and go with us to the King",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "The body is with the King, but the King is not with the body. The King is a thing—",
          "plainText": "The body is with the King but the King is not with the body The King is a thing",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "guildenstern",
        "name": "GUILDENSTERN",
        "displayName": "Guildenstern"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "A thing, my lord!",
          "plainText": "A thing my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Of nothing. Bring me to him. Hide fox, and all after.",
          "plainText": "Of nothing Bring me to him Hide fox and all after",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
