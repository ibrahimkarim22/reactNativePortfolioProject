    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@161743",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HAMLET.\nWhat noise? Who calls on Hamlet? O, here they come.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.2/p@161743/line-1",
