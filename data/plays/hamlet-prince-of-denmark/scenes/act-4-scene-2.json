    {
      "id": "hamlet-prince-of-denmark-4-2-stage-002",
      "type": "stage",
      "text": "Enter Rosencrantz and Guildenstern."
    },
    {
      "id": "hamlet-prince-of-denmark-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "rosencrantz",
