    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.3/p@167227",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HAMLET.\nI see a cherub that sees them. But, come; for England! Farewell, dear mother.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.3/p@167227/line-1",
