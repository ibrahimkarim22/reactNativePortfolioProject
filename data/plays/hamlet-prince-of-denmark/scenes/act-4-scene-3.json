      "id": "hamlet-prince-of-denmark/sceneIV_8.3/p@167346",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nThy loving father, Hamlet.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
