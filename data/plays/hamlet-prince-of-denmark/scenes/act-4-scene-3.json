    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.3/p@166622",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nHamlet, this deed, for thine especial safety,—\nWhich we do tender, as we dearly grieve\nFor that which thou hast done,—must send thee hence\nWith fiery quickness. Therefore prepare thyself;\nThe bark is ready, and the wind at help,\nTh’associates tend, and everything is bent\nFor England.\n",
      "separatorAfter": "\n\n",
      "spans": [],
