    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.3/p@167416",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HAMLET.\nMy mother. Father and mother is man and wife; man and wife is one flesh; and so, my mother. Come, for England.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.3/p@167416/line-1",
