    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.3/p@167612",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nFollow him at foot. Tempt him with speed aboard;\nDelay it not; I’ll have him hence tonight.\nAway, for everything is seal’d and done\nThat else leans on th’affair. Pray you make haste.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.3/p@167612/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
