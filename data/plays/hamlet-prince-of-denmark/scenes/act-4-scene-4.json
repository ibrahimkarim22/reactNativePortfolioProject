      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.4/p@170367/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
