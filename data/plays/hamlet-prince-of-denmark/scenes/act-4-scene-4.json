        "cueEnd": 7
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.4/p@170051",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPTAIN.\nTruly to speak, and with no addition,\nWe go to gain a little patch of ground\nThat hath in it no profit but the name.\nTo pay five ducats, five, I would not farm it;\nNor will it yield to Norway or the Pole\nA ranker rate, should it be sold in fee.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
