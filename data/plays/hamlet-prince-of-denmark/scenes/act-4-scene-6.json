          "start": 882,
          "end": 914,
          "sourceLineNumber": null
        },
        {
          "id": "hamlet-prince-of-denmark/sceneIV_8.6/p@187730/line-4",
          "start": 915,
          "end": 928,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1452573,
        "end": 1453559,
        "line": 54879,
        "column": 1,
        "path": "chap08/p@187730",
