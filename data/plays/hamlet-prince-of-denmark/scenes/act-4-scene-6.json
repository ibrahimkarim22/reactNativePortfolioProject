        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "hamlet-prince-of-denmark/sceneIV_8.6/p@188720",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Come, I will give you way for these your letters,\nAnd do’t the speedier, that you may direct me\nTo him from whom you brought them.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
