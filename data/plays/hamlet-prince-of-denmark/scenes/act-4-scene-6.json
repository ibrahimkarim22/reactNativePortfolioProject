      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "I do not know from what part of the world\nI should be greeted, if not from Lord Hamlet.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
