    {
      "id": "julius-caesar/sceneI_17.1/p@7306",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "See whether their basest metal be not mov’d;\nThey vanish tongue-tied in their guiltiness.\nGo you down that way towards the Capitol;\nThis way will I. Disrobe the images,\nIf you do find them deck’d with ceremonies.",
      "separatorAfter": "\n\n",
      "spans": [],
