    {
      "id": "julius-caesar/sceneI_17.1/p@7567",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARULLUS.\nMay we do so?\nYou know it is the feast of Lupercal.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneI_17.1/p@7567/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneI_17.1/p@7567/line-2",
          "start": 10,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneI_17.1/p@7567/line-3",
          "start": 24,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3017964,
        "end": 3018060,
        "line": 109230,
        "column": 1,
        "path": "chap17/p@7567",
        "anchor": "sceneI_17.1"
      },
      "speakerLabel": "MARULLUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneI_17.1/p@7667",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLAVIUS.\nIt is no matter; let no images\nBe hung with Caesar’s trophies. I’ll about\nAnd drive away the vulgar from the streets;\nSo do you too, where you perceive them thick.\nThese growing feathers pluck’d from Caesar’s wing\nWill make him fly an ordinary pitch,\nWho else would soar above the view of men,\nAnd keep us all in servile fearfulness.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
