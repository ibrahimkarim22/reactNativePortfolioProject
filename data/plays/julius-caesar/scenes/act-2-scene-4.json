      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nThou hast some suit to Caesar, hast thou not?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@68729/line-1",
          "start": 0,
