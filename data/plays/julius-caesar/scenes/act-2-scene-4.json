      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOOTHSAYER.\nAt mine own house, good lady.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@68321/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@68321/line-2",
          "start": 12,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3078718,
        "end": 3078789,
        "line": 111533,
        "column": 1,
        "path": "chap17/p@68321",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "SOOTHSAYER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "julius-caesar/sceneII_17.4/p@68396",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nWhat is’t o’clock?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@68396/line-1",
          "start": 0,
