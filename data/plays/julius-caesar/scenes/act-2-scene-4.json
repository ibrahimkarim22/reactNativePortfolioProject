        "end": 3079209,
        "line": 111559,
        "column": 1,
        "path": "chap17/p@68729",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneII_17.4/p@68816",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOOTHSAYER.\nThat I have, lady, if it will please Caesar\nTo be so good to Caesar as to hear me,\nI shall beseech him to befriend himself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@68816/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
