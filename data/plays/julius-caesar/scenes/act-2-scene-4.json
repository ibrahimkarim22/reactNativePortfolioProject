      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOOTHSAYER.\nAbout the ninth hour, lady.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@68456/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@68456/line-2",
          "start": 12,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3078853,
        "end": 3078922,
        "line": 111543,
        "column": 1,
        "path": "chap17/p@68456",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "SOOTHSAYER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "julius-caesar/sceneII_17.4/p@68529",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nIs Caesar yet gone to the Capitol?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@68529/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@68529/line-2",
          "start": 8,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3078926,
        "end": 3078998,
        "line": 111548,
        "column": 1,
        "path": "chap17/p@68529",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneII_17.4/p@68605",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOOTHSAYER.\nMadam, not yet. I go to take my stand,\nTo see him pass on to the Capitol.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@68605/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
