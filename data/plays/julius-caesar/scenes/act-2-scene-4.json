          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67110/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67110/line-3",
          "start": 52,
          "end": 100,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67110/line-4",
          "start": 101,
          "end": 146,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67110/line-5",
          "start": 147,
          "end": 194,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67110/line-6",
          "start": 195,
          "end": 236,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67110/line-7",
          "start": 237,
          "end": 278,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67110/line-8",
          "start": 279,
          "end": 297,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
