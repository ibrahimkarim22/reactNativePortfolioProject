      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nCome hither, fellow:\nWhich way hast thou been?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@68228/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@68228/line-2",
          "start": 8,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@68228/line-3",
          "start": 29,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
