          "start": 8,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67918/line-3",
          "start": 31,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67918/line-4",
          "start": 71,
          "end": 111,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3078315,
        "end": 3078466,
        "line": 111511,
        "column": 1,
        "path": "chap17/p@67918",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
