    {
      "id": "julius-caesar/sceneII_17.4/p@66888",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nI pr’ythee, boy, run to the Senate-house;\nStay not to answer me, but get thee gone.\nWhy dost thou stay?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@66888/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@66888/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@66888/line-3",
          "start": 50,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@66888/line-4",
          "start": 92,
          "end": 111,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3077285,
        "end": 3077436,
        "line": 111468,
        "column": 1,
        "path": "chap17/p@66888",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
