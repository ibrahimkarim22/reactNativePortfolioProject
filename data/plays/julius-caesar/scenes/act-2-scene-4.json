      }
    },
    {
      "id": "julius-caesar/sceneII_17.4/p@67043",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nTo know my errand, madam.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@67043/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67043/line-2",
          "start": 8,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3077440,
        "end": 3077503,
        "line": 111475,
        "column": 1,
        "path": "chap17/p@67043",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneII_17.4/p@67110",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nI would have had thee there and here again,\nEre I can tell thee what thou shouldst do there.\n[Aside.] O constancy, be strong upon my side,\nSet a huge mountain ’tween my heart and tongue!\nI have a man’s mind, but a woman’s might.\nHow hard it is for women to keep counsel!\nArt thou here yet?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 102,
          "end": 108
        }
      ],
      "lines": [
        {
