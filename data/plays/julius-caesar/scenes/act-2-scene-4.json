    {
      "id": "julius-caesar/sceneII_17.4/p@68995",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nWhy, know’st thou any harm’s intended towards him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@68995/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@68995/line-2",
          "start": 8,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3079392,
        "end": 3079480,
        "line": 111571,
        "column": 1,
        "path": "chap17/p@68995",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneII_17.4/p@69087",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOOTHSAYER.\nNone that I know will be, much that I fear may chance.\nGood morrow to you. Here the street is narrow.\nThe throng that follows Caesar at the heels,\nOf Senators, of Praetors, common suitors,\nWill crowd a feeble man almost to death:\nI’ll get me to a place more void, and there\nSpeak to great Caesar as he comes along.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
