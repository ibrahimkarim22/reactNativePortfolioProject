    {
      "id": "julius-caesar/sceneII_17.4/p@67478",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nMadam, what should I do?\nRun to the Capitol, and nothing else?\nAnd so return to you, and nothing else?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@67478/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67478/line-2",
          "start": 8,
          "end": 32,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67478/line-3",
          "start": 33,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67478/line-4",
          "start": 71,
          "end": 110,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3077875,
        "end": 3078025,
        "line": 111491,
        "column": 1,
        "path": "chap17/p@67478",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneII_17.4/p@67632",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nYes, bring me word, boy, if thy lord look well,\nFor he went sickly forth: and take good note\nWhat Caesar doth, what suitors press to him.\nHark, boy, what noise is that?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@67632/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67632/line-2",
          "start": 8,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67632/line-3",
          "start": 56,
          "end": 100,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67632/line-4",
          "start": 101,
          "end": 145,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67632/line-5",
          "start": 146,
          "end": 176,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3078029,
        "end": 3078250,
        "line": 111498,
        "column": 1,
        "path": "chap17/p@67632",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneII_17.4/p@67857",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nI hear none, madam.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@67857/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneII_17.4/p@67857/line-2",
          "start": 8,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3078254,
        "end": 3078311,
        "line": 111506,
        "column": 1,
        "path": "chap17/p@67857",
        "anchor": "sceneII_17.4"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneII_17.4/p@67918",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nPr’ythee, listen well.\nI heard a bustling rumour, like a fray,\nAnd the wind brings it from the Capitol.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneII_17.4/p@67918/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
