      "id": "julius-caesar/sceneIII_17.3/p@107244",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CINNA.\nWhat is my name? Whither am I going? Where do I dwell? Am I a married man or a bachelor? Then, to answer every man directly and briefly, wisely and truly. Wisely I say I am a bachelor.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIII_17.3/p@107244/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIII_17.3/p@107244/line-2",
          "start": 7,
          "end": 191,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3117641,
        "end": 3117864,
        "line": 113087,
        "column": 1,
        "path": "chap17/p@107244",
        "anchor": "sceneIII_17.3"
      },
      "speakerLabel": "CINNA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "julius-caesar/sceneIII_17.3/p@107471",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CITIZEN.\nThat’s as much as to say they are fools that marry; you’ll bear me a bang for that, I fear. Proceed, directly.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIII_17.3/p@107471/line-1",
