      "classes": [
        "drama"
      ],
      "text": "FOURTH CITIZEN.\nIt is no matter, his name’s Cinna; pluck but his name out of his heart, and turn him going.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
