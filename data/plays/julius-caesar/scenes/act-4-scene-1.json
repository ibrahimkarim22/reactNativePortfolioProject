    {
      "id": "julius-caesar/sceneIV_17.1/p@109575",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEPIDUS.\nUpon condition Publius shall not live,\nWho is your sister’s son, Mark Antony.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.1/p@109575/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@109575/line-2",
          "start": 9,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@109575/line-3",
          "start": 48,
          "end": 86,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3119972,
        "end": 3120093,
        "line": 113208,
        "column": 1,
        "path": "chap17/p@109575",
        "anchor": "sceneIV_17.1"
      },
      "speakerLabel": "LEPIDUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.1/p@109700",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nHe shall not live; look, with a spot I damn him.\nBut, Lepidus, go you to Caesar’s house;\nFetch the will hither, and we shall determine\nHow to cut off some charge in legacies.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
