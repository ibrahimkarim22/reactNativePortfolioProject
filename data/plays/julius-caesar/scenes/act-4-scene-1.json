        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.1/p@111024",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OCTAVIUS.\nYou may do your will;\nBut he’s a tried and valiant soldier.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.1/p@111024/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@111024/line-2",
          "start": 10,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@111024/line-3",
          "start": 32,
          "end": 69,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3121421,
        "end": 3121525,
        "line": 113265,
        "column": 1,
        "path": "chap17/p@111024",
        "anchor": "sceneIV_17.1"
      },
      "speakerLabel": "OCTAVIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.1/p@111132",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nSo is my horse, Octavius; and for that\nI do appoint him store of provender.\nIt is a creature that I teach to fight,\nTo wind, to stop, to run directly on,\nHis corporal motion govern’d by my spirit.\nAnd, in some taste, is Lepidus but so:\nHe must be taught, and train’d, and bid go forth:\nA barren-spirited fellow; one that feeds\nOn objects, arts, and imitations,\nWhich, out of use and stal’d by other men,\nBegin his fashion. Do not talk of him\nBut as a property. And now, Octavius,\nListen great things. Brutus and Cassius\nAre levying powers; we must straight make head.\nTherefore let our alliance be combin’d,\nOur best friends made, our means stretch’d;\nAnd let us presently go sit in council,\nHow covert matters may be best disclos’d,\nAnd open perils surest answered.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
