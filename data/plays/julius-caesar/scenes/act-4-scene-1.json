          "start": 57,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@109700/line-4",
          "start": 97,
          "end": 142,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@109700/line-5",
          "start": 143,
          "end": 182,
          "sourceLineNumber": null
        }
      ],
