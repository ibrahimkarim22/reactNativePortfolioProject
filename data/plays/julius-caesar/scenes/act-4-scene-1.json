    {
      "id": "julius-caesar/sceneIV_17.1/p@110154",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nThis is a slight unmeritable man,\nMeet to be sent on errands. Is it fit,\nThe three-fold world divided, he should stand\nOne of the three to share it?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.1/p@110154/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@110154/line-2",
          "start": 8,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@110154/line-3",
          "start": 42,
          "end": 80,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@110154/line-4",
          "start": 81,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@110154/line-5",
          "start": 127,
          "end": 156,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3120551,
        "end": 3120752,
        "line": 113236,
        "column": 1,
        "path": "chap17/p@110154",
        "anchor": "sceneIV_17.1"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.1/p@110359",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OCTAVIUS.\nSo you thought him,\nAnd took his voice who should be prick’d to die\nIn our black sentence and proscription.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.1/p@110359/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@110359/line-2",
          "start": 10,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@110359/line-3",
          "start": 30,
          "end": 77,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@110359/line-4",
          "start": 78,
          "end": 117,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3120756,
        "end": 3120913,
        "line": 113244,
        "column": 1,
        "path": "chap17/p@110359",
        "anchor": "sceneIV_17.1"
      },
      "speakerLabel": "OCTAVIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.1/p@110520",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nOctavius, I have seen more days than you;\nAnd though we lay these honours on this man,\nTo ease ourselves of divers sland’rous loads,\nHe shall but bear them as the ass bears gold,\nTo groan and sweat under the business,\nEither led or driven, as we point the way;\nAnd having brought our treasure where we will,\nThen take we down his load, and turn him off,\nLike to the empty ass, to shake his ears,\nAnd graze in commons.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.1/p@110520/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@110520/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
