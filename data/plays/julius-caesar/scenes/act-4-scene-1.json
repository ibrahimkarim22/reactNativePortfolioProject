          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.1/p@109700/line-2",
          "start": 8,
          "end": 56,
          "sourceLineNumber": null
        },
        {
