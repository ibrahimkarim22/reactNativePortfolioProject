      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCILIUS.\nGive the word, ho! and stand.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@112657/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@112657/line-2",
          "start": 10,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3123054,
        "end": 3123123,
        "line": 113318,
        "column": 1,
        "path": "chap17/p@112657",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "LUCILIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@112730",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nWhat now, Lucilius! is Cassius near?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@112730/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@112730/line-2",
          "start": 8,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3123127,
        "end": 3123201,
        "line": 113323,
        "column": 1,
        "path": "chap17/p@112730",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "BRUTUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@112808",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCILIUS.\nHe is at hand, and Pindarus is come\nTo do you salutation from his master.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@112808/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@112808/line-2",
          "start": 10,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@112808/line-3",
          "start": 46,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3123205,
        "end": 3123323,
        "line": 113328,
        "column": 1,
        "path": "chap17/p@112808",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "LUCILIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@112930",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Pindarus gives a letter to Brutus.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 1,
          "end": 9,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 28,
          "end": 34,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 35
        }
      ],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@112930/line-1",
          "start": 0,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3123327,
        "end": 3123455,
        "line": 113334,
        "column": 1,
        "path": "chap17/p@112930",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@113062",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nHe greets me well. Your master, Pindarus,\nIn his own change, or by ill officers,\nHath given me some worthy cause to wish\nThings done, undone: but, if he be at hand,\nI shall be satisfied.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@113062/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113062/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113062/line-3",
          "start": 50,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113062/line-4",
          "start": 89,
          "end": 128,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113062/line-5",
          "start": 129,
          "end": 172,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113062/line-6",
          "start": 173,
          "end": 194,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3123459,
        "end": 3123703,
        "line": 113338,
        "column": 1,
        "path": "chap17/p@113062",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "BRUTUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@113310",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PINDARUS.\nI do not doubt\nBut that my noble master will appear\nSuch as he is, full of regard and honour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@113310/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113310/line-2",
          "start": 10,
          "end": 24,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113310/line-3",
          "start": 25,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113310/line-4",
          "start": 62,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3123707,
        "end": 3123850,
        "line": 113347,
        "column": 1,
        "path": "chap17/p@113310",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "PINDARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@113457",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nHe is not doubted. A word, Lucilius;\nHow he received you, let me be resolv’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@113457/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113457/line-2",
          "start": 8,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113457/line-3",
          "start": 45,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3123854,
        "end": 3123974,
        "line": 113354,
        "column": 1,
        "path": "chap17/p@113457",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "BRUTUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@113581",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCILIUS.\nWith courtesy and with respect enough,\nBut not with such familiar instances,\nNor with such free and friendly conference,\nAs he hath us’d of old.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@113581/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113581/line-2",
          "start": 10,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113581/line-3",
          "start": 49,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113581/line-4",
          "start": 87,
          "end": 130,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113581/line-5",
          "start": 131,
          "end": 154,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3123978,
        "end": 3124177,
        "line": 113360,
        "column": 1,
        "path": "chap17/p@113581",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "LUCILIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@113784",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nThou hast describ’d\nA hot friend cooling. Ever note, Lucilius,\nWhen love begins to sicken and decay\nIt useth an enforced ceremony.\nThere are no tricks in plain and simple faith;\nBut hollow men, like horses hot at hand,\nMake gallant show and promise of their mettle;",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@113784/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113784/line-2",
          "start": 8,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113784/line-3",
          "start": 28,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113784/line-4",
          "start": 71,
          "end": 107,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113784/line-5",
          "start": 108,
          "end": 138,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113784/line-6",
          "start": 139,
          "end": 185,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113784/line-7",
          "start": 186,
          "end": 226,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@113784/line-8",
          "start": 227,
          "end": 273,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3124181,
        "end": 3124514,
        "line": 113368,
        "column": 1,
        "path": "chap17/p@113784",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "BRUTUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@114121",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Low march within.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 18
        }
      ],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@114121/line-1",
          "start": 0,
          "end": 19,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3124518,
        "end": 3124569,
        "line": 113379,
        "column": 1,
        "path": "chap17/p@114121",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@114176",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "But when they should endure the bloody spur,\nThey fall their crests, and like deceitful jades\nSink in the trial. Comes his army on?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@114176/line-1",
          "start": 0,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@114176/line-2",
          "start": 45,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@114176/line-3",
          "start": 94,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3124573,
        "end": 3124739,
        "line": 113383,
        "column": 1,
        "path": "chap17/p@114176",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@114346",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCILIUS.\nThey meant this night in Sardis to be quarter’d;\nThe greater part, the horse in general,\nAre come with Cassius.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@114346/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@114346/line-2",
          "start": 10,
          "end": 58,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@114346/line-3",
          "start": 59,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@114346/line-4",
          "start": 99,
          "end": 121,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3124743,
        "end": 3124904,
        "line": 113389,
        "column": 1,
        "path": "chap17/p@114346",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "LUCILIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@114511",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Cassius and Soldiers.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 18,
          "end": 26,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@114511/line-1",
          "start": 0,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3124908,
        "end": 3125024,
        "line": 113396,
        "column": 1,
        "path": "chap17/p@114511",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@114631",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nHark! he is arriv’d.\nMarch gently on to meet him.",
