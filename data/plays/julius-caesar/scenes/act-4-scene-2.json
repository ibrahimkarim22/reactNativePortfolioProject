      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Drum. Enter Brutus, Lucilius, Titinius and Soldiers; Pindarus meeting them; Lucius at some distance.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 12,
