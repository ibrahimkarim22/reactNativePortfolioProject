    {
      "id": "julius-caesar/sceneIV_17.2/p@112605",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nStand, ho!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@112605/line-1",
          "start": 0,
