    {
      "id": "julius-caesar/sceneIV_17.2/p@115020",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CASSIUS.\nMost noble brother, you have done me wrong.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@115020/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115020/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3125417,
        "end": 3125499,
        "line": 113431,
        "column": 1,
        "path": "chap17/p@115020",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "CASSIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@115106",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nJudge me, you gods; wrong I mine enemies?\nAnd if not so, how should I wrong a brother?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@115106/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115106/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115106/line-3",
          "start": 50,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3125503,
        "end": 3125632,
        "line": 113436,
        "column": 1,
        "path": "chap17/p@115106",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "BRUTUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@115239",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CASSIUS.\nBrutus, this sober form of yours hides wrongs;\nAnd when you do them—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@115239/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115239/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115239/line-3",
          "start": 56,
          "end": 77,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3125636,
        "end": 3125748,
        "line": 113442,
        "column": 1,
        "path": "chap17/p@115239",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "CASSIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@115355",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nCassius, be content.\nSpeak your griefs softly, I do know you well.\nBefore the eyes of both our armies here,\nWhich should perceive nothing but love from us,\nLet us not wrangle. Bid them move away;\nThen in my tent, Cassius, enlarge your griefs,\nAnd I will give you audience.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@115355/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115355/line-2",
          "start": 8,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115355/line-3",
          "start": 29,
          "end": 74,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115355/line-4",
          "start": 75,
          "end": 115,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115355/line-5",
          "start": 116,
          "end": 163,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115355/line-6",
          "start": 164,
          "end": 203,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115355/line-7",
          "start": 204,
          "end": 250,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115355/line-8",
          "start": 251,
          "end": 280,
          "sourceLineNumber": null
        }
      ],
