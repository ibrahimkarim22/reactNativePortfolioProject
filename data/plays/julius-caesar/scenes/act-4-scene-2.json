        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@115699",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CASSIUS.\nPindarus,\nBid our commanders lead their charges off\nA little from this ground.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneIV_17.2/p@115699/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115699/line-2",
          "start": 9,
          "end": 18,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115699/line-3",
          "start": 19,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneIV_17.2/p@115699/line-4",
          "start": 61,
          "end": 87,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3126096,
        "end": 3126223,
        "line": 113459,
        "column": 1,
        "path": "chap17/p@115699",
        "anchor": "sceneIV_17.2"
      },
      "speakerLabel": "CASSIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "julius-caesar/sceneIV_17.2/p@115830",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nLucilius, do you the like; and let no man\nCome to our tent till we have done our conference.\nLucius and Titinius, guard our door.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
