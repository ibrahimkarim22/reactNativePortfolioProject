    "label": "Act 5, Scene 3",
    "title": "SCENE III. Another part of the field.",
    "location": "Another part of the field.",
    "orderInPlay": 16
  },
  "content": [
    {
      "id": "julius-caesar-5-3-stage-001",
      "type": "stage",
      "text": "Alarum. Enter Cassius and Titinius."
    },
    {
      "id": "julius-caesar-5-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "O, look, Titinius, look, the villains fly!",
          "plainText": "O look Titinius look the villains fly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Myself have to mine own turn'd enemy:",
          "plainText": "Myself have to mine own turn'd enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "This ensign here of mine was turning back;",
          "plainText": "This ensign here of mine was turning back",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "I slew the coward, and did take it from him.",
          "plainText": "I slew the coward and did take it from him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "titinius",
        "name": "TITINIUS",
        "displayName": "Titinius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "O Cassius, Brutus gave the word too early,",
          "plainText": "O Cassius Brutus gave the word too early",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Who, having some advantage on Octavius,",
          "plainText": "Who having some advantage on Octavius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "Took it too eagerly: his soldiers fell to spoil,",
          "plainText": "Took it too eagerly his soldiers fell to spoil",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "Whilst we by Antony are all enclos'd.",
          "plainText": "Whilst we by Antony are all enclos'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-stage-002",
      "type": "stage",
      "text": "Enter Pindarus."
    },
    {
      "id": "julius-caesar-5-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "pindarus",
        "name": "PINDARUS",
        "displayName": "Pindarus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Fly further off, my lord, fly further off;",
          "plainText": "Fly further off my lord fly further off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Mark Antony is in your tents, my lord.",
          "plainText": "Mark Antony is in your tents my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Fly, therefore, noble Cassius, fly far off.",
          "plainText": "Fly therefore noble Cassius fly far off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "This hill is far enough. Look, look, Titinius;",
          "plainText": "This hill is far enough Look look Titinius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Are those my tents where I perceive the fire?",
          "plainText": "Are those my tents where I perceive the fire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "titinius",
        "name": "TITINIUS",
        "displayName": "Titinius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "They are, my lord.",
          "plainText": "They are my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Titinius, if thou lovest me,",
          "plainText": "Titinius if thou lovest me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Mount thou my horse and hide thy spurs in him,",
          "plainText": "Mount thou my horse and hide thy spurs in him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "Till he have brought thee up to yonder troops",
          "plainText": "Till he have brought thee up to yonder troops",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "And here again, that I may rest assur'd",
          "plainText": "And here again that I may rest assur'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0019",
          "number": 19,
          "speechLineNumber": 5,
          "text": "Whether yond troops are friend or enemy.",
          "plainText": "Whether yond troops are friend or enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "titinius",
        "name": "TITINIUS",
        "displayName": "Titinius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "I will be here again, even with a thought.",
          "plainText": "I will be here again even with a thought",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "julius-caesar-5-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Go, Pindarus, get higher on that hill,",
          "plainText": "Go Pindarus get higher on that hill",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "My sight was ever thick. Regard Titinius,",
          "plainText": "My sight was ever thick Regard Titinius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "And tell me what thou notest about the field.",
          "plainText": "And tell me what thou notest about the field",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-stage-004",
      "type": "stage",
      "text": "[Pindarus goes up.]"
    },
    {
      "id": "julius-caesar-5-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "pindarus",
        "name": "PINDARUS",
        "displayName": "Pindarus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "[Above.] O my lord!",
          "plainText": "Above O my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "What news?",
          "plainText": "What news",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "pindarus",
        "name": "PINDARUS",
        "displayName": "Pindarus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "[Above.] Titinius is enclosed round about",
          "plainText": "Above Titinius is enclosed round about",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "With horsemen, that make to him on the spur,",
          "plainText": "With horsemen that make to him on the spur",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "Yet he spurs on. Now they are almost on him.",
          "plainText": "Yet he spurs on Now they are almost on him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "Now, Titinius! Now some light. O, he lights too.",
          "plainText": "Now Titinius Now some light O he lights too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0030",
          "number": 30,
          "speechLineNumber": 5,
          "text": "He's ta'en!",
          "plainText": "He's ta'en",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-stage-005",
      "type": "stage",
      "text": "[Shout.]"
    },
    {
      "id": "julius-caesar-5-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Come down; behold no more.",
          "plainText": "Come down behold no more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "O, coward that I am, to live so long,",
          "plainText": "O coward that I am to live so long",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "To see my best friend ta'en before my face!",
          "plainText": "To see my best friend ta'en before my face",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-stage-006",
      "type": "stage",
      "text": "[Pindarus descends.]"
    },
    {
      "id": "julius-caesar-5-3-stage-007",
      "type": "stage",
      "text": "[Dies.]"
    },
    {
      "id": "julius-caesar-5-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "pindarus",
        "name": "PINDARUS",
        "displayName": "Pindarus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "So, I am free, yet would not so have been,",
          "plainText": "So I am free yet would not so have been",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Durst I have done my will. O Cassius!",
          "plainText": "Durst I have done my will O Cassius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Far from this country Pindarus shall run,",
          "plainText": "Far from this country Pindarus shall run",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "Where never Roman shall take note of him.",
          "plainText": "Where never Roman shall take note of him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-stage-008",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "julius-caesar-5-3-stage-009",
      "type": "stage",
      "text": "Enter Titinius with Messala."
    },
    {
      "id": "julius-caesar-5-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "It is but change, Titinius; for Octavius",
          "plainText": "It is but change Titinius for Octavius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "Is overthrown by noble Brutus' power,",
          "plainText": "Is overthrown by noble Brutus' power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "As Cassius' legions are by Antony.",
          "plainText": "As Cassius' legions are by Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "titinius",
        "name": "TITINIUS",
        "displayName": "Titinius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "These tidings would well comfort Cassius.",
          "plainText": "These tidings would well comfort Cassius",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Where did you leave him?",
          "plainText": "Where did you leave him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "titinius",
        "name": "TITINIUS",
        "displayName": "Titinius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "All disconsolate,",
          "plainText": "All disconsolate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "With Pindarus his bondman, on this hill.",
          "plainText": "With Pindarus his bondman on this hill",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Is not that he that lies upon the ground?",
          "plainText": "Is not that he that lies upon the ground",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "titinius",
        "name": "TITINIUS",
        "displayName": "Titinius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "He lies not like the living. O my heart!",
          "plainText": "He lies not like the living O my heart",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Is not that he?",
          "plainText": "Is not that he",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "titinius",
        "name": "TITINIUS",
        "displayName": "Titinius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "No, this was he, Messala,",
          "plainText": "No this was he Messala",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "But Cassius is no more. O setting sun,",
          "plainText": "But Cassius is no more O setting sun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "As in thy red rays thou dost sink to night,",
          "plainText": "As in thy red rays thou dost sink to night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "So in his red blood Cassius' day is set.",
          "plainText": "So in his red blood Cassius' day is set",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0052",
          "number": 52,
          "speechLineNumber": 5,
          "text": "The sun of Rome is set. Our day is gone;",
          "plainText": "The sun of Rome is set Our day is gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0053",
          "number": 53,
          "speechLineNumber": 6,
          "text": "Clouds, dews, and dangers come; our deeds are done.",
          "plainText": "Clouds dews and dangers come our deeds are done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0054",
          "number": 54,
          "speechLineNumber": 7,
          "text": "Mistrust of my success hath done this deed.",
          "plainText": "Mistrust of my success hath done this deed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Mistrust of good success hath done this deed.",
          "plainText": "Mistrust of good success hath done this deed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "O hateful Error, Melancholy's child!",
          "plainText": "O hateful Error Melancholy's child",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "Why dost thou show to the apt thoughts of men",
          "plainText": "Why dost thou show to the apt thoughts of men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0058",
          "number": 58,
          "speechLineNumber": 4,
          "text": "The things that are not? O Error, soon conceiv'd,",
          "plainText": "The things that are not O Error soon conceiv'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0059",
          "number": 59,
          "speechLineNumber": 5,
          "text": "Thou never com'st unto a happy birth,",
          "plainText": "Thou never com'st unto a happy birth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0060",
          "number": 60,
          "speechLineNumber": 6,
          "text": "But kill'st the mother that engender'd thee!",
          "plainText": "But kill'st the mother that engender'd thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "titinius",
        "name": "TITINIUS",
        "displayName": "Titinius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "What, Pindarus! where art thou, Pindarus?",
          "plainText": "What Pindarus where art thou Pindarus",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Seek him, Titinius, whilst I go to meet",
          "plainText": "Seek him Titinius whilst I go to meet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "The noble Brutus, thrusting this report",
          "plainText": "The noble Brutus thrusting this report",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "Into his ears. I may say thrusting it;",
          "plainText": "Into his ears I may say thrusting it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "For piercing steel and darts envenomed",
          "plainText": "For piercing steel and darts envenomed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0066",
          "number": 66,
          "speechLineNumber": 5,
          "text": "Shall be as welcome to the ears of Brutus",
          "plainText": "Shall be as welcome to the ears of Brutus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0067",
          "number": 67,
          "speechLineNumber": 6,
          "text": "As tidings of this sight.",
          "plainText": "As tidings of this sight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "titinius",
        "name": "TITINIUS",
        "displayName": "Titinius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Hie you, Messala,",
          "plainText": "Hie you Messala",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "And I will seek for Pindarus the while.",
          "plainText": "And I will seek for Pindarus the while",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-stage-010",
      "type": "stage",
      "text": "[Exit Messala.]"
    },
    {
      "id": "julius-caesar-5-3-stage-011",
      "type": "stage",
      "text": "[Dies.]"
    },
    {
      "id": "julius-caesar-5-3-stage-012",
      "type": "stage",
      "text": "Alarum. Enter Brutus, Messala, young Cato, Strato, Volumnius and Lucilius."
    },
    {
      "id": "julius-caesar-5-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Where, where, Messala, doth his body lie?",
          "plainText": "Where where Messala doth his body lie",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Lo, yonder, and Titinius mourning it.",
          "plainText": "Lo yonder and Titinius mourning it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Titinius' face is upward.",
          "plainText": "Titinius' face is upward",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "cato",
        "name": "CATO",
        "displayName": "Cato"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "He is slain.",
          "plainText": "He is slain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "O Julius Caesar, thou art mighty yet!",
          "plainText": "O Julius Caesar thou art mighty yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "Thy spirit walks abroad, and turns our swords",
          "plainText": "Thy spirit walks abroad and turns our swords",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "In our own proper entrails.",
          "plainText": "In our own proper entrails",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-stage-013",
      "type": "stage",
      "text": "[Low alarums.]"
    },
    {
      "id": "julius-caesar-5-3-speech-031",
      "type": "speech",
      "speaker": {
        "id": "cato",
        "name": "CATO",
        "displayName": "Cato"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Brave Titinius!",
          "plainText": "Brave Titinius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "Look whether he have not crown'd dead Cassius!",
          "plainText": "Look whether he have not crown'd dead Cassius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-speech-032",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-3-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Are yet two Romans living such as these?",
          "plainText": "Are yet two Romans living such as these",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0080",
          "number": 80,
          "speechLineNumber": 2,
          "text": "The last of all the Romans, fare thee well!",
          "plainText": "The last of all the Romans fare thee well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0081",
          "number": 81,
          "speechLineNumber": 3,
          "text": "It is impossible that ever Rome",
          "plainText": "It is impossible that ever Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0082",
          "number": 82,
          "speechLineNumber": 4,
          "text": "Should breed thy fellow. Friends, I owe more tears",
          "plainText": "Should breed thy fellow Friends I owe more tears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0083",
          "number": 83,
          "speechLineNumber": 5,
          "text": "To this dead man than you shall see me pay.",
          "plainText": "To this dead man than you shall see me pay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0084",
          "number": 84,
          "speechLineNumber": 6,
          "text": "I shall find time, Cassius, I shall find time.",
          "plainText": "I shall find time Cassius I shall find time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0085",
          "number": 85,
          "speechLineNumber": 7,
          "text": "Come therefore, and to Thassos send his body.",
          "plainText": "Come therefore and to Thassos send his body",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0086",
          "number": 86,
          "speechLineNumber": 8,
          "text": "His funerals shall not be in our camp,",
          "plainText": "His funerals shall not be in our camp",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0087",
          "number": 87,
          "speechLineNumber": 9,
          "text": "Lest it discomfort us. Lucilius, come;",
          "plainText": "Lest it discomfort us Lucilius come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0088",
          "number": 88,
          "speechLineNumber": 10,
          "text": "And come, young Cato; let us to the field.",
          "plainText": "And come young Cato let us to the field",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0089",
          "number": 89,
          "speechLineNumber": 11,
          "text": "Labeo and Flavius, set our battles on.",
          "plainText": "Labeo and Flavius set our battles on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0090",
          "number": 90,
          "speechLineNumber": 12,
          "text": "'Tis three o'clock; and Romans, yet ere night",
          "plainText": "'Tis three o'clock and Romans yet ere night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-5-3-line-0091",
          "number": 91,
          "speechLineNumber": 13,
          "text": "We shall try fortune in a second fight.",
          "plainText": "We shall try fortune in a second fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-5-3-stage-014",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}