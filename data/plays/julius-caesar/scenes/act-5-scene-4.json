      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 12,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@156058/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3166455,
        "end": 3166527,
        "line": 115282,
        "column": 1,
        "path": "chap17/p@156058",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@156134",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Brutus is ta’en, Brutus is ta’en, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@156134/line-1",
          "start": 0,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3166531,
        "end": 3166598,
        "line": 115286,
        "column": 1,
        "path": "chap17/p@156134",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@156205",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONY.\nWhere is he?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@156205/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@156205/line-2",
          "start": 8,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3166602,
        "end": 3166652,
        "line": 115290,
        "column": 1,
        "path": "chap17/p@156205",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": "ANTONY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@156259",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCILIUS.\nSafe, Antony; Brutus is safe enough.\nI dare assure thee that no enemy\nShall ever take alive the noble Brutus.\nThe gods defend him from so great a shame!\nWhen you do find him, or alive or dead,\nHe will be found like Brutus, like himself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@156259/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@156259/line-2",
          "start": 10,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@156259/line-3",
          "start": 47,
          "end": 79,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@156259/line-4",
          "start": 80,
          "end": 119,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@156259/line-5",
          "start": 120,
          "end": 162,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@156259/line-6",
          "start": 163,
          "end": 202,
          "sourceLineNumber": null
