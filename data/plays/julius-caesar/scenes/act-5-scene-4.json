          "start": 10,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@155051/line-3",
          "start": 45,
          "end": 93,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3165448,
        "end": 3165576,
        "line": 115230,
        "column": 1,
        "path": "chap17/p@155051",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": "LUCILIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@155183",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit, charging the enemy. Cato is overpowered, and falls.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 27,
          "end": 31,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 58
        }
      ],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@155183/line-1",
          "start": 0,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
