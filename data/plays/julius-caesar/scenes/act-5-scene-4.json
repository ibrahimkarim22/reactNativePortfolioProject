    {
      "id": "julius-caesar/sceneV_17.4/p@155051",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCILIUS.\nAnd I am Brutus, Marcus Brutus, I;\nBrutus, my country’s friend; know me for Brutus!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@155051/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
