    },
    {
      "id": "julius-caesar/sceneV_17.4/p@154657",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BRUTUS.\nYet, countrymen, O, yet hold up your heads!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@154657/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@154657/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3165054,
        "end": 3165135,
        "line": 115212,
        "column": 1,
        "path": "chap17/p@154657",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": "BRUTUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@154742",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CATO.\nWhat bastard doth not? Who will go with me?\nI will proclaim my name about the field.\nI am the son of Marcus Cato, ho!\nA foe to tyrants, and my country’s friend.\nI am the son of Marcus Cato, ho!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@154742/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@154742/line-2",
          "start": 6,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@154742/line-3",
          "start": 50,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@154742/line-4",
          "start": 91,
          "end": 123,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@154742/line-5",
          "start": 124,
          "end": 166,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@154742/line-6",
          "start": 167,
          "end": 199,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3165139,
        "end": 3165388,
        "line": 115217,
        "column": 1,
        "path": "chap17/p@154742",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": "CATO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
