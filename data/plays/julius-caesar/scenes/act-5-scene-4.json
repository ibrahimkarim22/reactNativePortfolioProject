        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@155486",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SOLDIER.\nYield, or thou diest.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@155486/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@155486/line-2",
          "start": 15,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3165883,
        "end": 3165949,
        "line": 115248,
        "column": 1,
        "path": "chap17/p@155486",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": "FIRST SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@155556",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCILIUS.\nOnly I yield to die:\nThere is so much that thou wilt kill me straight;",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@155556/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@155556/line-2",
          "start": 10,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@155556/line-3",
          "start": 31,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3165953,
        "end": 3166068,
        "line": 115253,
        "column": 1,
        "path": "chap17/p@155556",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": "LUCILIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@155675",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Offering money]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 15
        }
      ],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@155675/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3166072,
        "end": 3166120,
        "line": 115259,
        "column": 1,
        "path": "chap17/p@155675",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@155727",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Kill Brutus, and be honour’d in his death.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@155727/line-1",
          "start": 0,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3166124,
        "end": 3166191,
        "line": 115263,
        "column": 1,
        "path": "chap17/p@155727",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@155798",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SOLDIER.\nWe must not. A noble prisoner!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@155798/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@155798/line-2",
          "start": 15,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3166195,
        "end": 3166270,
        "line": 115267,
        "column": 1,
        "path": "chap17/p@155798",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": "FIRST SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@155877",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SOLDIER.\nRoom, ho! Tell Antony, Brutus is ta’en.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@155877/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@155877/line-2",
          "start": 16,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3166274,
        "end": 3166359,
        "line": 115272,
        "column": 1,
        "path": "chap17/p@155877",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": "SECOND SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@155966",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SOLDIER.\nI’ll tell the news. Here comes the General.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@155966/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@155966/line-2",
          "start": 15,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3166363,
        "end": 3166451,
        "line": 115277,
        "column": 1,
        "path": "chap17/p@155966",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": "FIRST SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
