        "end": 3165702,
        "line": 115236,
        "column": 1,
        "path": "chap17/p@155183",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "julius-caesar/sceneV_17.4/p@155309",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCILIUS.\nO young and noble Cato, art thou down?\nWhy, now thou diest as bravely as Titinius,\nAnd mayst be honour’d, being Cato’s son.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "julius-caesar/sceneV_17.4/p@155309/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@155309/line-2",
          "start": 10,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@155309/line-3",
          "start": 49,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "julius-caesar/sceneV_17.4/p@155309/line-4",
          "start": 93,
          "end": 133,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3165706,
        "end": 3165879,
        "line": 115241,
        "column": 1,
        "path": "chap17/p@155309",
        "anchor": "sceneV_17.4"
      },
      "speakerLabel": "LUCILIUS.",
      "attribution": {
        "status": "explicit",
