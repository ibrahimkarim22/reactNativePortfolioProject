      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Lord Chamberlain  and Lord Sandys.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 23,
          "className": "charname"
        },
        {
          "tag": "span",
