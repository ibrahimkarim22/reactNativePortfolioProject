          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2694974,
        "end": 2695100,
        "line": 98054,
        "column": 1,
        "path": "chap15/p@33609",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@33739",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nIs’t possible the spells of France should juggle\nMen into such strange mysteries?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@33739/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@33739/line-2",
          "start": 13,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@33739/line-3",
          "start": 62,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2695104,
        "end": 2695233,
        "line": 98057,
        "column": 1,
        "path": "chap15/p@33739",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@33872",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SANDYS.\nNew customs,\nThough they be never so ridiculous—\nNay, let ’em be unmanly—yet are followed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@33872/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@33872/line-2",
          "start": 8,
          "end": 20,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@33872/line-3",
          "start": 21,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@33872/line-4",
          "start": 57,
          "end": 98,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2695237,
        "end": 2695375,
        "line": 98063,
        "column": 1,
        "path": "chap15/p@33872",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "SANDYS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@34014",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nAs far as I see, all the good our English\nHave got by the late voyage is but merely\nA fit or two o’ th’ face; but they are shrewd ones,\nFor when they hold ’em, you would swear directly\nTheir very noses had been counsellors\nTo Pepin or Clotharius, they keep state so.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34014/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34014/line-2",
          "start": 13,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34014/line-3",
          "start": 55,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34014/line-4",
          "start": 97,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34014/line-5",
          "start": 149,
          "end": 197,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34014/line-6",
          "start": 198,
          "end": 235,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34014/line-7",
          "start": 236,
          "end": 279,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2695379,
        "end": 2695713,
        "line": 98070,
        "column": 1,
        "path": "chap15/p@34014",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@34352",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SANDYS.\nThey have all new legs, and lame ones. One would take it,\nThat never saw ’em pace before, the spavin\nOr springhalt reigned among ’em.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34352/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34352/line-2",
          "start": 8,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34352/line-3",
          "start": 66,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34352/line-4",
          "start": 109,
          "end": 141,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2695717,
        "end": 2695898,
        "line": 98080,
        "column": 1,
        "path": "chap15/p@34352",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "SANDYS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@34537",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nDeath! My lord,\nTheir clothes are after such a pagan cut to’t,\nThat, sure, they’ve worn out Christendom.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34537/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34537/line-2",
          "start": 13,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34537/line-3",
          "start": 29,
          "end": 75,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34537/line-4",
          "start": 76,
          "end": 117,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2695902,
        "end": 2696059,
        "line": 98087,
        "column": 1,
        "path": "chap15/p@34537",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@34698",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Sir Thomas Lovell.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 23,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34698/line-1",
          "start": 0,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2696063,
        "end": 2696142,
        "line": 98094,
        "column": 1,
        "path": "chap15/p@34698",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@34781",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "How now?\nWhat news, Sir Thomas Lovell?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34781/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34781/line-2",
          "start": 9,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2696146,
        "end": 2696214,
        "line": 98096,
        "column": 1,
        "path": "chap15/p@34781",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@34853",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LOVELL.\nFaith, my lord,\nI hear of none but the new proclamation\nThat’s clapped upon the court gate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34853/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34853/line-2",
          "start": 8,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34853/line-3",
          "start": 24,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34853/line-4",
          "start": 64,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2696218,
        "end": 2696357,
        "line": 98101,
        "column": 1,
        "path": "chap15/p@34853",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "LOVELL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@34996",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nWhat is’t for?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34996/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@34996/line-2",
          "start": 13,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2696361,
        "end": 2696418,
        "line": 98108,
        "column": 1,
        "path": "chap15/p@34996",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@35057",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LOVELL.\nThe reformation of our travelled gallants\nThat fill the court with quarrels, talk, and tailors.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@35057/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@35057/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@35057/line-3",
          "start": 50,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2696422,
        "end": 2696560,
        "line": 98113,
        "column": 1,
        "path": "chap15/p@35057",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "LOVELL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@35199",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nI’m glad ’tis there. Now I would pray our monsieurs\nTo think an English courtier may be wise\nAnd never see the Louvre.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@35199/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@35199/line-2",
          "start": 13,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@35199/line-3",
          "start": 65,
          "end": 105,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@35199/line-4",
          "start": 106,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2696564,
        "end": 2696735,
        "line": 98119,
        "column": 1,
        "path": "chap15/p@35199",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@35374",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LOVELL.\nThey must either,\nFor so run the conditions, leave those remnants\nOf fool and feather that they got in France,\nWith all their honourable points of ignorance\nPertaining thereunto, as fights and fireworks,\nAbusing better men than they can be\nOut of a foreign wisdom, renouncing clean\nThe faith they have in tennis and tall stockings,\nShort blistered breeches, and those types of travel,\nAnd understand again like honest men,\nOr pack to their old playfellows. There, I take it,\nThey may, cum privilegio, oui away\nThe lag end of their lewdness and be laughed at.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 493,
          "end": 512
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@35374/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
