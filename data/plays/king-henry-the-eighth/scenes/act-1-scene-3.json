        "drama"
      ],
      "text": "SANDYS.\n’Tis time to give ’em physic, their diseases\nAre grown so catching.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36041/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36041/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36041/line-3",
          "start": 53,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2697406,
        "end": 2697516,
        "line": 98143,
        "column": 1,
        "path": "chap15/p@36041",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "SANDYS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@36155",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nWhat a loss our ladies\nWill have of these trim vanities!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36155/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36155/line-2",
          "start": 13,
          "end": 35,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36155/line-3",
          "start": 36,
          "end": 69,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2697520,
        "end": 2697624,
        "line": 98149,
        "column": 1,
        "path": "chap15/p@36155",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@36263",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LOVELL.\nAy, marry,\nThere will be woe indeed, lords. The sly whoresons\nHave got a speeding trick to lay down ladies.\nA French song and a fiddle has no fellow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36263/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36263/line-2",
          "start": 8,
          "end": 18,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36263/line-3",
          "start": 19,
          "end": 69,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36263/line-4",
          "start": 70,
          "end": 115,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36263/line-5",
          "start": 116,
          "end": 157,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2697628,
        "end": 2697830,
        "line": 98155,
        "column": 1,
        "path": "chap15/p@36263",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "LOVELL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@36469",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SANDYS.\nThe devil fiddle ’em! I am glad they are going,\nFor sure, there’s no converting of ’em. Now\nAn honest country lord, as I am, beaten\nA long time out of play, may bring his plainsong\nAnd have an hour of hearing, and, by ’r Lady,\nHeld current music too.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36469/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36469/line-2",
          "start": 8,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36469/line-3",
          "start": 56,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36469/line-4",
          "start": 100,
          "end": 139,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36469/line-5",
          "start": 140,
          "end": 188,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36469/line-6",
          "start": 189,
          "end": 234,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36469/line-7",
          "start": 235,
          "end": 258,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2697834,
        "end": 2698147,
        "line": 98163,
        "column": 1,
        "path": "chap15/p@36469",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "SANDYS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@36786",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nWell said, Lord Sandys.\nYour colt’s tooth is not cast yet.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36786/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36786/line-2",
          "start": 13,
          "end": 36,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36786/line-3",
          "start": 37,
          "end": 71,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2698151,
        "end": 2698257,
        "line": 98173,
        "column": 1,
        "path": "chap15/p@36786",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@36896",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SANDYS.\nNo, my lord,\nNor shall not while I have a stump.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36896/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36896/line-2",
          "start": 8,
          "end": 20,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36896/line-3",
          "start": 21,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2698261,
        "end": 2698352,
        "line": 98179,
        "column": 1,
        "path": "chap15/p@36896",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "SANDYS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@36991",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nSir Thomas,\nWhither were you a-going?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36991/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36991/line-2",
          "start": 13,
          "end": 24,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@36991/line-3",
          "start": 25,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2698356,
        "end": 2698441,
        "line": 98185,
        "column": 1,
        "path": "chap15/p@36991",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@37080",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LOVELL.\nTo the Cardinal’s.\nYour lordship is a guest too.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37080/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37080/line-2",
          "start": 8,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37080/line-3",
          "start": 27,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2698445,
        "end": 2698536,
        "line": 98191,
        "column": 1,
        "path": "chap15/p@37080",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "LOVELL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@37175",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nO, ’tis true.\nThis night he makes a supper, and a great one,\nTo many lords and ladies. There will be\nThe beauty of this kingdom, I’ll assure you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37175/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37175/line-2",
          "start": 13,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37175/line-3",
          "start": 27,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37175/line-4",
          "start": 74,
          "end": 113,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37175/line-5",
          "start": 114,
          "end": 158,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2698540,
        "end": 2698743,
        "line": 98197,
        "column": 1,
        "path": "chap15/p@37175",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@37382",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LOVELL.\nThat churchman bears a bounteous mind indeed,\nA hand as fruitful as the land that feeds us.\nHis dews fall everywhere.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37382/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37382/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37382/line-3",
          "start": 54,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37382/line-4",
          "start": 100,
          "end": 125,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2698747,
        "end": 2698912,
        "line": 98205,
        "column": 1,
        "path": "chap15/p@37382",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "LOVELL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@37551",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nNo doubt he’s noble;\nHe had a black mouth that said other of him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37551/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37551/line-2",
          "start": 13,
          "end": 33,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37551/line-3",
          "start": 34,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2698916,
        "end": 2699029,
        "line": 98212,
        "column": 1,
        "path": "chap15/p@37551",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@37668",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SANDYS.\nHe may, my lord; has wherewithal. In him\nSparing would show a worse sin than ill doctrine.\nMen of his way should be most liberal;\nThey are set here for examples.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37668/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37668/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37668/line-3",
          "start": 49,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37668/line-4",
          "start": 99,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37668/line-5",
          "start": 138,
          "end": 169,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2699033,
        "end": 2699247,
        "line": 98218,
        "column": 1,
        "path": "chap15/p@37668",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "SANDYS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@37886",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nTrue, they are so,\nBut few now give so great ones. My barge stays.\nYour lordship shall along. Come, good Sir Thomas,\nWe shall be late else, which I would not be,\nFor I was spoke to, with Sir Henry Guildford,\nThis night to be comptrollers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37886/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37886/line-2",
          "start": 13,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37886/line-3",
          "start": 32,
          "end": 79,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37886/line-4",
          "start": 80,
          "end": 129,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37886/line-5",
          "start": 130,
          "end": 174,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37886/line-6",
          "start": 175,
          "end": 220,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@37886/line-7",
          "start": 221,
          "end": 251,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2699251,
        "end": 2699557,
        "line": 98226,
        "column": 1,
        "path": "chap15/p@37886",
        "anchor": "sceneI_15.3"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@38196",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SANDYS.\nI am your lordship’s.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@38196/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneI_15.3/p@38196/line-2",
          "start": 8,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
