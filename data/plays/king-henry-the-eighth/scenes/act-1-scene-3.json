        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-eighth/sceneI_15.3/p@38259",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt.]",
      "separatorAfter": "\n\n",
