    },
    {
      "id": "king-henry-the-eighth/sceneV_15.3/p@183795",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nAs I live,\nIf the King blame me for’t, I’ll lay ye all\nBy th’ heels, and suddenly, and on your heads\nClap round fines for neglect. You’re lazy knaves,\nAnd here ye lie baiting of bombards, when\nYe should do service. Hark, the trumpets sound!\nThey’re come already from the christening.\nGo break among the press, and find a way out\nTo let the troops pass fairly, or I’ll find\nA Marshalsea shall hold ye play these two months.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
