    {
      "id": "king-henry-the-eighth/sceneV_15.3/p@183609",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTER.\nAn’t please your honour,\nWe are but men; and what so many may do,\nNot being torn a-pieces, we have done.\nAn army cannot rule ’em.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-eighth/sceneV_15.3/p@183609/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneV_15.3/p@183609/line-2",
          "start": 8,
          "end": 32,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneV_15.3/p@183609/line-3",
          "start": 33,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneV_15.3/p@183609/line-4",
          "start": 74,
          "end": 112,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-eighth/sceneV_15.3/p@183609/line-5",
          "start": 113,
          "end": 137,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2844974,
        "end": 2845156,
        "line": 103377,
        "column": 1,
        "path": "chap15/p@183609",
