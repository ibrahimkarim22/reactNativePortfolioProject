      "id": "king-henry-the-eighth/sceneV_15.4/p@186455",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nMy noble gossips, you’ve have been too prodigal.\nI thank ye heartily; so shall this lady,\nWhen she has so much English.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
