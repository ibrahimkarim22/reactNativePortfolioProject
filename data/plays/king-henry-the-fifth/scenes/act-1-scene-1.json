    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@10128",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ELY.\nThe strawberry grows underneath the nettle,\nAnd wholesome berries thrive and ripen best\nNeighboured by fruit of baser quality;\nAnd so the Prince obscured his contemplation\nUnder the veil of wildness, which, no doubt,\nGrew like the summer grass, fastest by night,\nUnseen, yet crescive in his faculty.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10128/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10128/line-2",
          "start": 5,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10128/line-3",
          "start": 49,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10128/line-4",
          "start": 93,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10128/line-5",
          "start": 132,
          "end": 176,
          "sourceLineNumber": null
        },
        {
