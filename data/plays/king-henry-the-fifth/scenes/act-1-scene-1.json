    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@10480",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "CANTERBURY.\nIt must be so, for miracles are ceased,\nAnd therefore we must needs admit the means\nHow things are perfected.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10480/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10480/line-2",
          "start": 12,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10480/line-3",
          "start": 52,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10480/line-4",
          "start": 96,
          "end": 121,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1909909,
        "end": 1910054,
        "line": 71336,
        "column": 1,
        "path": "chap11/p@10480",
        "anchor": "sceneI_11.1"
      },
      "speakerLabel": "CANTERBURY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@10629",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ELY.\nBut, my good lord,\nHow now for mitigation of this bill\nUrged by the Commons? Doth his Majesty\nIncline to it, or no?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10629/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10629/line-2",
          "start": 5,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10629/line-3",
          "start": 24,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10629/line-4",
          "start": 60,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10629/line-5",
          "start": 99,
          "end": 120,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1910058,
        "end": 1910207,
        "line": 71342,
        "column": 1,
        "path": "chap11/p@10629",
        "anchor": "sceneI_11.1"
      },
      "speakerLabel": "ELY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@10782",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "CANTERBURY.\nHe seems indifferent,\nOr rather swaying more upon our part\nThan cherishing th’ exhibitors against us;\nFor I have made an offer to his Majesty,\nUpon our spiritual convocation\nAnd in regard of causes now in hand,\nWhich I have opened to his Grace at large,\nAs touching France, to give a greater sum\nThan ever at one time the clergy yet\nDid to his predecessors part withal.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10782/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10782/line-2",
          "start": 12,
          "end": 33,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10782/line-3",
          "start": 34,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10782/line-4",
          "start": 71,
          "end": 113,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10782/line-5",
          "start": 114,
          "end": 154,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10782/line-6",
          "start": 155,
          "end": 185,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10782/line-7",
          "start": 186,
          "end": 222,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10782/line-8",
          "start": 223,
          "end": 265,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10782/line-9",
          "start": 266,
          "end": 307,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@10782/line-10",
          "start": 308,
          "end": 344,
          "sourceLineNumber": null
