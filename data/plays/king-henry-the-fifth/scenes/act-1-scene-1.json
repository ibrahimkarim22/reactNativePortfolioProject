    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@7137",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "CANTERBURY.\nMy lord, I’ll tell you, that self bill is urg’d\nWhich in the eleventh year of the last king’s reign\nWas like, and had indeed against us passed\nBut that the scambling and unquiet time\nDid push it out of farther question.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
