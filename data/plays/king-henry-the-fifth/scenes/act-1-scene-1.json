    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@7406",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ELY.\nBut how, my lord, shall we resist it now?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@7406/line-1",
