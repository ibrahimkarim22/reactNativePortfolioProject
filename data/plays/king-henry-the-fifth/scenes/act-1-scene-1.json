          "start": 345,
          "end": 381,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1910211,
        "end": 1910651,
        "line": 71349,
        "column": 1,
        "path": "chap11/p@10782",
        "anchor": "sceneI_11.1"
      },
      "speakerLabel": "CANTERBURY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
