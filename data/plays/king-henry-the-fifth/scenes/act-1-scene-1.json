    },
    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@11226",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ELY.\nHow did this offer seem received, my lord?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11226/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11226/line-2",
          "start": 5,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1910655,
        "end": 1910716,
        "line": 71362,
        "column": 1,
        "path": "chap11/p@11226",
        "anchor": "sceneI_11.1"
      },
      "speakerLabel": "ELY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@11291",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "CANTERBURY.\nWith good acceptance of his Majesty;\nSave that there was not time enough to hear,\nAs I perceived his Grace would fain have done,\nThe severals and unhidden passages\nOf his true titles to some certain dukedoms,\nAnd generally to the crown and seat of France,\nDerived from Edward, his great-grandfather.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11291/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11291/line-2",
          "start": 12,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11291/line-3",
          "start": 49,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11291/line-4",
          "start": 94,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11291/line-5",
          "start": 141,
          "end": 175,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11291/line-6",
          "start": 176,
          "end": 220,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11291/line-7",
          "start": 221,
          "end": 267,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11291/line-8",
          "start": 268,
          "end": 311,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1910720,
        "end": 1911075,
        "line": 71366,
        "column": 1,
        "path": "chap11/p@11291",
        "anchor": "sceneI_11.1"
      },
      "speakerLabel": "CANTERBURY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@11650",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ELY.\nWhat was th’ impediment that broke this off?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11650/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11650/line-2",
          "start": 5,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1911079,
        "end": 1911142,
        "line": 71376,
        "column": 1,
        "path": "chap11/p@11650",
        "anchor": "sceneI_11.1"
      },
      "speakerLabel": "ELY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@11717",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "CANTERBURY.\nThe French ambassador upon that instant\nCraved audience; and the hour, I think, is come\nTo give him hearing. Is it four o’clock?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11717/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11717/line-2",
          "start": 12,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11717/line-3",
          "start": 52,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11717/line-4",
          "start": 100,
          "end": 140,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1911146,
        "end": 1911310,
        "line": 71380,
        "column": 1,
        "path": "chap11/p@11717",
        "anchor": "sceneI_11.1"
      },
      "speakerLabel": "CANTERBURY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@11885",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ELY.\nIt is.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11885/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11885/line-2",
          "start": 5,
          "end": 11,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1911314,
        "end": 1911339,
        "line": 71386,
        "column": 1,
        "path": "chap11/p@11885",
        "anchor": "sceneI_11.1"
      },
      "speakerLabel": "ELY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@11914",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "CANTERBURY.\nThen go we in, to know his embassy,\nWhich I could with a ready guess declare\nBefore the Frenchman speak a word of it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11914/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11914/line-2",
          "start": 12,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11914/line-3",
          "start": 48,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@11914/line-4",
          "start": 89,
          "end": 129,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1911343,
        "end": 1911496,
        "line": 71390,
        "column": 1,
        "path": "chap11/p@11914",
        "anchor": "sceneI_11.1"
      },
      "speakerLabel": "CANTERBURY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@12071",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ELY.\nI’ll wait upon you, and I long to hear it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@12071/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneI_11.1/p@12071/line-2",
          "start": 5,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1911500,
        "end": 1911561,
        "line": 71396,
        "column": 1,
        "path": "chap11/p@12071",
        "anchor": "sceneI_11.1"
      },
      "speakerLabel": "ELY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "king-henry-the-fifth/sceneI_11.1/p@12136",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt.]",
      "separatorAfter": "\n\n",
