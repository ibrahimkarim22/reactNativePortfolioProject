    {
      "id": "king-henry-the-fifth/sceneII_11.3/p@50186",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "HOSTESS.\n’A did in some sort, indeed, handle women; but then he was rheumatic, and talk’d of the whore of Babylon.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@50186/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@50186/line-2",
          "start": 9,
          "end": 114,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1949615,
        "end": 1949744,
        "line": 72503,
        "column": 1,
        "path": "chap11/p@50186",
        "anchor": "sceneII_11.3"
      },
      "speakerLabel": "HOSTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-henry-the-fifth/sceneII_11.3/p@50319",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOY.\nDo you not remember, ’a saw a flea stick upon Bardolph’s nose, and ’a said it was a black soul burning in hell-fire?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@50319/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@50319/line-2",
          "start": 5,
          "end": 121,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
