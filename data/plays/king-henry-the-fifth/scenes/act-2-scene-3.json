  "content": [
    {
      "id": "king-henry-the-fifth-2-3-stage-001",
      "type": "stage",
      "text": "Enter Pistol, Nym, Bardolph, Boy and Hostess."
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Prithee, honey, sweet husband, let me bring thee to Staines.",
          "plainText": "Prithee honey sweet husband let me bring thee to Staines",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "No; for my manly heart doth yearn.",
          "plainText": "No for my manly heart doth yearn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Bardolph, be blithe; Nym, rouse thy vaunting veins;",
          "plainText": "Bardolph be blithe Nym rouse thy vaunting veins",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "Boy, bristle thy courage up; for Falstaff he is dead,",
          "plainText": "Boy bristle thy courage up for Falstaff he is dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "And we must yearn therefore.",
          "plainText": "And we must yearn therefore",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Would I were with him, wheresome'er he is, either in heaven or in hell!",
          "plainText": "Would I were with him wheresome'er he is either in heaven or in hell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Nay, sure, he's not in hell. He's in Arthur's bosom, if ever man went to Arthur's bosom. 'A made a finer end and went away an it had been any christom child. 'A parted even just between twelve and one, even at the turning o' the tide: for after I saw him fumble with the sheets, and play with flowers, and smile upon his fingers' ends, I knew there was but one way; for his nose was as sharp as a pen, and 'a babbled of green fields. \"How now, Sir John!\" quoth I; \"what, man! be o' good cheer.\" So 'a cried out, \"God, God, God!\" three or four times. Now I, to comfort him, bid him 'a should not think of God; I hop'd there was no need to trouble himself with any such thoughts yet. So 'a bade me lay more clothes on his feet. I put my hand into the bed and felt them, and they were as cold as any stone. Then I felt to his knees, and so upward and upward, and all was as cold as any stone.",
          "plainText": "Nay sure he's not in hell He's in Arthur's bosom if ever man went to Arthur's bosom 'A made a finer end and went away an it had been any christom child 'A parted even just between twelve and one even at the turning o' the tide for after I saw him fumble with the sheets and play with flowers and smile upon his fingers' ends I knew there was but one way for his nose was as sharp as a pen and 'a babbled of green fields How now Sir John quoth I what man be o' good cheer So 'a cried out God God God three or four times Now I to comfort him bid him 'a should not think of God I hop'd there was no need to trouble himself with any such thoughts yet So 'a bade me lay more clothes on his feet I put my hand into the bed and felt them and they were as cold as any stone Then I felt to his knees and so upward and upward and all was as cold as any stone",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "They say he cried out of sack.",
          "plainText": "They say he cried out of sack",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Ay, that 'a did.",
          "plainText": "Ay that 'a did",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "And of women.",
          "plainText": "And of women",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Nay, that 'a did not.",
          "plainText": "Nay that 'a did not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Yes, that 'a did; and said they were devils incarnate.",
          "plainText": "Yes that 'a did and said they were devils incarnate",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "'A could never abide carnation; 'twas a colour he never liked.",
          "plainText": "'A could never abide carnation 'twas a colour he never liked",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "'A said once, the devil would have him about women.",
          "plainText": "'A said once the devil would have him about women",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "'A did in some sort, indeed, handle women; but then he was rheumatic, and talk'd of the whore of Babylon.",
          "plainText": "'A did in some sort indeed handle women but then he was rheumatic and talk'd of the whore of Babylon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Do you not remember, 'a saw a flea stick upon Bardolph's nose, and 'a said it was a black soul burning in hell-fire?",
          "plainText": "Do you not remember 'a saw a flea stick upon Bardolph's nose and 'a said it was a black soul burning in hellfire",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Well, the fuel is gone that maintain'd that fire. That's all the riches I got in his service.",
          "plainText": "Well the fuel is gone that maintain'd that fire That's all the riches I got in his service",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Shall we shog? The King will be gone from Southampton.",
          "plainText": "Shall we shog The King will be gone from Southampton",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Come, let's away. My love, give me thy lips.",
          "plainText": "Come let's away My love give me thy lips",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Look to my chattels and my movables.",
          "plainText": "Look to my chattels and my movables",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Let senses rule; the word is \"Pitch and Pay.\"",
          "plainText": "Let senses rule the word is Pitch and Pay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "Trust none;",
          "plainText": "Trust none",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "For oaths are straws, men's faiths are wafer-cakes",
          "plainText": "For oaths are straws men's faiths are wafercakes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "And hold-fast is the only dog, my duck;",
          "plainText": "And holdfast is the only dog my duck",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 7,
          "text": "Therefore, Caveto be thy counsellor.",
          "plainText": "Therefore Caveto be thy counsellor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 8,
          "text": "Go, clear thy crystals. Yoke-fellows in arms,",
          "plainText": "Go clear thy crystals Yokefellows in arms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 9,
          "text": "Let us to France; like horse-leeches, my boys,",
          "plainText": "Let us to France like horseleeches my boys",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 10,
          "text": "To suck, to suck, the very blood to suck!",
          "plainText": "To suck to suck the very blood to suck",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "And that's but unwholesome food, they say.",
          "plainText": "And that's but unwholesome food they say",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Touch her soft mouth, and march.",
          "plainText": "Touch her soft mouth and march",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Farewell, hostess.",
          "plainText": "Farewell hostess",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-stage-002",
      "type": "stage",
      "text": "[Kissing her.]"
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "I cannot kiss; that is the humour of it; but, adieu.",
          "plainText": "I cannot kiss that is the humour of it but adieu",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Let housewifery appear. Keep close, I thee command.",
          "plainText": "Let housewifery appear Keep close I thee command",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Farewell; adieu.",
          "plainText": "Farewell adieu",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}