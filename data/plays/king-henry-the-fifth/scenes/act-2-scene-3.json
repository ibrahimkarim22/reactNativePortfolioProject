      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "HOSTESS.\nAy, that ’a did.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@49814/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
