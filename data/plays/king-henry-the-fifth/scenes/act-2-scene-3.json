          "start": 5,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1949375,
        "end": 1949448,
        "line": 72491,
        "column": 1,
        "path": "chap11/p@49946",
        "anchor": "sceneII_11.3"
      },
      "speakerLabel": "BOY.",
