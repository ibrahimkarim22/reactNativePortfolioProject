    {
      "id": "king-henry-the-fifth/sceneII_11.3/p@50023",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "HOSTESS.\n’A could never abide carnation; ’twas a colour he never liked.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@50023/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@50023/line-2",
          "start": 9,
          "end": 71,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1949452,
        "end": 1949537,
        "line": 72495,
        "column": 1,
        "path": "chap11/p@50023",
        "anchor": "sceneII_11.3"
      },
      "speakerLabel": "HOSTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-henry-the-fifth/sceneII_11.3/p@50112",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOY.\n’A said once, the devil would have him about women.",
