        "end": 1949884,
        "line": 72508,
        "column": 1,
        "path": "chap11/p@50319",
        "anchor": "sceneII_11.3"
      },
      "speakerLabel": "BOY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "king-henry-the-fifth/sceneII_11.3/p@50459",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BARDOLPH.\nWell, the fuel is gone that maintain’d that fire. That’s all the riches I got in his service.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@50459/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@50459/line-2",
          "start": 10,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1949888,
        "end": 1950006,
        "line": 72513,
        "column": 1,
        "path": "chap11/p@50459",
        "anchor": "sceneII_11.3"
      },
      "speakerLabel": "BARDOLPH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneII_11.3/p@50581",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "NYM.\nShall we shog? The King will be gone from Southampton.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@50581/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@50581/line-2",
          "start": 5,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1950010,
        "end": 1950083,
        "line": 72518,
        "column": 1,
        "path": "chap11/p@50581",
        "anchor": "sceneII_11.3"
      },
      "speakerLabel": "NYM.",
