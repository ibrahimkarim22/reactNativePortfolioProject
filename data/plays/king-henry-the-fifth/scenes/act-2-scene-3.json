    {
      "id": "king-henry-the-fifth/sceneII_11.3/p@49946",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOY.\nYes, that ’a did; and said they were devils incarnate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneII_11.3/p@49946/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
