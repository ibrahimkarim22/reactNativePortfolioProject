      "id": "king-henry-the-fifth/sceneIII_11.2/p@66934",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "GOWER.\nCaptain Fluellen, you must come presently to the mines.\nThe Duke of Gloucester would speak with you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
