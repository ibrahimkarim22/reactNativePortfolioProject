    {
      "id": "king-henry-the-fifth/sceneIII_11.2/p@67064",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nTo the mines! Tell you the Duke, it is not so good to come to the mines; for, look you, the mines is not according to the disciplines of the war. The concavities of it is not sufficient; for, look you, the athversary, you may discuss unto the Duke, look you, is digt himself four yard under the countermines. By Cheshu, I think ’a will plow up all, if there is not better directions.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.2/p@67064/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIII_11.2/p@67064/line-2",
          "start": 10,
          "end": 393,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1966493,
        "end": 1966905,
        "line": 72982,
        "column": 1,
        "path": "chap11/p@67064",
        "anchor": "sceneIII_11.2"
      },
      "speakerLabel": "FLUELLEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIII_11.2/p@67480",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "GOWER.\nThe Duke of Gloucester, to whom the order of the siege is given, is altogether directed by an Irishman, a very valiant gentleman, i’ faith.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.2/p@67480/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIII_11.2/p@67480/line-2",
          "start": 7,
          "end": 146,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1966909,
        "end": 1967070,
        "line": 72991,
        "column": 1,
        "path": "chap11/p@67480",
        "anchor": "sceneIII_11.2"
      },
      "speakerLabel": "GOWER.",
