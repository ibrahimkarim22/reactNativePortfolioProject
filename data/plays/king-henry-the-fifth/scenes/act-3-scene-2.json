        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIII_11.2/p@67645",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nIt is Captain Macmorris, is it not?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.2/p@67645/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIII_11.2/p@67645/line-2",
          "start": 10,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
