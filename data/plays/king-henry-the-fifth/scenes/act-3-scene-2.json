        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIII_11.2/p@67708",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "GOWER.\nI think it be.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.2/p@67708/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIII_11.2/p@67708/line-2",
          "start": 7,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1967137,
        "end": 1967172,
        "line": 73000,
        "column": 1,
        "path": "chap11/p@67708",
        "anchor": "sceneIII_11.2"
      },
      "speakerLabel": "GOWER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIII_11.2/p@67747",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nBy Cheshu, he is an ass, as in the world. I will verify as much in his beard. He has no more directions in the true disciplines of the wars, look you, of the Roman disciplines, than is a puppy-dog.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.2/p@67747/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIII_11.2/p@67747/line-2",
          "start": 10,
          "end": 207,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1967176,
        "end": 1967399,
        "line": 73004,
        "column": 1,
        "path": "chap11/p@67747",
        "anchor": "sceneIII_11.2"
      },
      "speakerLabel": "FLUELLEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIII_11.2/p@67974",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Macmorris and Captain Jamy.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 15,
          "className": "charname"
