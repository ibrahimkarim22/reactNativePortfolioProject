    {
      "id": "king-henry-the-fifth/sceneIII_11.2/p@64033",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "NYM.\nPray thee, corporal, stay. The knocks are too hot; and, for mine own part, I have not a case of lives. The humour of it is too hot; that is the very plain-song of it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
