    {
      "id": "king-henry-the-fifth/sceneIII_11.4/p@75534",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ALICE.\nLes doigts? Ma foi, j’oublie les doigts; mais je me souviendrai. Les doigts? Je pense qu’ils sont appelés de fingres; oui, de fingres.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 7,
          "end": 112
        },
        {
          "tag": "i",
          "start": 125,
          "end": 128
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@75534/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@75534/line-2",
          "start": 7,
          "end": 141,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1974963,
        "end": 1975134,
        "line": 73222,
        "column": 1,
        "path": "chap11/p@75534",
        "anchor": "sceneIII_11.4"
      },
      "speakerLabel": "ALICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIII_11.4/p@75709",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KATHARINE.\nLa main, de hand; les doigts, de fingres. Je pense que je suis le bon écolier; j’ai gagné deux mots d’anglais vitement. Comment appelez-vous les ongles?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 11,
          "end": 18
        },
        {
          "tag": "i",
          "start": 29,
          "end": 39
        },
        {
          "tag": "i",
          "start": 53,
          "end": 163
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@75709/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@75709/line-2",
          "start": 11,
          "end": 163,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1975138,
        "end": 1975338,
        "line": 73228,
        "column": 1,
        "path": "chap11/p@75709",
        "anchor": "sceneIII_11.4"
      },
      "speakerLabel": "KATHARINE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIII_11.4/p@75913",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ALICE.\nLes ongles? Nous les appelons de nails.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 7,
          "end": 36
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@75913/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@75913/line-2",
          "start": 7,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1975342,
        "end": 1975409,
        "line": 73234,
        "column": 1,
        "path": "chap11/p@75913",
        "anchor": "sceneIII_11.4"
      },
      "speakerLabel": "ALICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIII_11.4/p@75984",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KATHARINE.\nDe nails. Écoutez; dites-moi, si je parle bien: de hand, de fingres, et de nails.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 21,
          "end": 58
        },
        {
          "tag": "i",
          "start": 80,
          "end": 82
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@75984/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@75984/line-2",
          "start": 11,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1975413,
        "end": 1975534,
        "line": 73238,
        "column": 1,
        "path": "chap11/p@75984",
        "anchor": "sceneIII_11.4"
      },
      "speakerLabel": "KATHARINE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIII_11.4/p@76109",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ALICE.\nC’est bien dit, madame; il est fort bon anglais.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 7,
          "end": 55
        }
      ],
      "lines": [
        {
