    {
      "id": "king-henry-the-fifth/sceneIII_11.4/p@75270",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KATHARINE.\nJe te prie, m’enseignez; il faut que j’apprenne à parler.\nComment appelez-vous la main en anglais?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 11,
          "end": 109
        }
      ],
      "lines": [
        {
