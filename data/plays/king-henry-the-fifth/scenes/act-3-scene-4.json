      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ALICE.\nD’elbow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@76353/line-1",
