      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KATHARINE.\nD’elbow. Je m’en fais la répétition de tous les mots que vous m’avez appris dès à présent.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 20,
          "end": 101
        }
      ],
      "lines": [
