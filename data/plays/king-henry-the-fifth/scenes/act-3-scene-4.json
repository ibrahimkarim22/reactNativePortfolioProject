    {
      "id": "king-henry-the-fifth/sceneIII_11.4/p@75475",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KATHARINE.\nDe hand. Et les doigts?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 20,
          "end": 34
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@75475/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIII_11.4/p@75475/line-2",
          "start": 11,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1974904,
        "end": 1974959,
        "line": 73218,
        "column": 1,
        "path": "chap11/p@75475",
        "anchor": "sceneIII_11.4"
      },
      "speakerLabel": "KATHARINE.",
