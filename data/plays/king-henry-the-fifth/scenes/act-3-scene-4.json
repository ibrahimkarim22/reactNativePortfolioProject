      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KATHARINE.\nDites-moi l’anglais pour le bras.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 11,
          "end": 44
        }
      ],
      "lines": [
