    {
      "id": "king-henry-the-fifth/sceneIII_11.4/p@75409",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ALICE.\nLa main? Elle est appelée de hand.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 7,
          "end": 32
        }
      ],
      "lines": [
        {
