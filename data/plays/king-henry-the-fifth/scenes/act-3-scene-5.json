    {
      "id": "king-henry-the-fifth/sceneIII_11.5/p@79221",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOURBON.\nNormans, but bastard Normans, Norman bastards!\nMort de ma vie, if they march along\nUnfought withal, but I will sell my dukedom,\nTo buy a slobbery and a dirty farm\nIn that nook-shotten isle of Albion.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 56,
          "end": 70
        }
      ],
      "lines": [
