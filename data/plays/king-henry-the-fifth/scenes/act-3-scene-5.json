    {
      "id": "king-henry-the-fifth/sceneIII_11.5/p@80117",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "DAUPHIN.\nBy faith and honour,\nOur madams mock at us, and plainly say\nOur mettle is bred out, and they will give\nTheir bodies to the lust of English youth\nTo new-store France with bastard warriors.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
