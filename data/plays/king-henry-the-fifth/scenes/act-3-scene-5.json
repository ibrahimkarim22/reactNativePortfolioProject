    {
      "id": "king-henry-the-fifth/sceneIII_11.5/p@78814",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "CONSTABLE.\nAnd if he be not fought withal, my lord,\nLet us not live in France; let us quit all\nAnd give our vineyards to a barbarous people.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
