    {
      "id": "king-henry-the-fifth/sceneIII_11.5/p@78739",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FRENCH KING.\n’Tis certain he hath pass’d the river Somme.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIII_11.5/p@78739/line-1",
