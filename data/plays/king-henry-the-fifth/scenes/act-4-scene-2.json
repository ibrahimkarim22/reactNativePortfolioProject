    {
      "id": "king-henry-the-fifth/sceneIV_11.2/p@123567",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "CONSTABLE.\nI stay but for my guard; on to the field!\nI will the banner from a trumpet take,\nAnd use it for my haste. Come, come, away!\nThe sun is high, and we outwear the day.",
      "separatorAfter": "\n\n",
