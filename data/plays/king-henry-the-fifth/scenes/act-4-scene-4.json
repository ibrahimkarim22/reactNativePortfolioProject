      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOY.\nI do not know the French for fer, and ferret, and firk.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133280/line-1",
