      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nMaster Fer! I’ll fer him, and firk him, and ferret him.\nDiscuss the same in French unto him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133157/line-1",
