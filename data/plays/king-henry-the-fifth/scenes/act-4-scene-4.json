      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@133427",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FRENCH SOLDIER.\nQue dit-il, monsieur?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 16,
          "end": 37
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133427/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133427/line-2",
          "start": 16,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2032856,
        "end": 2032914,
        "line": 75147,
        "column": 1,
        "path": "chap11/p@133427",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "FRENCH SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@133489",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOY.\nIl me commande à vous dire que vous faites vous prêt, car ce soldat ici est disposé tout à cette heure de couper votre gorge.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 5,
          "end": 130
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133489/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133489/line-2",
          "start": 5,
          "end": 130,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2032918,
        "end": 2033070,
        "line": 75151,
        "column": 1,
        "path": "chap11/p@133489",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "BOY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@133645",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nOwy, cuppele gorge, permafoy,\nPeasant, unless thou give me crowns, brave crowns;\nOr mangled shalt thou be by this my sword.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133645/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133645/line-2",
          "start": 8,
          "end": 37,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133645/line-3",
          "start": 38,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133645/line-4",
          "start": 89,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2033074,
        "end": 2033229,
        "line": 75156,
        "column": 1,
        "path": "chap11/p@133645",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@133804",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FRENCH SOLDIER.\nO, je vous supplie, pour l’amour de Dieu, me pardonner! Je suis le gentilhomme de bonne maison; gardez ma vie, et je vous donnerai deux cents écus.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 16,
          "end": 163
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133804/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133804/line-2",
          "start": 16,
          "end": 163,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2033233,
        "end": 2033419,
        "line": 75162,
        "column": 1,
        "path": "chap11/p@133804",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "FRENCH SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@133994",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nWhat are his words?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133994/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133994/line-2",
          "start": 8,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2033423,
        "end": 2033464,
        "line": 75168,
        "column": 1,
        "path": "chap11/p@133994",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@134039",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOY.\nHe prays you to save his life. He is a gentleman of a good house; and for his ransom he will give you two hundred crowns.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134039/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134039/line-2",
          "start": 5,
          "end": 126,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2033468,
        "end": 2033609,
        "line": 75172,
        "column": 1,
        "path": "chap11/p@134039",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "BOY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@134184",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nTell him my fury shall abate, and I\nThe crowns will take.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134184/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134184/line-2",
          "start": 8,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134184/line-3",
          "start": 44,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2033613,
        "end": 2033697,
        "line": 75177,
        "column": 1,
        "path": "chap11/p@134184",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@134272",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FRENCH SOLDIER.\nPetit monsieur, que dit-il?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 16,
          "end": 43
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134272/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134272/line-2",
          "start": 16,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2033701,
        "end": 2033765,
        "line": 75182,
        "column": 1,
        "path": "chap11/p@134272",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "FRENCH SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@134340",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOY.\nEncore qu’il est contre son jurement de pardonner aucun prisonnier; néanmoins, pour les écus que vous lui avez promis, il est content à vous donner la liberté, le franchisement.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 5,
          "end": 182
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134340/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134340/line-2",
          "start": 5,
          "end": 182,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2033769,
        "end": 2033974,
        "line": 75186,
        "column": 1,
        "path": "chap11/p@134340",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "BOY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@134549",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FRENCH SOLDIER.\nSur mes genoux je vous donne mille remerciements; et je m’estime heureux que je suis tombé entre les mains d’un chevalier, je pense, le plus brave, vaillant, et très distingué seigneur d’Angleterre.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 16,
          "end": 214
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134549/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134549/line-2",
          "start": 16,
          "end": 214,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2033978,
        "end": 2034215,
        "line": 75192,
        "column": 1,
        "path": "chap11/p@134549",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "FRENCH SOLDIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@134790",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nExpound unto me, boy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134790/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134790/line-2",
          "start": 8,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2034219,
        "end": 2034262,
        "line": 75198,
        "column": 1,
        "path": "chap11/p@134790",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@134837",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOY.\nHe gives you upon his knees, a thousand thanks; and he esteems himself happy that he hath fallen into the hands of one, as he thinks, the most brave, valorous, and thrice-worthy seigneur of England.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 183,
          "end": 191
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134837/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@134837/line-2",
          "start": 5,
          "end": 203,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2034266,
        "end": 2034492,
        "line": 75202,
        "column": 1,
        "path": "chap11/p@134837",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "BOY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@135067",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nAs I suck blood, I will some mercy show.\nFollow me!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@135067/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@135067/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@135067/line-3",
          "start": 49,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2034496,
        "end": 2034574,
        "line": 75208,
        "column": 1,
        "path": "chap11/p@135067",
        "anchor": "sceneIV_11.4"
      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.4/p@135149",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOY.\nSuivez-vous le grand capitaine.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 5,
          "end": 36
        }
      ],
      "lines": [
        {
