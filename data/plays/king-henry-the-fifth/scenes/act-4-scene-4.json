      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt Pistol and French Soldier.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 14,
          "className": "charname"
        },
