      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nBid him prepare; for I will cut his throat.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133358/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.4/p@133358/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
