      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "CONSTABLE.\nWhy, all our ranks are broke.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@136516/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
