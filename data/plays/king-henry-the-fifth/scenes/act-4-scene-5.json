    {
      "id": "king-henry-the-fifth/sceneIV_11.5/p@137118",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "CONSTABLE.\nDisorder, that hath spoil’d us, friend us now!\nLet us on heaps go offer up our lives.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@137118/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@137118/line-2",
          "start": 11,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@137118/line-3",
          "start": 58,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2036547,
        "end": 2036662,
        "line": 75278,
        "column": 1,
        "path": "chap11/p@137118",
        "anchor": "sceneIV_11.5"
      },
      "speakerLabel": "CONSTABLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.5/p@137237",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ORLEANS.\nWe are enough yet living in the field\nTo smother up the English in our throngs,\nIf any order might be thought upon.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@137237/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@137237/line-2",
          "start": 9,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@137237/line-3",
          "start": 47,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@137237/line-4",
          "start": 89,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2036666,
        "end": 2036814,
        "line": 75283,
        "column": 1,
        "path": "chap11/p@137237",
        "anchor": "sceneIV_11.5"
      },
      "speakerLabel": "ORLEANS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.5/p@137389",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOURBON.\nThe devil take order now! I’ll to the throng.\nLet life be short, else shame will be too long.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@137389/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
