        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.5/p@136697",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ORLEANS.\nIs this the king we sent to for his ransom?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@136697/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@136697/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2036126,
        "end": 2036192,
        "line": 75264,
        "column": 1,
        "path": "chap11/p@136697",
        "anchor": "sceneIV_11.5"
      },
      "speakerLabel": "ORLEANS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-henry-the-fifth/sceneIV_11.5/p@136767",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "BOURBON.\nShame and eternal shame, nothing but shame!\nLet’s die in honour! Once more back again!\nAnd he that will not follow Bourbon now,\nLet him go hence, and with his cap in hand,\nLike a base pandar, hold the chamber door\nWhilst by a slave, no gentler than my dog,\nHis fairest daughter is contaminated.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@136767/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@136767/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@136767/line-3",
          "start": 53,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@136767/line-4",
          "start": 96,
          "end": 136,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@136767/line-5",
          "start": 137,
          "end": 180,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.5/p@136767/line-6",
          "start": 181,
          "end": 222,
          "sourceLineNumber": null
        },
        {
