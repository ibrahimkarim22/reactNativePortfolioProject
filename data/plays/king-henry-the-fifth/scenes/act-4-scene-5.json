      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "DAUPHIN.\nMort de ma vie! all is confounded, all!\nReproach and everlasting shame\nSits mocking in our plumes.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 9,
          "end": 24
        }
      ],
      "lines": [
