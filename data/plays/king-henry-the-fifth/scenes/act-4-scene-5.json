      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "ORLEANS.\nO Seigneur! le jour est perdu, tout est perdu!",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 9,
          "end": 55
        }
      ],
      "lines": [
