      "id": "king-henry-the-fifth/sceneIV_11.6/p@139365",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KING HENRY.\nI blame you not;\nFor, hearing this, I must perforce compound\nWith mistful eyes, or they will issue too.",
