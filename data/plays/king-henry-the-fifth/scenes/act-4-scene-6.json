    {
      "id": "king-henry-the-fifth/sceneIV_11.6/p@137957",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KING HENRY.\nLives he, good uncle? Thrice within this hour\nI saw him down; thrice up again, and fighting.\nFrom helmet to the spur all blood he was.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneIV_11.6/p@137957/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.6/p@137957/line-2",
          "start": 12,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.6/p@137957/line-3",
          "start": 58,
          "end": 104,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneIV_11.6/p@137957/line-4",
          "start": 105,
          "end": 146,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2037386,
        "end": 2037556,
        "line": 75310,
        "column": 1,
        "path": "chap11/p@137957",
        "anchor": "sceneIV_11.6"
