    {
      "id": "king-henry-the-fifth/sceneIV_11.6/p@137754",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KING HENRY.\nWell have we done, thrice valiant countrymen.\nBut all’s not done; yet keep the French the field.",
