    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@162794",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nMuch good do you, scald knave, heartily. Nay, pray you, throw none away; the skin is good for your broken coxcomb. When you take occasions to see leeks hereafter, I pray you, mock at ’em; that is all.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
