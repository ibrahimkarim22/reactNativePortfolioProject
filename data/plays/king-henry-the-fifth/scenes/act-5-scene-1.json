      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nYes, verily and in truth you shall take it; or I have another leek in my pocket, which you shall eat.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
