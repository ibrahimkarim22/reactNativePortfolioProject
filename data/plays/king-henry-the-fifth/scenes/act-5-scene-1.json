      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 19,
          "end": 24,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@159926/line-1",
          "start": 0,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2059355,
        "end": 2059466,
        "line": 76002,
        "column": 1,
        "path": "chap11/p@159926",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@160041",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "GOWER.\nNay, that’s right; but why wear you your leek today?\nSaint Davy’s day is past.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@160041/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@160041/line-2",
          "start": 7,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@160041/line-3",
          "start": 60,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2059470,
        "end": 2059574,
        "line": 76004,
        "column": 1,
        "path": "chap11/p@160041",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "GOWER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@160149",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nThere is occasions and causes why and wherefore in all things. I will tell you ass my friend, Captain Gower. The rascally, scald, beggarly, lousy, pragging knave, Pistol, which you and yourself and all the world know to be no petter than a fellow, look you now, of no merits, he is come to me and prings me pread and salt yesterday, look you, and bid me eat my leek. It was in a place where I could not breed no contention with him; but I will be so bold as to wear it in my cap till I see him once again, and then I will tell him a little piece of my desires.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@160149/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@160149/line-2",
          "start": 10,
          "end": 570,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2059578,
        "end": 2060169,
        "line": 76009,
        "column": 1,
        "path": "chap11/p@160149",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "FLUELLEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@160744",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Pistol.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 12,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@160744/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2060173,
        "end": 2060242,
        "line": 76020,
        "column": 1,
        "path": "chap11/p@160744",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@160817",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "GOWER.\nWhy, here he comes, swelling like a turkey-cock.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@160817/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@160817/line-2",
          "start": 7,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2060246,
        "end": 2060315,
        "line": 76022,
        "column": 1,
        "path": "chap11/p@160817",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "GOWER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@160890",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\n’Tis no matter for his swellings nor his turkey-cocks. God pless you, Anchient Pistol! you scurvy, lousy knave, God pless you!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@160890/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@160890/line-2",
          "start": 10,
          "end": 136,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2060319,
        "end": 2060470,
        "line": 76026,
        "column": 1,
        "path": "chap11/p@160890",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "FLUELLEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@161045",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nHa! art thou bedlam? Dost thou thirst, base Trojan,\nTo have me fold up Parca’s fatal web?\nHence! I am qualmish at the smell of leek.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161045/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161045/line-2",
          "start": 8,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161045/line-3",
          "start": 60,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161045/line-4",
          "start": 98,
          "end": 140,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2060474,
        "end": 2060638,
        "line": 76031,
        "column": 1,
        "path": "chap11/p@161045",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@161213",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nI peseech you heartily, scurfy, lousy knave, at my desires, and my requests, and my petitions, to eat, look you, this leek. Because, look you, you do not love it, nor your affections and your appetites and your digestions does not agree with it, I would desire you to eat it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161213/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161213/line-2",
          "start": 10,
          "end": 285,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2060642,
        "end": 2060944,
        "line": 76037,
        "column": 1,
        "path": "chap11/p@161213",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "FLUELLEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@161519",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nNot for Cadwallader and all his goats.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161519/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161519/line-2",
          "start": 8,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2060948,
        "end": 2061008,
        "line": 76044,
        "column": 1,
        "path": "chap11/p@161519",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@161583",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nThere is one goat for you. [Strikes him.] Will you be so good, scald knave, as eat it?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 38,
          "end": 50
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161583/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161583/line-2",
          "start": 10,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2061012,
        "end": 2061130,
        "line": 76048,
        "column": 1,
        "path": "chap11/p@161583",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "FLUELLEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@161705",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nBase Trojan, thou shalt die.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161705/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161705/line-2",
          "start": 8,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2061134,
        "end": 2061184,
        "line": 76053,
        "column": 1,
        "path": "chap11/p@161705",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@161759",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nYou say very true, scald knave, when God’s will is. I will desire you to live in the mean time, and eat your victuals. Come, there is sauce for it. [Strikes him.] You call’d me yesterday mountain-squire; but I will make you today a squire of low degree. I pray you, fall to; if you can mock a leek, you can eat a leek.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 159,
          "end": 171
        }
      ],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161759/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@161759/line-2",
          "start": 10,
          "end": 328,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2061188,
        "end": 2061541,
        "line": 76057,
        "column": 1,
        "path": "chap11/p@161759",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "FLUELLEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@162116",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "GOWER.\nEnough, captain; you have astonish’d him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162116/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162116/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2061545,
        "end": 2061607,
        "line": 76065,
        "column": 1,
        "path": "chap11/p@162116",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "GOWER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@162182",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nI say, I will make him eat some part of my leek, or I will peat his pate four days. Bite, I pray you; it is good for your green wound and your ploody coxcomb.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162182/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162182/line-2",
          "start": 10,
          "end": 168,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2061611,
        "end": 2061795,
        "line": 76069,
        "column": 1,
        "path": "chap11/p@162182",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "FLUELLEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@162370",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nMust I bite?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162370/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162370/line-2",
          "start": 8,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2061799,
        "end": 2061833,
        "line": 76075,
        "column": 1,
        "path": "chap11/p@162370",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@162408",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nYes, certainly, and out of doubt and out of question too, and ambiguities.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162408/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162408/line-2",
          "start": 10,
          "end": 84,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2061837,
        "end": 2061935,
        "line": 76079,
        "column": 1,
        "path": "chap11/p@162408",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "FLUELLEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@162510",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PISTOL.\nBy this leek, I will most horribly revenge. I eat and eat, I swear—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162510/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162510/line-2",
          "start": 8,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2061939,
        "end": 2062028,
        "line": 76083,
        "column": 1,
        "path": "chap11/p@162510",
        "anchor": "sceneV_11.1"
      },
      "speakerLabel": "PISTOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@162603",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nEat, I pray you. Will you have some more sauce to your leek? There is not enough leek to swear by.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-henry-the-fifth/sceneV_11.1/p@162603/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
