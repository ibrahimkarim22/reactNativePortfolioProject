    {
      "id": "king-henry-the-fifth/sceneV_11.1/p@163379",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "FLUELLEN.\nIf I owe you anything I will pay you in cudgels. You shall be a woodmonger, and buy nothing of me but cudgels. God be wi’ you, and keep you, and heal your pate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
