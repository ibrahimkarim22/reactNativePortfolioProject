    {
      "id": "king-john/sceneIII_16.2/p@75883",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING JOHN.\nHubert, keep this boy.—Philip, make up.\nMy mother is assailed in our tent,\nAnd ta’en, I fear.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
