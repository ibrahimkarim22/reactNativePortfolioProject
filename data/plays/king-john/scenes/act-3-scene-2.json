    },
    {
      "id": "king-john/sceneIII_16.2/p@76031",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nMy lord, I rescu’d her;\nHer highness is in safety, fear you not.\nBut on, my liege; for very little pains\nWill bring this labour to an happy end.",
      "separatorAfter": "\n\n",
      "spans": [],
