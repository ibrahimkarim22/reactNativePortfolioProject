    {
      "id": "king-john/sceneIII_16.2/p@75547",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nNow, by my life, this day grows wondrous hot;\nSome airy devil hovers in the sky\nAnd pours down mischief. Austria’s head lie there,\nWhile Philip breathes.",
      "separatorAfter": "\n\n",
      "spans": [],
