      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING JOHN.\nFor England, cousin, go.\nHubert shall be your man, attend on you\nWith all true duty. On toward Calais, ho!",
      "separatorAfter": "\n\n",
      "spans": [],
