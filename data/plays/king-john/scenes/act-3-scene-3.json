    {
      "id": "king-john/sceneIII_16.3/p@79925",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING JOHN.\nDo not I know thou wouldst?\nGood Hubert, Hubert, Hubert, throw thine eye\nOn yon young boy. I’ll tell thee what, my friend,\nHe is a very serpent in my way;\nAnd wheresoe’er this foot of mine doth tread,\nHe lies before me. Dost thou understand me?\nThou art his keeper.",
      "separatorAfter": "\n\n",
      "spans": [],
