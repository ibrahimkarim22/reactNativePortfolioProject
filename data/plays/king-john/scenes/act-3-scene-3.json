  "scene": {
    "id": "king-john-3-3",
    "act": 3,
    "scene": 3,
    "label": "Act 3, Scene 3",
    "title": "SCENE III. The same.",
    "location": "The same.",
    "orderInPlay": 5
  },
  "content": [
    {
      "id": "king-john-3-3-stage-001",
      "type": "stage",
      "text": "Alarums, Excursions, Retreat. Enter King John, Eleanor, Arthur, the Bastard, Hubert and Lords."
    },
    {
      "id": "king-john-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "[To Eleanor] So shall it be; your grace shall stay behind",
          "plainText": "To Eleanor So shall it be your grace shall stay behind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "So strongly guarded.",
          "plainText": "So strongly guarded",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "[To Arthur] Cousin, look not sad.",
          "plainText": "To Arthur Cousin look not sad",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Thy grandam loves thee, and thy uncle will",
          "plainText": "Thy grandam loves thee and thy uncle will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "As dear be to thee as thy father was.",
          "plainText": "As dear be to thee as thy father was",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "arthur",
        "name": "ARTHUR",
        "displayName": "Arthur"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "O, this will make my mother die with grief!",
          "plainText": "O this will make my mother die with grief",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "[To the Bastard] Cousin, away for England! Haste before,",
          "plainText": "To the Bastard Cousin away for England Haste before",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "And, ere our coming, see thou shake the bags",
          "plainText": "And ere our coming see thou shake the bags",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Of hoarding abbots; imprison'd angels",
          "plainText": "Of hoarding abbots imprison'd angels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "Set at liberty. The fat ribs of peace",
          "plainText": "Set at liberty The fat ribs of peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "Must by the hungry now be fed upon.",
          "plainText": "Must by the hungry now be fed upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "Use our commission in his utmost force.",
          "plainText": "Use our commission in his utmost force",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Bell, book, and candle shall not drive me back",
          "plainText": "Bell book and candle shall not drive me back",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "When gold and silver becks me to come on.",
          "plainText": "When gold and silver becks me to come on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "I leave your highness. Grandam, I will pray,",
          "plainText": "I leave your highness Grandam I will pray",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "If ever I remember to be holy,",
          "plainText": "If ever I remember to be holy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 5,
          "text": "For your fair safety; so, I kiss your hand.",
          "plainText": "For your fair safety so I kiss your hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "queen-eleanor",
        "name": "QUEEN ELEANOR",
        "displayName": "Queen Eleanor"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Farewell, gentle cousin.",
          "plainText": "Farewell gentle cousin",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Coz, farewell.",
          "plainText": "Coz farewell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-3-3-stage-002",
      "type": "stage",
      "text": "[Exit Bastard.]"
    },
    {
      "id": "king-john-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "queen-eleanor",
        "name": "QUEEN ELEANOR",
        "displayName": "Queen Eleanor"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Come hither, little kinsman; hark, a word.",
          "plainText": "Come hither little kinsman hark a word",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-3-3-stage-003",
      "type": "stage",
      "text": "[She takes Arthur aside.]"
    },
    {
      "id": "king-john-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Come hither, Hubert. O my gentle Hubert,",
          "plainText": "Come hither Hubert O my gentle Hubert",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "We owe thee much! Within this wall of flesh",
          "plainText": "We owe thee much Within this wall of flesh",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "There is a soul counts thee her creditor,",
          "plainText": "There is a soul counts thee her creditor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "And with advantage means to pay thy love.",
          "plainText": "And with advantage means to pay thy love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "And, my good friend, thy voluntary oath",
          "plainText": "And my good friend thy voluntary oath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 6,
          "text": "Lives in this bosom, dearly cherished.",
          "plainText": "Lives in this bosom dearly cherished",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 7,
          "text": "Give me thy hand. I had a thing to say,",
          "plainText": "Give me thy hand I had a thing to say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 8,
          "text": "But I will fit it with some better tune.",
          "plainText": "But I will fit it with some better tune",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0029",
          "number": 29,
          "speechLineNumber": 9,
          "text": "By heaven, Hubert, I am almost asham'd",
          "plainText": "By heaven Hubert I am almost asham'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0030",
          "number": 30,
          "speechLineNumber": 10,
          "text": "To say what good respect I have of thee.",
          "plainText": "To say what good respect I have of thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "I am much bounden to your majesty.",
          "plainText": "I am much bounden to your majesty",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Good friend, thou hast no cause to say so yet,",
          "plainText": "Good friend thou hast no cause to say so yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "But thou shalt have; and creep time ne'er so slow,",
          "plainText": "But thou shalt have and creep time ne'er so slow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "Yet it shall come for me to do thee good.",
          "plainText": "Yet it shall come for me to do thee good",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "I had a thing to say, but let it go.",
          "plainText": "I had a thing to say but let it go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "The sun is in the heaven, and the proud day,",
          "plainText": "The sun is in the heaven and the proud day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "Attended with the pleasures of the world,",
          "plainText": "Attended with the pleasures of the world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "Is all too wanton and too full of gauds",
          "plainText": "Is all too wanton and too full of gauds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0039",
          "number": 39,
          "speechLineNumber": 8,
          "text": "To give me audience. If the midnight bell",
          "plainText": "To give me audience If the midnight bell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0040",
          "number": 40,
          "speechLineNumber": 9,
          "text": "Did, with his iron tongue and brazen mouth,",
          "plainText": "Did with his iron tongue and brazen mouth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0041",
          "number": 41,
          "speechLineNumber": 10,
          "text": "Sound on into the drowsy race of night;",
          "plainText": "Sound on into the drowsy race of night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0042",
          "number": 42,
          "speechLineNumber": 11,
          "text": "If this same were a churchyard where we stand,",
          "plainText": "If this same were a churchyard where we stand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0043",
          "number": 43,
          "speechLineNumber": 12,
          "text": "And thou possessed with a thousand wrongs;",
          "plainText": "And thou possessed with a thousand wrongs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0044",
          "number": 44,
          "speechLineNumber": 13,
          "text": "Or if that surly spirit, melancholy,",
          "plainText": "Or if that surly spirit melancholy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0045",
          "number": 45,
          "speechLineNumber": 14,
          "text": "Had bak'd thy blood and made it heavy, thick,",
          "plainText": "Had bak'd thy blood and made it heavy thick",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0046",
          "number": 46,
          "speechLineNumber": 15,
          "text": "Which else runs tickling up and down the veins,",
          "plainText": "Which else runs tickling up and down the veins",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0047",
          "number": 47,
          "speechLineNumber": 16,
          "text": "Making that idiot, laughter, keep men's eyes",
          "plainText": "Making that idiot laughter keep men's eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0048",
          "number": 48,
          "speechLineNumber": 17,
          "text": "And strain their cheeks to idle merriment,",
          "plainText": "And strain their cheeks to idle merriment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0049",
          "number": 49,
          "speechLineNumber": 18,
          "text": "A passion hateful to my purposes;",
          "plainText": "A passion hateful to my purposes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0050",
          "number": 50,
          "speechLineNumber": 19,
          "text": "Or if that thou couldst see me without eyes,",
          "plainText": "Or if that thou couldst see me without eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0051",
          "number": 51,
          "speechLineNumber": 20,
          "text": "Hear me without thine ears, and make reply",
          "plainText": "Hear me without thine ears and make reply",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0052",
          "number": 52,
          "speechLineNumber": 21,
          "text": "Without a tongue, using conceit alone,",
          "plainText": "Without a tongue using conceit alone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0053",
          "number": 53,
          "speechLineNumber": 22,
          "text": "Without eyes, ears, and harmful sound of words;",
          "plainText": "Without eyes ears and harmful sound of words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0054",
          "number": 54,
          "speechLineNumber": 23,
          "text": "Then, in despite of brooded watchful day,",
          "plainText": "Then in despite of brooded watchful day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0055",
          "number": 55,
          "speechLineNumber": 24,
          "text": "I would into thy bosom pour my thoughts.",
          "plainText": "I would into thy bosom pour my thoughts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0056",
          "number": 56,
          "speechLineNumber": 25,
          "text": "But, ah, I will not! Yet I love thee well;",
          "plainText": "But ah I will not Yet I love thee well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0057",
          "number": 57,
          "speechLineNumber": 26,
          "text": "And, by my troth, I think thou lov'st me well.",
          "plainText": "And by my troth I think thou lov'st me well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "So well that what you bid me undertake,",
          "plainText": "So well that what you bid me undertake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "Though that my death were adjunct to my act,",
          "plainText": "Though that my death were adjunct to my act",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "By heaven, I would do it.",
          "plainText": "By heaven I would do it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Do not I know thou wouldst?",
          "plainText": "Do not I know thou wouldst",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "Good Hubert, Hubert, Hubert, throw thine eye",
          "plainText": "Good Hubert Hubert Hubert throw thine eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "On yon young boy. I'll tell thee what, my friend,",
          "plainText": "On yon young boy I'll tell thee what my friend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0064",
          "number": 64,
          "speechLineNumber": 4,
          "text": "He is a very serpent in my way;",
          "plainText": "He is a very serpent in my way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0065",
          "number": 65,
          "speechLineNumber": 5,
          "text": "And wheresoe'er this foot of mine doth tread,",
          "plainText": "And wheresoe'er this foot of mine doth tread",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0066",
          "number": 66,
          "speechLineNumber": 6,
          "text": "He lies before me. Dost thou understand me?",
          "plainText": "He lies before me Dost thou understand me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0067",
          "number": 67,
          "speechLineNumber": 7,
          "text": "Thou art his keeper.",
          "plainText": "Thou art his keeper",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "And I'll keep him so",
          "plainText": "And I'll keep him so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "That he shall not offend your majesty.",
          "plainText": "That he shall not offend your majesty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Death.",
          "plainText": "Death",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "My lord?",
          "plainText": "My lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "A grave.",
          "plainText": "A grave",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "He shall not live.",
          "plainText": "He shall not live",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Enough.",
          "plainText": "Enough",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "I could be merry now. Hubert, I love thee.",
          "plainText": "I could be merry now Hubert I love thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "Well, I'll not say what I intend for thee.",
          "plainText": "Well I'll not say what I intend for thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0077",
          "number": 77,
          "speechLineNumber": 4,
          "text": "Remember. Madam, fare you well.",
          "plainText": "Remember Madam fare you well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0078",
          "number": 78,
          "speechLineNumber": 5,
          "text": "I'll send those powers o'er to your majesty.",
          "plainText": "I'll send those powers o'er to your majesty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "queen-eleanor",
        "name": "QUEEN ELEANOR",
        "displayName": "Queen Eleanor"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "My blessing go with thee!",
          "plainText": "My blessing go with thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-3-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-3-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "For England, cousin, go.",
          "plainText": "For England cousin go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0081",
          "number": 81,
          "speechLineNumber": 2,
          "text": "Hubert shall be your man, attend on you",
          "plainText": "Hubert shall be your man attend on you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-3-3-line-0082",
          "number": 82,
          "speechLineNumber": 3,
          "text": "With all true duty. On toward Calais, ho!",
          "plainText": "With all true duty On toward Calais ho",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-3-3-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}