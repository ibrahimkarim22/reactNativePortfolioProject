    {
      "id": "king-john/sceneV_16.1/p@128512",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nAll Kent hath yielded. Nothing there holds out\nBut Dover Castle. London hath receiv’d,\nLike a kind host, the Dauphin and his powers.\nYour nobles will not hear you, but are gone\nTo offer service to your enemy;\nAnd wild amazement hurries up and down\nThe little number of your doubtful friends.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
