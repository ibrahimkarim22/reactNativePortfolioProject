    {
      "id": "king-john/sceneV_16.1/p@129004",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nThey found him dead and cast into the streets,\nAn empty casket, where the jewel of life\nBy some damn’d hand was robb’d and ta’en away.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
