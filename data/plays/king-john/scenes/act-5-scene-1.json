  "scene": {
    "id": "king-john-5-1",
    "act": 5,
    "scene": 1,
    "label": "Act 5, Scene 1",
    "title": "SCENE I. Northampton. A Room in the Palace.",
    "location": "Northampton. A Room in the Palace.",
    "orderInPlay": 10
  },
  "content": [
    {
      "id": "king-john-5-1-stage-001",
      "type": "stage",
      "text": "Enter King John, Pandulph with the crown, and Attendants."
    },
    {
      "id": "king-john-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Thus have I yielded up into your hand",
          "plainText": "Thus have I yielded up into your hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The circle of my glory.",
          "plainText": "The circle of my glory",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "pandulph",
        "name": "PANDULPH",
        "displayName": "Pandulph"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "[Giving King John the crown.]",
          "plainText": "Giving King John the crown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Take again",
          "plainText": "Take again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "From this my hand, as holding of the pope,",
          "plainText": "From this my hand as holding of the pope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "Your sovereign greatness and authority.",
          "plainText": "Your sovereign greatness and authority",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Now keep your holy word. Go meet the French,",
          "plainText": "Now keep your holy word Go meet the French",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "And from his holiness use all your power",
          "plainText": "And from his holiness use all your power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "To stop their marches 'fore we are inflam'd.",
          "plainText": "To stop their marches 'fore we are inflam'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "Our discontented counties do revolt;",
          "plainText": "Our discontented counties do revolt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "Our people quarrel with obedience,",
          "plainText": "Our people quarrel with obedience",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "Swearing allegiance and the love of soul",
          "plainText": "Swearing allegiance and the love of soul",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 7,
          "text": "To stranger blood, to foreign royalty.",
          "plainText": "To stranger blood to foreign royalty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 8,
          "text": "This inundation of mistemper'd humour",
          "plainText": "This inundation of mistemper'd humour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 9,
          "text": "Rests by you only to be qualified.",
          "plainText": "Rests by you only to be qualified",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 10,
          "text": "Then pause not; for the present time's so sick",
          "plainText": "Then pause not for the present time's so sick",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 11,
          "text": "That present med'cine must be minist'red",
          "plainText": "That present med'cine must be minist'red",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 12,
          "text": "Or overthrow incurable ensues.",
          "plainText": "Or overthrow incurable ensues",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "pandulph",
        "name": "PANDULPH",
        "displayName": "Pandulph"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "It was my breath that blew this tempest up,",
          "plainText": "It was my breath that blew this tempest up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Upon your stubborn usage of the pope;",
          "plainText": "Upon your stubborn usage of the pope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "But since you are a gentle convertite,",
          "plainText": "But since you are a gentle convertite",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "My tongue shall hush again this storm of war",
          "plainText": "My tongue shall hush again this storm of war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "And make fair weather in your blust'ring land.",
          "plainText": "And make fair weather in your blust'ring land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "On this Ascension-day, remember well,",
          "plainText": "On this Ascensionday remember well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 7,
          "text": "Upon your oath of service to the pope,",
          "plainText": "Upon your oath of service to the pope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 8,
          "text": "Go I to make the French lay down their arms.",
          "plainText": "Go I to make the French lay down their arms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "king-john-5-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Is this Ascension-day? Did not the prophet",
          "plainText": "Is this Ascensionday Did not the prophet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Say that before Ascension-day at noon",
          "plainText": "Say that before Ascensionday at noon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "My crown I should give off? Even so I have.",
          "plainText": "My crown I should give off Even so I have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "I did suppose it should be on constraint;",
          "plainText": "I did suppose it should be on constraint",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "But, heaven be thank'd, it is but voluntary.",
          "plainText": "But heaven be thank'd it is but voluntary",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-stage-003",
      "type": "stage",
      "text": "Enter the Bastard."
    },
    {
      "id": "king-john-5-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "All Kent hath yielded. Nothing there holds out",
          "plainText": "All Kent hath yielded Nothing there holds out",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "But Dover Castle. London hath receiv'd,",
          "plainText": "But Dover Castle London hath receiv'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "Like a kind host, the Dauphin and his powers.",
          "plainText": "Like a kind host the Dauphin and his powers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "Your nobles will not hear you, but are gone",
          "plainText": "Your nobles will not hear you but are gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "To offer service to your enemy;",
          "plainText": "To offer service to your enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "And wild amazement hurries up and down",
          "plainText": "And wild amazement hurries up and down",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "The little number of your doubtful friends.",
          "plainText": "The little number of your doubtful friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Would not my lords return to me again",
          "plainText": "Would not my lords return to me again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "After they heard young Arthur was alive?",
          "plainText": "After they heard young Arthur was alive",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "They found him dead and cast into the streets,",
          "plainText": "They found him dead and cast into the streets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "An empty casket, where the jewel of life",
          "plainText": "An empty casket where the jewel of life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "By some damn'd hand was robb'd and ta'en away.",
          "plainText": "By some damn'd hand was robb'd and ta'en away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "That villain Hubert told me he did live.",
          "plainText": "That villain Hubert told me he did live",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "So, on my soul, he did, for aught he knew.",
          "plainText": "So on my soul he did for aught he knew",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "But wherefore do you droop? Why look you sad?",
          "plainText": "But wherefore do you droop Why look you sad",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "Be great in act, as you have been in thought;",
          "plainText": "Be great in act as you have been in thought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "Let not the world see fear and sad distrust",
          "plainText": "Let not the world see fear and sad distrust",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0049",
          "number": 49,
          "speechLineNumber": 5,
          "text": "Govern the motion of a kingly eye.",
          "plainText": "Govern the motion of a kingly eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0050",
          "number": 50,
          "speechLineNumber": 6,
          "text": "Be stirring as the time; be fire with fire;",
          "plainText": "Be stirring as the time be fire with fire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0051",
          "number": 51,
          "speechLineNumber": 7,
          "text": "Threaten the threat'ner, and outface the brow",
          "plainText": "Threaten the threat'ner and outface the brow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0052",
          "number": 52,
          "speechLineNumber": 8,
          "text": "Of bragging horror. So shall inferior eyes,",
          "plainText": "Of bragging horror So shall inferior eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0053",
          "number": 53,
          "speechLineNumber": 9,
          "text": "That borrow their behaviours from the great,",
          "plainText": "That borrow their behaviours from the great",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0054",
          "number": 54,
          "speechLineNumber": 10,
          "text": "Grow great by your example and put on",
          "plainText": "Grow great by your example and put on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0055",
          "number": 55,
          "speechLineNumber": 11,
          "text": "The dauntless spirit of resolution.",
          "plainText": "The dauntless spirit of resolution",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0056",
          "number": 56,
          "speechLineNumber": 12,
          "text": "Away, and glister like the god of war",
          "plainText": "Away and glister like the god of war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0057",
          "number": 57,
          "speechLineNumber": 13,
          "text": "When he intendeth to become the field.",
          "plainText": "When he intendeth to become the field",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0058",
          "number": 58,
          "speechLineNumber": 14,
          "text": "Show boldness and aspiring confidence.",
          "plainText": "Show boldness and aspiring confidence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0059",
          "number": 59,
          "speechLineNumber": 15,
          "text": "What, shall they seek the lion in his den,",
          "plainText": "What shall they seek the lion in his den",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0060",
          "number": 60,
          "speechLineNumber": 16,
          "text": "And fright him there? And make him tremble there?",
          "plainText": "And fright him there And make him tremble there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0061",
          "number": 61,
          "speechLineNumber": 17,
          "text": "O, let it not be said! Forage, and run",
          "plainText": "O let it not be said Forage and run",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0062",
          "number": 62,
          "speechLineNumber": 18,
          "text": "To meet displeasure farther from the doors,",
          "plainText": "To meet displeasure farther from the doors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0063",
          "number": 63,
          "speechLineNumber": 19,
          "text": "And grapple with him ere he come so nigh.",
          "plainText": "And grapple with him ere he come so nigh",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "The legate of the pope hath been with me,",
          "plainText": "The legate of the pope hath been with me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "And I have made a happy peace with him;",
          "plainText": "And I have made a happy peace with him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "And he hath promis'd to dismiss the powers",
          "plainText": "And he hath promis'd to dismiss the powers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0067",
          "number": 67,
          "speechLineNumber": 4,
          "text": "Led by the Dauphin.",
          "plainText": "Led by the Dauphin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "O inglorious league!",
          "plainText": "O inglorious league",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "Shall we, upon the footing of our land,",
          "plainText": "Shall we upon the footing of our land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0070",
          "number": 70,
          "speechLineNumber": 3,
          "text": "Send fair-play orders and make compromise,",
          "plainText": "Send fairplay orders and make compromise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0071",
          "number": 71,
          "speechLineNumber": 4,
          "text": "Insinuation, parley, and base truce",
          "plainText": "Insinuation parley and base truce",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0072",
          "number": 72,
          "speechLineNumber": 5,
          "text": "To arms invasive? Shall a beardless boy,",
          "plainText": "To arms invasive Shall a beardless boy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0073",
          "number": 73,
          "speechLineNumber": 6,
          "text": "A cocker'd silken wanton, brave our fields,",
          "plainText": "A cocker'd silken wanton brave our fields",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0074",
          "number": 74,
          "speechLineNumber": 7,
          "text": "And flesh his spirit in a warlike soil,",
          "plainText": "And flesh his spirit in a warlike soil",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0075",
          "number": 75,
          "speechLineNumber": 8,
          "text": "Mocking the air with colours idly spread,",
          "plainText": "Mocking the air with colours idly spread",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0076",
          "number": 76,
          "speechLineNumber": 9,
          "text": "And find no check? Let us, my liege, to arms!",
          "plainText": "And find no check Let us my liege to arms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0077",
          "number": 77,
          "speechLineNumber": 10,
          "text": "Perchance the cardinal cannot make your peace;",
          "plainText": "Perchance the cardinal cannot make your peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0078",
          "number": 78,
          "speechLineNumber": 11,
          "text": "Or if he do, let it at least be said",
          "plainText": "Or if he do let it at least be said",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0079",
          "number": 79,
          "speechLineNumber": 12,
          "text": "They saw we had a purpose of defence.",
          "plainText": "They saw we had a purpose of defence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "Have thou the ordering of this present time.",
          "plainText": "Have thou the ordering of this present time",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-5-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-1-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "Away, then, with good courage! Yet, I know",
          "plainText": "Away then with good courage Yet I know",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-1-line-0082",
          "number": 82,
          "speechLineNumber": 2,
          "text": "Our party may well meet a prouder foe.",
          "plainText": "Our party may well meet a prouder foe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-1-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}