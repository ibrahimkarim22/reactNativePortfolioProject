    {
      "id": "king-john/sceneV_16.1/p@130209",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING JOHN.\nThe legate of the pope hath been with me,\nAnd I have made a happy peace with him;\nAnd he hath promis’d to dismiss the powers\nLed by the Dauphin.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
