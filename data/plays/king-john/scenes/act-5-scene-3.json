    {
      "id": "king-john/sceneV_16.3/p@141082",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING JOHN.\nHow goes the day with us? O, tell me, Hubert.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.3/p@141082/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141082/line-2",
          "start": 11,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2993363,
        "end": 2993449,
        "line": 108323,
        "column": 1,
        "path": "chap16/p@141082",
        "anchor": "sceneV_16.3"
      },
      "speakerLabel": "KING JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-john/sceneV_16.3/p@141172",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUBERT.\nBadly, I fear. How fares your majesty?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.3/p@141172/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141172/line-2",
          "start": 8,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2993453,
        "end": 2993529,
        "line": 108328,
        "column": 1,
        "path": "chap16/p@141172",
        "anchor": "sceneV_16.3"
      },
      "speakerLabel": "HUBERT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-john/sceneV_16.3/p@141252",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING JOHN.\nThis fever that hath troubled me so long\nLies heavy on me. O, my heart is sick!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.3/p@141252/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141252/line-2",
          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141252/line-3",
          "start": 52,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2993533,
        "end": 2993658,
        "line": 108333,
        "column": 1,
        "path": "chap16/p@141252",
        "anchor": "sceneV_16.3"
      },
      "speakerLabel": "KING JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-john/sceneV_16.3/p@141381",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter a Messenger.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 17,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-john/sceneV_16.3/p@141381/line-1",
          "start": 0,
          "end": 18,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2993662,
        "end": 2993735,
        "line": 108339,
        "column": 1,
        "path": "chap16/p@141381",
        "anchor": "sceneV_16.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-john/sceneV_16.3/p@141458",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nMy lord, your valiant kinsman, Faulconbridge,\nDesires your majesty to leave the field\nAnd send him word by me which way you go.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.3/p@141458/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141458/line-2",
          "start": 11,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141458/line-3",
          "start": 57,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141458/line-4",
          "start": 97,
          "end": 138,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2993739,
        "end": 2993917,
        "line": 108341,
        "column": 1,
        "path": "chap16/p@141458",
        "anchor": "sceneV_16.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-john/sceneV_16.3/p@141640",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING JOHN.\nTell him, toward Swinstead, to the abbey there.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.3/p@141640/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141640/line-2",
          "start": 11,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2993921,
        "end": 2994009,
        "line": 108348,
        "column": 1,
        "path": "chap16/p@141640",
        "anchor": "sceneV_16.3"
      },
      "speakerLabel": "KING JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-john/sceneV_16.3/p@141732",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nBe of good comfort; for the great supply\nThat was expected by the Dauphin here\nAre wrack’d three nights ago on Goodwin Sands.\nThis news was brought to Richard but even now.\nThe French fight coldly, and retire themselves.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.3/p@141732/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141732/line-2",
          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141732/line-3",
          "start": 52,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141732/line-4",
          "start": 90,
          "end": 136,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141732/line-5",
          "start": 137,
          "end": 183,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.3/p@141732/line-6",
          "start": 184,
          "end": 231,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2994013,
        "end": 2994294,
        "line": 108353,
        "column": 1,
        "path": "chap16/p@141732",
        "anchor": "sceneV_16.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-john/sceneV_16.3/p@142017",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING JOHN.\nAy me, this tyrant fever burns me up\nAnd will not let me welcome this good news.\nSet on toward Swinstead. To my litter straight.\nWeakness possesseth me, and I am faint.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.3/p@142017/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
