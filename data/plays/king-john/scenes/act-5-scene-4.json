    {
      "id": "king-john/sceneV_16.4/p@143875",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALISBURY.\nMay this be possible? May this be true?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.4/p@143875/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
