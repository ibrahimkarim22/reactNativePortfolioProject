        {
          "id": "king-john/sceneV_16.4/p@143875/line-2",
          "start": 11,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2996156,
        "end": 2996236,
        "line": 108437,
        "column": 1,
        "path": "chap16/p@143875",
        "anchor": "sceneV_16.4"
      },
      "speakerLabel": "SALISBURY.",
      "attribution": {
