    {
      "id": "king-john/sceneV_16.5/p@146177",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LOUIS.\nThe sun of heaven, methought, was loath to set,\nBut stay’d, and made the western welkin blush,\nWhen the English measure backward their own ground\nIn faint retire. O, bravely came we off,\nWhen with a volley of our needless shot,\nAfter such bloody toil, we bid good night,\nAnd wound our tott’ring colours clearly up,\nLast in the field, and almost lords of it!",
      "separatorAfter": "\n\n",
      "spans": [],
