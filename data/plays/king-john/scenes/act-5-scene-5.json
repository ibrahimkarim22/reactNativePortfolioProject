      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nWhoever spoke it, it is true, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
