    {
      "id": "king-john/sceneV_16.5/p@147053",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LOUIS.\nAh, foul shrewd news! Beshrew thy very heart!\nI did not think to be so sad tonight\nAs this hath made me. Who was he that said\nKing John did fly an hour or two before\nThe stumbling night did part our weary powers?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
