    {
      "id": "king-john/sceneV_16.5/p@146821",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nThe Count Melun is slain; the English lords\nBy his persuasion are again fall’n off,\nAnd your supply, which you have wish’d so long,\nAre cast away and sunk on Goodwin Sands.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
