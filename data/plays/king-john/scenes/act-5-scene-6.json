    {
      "id": "king-john/sceneV_16.6/p@150077",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUBERT.\nWhy, know you not? The lords are all come back,\nAnd brought Prince Henry in their company;\nAt whose request the King hath pardon’d them,\nAnd they are all about his majesty.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
