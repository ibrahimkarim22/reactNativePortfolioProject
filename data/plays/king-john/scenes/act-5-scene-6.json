      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nWho didst thou leave to tend his majesty?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
