      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 10,
          "end": 17,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 22,
          "end": 29,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@147732/line-1",
