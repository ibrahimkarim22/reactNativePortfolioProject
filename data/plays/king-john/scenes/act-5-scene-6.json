      }
    },
    {
      "id": "king-john/sceneV_16.6/p@147860",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUBERT.\nWho’s there? Speak, ho! Speak quickly, or I shoot.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@147860/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@147860/line-2",
          "start": 8,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3000141,
        "end": 3000229,
        "line": 108557,
        "column": 1,
        "path": "chap16/p@147860",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "HUBERT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@147952",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nA friend. What art thou?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@147952/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@147952/line-2",
          "start": 9,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3000233,
        "end": 3000296,
        "line": 108562,
        "column": 1,
        "path": "chap16/p@147952",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "BASTARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@148019",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUBERT.\nOf the part of England.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@148019/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148019/line-2",
          "start": 8,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3000300,
        "end": 3000361,
        "line": 108567,
        "column": 1,
        "path": "chap16/p@148019",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "HUBERT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@148084",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nWhither dost thou go?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@148084/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148084/line-2",
          "start": 9,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3000365,
        "end": 3000425,
        "line": 108572,
        "column": 1,
        "path": "chap16/p@148084",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "BASTARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@148148",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUBERT.\nWhat’s that to thee? Why may I not demand\nOf thine affairs, as well as thou of mine?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@148148/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148148/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148148/line-3",
          "start": 50,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3000429,
        "end": 3000556,
        "line": 108577,
        "column": 1,
        "path": "chap16/p@148148",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "HUBERT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@148279",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nHubert, I think.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@148279/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148279/line-2",
          "start": 9,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3000560,
        "end": 3000615,
        "line": 108583,
        "column": 1,
        "path": "chap16/p@148279",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "BASTARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@148338",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUBERT.\nThou hast a perfect thought.\nI will, upon all hazards, well believe\nThou art my friend, that know’st my tongue so well.\nWho art thou?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@148338/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148338/line-2",
          "start": 8,
          "end": 36,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148338/line-3",
          "start": 37,
          "end": 75,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148338/line-4",
          "start": 76,
          "end": 127,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148338/line-5",
          "start": 128,
          "end": 141,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3000619,
        "end": 3000805,
        "line": 108588,
        "column": 1,
        "path": "chap16/p@148338",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "HUBERT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@148528",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nWho thou wilt. And if thou please,\nThou mayst befriend me so much as to think\nI come one way of the Plantagenets.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@148528/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148528/line-2",
          "start": 9,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148528/line-3",
          "start": 44,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148528/line-4",
          "start": 87,
          "end": 122,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3000809,
        "end": 3000971,
        "line": 108596,
        "column": 1,
        "path": "chap16/p@148528",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "BASTARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@148694",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUBERT.\nUnkind remembrance! Thou and eyeless night\nHave done me shame. Brave soldier, pardon me,\nThat any accent breaking from thy tongue\nShould ’scape the true acquaintance of mine ear.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@148694/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148694/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148694/line-3",
          "start": 51,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148694/line-4",
          "start": 97,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148694/line-5",
          "start": 138,
          "end": 186,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3000975,
        "end": 3001206,
        "line": 108603,
        "column": 1,
        "path": "chap16/p@148694",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "HUBERT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@148929",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nCome, come; sans compliment, what news abroad?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@148929/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@148929/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3001210,
        "end": 3001295,
        "line": 108611,
        "column": 1,
        "path": "chap16/p@148929",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "BASTARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@149018",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUBERT.\nWhy, here walk I in the black brow of night,\nTo find you out.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@149018/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149018/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149018/line-3",
          "start": 53,
          "end": 69,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3001299,
        "end": 3001403,
        "line": 108616,
        "column": 1,
        "path": "chap16/p@149018",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "HUBERT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@149126",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nBrief, then; and what’s the news?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@149126/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149126/line-2",
          "start": 9,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3001407,
        "end": 3001479,
        "line": 108622,
        "column": 1,
        "path": "chap16/p@149126",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "BASTARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@149202",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUBERT.\nO, my sweet sir, news fitting to the night,\nBlack, fearful, comfortless, and horrible.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@149202/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149202/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149202/line-3",
          "start": 52,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3001483,
        "end": 3001612,
        "line": 108627,
        "column": 1,
        "path": "chap16/p@149202",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "HUBERT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@149335",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nShow me the very wound of this ill news.\nI am no woman, I’ll not swoon at it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@149335/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149335/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149335/line-3",
          "start": 50,
          "end": 86,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3001616,
        "end": 3001737,
        "line": 108633,
        "column": 1,
        "path": "chap16/p@149335",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "BASTARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@149460",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUBERT.\nThe King, I fear, is poison’d by a monk.\nI left him almost speechless, and broke out\nTo acquaint you with this evil, that you might\nThe better arm you to the sudden time,\nThan if you had at leisure known of this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@149460/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149460/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149460/line-3",
          "start": 49,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149460/line-4",
          "start": 93,
          "end": 139,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149460/line-5",
          "start": 140,
          "end": 178,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149460/line-6",
          "start": 179,
          "end": 220,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3001741,
        "end": 3002011,
        "line": 108639,
        "column": 1,
        "path": "chap16/p@149460",
        "anchor": "sceneV_16.6"
      },
      "speakerLabel": "HUBERT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-john/sceneV_16.6/p@149734",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nHow did he take it? Who did taste to him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-john/sceneV_16.6/p@149734/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-john/sceneV_16.6/p@149734/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3002015,
        "end": 3002095,
        "line": 108648,
        "column": 1,
