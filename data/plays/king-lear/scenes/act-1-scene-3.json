    {
      "id": "king-lear/sceneI_18.3/p@35433",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GONERIL.\nAnd let his knights have colder looks among you;\nWhat grows of it, no matter; advise your fellows so;\nI would breed from hence occasions, and I shall,\nThat I may speak. I’ll write straight to my sister\nTo hold my very course. Prepare for dinner.",
      "separatorAfter": "\n\n",
      "spans": [],
