    "scene": 3,
    "label": "Act 1, Scene 3",
    "title": "SCENE III. A Room in the Duke of Albany's Palace",
    "location": "A Room in the Duke of Albany's Palace",
    "orderInPlay": 3
  },
  "content": [
    {
      "id": "king-lear-1-3-stage-001",
      "type": "stage",
      "text": "Enter Goneril and Oswald."
    },
    {
      "id": "king-lear-1-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "goneril",
        "name": "GONERIL",
        "displayName": "Goneril"
      },
      "lines": [
        {
          "id": "king-lear-1-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Did my father strike my gentleman for chiding of his fool?",
          "plainText": "Did my father strike my gentleman for chiding of his fool",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-1-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Ay, madam.",
          "plainText": "Ay madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "goneril",
        "name": "GONERIL",
        "displayName": "Goneril"
      },
      "lines": [
        {
          "id": "king-lear-1-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "By day and night, he wrongs me; every hour",
          "plainText": "By day and night he wrongs me every hour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "He flashes into one gross crime or other,",
          "plainText": "He flashes into one gross crime or other",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "That sets us all at odds; I'll not endure it:",
          "plainText": "That sets us all at odds I'll not endure it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "His knights grow riotous, and himself upbraids us",
          "plainText": "His knights grow riotous and himself upbraids us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0007",
          "number": 7,
          "speechLineNumber": 5,
          "text": "On every trifle. When he returns from hunting,",
          "plainText": "On every trifle When he returns from hunting",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0008",
          "number": 8,
          "speechLineNumber": 6,
          "text": "I will not speak with him; say I am sick.",
          "plainText": "I will not speak with him say I am sick",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0009",
          "number": 9,
          "speechLineNumber": 7,
          "text": "If you come slack of former services,",
          "plainText": "If you come slack of former services",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0010",
          "number": 10,
          "speechLineNumber": 8,
          "text": "You shall do well; the fault of it I'll answer.",
          "plainText": "You shall do well the fault of it I'll answer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-1-3-stage-002",
      "type": "stage",
      "text": "[Horns within.]"
    },
    {
      "id": "king-lear-1-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-1-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "He's coming, madam; I hear him.",
          "plainText": "He's coming madam I hear him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "goneril",
        "name": "GONERIL",
        "displayName": "Goneril"
      },
      "lines": [
        {
          "id": "king-lear-1-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Put on what weary negligence you please,",
          "plainText": "Put on what weary negligence you please",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "You and your fellows; I'd have it come to question:",
          "plainText": "You and your fellows I'd have it come to question",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "If he distaste it, let him to our sister,",
          "plainText": "If he distaste it let him to our sister",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "Whose mind and mine, I know, in that are one,",
          "plainText": "Whose mind and mine I know in that are one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "Not to be overruled. Idle old man,",
          "plainText": "Not to be overruled Idle old man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "That still would manage those authorities",
          "plainText": "That still would manage those authorities",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0018",
          "number": 18,
          "speechLineNumber": 7,
          "text": "That he hath given away! Now, by my life,",
          "plainText": "That he hath given away Now by my life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0019",
          "number": 19,
          "speechLineNumber": 8,
          "text": "Old fools are babes again; and must be us'd",
          "plainText": "Old fools are babes again and must be us'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0020",
          "number": 20,
          "speechLineNumber": 9,
          "text": "With checks as flatteries, when they are seen abus'd.",
          "plainText": "With checks as flatteries when they are seen abus'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0021",
          "number": 21,
          "speechLineNumber": 10,
          "text": "Remember what I have said.",
          "plainText": "Remember what I have said",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-1-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-1-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Very well, madam.",
          "plainText": "Very well madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "goneril",
        "name": "GONERIL",
        "displayName": "Goneril"
      },
      "lines": [
        {
          "id": "king-lear-1-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "And let his knights have colder looks among you;",
          "plainText": "And let his knights have colder looks among you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "What grows of it, no matter; advise your fellows so;",
          "plainText": "What grows of it no matter advise your fellows so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "I would breed from hence occasions, and I shall,",
          "plainText": "I would breed from hence occasions and I shall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "That I may speak. I'll write straight to my sister",
          "plainText": "That I may speak I'll write straight to my sister",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-3-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "To hold my very course. Prepare for dinner.",
          "plainText": "To hold my very course Prepare for dinner",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-1-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}