    {
      "id": "king-lear/sceneI_18.5/p@57247",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FOOL.\nIf a man’s brains were in’s heels, were’t not in danger of kibes?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@57247/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@57247/line-2",
          "start": 6,
          "end": 71,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3230702,
        "end": 3230804,
        "line": 117746,
        "column": 1,
        "path": "chap18/p@57247",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "FOOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@57353",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEAR.\nAy, boy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@57353/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@57353/line-2",
          "start": 6,
          "end": 14,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3230808,
        "end": 3230852,
        "line": 117752,
        "column": 1,
        "path": "chap18/p@57353",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "LEAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@57401",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FOOL.\nThen I prithee be merry; thy wit shall not go slipshod.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@57401/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@57401/line-2",
          "start": 6,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3230856,
        "end": 3230947,
        "line": 117757,
        "column": 1,
        "path": "chap18/p@57401",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "FOOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@57496",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEAR.\nHa, ha, ha!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@57496/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@57496/line-2",
          "start": 6,
          "end": 17,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3230951,
        "end": 3230998,
        "line": 117762,
        "column": 1,
        "path": "chap18/p@57496",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "LEAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@57547",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FOOL.\nShalt see thy other daughter will use thee kindly, for though she’s as like this as a crab’s like an apple, yet I can tell what I can tell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@57547/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@57547/line-2",
          "start": 6,
          "end": 145,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231002,
        "end": 3231177,
        "line": 117767,
        "column": 1,
        "path": "chap18/p@57547",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "FOOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@57726",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEAR.\nWhat canst tell, boy?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@57726/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@57726/line-2",
          "start": 6,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231181,
        "end": 3231238,
        "line": 117773,
        "column": 1,
        "path": "chap18/p@57726",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "LEAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@57787",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FOOL.\nShe’ll taste as like this as a crab does to a crab. Thou canst tell why one’s nose stands i’the middle on’s face?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@57787/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@57787/line-2",
          "start": 6,
          "end": 119,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231242,
        "end": 3231390,
        "line": 117778,
        "column": 1,
        "path": "chap18/p@57787",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "FOOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@57939",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEAR.\nNo.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@57939/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@57939/line-2",
          "start": 6,
          "end": 9,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231394,
        "end": 3231433,
        "line": 117783,
        "column": 1,
        "path": "chap18/p@57939",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "LEAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@57982",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FOOL.\nWhy, to keep one’s eyes of either side’s nose, that what a man cannot smell out, he may spy into.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@57982/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@57982/line-2",
          "start": 6,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231437,
        "end": 3231569,
        "line": 117788,
        "column": 1,
        "path": "chap18/p@57982",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "FOOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@58118",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEAR.\nI did her wrong.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@58118/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@58118/line-2",
          "start": 6,
          "end": 22,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231573,
        "end": 3231625,
        "line": 117793,
        "column": 1,
        "path": "chap18/p@58118",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "LEAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@58174",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FOOL.\nCanst tell how an oyster makes his shell?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@58174/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@58174/line-2",
          "start": 6,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231629,
        "end": 3231706,
        "line": 117798,
        "column": 1,
        "path": "chap18/p@58174",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "FOOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@58255",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEAR.\nNo.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@58255/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@58255/line-2",
          "start": 6,
          "end": 9,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231710,
        "end": 3231749,
        "line": 117803,
        "column": 1,
        "path": "chap18/p@58255",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "LEAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@58298",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FOOL.\nNor I neither; but I can tell why a snail has a house.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@58298/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@58298/line-2",
          "start": 6,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231753,
        "end": 3231843,
        "line": 117808,
        "column": 1,
        "path": "chap18/p@58298",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "FOOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@58392",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEAR.\nWhy?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@58392/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@58392/line-2",
          "start": 6,
          "end": 10,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231847,
        "end": 3231887,
        "line": 117813,
        "column": 1,
        "path": "chap18/p@58392",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "LEAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@58436",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FOOL.\nWhy, to put’s head in; not to give it away to his daughters, and leave his horns without a case.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@58436/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@58436/line-2",
          "start": 6,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3231891,
        "end": 3232022,
        "line": 117818,
        "column": 1,
        "path": "chap18/p@58436",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "FOOL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@58571",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEAR.\nI will forget my nature. So kind a father! Be my horses ready?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@58571/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@58571/line-2",
          "start": 6,
          "end": 68,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3232026,
