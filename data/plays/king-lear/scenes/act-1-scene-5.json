    {
      "id": "king-lear/sceneI_18.5/p@56857",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEAR.\nGo you before to Gloucester with these letters: acquaint my daughter no further with anything you know than comes from her demand out of the letter. If your diligence be not speedy, I shall be there afore you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@56857/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@56857/line-2",
          "start": 6,
          "end": 215,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3230312,
        "end": 3230558,
        "line": 117732,
        "column": 1,
        "path": "chap18/p@56857",
        "anchor": "sceneI_18.5"
      },
      "speakerLabel": "LEAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneI_18.5/p@57107",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KENT.\nI will not sleep, my lord, till I have delivered your letter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneI_18.5/p@57107/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneI_18.5/p@57107/line-2",
          "start": 6,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
