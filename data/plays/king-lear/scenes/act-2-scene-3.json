    "label": "Act 2, Scene 3",
    "title": "SCENE III. The open Country",
    "location": "The open Country",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "king-lear-2-3-stage-001",
      "type": "stage",
      "text": "Enter Edgar."
    },
    {
      "id": "king-lear-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I heard myself proclaim'd,",
          "plainText": "I heard myself proclaim'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And by the happy hollow of a tree",
          "plainText": "And by the happy hollow of a tree",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Escap'd the hunt. No port is free, no place",
          "plainText": "Escap'd the hunt No port is free no place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "That guard and most unusual vigilance",
          "plainText": "That guard and most unusual vigilance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Does not attend my taking. While I may scape",
          "plainText": "Does not attend my taking While I may scape",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "I will preserve myself: and am bethought",
          "plainText": "I will preserve myself and am bethought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "To take the basest and most poorest shape",
          "plainText": "To take the basest and most poorest shape",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "That ever penury in contempt of man,",
          "plainText": "That ever penury in contempt of man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Brought near to beast: my face I'll grime with filth,",
          "plainText": "Brought near to beast my face I'll grime with filth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Blanket my loins; elf all my hair in knots,",
          "plainText": "Blanket my loins elf all my hair in knots",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "And with presented nakedness outface",
          "plainText": "And with presented nakedness outface",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "The winds and persecutions of the sky.",
          "plainText": "The winds and persecutions of the sky",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "The country gives me proof and precedent",
          "plainText": "The country gives me proof and precedent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Of Bedlam beggars, who, with roaring voices,",
          "plainText": "Of Bedlam beggars who with roaring voices",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "Strike in their numb'd and mortified bare arms",
          "plainText": "Strike in their numb'd and mortified bare arms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "Pins, wooden pricks, nails, sprigs of rosemary;",
          "plainText": "Pins wooden pricks nails sprigs of rosemary",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "And with this horrible object, from low farms,",
          "plainText": "And with this horrible object from low farms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Poor pelting villages, sheep-cotes, and mills,",
          "plainText": "Poor pelting villages sheepcotes and mills",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "Sometime with lunatic bans, sometime with prayers,",
          "plainText": "Sometime with lunatic bans sometime with prayers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "Enforce their charity. Poor Turlygod! poor Tom,",
          "plainText": "Enforce their charity Poor Turlygod poor Tom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "That's something yet: Edgar I nothing am.",
          "plainText": "That's something yet Edgar I nothing am",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-2-3-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}