    {
      "id": "king-lear/sceneIII_18.1/p@101409",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GENTLEMAN.\nNone but the fool, who labours to out-jest\nHis heart-struck injuries.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.1/p@101409/line-1",
