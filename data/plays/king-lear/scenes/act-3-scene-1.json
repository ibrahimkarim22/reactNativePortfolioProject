    {
      "id": "king-lear/sceneIII_18.1/p@102858",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KENT.\nNo, do not.\nFor confirmation that I am much more\nThan my out-wall, open this purse, and take\nWhat it contains. If you shall see Cordelia,\nAs fear not but you shall, show her this ring;\nAnd she will tell you who your fellow is\nThat yet you do not know. Fie on this storm!\nI will go seek the King.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
