        {
          "id": "king-lear/sceneIII_18.1/p@101409/line-3",
          "start": 54,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3274864,
        "end": 3274979,
        "line": 119517,
        "column": 1,
        "path": "chap18/p@101409",
