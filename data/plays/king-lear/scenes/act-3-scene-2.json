    {
      "id": "king-lear/sceneIII_18.2/p@104269",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FOOL.\nO nuncle, court holy-water in a dry house is better than this rain-water out o’ door. Good nuncle, in; and ask thy daughters blessing: here’s a night pities neither wise men nor fools.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
