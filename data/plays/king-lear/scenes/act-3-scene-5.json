      }
    },
    {
      "id": "king-lear/sceneIII_18.5/p@122156",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORNWALL.\nI will have my revenge ere I depart his house.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.5/p@122156/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIII_18.5/p@122156/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3295611,
        "end": 3295697,
        "line": 120228,
        "column": 1,
        "path": "chap18/p@122156",
        "anchor": "sceneIII_18.5"
      },
      "speakerLabel": "CORNWALL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-lear/sceneIII_18.5/p@122246",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\nHow, my lord, I may be censured, that nature thus gives way to loyalty, something fears me to think of.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.5/p@122246/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIII_18.5/p@122246/line-2",
          "start": 8,
          "end": 111,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3295701,
        "end": 3295841,
        "line": 120233,
        "column": 1,
        "path": "chap18/p@122246",
        "anchor": "sceneIII_18.5"
      },
      "speakerLabel": "EDMUND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneIII_18.5/p@122390",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORNWALL.\nI now perceive it was not altogether your brother’s evil disposition made him seek his death; but a provoking merit, set a-work by a reproveable badness in himself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.5/p@122390/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIII_18.5/p@122390/line-2",
          "start": 10,
          "end": 174,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3295845,
        "end": 3296049,
        "line": 120238,
        "column": 1,
        "path": "chap18/p@122390",
        "anchor": "sceneIII_18.5"
      },
      "speakerLabel": "CORNWALL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-lear/sceneIII_18.5/p@122598",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\nHow malicious is my fortune, that I must repent to be just! This is the letter he spoke of, which approves him an intelligent party to the advantages of France. O heavens! that this treason were not; or not I the detector!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.5/p@122598/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIII_18.5/p@122598/line-2",
          "start": 8,
          "end": 230,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3296053,
        "end": 3296314,
        "line": 120244,
        "column": 1,
        "path": "chap18/p@122598",
        "anchor": "sceneIII_18.5"
      },
      "speakerLabel": "EDMUND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneIII_18.5/p@122863",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORNWALL.\nGo with me to the Duchess.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.5/p@122863/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIII_18.5/p@122863/line-2",
          "start": 10,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3296318,
        "end": 3296384,
        "line": 120251,
        "column": 1,
        "path": "chap18/p@122863",
        "anchor": "sceneIII_18.5"
      },
      "speakerLabel": "CORNWALL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-lear/sceneIII_18.5/p@122933",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\nIf the matter of this paper be certain, you have mighty business in hand.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.5/p@122933/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIII_18.5/p@122933/line-2",
          "start": 8,
          "end": 81,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3296388,
        "end": 3296498,
        "line": 120256,
        "column": 1,
        "path": "chap18/p@122933",
        "anchor": "sceneIII_18.5"
      },
      "speakerLabel": "EDMUND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneIII_18.5/p@123047",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORNWALL.\nTrue or false, it hath made thee Earl of Gloucester. Seek out where thy father is, that he may be ready for our apprehension.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.5/p@123047/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIII_18.5/p@123047/line-2",
          "start": 10,
          "end": 135,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3296502,
        "end": 3296666,
        "line": 120261,
        "column": 1,
        "path": "chap18/p@123047",
        "anchor": "sceneIII_18.5"
      },
      "speakerLabel": "CORNWALL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-lear/sceneIII_18.5/p@123215",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\n[Aside.] If I find him comforting the King, it will stuff his suspicion more fully. I will persever in my course of loyalty, though the conflict be sore between that and my blood.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 9,
          "end": 15
        }
      ],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.5/p@123215/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIII_18.5/p@123215/line-2",
          "start": 8,
          "end": 187,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3296670,
        "end": 3296894,
        "line": 120266,
        "column": 1,
        "path": "chap18/p@123215",
        "anchor": "sceneIII_18.5"
      },
      "speakerLabel": "EDMUND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneIII_18.5/p@123443",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORNWALL.\nI will lay trust upon thee; and thou shalt find a dearer father in my love.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.5/p@123443/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIII_18.5/p@123443/line-2",
          "start": 10,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3296898,
        "end": 3297012,
        "line": 120272,
        "column": 1,
        "path": "chap18/p@123443",
        "anchor": "sceneIII_18.5"
      },
      "speakerLabel": "CORNWALL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-lear/sceneIII_18.5/p@123561",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 8
        }
      ],
