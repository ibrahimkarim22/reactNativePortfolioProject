        }
      ],
      "lines": [
        {
          "id": "king-lear/sceneIII_18.5/p@122041/line-1",
          "start": 0,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3295496,
        "end": 3295607,
        "line": 120226,
        "column": 1,
