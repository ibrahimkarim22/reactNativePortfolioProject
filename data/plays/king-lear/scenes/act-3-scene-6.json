  "scene": {
    "id": "king-lear-3-6",
    "act": 3,
    "scene": 6,
    "label": "Act 3, Scene 6",
    "title": "SCENE VI. A Chamber in a Farmhouse adjoining the Castle",
    "location": "A Chamber in a Farmhouse adjoining the Castle",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "king-lear-3-6-stage-001",
      "type": "stage",
      "text": "Enter Gloucester, Lear, Kent, Fool and Edgar."
    },
    {
      "id": "king-lear-3-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Here is better than the open air; take it thankfully. I will piece out the comfort with what addition I can: I will not be long from you.",
          "plainText": "Here is better than the open air take it thankfully I will piece out the comfort with what addition I can I will not be long from you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "All the power of his wits have given way to his impatience:— the gods reward your kindness!",
          "plainText": "All the power of his wits have given way to his impatience the gods reward your kindness",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-stage-002",
      "type": "stage",
      "text": "[Exit Gloucester.]"
    },
    {
      "id": "king-lear-3-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Frateretto calls me; and tells me Nero is an angler in the lake of darkness. Pray, innocent, and beware the foul fiend.",
          "plainText": "Frateretto calls me and tells me Nero is an angler in the lake of darkness Pray innocent and beware the foul fiend",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Prithee, nuncle, tell me whether a madman be a gentleman or a yeoman.",
          "plainText": "Prithee nuncle tell me whether a madman be a gentleman or a yeoman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "A king, a king!",
          "plainText": "A king a king",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "No, he's a yeoman that has a gentleman to his son; for he's a mad yeoman that sees his son a gentleman before him.",
          "plainText": "No he's a yeoman that has a gentleman to his son for he's a mad yeoman that sees his son a gentleman before him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "To have a thousand with red burning spits",
          "plainText": "To have a thousand with red burning spits",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Come hissing in upon 'em.",
          "plainText": "Come hissing in upon 'em",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-008",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "The foul fiend bites my back.",
          "plainText": "The foul fiend bites my back",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-009",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "He's mad that trusts in the tameness of a wolf, a horse's health, a boy's love, or a whore's oath.",
          "plainText": "He's mad that trusts in the tameness of a wolf a horse's health a boy's love or a whore's oath",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-010",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "It shall be done; I will arraign them straight.",
          "plainText": "It shall be done I will arraign them straight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "[To Edgar.] Come, sit thou here, most learned justicer;",
          "plainText": "To Edgar Come sit thou here most learned justicer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "[To the Fool.] Thou, sapient sir, sit here. Now, you she-foxes!—",
          "plainText": "To the Fool Thou sapient sir sit here Now you shefoxes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-011",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Look, where he stands and glares! Want'st thou eyes at trial, madam?",
          "plainText": "Look where he stands and glares Want'st thou eyes at trial madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Come o'er the bourn, Bessy, to me.",
          "plainText": "Come o'er the bourn Bessy to me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-012",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Her boat hath a leak,",
          "plainText": "Her boat hath a leak",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "And she must not speak",
          "plainText": "And she must not speak",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Why she dares not come over to thee.",
          "plainText": "Why she dares not come over to thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-013",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "The foul fiend haunts poor Tom in the voice of a nightingale. Hoppedance cries in Tom's belly for two white herring. Croak not, black angel; I have no food for thee.",
          "plainText": "The foul fiend haunts poor Tom in the voice of a nightingale Hoppedance cries in Tom's belly for two white herring Croak not black angel I have no food for thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-014",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "How do you, sir? Stand you not so amaz'd;",
          "plainText": "How do you sir Stand you not so amaz'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Will you lie down and rest upon the cushions?",
          "plainText": "Will you lie down and rest upon the cushions",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-015",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I'll see their trial first. Bring in their evidence.",
          "plainText": "I'll see their trial first Bring in their evidence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "[To Edgar.] Thou, robed man of justice, take thy place.",
          "plainText": "To Edgar Thou robed man of justice take thy place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "[To the Fool.] And thou, his yokefellow of equity,",
          "plainText": "To the Fool And thou his yokefellow of equity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Bench by his side. [To Kent.] You are o' the commission,",
          "plainText": "Bench by his side To Kent You are o' the commission",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "Sit you too.",
          "plainText": "Sit you too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-016",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Let us deal justly.",
          "plainText": "Let us deal justly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Sleepest or wakest thou, jolly shepherd?",
          "plainText": "Sleepest or wakest thou jolly shepherd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "Thy sheep be in the corn;",
          "plainText": "Thy sheep be in the corn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "And for one blast of thy minikin mouth",
          "plainText": "And for one blast of thy minikin mouth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "Thy sheep shall take no harm.",
          "plainText": "Thy sheep shall take no harm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0032",
          "number": 32,
          "speechLineNumber": 6,
          "text": "Purr! the cat is grey.",
          "plainText": "Purr the cat is grey",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-017",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Arraign her first; 'tis Goneril. I here take my oath before this honourable assembly, she kicked the poor King her father.",
          "plainText": "Arraign her first 'tis Goneril I here take my oath before this honourable assembly she kicked the poor King her father",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-018",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Come hither, mistress. Is your name Goneril?",
          "plainText": "Come hither mistress Is your name Goneril",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-019",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "She cannot deny it.",
          "plainText": "She cannot deny it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-020",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Cry you mercy, I took you for a joint-stool.",
          "plainText": "Cry you mercy I took you for a jointstool",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-021",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "And here's another, whose warp'd looks proclaim",
          "plainText": "And here's another whose warp'd looks proclaim",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "What store her heart is made on. Stop her there!",
          "plainText": "What store her heart is made on Stop her there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "Arms, arms! sword! fire! Corruption in the place!",
          "plainText": "Arms arms sword fire Corruption in the place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "False justicer, why hast thou let her 'scape?",
          "plainText": "False justicer why hast thou let her 'scape",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-022",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Bless thy five wits!",
          "plainText": "Bless thy five wits",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-023",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "O pity! Sir, where is the patience now",
          "plainText": "O pity Sir where is the patience now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "That you so oft have boasted to retain?",
          "plainText": "That you so oft have boasted to retain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-024",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "[Aside.] My tears begin to take his part so much",
          "plainText": "Aside My tears begin to take his part so much",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "They mar my counterfeiting.",
          "plainText": "They mar my counterfeiting",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-025",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "The little dogs and all,",
          "plainText": "The little dogs and all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Trey, Blanch, and Sweetheart, see, they bark at me.",
          "plainText": "Trey Blanch and Sweetheart see they bark at me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-026",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Tom will throw his head at them. Avaunt, you curs!",
          "plainText": "Tom will throw his head at them Avaunt you curs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "Be thy mouth or black or white,",
          "plainText": "Be thy mouth or black or white",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "Tooth that poisons if it bite;",
          "plainText": "Tooth that poisons if it bite",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "Mastiff, greyhound, mongrel grim,",
          "plainText": "Mastiff greyhound mongrel grim",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0052",
          "number": 52,
          "speechLineNumber": 5,
          "text": "Hound or spaniel, brach or him,",
          "plainText": "Hound or spaniel brach or him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0053",
          "number": 53,
          "speechLineNumber": 6,
          "text": "Or bobtail tike or trundle-tail,",
          "plainText": "Or bobtail tike or trundletail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0054",
          "number": 54,
          "speechLineNumber": 7,
          "text": "Tom will make them weep and wail;",
          "plainText": "Tom will make them weep and wail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0055",
          "number": 55,
          "speechLineNumber": 8,
          "text": "For, with throwing thus my head,",
          "plainText": "For with throwing thus my head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0056",
          "number": 56,
          "speechLineNumber": 9,
          "text": "Dogs leap the hatch, and all are fled.",
          "plainText": "Dogs leap the hatch and all are fled",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0057",
          "number": 57,
          "speechLineNumber": 10,
          "text": "Do, de, de, de. Sessa! Come, march to wakes and fairs and market towns. Poor Tom, thy horn is dry.",
          "plainText": "Do de de de Sessa Come march to wakes and fairs and market towns Poor Tom thy horn is dry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-027",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Then let them anatomize Regan; see what breeds about her heart. Is there any cause in nature that makes these hard hearts? [To Edgar.] You, sir, I entertain you for one of my hundred; only I do not like the fashion of your garments. You'll say they are Persian; but let them be changed.",
          "plainText": "Then let them anatomize Regan see what breeds about her heart Is there any cause in nature that makes these hard hearts To Edgar You sir I entertain you for one of my hundred only I do not like the fashion of your garments You'll say they are Persian but let them be changed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-028",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Now, good my lord, lie here and rest awhile.",
          "plainText": "Now good my lord lie here and rest awhile",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-029",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Make no noise, make no noise; draw the curtains.",
          "plainText": "Make no noise make no noise draw the curtains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "So, so. We'll go to supper i' the morning.",
          "plainText": "So so We'll go to supper i' the morning",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-030",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "And I'll go to bed at noon.",
          "plainText": "And I'll go to bed at noon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-stage-003",
      "type": "stage",
      "text": "Enter Gloucester."
    },
    {
      "id": "king-lear-3-6-speech-031",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Come hither, friend;",
          "plainText": "Come hither friend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "Where is the King my master?",
          "plainText": "Where is the King my master",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-032",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Here, sir; but trouble him not, his wits are gone.",
          "plainText": "Here sir but trouble him not his wits are gone",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-033",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Good friend, I prithee, take him in thy arms;",
          "plainText": "Good friend I prithee take him in thy arms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "I have o'erheard a plot of death upon him;",
          "plainText": "I have o'erheard a plot of death upon him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0068",
          "number": 68,
          "speechLineNumber": 3,
          "text": "There is a litter ready; lay him in't",
          "plainText": "There is a litter ready lay him in't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0069",
          "number": 69,
          "speechLineNumber": 4,
          "text": "And drive towards Dover, friend, where thou shalt meet",
          "plainText": "And drive towards Dover friend where thou shalt meet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0070",
          "number": 70,
          "speechLineNumber": 5,
          "text": "Both welcome and protection. Take up thy master;",
          "plainText": "Both welcome and protection Take up thy master",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0071",
          "number": 71,
          "speechLineNumber": 6,
          "text": "If thou shouldst dally half an hour, his life,",
          "plainText": "If thou shouldst dally half an hour his life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0072",
          "number": 72,
          "speechLineNumber": 7,
          "text": "With thine, and all that offer to defend him,",
          "plainText": "With thine and all that offer to defend him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0073",
          "number": 73,
          "speechLineNumber": 8,
          "text": "Stand in assured loss. Take up, take up;",
          "plainText": "Stand in assured loss Take up take up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0074",
          "number": 74,
          "speechLineNumber": 9,
          "text": "And follow me, that will to some provision",
          "plainText": "And follow me that will to some provision",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0075",
          "number": 75,
          "speechLineNumber": 10,
          "text": "Give thee quick conduct.",
          "plainText": "Give thee quick conduct",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-034",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Oppressed nature sleeps.",
          "plainText": "Oppressed nature sleeps",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0077",
          "number": 77,
          "speechLineNumber": 2,
          "text": "This rest might yet have balm'd thy broken sinews,",
          "plainText": "This rest might yet have balm'd thy broken sinews",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0078",
          "number": 78,
          "speechLineNumber": 3,
          "text": "Which, if convenience will not allow,",
          "plainText": "Which if convenience will not allow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0079",
          "number": 79,
          "speechLineNumber": 4,
          "text": "Stand in hard cure. Come, help to bear thy master;",
          "plainText": "Stand in hard cure Come help to bear thy master",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0080",
          "number": 80,
          "speechLineNumber": 5,
          "text": "[To the Fool.] Thou must not stay behind.",
          "plainText": "To the Fool Thou must not stay behind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-6-speech-035",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "Come, come, away!",
          "plainText": "Come come away",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-6-stage-004",
      "type": "stage",
      "text": "[Exeunt Kent, Gloucester and the Fool bearing off Lear.]"
    },
    {
      "id": "king-lear-3-6-speech-036",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-3-6-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "When we our betters see bearing our woes,",
          "plainText": "When we our betters see bearing our woes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0083",
          "number": 83,
          "speechLineNumber": 2,
          "text": "We scarcely think our miseries our foes.",
          "plainText": "We scarcely think our miseries our foes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0084",
          "number": 84,
          "speechLineNumber": 3,
          "text": "Who alone suffers, suffers most i' the mind,",
          "plainText": "Who alone suffers suffers most i' the mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0085",
          "number": 85,
          "speechLineNumber": 4,
          "text": "Leaving free things and happy shows behind:",
          "plainText": "Leaving free things and happy shows behind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0086",
          "number": 86,
          "speechLineNumber": 5,
          "text": "But then the mind much sufferance doth o'erskip",
          "plainText": "But then the mind much sufferance doth o'erskip",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0087",
          "number": 87,
          "speechLineNumber": 6,
          "text": "When grief hath mates, and bearing fellowship.",
          "plainText": "When grief hath mates and bearing fellowship",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0088",
          "number": 88,
          "speechLineNumber": 7,
          "text": "How light and portable my pain seems now,",
          "plainText": "How light and portable my pain seems now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0089",
          "number": 89,
          "speechLineNumber": 8,
          "text": "When that which makes me bend makes the King bow;",
          "plainText": "When that which makes me bend makes the King bow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0090",
          "number": 90,
          "speechLineNumber": 9,
          "text": "He childed as I fathered! Tom, away!",
          "plainText": "He childed as I fathered Tom away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0091",
          "number": 91,
          "speechLineNumber": 10,
          "text": "Mark the high noises; and thyself bewray,",
          "plainText": "Mark the high noises and thyself bewray",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0092",
          "number": 92,
          "speechLineNumber": 11,
          "text": "When false opinion, whose wrong thoughts defile thee,",
          "plainText": "When false opinion whose wrong thoughts defile thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-6-line-0093",
          "number": 93,
          "speechLineNumber": 12,
          "text": "In thy just proof repeals and reconciles thee.",
          "plainText": "In thy just proof repeals and reconciles thee",
