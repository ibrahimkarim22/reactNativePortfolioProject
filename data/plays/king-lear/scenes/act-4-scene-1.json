    {
      "id": "king-lear/sceneIV_18.1/p@139794",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDGAR.\nYet better thus, and known to be contemn’d,\nThan still contemn’d and flatter’d. To be worst,\nThe lowest and most dejected thing of fortune,\nStands still in esperance, lives not in fear:\nThe lamentable change is from the best;\nThe worst returns to laughter. Welcome then,\nThou unsubstantial air that I embrace;\nThe wretch that thou hast blown unto the worst\nOwes nothing to thy blasts.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
