    {
      "id": "king-lear/sceneIV_18.1/p@140385",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "But who comes here? My father, poorly led?\nWorld, world, O world!\nBut that thy strange mutations make us hate thee,\nLife would not yield to age.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
