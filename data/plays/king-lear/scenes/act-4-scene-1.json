          "start": 7,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@141540/line-3",
          "start": 57,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3314995,
        "end": 3315136,
        "line": 120995,
        "column": 1,
        "path": "chap18/p@141540",
        "anchor": "sceneIV_18.1"
      },
      "speakerLabel": "EDGAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneIV_18.1/p@141685",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OLD MAN.\nFellow, where goest?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@141685/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@141685/line-2",
          "start": 9,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3315140,
        "end": 3315199,
        "line": 121001,
        "column": 1,
        "path": "chap18/p@141685",
        "anchor": "sceneIV_18.1"
      },
      "speakerLabel": "OLD MAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-lear/sceneIV_18.1/p@141748",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nIs it a beggar-man?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@141748/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@141748/line-2",
          "start": 12,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3315203,
        "end": 3315264,
        "line": 121006,
        "column": 1,
        "path": "chap18/p@141748",
        "anchor": "sceneIV_18.1"
      },
      "speakerLabel": "GLOUCESTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-lear/sceneIV_18.1/p@141813",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OLD MAN.\nMadman, and beggar too.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@141813/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@141813/line-2",
          "start": 9,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3315268,
        "end": 3315330,
        "line": 121011,
        "column": 1,
        "path": "chap18/p@141813",
        "anchor": "sceneIV_18.1"
      },
      "speakerLabel": "OLD MAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-lear/sceneIV_18.1/p@141879",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nHe has some reason, else he could not beg.\nI’ the last night’s storm I such a fellow saw;\nWhich made me think a man a worm. My son\nCame then into my mind, and yet my mind\nWas then scarce friends with him.\nI have heard more since.\nAs flies to wanton boys are we to the gods,\nThey kill us for their sport.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@141879/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
