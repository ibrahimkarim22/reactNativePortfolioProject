        "end": 3314794,
        "line": 120978,
        "column": 1,
        "path": "chap18/p@141279",
        "anchor": "sceneIV_18.1"
      },
      "speakerLabel": "OLD MAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-lear/sceneIV_18.1/p@141343",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDGAR.\n[Aside.] O gods! Who is’t can say ‘I am at the worst’?\nI am worse than e’er I was.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 8,
          "end": 14
        }
      ],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@141343/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@141343/line-2",
          "start": 7,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@141343/line-3",
          "start": 62,
          "end": 89,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3314798,
        "end": 3314930,
        "line": 120983,
        "column": 1,
        "path": "chap18/p@141343",
        "anchor": "sceneIV_18.1"
      },
      "speakerLabel": "EDGAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneIV_18.1/p@141479",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OLD MAN.\n’Tis poor mad Tom.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@141479/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@141479/line-2",
          "start": 9,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3314934,
        "end": 3314991,
        "line": 120990,
        "column": 1,
        "path": "chap18/p@141479",
        "anchor": "sceneIV_18.1"
      },
      "speakerLabel": "OLD MAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-lear/sceneIV_18.1/p@141540",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDGAR.\n[Aside.] And worse I may be yet. The worst is not\nSo long as we can say ‘This is the worst.’",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 8,
          "end": 14
        }
      ],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@141540/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
