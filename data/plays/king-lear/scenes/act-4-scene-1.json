    {
      "id": "king-lear/sceneIV_18.1/p@140573",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OLD MAN.\nO my good lord, I have been your tenant, and your father’s tenant these fourscore years.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@140573/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@140573/line-2",
          "start": 9,
          "end": 97,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3314028,
        "end": 3314156,
        "line": 120949,
        "column": 1,
        "path": "chap18/p@140573",
        "anchor": "sceneIV_18.1"
      },
      "speakerLabel": "OLD MAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-lear/sceneIV_18.1/p@140705",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nAway, get thee away; good friend, be gone.\nThy comforts can do me no good at all;\nThee they may hurt.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@140705/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@140705/line-2",
          "start": 12,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@140705/line-3",
          "start": 55,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@140705/line-4",
          "start": 94,
          "end": 113,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3314160,
        "end": 3314313,
        "line": 120955,
        "column": 1,
        "path": "chap18/p@140705",
        "anchor": "sceneIV_18.1"
      },
      "speakerLabel": "GLOUCESTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-lear/sceneIV_18.1/p@140862",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OLD MAN.\nYou cannot see your way.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@140862/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@140862/line-2",
          "start": 9,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3314317,
        "end": 3314380,
        "line": 120962,
        "column": 1,
        "path": "chap18/p@140862",
        "anchor": "sceneIV_18.1"
      },
      "speakerLabel": "OLD MAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-lear/sceneIV_18.1/p@140929",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nI have no way, and therefore want no eyes;\nI stumbled when I saw. Full oft ’tis seen\nOur means secure us, and our mere defects\nProve our commodities. O dear son Edgar,\nThe food of thy abused father’s wrath!\nMight I but live to see thee in my touch,\nI’d say I had eyes again!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@140929/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@140929/line-2",
          "start": 12,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@140929/line-3",
          "start": 55,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@140929/line-4",
          "start": 97,
          "end": 138,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.1/p@140929/line-5",
          "start": 139,
          "end": 179,
          "sourceLineNumber": null
        },
        {
