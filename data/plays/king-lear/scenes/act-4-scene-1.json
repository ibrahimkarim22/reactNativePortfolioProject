      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OLD MAN.\nHow now! Who’s there?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.1/p@141279/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
