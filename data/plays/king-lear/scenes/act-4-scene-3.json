    },
    {
      "id": "king-lear/sceneIV_18.3/p@153855",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KENT.\nWas this before the King return’d?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.3/p@153855/line-1",
          "start": 0,
