    {
      "id": "king-lear/sceneIV_18.3/p@154264",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KENT.\nA sovereign shame so elbows him. His own unkindness,\nThat stripp’d her from his benediction, turn’d her\nTo foreign casualties, gave her dear rights\nTo his dog-hearted daughters, these things sting\nHis mind so venomously that burning shame\nDetains him from Cordelia.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
