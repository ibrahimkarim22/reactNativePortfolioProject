          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153156/line-8",
          "start": 299,
          "end": 346,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153156/line-9",
          "start": 347,
          "end": 372,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3326611,
        "end": 3327048,
        "line": 121452,
        "column": 1,
        "path": "chap18/p@153156",
        "anchor": "sceneIV_18.3"
      },
      "speakerLabel": "GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-lear/sceneIV_18.3/p@153597",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KENT.\nIt is the stars,\nThe stars above us govern our conditions;\nElse one self mate and make could not beget\nSuch different issues. You spoke not with her since?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.3/p@153597/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153597/line-2",
          "start": 6,
          "end": 22,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153597/line-3",
          "start": 23,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153597/line-4",
          "start": 65,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153597/line-5",
          "start": 109,
          "end": 161,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3327052,
        "end": 3327258,
        "line": 121464,
        "column": 1,
        "path": "chap18/p@153597",
        "anchor": "sceneIV_18.3"
      },
      "speakerLabel": "KENT.",
      "attribution": {
        "status": "explicit",
