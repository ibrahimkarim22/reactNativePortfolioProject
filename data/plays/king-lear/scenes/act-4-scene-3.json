    {
      "id": "king-lear/sceneIV_18.3/p@153088",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KENT.\nMade she no verbal question?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.3/p@153088/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153088/line-2",
          "start": 6,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3326543,
        "end": 3326607,
        "line": 121447,
        "column": 1,
        "path": "chap18/p@153088",
        "anchor": "sceneIV_18.3"
      },
      "speakerLabel": "KENT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-lear/sceneIV_18.3/p@153156",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GENTLEMAN.\nFaith, once or twice she heav’d the name of ‘father’\nPantingly forth, as if it press’d her heart;\nCried ‘Sisters, sisters! Shame of ladies! sisters!\nKent! father! sisters! What, i’ the storm? i’ the night?\nLet pity not be believ’d!’ There she shook\nThe holy water from her heavenly eyes,\nAnd clamour master’d her: then away she started\nTo deal with grief alone.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.3/p@153156/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153156/line-2",
          "start": 11,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153156/line-3",
          "start": 64,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153156/line-4",
          "start": 109,
          "end": 159,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153156/line-5",
          "start": 160,
          "end": 216,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153156/line-6",
          "start": 217,
          "end": 259,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.3/p@153156/line-7",
