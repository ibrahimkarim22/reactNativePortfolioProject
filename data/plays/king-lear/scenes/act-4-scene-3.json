    {
      "id": "king-lear/sceneIV_18.3/p@154818",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KENT.\nWell, sir, I’ll bring you to our master Lear\nAnd leave you to attend him. Some dear cause\nWill in concealment wrap me up awhile;\nWhen I am known aright, you shall not grieve\nLending me this acquaintance.\nI pray you, go along with me.",
