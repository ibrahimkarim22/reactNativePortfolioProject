    {
      "id": "king-lear/sceneIV_18.4/p@156227",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORDELIA.\nAll bless’d secrets,\nAll you unpublish’d virtues of the earth,\nSpring with my tears! Be aidant and remediate\nIn the good man’s distress! Seek, seek for him;\nLest his ungovern’d rage dissolve the life\nThat wants the means to lead it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
