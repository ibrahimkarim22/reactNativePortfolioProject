    {
      "id": "king-lear/sceneIV_18.4/p@155388",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORDELIA.\nAlack, ’tis he: why, he was met even now\nAs mad as the vex’d sea; singing aloud;\nCrown’d with rank fumiter and furrow weeds,\nWith harlocks, hemlock, nettles, cuckoo-flowers,\nDarnel, and all the idle weeds that grow\nIn our sustaining corn. A century send forth;\nSearch every acre in the high-grown field,\nAnd bring him to our eye.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
