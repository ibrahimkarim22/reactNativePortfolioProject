      "id": "king-lear/sceneIV_18.4/p@156605",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nNews, madam;\nThe British powers are marching hitherward.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.4/p@156605/line-1",
          "start": 0,
