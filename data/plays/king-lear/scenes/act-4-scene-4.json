          "start": 24,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3330060,
        "end": 3330162,
        "line": 121583,
        "column": 1,
        "path": "chap18/p@156605",
        "anchor": "sceneIV_18.4"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-lear/sceneIV_18.4/p@156711",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CORDELIA.\n’Tis known before. Our preparation stands\nIn expectation of them. O dear father,\nIt is thy business that I go about;\nTherefore great France\nMy mourning and important tears hath pitied.\nNo blown ambition doth our arms incite,\nBut love, dear love, and our ag’d father’s right:\nSoon may I hear and see him!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
