    {
      "id": "king-lear/sceneIV_18.4/p@155846",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "What can man’s wisdom\nIn the restoring his bereaved sense,\nHe that helps him take all my outward worth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.4/p@155846/line-1",
