    {
      "id": "king-lear/sceneIV_18.4/p@155988",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PHYSICIAN.\nThere is means, madam:\nOur foster nurse of nature is repose,\nThe which he lacks; that to provoke in him\nAre many simples operative, whose power\nWill close the eye of anguish.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
