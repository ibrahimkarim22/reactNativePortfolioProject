    "scene": 5,
    "label": "Act 4, Scene 5",
    "title": "SCENE V. A Room in Gloucester's Castle",
    "location": "A Room in Gloucester's Castle",
    "orderInPlay": 21
  },
  "content": [
    {
      "id": "king-lear-4-5-stage-001",
      "type": "stage",
      "text": "Enter Regan and Oswald."
    },
    {
      "id": "king-lear-4-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "But are my brother's powers set forth?",
          "plainText": "But are my brother's powers set forth",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Ay, madam.",
          "plainText": "Ay madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Himself in person there?",
          "plainText": "Himself in person there",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Madam, with much ado.",
          "plainText": "Madam with much ado",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Your sister is the better soldier.",
          "plainText": "Your sister is the better soldier",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Lord Edmund spake not with your lord at home?",
          "plainText": "Lord Edmund spake not with your lord at home",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "No, madam.",
          "plainText": "No madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "What might import my sister's letter to him?",
          "plainText": "What might import my sister's letter to him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "I know not, lady.",
          "plainText": "I know not lady",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Faith, he is posted hence on serious matter.",
          "plainText": "Faith he is posted hence on serious matter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "It was great ignorance, Gloucester's eyes being out,",
          "plainText": "It was great ignorance Gloucester's eyes being out",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "To let him live. Where he arrives he moves",
          "plainText": "To let him live Where he arrives he moves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "All hearts against us. Edmund, I think, is gone",
          "plainText": "All hearts against us Edmund I think is gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0014",
          "number": 14,
          "speechLineNumber": 5,
          "text": "In pity of his misery, to dispatch",
          "plainText": "In pity of his misery to dispatch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0015",
          "number": 15,
          "speechLineNumber": 6,
          "text": "His nighted life; moreover to descry",
          "plainText": "His nighted life moreover to descry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0016",
          "number": 16,
          "speechLineNumber": 7,
          "text": "The strength o' th'enemy.",
          "plainText": "The strength o' th'enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "I must needs after him, madam, with my letter.",
          "plainText": "I must needs after him madam with my letter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Our troops set forth tomorrow; stay with us;",
          "plainText": "Our troops set forth tomorrow stay with us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "The ways are dangerous.",
          "plainText": "The ways are dangerous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "I may not, madam:",
          "plainText": "I may not madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "My lady charg'd my duty in this business.",
          "plainText": "My lady charg'd my duty in this business",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Why should she write to Edmund? Might not you",
          "plainText": "Why should she write to Edmund Might not you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Transport her purposes by word? Belike,",
          "plainText": "Transport her purposes by word Belike",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "Somethings, I know not what, I'll love thee much.",
          "plainText": "Somethings I know not what I'll love thee much",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Let me unseal the letter.",
          "plainText": "Let me unseal the letter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Madam, I had rather—",
          "plainText": "Madam I had rather",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "I know your lady does not love her husband;",
          "plainText": "I know your lady does not love her husband",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "I am sure of that; and at her late being here",
          "plainText": "I am sure of that and at her late being here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "She gave strange oeillades and most speaking looks",
          "plainText": "She gave strange oeillades and most speaking looks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "To noble Edmund. I know you are of her bosom.",
          "plainText": "To noble Edmund I know you are of her bosom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "I, madam?",
          "plainText": "I madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "I speak in understanding; y'are, I know't:",
          "plainText": "I speak in understanding y'are I know't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Therefore I do advise you take this note:",
          "plainText": "Therefore I do advise you take this note",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "My lord is dead; Edmund and I have talk'd,",
          "plainText": "My lord is dead Edmund and I have talk'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "And more convenient is he for my hand",
          "plainText": "And more convenient is he for my hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "Than for your lady's. You may gather more.",
          "plainText": "Than for your lady's You may gather more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "If you do find him, pray you give him this;",
          "plainText": "If you do find him pray you give him this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "And when your mistress hears thus much from you,",
          "plainText": "And when your mistress hears thus much from you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0039",
          "number": 39,
          "speechLineNumber": 8,
          "text": "I pray desire her call her wisdom to her.",
          "plainText": "I pray desire her call her wisdom to her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0040",
          "number": 40,
          "speechLineNumber": 9,
          "text": "So, fare you well.",
          "plainText": "So fare you well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0041",
          "number": 41,
          "speechLineNumber": 10,
          "text": "If you do chance to hear of that blind traitor,",
          "plainText": "If you do chance to hear of that blind traitor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0042",
          "number": 42,
          "speechLineNumber": 11,
          "text": "Preferment falls on him that cuts him off.",
          "plainText": "Preferment falls on him that cuts him off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Would I could meet him, madam! I should show",
          "plainText": "Would I could meet him madam I should show",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-5-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "What party I do follow.",
          "plainText": "What party I do follow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-4-5-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Fare thee well.",
          "plainText": "Fare thee well",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-5-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}