      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nHimself in person there?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@157461/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
