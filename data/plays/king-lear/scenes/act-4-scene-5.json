        "end": 3330977,
        "line": 121617,
        "column": 1,
        "path": "chap18/p@157461",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@157526",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OSWALD.\nMadam, with much ado.\nYour sister is the better soldier.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@157526/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157526/line-2",
          "start": 8,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157526/line-3",
          "start": 30,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3330981,
        "end": 3331080,
        "line": 121622,
        "column": 1,
        "path": "chap18/p@157526",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "OSWALD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@157629",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nLord Edmund spake not with your lord at home?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@157629/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157629/line-2",
          "start": 7,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3331084,
        "end": 3331166,
        "line": 121628,
        "column": 1,
        "path": "chap18/p@157629",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@157715",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OSWALD.\nNo, madam.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@157715/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157715/line-2",
          "start": 8,
          "end": 18,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3331170,
        "end": 3331218,
        "line": 121633,
        "column": 1,
        "path": "chap18/p@157715",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "OSWALD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@157767",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nWhat might import my sister’s letter to him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@157767/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157767/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3331222,
        "end": 3331303,
        "line": 121638,
        "column": 1,
        "path": "chap18/p@157767",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@157852",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OSWALD.\nI know not, lady.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@157852/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157852/line-2",
          "start": 8,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3331307,
        "end": 3331362,
        "line": 121643,
        "column": 1,
        "path": "chap18/p@157852",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "OSWALD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@157911",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nFaith, he is posted hence on serious matter.\nIt was great ignorance, Gloucester’s eyes being out,\nTo let him live. Where he arrives he moves\nAll hearts against us. Edmund, I think, is gone\nIn pity of his misery, to dispatch\nHis nighted life; moreover to descry\nThe strength o’ th’enemy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@157911/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157911/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157911/line-3",
          "start": 52,
          "end": 104,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157911/line-4",
          "start": 105,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157911/line-5",
          "start": 148,
          "end": 195,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157911/line-6",
          "start": 196,
          "end": 230,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157911/line-7",
          "start": 231,
          "end": 267,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@157911/line-8",
          "start": 268,
          "end": 293,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3331366,
        "end": 3331719,
        "line": 121648,
        "column": 1,
        "path": "chap18/p@157911",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@158268",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OSWALD.\nI must needs after him, madam, with my letter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@158268/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158268/line-2",
          "start": 8,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3331723,
        "end": 3331807,
        "line": 121659,
        "column": 1,
        "path": "chap18/p@158268",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "OSWALD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@158356",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nOur troops set forth tomorrow; stay with us;\nThe ways are dangerous.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@158356/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158356/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158356/line-3",
          "start": 52,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3331811,
        "end": 3331921,
        "line": 121664,
        "column": 1,
        "path": "chap18/p@158356",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@158470",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OSWALD.\nI may not, madam:\nMy lady charg’d my duty in this business.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@158470/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158470/line-2",
          "start": 8,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158470/line-3",
          "start": 26,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3331925,
        "end": 3332027,
        "line": 121670,
        "column": 1,
        "path": "chap18/p@158470",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "OSWALD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@158576",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nWhy should she write to Edmund? Might not you\nTransport her purposes by word? Belike,\nSomethings, I know not what, I’ll love thee much.\nLet me unseal the letter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@158576/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158576/line-2",
          "start": 7,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158576/line-3",
          "start": 53,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158576/line-4",
          "start": 93,
          "end": 142,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158576/line-5",
          "start": 143,
          "end": 168,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3332031,
        "end": 3332244,
        "line": 121676,
        "column": 1,
        "path": "chap18/p@158576",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@158793",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OSWALD.\nMadam, I had rather—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@158793/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158793/line-2",
          "start": 8,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3332248,
        "end": 3332306,
        "line": 121684,
        "column": 1,
        "path": "chap18/p@158793",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "OSWALD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@158855",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nI know your lady does not love her husband;\nI am sure of that; and at her late being here\nShe gave strange oeillades and most speaking looks\nTo noble Edmund. I know you are of her bosom.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@158855/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158855/line-2",
          "start": 7,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158855/line-3",
          "start": 51,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158855/line-4",
          "start": 97,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@158855/line-5",
          "start": 148,
          "end": 193,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3332310,
        "end": 3332548,
        "line": 121689,
        "column": 1,
        "path": "chap18/p@158855",
        "anchor": "sceneIV_18.5"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneIV_18.5/p@159097",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OSWALD.\nI, madam?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneIV_18.5/p@159097/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneIV_18.5/p@159097/line-2",
          "start": 8,
          "end": 17,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3332552,
