      "classes": [
        "drama"
      ],
      "text": "EDGAR.\nI was forbid it.\nWhen time shall serve, let but the herald cry,\nAnd I’ll appear again.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
