      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\nThe enemy’s in view; draw up your powers.\nHere is the guess of their true strength and forces\nBy diligent discovery; but your haste\nIs now urg’d on you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@189046/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
