      "id": "king-lear/sceneV_18.1/p@184907",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter, with drum and colours Edmund, Regan, Officers, Soldiers and others.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 29,
          "end": 62,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@184907/line-1",
          "start": 0,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3358362,
        "end": 3358491,
        "line": 122729,
        "column": 1,
        "path": "chap18/p@184907",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": null,
