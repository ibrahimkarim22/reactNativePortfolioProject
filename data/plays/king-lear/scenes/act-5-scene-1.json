      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[To an Officer, who goes out.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 29
        }
      ],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@185274/line-1",
