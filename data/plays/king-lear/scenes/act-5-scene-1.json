    {
      "id": "king-lear/sceneV_18.1/p@185336",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nOur sister’s man is certainly miscarried.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@185336/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185336/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3358791,
        "end": 3358869,
        "line": 122741,
        "column": 1,
        "path": "chap18/p@185336",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@185418",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\n’Tis to be doubted, madam.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@185418/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185418/line-2",
          "start": 8,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3358873,
        "end": 3358937,
        "line": 122746,
        "column": 1,
        "path": "chap18/p@185418",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "EDMUND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@185486",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nNow, sweet lord,\nYou know the goodness I intend upon you:\nTell me but truly, but then speak the truth,\nDo you not love my sister?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@185486/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185486/line-2",
          "start": 7,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185486/line-3",
          "start": 24,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185486/line-4",
          "start": 65,
          "end": 109,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185486/line-5",
          "start": 110,
          "end": 136,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3358941,
        "end": 3359122,
        "line": 122751,
        "column": 1,
        "path": "chap18/p@185486",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@185671",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\nIn honour’d love.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@185671/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185671/line-2",
          "start": 8,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3359126,
        "end": 3359181,
        "line": 122759,
        "column": 1,
        "path": "chap18/p@185671",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "EDMUND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@185730",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nBut have you never found my brother’s way\nTo the forfended place?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@185730/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185730/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185730/line-3",
          "start": 49,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3359185,
        "end": 3359292,
        "line": 122764,
        "column": 1,
        "path": "chap18/p@185730",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@185841",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\nThat thought abuses you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@185841/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185841/line-2",
          "start": 8,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3359296,
        "end": 3359358,
        "line": 122770,
        "column": 1,
        "path": "chap18/p@185841",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "EDMUND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@185907",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nI am doubtful that you have been conjunct\nAnd bosom’d with her, as far as we call hers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@185907/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185907/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185907/line-3",
          "start": 49,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3359362,
        "end": 3359491,
        "line": 122775,
        "column": 1,
        "path": "chap18/p@185907",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@186040",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\nNo, by mine honour, madam.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@186040/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@186040/line-2",
          "start": 8,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3359495,
        "end": 3359559,
        "line": 122781,
        "column": 1,
        "path": "chap18/p@186040",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "EDMUND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@186108",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REGAN.\nI never shall endure her, dear my lord,\nBe not familiar with her.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@186108/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@186108/line-2",
          "start": 7,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@186108/line-3",
          "start": 47,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3359563,
        "end": 3359670,
        "line": 122786,
        "column": 1,
        "path": "chap18/p@186108",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "REGAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@186219",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\nFear not,\nShe and the Duke her husband!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@186219/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@186219/line-2",
          "start": 8,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@186219/line-3",
          "start": 18,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3359674,
        "end": 3359756,
        "line": 122792,
        "column": 1,
        "path": "chap18/p@186219",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "EDMUND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@186305",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter with drum and colours Albany, Goneril and Soldiers.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 28,
          "end": 43,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 48,
          "end": 56,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@186305/line-1",
          "start": 0,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3359760,
        "end": 3359902,
        "line": 122798,
        "column": 1,
        "path": "chap18/p@186305",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@186451",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GONERIL.\n[Aside.] I had rather lose the battle than that sister\nShould loosen him and me.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 10,
          "end": 16
        }
      ],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@186451/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@186451/line-2",
          "start": 9,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@186451/line-3",
          "start": 64,
          "end": 89,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3359906,
        "end": 3360037,
        "line": 122800,
        "column": 1,
        "path": "chap18/p@186451",
        "anchor": "sceneV_18.1"
      },
      "speakerLabel": "GONERIL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-lear/sceneV_18.1/p@186586",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALBANY.\nOur very loving sister, well be-met.\nSir, this I heard: the King is come to his daughter,\nWith others whom the rigour of our state\nForc’d to cry out. Where I could not be honest,\nI never yet was valiant. For this business,\nIt toucheth us as France invades our land,\nNot bolds the King, with others whom I fear\nMost just and heavy causes make oppose.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@186586/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@186586/line-2",
          "start": 8,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@186586/line-3",
