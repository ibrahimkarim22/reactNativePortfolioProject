    {
      "id": "king-lear/sceneV_18.1/p@188223",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDGAR.\nBefore you fight the battle, ope this letter.\nIf you have victory, let the trumpet sound\nFor him that brought it: wretched though I seem,\nI can produce a champion that will prove\nWhat is avouched there. If you miscarry,\nYour business of the world hath so an end,\nAnd machination ceases. Fortune love you!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
