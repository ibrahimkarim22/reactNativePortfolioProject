    {
      "id": "king-lear/sceneV_18.1/p@185040",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDMUND.\nKnow of the Duke if his last purpose hold,\nOr whether since he is advis’d by aught\nTo change the course, he’s full of alteration\nAnd self-reproving, bring his constant pleasure.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.1/p@185040/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185040/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185040/line-3",
          "start": 51,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185040/line-4",
          "start": 91,
          "end": 136,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.1/p@185040/line-5",
          "start": 137,
          "end": 185,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3358495,
        "end": 3358725,
        "line": 122731,
        "column": 1,
        "path": "chap18/p@185040",
