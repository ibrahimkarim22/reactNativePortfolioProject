  "scene": {
    "id": "king-lear-5-1",
    "act": 5,
    "scene": 1,
    "label": "Act 5, Scene 1",
    "title": "SCENE I. The Camp of the British Forces near Dover",
    "location": "The Camp of the British Forces near Dover",
    "orderInPlay": 24
  },
  "content": [
    {
      "id": "king-lear-5-1-stage-001",
      "type": "stage",
      "text": "Enter, with drum and colours Edmund, Regan, Officers, Soldiers and others."
    },
    {
      "id": "king-lear-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "edmund",
        "name": "EDMUND",
        "displayName": "Edmund"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Know of the Duke if his last purpose hold,",
          "plainText": "Know of the Duke if his last purpose hold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Or whether since he is advis'd by aught",
          "plainText": "Or whether since he is advis'd by aught",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "To change the course, he's full of alteration",
          "plainText": "To change the course he's full of alteration",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And self-reproving, bring his constant pleasure.",
          "plainText": "And selfreproving bring his constant pleasure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-stage-002",
      "type": "stage",
      "text": "[To an Officer, who goes out.]"
    },
    {
      "id": "king-lear-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Our sister's man is certainly miscarried.",
          "plainText": "Our sister's man is certainly miscarried",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "edmund",
        "name": "EDMUND",
        "displayName": "Edmund"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "'Tis to be doubted, madam.",
          "plainText": "'Tis to be doubted madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Now, sweet lord,",
          "plainText": "Now sweet lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "You know the goodness I intend upon you:",
          "plainText": "You know the goodness I intend upon you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Tell me but truly, but then speak the truth,",
          "plainText": "Tell me but truly but then speak the truth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "Do you not love my sister?",
          "plainText": "Do you not love my sister",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "edmund",
        "name": "EDMUND",
        "displayName": "Edmund"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "In honour'd love.",
          "plainText": "In honour'd love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "But have you never found my brother's way",
          "plainText": "But have you never found my brother's way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "To the forfended place?",
          "plainText": "To the forfended place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "edmund",
        "name": "EDMUND",
        "displayName": "Edmund"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "That thought abuses you.",
          "plainText": "That thought abuses you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "I am doubtful that you have been conjunct",
          "plainText": "I am doubtful that you have been conjunct",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "And bosom'd with her, as far as we call hers.",
          "plainText": "And bosom'd with her as far as we call hers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "edmund",
        "name": "EDMUND",
        "displayName": "Edmund"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "No, by mine honour, madam.",
          "plainText": "No by mine honour madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "I never shall endure her, dear my lord,",
          "plainText": "I never shall endure her dear my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Be not familiar with her.",
          "plainText": "Be not familiar with her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "edmund",
        "name": "EDMUND",
        "displayName": "Edmund"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Fear not,",
          "plainText": "Fear not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "She and the Duke her husband!",
          "plainText": "She and the Duke her husband",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-stage-003",
      "type": "stage",
      "text": "Enter with drum and colours Albany, Goneril and Soldiers."
    },
    {
      "id": "king-lear-5-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "goneril",
        "name": "GONERIL",
        "displayName": "Goneril"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "[Aside.] I had rather lose the battle than that sister",
          "plainText": "Aside I had rather lose the battle than that sister",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Should loosen him and me.",
          "plainText": "Should loosen him and me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "albany",
        "name": "ALBANY",
        "displayName": "Albany"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Our very loving sister, well be-met.",
          "plainText": "Our very loving sister well bemet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "Sir, this I heard: the King is come to his daughter,",
          "plainText": "Sir this I heard the King is come to his daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "With others whom the rigour of our state",
          "plainText": "With others whom the rigour of our state",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "Forc'd to cry out. Where I could not be honest,",
          "plainText": "Forc'd to cry out Where I could not be honest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 5,
          "text": "I never yet was valiant. For this business,",
          "plainText": "I never yet was valiant For this business",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 6,
          "text": "It toucheth us as France invades our land,",
          "plainText": "It toucheth us as France invades our land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0030",
          "number": 30,
          "speechLineNumber": 7,
          "text": "Not bolds the King, with others whom I fear",
          "plainText": "Not bolds the King with others whom I fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0031",
          "number": 31,
          "speechLineNumber": 8,
          "text": "Most just and heavy causes make oppose.",
          "plainText": "Most just and heavy causes make oppose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "edmund",
        "name": "EDMUND",
        "displayName": "Edmund"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Sir, you speak nobly.",
          "plainText": "Sir you speak nobly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Why is this reason'd?",
          "plainText": "Why is this reason'd",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "goneril",
        "name": "GONERIL",
        "displayName": "Goneril"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Combine together 'gainst the enemy;",
          "plainText": "Combine together 'gainst the enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "For these domestic and particular broils",
          "plainText": "For these domestic and particular broils",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Are not the question here.",
          "plainText": "Are not the question here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "albany",
        "name": "ALBANY",
        "displayName": "Albany"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Let's, then, determine with the ancient of war",
          "plainText": "Let's then determine with the ancient of war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "On our proceeding.",
          "plainText": "On our proceeding",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "edmund",
        "name": "EDMUND",
        "displayName": "Edmund"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "I shall attend you presently at your tent.",
          "plainText": "I shall attend you presently at your tent",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Sister, you'll go with us?",
          "plainText": "Sister you'll go with us",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "goneril",
        "name": "GONERIL",
        "displayName": "Goneril"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "No.",
          "plainText": "No",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "'Tis most convenient; pray you, go with us.",
          "plainText": "'Tis most convenient pray you go with us",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "goneril",
        "name": "GONERIL",
        "displayName": "Goneril"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "[Aside.] O, ho, I know the riddle. I will go.",
          "plainText": "Aside O ho I know the riddle I will go",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-stage-004",
      "type": "stage",
      "text": "[Exeunt Edmund, Regan, Goneril, Officers, Soldiers and Attendants.]"
    },
    {
      "id": "king-lear-5-1-stage-005",
      "type": "stage",
      "text": "As they are going out, enter Edgar disguised."
    },
    {
      "id": "king-lear-5-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "If e'er your grace had speech with man so poor,",
          "plainText": "If e'er your grace had speech with man so poor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "Hear me one word.",
          "plainText": "Hear me one word",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "albany",
        "name": "ALBANY",
        "displayName": "Albany"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "I'll overtake you. Speak.",
          "plainText": "I'll overtake you Speak",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Before you fight the battle, ope this letter.",
          "plainText": "Before you fight the battle ope this letter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "If you have victory, let the trumpet sound",
          "plainText": "If you have victory let the trumpet sound",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0049",
          "number": 49,
          "speechLineNumber": 3,
          "text": "For him that brought it: wretched though I seem,",
          "plainText": "For him that brought it wretched though I seem",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0050",
          "number": 50,
          "speechLineNumber": 4,
          "text": "I can produce a champion that will prove",
          "plainText": "I can produce a champion that will prove",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0051",
          "number": 51,
          "speechLineNumber": 5,
          "text": "What is avouched there. If you miscarry,",
          "plainText": "What is avouched there If you miscarry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0052",
          "number": 52,
          "speechLineNumber": 6,
          "text": "Your business of the world hath so an end,",
          "plainText": "Your business of the world hath so an end",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0053",
          "number": 53,
          "speechLineNumber": 7,
          "text": "And machination ceases. Fortune love you!",
          "plainText": "And machination ceases Fortune love you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "albany",
        "name": "ALBANY",
        "displayName": "Albany"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Stay till I have read the letter.",
          "plainText": "Stay till I have read the letter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "I was forbid it.",
          "plainText": "I was forbid it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "When time shall serve, let but the herald cry,",
          "plainText": "When time shall serve let but the herald cry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "And I'll appear again.",
          "plainText": "And I'll appear again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "albany",
        "name": "ALBANY",
        "displayName": "Albany"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Why, fare thee well. I will o'erlook thy paper.",
          "plainText": "Why fare thee well I will o'erlook thy paper",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-stage-006",
      "type": "stage",
      "text": "[Exit Edgar.]"
    },
    {
      "id": "king-lear-5-1-stage-007",
      "type": "stage",
      "text": "Enter Edmund."
    },
    {
      "id": "king-lear-5-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "edmund",
        "name": "EDMUND",
        "displayName": "Edmund"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "The enemy's in view; draw up your powers.",
          "plainText": "The enemy's in view draw up your powers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "Here is the guess of their true strength and forces",
          "plainText": "Here is the guess of their true strength and forces",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "By diligent discovery; but your haste",
          "plainText": "By diligent discovery but your haste",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0062",
          "number": 62,
          "speechLineNumber": 4,
          "text": "Is now urg'd on you.",
          "plainText": "Is now urg'd on you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "albany",
        "name": "ALBANY",
        "displayName": "Albany"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "We will greet the time.",
          "plainText": "We will greet the time",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-5-1-stage-008",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "king-lear-5-1-speech-031",
      "type": "speech",
      "speaker": {
        "id": "edmund",
        "name": "EDMUND",
        "displayName": "Edmund"
      },
      "lines": [
        {
          "id": "king-lear-5-1-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "To both these sisters have I sworn my love;",
          "plainText": "To both these sisters have I sworn my love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "Each jealous of the other, as the stung",
          "plainText": "Each jealous of the other as the stung",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "Are of the adder. Which of them shall I take?",
          "plainText": "Are of the adder Which of them shall I take",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0067",
          "number": 67,
          "speechLineNumber": 4,
          "text": "Both? One? Or neither? Neither can be enjoy'd,",
          "plainText": "Both One Or neither Neither can be enjoy'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0068",
          "number": 68,
          "speechLineNumber": 5,
          "text": "If both remain alive. To take the widow",
          "plainText": "If both remain alive To take the widow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0069",
          "number": 69,
          "speechLineNumber": 6,
          "text": "Exasperates, makes mad her sister Goneril;",
          "plainText": "Exasperates makes mad her sister Goneril",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0070",
          "number": 70,
          "speechLineNumber": 7,
          "text": "And hardly shall I carry out my side,",
          "plainText": "And hardly shall I carry out my side",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0071",
          "number": 71,
          "speechLineNumber": 8,
          "text": "Her husband being alive. Now, then, we'll use",
          "plainText": "Her husband being alive Now then we'll use",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0072",
          "number": 72,
          "speechLineNumber": 9,
          "text": "His countenance for the battle; which being done,",
          "plainText": "His countenance for the battle which being done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0073",
          "number": 73,
          "speechLineNumber": 10,
          "text": "Let her who would be rid of him devise",
          "plainText": "Let her who would be rid of him devise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0074",
          "number": 74,
          "speechLineNumber": 11,
          "text": "His speedy taking off. As for the mercy",
          "plainText": "His speedy taking off As for the mercy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0075",
          "number": 75,
          "speechLineNumber": 12,
          "text": "Which he intends to Lear and to Cordelia,",
          "plainText": "Which he intends to Lear and to Cordelia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0076",
          "number": 76,
          "speechLineNumber": 13,
          "text": "The battle done, and they within our power,",
          "plainText": "The battle done and they within our power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0077",
          "number": 77,
          "speechLineNumber": 14,
          "text": "Shall never see his pardon: for my state",
          "plainText": "Shall never see his pardon for my state",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-5-1-line-0078",
          "number": 78,
          "speechLineNumber": 15,
          "text": "Stands on me to defend, not to debate.",
          "plainText": "Stands on me to defend not to debate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-5-1-stage-009",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}