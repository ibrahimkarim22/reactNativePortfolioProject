    {
      "id": "king-lear/sceneV_18.2/p@190942",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDGAR.\nAway, old man, give me thy hand, away!\nKing Lear hath lost, he and his daughter ta’en:\nGive me thy hand; come on!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.2/p@190942/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.2/p@190942/line-2",
          "start": 7,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.2/p@190942/line-3",
          "start": 46,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.2/p@190942/line-4",
          "start": 94,
          "end": 120,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3364397,
        "end": 3364557,
        "line": 122973,
        "column": 1,
        "path": "chap18/p@190942",
        "anchor": "sceneV_18.2"
      },
      "speakerLabel": "EDGAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneV_18.2/p@191106",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nNo further, sir; a man may rot even here.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.2/p@191106/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.2/p@191106/line-2",
          "start": 12,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3364561,
        "end": 3364644,
        "line": 122980,
        "column": 1,
        "path": "chap18/p@191106",
        "anchor": "sceneV_18.2"
      },
      "speakerLabel": "GLOUCESTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-lear/sceneV_18.2/p@191193",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDGAR.\nWhat, in ill thoughts again? Men must endure\nTheir going hence, even as their coming hither;\nRipeness is all. Come on.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-lear/sceneV_18.2/p@191193/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
