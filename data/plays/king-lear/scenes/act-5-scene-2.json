          "start": 52,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "king-lear/sceneV_18.2/p@191193/line-4",
          "start": 100,
          "end": 125,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3364648,
        "end": 3364813,
        "line": 122985,
        "column": 1,
        "path": "chap18/p@191193",
        "anchor": "sceneV_18.2"
      },
      "speakerLabel": "EDGAR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-lear/sceneV_18.2/p@191362",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nAnd that’s true too.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
