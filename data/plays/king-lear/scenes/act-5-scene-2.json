    {
      "id": "king-lear/sceneV_18.2/p@190495",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDGAR.\nHere, father, take the shadow of this tree\nFor your good host; pray that the right may thrive:\nIf ever I return to you again,\nI’ll bring you comfort.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
