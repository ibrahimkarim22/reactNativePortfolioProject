      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Alarum and retreat within. Enter Edgar.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 33,
          "end": 38,
          "className": "charname"
        }
      ],
      "lines": [
        {
