          "start": 7,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.2/p@18345/line-3",
          "start": 45,
          "end": 87,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4906163,
        "end": 4906285,
        "line": 183025,
        "column": 1,
        "path": "chap28/p@18345",
        "anchor": "sceneI_28.2"
