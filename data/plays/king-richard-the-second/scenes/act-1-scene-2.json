    {
      "id": "king-richard-the-second/sceneI_28.2/p@18345",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GAUNT.\nSister, farewell; I must to Coventry.\nAs much good stay with thee as go with me!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneI_28.2/p@18345/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
