    {
      "id": "king-richard-the-second/sceneI_28.4/p@41232",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nNow put it, God, in his physician’s mind\nTo help him to his grave immediately!\nThe lining of his coffers shall make coats\nTo deck our soldiers for these Irish wars.\nCome, gentlemen, let’s all go visit him.\nPray God we may make haste and come too late!",
      "separatorAfter": "\n\n",
      "spans": [],
