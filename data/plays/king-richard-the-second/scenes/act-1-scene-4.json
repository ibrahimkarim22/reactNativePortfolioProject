    {
      "id": "king-richard-the-second/sceneI_28.4/p@37960",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nWe did observe.—Cousin Aumerle,\nHow far brought you high Hereford on his way?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneI_28.4/p@37960/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@37960/line-2",
          "start": 14,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@37960/line-3",
          "start": 46,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4925778,
        "end": 4925904,
        "line": 183649,
        "column": 1,
        "path": "chap28/p@37960",
        "anchor": "sceneI_28.4"
      },
      "speakerLabel": "KING RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "king-richard-the-second/sceneI_28.4/p@38090",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AUMERLE.\nI brought high Hereford, if you call him so,\nBut to the next highway, and there I left him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38090/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38090/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38090/line-3",
          "start": 54,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4925908,
        "end": 4926043,
        "line": 183655,
        "column": 1,
        "path": "chap28/p@38090",
        "anchor": "sceneI_28.4"
      },
      "speakerLabel": "AUMERLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-richard-the-second/sceneI_28.4/p@38229",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nAnd say, what store of parting tears were shed?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38229/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38229/line-2",
          "start": 14,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4926047,
        "end": 4926138,
        "line": 183661,
        "column": 1,
        "path": "chap28/p@38229",
        "anchor": "sceneI_28.4"
      },
      "speakerLabel": "KING RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "king-richard-the-second/sceneI_28.4/p@38324",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AUMERLE.\nFaith, none for me, except the northeast wind,\nWhich then blew bitterly against our faces,\nAwaked the sleeping rheum, and so by chance\nDid grace our hollow parting with a tear.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38324/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38324/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38324/line-3",
          "start": 56,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38324/line-4",
          "start": 100,
          "end": 143,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38324/line-5",
          "start": 144,
          "end": 185,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4926142,
        "end": 4926372,
        "line": 183666,
        "column": 1,
        "path": "chap28/p@38324",
