    {
      "id": "king-richard-the-second/sceneI_28.4/p@38558",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nWhat said our cousin when you parted with him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38558/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38558/line-2",
          "start": 14,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4926376,
        "end": 4926466,
        "line": 183674,
        "column": 1,
        "path": "chap28/p@38558",
        "anchor": "sceneI_28.4"
      },
      "speakerLabel": "KING RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "king-richard-the-second/sceneI_28.4/p@38652",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AUMERLE.\n“Farewell.”\nAnd, for my heart disdained that my tongue\nShould so profane the word, that taught me craft\nTo counterfeit oppression of such grief\nThat words seemed buried in my sorrow’s grave.\nMarry, would the word “farewell” have lengthened hours\nAnd added years to his short banishment,\nHe should have had a volume of farewells,\nBut since it would not, he had none of me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38652/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38652/line-2",
          "start": 9,
          "end": 20,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38652/line-3",
          "start": 21,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38652/line-4",
          "start": 64,
          "end": 112,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38652/line-5",
          "start": 113,
          "end": 152,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38652/line-6",
          "start": 153,
          "end": 199,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38652/line-7",
          "start": 200,
          "end": 254,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38652/line-8",
          "start": 255,
          "end": 295,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38652/line-9",
          "start": 296,
          "end": 337,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneI_28.4/p@38652/line-10",
