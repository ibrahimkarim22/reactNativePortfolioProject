    {
      "id": "king-richard-the-second/sceneI_28.4/p@40943",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BUSHY.\nOld John of Gaunt is grievous sick, my lord,\nSuddenly taken, and hath sent posthaste\nTo entreat your Majesty to visit him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
