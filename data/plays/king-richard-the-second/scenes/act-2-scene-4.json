    {
      "id": "king-richard-the-second/sceneII_28.4/p@79775",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALISBURY.\nAh, Richard! With the eyes of heavy mind\nI see thy glory like a shooting star\nFall to the base earth from the firmament.\nThy sun sets weeping in the lowly west,\nWitnessing storms to come, woe, and unrest.\nThy friends are fled, to wait upon thy foes,\nAnd crossly to thy good all fortune goes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
