    },
    {
      "id": "king-richard-the-second/sceneII_28.4/p@79005",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALISBURY.\nStay yet another day, thou trusty Welshman.\nThe King reposeth all his confidence in thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneII_28.4/p@79005/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneII_28.4/p@79005/line-2",
          "start": 11,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneII_28.4/p@79005/line-3",
          "start": 55,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4966823,
        "end": 4966958,
        "line": 185014,
        "column": 1,
        "path": "chap28/p@79005",
        "anchor": "sceneII_28.4"
      },
      "speakerLabel": "SALISBURY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-richard-the-second/sceneII_28.4/p@79144",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPTAIN.\n’Tis thought the King is dead. We will not stay.\nThe bay trees in our country are all withered,\nAnd meteors fright the fixed stars of heaven;\nThe pale-faced moon looks bloody on the earth,\nAnd lean-looked prophets whisper fearful change;\nRich men look sad, and ruffians dance and leap,\nThe one in fear to lose what they enjoy,\nThe other to enjoy by rage and war.\nThese signs forerun the death or fall of kings.\nFarewell. Our countrymen are gone and fled,\nAs well assured Richard their king is dead.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneII_28.4/p@79144/line-1",
          "start": 0,
          "end": 8,
