          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneII_28.4/p@78771/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneII_28.4/p@78771/line-3",
          "start": 55,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneII_28.4/p@78771/line-4",
          "start": 96,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneII_28.4/p@78771/line-5",
          "start": 138,
          "end": 185,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4966589,
        "end": 4966819,
        "line": 185006,
        "column": 1,
        "path": "chap28/p@78771",
