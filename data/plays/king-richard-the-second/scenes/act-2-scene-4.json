    {
      "id": "king-richard-the-second/sceneII_28.4/p@78771",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPTAIN.\nMy Lord of Salisbury, we have stayed ten days\nAnd hardly kept our countrymen together,\nAnd yet we hear no tidings from the King.\nTherefore we will disperse ourselves. Farewell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
