  "scene": {
    "id": "king-richard-the-second-3-1",
    "act": 3,
    "scene": 1,
    "label": "Act 3, Scene 1",
    "title": "SCENE I. Bristol. Bolingbroke's camp.",
    "location": "Bristol. Bolingbroke's camp.",
    "orderInPlay": 9
  },
  "content": [
    {
      "id": "king-richard-the-second-3-1-stage-001",
      "type": "stage",
      "text": "Enter Bolingbroke, York, Northumberland, Harry Percy, Willoughby, Ross; Officers behind, with Bushy and Green, prisoners."
    },
    {
      "id": "king-richard-the-second-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "bolingbroke",
        "name": "BOLINGBROKE",
        "displayName": "Bolingbroke"
      },
      "lines": [
        {
          "id": "king-richard-the-second-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Bring forth these men.",
          "plainText": "Bring forth these men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Bushy and Green, I will not vex your souls—",
          "plainText": "Bushy and Green I will not vex your souls",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Since presently your souls must part your bodies—",
          "plainText": "Since presently your souls must part your bodies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "With too much urging your pernicious lives,",
          "plainText": "With too much urging your pernicious lives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "For 'twere no charity; yet to wash your blood",
          "plainText": "For 'twere no charity yet to wash your blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "From off my hands, here in the view of men",
          "plainText": "From off my hands here in the view of men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "I will unfold some causes of your deaths:",
          "plainText": "I will unfold some causes of your deaths",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "You have misled a prince, a royal king,",
          "plainText": "You have misled a prince a royal king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "A happy gentleman in blood and lineaments,",
          "plainText": "A happy gentleman in blood and lineaments",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "By you unhappied and disfigured clean.",
          "plainText": "By you unhappied and disfigured clean",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "You have in manner with your sinful hours",
          "plainText": "You have in manner with your sinful hours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "Made a divorce betwixt his queen and him,",
          "plainText": "Made a divorce betwixt his queen and him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "Broke the possession of a royal bed,",
          "plainText": "Broke the possession of a royal bed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "And stained the beauty of a fair queen's cheeks",
          "plainText": "And stained the beauty of a fair queen's cheeks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "With tears drawn from her eyes by your foul wrongs.",
          "plainText": "With tears drawn from her eyes by your foul wrongs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "Myself, a prince by fortune of my birth,",
          "plainText": "Myself a prince by fortune of my birth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "Near to the King in blood, and near in love",
          "plainText": "Near to the King in blood and near in love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Till you did make him misinterpret me,",
          "plainText": "Till you did make him misinterpret me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "Have stooped my neck under your injuries",
          "plainText": "Have stooped my neck under your injuries",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "And sighed my English breath in foreign clouds,",
          "plainText": "And sighed my English breath in foreign clouds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "Eating the bitter bread of banishment,",
          "plainText": "Eating the bitter bread of banishment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "Whilst you have fed upon my signories,",
          "plainText": "Whilst you have fed upon my signories",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "Disparked my parks and felled my forest woods,",
          "plainText": "Disparked my parks and felled my forest woods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "From my own windows torn my household coat,",
          "plainText": "From my own windows torn my household coat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 25,
          "text": "Rased out my imprese, leaving me no sign",
          "plainText": "Rased out my imprese leaving me no sign",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 26,
          "text": "Save men's opinions and my living blood",
          "plainText": "Save men's opinions and my living blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 27,
          "text": "To show the world I am a gentleman.",
          "plainText": "To show the world I am a gentleman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0028",
          "number": 28,
          "speechLineNumber": 28,
          "text": "This and much more, much more than twice all this,",
          "plainText": "This and much more much more than twice all this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0029",
          "number": 29,
          "speechLineNumber": 29,
          "text": "Condemns you to the death. See them delivered over",
          "plainText": "Condemns you to the death See them delivered over",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0030",
          "number": 30,
          "speechLineNumber": 30,
          "text": "To execution and the hand of death.",
          "plainText": "To execution and the hand of death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "bushy",
        "name": "BUSHY",
        "displayName": "Bushy"
      },
      "lines": [
        {
          "id": "king-richard-the-second-3-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "More welcome is the stroke of death to me",
          "plainText": "More welcome is the stroke of death to me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Than Bolingbroke to England. Lords, farewell.",
          "plainText": "Than Bolingbroke to England Lords farewell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "green",
        "name": "GREEN",
        "displayName": "Green"
      },
      "lines": [
        {
          "id": "king-richard-the-second-3-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "My comfort is that heaven will take our souls",
          "plainText": "My comfort is that heaven will take our souls",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "And plague injustice with the pains of hell.",
          "plainText": "And plague injustice with the pains of hell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "bolingbroke",
        "name": "BOLINGBROKE",
        "displayName": "Bolingbroke"
      },
      "lines": [
        {
          "id": "king-richard-the-second-3-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "My Lord Northumberland, see them dispatched.",
          "plainText": "My Lord Northumberland see them dispatched",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-second-3-1-stage-002",
      "type": "stage",
      "text": "[Exeunt Northumberland and Others, with Bushy and Green.]"
    },
    {
      "id": "king-richard-the-second-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-3-1-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "A gentleman of mine I have dispatched",
          "plainText": "A gentleman of mine I have dispatched",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "With letters of your love to her at large.",
          "plainText": "With letters of your love to her at large",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "bolingbroke",
        "name": "BOLINGBROKE",
        "displayName": "Bolingbroke"
      },
      "lines": [
        {
          "id": "king-richard-the-second-3-1-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Thanks, gentle uncle. Come, lords, away,",
          "plainText": "Thanks gentle uncle Come lords away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "To fight with Glendower and his complices.",
          "plainText": "To fight with Glendower and his complices",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-3-1-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "A while to work, and after holiday.",
          "plainText": "A while to work and after holiday",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-3-1-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}