      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nA gentleman of mine I have dispatched\nWith letters of your love to her at large.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
