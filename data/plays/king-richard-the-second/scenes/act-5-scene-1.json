    {
      "id": "king-richard-the-second/sceneV_28.1/p@134839",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN.\nThis way the King will come. This is the way\nTo Julius Caesar’s ill-erected tower,\nTo whose flint bosom my condemned lord\nIs doomed a prisoner by proud Bolingbroke.\nHere let us rest, if this rebellious earth\nHave any resting for her true king’s queen.",
