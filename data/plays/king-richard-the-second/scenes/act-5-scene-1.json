    {
      "id": "king-richard-the-second/sceneV_28.1/p@137619",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NORTHUMBERLAND.\nMy lord, the mind of Bolingbroke is changed.\nYou must to Pomfret, not unto the Tower.\nAnd, madam, there is order ta’en for you:\nWith all swift speed you must away to France.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
