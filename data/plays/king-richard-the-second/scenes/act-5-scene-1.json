    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@138577",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NORTHUMBERLAND.\nMy guilt be on my head, and there an end.\nTake leave and part, for you must part forthwith.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@138577/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@138577/line-2",
          "start": 16,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@138577/line-3",
          "start": 58,
          "end": 107,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5026395,
        "end": 5026537,
        "line": 186876,
        "column": 1,
        "path": "chap28/p@138577",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": "NORTHUMBERLAND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@138723",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nDoubly divorced! Bad men, you violate\nA twofold marriage, ’twixt my crown and me,\nAnd then betwixt me and my married wife.\nLet me unkiss the oath ’twixt thee and me;\nAnd yet not so, for with a kiss ’twas made.\nPart us, Northumberland: I towards the north,\nWhere shivering cold and sickness pines the clime;\nMy wife to France, from whence set forth in pomp,\nShe came adorned hither like sweet May,\nSent back like Hallowmas or short’st of day.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@138723/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@138723/line-2",
          "start": 14,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@138723/line-3",
          "start": 52,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@138723/line-4",
          "start": 96,
          "end": 136,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@138723/line-5",
          "start": 137,
          "end": 179,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@138723/line-6",
