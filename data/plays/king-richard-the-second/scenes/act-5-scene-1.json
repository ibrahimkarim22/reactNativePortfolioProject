      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@139257",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN.\nAnd must we be divided? Must we part?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139257/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139257/line-2",
          "start": 7,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5027075,
        "end": 5027149,
        "line": 186896,
        "column": 1,
        "path": "chap28/p@139257",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": "QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@139335",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nAy, hand from hand, my love, and heart from heart.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139335/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139335/line-2",
          "start": 14,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5027153,
        "end": 5027247,
        "line": 186901,
        "column": 1,
        "path": "chap28/p@139335",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": "KING RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@139433",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN.\nBanish us both, and send the King with me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139433/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139433/line-2",
          "start": 7,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5027251,
        "end": 5027330,
        "line": 186906,
        "column": 1,
        "path": "chap28/p@139433",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": "QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@139516",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NORTHUMBERLAND.\nThat were some love, but little policy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139516/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139516/line-2",
          "start": 16,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5027334,
        "end": 5027419,
        "line": 186911,
        "column": 1,
        "path": "chap28/p@139516",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": "NORTHUMBERLAND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@139605",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN.\nThen whither he goes, thither let me go.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139605/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139605/line-2",
          "start": 7,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5027423,
        "end": 5027500,
        "line": 186916,
        "column": 1,
        "path": "chap28/p@139605",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": "QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@139686",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nSo two, together weeping, make one woe.\nWeep thou for me in France, I for thee here;\nBetter far off than near, be ne’er the near.\nGo, count thy way with sighs, I mine with groans.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139686/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139686/line-2",
          "start": 14,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139686/line-3",
          "start": 54,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139686/line-4",
          "start": 99,
          "end": 143,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139686/line-5",
          "start": 144,
          "end": 193,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5027504,
        "end": 5027742,
        "line": 186921,
        "column": 1,
        "path": "chap28/p@139686",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": "KING RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@139928",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN.\nSo longest way shall have the longest moans.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139928/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@139928/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5027746,
        "end": 5027827,
        "line": 186929,
        "column": 1,
        "path": "chap28/p@139928",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": "QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@140013",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nTwice for one step I’ll groan, the way being short,\nAnd piece the way out with a heavy heart.\nCome, come, in wooing sorrow let’s be brief,\nSince, wedding it, there is such length in grief.\nOne kiss shall stop our mouths, and dumbly part;\nThus give I mine, and thus take I thy heart.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140013/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140013/line-2",
          "start": 14,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140013/line-3",
          "start": 66,
          "end": 107,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140013/line-4",
          "start": 108,
          "end": 152,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140013/line-5",
          "start": 153,
          "end": 202,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140013/line-6",
          "start": 203,
          "end": 251,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140013/line-7",
          "start": 252,
          "end": 296,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5027831,
        "end": 5028182,
        "line": 186934,
        "column": 1,
        "path": "chap28/p@140013",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": "KING RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@140368",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[They kiss.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 11
        }
      ],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140368/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5028186,
        "end": 5028227,
        "line": 186944,
        "column": 1,
        "path": "chap28/p@140368",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@140413",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN.\nGive me mine own again; ’twere no good part\nTo take on me to keep and kill thy heart.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140413/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140413/line-2",
          "start": 7,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140413/line-3",
          "start": 51,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5028231,
        "end": 5028358,
        "line": 186946,
        "column": 1,
        "path": "chap28/p@140413",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": "QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@140544",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[They kiss again.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 17
        }
      ],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140544/line-1",
          "start": 0,
          "end": 18,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5028362,
        "end": 5028409,
        "line": 186952,
        "column": 1,
        "path": "chap28/p@140544",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@140595",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "So, now I have mine own again, be gone,\nThat I may strive to kill it with a groan.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140595/line-1",
          "start": 0,
          "end": 39,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140595/line-2",
          "start": 40,
          "end": 82,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5028413,
        "end": 5028525,
        "line": 186954,
        "column": 1,
        "path": "chap28/p@140595",
        "anchor": "sceneV_28.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.1/p@140711",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nWe make woe wanton with this fond delay:\nOnce more, adieu. The rest let sorrow say.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140711/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.1/p@140711/line-2",
          "start": 14,
          "end": 54,
          "sourceLineNumber": null
