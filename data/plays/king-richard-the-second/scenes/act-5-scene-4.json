          "start": 58,
          "end": 109,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.4/p@158862/line-4",
          "start": 110,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5046680,
        "end": 5046844,
        "line": 187664,
        "column": 1,
        "path": "chap28/p@158862",
        "anchor": "sceneV_28.4"
      },
      "speakerLabel": "EXTON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.4/p@159030",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVANT.\nThese were his very words.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.4/p@159030/line-1",
