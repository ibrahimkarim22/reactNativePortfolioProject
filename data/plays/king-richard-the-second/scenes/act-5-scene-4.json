          "start": 7,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.4/p@159099/line-3",
          "start": 55,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5046917,
        "end": 5047047,
        "line": 187676,
        "column": 1,
        "path": "chap28/p@159099",
        "anchor": "sceneV_28.4"
      },
      "speakerLabel": "EXTON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.4/p@159233",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVANT.\nHe did.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.4/p@159233/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.4/p@159233/line-2",
          "start": 9,
          "end": 16,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5047051,
        "end": 5047097,
        "line": 187682,
        "column": 1,
        "path": "chap28/p@159233",
        "anchor": "sceneV_28.4"
      },
      "speakerLabel": "SERVANT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.4/p@159283",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EXTON.\nAnd speaking it, he wishtly looked on me,\nAs who should say “I would thou wert the man\nThat would divorce this terror from my heart”,\nMeaning the king at Pomfret. Come, let’s go.\nI am the King’s friend, and will rid his foe.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
