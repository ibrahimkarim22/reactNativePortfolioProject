    },
    {
      "id": "king-richard-the-second/sceneV_28.4/p@159099",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EXTON.\n“Have I no friend?” quoth he. He spake it twice\nAnd urged it twice together, did he not?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.4/p@159099/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
