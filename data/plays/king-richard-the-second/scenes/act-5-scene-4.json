    {
      "id": "king-richard-the-second/sceneV_28.4/p@158862",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EXTON.\nDidst thou not mark the King, what words he spake:\n“Have I no friend will rid me of this living fear?”\nWas it not so?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.4/p@158862/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.4/p@158862/line-2",
          "start": 7,
          "end": 57,
          "sourceLineNumber": null
        },
        {
