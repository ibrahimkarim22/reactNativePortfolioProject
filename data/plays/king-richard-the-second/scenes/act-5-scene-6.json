      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Flourish. Enter King Henry and York with Lords and Attendants.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 16,
          "end": 26,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 31,
          "end": 35,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@166875/line-1",
          "start": 0,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5054693,
        "end": 5054842,
        "line": 187915,
        "column": 1,
        "path": "chap28/p@166875",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@167028",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nKind uncle York, the latest news we hear\nIs that the rebels have consumed with fire\nOur town of Cicester in Gloucestershire,\nBut whether they be ta’en or slain we hear not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167028/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167028/line-2",
          "start": 12,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167028/line-3",
          "start": 53,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167028/line-4",
          "start": 96,
          "end": 136,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167028/line-5",
          "start": 137,
          "end": 184,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5054846,
        "end": 5055075,
        "line": 187918,
        "column": 1,
        "path": "chap28/p@167028",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@167261",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Northumberland.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 20,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167261/line-1",
          "start": 0,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5055079,
        "end": 5055156,
        "line": 187926,
        "column": 1,
        "path": "chap28/p@167261",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@167342",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Welcome, my lord. What is the news?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167342/line-1",
          "start": 0,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5055160,
        "end": 5055218,
        "line": 187928,
        "column": 1,
        "path": "chap28/p@167342",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@167404",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NORTHUMBERLAND.\nFirst, to thy sacred state wish I all happiness.\nThe next news is: I have to London sent\nThe heads of Salisbury, Spencer, Blunt, and Kent.\nThe manner of their taking may appear\nAt large discoursed in this paper here.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167404/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167404/line-2",
          "start": 16,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167404/line-3",
          "start": 65,
          "end": 104,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167404/line-4",
          "start": 105,
          "end": 154,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167404/line-5",
          "start": 155,
          "end": 192,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167404/line-6",
          "start": 193,
          "end": 232,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5055222,
        "end": 5055504,
        "line": 187931,
        "column": 1,
        "path": "chap28/p@167404",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": "NORTHUMBERLAND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@167690",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nWe thank thee, gentle Percy, for thy pains,\nAnd to thy worth will add right worthy gains.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167690/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167690/line-2",
          "start": 12,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167690/line-3",
          "start": 56,
          "end": 101,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5055508,
        "end": 5055644,
        "line": 187940,
        "column": 1,
        "path": "chap28/p@167690",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@167830",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Fitzwater.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 15,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167830/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5055648,
        "end": 5055720,
        "line": 187946,
        "column": 1,
        "path": "chap28/p@167830",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@167906",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FITZWATER.\nMy lord, I have from Oxford sent to London\nThe heads of Brocas and Sir Bennet Seely,\nTwo of the dangerous consorted traitors\nThat sought at Oxford thy dire overthrow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167906/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167906/line-2",
          "start": 11,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167906/line-3",
          "start": 54,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167906/line-4",
          "start": 96,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@167906/line-5",
          "start": 136,
          "end": 177,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5055724,
        "end": 5055946,
        "line": 187948,
        "column": 1,
        "path": "chap28/p@167906",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": "FITZWATER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@168132",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nThy pains, Fitzwater, shall not be forgot.\nRight noble is thy merit, well I wot.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168132/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168132/line-2",
          "start": 12,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168132/line-3",
          "start": 55,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5055950,
        "end": 5056077,
        "line": 187956,
        "column": 1,
        "path": "chap28/p@168132",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@168265",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Harry Percy with the Bishop of Carlisle.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 17,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 27,
          "end": 45,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168265/line-1",
          "start": 0,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5056083,
        "end": 5056216,
        "line": 187963,
        "column": 1,
        "path": "chap28/p@168265",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@168402",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERCY.\nThe grand conspirator, Abbot of Westminster,\nWith clog of conscience and sour melancholy,\nHath yielded up his body to the grave.\nBut here is Carlisle living, to abide\nThy kingly doom and sentence of his pride.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168402/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168402/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168402/line-3",
          "start": 52,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168402/line-4",
          "start": 97,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168402/line-5",
          "start": 136,
          "end": 173,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168402/line-6",
          "start": 174,
          "end": 216,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5056220,
        "end": 5056486,
        "line": 187966,
        "column": 1,
        "path": "chap28/p@168402",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": "PERCY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@168672",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nCarlisle, this is your doom:\nChoose out some secret place, some reverend room,\nMore than thou hast, and with it joy thy life.\nSo as thou liv’st in peace, die free from strife;\nFor though mine enemy thou hast ever been,\nHigh sparks of honour in thee have I seen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168672/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168672/line-2",
          "start": 12,
          "end": 40,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168672/line-3",
          "start": 41,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168672/line-4",
          "start": 91,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168672/line-5",
          "start": 138,
          "end": 187,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168672/line-6",
          "start": 188,
          "end": 230,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@168672/line-7",
          "start": 231,
          "end": 273,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5056490,
        "end": 5056818,
        "line": 187975,
        "column": 1,
        "path": "chap28/p@168672",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@169006",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Exton with attendants, bearing a coffin.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 11,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@169006/line-1",
          "start": 0,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5056824,
        "end": 5056927,
        "line": 187986,
        "column": 1,
        "path": "chap28/p@169006",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@169113",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EXTON.\nGreat king, within this coffin I present\nThy buried fear. Herein all breathless lies\nThe mightiest of thy greatest enemies,\nRichard of Bordeaux, by me hither brought.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@169113/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@169113/line-2",
          "start": 7,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@169113/line-3",
          "start": 48,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@169113/line-4",
          "start": 92,
          "end": 130,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@169113/line-5",
          "start": 131,
          "end": 173,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5056931,
        "end": 5057149,
        "line": 187989,
        "column": 1,
        "path": "chap28/p@169113",
        "anchor": "sceneV_28.6"
      },
      "speakerLabel": "EXTON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "king-richard-the-second/sceneV_28.6/p@169335",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nExton, I thank thee not, for thou hast wrought\nA deed of slander with thy fatal hand\nUpon my head and all this famous land.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-second/sceneV_28.6/p@169335/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-second/sceneV_28.6/p@169335/line-2",
          "start": 12,
          "end": 58,
          "sourceLineNumber": null
        },
