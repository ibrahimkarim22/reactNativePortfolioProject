      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CITIZEN.\nCome, come, we fear the worst; all will be well.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@92626/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
