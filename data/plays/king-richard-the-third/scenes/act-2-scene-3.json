      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CITIZEN.\nMarry, we were sent for to the Justices.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
