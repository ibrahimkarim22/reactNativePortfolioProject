      },
      "speakerLabel": "FIRST CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@92723",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD CITIZEN.\nWhen clouds are seen, wise men put on their cloaks;\nWhen great leaves fall, then winter is at hand;\nWhen the sun sets, who doth not look for night?\nUntimely storms make men expect a dearth.\nAll may be well; but, if God sort it so,\n’Tis more than we deserve or I expect.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@92723/line-1",
          "start": 0,
