    {
      "id": "king-richard-the-third/sceneII_29.3/p@90343",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CITIZEN.\nGood morrow, neighbour, whither away so fast?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90343/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90343/line-2",
          "start": 15,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5148607,
        "end": 5148697,
        "line": 191394,
        "column": 1,
        "path": "chap29/p@90343",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "FIRST CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@90437",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CITIZEN.\nI promise you, I scarcely know myself.\nHear you the news abroad?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90437/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90437/line-2",
          "start": 16,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90437/line-3",
          "start": 55,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5148701,
        "end": 5148816,
        "line": 191399,
        "column": 1,
        "path": "chap29/p@90437",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "SECOND CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@90556",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CITIZEN.\nYes, that the King is dead.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90556/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90556/line-2",
          "start": 15,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5148820,
        "end": 5148892,
        "line": 191405,
        "column": 1,
        "path": "chap29/p@90556",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "FIRST CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@90632",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CITIZEN.\nIll news, by’r Lady; seldom comes the better.\nI fear, I fear ’twill prove a giddy world.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90632/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90632/line-2",
          "start": 16,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90632/line-3",
          "start": 62,
          "end": 104,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5148896,
        "end": 5149035,
        "line": 191410,
        "column": 1,
        "path": "chap29/p@90632",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "SECOND CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@90775",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter another Citizen.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 14,
          "end": 21,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90775/line-1",
          "start": 0,
          "end": 22,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5149039,
        "end": 5149116,
        "line": 191416,
        "column": 1,
        "path": "chap29/p@90775",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@90856",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD CITIZEN.\nNeighbours, God speed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90856/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90856/line-2",
          "start": 15,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5149120,
        "end": 5149187,
        "line": 191418,
        "column": 1,
        "path": "chap29/p@90856",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "THIRD CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@90927",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CITIZEN.\nGive you good morrow, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90927/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@90927/line-2",
          "start": 15,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5149191,
        "end": 5149262,
        "line": 191423,
        "column": 1,
        "path": "chap29/p@90927",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "FIRST CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@91002",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD CITIZEN.\nDoth the news hold of good King Edward’s death?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91002/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91002/line-2",
          "start": 15,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5149266,
        "end": 5149358,
        "line": 191428,
        "column": 1,
        "path": "chap29/p@91002",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "THIRD CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@91098",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CITIZEN.\nAy, sir, it is too true, God help the while.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91098/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91098/line-2",
          "start": 16,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5149362,
        "end": 5149452,
        "line": 191433,
        "column": 1,
        "path": "chap29/p@91098",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "SECOND CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@91192",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD CITIZEN.\nThen, masters, look to see a troublous world.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91192/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91192/line-2",
          "start": 15,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5149456,
        "end": 5149546,
        "line": 191438,
        "column": 1,
        "path": "chap29/p@91192",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "THIRD CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@91286",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CITIZEN.\nNo, no; by God’s good grace, his son shall reign.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91286/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91286/line-2",
          "start": 15,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5149550,
        "end": 5149644,
        "line": 191443,
        "column": 1,
        "path": "chap29/p@91286",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "FIRST CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@91384",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD CITIZEN.\nWoe to that land that’s governed by a child.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91384/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91384/line-2",
          "start": 15,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5149648,
        "end": 5149737,
        "line": 191448,
        "column": 1,
        "path": "chap29/p@91384",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "THIRD CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@91477",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CITIZEN.\nIn him there is a hope of government,\nWhich, in his nonage, council under him,\nAnd, in his full and ripened years, himself,\nNo doubt shall then, and till then, govern well.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91477/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91477/line-2",
          "start": 16,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91477/line-3",
          "start": 54,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91477/line-4",
          "start": 95,
          "end": 139,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91477/line-5",
          "start": 140,
          "end": 188,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5149741,
        "end": 5149974,
        "line": 191453,
        "column": 1,
        "path": "chap29/p@91477",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "SECOND CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@91714",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CITIZEN.\nSo stood the state when Henry the Sixth\nWas crowned in Paris but at nine months old.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91714/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91714/line-2",
          "start": 15,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91714/line-3",
          "start": 55,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5149978,
        "end": 5150112,
        "line": 191461,
        "column": 1,
        "path": "chap29/p@91714",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "FIRST CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@91852",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD CITIZEN.\nStood the state so? No, no, good friends, God wot.\nFor then this land was famously enriched\nWith politic grave counsel; then the King\nHad virtuous uncles to protect his Grace.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91852/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91852/line-2",
          "start": 15,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91852/line-3",
          "start": 66,
          "end": 106,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91852/line-4",
          "start": 107,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@91852/line-5",
          "start": 149,
          "end": 190,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5150116,
        "end": 5150351,
        "line": 191467,
        "column": 1,
        "path": "chap29/p@91852",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "THIRD CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@92091",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CITIZEN.\nWhy, so hath this, both by his father and mother.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.3/p@92091/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.3/p@92091/line-2",
          "start": 15,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5150355,
        "end": 5150449,
        "line": 191475,
        "column": 1,
        "path": "chap29/p@92091",
        "anchor": "sceneII_29.3"
      },
      "speakerLabel": "FIRST CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.3/p@92189",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD CITIZEN.\nBetter it were they all came by his father,\nOr by his father there were none at all,\nFor emulation who shall now be nearest\nWill touch us all too near, if God prevent not.\nO, full of danger is the Duke of Gloucester,\nAnd the Queen’s sons and brothers haught and proud;\nAnd were they to be ruled, and not to rule,\nThis sickly land might solace as before.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
