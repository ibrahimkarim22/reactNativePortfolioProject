    {
      "id": "king-richard-the-third/sceneII_29.4/p@93816",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter the Archbishop of York, the young Duke of York, Queen Elizabeth and the Duchess of York.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 10,
          "end": 28,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 40,
          "end": 69,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 78,
          "end": 93,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@93816/line-1",
          "start": 0,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5152080,
        "end": 5152291,
        "line": 191537,
        "column": 1,
        "path": "chap29/p@93816",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@94031",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCHBISHOP.\nLast night, I hear, they lay at Stony Stratford,\nAnd at Northampton they do rest tonight.\nTomorrow or next day they will be here.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94031/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94031/line-2",
          "start": 12,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94031/line-3",
          "start": 61,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94031/line-4",
          "start": 102,
          "end": 141,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5152295,
        "end": 5152476,
        "line": 191541,
        "column": 1,
        "path": "chap29/p@94031",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "ARCHBISHOP.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@94216",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUCHESS.\nI long with all my heart to see the Prince.\nI hope he is much grown since last I saw him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94216/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94216/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94216/line-3",
          "start": 53,
          "end": 98,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5152480,
        "end": 5152613,
        "line": 191548,
        "column": 1,
        "path": "chap29/p@94216",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "DUCHESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@94353",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN ELIZABETH.\nBut I hear no; they say my son of York\nHas almost overta’en him in his growth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94353/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94353/line-2",
          "start": 17,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94353/line-3",
          "start": 56,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5152617,
        "end": 5152747,
        "line": 191554,
        "column": 1,
        "path": "chap29/p@94353",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "QUEEN ELIZABETH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@94487",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nAy, mother, but I would not have it so.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94487/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94487/line-2",
          "start": 6,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5152751,
        "end": 5152826,
        "line": 191560,
        "column": 1,
        "path": "chap29/p@94487",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@94566",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUCHESS.\nWhy, my good cousin? It is good to grow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94566/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94566/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5152830,
        "end": 5152909,
        "line": 191565,
        "column": 1,
        "path": "chap29/p@94566",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "DUCHESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@94649",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nGrandam, one night as we did sit at supper,\nMy uncle Rivers talked how I did grow\nMore than my brother. “Ay,” quoth my uncle Gloucester,\n“Small herbs have grace; great weeds do grow apace.”\nAnd since, methinks I would not grow so fast,\nBecause sweet flowers are slow and weeds make haste.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94649/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94649/line-2",
          "start": 6,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94649/line-3",
          "start": 50,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94649/line-4",
          "start": 88,
          "end": 142,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94649/line-5",
          "start": 143,
          "end": 195,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94649/line-6",
          "start": 196,
          "end": 241,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@94649/line-7",
          "start": 242,
          "end": 294,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5152913,
        "end": 5153262,
        "line": 191570,
        "column": 1,
        "path": "chap29/p@94649",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@95002",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUCHESS.\nGood faith, good faith, the saying did not hold\nIn him that did object the same to thee!\nHe was the wretched’st thing when he was young,\nSo long a-growing and so leisurely,\nThat if his rule were true, he should be gracious.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95002/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95002/line-2",
          "start": 9,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95002/line-3",
          "start": 57,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95002/line-4",
          "start": 98,
          "end": 145,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95002/line-5",
          "start": 146,
          "end": 181,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95002/line-6",
          "start": 182,
          "end": 232,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5153266,
        "end": 5153548,
        "line": 191580,
        "column": 1,
        "path": "chap29/p@95002",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "DUCHESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@95288",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCHBISHOP.\nAnd so no doubt he is, my gracious madam.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95288/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95288/line-2",
          "start": 12,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5153552,
        "end": 5153635,
        "line": 191589,
        "column": 1,
        "path": "chap29/p@95288",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "ARCHBISHOP.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@95375",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUCHESS.\nI hope he is, but yet let mothers doubt.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95375/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95375/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5153639,
        "end": 5153718,
        "line": 191594,
        "column": 1,
        "path": "chap29/p@95375",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "DUCHESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@95458",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nNow, by my troth, if I had been remembered,\nI could have given my uncle’s Grace a flout\nTo touch his growth nearer than he touched mine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95458/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95458/line-2",
          "start": 6,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95458/line-3",
          "start": 50,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95458/line-4",
          "start": 94,
          "end": 142,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5153722,
        "end": 5153904,
        "line": 191599,
        "column": 1,
        "path": "chap29/p@95458",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@95644",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUCHESS.\nHow, my young York? I prithee let me hear it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95644/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95644/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5153908,
        "end": 5153992,
        "line": 191606,
        "column": 1,
        "path": "chap29/p@95644",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "DUCHESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@95732",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nMarry, they say my uncle grew so fast\nThat he could gnaw a crust at two hours old.\n’Twas full two years ere I could get a tooth.\nGrandam, this would have been a biting jest.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95732/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95732/line-2",
          "start": 6,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95732/line-3",
          "start": 44,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95732/line-4",
          "start": 89,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95732/line-5",
          "start": 135,
          "end": 179,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5153996,
        "end": 5154220,
        "line": 191611,
        "column": 1,
        "path": "chap29/p@95732",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@95960",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUCHESS.\nI prithee, pretty York, who told thee this?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95960/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@95960/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5154224,
        "end": 5154306,
        "line": 191619,
        "column": 1,
        "path": "chap29/p@95960",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "DUCHESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@96046",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nGrandam, his nurse.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@96046/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@96046/line-2",
          "start": 6,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5154310,
        "end": 5154365,
        "line": 191624,
        "column": 1,
        "path": "chap29/p@96046",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@96105",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUCHESS.\nHis nurse? Why she was dead ere thou wast born.",
      "separatorAfter": "\n\n",
      "spans": [],
