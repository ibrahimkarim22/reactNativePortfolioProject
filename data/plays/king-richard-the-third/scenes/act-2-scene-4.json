    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@97511",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN ELIZABETH.\nAh me! I see the ruin of my house.\nThe tiger now hath seized the gentle hind;\nInsulting tyranny begins to jut\nUpon the innocent and aweless throne.\nWelcome, destruction, blood, and massacre;\nI see, as in a map, the end of all.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@97511/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@97511/line-2",
          "start": 17,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@97511/line-3",
          "start": 52,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@97511/line-4",
          "start": 95,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@97511/line-5",
          "start": 127,
          "end": 164,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@97511/line-6",
          "start": 165,
          "end": 207,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneII_29.4/p@97511/line-7",
          "start": 208,
          "end": 243,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5155775,
        "end": 5156073,
        "line": 191709,
        "column": 1,
        "path": "chap29/p@97511",
        "anchor": "sceneII_29.4"
      },
      "speakerLabel": "QUEEN ELIZABETH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "king-richard-the-third/sceneII_29.4/p@97813",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUCHESS.\nAccursed and unquiet wrangling days,\nHow many of you have mine eyes beheld?\nMy husband lost his life to get the crown,\nAnd often up and down my sons were tossed\nFor me to joy and weep their gain and loss.\nAnd being seated, and domestic broils\nClean over-blown, themselves, the conquerors\nMake war upon themselves, brother to brother,\nBlood to blood, self against self. O, preposterous\nAnd frantic outrage, end thy damned spleen,\nOr let me die, to look on earth no more.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneII_29.4/p@97813/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
