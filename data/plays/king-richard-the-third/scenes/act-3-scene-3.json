      },
      "speakerLabel": "RIVERS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-richard-the-third/sceneIII_29.3/p@122851",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RATCLIFFE.\nMake haste. The hour of death is expiate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122851/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122851/line-2",
          "start": 11,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5181115,
        "end": 5181197,
        "line": 192727,
        "column": 1,
        "path": "chap29/p@122851",
        "anchor": "sceneIII_29.3"
      },
      "speakerLabel": "RATCLIFFE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-richard-the-third/sceneIII_29.3/p@122937",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RIVERS.\nCome, Grey, come, Vaughan, let us here embrace.\nFarewell, until we meet again in heaven.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122937/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
