          "end": 76,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 81,
          "end": 88,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121304/line-1",
          "start": 0,
          "end": 109,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5179568,
        "end": 5179793,
        "line": 192674,
        "column": 1,
