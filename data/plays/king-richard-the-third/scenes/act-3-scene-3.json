        "anchor": "sceneIII_29.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "king-richard-the-third/sceneIII_29.3/p@121533",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RIVERS.\nSir Richard Ratcliffe, let me tell thee this:\nToday shalt thou behold a subject die\nFor truth, for duty, and for loyalty.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121533/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121533/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121533/line-3",
          "start": 54,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121533/line-4",
          "start": 92,
          "end": 129,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5179797,
        "end": 5179966,
        "line": 192677,
        "column": 1,
        "path": "chap29/p@121533",
        "anchor": "sceneIII_29.3"
      },
      "speakerLabel": "RIVERS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-richard-the-third/sceneIII_29.3/p@121706",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GREY.\nGod bless the Prince from all the pack of you!\nA knot you are of damned bloodsuckers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121706/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121706/line-2",
          "start": 6,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121706/line-3",
          "start": 53,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5179970,
        "end": 5180096,
        "line": 192684,
        "column": 1,
        "path": "chap29/p@121706",
        "anchor": "sceneIII_29.3"
      },
      "speakerLabel": "GREY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-richard-the-third/sceneIII_29.3/p@121836",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VAUGHAN\nYou live that shall cry woe for this hereafter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121836/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121836/line-2",
          "start": 8,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5180100,
        "end": 5180185,
        "line": 192690,
        "column": 1,
        "path": "chap29/p@121836",
        "anchor": "sceneIII_29.3"
      },
      "speakerLabel": "VAUGHAN",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-richard-the-third/sceneIII_29.3/p@121925",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RATCLIFFE\nDispatch. The limit of your lives is out.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121925/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@121925/line-2",
          "start": 10,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5180189,
        "end": 5180270,
        "line": 192695,
        "column": 1,
        "path": "chap29/p@121925",
        "anchor": "sceneIII_29.3"
      },
      "speakerLabel": "RATCLIFFE",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-richard-the-third/sceneIII_29.3/p@122010",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RIVERS.\nO Pomfret, Pomfret! O thou bloody prison,\nFatal and ominous to noble peers!\nWithin the guilty closure of thy walls\nRichard the Second here was hacked to death;\nAnd, for more slander to thy dismal seat,\nWe give to thee our guiltless blood to drink.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122010/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122010/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122010/line-3",
          "start": 50,
          "end": 83,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122010/line-4",
          "start": 84,
          "end": 122,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122010/line-5",
          "start": 123,
          "end": 167,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122010/line-6",
          "start": 168,
          "end": 209,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122010/line-7",
          "start": 210,
          "end": 255,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5180274,
        "end": 5180584,
        "line": 192700,
        "column": 1,
        "path": "chap29/p@122010",
        "anchor": "sceneIII_29.3"
      },
      "speakerLabel": "RIVERS.",
      "attribution": {
