    {
      "id": "king-richard-the-third/sceneIII_29.3/p@121304",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Sir Richard Ratcliffe, with Halberds, carrying the nobles Rivers, Grey and Vaughan to death at Pomfret.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 27,
          "className": "charname"
        },
        {
