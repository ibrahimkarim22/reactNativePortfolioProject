  "scene": {
    "id": "king-richard-the-third-3-3",
    "act": 3,
    "scene": 3,
    "label": "Act 3, Scene 3",
    "title": "SCENE III. Pomfret. Before the Castle",
    "location": "Pomfret. Before the Castle",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "king-richard-the-third-3-3-stage-001",
      "type": "stage",
      "text": "Enter Sir Richard Ratcliffe, with Halberds, carrying the nobles Rivers, Grey and Vaughan to death at Pomfret."
    },
    {
      "id": "king-richard-the-third-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "rivers",
        "name": "RIVERS",
        "displayName": "Rivers"
      },
      "lines": [
        {
          "id": "king-richard-the-third-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Sir Richard Ratcliffe, let me tell thee this:",
          "plainText": "Sir Richard Ratcliffe let me tell thee this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Today shalt thou behold a subject die",
          "plainText": "Today shalt thou behold a subject die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "For truth, for duty, and for loyalty.",
          "plainText": "For truth for duty and for loyalty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "grey",
        "name": "GREY",
        "displayName": "Grey"
      },
      "lines": [
        {
          "id": "king-richard-the-third-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "God bless the Prince from all the pack of you!",
          "plainText": "God bless the Prince from all the pack of you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "A knot you are of damned bloodsuckers.",
          "plainText": "A knot you are of damned bloodsuckers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "vaughan",
        "name": "VAUGHAN",
        "displayName": "Vaughan"
      },
      "lines": [
        {
          "id": "king-richard-the-third-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "You live that shall cry woe for this hereafter.",
          "plainText": "You live that shall cry woe for this hereafter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "ratcliffe",
        "name": "RATCLIFFE",
        "displayName": "Ratcliffe"
      },
      "lines": [
        {
          "id": "king-richard-the-third-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Dispatch. The limit of your lives is out.",
          "plainText": "Dispatch The limit of your lives is out",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "rivers",
        "name": "RIVERS",
        "displayName": "Rivers"
      },
      "lines": [
        {
          "id": "king-richard-the-third-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "O Pomfret, Pomfret! O thou bloody prison,",
          "plainText": "O Pomfret Pomfret O thou bloody prison",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Fatal and ominous to noble peers!",
          "plainText": "Fatal and ominous to noble peers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Within the guilty closure of thy walls",
          "plainText": "Within the guilty closure of thy walls",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Richard the Second here was hacked to death;",
          "plainText": "Richard the Second here was hacked to death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "And, for more slander to thy dismal seat,",
          "plainText": "And for more slander to thy dismal seat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "We give to thee our guiltless blood to drink.",
          "plainText": "We give to thee our guiltless blood to drink",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "grey",
        "name": "GREY",
        "displayName": "Grey"
      },
      "lines": [
        {
          "id": "king-richard-the-third-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Now Margaret's curse is fall'n upon our heads,",
          "plainText": "Now Margaret's curse is fall'n upon our heads",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "When she exclaimed on Hastings, you, and I,",
          "plainText": "When she exclaimed on Hastings you and I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "For standing by when Richard stabbed her son.",
          "plainText": "For standing by when Richard stabbed her son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "rivers",
        "name": "RIVERS",
        "displayName": "Rivers"
      },
      "lines": [
        {
          "id": "king-richard-the-third-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Then cursed she Richard, then cursed she Buckingham,",
          "plainText": "Then cursed she Richard then cursed she Buckingham",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Then cursed she Hastings. O, remember, God,",
          "plainText": "Then cursed she Hastings O remember God",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "To hear her prayer for them, as now for us!",
          "plainText": "To hear her prayer for them as now for us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "And for my sister and her princely sons,",
          "plainText": "And for my sister and her princely sons",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Be satisfied, dear God, with our true blood,",
          "plainText": "Be satisfied dear God with our true blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "Which, as thou know'st, unjustly must be spilt.",
          "plainText": "Which as thou know'st unjustly must be spilt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "ratcliffe",
        "name": "RATCLIFFE",
        "displayName": "Ratcliffe"
      },
      "lines": [
        {
          "id": "king-richard-the-third-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Make haste. The hour of death is expiate.",
          "plainText": "Make haste The hour of death is expiate",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "rivers",
        "name": "RIVERS",
        "displayName": "Rivers"
      },
      "lines": [
        {
          "id": "king-richard-the-third-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Come, Grey, come, Vaughan, let us here embrace.",
          "plainText": "Come Grey come Vaughan let us here embrace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "Farewell, until we meet again in heaven.",
          "plainText": "Farewell until we meet again in heaven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-3-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}