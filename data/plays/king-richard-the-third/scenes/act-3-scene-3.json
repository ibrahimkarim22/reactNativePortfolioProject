        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-richard-the-third/sceneIII_29.3/p@122324",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GREY.\nNow Margaret’s curse is fall’n upon our heads,\nWhen she exclaimed on Hastings, you, and I,\nFor standing by when Richard stabbed her son.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122324/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122324/line-2",
          "start": 6,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122324/line-3",
          "start": 53,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122324/line-4",
          "start": 97,
          "end": 142,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5180588,
        "end": 5180770,
        "line": 192710,
        "column": 1,
        "path": "chap29/p@122324",
        "anchor": "sceneIII_29.3"
      },
      "speakerLabel": "GREY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "king-richard-the-third/sceneIII_29.3/p@122510",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RIVERS.\nThen cursed she Richard, then cursed she Buckingham,\nThen cursed she Hastings. O, remember, God,\nTo hear her prayer for them, as now for us!\nAnd for my sister and her princely sons,\nBe satisfied, dear God, with our true blood,\nWhich, as thou know’st, unjustly must be spilt.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122510/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122510/line-2",
          "start": 8,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122510/line-3",
          "start": 61,
          "end": 104,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122510/line-4",
          "start": 105,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122510/line-5",
          "start": 149,
          "end": 189,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122510/line-6",
          "start": 190,
          "end": 234,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIII_29.3/p@122510/line-7",
          "start": 235,
          "end": 282,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5180774,
        "end": 5181111,
        "line": 192717,
        "column": 1,
        "path": "chap29/p@122510",
