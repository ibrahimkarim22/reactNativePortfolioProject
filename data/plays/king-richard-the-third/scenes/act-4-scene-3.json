      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TYRREL.\nThe chaplain of the Tower hath buried them,\nBut where, to say the truth, I do not know.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@170150/line-1",
