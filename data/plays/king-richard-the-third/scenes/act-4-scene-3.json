        "path": "chap29/p@170150",
        "anchor": "sceneIV_29.3"
      },
      "speakerLabel": "TYRREL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "king-richard-the-third/sceneIV_29.3/p@170284",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nCome to me, Tyrrel, soon, at after-supper,\nWhen thou shalt tell the process of their death.\nMeantime, but think how I may do thee good,\nAnd be inheritor of thy desire.\nFarewell till then.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
