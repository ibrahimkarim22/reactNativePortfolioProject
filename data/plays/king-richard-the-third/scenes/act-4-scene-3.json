    {
      "id": "king-richard-the-third/sceneIV_29.3/p@170643",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nThe son of Clarence have I pent up close;\nHis daughter meanly have I matched in marriage;\nThe sons of Edward sleep in Abraham’s bosom,\nAnd Anne my wife hath bid the world good night.\nNow, for I know the Breton Richmond aims\nAt young Elizabeth, my brother’s daughter,\nAnd by that knot looks proudly on the crown,\nTo her go I, a jolly thriving wooer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@170643/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@170643/line-2",
          "start": 14,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@170643/line-3",
          "start": 56,
          "end": 103,
