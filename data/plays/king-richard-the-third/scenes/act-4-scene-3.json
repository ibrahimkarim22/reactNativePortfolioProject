    {
      "id": "king-richard-the-third/sceneIV_29.3/p@171202",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nGood or bad news, that thou com’st in so bluntly?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@171202/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@171202/line-2",
          "start": 14,
          "end": 63,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5229466,
        "end": 5229559,
        "line": 194456,
        "column": 1,
        "path": "chap29/p@171202",
        "anchor": "sceneIV_29.3"
      },
      "speakerLabel": "KING RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "king-richard-the-third/sceneIV_29.3/p@171299",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RATCLIFFE.\nBad news, my lord. Morton is fled to Richmond,\nAnd Buckingham, backed with the hardy Welshmen,\nIs in the field, and still his power increaseth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@171299/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@171299/line-2",
          "start": 11,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@171299/line-3",
          "start": 58,
          "end": 105,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@171299/line-4",
          "start": 106,
          "end": 154,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5229563,
        "end": 5229757,
        "line": 194461,
        "column": 1,
        "path": "chap29/p@171299",
        "anchor": "sceneIV_29.3"
      },
      "speakerLabel": "RATCLIFFE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "king-richard-the-third/sceneIV_29.3/p@171497",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nEly with Richmond troubles me more near\nThan Buckingham and his rash-levied strength.\nCome, I have learned that fearful commenting\nIs leaden servitor to dull delay;\nDelay leads impotent and snail-paced beggary;\nThen fiery expedition be my wing,\nJove’s Mercury, and herald for a king!\nGo, muster men. My counsel is my shield.\nWe must be brief when traitors brave the field.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
