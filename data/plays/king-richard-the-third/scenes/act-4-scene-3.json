          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneIV_29.3/p@170150/line-3",
          "start": 52,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5228414,
        "end": 5228544,
        "line": 194415,
