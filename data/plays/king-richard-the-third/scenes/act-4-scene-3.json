      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nKind Tyrrel, am I happy in thy news?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
