      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "STANLEY.\nWhat men of name resort to him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneIV_29.5/p@208275/line-1",
