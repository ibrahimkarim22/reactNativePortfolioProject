    {
      "id": "king-richard-the-third/sceneIV_29.5/p@208349",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHRISTOPHER.\nSir Walter Herbert, a renowned soldier;\nSir Gilbert Talbot, Sir William Stanley,\nOxford, redoubted Pembroke, Sir James Blunt,\nAnd Rice ap Thomas, with a valiant crew,\nAnd many other of great name and worth;\nAnd towards London do they bend their power,\nIf by the way they be not fought withal.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
