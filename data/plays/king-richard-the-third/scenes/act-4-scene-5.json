    {
      "id": "king-richard-the-third/sceneIV_29.5/p@207710",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "STANLEY.\nSir Christopher, tell Richmond this from me:\nThat in the sty of the most deadly boar\nMy son George Stanley is franked up in hold;\nIf I revolt, off goes young George’s head;\nThe fear of that holds off my present aid.\nSo get thee gone. Commend me to thy lord;\nWithal say that the Queen hath heartily consented\nHe should espouse Elizabeth her daughter.\nBut tell me, where is princely Richmond now?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
