      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "STANLEY.\nWell, hie thee to thy lord; I kiss his hand.\nMy letter will resolve him of my mind.\nFarewell.",
      "separatorAfter": "\n\n",
      "spans": [],
