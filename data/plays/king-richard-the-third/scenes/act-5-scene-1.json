    {
      "id": "king-richard-the-third/sceneV_29.1/p@209386",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BUCKINGHAM.\nHastings, and Edward’s children, Grey, and Rivers,\nHoly King Henry, and thy fair son Edward,\nVaughan, and all that have miscarried\nBy underhand, corrupted foul injustice,\nIf that your moody discontented souls\nDo through the clouds behold this present hour,\nEven for revenge mock my destruction.\nThis is All-Souls’ day, fellow, is it not?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
