          "start": 9,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5268068,
        "end": 5268113,
        "line": 195914,
        "column": 1,
        "path": "chap29/p@209804",
        "anchor": "sceneV_29.1"
      },
      "speakerLabel": "SHERIFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-richard-the-third/sceneV_29.1/p@209853",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BUCKINGHAM.\nWhy, then All-Souls’ day is my body’s doomsday.\nThis is the day which, in King Edward’s time,\nI wished might fall on me when I was found\nFalse to his children and his wife’s allies.\nThis is the day wherein I wished to fall\nBy the false faith of him whom most I trusted.\nThis, this All-Souls’ day to my fearful soul\nIs the determined respite of my wrongs.\nThat high All-Seer which I dallied with\nHath turned my feigned prayer on my head\nAnd given in earnest what I begged in jest.\nThus doth He force the swords of wicked men\nTo turn their own points in their masters’ bosoms.\nThus Margaret’s curse falls heavy on my neck:\n“When he,” quoth she, “shall split thy heart with sorrow,\nRemember Margaret was a prophetess.”\nCome lead me, officers, to the block of shame;\nWrong hath but wrong, and blame the due of blame.",
      "separatorAfter": "\n\n",
      "spans": [],
