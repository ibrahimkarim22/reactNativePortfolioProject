    {
      "id": "king-richard-the-third/sceneV_29.2/p@212220",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHMOND.\nAll for our vantage. Then in God’s name, march.\nTrue hope is swift, and flies with swallow’s wings;\nKings it makes gods, and meaner creatures kings.",
