  "content": [
    {
      "id": "king-richard-the-third-5-4-stage-001",
      "type": "stage",
      "text": "Alarum. Excursions. Enter Norfolk and Soldiers; to him Catesby."
    },
    {
      "id": "king-richard-the-third-5-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "catesby",
        "name": "CATESBY",
        "displayName": "Catesby"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Rescue, my lord of Norfolk, rescue, rescue!",
          "plainText": "Rescue my lord of Norfolk rescue rescue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The King enacts more wonders than a man,",
          "plainText": "The King enacts more wonders than a man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Daring an opposite to every danger.",
          "plainText": "Daring an opposite to every danger",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-4-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "His horse is slain, and all on foot he fights,",
          "plainText": "His horse is slain and all on foot he fights",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-4-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Seeking for Richmond in the throat of death.",
          "plainText": "Seeking for Richmond in the throat of death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-4-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Rescue, fair lord, or else the day is lost!",
          "plainText": "Rescue fair lord or else the day is lost",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-4-stage-002",
      "type": "stage",
      "text": "[Exeunt Norfolk and Soldiers.]"
    },
    {
      "id": "king-richard-the-third-5-4-stage-003",
      "type": "stage",
      "text": "Alarum. Enter King Richard."
    },
    {
      "id": "king-richard-the-third-5-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "king-richard",
        "name": "KING RICHARD",
        "displayName": "King Richard"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "A horse! A horse! My kingdom for a horse!",
          "plainText": "A horse A horse My kingdom for a horse",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "catesby",
        "name": "CATESBY",
        "displayName": "Catesby"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Withdraw, my lord; I'll help you to a horse.",
          "plainText": "Withdraw my lord I'll help you to a horse",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "king-richard",
        "name": "KING RICHARD",
        "displayName": "King Richard"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Slave, I have set my life upon a cast,",
          "plainText": "Slave I have set my life upon a cast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-4-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "And I will stand the hazard of the die.",
          "plainText": "And I will stand the hazard of the die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-4-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "I think there be six Richmonds in the field;",
          "plainText": "I think there be six Richmonds in the field",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-4-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "Five have I slain today instead of him.",
          "plainText": "Five have I slain today instead of him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-4-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "A horse! A horse! My kingdom for a horse!",
          "plainText": "A horse A horse My kingdom for a horse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-4-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
