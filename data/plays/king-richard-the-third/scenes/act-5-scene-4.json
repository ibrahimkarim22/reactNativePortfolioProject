    {
      "id": "king-richard-the-third/sceneV_29.4/p@236880",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CATESBY.\nRescue, my lord of Norfolk, rescue, rescue!\nThe King enacts more wonders than a man,\nDaring an opposite to every danger.\nHis horse is slain, and all on foot he fights,\nSeeking for Richmond in the throat of death.\nRescue, fair lord, or else the day is lost!",
      "separatorAfter": "\n\n",
