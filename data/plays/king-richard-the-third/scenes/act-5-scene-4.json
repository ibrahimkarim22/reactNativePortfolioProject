    {
      "id": "king-richard-the-third/sceneV_29.4/p@237558",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING RICHARD.\nSlave, I have set my life upon a cast,\nAnd I will stand the hazard of the die.\nI think there be six Richmonds in the field;\nFive have I slain today instead of him.\nA horse! A horse! My kingdom for a horse!",
      "separatorAfter": "\n\n",
      "spans": [],
