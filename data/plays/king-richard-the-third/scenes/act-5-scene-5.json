    {
      "id": "king-richard-the-third/sceneV_29.5/p@238798",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHMOND.\nGreat God of heaven, say Amen to all!\nBut tell me, is young George Stanley living?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238798/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238798/line-2",
          "start": 10,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238798/line-3",
          "start": 48,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5297062,
        "end": 5297189,
        "line": 196859,
        "column": 1,
        "path": "chap29/p@238798",
        "anchor": "sceneV_29.5"
      },
      "speakerLabel": "RICHMOND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-richard-the-third/sceneV_29.5/p@238929",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "STANLEY.\nHe is, my lord, and safe in Leicester town,\nWhither, if it please you, we may now withdraw us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238929/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
