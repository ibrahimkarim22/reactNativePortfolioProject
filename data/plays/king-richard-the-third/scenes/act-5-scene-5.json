      }
    },
    {
      "id": "king-richard-the-third/sceneV_29.5/p@239071",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHMOND.\nWhat men of name are slain on either side?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneV_29.5/p@239071/line-1",
          "start": 0,
          "end": 9,
