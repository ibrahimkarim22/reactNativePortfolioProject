          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238929/line-3",
          "start": 53,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5297193,
        "end": 5297331,
        "line": 196865,
        "column": 1,
        "path": "chap29/p@238929",
