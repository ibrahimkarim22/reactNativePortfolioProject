    {
      "id": "king-richard-the-third/sceneV_29.5/p@238381",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHMOND.\nGod and your arms be praised, victorious friends!\nThe day is ours, the bloody dog is dead.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238381/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238381/line-2",
          "start": 10,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238381/line-3",
          "start": 60,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5296645,
        "end": 5296780,
        "line": 196844,
        "column": 1,
        "path": "chap29/p@238381",
        "anchor": "sceneV_29.5"
      },
      "speakerLabel": "RICHMOND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-richard-the-third/sceneV_29.5/p@238520",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "STANLEY.\nCourageous Richmond, well hast thou acquit thee!\nLo, here, this long-usurped royalty\nFrom the dead temples of this bloody wretch\nHave I plucked off, to grace thy brows withal.\nWear it, enjoy it, and make much of it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238520/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238520/line-2",
          "start": 9,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238520/line-3",
          "start": 58,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238520/line-4",
          "start": 94,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238520/line-5",
          "start": 138,
          "end": 184,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@238520/line-6",
          "start": 185,
          "end": 224,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
