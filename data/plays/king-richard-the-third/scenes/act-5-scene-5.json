          "start": 10,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5297335,
        "end": 5297417,
        "line": 196871,
        "column": 1,
        "path": "chap29/p@239071",
        "anchor": "sceneV_29.5"
      },
      "speakerLabel": "RICHMOND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "king-richard-the-third/sceneV_29.5/p@239157",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "STANLEY.\nJohn, Duke of Norfolk, Walter, Lord Ferrers,\nSir Robert Brakenbury, and Sir William Brandon.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "king-richard-the-third/sceneV_29.5/p@239157/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@239157/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "king-richard-the-third/sceneV_29.5/p@239157/line-3",
          "start": 54,
          "end": 101,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5297421,
        "end": 5297557,
        "line": 196876,
        "column": 1,
        "path": "chap29/p@239157",
        "anchor": "sceneV_29.5"
      },
      "speakerLabel": "STANLEY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "king-richard-the-third/sceneV_29.5/p@239297",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHMOND.\nInter their bodies as becomes their births.\nProclaim a pardon to the soldiers fled\nThat in submission will return to us.\nAnd then, as we have ta’en the sacrament,\nWe will unite the white rose and the red.\nSmile heaven upon this fair conjunction,\nThat long have frowned upon their enmity.\nWhat traitor hears me and says not Amen?\nEngland hath long been mad, and scarred herself:\nThe brother blindly shed the brother’s blood;\nThe father rashly slaughtered his own son;\nThe son, compelled, been butcher to the sire.\nAll this divided York and Lancaster,\nDivided in their dire division.\nO, now let Richmond and Elizabeth,\nThe true succeeders of each royal house,\nBy God’s fair ordinance conjoin together,\nAnd let their heirs, God, if Thy will be so,\nEnrich the time to come with smoothed-faced peace,\nWith smiling plenty, and fair prosperous days.\nAbate the edge of traitors, gracious Lord,\nThat would reduce these bloody days again,\nAnd make poor England weep in streams of blood.\nLet them not live to taste this land’s increase,\nThat would with treason wound this fair land’s peace.\nNow civil wounds are stopped, peace lives again.\nThat she may long live here, God say Amen.",
      "separatorAfter": "\n\n",
