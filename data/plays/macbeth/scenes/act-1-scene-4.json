    {
      "id": "macbeth/sceneI_20.4/p@21677",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUNCAN.\nWelcome hither:\nI have begun to plant thee, and will labour\nTo make thee full of growing.—Noble Banquo,\nThat hast no less deserv’d, nor must be known\nNo less to have done so, let me infold thee\nAnd hold thee to my heart.",
