      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUNCAN.\nIs execution done on Cawdor? Are not\nThose in commission yet return’d?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneI_20.4/p@20080/line-1",
