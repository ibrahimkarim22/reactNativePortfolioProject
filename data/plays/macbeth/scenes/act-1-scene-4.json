    {
      "id": "macbeth/sceneI_20.4/p@22568",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nThe rest is labour, which is not us’d for you:\nI’ll be myself the harbinger, and make joyful\nThe hearing of my wife with your approach;\nSo, humbly take my leave.",
