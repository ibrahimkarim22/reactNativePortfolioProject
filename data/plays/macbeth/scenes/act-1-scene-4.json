    {
      "id": "macbeth/sceneI_20.4/p@21350",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nThe service and the loyalty I owe,\nIn doing it, pays itself. Your Highness’ part\nIs to receive our duties: and our duties\nAre to your throne and state, children and servants;\nWhich do but what they should, by doing everything\nSafe toward your love and honour.",
      "separatorAfter": "\n\n",
      "spans": [],
