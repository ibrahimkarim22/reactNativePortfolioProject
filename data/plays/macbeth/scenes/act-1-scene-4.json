    {
      "id": "macbeth/sceneI_20.4/p@20962",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "O worthiest cousin!\nThe sin of my ingratitude even now\nWas heavy on me. Thou art so far before,\nThat swiftest wing of recompense is slow\nTo overtake thee. Would thou hadst less deserv’d;\nThat the proportion both of thanks and payment\nMight have been mine! only I have left to say,\nMore is thy due than more than all can pay.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
