      "id": "macbeth/sceneI_20.4/p@20664",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUNCAN.\nThere’s no art\nTo find the mind’s construction in the face:\nHe was a gentleman on whom I built\nAn absolute trust.",
