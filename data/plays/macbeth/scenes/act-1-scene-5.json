  "content": [
    {
      "id": "macbeth-1-5-stage-001",
      "type": "stage",
      "text": "Enter Lady Macbeth, reading a letter."
    },
    {
      "id": "macbeth-1-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "\"They met me in the day of success; and I have learned by the perfect'st report they have more in them than mortal knowledge. When I burned in desire to question them further, they made themselves air, into which they vanished. Whiles I stood rapt in the wonder of it, came missives from the King, who all-hailed me, 'Thane of Cawdor'; by which title, before, these Weird Sisters saluted me, and referred me to the coming on of time, with 'Hail, king that shalt be!' This have I thought good to deliver thee (my dearest partner of greatness) that thou might'st not lose the dues of rejoicing, by being ignorant of what greatness is promis'd thee. Lay it to thy heart, and farewell.\"",
          "plainText": "They met me in the day of success and I have learned by the perfect'st report they have more in them than mortal knowledge When I burned in desire to question them further they made themselves air into which they vanished Whiles I stood rapt in the wonder of it came missives from the King who allhailed me 'Thane of Cawdor' by which title before these Weird Sisters saluted me and referred me to the coming on of time with 'Hail king that shalt be' This have I thought good to deliver thee my dearest partner of greatness that thou might'st not lose the dues of rejoicing by being ignorant of what greatness is promis'd thee Lay it to thy heart and farewell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-1-5-stage-002",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "macbeth-1-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "The King comes here tonight.",
          "plainText": "The King comes here tonight",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-1-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Thou'rt mad to say it.",
          "plainText": "Thou'rt mad to say it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Is not thy master with him? who, were't so,",
          "plainText": "Is not thy master with him who were't so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Would have inform'd for preparation.",
          "plainText": "Would have inform'd for preparation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-1-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "So please you, it is true. Our thane is coming.",
          "plainText": "So please you it is true Our thane is coming",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "One of my fellows had the speed of him,",
          "plainText": "One of my fellows had the speed of him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "Who, almost dead for breath, had scarcely more",
          "plainText": "Who almost dead for breath had scarcely more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Than would make up his message.",
          "plainText": "Than would make up his message",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-1-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Give him tending.",
          "plainText": "Give him tending",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "He brings great news.",
          "plainText": "He brings great news",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-1-5-stage-003",
      "type": "stage",
      "text": "[Exit Messenger.]"
    },
    {
      "id": "macbeth-1-5-stage-004",
      "type": "stage",
      "text": "Enter Macbeth."
    },
    {
      "id": "macbeth-1-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "My dearest love,",
          "plainText": "My dearest love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Duncan comes here tonight.",
          "plainText": "Duncan comes here tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-1-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "And when goes hence?",
          "plainText": "And when goes hence",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-1-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Tomorrow, as he purposes.",
          "plainText": "Tomorrow as he purposes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-1-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "O, never",
          "plainText": "O never",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Shall sun that morrow see!",
          "plainText": "Shall sun that morrow see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Your face, my thane, is as a book where men",
          "plainText": "Your face my thane is as a book where men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "May read strange matters. To beguile the time,",
          "plainText": "May read strange matters To beguile the time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "Look like the time; bear welcome in your eye,",
          "plainText": "Look like the time bear welcome in your eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0021",
          "number": 21,
          "speechLineNumber": 6,
          "text": "Your hand, your tongue: look like the innocent flower,",
          "plainText": "Your hand your tongue look like the innocent flower",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0022",
          "number": 22,
          "speechLineNumber": 7,
          "text": "But be the serpent under't. He that's coming",
          "plainText": "But be the serpent under't He that's coming",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0023",
          "number": 23,
          "speechLineNumber": 8,
          "text": "Must be provided for; and you shall put",
          "plainText": "Must be provided for and you shall put",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0024",
          "number": 24,
          "speechLineNumber": 9,
          "text": "This night's great business into my dispatch;",
          "plainText": "This night's great business into my dispatch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0025",
          "number": 25,
          "speechLineNumber": 10,
          "text": "Which shall to all our nights and days to come",
          "plainText": "Which shall to all our nights and days to come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0026",
          "number": 26,
          "speechLineNumber": 11,
          "text": "Give solely sovereign sway and masterdom.",
          "plainText": "Give solely sovereign sway and masterdom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-1-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "We will speak further.",
          "plainText": "We will speak further",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-1-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-1-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Only look up clear;",
          "plainText": "Only look up clear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "To alter favour ever is to fear.",
          "plainText": "To alter favour ever is to fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-5-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "Leave all the rest to me.",
          "plainText": "Leave all the rest to me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-1-5-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}