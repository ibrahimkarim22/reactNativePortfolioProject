    {
      "id": "macbeth/sceneI_20.6/p@29773",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUNCAN.\nWhere’s the Thane of Cawdor?\nWe cours’d him at the heels, and had a purpose\nTo be his purveyor: but he rides well;\nAnd his great love, sharp as his spur, hath holp him\nTo his home before us. Fair and noble hostess,\nWe are your guest tonight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
