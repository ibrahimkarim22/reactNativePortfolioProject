    {
      "id": "macbeth/sceneI_20.6/p@29430",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LADY MACBETH.\nAll our service,\nIn every point twice done, and then done double,\nWere poor and single business to contend\nAgainst those honours deep and broad wherewith\nYour Majesty loads our house: for those of old,\nAnd the late dignities heap’d up to them,\nWe rest your hermits.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
