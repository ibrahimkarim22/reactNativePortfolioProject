          "start": 41,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneI_20.6/p@29160/line-4",
          "start": 91,
          "end": 139,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneI_20.6/p@29160/line-5",
          "start": 140,
          "end": 185,
          "sourceLineNumber": null
        },
        {
