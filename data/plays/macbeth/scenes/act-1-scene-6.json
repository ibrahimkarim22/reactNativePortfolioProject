    {
      "id": "macbeth/sceneI_20.6/p@29160",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUNCAN.\nSee, see, our honour’d hostess!—\nThe love that follows us sometime is our trouble,\nWhich still we thank as love. Herein I teach you\nHow you shall bid God ’ild us for your pains,\nAnd thank us for your trouble.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
