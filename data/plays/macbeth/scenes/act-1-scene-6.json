    {
      "id": "macbeth/sceneI_20.6/p@28534",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUNCAN.\nThis castle hath a pleasant seat. The air\nNimbly and sweetly recommends itself\nUnto our gentle senses.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneI_20.6/p@28534/line-1",
          "start": 0,
