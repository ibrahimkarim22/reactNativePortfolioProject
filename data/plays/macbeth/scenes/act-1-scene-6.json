          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneI_20.6/p@28534/line-4",
          "start": 87,
          "end": 110,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3592726,
        "end": 3592876,
        "line": 132289,
