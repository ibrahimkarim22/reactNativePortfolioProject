    {
      "id": "macbeth/sceneI_20.6/p@30291",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUNCAN.\nGive me your hand;\nConduct me to mine host: we love him highly,\nAnd shall continue our graces towards him.\nBy your leave, hostess.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
