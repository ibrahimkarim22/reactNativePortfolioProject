    {
      "id": "macbeth/sceneI_20.6/p@30081",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LADY MACBETH.\nYour servants ever\nHave theirs, themselves, and what is theirs, in compt,\nTo make their audit at your Highness’ pleasure,\nStill to return your own.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
