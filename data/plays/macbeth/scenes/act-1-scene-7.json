    {
      "id": "macbeth/sceneI_20.7/p@34860",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nBring forth men-children only;\nFor thy undaunted mettle should compose\nNothing but males. Will it not be receiv’d,\nWhen we have mark’d with blood those sleepy two\nOf his own chamber, and us’d their very daggers,\nThat they have done’t?",
