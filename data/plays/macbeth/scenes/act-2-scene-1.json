        "end": 3601197,
        "line": 132569,
        "column": 1,
        "path": "chap20/p@36708",
        "anchor": "sceneII_20.1"
      },
      "speakerLabel": "BANQUO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "macbeth/sceneII_20.1/p@37009",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nBeing unprepar’d,\nOur will became the servant to defect,\nWhich else should free have wrought.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.1/p@37009/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37009/line-2",
          "start": 9,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37009/line-3",
          "start": 27,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37009/line-4",
          "start": 66,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3601201,
        "end": 3601343,
        "line": 132579,
        "column": 1,
        "path": "chap20/p@37009",
        "anchor": "sceneII_20.1"
      },
      "speakerLabel": "MACBETH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "macbeth/sceneII_20.1/p@37155",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BANQUO.\nAll’s well.\nI dreamt last night of the three Weird Sisters:\nTo you they have show’d some truth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.1/p@37155/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37155/line-2",
          "start": 8,
          "end": 19,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37155/line-3",
          "start": 20,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37155/line-4",
          "start": 68,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3601347,
        "end": 3601490,
        "line": 132586,
        "column": 1,
        "path": "chap20/p@37155",
        "anchor": "sceneII_20.1"
      },
      "speakerLabel": "BANQUO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "macbeth/sceneII_20.1/p@37302",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nI think not of them:\nYet, when we can entreat an hour to serve,\nWe would spend it in some words upon that business,\nIf you would grant the time.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.1/p@37302/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37302/line-2",
          "start": 9,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37302/line-3",
          "start": 30,
          "end": 72,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37302/line-4",
          "start": 73,
          "end": 124,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37302/line-5",
          "start": 125,
          "end": 153,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3601494,
        "end": 3601692,
        "line": 132593,
        "column": 1,
        "path": "chap20/p@37302",
        "anchor": "sceneII_20.1"
      },
      "speakerLabel": "MACBETH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "macbeth/sceneII_20.1/p@37504",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BANQUO.\nAt your kind’st leisure.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.1/p@37504/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37504/line-2",
          "start": 8,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3601696,
        "end": 3601758,
        "line": 132601,
        "column": 1,
        "path": "chap20/p@37504",
        "anchor": "sceneII_20.1"
      },
      "speakerLabel": "BANQUO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "macbeth/sceneII_20.1/p@37570",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nIf you shall cleave to my consent, when ’tis,\nIt shall make honour for you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.1/p@37570/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37570/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37570/line-3",
          "start": 55,
          "end": 84,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3601762,
        "end": 3601881,
        "line": 132606,
        "column": 1,
        "path": "chap20/p@37570",
        "anchor": "sceneII_20.1"
      },
      "speakerLabel": "MACBETH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "macbeth/sceneII_20.1/p@37693",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BANQUO.\nSo I lose none\nIn seeking to augment it, but still keep\nMy bosom franchis’d, and allegiance clear,\nI shall be counsell’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.1/p@37693/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37693/line-2",
          "start": 8,
          "end": 22,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37693/line-3",
          "start": 23,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@37693/line-4",
