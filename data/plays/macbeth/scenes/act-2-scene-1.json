    {
      "id": "macbeth/sceneII_20.1/p@36708",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BANQUO.\nWhat, sir, not yet at rest? The King’s abed:\nHe hath been in unusual pleasure and\nSent forth great largess to your offices.\nThis diamond he greets your wife withal,\nBy the name of most kind hostess, and shut up\nIn measureless content.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.1/p@36708/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@36708/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@36708/line-3",
          "start": 53,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@36708/line-4",
          "start": 90,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@36708/line-5",
          "start": 132,
          "end": 172,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@36708/line-6",
          "start": 173,
          "end": 218,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.1/p@36708/line-7",
          "start": 219,
          "end": 242,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
