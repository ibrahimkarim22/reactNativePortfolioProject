    {
      "id": "macbeth/sceneII_20.1/p@36174",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BANQUO.\nHold, take my sword.—There’s husbandry in heaven;\nTheir candles are all out. Take thee that too.\nA heavy summons lies like lead upon me,\nAnd yet I would not sleep. Merciful powers,\nRestrain in me the cursed thoughts that nature\nGives way to in repose!\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
