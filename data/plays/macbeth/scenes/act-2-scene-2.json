      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nI’ll go no more:\nI am afraid to think what I have done;\nLook on’t again I dare not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
