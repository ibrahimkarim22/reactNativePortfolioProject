    {
      "id": "macbeth/sceneII_20.2/p@43352",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LADY MACBETH.\nWho was it that thus cried? Why, worthy thane,\nYou do unbend your noble strength to think\nSo brainsickly of things. Go get some water,\nAnd wash this filthy witness from your hand.—\nWhy did you bring these daggers from the place?\nThey must lie there: go carry them, and smear\nThe sleepy grooms with blood.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
