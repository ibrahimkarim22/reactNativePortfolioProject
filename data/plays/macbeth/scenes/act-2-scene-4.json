    {
      "id": "macbeth/sceneII_20.4/p@56816",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OLD MAN.\n’Tis unnatural,\nEven like the deed that’s done. On Tuesday last,\nA falcon, towering in her pride of place,\nWas by a mousing owl hawk’d at and kill’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
