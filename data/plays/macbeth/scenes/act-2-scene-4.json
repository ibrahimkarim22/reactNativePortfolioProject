          "end": 20,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@57871/line-3",
          "start": 21,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3622063,
        "end": 3622148,
        "line": 133396,
        "column": 1,
        "path": "chap20/p@57871",
        "anchor": "sceneII_20.4"
      },
      "speakerLabel": "ROSS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "macbeth/sceneII_20.4/p@57960",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACDUFF.\nThey were suborn’d.\nMalcolm and Donalbain, the King’s two sons,\nAre stol’n away and fled; which puts upon them\nSuspicion of the deed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.4/p@57960/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@57960/line-2",
          "start": 9,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@57960/line-3",
          "start": 29,
          "end": 72,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@57960/line-4",
          "start": 73,
          "end": 119,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@57960/line-5",
          "start": 120,
          "end": 142,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3622152,
        "end": 3622339,
        "line": 133402,
        "column": 1,
        "path": "chap20/p@57960",
