    {
      "id": "macbeth/sceneII_20.4/p@57379",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSS.\nThey did so; to the amazement of mine eyes,\nThat look’d upon’t.\nHere comes the good Macduff.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.4/p@57379/line-1",
