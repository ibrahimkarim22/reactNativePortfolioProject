      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACDUFF.\nHe is already nam’d; and gone to Scone\nTo be invested.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.4/p@58351/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@58351/line-2",
          "start": 9,
          "end": 47,
          "sourceLineNumber": null
        },
        {
