        },
        {
          "id": "macbeth/sceneII_20.4/p@58151/line-5",
          "start": 112,
          "end": 151,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3622343,
        "end": 3622539,
        "line": 133410,
        "column": 1,
        "path": "chap20/p@58151",
        "anchor": "sceneII_20.4"
