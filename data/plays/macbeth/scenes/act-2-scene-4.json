    {
      "id": "macbeth/sceneII_20.4/p@56451",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSS.\nHa, good father,\nThou seest the heavens, as troubled with man’s act,\nThreatens his bloody stage: by the clock ’tis day,\nAnd yet dark night strangles the travelling lamp.\nIs’t night’s predominance, or the day’s shame,\nThat darkness does the face of earth entomb,\nWhen living light should kiss it?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.4/p@56451/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@56451/line-2",
          "start": 6,
          "end": 22,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@56451/line-3",
