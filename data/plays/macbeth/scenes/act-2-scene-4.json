          "start": 49,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@56225/line-4",
          "start": 93,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@56225/line-5",
          "start": 148,
          "end": 177,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
