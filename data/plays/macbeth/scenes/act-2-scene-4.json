      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "macbeth/sceneII_20.4/p@58151",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSS.\n’Gainst nature still:\nThriftless ambition, that will ravin up\nThine own life’s means!—Then ’tis most like\nThe sovereignty will fall upon Macbeth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
