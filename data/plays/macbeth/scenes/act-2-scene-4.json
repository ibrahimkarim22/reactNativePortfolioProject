      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSS.\nIs’t known who did this more than bloody deed?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.4/p@57712/line-1",
          "start": 0,
