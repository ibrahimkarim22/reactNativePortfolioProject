          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@56816/line-2",
          "start": 9,
          "end": 24,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@56816/line-3",
          "start": 25,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@56816/line-4",
          "start": 74,
          "end": 115,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@56816/line-5",
          "start": 116,
          "end": 158,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3621008,
        "end": 3621211,
        "line": 133346,
        "column": 1,
        "path": "chap20/p@56816",
