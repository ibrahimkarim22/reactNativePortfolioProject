      ],
      "sourceRef": {
        "start": 3621990,
        "end": 3622059,
        "line": 133391,
        "column": 1,
        "path": "chap20/p@57798",
        "anchor": "sceneII_20.4"
      },
      "speakerLabel": "MACDUFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
