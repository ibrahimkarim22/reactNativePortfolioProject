      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACDUFF.\nWhy, see you not?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.4/p@57652/line-1",
          "start": 0,
