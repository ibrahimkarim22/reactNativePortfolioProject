          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@57023/line-5",
          "start": 163,
          "end": 211,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneII_20.4/p@57023/line-6",
          "start": 212,
          "end": 229,
          "sourceLineNumber": null
        }
      ],
