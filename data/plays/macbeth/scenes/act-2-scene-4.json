      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OLD MAN.\n’Tis said they eat each other.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.4/p@57306/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
