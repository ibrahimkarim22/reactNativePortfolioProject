    },
    {
      "id": "macbeth/sceneII_20.4/p@57871",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROSS.\nAlas, the day!\nWhat good could they pretend?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneII_20.4/p@57871/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
