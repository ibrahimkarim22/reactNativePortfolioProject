  "content": [
    {
      "id": "macbeth-3-2-stage-001",
      "type": "stage",
      "text": "Enter Lady Macbeth and a Servant."
    },
    {
      "id": "macbeth-3-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Is Banquo gone from court?",
          "plainText": "Is Banquo gone from court",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Ay, madam, but returns again tonight.",
          "plainText": "Ay madam but returns again tonight",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Say to the King, I would attend his leisure",
          "plainText": "Say to the King I would attend his leisure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "For a few words.",
          "plainText": "For a few words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Madam, I will.",
          "plainText": "Madam I will",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-3-2-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "macbeth-3-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Naught's had, all's spent,",
          "plainText": "Naught's had all's spent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Where our desire is got without content:",
          "plainText": "Where our desire is got without content",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "'Tis safer to be that which we destroy,",
          "plainText": "'Tis safer to be that which we destroy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Than by destruction dwell in doubtful joy.",
          "plainText": "Than by destruction dwell in doubtful joy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-2-stage-003",
      "type": "stage",
      "text": "Enter Macbeth."
    },
    {
      "id": "macbeth-3-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "We have scorch'd the snake, not kill'd it.",
          "plainText": "We have scorch'd the snake not kill'd it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "She'll close, and be herself; whilst our poor malice",
          "plainText": "She'll close and be herself whilst our poor malice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "Remains in danger of her former tooth.",
          "plainText": "Remains in danger of her former tooth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "But let the frame of things disjoint,",
          "plainText": "But let the frame of things disjoint",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0014",
          "number": 14,
          "speechLineNumber": 5,
          "text": "Both the worlds suffer,",
          "plainText": "Both the worlds suffer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0015",
          "number": 15,
          "speechLineNumber": 6,
          "text": "Ere we will eat our meal in fear, and sleep",
          "plainText": "Ere we will eat our meal in fear and sleep",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0016",
          "number": 16,
          "speechLineNumber": 7,
          "text": "In the affliction of these terrible dreams",
          "plainText": "In the affliction of these terrible dreams",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0017",
          "number": 17,
          "speechLineNumber": 8,
          "text": "That shake us nightly. Better be with the dead,",
          "plainText": "That shake us nightly Better be with the dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0018",
          "number": 18,
          "speechLineNumber": 9,
          "text": "Whom we, to gain our peace, have sent to peace,",
          "plainText": "Whom we to gain our peace have sent to peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0019",
          "number": 19,
          "speechLineNumber": 10,
          "text": "Than on the torture of the mind to lie",
          "plainText": "Than on the torture of the mind to lie",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0020",
          "number": 20,
          "speechLineNumber": 11,
          "text": "In restless ecstasy. Duncan is in his grave;",
          "plainText": "In restless ecstasy Duncan is in his grave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0021",
          "number": 21,
          "speechLineNumber": 12,
          "text": "After life's fitful fever he sleeps well;",
          "plainText": "After life's fitful fever he sleeps well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0022",
          "number": 22,
          "speechLineNumber": 13,
          "text": "Treason has done his worst: nor steel, nor poison,",
          "plainText": "Treason has done his worst nor steel nor poison",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0023",
          "number": 23,
          "speechLineNumber": 14,
          "text": "Malice domestic, foreign levy, nothing",
          "plainText": "Malice domestic foreign levy nothing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0024",
          "number": 24,
          "speechLineNumber": 15,
          "text": "Can touch him further.",
          "plainText": "Can touch him further",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Come on,",
          "plainText": "Come on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Gently my lord, sleek o'er your rugged looks;",
          "plainText": "Gently my lord sleek o'er your rugged looks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "Be bright and jovial among your guests tonight.",
          "plainText": "Be bright and jovial among your guests tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "So shall I, love; and so, I pray, be you.",
          "plainText": "So shall I love and so I pray be you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "Let your remembrance apply to Banquo;",
          "plainText": "Let your remembrance apply to Banquo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "Present him eminence, both with eye and tongue:",
          "plainText": "Present him eminence both with eye and tongue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0031",
          "number": 31,
          "speechLineNumber": 4,
          "text": "Unsafe the while, that we",
          "plainText": "Unsafe the while that we",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0032",
          "number": 32,
          "speechLineNumber": 5,
          "text": "Must lave our honours in these flattering streams,",
          "plainText": "Must lave our honours in these flattering streams",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0033",
          "number": 33,
          "speechLineNumber": 6,
          "text": "And make our faces vizards to our hearts,",
          "plainText": "And make our faces vizards to our hearts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0034",
          "number": 34,
          "speechLineNumber": 7,
          "text": "Disguising what they are.",
          "plainText": "Disguising what they are",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "You must leave this.",
          "plainText": "You must leave this",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "O, full of scorpions is my mind, dear wife!",
          "plainText": "O full of scorpions is my mind dear wife",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "Thou know'st that Banquo, and his Fleance, lives.",
          "plainText": "Thou know'st that Banquo and his Fleance lives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "But in them nature's copy's not eterne.",
          "plainText": "But in them nature's copy's not eterne",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "There's comfort yet; they are assailable.",
          "plainText": "There's comfort yet they are assailable",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "Then be thou jocund. Ere the bat hath flown",
          "plainText": "Then be thou jocund Ere the bat hath flown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "His cloister'd flight, ere to black Hecate's summons",
          "plainText": "His cloister'd flight ere to black Hecate's summons",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0042",
          "number": 42,
          "speechLineNumber": 4,
          "text": "The shard-born beetle, with his drowsy hums,",
          "plainText": "The shardborn beetle with his drowsy hums",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0043",
          "number": 43,
          "speechLineNumber": 5,
          "text": "Hath rung night's yawning peal, there shall be done",
          "plainText": "Hath rung night's yawning peal there shall be done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0044",
          "number": 44,
          "speechLineNumber": 6,
          "text": "A deed of dreadful note.",
          "plainText": "A deed of dreadful note",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "What's to be done?",
          "plainText": "What's to be done",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-3-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-3-2-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Be innocent of the knowledge, dearest chuck,",
          "plainText": "Be innocent of the knowledge dearest chuck",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Till thou applaud the deed. Come, seeling night,",
          "plainText": "Till thou applaud the deed Come seeling night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "Scarf up the tender eye of pitiful day,",
          "plainText": "Scarf up the tender eye of pitiful day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "And with thy bloody and invisible hand",
          "plainText": "And with thy bloody and invisible hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0050",
          "number": 50,
          "speechLineNumber": 5,
          "text": "Cancel and tear to pieces that great bond",
          "plainText": "Cancel and tear to pieces that great bond",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-2-line-0051",
          "number": 51,
          "speechLineNumber": 6,
          "text": "Which keeps me pale!—Light thickens; and the crow",
          "plainText": "Which keeps me paleLight thickens and the crow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
