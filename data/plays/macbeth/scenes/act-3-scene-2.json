          "end": 186,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneIII_20.2/p@69266/line-5",
          "start": 187,
          "end": 233,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3633458,
        "end": 3633736,
        "line": 133842,
        "column": 1,
