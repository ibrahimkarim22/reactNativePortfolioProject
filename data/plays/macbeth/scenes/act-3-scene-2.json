    {
      "id": "macbeth/sceneIII_20.2/p@69266",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "How now, my lord, why do you keep alone,\nOf sorriest fancies your companions making,\nUsing those thoughts which should indeed have died\nWith them they think on? Things without all remedy\nShould be without regard: what’s done is done.",
      "separatorAfter": "\n\n",
      "spans": [],
