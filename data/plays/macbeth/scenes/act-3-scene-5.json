    "title": "SCENE V. The heath.",
    "location": "The heath.",
    "orderInPlay": 16
  },
  "content": [
    {
      "id": "macbeth-3-5-stage-001",
      "type": "stage",
      "text": "Thunder. Enter the three Witches meeting Hecate."
    },
    {
      "id": "macbeth-3-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-witch",
        "name": "FIRST WITCH",
        "displayName": "First Witch"
      },
      "lines": [
        {
          "id": "macbeth-3-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Why, how now, Hecate? you look angerly.",
          "plainText": "Why how now Hecate you look angerly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-3-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "hecate",
        "name": "HECATE",
        "displayName": "Hecate"
      },
      "lines": [
        {
          "id": "macbeth-3-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Have I not reason, beldams as you are,",
          "plainText": "Have I not reason beldams as you are",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Saucy and overbold? How did you dare",
          "plainText": "Saucy and overbold How did you dare",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "To trade and traffic with Macbeth",
          "plainText": "To trade and traffic with Macbeth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "In riddles and affairs of death;",
          "plainText": "In riddles and affairs of death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0006",
          "number": 6,
          "speechLineNumber": 5,
          "text": "And I, the mistress of your charms,",
          "plainText": "And I the mistress of your charms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0007",
          "number": 7,
          "speechLineNumber": 6,
          "text": "The close contriver of all harms,",
          "plainText": "The close contriver of all harms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0008",
          "number": 8,
          "speechLineNumber": 7,
          "text": "Was never call'd to bear my part,",
          "plainText": "Was never call'd to bear my part",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0009",
          "number": 9,
          "speechLineNumber": 8,
          "text": "Or show the glory of our art?",
          "plainText": "Or show the glory of our art",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0010",
          "number": 10,
          "speechLineNumber": 9,
          "text": "And, which is worse, all you have done",
          "plainText": "And which is worse all you have done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0011",
          "number": 11,
          "speechLineNumber": 10,
          "text": "Hath been but for a wayward son,",
          "plainText": "Hath been but for a wayward son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0012",
          "number": 12,
          "speechLineNumber": 11,
          "text": "Spiteful and wrathful; who, as others do,",
          "plainText": "Spiteful and wrathful who as others do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0013",
          "number": 13,
          "speechLineNumber": 12,
          "text": "Loves for his own ends, not for you.",
          "plainText": "Loves for his own ends not for you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0014",
          "number": 14,
          "speechLineNumber": 13,
          "text": "But make amends now: get you gone,",
          "plainText": "But make amends now get you gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0015",
          "number": 15,
          "speechLineNumber": 14,
          "text": "And at the pit of Acheron",
          "plainText": "And at the pit of Acheron",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0016",
          "number": 16,
          "speechLineNumber": 15,
          "text": "Meet me i' th' morning: thither he",
          "plainText": "Meet me i' th' morning thither he",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0017",
          "number": 17,
          "speechLineNumber": 16,
          "text": "Will come to know his destiny.",
          "plainText": "Will come to know his destiny",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0018",
          "number": 18,
          "speechLineNumber": 17,
          "text": "Your vessels and your spells provide,",
          "plainText": "Your vessels and your spells provide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0019",
          "number": 19,
          "speechLineNumber": 18,
          "text": "Your charms, and everything beside.",
          "plainText": "Your charms and everything beside",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0020",
          "number": 20,
          "speechLineNumber": 19,
          "text": "I am for th' air; this night I'll spend",
          "plainText": "I am for th' air this night I'll spend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0021",
          "number": 21,
          "speechLineNumber": 20,
          "text": "Unto a dismal and a fatal end.",
          "plainText": "Unto a dismal and a fatal end",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0022",
          "number": 22,
          "speechLineNumber": 21,
          "text": "Great business must be wrought ere noon.",
          "plainText": "Great business must be wrought ere noon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0023",
          "number": 23,
          "speechLineNumber": 22,
          "text": "Upon the corner of the moon",
          "plainText": "Upon the corner of the moon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0024",
          "number": 24,
          "speechLineNumber": 23,
          "text": "There hangs a vap'rous drop profound;",
          "plainText": "There hangs a vap'rous drop profound",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0025",
          "number": 25,
          "speechLineNumber": 24,
          "text": "I'll catch it ere it come to ground:",
          "plainText": "I'll catch it ere it come to ground",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0026",
          "number": 26,
          "speechLineNumber": 25,
          "text": "And that, distill'd by magic sleights,",
          "plainText": "And that distill'd by magic sleights",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0027",
          "number": 27,
          "speechLineNumber": 26,
          "text": "Shall raise such artificial sprites,",
          "plainText": "Shall raise such artificial sprites",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0028",
          "number": 28,
          "speechLineNumber": 27,
          "text": "As, by the strength of their illusion,",
          "plainText": "As by the strength of their illusion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0029",
          "number": 29,
          "speechLineNumber": 28,
          "text": "Shall draw him on to his confusion.",
          "plainText": "Shall draw him on to his confusion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0030",
          "number": 30,
          "speechLineNumber": 29,
          "text": "He shall spurn fate, scorn death, and bear",
          "plainText": "He shall spurn fate scorn death and bear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0031",
          "number": 31,
          "speechLineNumber": 30,
          "text": "His hopes 'bove wisdom, grace, and fear.",
          "plainText": "His hopes 'bove wisdom grace and fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0032",
          "number": 32,
          "speechLineNumber": 31,
          "text": "And you all know, security",
          "plainText": "And you all know security",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-5-line-0033",
          "number": 33,
          "speechLineNumber": 32,
          "text": "Is mortals' chiefest enemy.",
          "plainText": "Is mortals' chiefest enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-5-stage-002",
      "type": "stage",
      "text": "[Music and song within, \"Come away, come away\" &c.]"
    },
    {
      "id": "macbeth-3-5-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "macbeth-3-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-witch",
        "name": "FIRST WITCH",
        "displayName": "First Witch"
      },
      "lines": [
        {
          "id": "macbeth-3-5-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Come, let's make haste; she'll soon be back again.",
          "plainText": "Come let's make haste she'll soon be back again",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-3-5-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}