        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Ay, that he was.",
          "plainText": "Ay that he was",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
