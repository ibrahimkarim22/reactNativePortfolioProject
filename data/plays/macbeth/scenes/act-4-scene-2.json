      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Every one that does so is a traitor, and must be hanged.",
          "plainText": "Every one that does so is a traitor and must be hanged",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "son",
        "name": "SON",
        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "And must they all be hanged that swear and lie?",
          "plainText": "And must they all be hanged that swear and lie",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Every one.",
          "plainText": "Every one",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "son",
        "name": "SON",
        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Who must hang them?",
          "plainText": "Who must hang them",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Why, the honest men.",
          "plainText": "Why the honest men",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "son",
        "name": "SON",
        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Then the liars and swearers are fools: for there are liars and swearers enow to beat the honest men and hang up them.",
          "plainText": "Then the liars and swearers are fools for there are liars and swearers enow to beat the honest men and hang up them",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Now, God help thee, poor monkey! But how wilt thou do for a father?",
          "plainText": "Now God help thee poor monkey But how wilt thou do for a father",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "son",
        "name": "SON",
        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "If he were dead, you'ld weep for him: if you would not, it were a good sign that I should quickly have a new father.",
          "plainText": "If he were dead you'ld weep for him if you would not it were a good sign that I should quickly have a new father",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-033",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Poor prattler, how thou talk'st!",
          "plainText": "Poor prattler how thou talk'st",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-stage-003",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "macbeth-4-2-speech-034",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Bless you, fair dame! I am not to you known,",
          "plainText": "Bless you fair dame I am not to you known",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "Though in your state of honour I am perfect.",
          "plainText": "Though in your state of honour I am perfect",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "I doubt some danger does approach you nearly:",
          "plainText": "I doubt some danger does approach you nearly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "If you will take a homely man's advice,",
          "plainText": "If you will take a homely man's advice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0067",
          "number": 67,
          "speechLineNumber": 5,
          "text": "Be not found here; hence, with your little ones.",
          "plainText": "Be not found here hence with your little ones",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0068",
          "number": 68,
          "speechLineNumber": 6,
          "text": "To fright you thus, methinks, I am too savage;",
          "plainText": "To fright you thus methinks I am too savage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0069",
          "number": 69,
          "speechLineNumber": 7,
          "text": "To do worse to you were fell cruelty,",
          "plainText": "To do worse to you were fell cruelty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0070",
          "number": 70,
          "speechLineNumber": 8,
          "text": "Which is too nigh your person. Heaven preserve you!",
          "plainText": "Which is too nigh your person Heaven preserve you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0071",
          "number": 71,
          "speechLineNumber": 9,
          "text": "I dare abide no longer.",
          "plainText": "I dare abide no longer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-4-2-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "macbeth-4-2-speech-035",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Whither should I fly?",
          "plainText": "Whither should I fly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "I have done no harm. But I remember now",
          "plainText": "I have done no harm But I remember now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0074",
          "number": 74,
          "speechLineNumber": 3,
          "text": "I am in this earthly world, where to do harm",
          "plainText": "I am in this earthly world where to do harm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0075",
          "number": 75,
          "speechLineNumber": 4,
          "text": "Is often laudable; to do good sometime",
          "plainText": "Is often laudable to do good sometime",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0076",
          "number": 76,
          "speechLineNumber": 5,
          "text": "Accounted dangerous folly: why then, alas,",
          "plainText": "Accounted dangerous folly why then alas",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0077",
          "number": 77,
          "speechLineNumber": 6,
          "text": "Do I put up that womanly defence,",
          "plainText": "Do I put up that womanly defence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0078",
          "number": 78,
          "speechLineNumber": 7,
          "text": "To say I have done no harm? What are these faces?",
          "plainText": "To say I have done no harm What are these faces",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-4-2-stage-005",
      "type": "stage",
      "text": "Enter Murderers."
    },
