          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-037",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "I hope, in no place so unsanctified",
          "plainText": "I hope in no place so unsanctified",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0081",
          "number": 81,
          "speechLineNumber": 2,
          "text": "Where such as thou mayst find him.",
          "plainText": "Where such as thou mayst find him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
