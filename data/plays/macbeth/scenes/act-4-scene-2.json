        "displayName": "First Murderer"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "He's a traitor.",
          "plainText": "He's a traitor",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
