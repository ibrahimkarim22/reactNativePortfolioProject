        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "What is a traitor?",
          "plainText": "What is a traitor",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Why, one that swears and lies.",
          "plainText": "Why one that swears and lies",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
