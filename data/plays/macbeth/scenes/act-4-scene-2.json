      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Was my father a traitor, mother?",
          "plainText": "Was my father a traitor mother",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
