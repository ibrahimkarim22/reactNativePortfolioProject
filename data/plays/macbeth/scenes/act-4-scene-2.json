      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "Thou liest, thou shag-ear'd villain!",
          "plainText": "Thou liest thou shagear'd villain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
