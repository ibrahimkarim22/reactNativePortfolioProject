      "id": "macbeth-4-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "son",
        "name": "SON",
        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "And be all traitors that do so?",
          "plainText": "And be all traitors that do so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
