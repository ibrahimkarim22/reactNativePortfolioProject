  "content": [
    {
      "id": "macbeth-4-2-stage-001",
      "type": "stage",
      "text": "Enter Lady Macduff her Son and Ross."
    },
    {
      "id": "macbeth-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "What had he done, to make him fly the land?",
          "plainText": "What had he done to make him fly the land",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "You must have patience, madam.",
          "plainText": "You must have patience madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "He had none:",
          "plainText": "He had none",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "His flight was madness: when our actions do not,",
          "plainText": "His flight was madness when our actions do not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Our fears do make us traitors.",
          "plainText": "Our fears do make us traitors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "You know not",
          "plainText": "You know not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Whether it was his wisdom or his fear.",
          "plainText": "Whether it was his wisdom or his fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Wisdom! to leave his wife, to leave his babes,",
          "plainText": "Wisdom to leave his wife to leave his babes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "His mansion, and his titles, in a place",
          "plainText": "His mansion and his titles in a place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "From whence himself does fly? He loves us not:",
          "plainText": "From whence himself does fly He loves us not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "He wants the natural touch; for the poor wren,",
          "plainText": "He wants the natural touch for the poor wren",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "The most diminutive of birds, will fight,",
          "plainText": "The most diminutive of birds will fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "Her young ones in her nest, against the owl.",
          "plainText": "Her young ones in her nest against the owl",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 7,
          "text": "All is the fear, and nothing is the love;",
          "plainText": "All is the fear and nothing is the love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 8,
          "text": "As little is the wisdom, where the flight",
          "plainText": "As little is the wisdom where the flight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 9,
          "text": "So runs against all reason.",
          "plainText": "So runs against all reason",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "My dearest coz,",
          "plainText": "My dearest coz",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "I pray you, school yourself: but, for your husband,",
          "plainText": "I pray you school yourself but for your husband",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "He is noble, wise, judicious, and best knows",
          "plainText": "He is noble wise judicious and best knows",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "The fits o' th' season. I dare not speak much further:",
          "plainText": "The fits o' th' season I dare not speak much further",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "But cruel are the times, when we are traitors,",
          "plainText": "But cruel are the times when we are traitors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "And do not know ourselves; when we hold rumour",
          "plainText": "And do not know ourselves when we hold rumour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 7,
          "text": "From what we fear, yet know not what we fear,",
          "plainText": "From what we fear yet know not what we fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 8,
          "text": "But float upon a wild and violent sea",
          "plainText": "But float upon a wild and violent sea",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 9,
          "text": "Each way and move—I take my leave of you:",
          "plainText": "Each way and moveI take my leave of you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 10,
          "text": "Shall not be long but I'll be here again.",
          "plainText": "Shall not be long but I'll be here again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 11,
          "text": "Things at the worst will cease, or else climb upward",
          "plainText": "Things at the worst will cease or else climb upward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 12,
          "text": "To what they were before.—My pretty cousin,",
          "plainText": "To what they were beforeMy pretty cousin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 13,
          "text": "Blessing upon you!",
          "plainText": "Blessing upon you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Father'd he is, and yet he's fatherless.",
          "plainText": "Father'd he is and yet he's fatherless",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "I am so much a fool, should I stay longer,",
          "plainText": "I am so much a fool should I stay longer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "It would be my disgrace and your discomfort:",
          "plainText": "It would be my disgrace and your discomfort",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "I take my leave at once.",
          "plainText": "I take my leave at once",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-4-2-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "macbeth-4-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Sirrah, your father's dead.",
          "plainText": "Sirrah your father's dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "And what will you do now? How will you live?",
          "plainText": "And what will you do now How will you live",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "son",
        "name": "SON",
        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "As birds do, mother.",
          "plainText": "As birds do mother",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "What, with worms and flies?",
          "plainText": "What with worms and flies",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "son",
        "name": "SON",
        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "With what I get, I mean; and so do they.",
          "plainText": "With what I get I mean and so do they",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Poor bird! thou'dst never fear the net nor lime,",
          "plainText": "Poor bird thou'dst never fear the net nor lime",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "The pit-fall nor the gin.",
          "plainText": "The pitfall nor the gin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "son",
        "name": "SON",
        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Why should I, mother? Poor birds they are not set for.",
          "plainText": "Why should I mother Poor birds they are not set for",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "My father is not dead, for all your saying.",
          "plainText": "My father is not dead for all your saying",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Yes, he is dead: how wilt thou do for a father?",
          "plainText": "Yes he is dead how wilt thou do for a father",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "son",
        "name": "SON",
        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Nay, how will you do for a husband?",
          "plainText": "Nay how will you do for a husband",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Why, I can buy me twenty at any market.",
          "plainText": "Why I can buy me twenty at any market",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "son",
        "name": "SON",
        "displayName": "Son"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Then you'll buy 'em to sell again.",
          "plainText": "Then you'll buy 'em to sell again",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-4-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "lady-macduff",
        "name": "LADY MACDUFF",
        "displayName": "Lady Macduff"
      },
      "lines": [
        {
          "id": "macbeth-4-2-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Thou speak'st with all thy wit;",
          "plainText": "Thou speak'st with all thy wit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-4-2-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "And yet, i' faith, with wit enough for thee.",
          "plainText": "And yet i' faith with wit enough for thee",
          "lineType": "verse",
