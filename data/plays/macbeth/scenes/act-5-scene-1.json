      "text": "SCENE I. Dunsinane. A Room in the Castle.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "b",
          "start": 0,
          "end": 41
        }
      ],
      "lines": [
        {
          "id": "macbeth/sceneV_20.1/h3@120692/line-1",
          "start": 0,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
