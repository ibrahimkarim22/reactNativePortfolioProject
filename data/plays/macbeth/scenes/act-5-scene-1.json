  "content": [
    {
      "id": "macbeth-5-1-stage-001",
      "type": "stage",
      "text": "Enter a Doctor of Physic and a Waiting-Gentlewoman."
    },
    {
      "id": "macbeth-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I have two nights watched with you, but can perceive no truth in your report. When was it she last walked?",
          "plainText": "I have two nights watched with you but can perceive no truth in your report When was it she last walked",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "gentlewoman",
        "name": "GENTLEWOMAN",
        "displayName": "Gentlewoman"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Since his Majesty went into the field, I have seen her rise from her bed, throw her nightgown upon her, unlock her closet, take forth paper, fold it, write upon't, read it, afterwards seal it, and again return to bed; yet all this while in a most fast sleep.",
          "plainText": "Since his Majesty went into the field I have seen her rise from her bed throw her nightgown upon her unlock her closet take forth paper fold it write upon't read it afterwards seal it and again return to bed yet all this while in a most fast sleep",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "A great perturbation in nature, to receive at once the benefit of sleep, and do the effects of watching. In this slumbery agitation, besides her walking and other actual performances, what, at any time, have you heard her say?",
          "plainText": "A great perturbation in nature to receive at once the benefit of sleep and do the effects of watching In this slumbery agitation besides her walking and other actual performances what at any time have you heard her say",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "gentlewoman",
        "name": "GENTLEWOMAN",
        "displayName": "Gentlewoman"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "That, sir, which I will not report after her.",
          "plainText": "That sir which I will not report after her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "You may to me; and 'tis most meet you should.",
          "plainText": "You may to me and 'tis most meet you should",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "gentlewoman",
        "name": "GENTLEWOMAN",
        "displayName": "Gentlewoman"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Neither to you nor anyone; having no witness to confirm my speech.",
          "plainText": "Neither to you nor anyone having no witness to confirm my speech",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-stage-002",
      "type": "stage",
      "text": "Enter Lady Macbeth with a taper."
    },
    {
      "id": "macbeth-5-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "How came she by that light?",
          "plainText": "How came she by that light",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "gentlewoman",
        "name": "GENTLEWOMAN",
        "displayName": "Gentlewoman"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Why, it stood by her: she has light by her continually; 'tis her command.",
          "plainText": "Why it stood by her she has light by her continually 'tis her command",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "You see, her eyes are open.",
          "plainText": "You see her eyes are open",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "gentlewoman",
        "name": "GENTLEWOMAN",
        "displayName": "Gentlewoman"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Ay, but their sense are shut.",
          "plainText": "Ay but their sense are shut",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "What is it she does now? Look how she rubs her hands.",
          "plainText": "What is it she does now Look how she rubs her hands",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "gentlewoman",
        "name": "GENTLEWOMAN",
        "displayName": "Gentlewoman"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "It is an accustomed action with her, to seem thus washing her hands. I have known her continue in this a quarter of an hour.",
          "plainText": "It is an accustomed action with her to seem thus washing her hands I have known her continue in this a quarter of an hour",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Yet here's a spot.",
          "plainText": "Yet here's a spot",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Hark, she speaks. I will set down what comes from her, to satisfy my remembrance the more strongly.",
          "plainText": "Hark she speaks I will set down what comes from her to satisfy my remembrance the more strongly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Out, damned spot! out, I say! One; two. Why, then 'tis time to do't. Hell is murky! Fie, my lord, fie! a soldier, and afeard? What need we fear who knows it, when none can call our power to account? Yet who would have thought the old man to have had so much blood in him?",
          "plainText": "Out damned spot out I say One two Why then 'tis time to do't Hell is murky Fie my lord fie a soldier and afeard What need we fear who knows it when none can call our power to account Yet who would have thought the old man to have had so much blood in him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Do you mark that?",
          "plainText": "Do you mark that",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "The Thane of Fife had a wife. Where is she now?—What, will these hands ne'er be clean? No more o' that, my lord, no more o' that: you mar all with this starting.",
          "plainText": "The Thane of Fife had a wife Where is she nowWhat will these hands ne'er be clean No more o' that my lord no more o' that you mar all with this starting",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Go to, go to. You have known what you should not.",
          "plainText": "Go to go to You have known what you should not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "gentlewoman",
        "name": "GENTLEWOMAN",
        "displayName": "Gentlewoman"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "She has spoke what she should not, I am sure of that: heaven knows what she has known.",
          "plainText": "She has spoke what she should not I am sure of that heaven knows what she has known",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Here's the smell of the blood still: all the perfumes of Arabia will not sweeten this little hand. Oh, oh, oh!",
          "plainText": "Here's the smell of the blood still all the perfumes of Arabia will not sweeten this little hand Oh oh oh",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "What a sigh is there! The heart is sorely charged.",
          "plainText": "What a sigh is there The heart is sorely charged",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "gentlewoman",
        "name": "GENTLEWOMAN",
        "displayName": "Gentlewoman"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I would not have such a heart in my bosom for the dignity of the whole body.",
          "plainText": "I would not have such a heart in my bosom for the dignity of the whole body",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Well, well, well.",
          "plainText": "Well well well",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "gentlewoman",
        "name": "GENTLEWOMAN",
        "displayName": "Gentlewoman"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Pray God it be, sir.",
          "plainText": "Pray God it be sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "This disease is beyond my practice: yet I have known those which have walked in their sleep, who have died holily in their beds.",
          "plainText": "This disease is beyond my practice yet I have known those which have walked in their sleep who have died holily in their beds",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Wash your hands, put on your nightgown; look not so pale. I tell you yet again, Banquo's buried; he cannot come out on's grave.",
          "plainText": "Wash your hands put on your nightgown look not so pale I tell you yet again Banquo's buried he cannot come out on's grave",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Even so?",
          "plainText": "Even so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "To bed, to bed. There's knocking at the gate. Come, come, come, come, give me your hand. What's done cannot be undone. To bed, to bed, to bed.",
          "plainText": "To bed to bed There's knocking at the gate Come come come come give me your hand What's done cannot be undone To bed to bed to bed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "macbeth-5-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Will she go now to bed?",
          "plainText": "Will she go now to bed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "gentlewoman",
        "name": "GENTLEWOMAN",
        "displayName": "Gentlewoman"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Directly.",
          "plainText": "Directly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-1-speech-031",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Foul whisp'rings are abroad. Unnatural deeds",
          "plainText": "Foul whisp'rings are abroad Unnatural deeds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-1-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Do breed unnatural troubles: infected minds",
          "plainText": "Do breed unnatural troubles infected minds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-1-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "To their deaf pillows will discharge their secrets.",
          "plainText": "To their deaf pillows will discharge their secrets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-1-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "More needs she the divine than the physician.—",
          "plainText": "More needs she the divine than the physician",
