    {
      "id": "macbeth/sceneV_20.2/p@125683",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter, with drum and colours Menteith, Caithness, Angus, Lennox and Soldiers.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 29,
          "end": 63,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@125683/line-1",
          "start": 0,
          "end": 77,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3689875,
        "end": 3690008,
        "line": 136088,
        "column": 1,
        "path": "chap20/p@125683",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@125820",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENTEITH.\nThe English power is near, led on by Malcolm,\nHis uncle Siward, and the good Macduff.\nRevenges burn in them; for their dear causes\nWould to the bleeding and the grim alarm\nExcite the mortified man.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@125820/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@125820/line-2",
          "start": 10,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@125820/line-3",
          "start": 56,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@125820/line-4",
          "start": 96,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@125820/line-5",
          "start": 141,
          "end": 181,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@125820/line-6",
          "start": 182,
          "end": 207,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3690012,
        "end": 3690269,
        "line": 136091,
        "column": 1,
        "path": "chap20/p@125820",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": "MENTEITH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@126081",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANGUS.\nNear Birnam wood\nShall we well meet them. That way are they coming.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@126081/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126081/line-2",
          "start": 7,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126081/line-3",
          "start": 24,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3690273,
        "end": 3690382,
        "line": 136100,
        "column": 1,
        "path": "chap20/p@126081",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": "ANGUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@126194",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAITHNESS.\nWho knows if Donalbain be with his brother?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@126194/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126194/line-2",
          "start": 11,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3690386,
        "end": 3690470,
        "line": 136106,
        "column": 1,
        "path": "chap20/p@126194",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": "CAITHNESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@126282",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LENNOX.\nFor certain, sir, he is not. I have a file\nOf all the gentry: there is Siward’s son\nAnd many unrough youths, that even now\nProtest their first of manhood.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@126282/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126282/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126282/line-3",
          "start": 51,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126282/line-4",
          "start": 92,
          "end": 130,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126282/line-5",
          "start": 131,
          "end": 162,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3690474,
        "end": 3690681,
        "line": 136111,
        "column": 1,
        "path": "chap20/p@126282",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": "LENNOX.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@126493",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENTEITH.\nWhat does the tyrant?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@126493/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126493/line-2",
          "start": 10,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3690685,
        "end": 3690746,
        "line": 136119,
        "column": 1,
        "path": "chap20/p@126493",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": "MENTEITH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@126558",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAITHNESS.\nGreat Dunsinane he strongly fortifies.\nSome say he’s mad; others, that lesser hate him,\nDo call it valiant fury: but, for certain,\nHe cannot buckle his distemper’d cause\nWithin the belt of rule.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@126558/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126558/line-2",
          "start": 11,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126558/line-3",
          "start": 50,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126558/line-4",
          "start": 99,
          "end": 141,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126558/line-5",
          "start": 142,
          "end": 180,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126558/line-6",
          "start": 181,
          "end": 205,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3690750,
        "end": 3691005,
        "line": 136124,
        "column": 1,
        "path": "chap20/p@126558",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": "CAITHNESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@126817",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANGUS.\nNow does he feel\nHis secret murders sticking on his hands;\nNow minutely revolts upbraid his faith-breach;\nThose he commands move only in command,\nNothing in love: now does he feel his title\nHang loose about him, like a giant’s robe\nUpon a dwarfish thief.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@126817/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126817/line-2",
          "start": 7,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126817/line-3",
          "start": 24,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126817/line-4",
          "start": 66,
          "end": 112,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126817/line-5",
          "start": 113,
          "end": 152,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126817/line-6",
          "start": 153,
          "end": 196,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126817/line-7",
          "start": 197,
          "end": 238,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@126817/line-8",
          "start": 239,
          "end": 261,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3691009,
        "end": 3691330,
        "line": 136133,
        "column": 1,
        "path": "chap20/p@126817",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": "ANGUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@127142",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENTEITH.\nWho, then, shall blame\nHis pester’d senses to recoil and start,\nWhen all that is within him does condemn\nItself for being there?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@127142/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127142/line-2",
          "start": 10,
          "end": 32,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127142/line-3",
          "start": 33,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127142/line-4",
          "start": 74,
          "end": 114,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127142/line-5",
          "start": 115,
          "end": 138,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3691334,
        "end": 3691517,
        "line": 136144,
        "column": 1,
        "path": "chap20/p@127142",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": "MENTEITH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@127329",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAITHNESS.\nWell, march we on,\nTo give obedience where ’tis truly ow’d:\nMeet we the med’cine of the sickly weal;\nAnd with him pour we, in our country’s purge,\nEach drop of us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@127329/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127329/line-2",
          "start": 11,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127329/line-3",
          "start": 30,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127329/line-4",
          "start": 71,
          "end": 111,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127329/line-5",
          "start": 112,
          "end": 157,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127329/line-6",
          "start": 158,
          "end": 174,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3691521,
        "end": 3691745,
        "line": 136152,
        "column": 1,
        "path": "chap20/p@127329",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": "CAITHNESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@127557",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LENNOX.\nOr so much as it needs\nTo dew the sovereign flower, and drown the weeds.\nMake we our march towards Birnam.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.2/p@127557/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127557/line-2",
          "start": 8,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127557/line-3",
          "start": 31,
          "end": 80,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.2/p@127557/line-4",
          "start": 81,
          "end": 114,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3691749,
        "end": 3691903,
        "line": 136161,
        "column": 1,
        "path": "chap20/p@127557",
        "anchor": "sceneV_20.2"
      },
      "speakerLabel": "LENNOX.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "macbeth/sceneV_20.2/p@127715",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt, marching.]",
      "separatorAfter": "\n\n",
