    {
      "id": "macbeth/sceneV_20.3/p@130632",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nCure her of that:\nCanst thou not minister to a mind diseas’d,\nPluck from the memory a rooted sorrow,\nRaze out the written troubles of the brain,\nAnd with some sweet oblivious antidote\nCleanse the stuff’d bosom of that perilous stuff\nWhich weighs upon the heart?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
