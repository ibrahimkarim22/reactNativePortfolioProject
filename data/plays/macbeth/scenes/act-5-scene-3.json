      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nI’ll fight till from my bones my flesh be hack’d.\nGive me my armour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.3/p@130103/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
