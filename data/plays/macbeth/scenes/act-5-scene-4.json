    {
      "id": "macbeth/sceneV_20.4/p@132441",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MALCOLM.\nCousins, I hope the days are near at hand\nThat chambers will be safe.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.4/p@132441/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.4/p@132441/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.4/p@132441/line-3",
          "start": 51,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3696633,
        "end": 3696746,
        "line": 136351,
        "column": 1,
        "path": "chap20/p@132441",
        "anchor": "sceneV_20.4"
      },
      "speakerLabel": "MALCOLM.",
      "attribution": {
        "status": "explicit",
