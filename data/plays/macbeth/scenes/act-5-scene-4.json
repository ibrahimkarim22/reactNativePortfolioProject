    {
      "id": "macbeth/sceneV_20.4/p@132215",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter, with drum and colours Malcolm, old Siward and his Son, Macduff, Menteith, Caithness, Angus, Lennox, Ross and Soldiers, marching.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 29,
          "end": 48,
          "className": "charname"
        },
