        "cueEnd": 8
      }
    },
    {
      "id": "macbeth/sceneV_20.4/p@132558",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MENTEITH.\nWe doubt it nothing.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.4/p@132558/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.4/p@132558/line-2",
          "start": 10,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
