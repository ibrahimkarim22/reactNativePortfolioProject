      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nLet me endure your wrath, if’t be not so.\nWithin this three mile may you see it coming;\nI say, a moving grove.",
      "separatorAfter": "\n\n",
      "spans": [],
