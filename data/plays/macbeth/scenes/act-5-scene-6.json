  "content": [
    {
      "id": "macbeth-5-6-stage-001",
      "type": "stage",
      "text": "Enter, with drum and colours, Malcolm, old Siward, Macduff and their Army, with boughs."
    },
    {
      "id": "macbeth-5-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "malcolm",
        "name": "MALCOLM",
        "displayName": "Malcolm"
      },
      "lines": [
        {
          "id": "macbeth-5-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Now near enough. Your leafy screens throw down,",
          "plainText": "Now near enough Your leafy screens throw down",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And show like those you are.—You, worthy uncle,",
          "plainText": "And show like those you areYou worthy uncle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-6-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Shall with my cousin, your right noble son,",
          "plainText": "Shall with my cousin your right noble son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-6-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Lead our first battle: worthy Macduff and we",
          "plainText": "Lead our first battle worthy Macduff and we",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-6-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Shall take upon's what else remains to do,",
          "plainText": "Shall take upon's what else remains to do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-6-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "According to our order.",
          "plainText": "According to our order",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-6-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Fare you well.—",
          "plainText": "Fare you well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-6-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Do we but find the tyrant's power tonight,",
          "plainText": "Do we but find the tyrant's power tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-6-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Let us be beaten, if we cannot fight.",
          "plainText": "Let us be beaten if we cannot fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-5-6-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Make all our trumpets speak; give them all breath,",
          "plainText": "Make all our trumpets speak give them all breath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-6-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "Those clamorous harbingers of blood and death.",
          "plainText": "Those clamorous harbingers of blood and death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
