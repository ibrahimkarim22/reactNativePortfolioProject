  "scene": {
    "id": "macbeth-5-7",
    "act": 5,
    "scene": 7,
    "label": "Act 5, Scene 7",
    "title": "SCENE VII. The same. Another part of the Plain.",
    "location": "The same. Another part of the Plain.",
    "orderInPlay": 27
  },
  "content": [
    {
      "id": "macbeth-5-7-stage-001",
      "type": "stage",
      "text": "Alarums. Enter Macbeth."
    },
    {
      "id": "macbeth-5-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "They have tied me to a stake. I cannot fly,",
          "plainText": "They have tied me to a stake I cannot fly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "But, bear-like I must fight the course.—What's he",
          "plainText": "But bearlike I must fight the courseWhat's he",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "That was not born of woman? Such a one",
          "plainText": "That was not born of woman Such a one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Am I to fear, or none.",
          "plainText": "Am I to fear or none",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-7-stage-002",
      "type": "stage",
      "text": "Enter young Siward."
    },
    {
      "id": "macbeth-5-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "young-siward",
        "name": "YOUNG SIWARD",
        "displayName": "Young Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "What is thy name?",
          "plainText": "What is thy name",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Thou'lt be afraid to hear it.",
          "plainText": "Thou'lt be afraid to hear it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-7-speech-004",
      "type": "speech",
      "speaker": {
        "id": "young-siward",
        "name": "YOUNG SIWARD",
        "displayName": "Young Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "No; though thou call'st thyself a hotter name",
          "plainText": "No though thou call'st thyself a hotter name",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Than any is in hell.",
          "plainText": "Than any is in hell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-7-speech-005",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "My name's Macbeth.",
          "plainText": "My name's Macbeth",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-7-speech-006",
      "type": "speech",
      "speaker": {
        "id": "young-siward",
        "name": "YOUNG SIWARD",
        "displayName": "Young Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "The devil himself could not pronounce a title",
          "plainText": "The devil himself could not pronounce a title",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "More hateful to mine ear.",
          "plainText": "More hateful to mine ear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-7-speech-007",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "No, nor more fearful.",
          "plainText": "No nor more fearful",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-7-speech-008",
      "type": "speech",
      "speaker": {
        "id": "young-siward",
        "name": "YOUNG SIWARD",
        "displayName": "Young Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Thou liest, abhorred tyrant. With my sword",
          "plainText": "Thou liest abhorred tyrant With my sword",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "I'll prove the lie thou speak'st.",
          "plainText": "I'll prove the lie thou speak'st",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-7-stage-003",
      "type": "stage",
      "text": "[They fight, and young Siward is slain.]"
    },
    {
      "id": "macbeth-5-7-speech-009",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Thou wast born of woman.",
          "plainText": "Thou wast born of woman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "But swords I smile at, weapons laugh to scorn,",
          "plainText": "But swords I smile at weapons laugh to scorn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "Brandish'd by man that's of a woman born.",
          "plainText": "Brandish'd by man that's of a woman born",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-7-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "macbeth-5-7-stage-005",
      "type": "stage",
      "text": "Alarums. Enter Macduff."
    },
    {
      "id": "macbeth-5-7-speech-010",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "That way the noise is.—Tyrant, show thy face!",
          "plainText": "That way the noise isTyrant show thy face",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "If thou be'st slain and with no stroke of mine,",
          "plainText": "If thou be'st slain and with no stroke of mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "My wife and children's ghosts will haunt me still.",
          "plainText": "My wife and children's ghosts will haunt me still",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "I cannot strike at wretched kerns, whose arms",
          "plainText": "I cannot strike at wretched kerns whose arms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0022",
          "number": 22,
          "speechLineNumber": 5,
          "text": "Are hired to bear their staves. Either thou, Macbeth,",
          "plainText": "Are hired to bear their staves Either thou Macbeth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0023",
          "number": 23,
          "speechLineNumber": 6,
          "text": "Or else my sword, with an unbatter'd edge,",
          "plainText": "Or else my sword with an unbatter'd edge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0024",
          "number": 24,
          "speechLineNumber": 7,
          "text": "I sheathe again undeeded. There thou shouldst be;",
          "plainText": "I sheathe again undeeded There thou shouldst be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0025",
          "number": 25,
          "speechLineNumber": 8,
          "text": "By this great clatter, one of greatest note",
          "plainText": "By this great clatter one of greatest note",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0026",
          "number": 26,
          "speechLineNumber": 9,
          "text": "Seems bruited. Let me find him, Fortune!",
          "plainText": "Seems bruited Let me find him Fortune",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0027",
          "number": 27,
          "speechLineNumber": 10,
          "text": "And more I beg not.",
          "plainText": "And more I beg not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-7-stage-006",
      "type": "stage",
      "text": "[Exit. Alarums.]"
    },
    {
      "id": "macbeth-5-7-stage-007",
      "type": "stage",
      "text": "Enter Malcolm and old Siward."
    },
    {
      "id": "macbeth-5-7-speech-011",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "This way, my lord;—the castle's gently render'd:",
          "plainText": "This way my lordthe castle's gently render'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "The tyrant's people on both sides do fight;",
          "plainText": "The tyrant's people on both sides do fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "The noble thanes do bravely in the war,",
          "plainText": "The noble thanes do bravely in the war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0031",
          "number": 31,
          "speechLineNumber": 4,
          "text": "The day almost itself professes yours,",
          "plainText": "The day almost itself professes yours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0032",
          "number": 32,
          "speechLineNumber": 5,
          "text": "And little is to do.",
          "plainText": "And little is to do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-7-speech-012",
      "type": "speech",
      "speaker": {
        "id": "malcolm",
        "name": "MALCOLM",
        "displayName": "Malcolm"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "We have met with foes",
          "plainText": "We have met with foes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-7-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "That strike beside us.",
          "plainText": "That strike beside us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-7-speech-013",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-7-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Enter, sir, the castle.",
          "plainText": "Enter sir the castle",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-7-stage-008",
      "type": "stage",
      "text": "[Exeunt. Alarums.]"
    }
  ]
}