    {
      "id": "macbeth/sceneV_20.8/p@141737",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nThou losest labour:\nAs easy mayst thou the intrenchant air\nWith thy keen sword impress, as make me bleed:\nLet fall thy blade on vulnerable crests;\nI bear a charmed life, which must not yield\nTo one of woman born.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
