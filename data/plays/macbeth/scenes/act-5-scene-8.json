      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACDUFF.\nDespair thy charm;\nAnd let the angel whom thou still hast serv’d\nTell thee, Macduff was from his mother’s womb\nUntimely ripp’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
