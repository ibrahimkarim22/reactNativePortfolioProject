    {
      "id": "macbeth/sceneV_20.8/p@142202",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nAccursed be that tongue that tells me so,\nFor it hath cow’d my better part of man!\nAnd be these juggling fiends no more believ’d,\nThat palter with us in a double sense;\nThat keep the word of promise to our ear,\nAnd break it to our hope!—I’ll not fight with thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "macbeth/sceneV_20.8/p@142202/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "macbeth/sceneV_20.8/p@142202/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
