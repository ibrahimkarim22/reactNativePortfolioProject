    {
      "id": "macbeth/sceneV_20.8/p@142776",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACBETH.\nI will not yield,\nTo kiss the ground before young Malcolm’s feet,\nAnd to be baited with the rabble’s curse.\nThough Birnam wood be come to Dunsinane,\nAnd thou oppos’d, being of no woman born,\nYet I will try the last. Before my body\nI throw my warlike shield: lay on, Macduff;\nAnd damn’d be him that first cries, “Hold, enough!”",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
