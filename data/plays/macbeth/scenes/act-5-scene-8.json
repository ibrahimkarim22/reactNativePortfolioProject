    {
      "id": "macbeth/sceneV_20.8/p@142532",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MACDUFF.\nThen yield thee, coward,\nAnd live to be the show and gaze o’ th’ time.\nWe’ll have thee, as our rarer monsters are,\nPainted upon a pole, and underwrit,\n“Here may you see the tyrant.”",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
