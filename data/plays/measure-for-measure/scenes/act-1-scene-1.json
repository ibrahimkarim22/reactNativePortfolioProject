    },
    {
      "id": "measure-for-measure/sceneI_21.1/p@6742",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nMy haste may not admit it;\nNor need you, on mine honour, have to do\nWith any scruple. Your scope is as mine own,\nSo to enforce or qualify the laws\nAs to your soul seems good. Give me your hand;\nI’ll privily away. I love the people,\nBut do not like to stage me to their eyes.\nThough it do well, I do not relish well\nTheir loud applause and Aves vehement;\nNor do I think the man of safe discretion\nThat does affect it. Once more, fare you well.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 345,
          "end": 349
        }
      ],
