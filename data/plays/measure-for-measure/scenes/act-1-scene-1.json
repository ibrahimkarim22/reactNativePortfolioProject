    "label": "Act 1, Scene 1",
    "title": "SCENE I. An apartment in the Duke's palace.",
    "location": "An apartment in the Duke's palace.",
    "orderInPlay": 1
  },
  "content": [
    {
      "id": "measure-for-measure-1-1-stage-001",
      "type": "stage",
      "text": "Enter Duke, Escalus, Lords and Attendants."
    },
    {
      "id": "measure-for-measure-1-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Escalus.",
          "plainText": "Escalus",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "escalus",
        "name": "ESCALUS",
        "displayName": "Escalus"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "My lord.",
          "plainText": "My lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Of government the properties to unfold",
          "plainText": "Of government the properties to unfold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Would seem in me t' affect speech and discourse,",
          "plainText": "Would seem in me t' affect speech and discourse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Since I am put to know that your own science",
          "plainText": "Since I am put to know that your own science",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "Exceeds, in that, the lists of all advice",
          "plainText": "Exceeds in that the lists of all advice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0007",
          "number": 7,
          "speechLineNumber": 5,
          "text": "My strength can give you. Then no more remains",
          "plainText": "My strength can give you Then no more remains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0008",
          "number": 8,
          "speechLineNumber": 6,
          "text": "But that, to your sufficiency, as your worth is able,",
          "plainText": "But that to your sufficiency as your worth is able",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0009",
          "number": 9,
          "speechLineNumber": 7,
          "text": "And let them work. The nature of our people,",
          "plainText": "And let them work The nature of our people",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0010",
          "number": 10,
          "speechLineNumber": 8,
          "text": "Our city's institutions, and the terms",
          "plainText": "Our city's institutions and the terms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0011",
          "number": 11,
          "speechLineNumber": 9,
          "text": "For common justice, you're as pregnant in",
          "plainText": "For common justice you're as pregnant in",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0012",
          "number": 12,
          "speechLineNumber": 10,
          "text": "As art and practice hath enriched any",
          "plainText": "As art and practice hath enriched any",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0013",
          "number": 13,
          "speechLineNumber": 11,
          "text": "That we remember. There is our commission,",
          "plainText": "That we remember There is our commission",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0014",
          "number": 14,
          "speechLineNumber": 12,
          "text": "From which we would not have you warp.—Call hither,",
          "plainText": "From which we would not have you warpCall hither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0015",
          "number": 15,
          "speechLineNumber": 13,
          "text": "I say, bid come before us, Angelo.",
          "plainText": "I say bid come before us Angelo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-stage-002",
      "type": "stage",
      "text": "[Exit an Attendant.]"
    },
    {
      "id": "measure-for-measure-1-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "escalus",
        "name": "ESCALUS",
        "displayName": "Escalus"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "If any in Vienna be of worth",
          "plainText": "If any in Vienna be of worth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "To undergo such ample grace and honour,",
          "plainText": "To undergo such ample grace and honour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "It is Lord Angelo.",
          "plainText": "It is Lord Angelo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-stage-003",
      "type": "stage",
      "text": "Enter Angelo."
    },
    {
      "id": "measure-for-measure-1-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Look where he comes.",
          "plainText": "Look where he comes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "angelo",
        "name": "ANGELO",
        "displayName": "Angelo"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Always obedient to your Grace's will,",
          "plainText": "Always obedient to your Grace's will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "I come to know your pleasure.",
          "plainText": "I come to know your pleasure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Angelo,",
          "plainText": "Angelo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "There is a kind of character in thy life",
          "plainText": "There is a kind of character in thy life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "That to th' observer doth thy history",
          "plainText": "That to th' observer doth thy history",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Fully unfold. Thyself and thy belongings",
          "plainText": "Fully unfold Thyself and thy belongings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "Are not thine own so proper as to waste",
          "plainText": "Are not thine own so proper as to waste",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0027",
          "number": 27,
          "speechLineNumber": 6,
          "text": "Thyself upon thy virtues, they on thee.",
          "plainText": "Thyself upon thy virtues they on thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0028",
          "number": 28,
          "speechLineNumber": 7,
          "text": "Heaven doth with us as we with torches do,",
          "plainText": "Heaven doth with us as we with torches do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0029",
          "number": 29,
          "speechLineNumber": 8,
          "text": "Not light them for themselves; for if our virtues",
          "plainText": "Not light them for themselves for if our virtues",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0030",
          "number": 30,
          "speechLineNumber": 9,
          "text": "Did not go forth of us, 'twere all alike",
          "plainText": "Did not go forth of us 'twere all alike",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0031",
          "number": 31,
          "speechLineNumber": 10,
          "text": "As if we had them not. Spirits are not finely touched",
          "plainText": "As if we had them not Spirits are not finely touched",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0032",
          "number": 32,
          "speechLineNumber": 11,
          "text": "But to fine issues; nor nature never lends",
          "plainText": "But to fine issues nor nature never lends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0033",
          "number": 33,
          "speechLineNumber": 12,
          "text": "The smallest scruple of her excellence",
          "plainText": "The smallest scruple of her excellence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0034",
          "number": 34,
          "speechLineNumber": 13,
          "text": "But, like a thrifty goddess, she determines",
          "plainText": "But like a thrifty goddess she determines",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0035",
          "number": 35,
          "speechLineNumber": 14,
          "text": "Herself the glory of a creditor,",
          "plainText": "Herself the glory of a creditor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0036",
          "number": 36,
          "speechLineNumber": 15,
          "text": "Both thanks and use. But I do bend my speech",
          "plainText": "Both thanks and use But I do bend my speech",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0037",
          "number": 37,
          "speechLineNumber": 16,
          "text": "To one that can my part in him advertise.",
          "plainText": "To one that can my part in him advertise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0038",
          "number": 38,
          "speechLineNumber": 17,
          "text": "Hold, therefore, Angelo.",
          "plainText": "Hold therefore Angelo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0039",
          "number": 39,
          "speechLineNumber": 18,
          "text": "In our remove be thou at full ourself.",
          "plainText": "In our remove be thou at full ourself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0040",
          "number": 40,
          "speechLineNumber": 19,
          "text": "Mortality and mercy in Vienna",
          "plainText": "Mortality and mercy in Vienna",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0041",
          "number": 41,
          "speechLineNumber": 20,
          "text": "Live in thy tongue and heart. Old Escalus,",
          "plainText": "Live in thy tongue and heart Old Escalus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0042",
          "number": 42,
          "speechLineNumber": 21,
          "text": "Though first in question, is thy secondary.",
          "plainText": "Though first in question is thy secondary",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0043",
          "number": 43,
          "speechLineNumber": 22,
          "text": "Take thy commission.",
          "plainText": "Take thy commission",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "angelo",
        "name": "ANGELO",
        "displayName": "Angelo"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Now, good my lord,",
          "plainText": "Now good my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "Let there be some more test made of my metal,",
          "plainText": "Let there be some more test made of my metal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "Before so noble and so great a figure",
          "plainText": "Before so noble and so great a figure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "Be stamped upon it.",
          "plainText": "Be stamped upon it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "No more evasion.",
          "plainText": "No more evasion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "We have with a leavened and prepared choice",
          "plainText": "We have with a leavened and prepared choice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "Proceeded to you; therefore take your honours.",
          "plainText": "Proceeded to you therefore take your honours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "Our haste from hence is of so quick condition",
          "plainText": "Our haste from hence is of so quick condition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0052",
          "number": 52,
          "speechLineNumber": 5,
          "text": "That it prefers itself, and leaves unquestioned",
          "plainText": "That it prefers itself and leaves unquestioned",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0053",
          "number": 53,
          "speechLineNumber": 6,
          "text": "Matters of needful value. We shall write to you,",
          "plainText": "Matters of needful value We shall write to you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0054",
          "number": 54,
          "speechLineNumber": 7,
          "text": "As time and our concernings shall importune,",
          "plainText": "As time and our concernings shall importune",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0055",
          "number": 55,
          "speechLineNumber": 8,
          "text": "How it goes with us; and do look to know",
          "plainText": "How it goes with us and do look to know",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0056",
          "number": 56,
          "speechLineNumber": 9,
          "text": "What doth befall you here. So, fare you well.",
          "plainText": "What doth befall you here So fare you well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0057",
          "number": 57,
          "speechLineNumber": 10,
          "text": "To th' hopeful execution do I leave you",
          "plainText": "To th' hopeful execution do I leave you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0058",
          "number": 58,
          "speechLineNumber": 11,
          "text": "Of your commissions.",
          "plainText": "Of your commissions",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "angelo",
        "name": "ANGELO",
        "displayName": "Angelo"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Yet give leave, my lord,",
          "plainText": "Yet give leave my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "That we may bring you something on the way.",
          "plainText": "That we may bring you something on the way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "My haste may not admit it;",
          "plainText": "My haste may not admit it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "Nor need you, on mine honour, have to do",
          "plainText": "Nor need you on mine honour have to do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "With any scruple. Your scope is as mine own,",
          "plainText": "With any scruple Your scope is as mine own",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0064",
          "number": 64,
          "speechLineNumber": 4,
          "text": "So to enforce or qualify the laws",
          "plainText": "So to enforce or qualify the laws",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0065",
          "number": 65,
          "speechLineNumber": 5,
          "text": "As to your soul seems good. Give me your hand;",
          "plainText": "As to your soul seems good Give me your hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0066",
          "number": 66,
          "speechLineNumber": 6,
          "text": "I'll privily away. I love the people,",
          "plainText": "I'll privily away I love the people",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0067",
          "number": 67,
          "speechLineNumber": 7,
          "text": "But do not like to stage me to their eyes.",
          "plainText": "But do not like to stage me to their eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0068",
          "number": 68,
          "speechLineNumber": 8,
          "text": "Though it do well, I do not relish well",
          "plainText": "Though it do well I do not relish well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0069",
          "number": 69,
          "speechLineNumber": 9,
          "text": "Their loud applause and Aves vehement;",
          "plainText": "Their loud applause and Aves vehement",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0070",
          "number": 70,
          "speechLineNumber": 10,
          "text": "Nor do I think the man of safe discretion",
          "plainText": "Nor do I think the man of safe discretion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0071",
          "number": 71,
          "speechLineNumber": 11,
          "text": "That does affect it. Once more, fare you well.",
          "plainText": "That does affect it Once more fare you well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "angelo",
        "name": "ANGELO",
        "displayName": "Angelo"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "The heavens give safety to your purposes!",
          "plainText": "The heavens give safety to your purposes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
