    {
      "id": "measure-for-measure-1-1-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "measure-for-measure-1-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "escalus",
        "name": "ESCALUS",
        "displayName": "Escalus"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "I shall desire you, sir, to give me leave",
          "plainText": "I shall desire you sir to give me leave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "To have free speech with you; and it concerns me",
          "plainText": "To have free speech with you and it concerns me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0077",
          "number": 77,
          "speechLineNumber": 3,
          "text": "To look into the bottom of my place.",
          "plainText": "To look into the bottom of my place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0078",
          "number": 78,
          "speechLineNumber": 4,
          "text": "A power I have, but of what strength and nature",
          "plainText": "A power I have but of what strength and nature",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0079",
          "number": 79,
          "speechLineNumber": 5,
          "text": "I am not yet instructed.",
          "plainText": "I am not yet instructed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "angelo",
        "name": "ANGELO",
        "displayName": "Angelo"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "'Tis so with me. Let us withdraw together,",
          "plainText": "'Tis so with me Let us withdraw together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-1-line-0081",
          "number": 81,
          "speechLineNumber": 2,
          "text": "And we may soon our satisfaction have",
