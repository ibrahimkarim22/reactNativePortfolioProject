      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANGELO.\nYet give leave, my lord,\nThat we may bring you something on the way.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneI_21.1/p@6627/line-1",
