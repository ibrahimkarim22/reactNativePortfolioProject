        "displayName": "Escalus"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Lead forth and bring you back in happiness.",
          "plainText": "Lead forth and bring you back in happiness",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-1-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "I thank you. Fare you well.",
          "plainText": "I thank you Fare you well",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
