    {
      "id": "measure-for-measure/sceneI_21.3/p@21666",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR THOMAS.\nIt rested in your Grace\nTo unloose this tied-up justice when you pleased;\nAnd it in you more dreadful would have seemed\nThan in Lord Angelo.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
