  "content": [
    {
      "id": "measure-for-measure-1-3-stage-001",
      "type": "stage",
      "text": "Enter Duke and Friar Thomas."
    },
    {
      "id": "measure-for-measure-1-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "No, holy father, throw away that thought;",
          "plainText": "No holy father throw away that thought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Believe not that the dribbling dart of love",
          "plainText": "Believe not that the dribbling dart of love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Can pierce a complete bosom. Why I desire thee",
          "plainText": "Can pierce a complete bosom Why I desire thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "To give me secret harbour hath a purpose",
          "plainText": "To give me secret harbour hath a purpose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "More grave and wrinkled than the aims and ends",
          "plainText": "More grave and wrinkled than the aims and ends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Of burning youth.",
          "plainText": "Of burning youth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "friar-thomas",
        "name": "FRIAR THOMAS",
        "displayName": "Friar Thomas"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "May your Grace speak of it?",
          "plainText": "May your Grace speak of it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "My holy sir, none better knows than you",
          "plainText": "My holy sir none better knows than you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "How I have ever loved the life removed,",
          "plainText": "How I have ever loved the life removed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "And held in idle price to haunt assemblies",
          "plainText": "And held in idle price to haunt assemblies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Where youth, and cost, a witless bravery keeps.",
          "plainText": "Where youth and cost a witless bravery keeps",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "I have delivered to Lord Angelo,",
          "plainText": "I have delivered to Lord Angelo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "A man of stricture and firm abstinence,",
          "plainText": "A man of stricture and firm abstinence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0014",
          "number": 14,
          "speechLineNumber": 7,
          "text": "My absolute power and place here in Vienna,",
          "plainText": "My absolute power and place here in Vienna",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0015",
          "number": 15,
          "speechLineNumber": 8,
          "text": "And he supposes me travelled to Poland;",
          "plainText": "And he supposes me travelled to Poland",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0016",
          "number": 16,
          "speechLineNumber": 9,
          "text": "For so I have strewed it in the common ear,",
          "plainText": "For so I have strewed it in the common ear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0017",
          "number": 17,
          "speechLineNumber": 10,
          "text": "And so it is received. Now, pious sir,",
          "plainText": "And so it is received Now pious sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0018",
          "number": 18,
          "speechLineNumber": 11,
          "text": "You will demand of me why I do this?",
          "plainText": "You will demand of me why I do this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "friar-thomas",
        "name": "FRIAR THOMAS",
        "displayName": "Friar Thomas"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Gladly, my lord.",
          "plainText": "Gladly my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "We have strict statutes and most biting laws,",
          "plainText": "We have strict statutes and most biting laws",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "The needful bits and curbs to headstrong weeds,",
          "plainText": "The needful bits and curbs to headstrong weeds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "Which for this fourteen years we have let slip,",
          "plainText": "Which for this fourteen years we have let slip",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Even like an o'ergrown lion in a cave",
          "plainText": "Even like an o'ergrown lion in a cave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "That goes not out to prey. Now, as fond fathers,",
          "plainText": "That goes not out to prey Now as fond fathers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0025",
          "number": 25,
          "speechLineNumber": 6,
          "text": "Having bound up the threat'ning twigs of birch,",
          "plainText": "Having bound up the threat'ning twigs of birch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0026",
          "number": 26,
          "speechLineNumber": 7,
          "text": "Only to stick it in their children's sight",
          "plainText": "Only to stick it in their children's sight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0027",
          "number": 27,
          "speechLineNumber": 8,
          "text": "For terror, not to use, in time the rod",
          "plainText": "For terror not to use in time the rod",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0028",
          "number": 28,
          "speechLineNumber": 9,
          "text": "Becomes more mocked than feared: so our decrees,",
          "plainText": "Becomes more mocked than feared so our decrees",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0029",
          "number": 29,
          "speechLineNumber": 10,
          "text": "Dead to infliction, to themselves are dead,",
          "plainText": "Dead to infliction to themselves are dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0030",
          "number": 30,
          "speechLineNumber": 11,
          "text": "And liberty plucks justice by the nose,",
          "plainText": "And liberty plucks justice by the nose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0031",
          "number": 31,
          "speechLineNumber": 12,
          "text": "The baby beats the nurse, and quite athwart",
          "plainText": "The baby beats the nurse and quite athwart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0032",
          "number": 32,
          "speechLineNumber": 13,
          "text": "Goes all decorum.",
          "plainText": "Goes all decorum",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "friar-thomas",
        "name": "FRIAR THOMAS",
        "displayName": "Friar Thomas"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "It rested in your Grace",
          "plainText": "It rested in your Grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "To unloose this tied-up justice when you pleased;",
          "plainText": "To unloose this tiedup justice when you pleased",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "And it in you more dreadful would have seemed",
          "plainText": "And it in you more dreadful would have seemed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "Than in Lord Angelo.",
          "plainText": "Than in Lord Angelo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-3-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "I do fear, too dreadful.",
          "plainText": "I do fear too dreadful",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Sith 'twas my fault to give the people scope,",
          "plainText": "Sith 'twas my fault to give the people scope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "'Twould be my tyranny to strike and gall them",
          "plainText": "'Twould be my tyranny to strike and gall them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "For what I bid them do; for we bid this be done",
          "plainText": "For what I bid them do for we bid this be done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0041",
          "number": 41,
          "speechLineNumber": 5,
          "text": "When evil deeds have their permissive pass",
          "plainText": "When evil deeds have their permissive pass",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0042",
          "number": 42,
          "speechLineNumber": 6,
          "text": "And not the punishment. Therefore, indeed, my father,",
          "plainText": "And not the punishment Therefore indeed my father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0043",
          "number": 43,
          "speechLineNumber": 7,
          "text": "I have on Angelo imposed the office;",
          "plainText": "I have on Angelo imposed the office",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0044",
          "number": 44,
          "speechLineNumber": 8,
          "text": "Who may in th' ambush of my name strike home,",
          "plainText": "Who may in th' ambush of my name strike home",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0045",
          "number": 45,
          "speechLineNumber": 9,
          "text": "And yet my nature never in the fight",
          "plainText": "And yet my nature never in the fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0046",
          "number": 46,
          "speechLineNumber": 10,
          "text": "To do in slander. And to behold his sway,",
          "plainText": "To do in slander And to behold his sway",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0047",
          "number": 47,
          "speechLineNumber": 11,
          "text": "I will, as 'twere a brother of your order,",
          "plainText": "I will as 'twere a brother of your order",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0048",
          "number": 48,
          "speechLineNumber": 12,
          "text": "Visit both prince and people. Therefore, I prithee,",
          "plainText": "Visit both prince and people Therefore I prithee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0049",
          "number": 49,
          "speechLineNumber": 13,
          "text": "Supply me with the habit, and instruct me",
          "plainText": "Supply me with the habit and instruct me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0050",
          "number": 50,
          "speechLineNumber": 14,
          "text": "How I may formally in person bear",
          "plainText": "How I may formally in person bear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0051",
          "number": 51,
          "speechLineNumber": 15,
          "text": "Like a true friar. Moe reasons for this action",
          "plainText": "Like a true friar Moe reasons for this action",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0052",
          "number": 52,
          "speechLineNumber": 16,
          "text": "At our more leisure shall I render you;",
          "plainText": "At our more leisure shall I render you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0053",
          "number": 53,
          "speechLineNumber": 17,
          "text": "Only, this one: Lord Angelo is precise;",
          "plainText": "Only this one Lord Angelo is precise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0054",
          "number": 54,
          "speechLineNumber": 18,
          "text": "Stands at a guard with envy; scarce confesses",
          "plainText": "Stands at a guard with envy scarce confesses",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0055",
          "number": 55,
          "speechLineNumber": 19,
          "text": "That his blood flows or that his appetite",
          "plainText": "That his blood flows or that his appetite",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-1-3-line-0056",
          "number": 56,
          "speechLineNumber": 20,
