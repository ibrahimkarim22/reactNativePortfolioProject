    {
      "id": "measure-for-measure/sceneII_21.3/p@60155",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nRepent you, fair one, of the sin you carry?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@60155/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@60155/line-2",
          "start": 6,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3770547,
        "end": 3770626,
        "line": 139381,
        "column": 1,
        "path": "chap21/p@60155",
        "anchor": "sceneII_21.3"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "measure-for-measure/sceneII_21.3/p@60238",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nI do; and bear the shame most patiently.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@60238/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@60238/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3770630,
        "end": 3770708,
        "line": 139386,
        "column": 1,
        "path": "chap21/p@60238",
        "anchor": "sceneII_21.3"
      },
      "speakerLabel": "JULIET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "measure-for-measure/sceneII_21.3/p@60320",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nI’ll teach you how you shall arraign your conscience,\nAnd try your penitence, if it be sound\nOr hollowly put on.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@60320/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
