          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59992/line-4",
          "start": 85,
          "end": 112,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3770384,
        "end": 3770543,
        "line": 139374,
        "column": 1,
        "path": "chap21/p@59992",
        "anchor": "sceneII_21.3"
      },
      "speakerLabel": "PROVOST.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
