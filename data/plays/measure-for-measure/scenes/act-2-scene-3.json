    {
      "id": "measure-for-measure/sceneII_21.3/p@59649",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Look, here comes one, a gentlewoman of mine,\nWho, falling in the flaws of her own youth,\nHath blistered her report. She is with child,\nAnd he that got it, sentenced: a young man\nMore fit to do another such offence\nThan die for this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@59649/line-1",
          "start": 0,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59649/line-2",
          "start": 45,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59649/line-3",
          "start": 89,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59649/line-4",
          "start": 135,
          "end": 177,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59649/line-5",
          "start": 178,
          "end": 213,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59649/line-6",
