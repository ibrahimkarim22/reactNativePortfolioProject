      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nYes, as I love the woman that wronged him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@60616/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
