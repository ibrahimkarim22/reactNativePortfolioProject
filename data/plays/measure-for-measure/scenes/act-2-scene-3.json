      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROVOST.\nI am the Provost. What’s your will, good friar?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@59096/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
