      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nI do confess it, and repent it, father.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@60944/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
