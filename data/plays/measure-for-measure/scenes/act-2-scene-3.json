          "start": 6,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@60320/line-3",
          "start": 60,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@60320/line-4",
          "start": 99,
          "end": 118,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3770712,
        "end": 3770870,
        "line": 139391,
        "column": 1,
        "path": "chap21/p@60320",
        "anchor": "sceneII_21.3"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "measure-for-measure/sceneII_21.3/p@60482",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nI’ll gladly learn.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@60482/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@60482/line-2",
          "start": 8,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
