    {
      "id": "measure-for-measure/sceneII_21.3/p@59992",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROVOST.\nAs I do think, tomorrow.\n[To Juliet.] I have provided for you; stay a while\nAnd you shall be conducted.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 35,
          "end": 44
        }
      ],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@59992/line-1",
