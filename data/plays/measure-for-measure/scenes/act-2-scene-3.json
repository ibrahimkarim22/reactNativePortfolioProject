        "end": 3771088,
        "line": 139408,
        "column": 1,
        "path": "chap21/p@60616",
        "anchor": "sceneII_21.3"
      },
      "speakerLabel": "JULIET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
