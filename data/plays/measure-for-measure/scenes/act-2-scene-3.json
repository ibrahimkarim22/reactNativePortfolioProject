    {
      "id": "measure-for-measure/sceneII_21.3/p@59186",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nBound by my charity and my blessed order,\nI come to visit the afflicted spirits\nHere in the prison. Do me the common right\nTo let me see them, and to make me know\nThe nature of their crimes, that I may minister\nTo them accordingly.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@59186/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59186/line-2",
          "start": 6,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59186/line-3",
          "start": 48,
          "end": 85,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59186/line-4",
          "start": 86,
          "end": 128,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59186/line-5",
          "start": 129,
          "end": 168,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneII_21.3/p@59186/line-6",
          "start": 169,
          "end": 216,
          "sourceLineNumber": null
        },
        {
