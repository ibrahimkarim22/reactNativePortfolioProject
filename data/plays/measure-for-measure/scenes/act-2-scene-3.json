    {
      "id": "measure-for-measure/sceneII_21.3/p@61025",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\n’Tis meet so, daughter; but lest you do repent\nAs that the sin hath brought you to this shame,\nWhich sorrow is always toward ourselves, not heaven,\nShowing we would not spare heaven as we love it,\nBut as we stand in fear—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneII_21.3/p@61025/line-1",
          "start": 0,
