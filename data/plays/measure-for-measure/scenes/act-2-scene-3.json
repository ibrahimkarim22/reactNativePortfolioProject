      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nI do repent me as it is an evil,\nAnd take the shame with joy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
