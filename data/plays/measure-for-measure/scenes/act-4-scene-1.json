    {
      "id": "measure-for-measure/sceneIV_21.1/p@107155",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nVery well met, and welcome.\nWhat is the news from this good deputy?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107155/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107155/line-2",
          "start": 6,
          "end": 33,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107155/line-3",
          "start": 34,
          "end": 73,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3817547,
        "end": 3817655,
        "line": 141125,
        "column": 1,
        "path": "chap21/p@107155",
        "anchor": "sceneIV_21.1"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "measure-for-measure/sceneIV_21.1/p@107267",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ISABELLA.\nHe hath a garden circummured with brick,\nWhose western side is with a vineyard backed;\nAnd to that vineyard is a planched gate\nThat makes his opening with this bigger key.\nThis other doth command a little door\nWhich from the vineyard to the garden leads;\nThere have I made my promise, upon the\nHeavy middle of the night to call on him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107267/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107267/line-2",
          "start": 10,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107267/line-3",
          "start": 51,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107267/line-4",
          "start": 97,
          "end": 136,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107267/line-5",
          "start": 137,
          "end": 181,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107267/line-6",
          "start": 182,
          "end": 219,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107267/line-7",
          "start": 220,
          "end": 264,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107267/line-8",
          "start": 265,
          "end": 303,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107267/line-9",
          "start": 304,
          "end": 345,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3817659,
        "end": 3818069,
        "line": 141131,
        "column": 1,
        "path": "chap21/p@107267",
        "anchor": "sceneIV_21.1"
      },
      "speakerLabel": "ISABELLA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "measure-for-measure/sceneIV_21.1/p@107681",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nBut shall you on your knowledge find this way?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107681/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107681/line-2",
          "start": 6,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3818073,
        "end": 3818155,
        "line": 141143,
        "column": 1,
        "path": "chap21/p@107681",
        "anchor": "sceneIV_21.1"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "measure-for-measure/sceneIV_21.1/p@107767",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ISABELLA.\nI have ta’en a due and wary note upon’t;\nWith whispering and most guilty diligence,\nIn action all of precept, he did show me\nThe way twice o’er.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.1/p@107767/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
