    {
      "id": "measure-for-measure/sceneIV_21.1/p@105951",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARIANA.\nBreak off thy song, and haste thee quick away;\nHere comes a man of comfort, whose advice\nHath often stilled my brawling discontent.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
