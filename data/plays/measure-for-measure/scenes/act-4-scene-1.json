    {
      "id": "measure-for-measure/sceneIV_21.1/p@105499",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "                SONG\n  Take, O take those lips away,\n      That so sweetly were forsworn,\n  And those eyes, the break of day,\n      Lights that do mislead the morn.\n  But my kisses bring again,\n                Bring again;\n  Seals of love, but sealed in vain,\n                Sealed in vain.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 21,
          "end": 291
        }
      ],
