    {
      "id": "measure-for-measure/sceneIV_21.1/p@106208",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "I cry you mercy, sir, and well could wish\nYou had not found me here so musical.\nLet me excuse me, and believe me so,\nMy mirth it much displeased, but pleased my woe.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106208/line-1",
          "start": 0,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106208/line-2",
          "start": 42,
          "end": 79,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106208/line-3",
          "start": 80,
          "end": 116,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106208/line-4",
          "start": 117,
          "end": 165,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3816600,
        "end": 3816805,
        "line": 141087,
        "column": 1,
        "path": "chap21/p@106208",
        "anchor": "sceneIV_21.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "measure-for-measure/sceneIV_21.1/p@106417",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\n’Tis good; though music oft hath such a charm\nTo make bad good and good provoke to harm.\nI pray you tell me, hath anybody inquired for me here today? Much upon this time have I promised here to meet.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106417/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106417/line-2",
          "start": 6,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106417/line-3",
          "start": 52,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106417/line-4",
          "start": 95,
          "end": 205,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3816809,
        "end": 3817055,
        "line": 141094,
        "column": 1,
        "path": "chap21/p@106417",
        "anchor": "sceneIV_21.1"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "measure-for-measure/sceneIV_21.1/p@106667",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARIANA.\nYou have not been inquired after. I have sat here all day.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106667/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106667/line-2",
          "start": 9,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3817059,
        "end": 3817156,
        "line": 141102,
        "column": 1,
        "path": "chap21/p@106667",
        "anchor": "sceneIV_21.1"
      },
      "speakerLabel": "MARIANA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "measure-for-measure/sceneIV_21.1/p@106768",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Isabella.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106768/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3817160,
        "end": 3817234,
        "line": 141107,
        "column": 1,
        "path": "chap21/p@106768",
        "anchor": "sceneIV_21.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "measure-for-measure/sceneIV_21.1/p@106846",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nI do constantly believe you. The time is come even now. I shall crave your forbearance a little. Maybe I will call upon you anon for some advantage to yourself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106846/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@106846/line-2",
          "start": 6,
          "end": 166,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3817238,
        "end": 3817436,
        "line": 141111,
        "column": 1,
        "path": "chap21/p@106846",
        "anchor": "sceneIV_21.1"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "measure-for-measure/sceneIV_21.1/p@107048",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARIANA.\nI am always bound to you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
