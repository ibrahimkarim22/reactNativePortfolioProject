          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@105951/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@105951/line-3",
          "start": 56,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.1/p@105951/line-4",
