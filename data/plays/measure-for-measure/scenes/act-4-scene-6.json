      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ISABELLA.\nO, peace, the friar is come.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.6/p@139483/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.6/p@139483/line-2",
          "start": 10,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3849875,
        "end": 3849943,
        "line": 142393,
        "column": 1,
        "path": "chap21/p@139483",
        "anchor": "sceneIV_21.6"
      },
      "speakerLabel": "ISABELLA.",
      "attribution": {
