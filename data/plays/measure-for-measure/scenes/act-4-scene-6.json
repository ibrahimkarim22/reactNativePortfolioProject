      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARIANA.\nBe ruled by him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "measure-for-measure/sceneIV_21.6/p@139061/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "measure-for-measure/sceneIV_21.6/p@139061/line-2",
          "start": 9,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3849453,
        "end": 3849508,
        "line": 142371,
        "column": 1,
        "path": "chap21/p@139061",
        "anchor": "sceneIV_21.6"
      },
      "speakerLabel": "MARIANA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "measure-for-measure/sceneIV_21.6/p@139120",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ISABELLA.\nBesides, he tells me that, if peradventure\nHe speak against me on the adverse side,\nI should not think it strange, for ’tis a physic\nThat’s bitter to sweet end.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
