    {
      "id": "measure-for-measure/sceneIV_21.6/p@138847",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ISABELLA.\nTo speak so indirectly I am loath;\nI would say the truth, but to accuse him so\nThat is your part; yet I am advised to do it,\nHe says, to veil full purpose.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
