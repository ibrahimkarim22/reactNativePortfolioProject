        "end": 4382395,
        "line": 162121,
        "column": 1,
        "path": "chap25/p@27128",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
