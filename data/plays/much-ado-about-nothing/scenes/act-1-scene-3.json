      },
      "speakerLabel": "CONRADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@27128",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nLet us to the great supper: their cheer is the greater that I am subdued. Would the cook were of my mind! Shall we go to prove what’s to be done?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@27128/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@27128/line-2",
          "start": 10,
          "end": 155,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
