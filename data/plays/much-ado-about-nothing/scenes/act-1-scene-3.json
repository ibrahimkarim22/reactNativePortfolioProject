      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Don John and Conrade.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 19,
