    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@26376",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nA very forward March-chick! How came you to this?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26376/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26376/line-2",
          "start": 10,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4381457,
        "end": 4381546,
        "line": 162097,
        "column": 1,
        "path": "chap25/p@26376",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@26469",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nBeing entertained for a perfumer, as I was smoking a musty room, comes me the Prince and Claudio, hand in hand, in sad conference: I whipt me behind the arras, and there heard it agreed upon that the Prince should woo Hero for himself, and having obtained her, give her to Count Claudio.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26469/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26469/line-2",
          "start": 10,
          "end": 297,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4381550,
        "end": 4381880,
        "line": 162102,
        "column": 1,
        "path": "chap25/p@26469",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@26803",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nCome, come; let us thither: this may prove food to my displeasure. That young start-up hath all the glory of my overthrow: if I can cross him any way, I bless myself every way. You are both sure, and will assist me?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26803/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26803/line-2",
          "start": 10,
          "end": 225,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4381884,
        "end": 4382141,
        "line": 162110,
        "column": 1,
        "path": "chap25/p@26803",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@27064",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CONRADE.\nTo the death, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
