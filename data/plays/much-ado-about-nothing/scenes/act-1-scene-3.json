        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23299/line-1",
          "start": 0,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4378380,
        "end": 4378496,
        "line": 161983,
        "column": 1,
        "path": "chap25/p@23299",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@23419",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CONRADE.\nWhat the good-year, my lord! why are you thus out of measure sad?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23419/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23419/line-2",
          "start": 9,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4378500,
        "end": 4378604,
        "line": 161987,
        "column": 1,
        "path": "chap25/p@23419",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "CONRADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@23527",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nThere is no measure in the occasion that breeds; therefore the sadness is without limit.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23527/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23527/line-2",
          "start": 10,
          "end": 98,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4378608,
        "end": 4378737,
        "line": 161992,
        "column": 1,
        "path": "chap25/p@23527",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@23660",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CONRADE.\nYou should hear reason.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23660/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23660/line-2",
          "start": 9,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4378741,
        "end": 4378803,
        "line": 161998,
        "column": 1,
        "path": "chap25/p@23660",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "CONRADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@23726",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nAnd when I have heard it, what blessings brings it?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23726/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23726/line-2",
          "start": 10,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4378807,
        "end": 4378898,
        "line": 162003,
        "column": 1,
        "path": "chap25/p@23726",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@23821",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CONRADE.\nIf not a present remedy, at least a patient sufferance.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23821/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23821/line-2",
          "start": 9,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4378902,
        "end": 4378996,
        "line": 162008,
        "column": 1,
        "path": "chap25/p@23821",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "CONRADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@23919",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nI wonder that thou (being as thou say’st thou art, born under Saturn) goest about to apply a moral medicine to a mortifying mischief. I cannot hide what I am: I must be sad when I have cause, and smile at no man’s jests; eat when I have stomach, and wait for no man’s leisure; sleep when I am drowsy, and tend on no man’s business; laugh when I am merry, and claw no man in his humour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23919/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@23919/line-2",
          "start": 10,
          "end": 395,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4379000,
        "end": 4379430,
        "line": 162013,
        "column": 1,
        "path": "chap25/p@23919",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@24353",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CONRADE.\nYea; but you must not make the full show of this till you may do it without controlment. You have of late stood out against your brother, and he hath ta’en you newly into his grace; where it is impossible you should take true root but by the fair weather that you make yourself: it is needful that you frame the season for your own harvest.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@24353/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@24353/line-2",
          "start": 9,
          "end": 349,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4379434,
        "end": 4379817,
        "line": 162023,
        "column": 1,
        "path": "chap25/p@24353",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "CONRADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@24740",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nI had rather be a canker in a hedge than a rose in his grace; and it better fits my blood to be disdained of all than to fashion a carriage to rob love from any: in this, though I cannot be said to be a flattering honest man, it must not be denied but I am a plain-dealing villain. I am trusted with a muzzle and enfranchised with a clog; therefore I have decreed not to sing in my cage. If I had my mouth, I would bite; if I had my liberty, I would do my liking: in the meantime, let me be that I am, and seek not to alter me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@24740/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@24740/line-2",
          "start": 10,
          "end": 537,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4379821,
        "end": 4380394,
        "line": 162032,
        "column": 1,
        "path": "chap25/p@24740",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@25317",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CONRADE.\nCan you make no use of your discontent?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25317/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25317/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4380398,
        "end": 4380475,
        "line": 162043,
        "column": 1,
        "path": "chap25/p@25317",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "CONRADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@25398",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nI make all use of it, for I use it only. Who comes here?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25398/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25398/line-2",
          "start": 10,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4380479,
        "end": 4380574,
        "line": 162047,
        "column": 1,
        "path": "chap25/p@25398",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@25497",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Borachio.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25497/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4380578,
        "end": 4380652,
        "line": 162051,
        "column": 1,
        "path": "chap25/p@25497",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@25575",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "What news, Borachio?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25575/line-1",
          "start": 0,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4380656,
        "end": 4380701,
        "line": 162055,
        "column": 1,
        "path": "chap25/p@25575",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@25624",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nI came yonder from a great supper: the Prince your brother is royally entertained by Leonato; and I can give you intelligence of an intended marriage.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25624/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25624/line-2",
          "start": 10,
          "end": 160,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4380705,
        "end": 4380897,
        "line": 162059,
        "column": 1,
        "path": "chap25/p@25624",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@25820",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nWill it serve for any model to build mischief on? What is he for a fool that betroths himself to unquietness?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25820/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25820/line-2",
          "start": 10,
          "end": 119,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4380901,
        "end": 4381051,
        "line": 162066,
        "column": 1,
        "path": "chap25/p@25820",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@25974",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nMarry, it is your brother’s right hand.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25974/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@25974/line-2",
          "start": 10,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4381055,
        "end": 4381134,
        "line": 162072,
        "column": 1,
        "path": "chap25/p@25974",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@26057",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nWho? the most exquisite Claudio?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26057/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26057/line-2",
          "start": 10,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4381138,
        "end": 4381210,
        "line": 162077,
        "column": 1,
        "path": "chap25/p@26057",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@26133",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nEven he.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26133/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26133/line-2",
          "start": 10,
          "end": 18,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4381214,
        "end": 4381262,
        "line": 162082,
        "column": 1,
        "path": "chap25/p@26133",
        "anchor": "sceneI_25.3"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneI_25.3/p@26185",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nA proper squire! And who, and who? which way looks he?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26185/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneI_25.3/p@26185/line-2",
          "start": 10,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4381266,
        "end": 4381360,
