      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nMarry, on Hero, the daughter and heir of Leonato.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
