      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Don John and Borachio.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 19,
          "end": 27,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@49877/line-1",
          "start": 0,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4404958,
        "end": 4405075,
        "line": 163032,
        "column": 1,
        "path": "chap25/p@49877",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": null,
