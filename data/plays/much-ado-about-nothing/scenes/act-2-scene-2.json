        "status": "not-applicable"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@49998",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nIt is so; the Count Claudio shall marry the daughter of Leonato.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@49998/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@49998/line-2",
          "start": 10,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4405079,
        "end": 4405183,
        "line": 163036,
        "column": 1,
        "path": "chap25/p@49998",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@50106",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nYea, my lord; but I can cross it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50106/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50106/line-2",
          "start": 10,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4405187,
        "end": 4405260,
        "line": 163041,
        "column": 1,
        "path": "chap25/p@50106",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@50183",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nAny bar, any cross, any impediment will be medicinable to me: I am sick in displeasure to him, and whatsoever comes athwart his affection ranges evenly with mine. How canst thou cross this marriage?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50183/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50183/line-2",
          "start": 10,
          "end": 208,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4405264,
        "end": 4405504,
        "line": 163046,
        "column": 1,
        "path": "chap25/p@50183",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@50427",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nNot honestly, my lord; but so covertly that no dishonesty shall appear in me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50427/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50427/line-2",
          "start": 10,
          "end": 87,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4405508,
        "end": 4405625,
        "line": 163053,
        "column": 1,
        "path": "chap25/p@50427",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@50548",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nShow me briefly how.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50548/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50548/line-2",
          "start": 10,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4405629,
        "end": 4405689,
        "line": 163058,
        "column": 1,
        "path": "chap25/p@50548",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@50612",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nI think I told your lordship, a year since, how much I am in the favour of Margaret, the waiting gentlewoman to Hero.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50612/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50612/line-2",
          "start": 10,
          "end": 127,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4405693,
        "end": 4405851,
        "line": 163063,
        "column": 1,
        "path": "chap25/p@50612",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@50774",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nI remember.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50774/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50774/line-2",
          "start": 10,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4405855,
        "end": 4405906,
        "line": 163069,
        "column": 1,
        "path": "chap25/p@50774",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@50829",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nI can, at any unseasonable instant of the night, appoint her to look out at her lady’s chamber window.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50829/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50829/line-2",
          "start": 10,
          "end": 112,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4405910,
        "end": 4406053,
        "line": 163074,
        "column": 1,
        "path": "chap25/p@50829",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@50976",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nWhat life is in that, to be the death of this marriage?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50976/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@50976/line-2",
          "start": 10,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4406057,
        "end": 4406151,
        "line": 163080,
        "column": 1,
        "path": "chap25/p@50976",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@51074",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nThe poison of that lies in you to temper. Go you to the Prince your brother; spare not to tell him, that he hath wronged his honour in marrying the renowned Claudio,—whose estimation do you mightily hold up,—to a contaminated stale, such a one as Hero.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@51074/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@51074/line-2",
          "start": 10,
          "end": 262,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4406155,
        "end": 4406450,
        "line": 163084,
        "column": 1,
        "path": "chap25/p@51074",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@51373",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nWhat proof shall I make of that?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@51373/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@51373/line-2",
          "start": 10,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4406454,
        "end": 4406526,
        "line": 163092,
        "column": 1,
        "path": "chap25/p@51373",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@51449",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nProof enough to misuse the Prince, to vex Claudio, to undo Hero, and kill Leonato. Look you for any other issue?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@51449/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@51449/line-2",
          "start": 10,
          "end": 122,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4406530,
        "end": 4406683,
        "line": 163097,
        "column": 1,
        "path": "chap25/p@51449",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@51606",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nOnly to despite them, I will endeavour anything.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@51606/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@51606/line-2",
          "start": 10,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4406687,
        "end": 4406775,
        "line": 163103,
        "column": 1,
        "path": "chap25/p@51606",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@51698",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nGo then; find me a meet hour to draw Don Pedro and the Count Claudio alone: tell them that you know that Hero loves me; intend a kind of zeal both to the Prince and Claudio, as—in love of your brother’s honour, who hath made this match, and his friend’s reputation, who is thus like to be cozened with the semblance of a maid,—that you have discovered thus. They will scarcely believe this without trial: offer them instances, which shall bear no less likelihood than to see me at her chamber window, hear me call Margaret Hero, hear Margaret term me Claudio; and bring them to see this the very night before the intended wedding: for in the meantime I will so fashion the matter that Hero shall be absent; and there shall appear such seeming truth of Hero’s disloyalty, that jealousy shall be called assurance, and all the preparation overthrown.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@51698/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@51698/line-2",
          "start": 10,
          "end": 857,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4406779,
        "end": 4407677,
        "line": 163108,
        "column": 1,
        "path": "chap25/p@51698",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@52600",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nGrow this to what adverse issue it can, I will put it in practice. Be cunning in the working this, and thy fee is a thousand ducats.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@52600/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@52600/line-2",
          "start": 10,
          "end": 142,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4407681,
        "end": 4407854,
        "line": 163124,
        "column": 1,
        "path": "chap25/p@52600",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@52777",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BORACHIO.\nBe you constant in the accusation, and my cunning shall not shame me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@52777/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@52777/line-2",
          "start": 10,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4407858,
        "end": 4407967,
        "line": 163130,
        "column": 1,
        "path": "chap25/p@52777",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "BORACHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@52890",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON JOHN.\nI will presently go learn their day of marriage.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@52890/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneII_25.2/p@52890/line-2",
          "start": 10,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4407971,
        "end": 4408059,
        "line": 163135,
        "column": 1,
        "path": "chap25/p@52890",
        "anchor": "sceneII_25.2"
      },
      "speakerLabel": "DON JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneII_25.2/p@52982",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 8
