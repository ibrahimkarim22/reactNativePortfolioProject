        "start": 4452941,
        "end": 4453018,
        "line": 164920,
        "column": 1,
        "path": "chap25/p@97860",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@97941",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nA maid, and stuffed! there’s goodly catching of cold.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@97941/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
