          "start": 10,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4452149,
        "end": 4452245,
        "line": 164879,
        "column": 1,
        "path": "chap25/p@97068",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@97168",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\n’Tis almost five o’clock, cousin; ’tis time you were ready. By my troth, I am exceeding ill. Heigh-ho!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@97168/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@97168/line-2",
          "start": 10,
          "end": 112,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4452249,
        "end": 4452392,
        "line": 164884,
        "column": 1,
        "path": "chap25/p@97168",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@97315",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nFor a hawk, a horse, or a husband?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
