      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nBenedictus! why benedictus? you have some moral in this benedictus.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 10,
          "end": 21
        },
        {
          "tag": "i",
          "start": 26,
          "end": 37
        },
        {
          "tag": "i",
          "start": 66,
          "end": 76
        }
      ],
