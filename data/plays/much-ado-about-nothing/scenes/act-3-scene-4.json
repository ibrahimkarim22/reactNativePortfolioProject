      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HERO.\nThese gloves the Count sent me; they are an excellent perfume.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@97758/line-1",
