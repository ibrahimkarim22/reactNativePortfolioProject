        "start": 4451991,
        "end": 4452145,
        "line": 164873,
        "column": 1,
        "path": "chap25/p@96910",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@97068",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nO illegitimate construction! I scorn that with my heels.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@97068/line-1",
          "start": 0,
