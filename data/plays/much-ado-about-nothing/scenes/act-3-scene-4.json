      "sourceRef": {
        "start": 4452839,
        "end": 4452937,
        "line": 164915,
        "column": 1,
        "path": "chap25/p@97758",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "HERO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
