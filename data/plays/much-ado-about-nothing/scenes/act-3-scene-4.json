          "start": 10,
          "end": 63,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4453022,
        "end": 4453115,
        "line": 164925,
        "column": 1,
        "path": "chap25/p@97941",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@98038",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nO, God help me! God help me! how long have you professed apprehension?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@98038/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@98038/line-2",
          "start": 10,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4453119,
        "end": 4453229,
        "line": 164930,
        "column": 1,
        "path": "chap25/p@98038",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@98152",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nEver since you left it. Doth not my wit become me rarely!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@98152/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@98152/line-2",
          "start": 10,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4453233,
        "end": 4453330,
        "line": 164935,
        "column": 1,
        "path": "chap25/p@98152",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@98253",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nIt is not seen enough, you should wear it in your cap. By my troth, I am sick.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@98253/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@98253/line-2",
          "start": 10,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4453334,
        "end": 4453452,
        "line": 164940,
        "column": 1,
        "path": "chap25/p@98253",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@98375",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nGet you some of this distilled Carduus benedictus, and lay it to your heart: it is the only thing for a qualm.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 41,
          "end": 59
        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@98375/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@98375/line-2",
          "start": 10,
          "end": 120,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4453456,
        "end": 4453614,
        "line": 164945,
        "column": 1,
        "path": "chap25/p@98375",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
