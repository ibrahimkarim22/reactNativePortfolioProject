      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nNothing I; but God send everyone their heart’s desire!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@97660/line-1",
          "start": 0,
