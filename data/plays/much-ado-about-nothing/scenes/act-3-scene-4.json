      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nFor the letter that begins them all, H.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@97393/line-1",
