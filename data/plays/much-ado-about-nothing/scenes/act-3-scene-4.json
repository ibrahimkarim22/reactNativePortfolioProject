        "start": 4451855,
        "end": 4451987,
        "line": 164867,
        "column": 1,
        "path": "chap25/p@96774",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@96910",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nYe, light o’ love with your heels! then, if your husband have stables enough, you’ll see he shall lack no barnes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@96910/line-1",
          "start": 0,
          "end": 9,
