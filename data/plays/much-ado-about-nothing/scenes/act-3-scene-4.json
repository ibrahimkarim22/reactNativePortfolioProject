  "content": [
    {
      "id": "much-ado-about-nothing-3-4-stage-001",
      "type": "stage",
      "text": "Enter Hero, Margaret and Ursula."
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Good Ursula, wake my cousin Beatrice, and desire her to rise.",
          "plainText": "Good Ursula wake my cousin Beatrice and desire her to rise",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "ursula",
        "name": "URSULA",
        "displayName": "Ursula"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "I will, lady.",
          "plainText": "I will lady",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "And bid her come hither.",
          "plainText": "And bid her come hither",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "ursula",
        "name": "URSULA",
        "displayName": "Ursula"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Well.",
          "plainText": "Well",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Troth, I think your other rebato were better.",
          "plainText": "Troth I think your other rebato were better",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "No, pray thee, good Meg, I'll wear this.",
          "plainText": "No pray thee good Meg I'll wear this",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "By my troth's not so good; and I warrant your cousin will say so.",
          "plainText": "By my troth's not so good and I warrant your cousin will say so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "My cousin's a fool, and thou art another: I'll wear none but this.",
          "plainText": "My cousin's a fool and thou art another I'll wear none but this",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "I like the new tire within excellently, if the hair were a thought browner; and your gown's a most rare fashion, i' faith. I saw the Duchess of Milan's gown that they praise so.",
          "plainText": "I like the new tire within excellently if the hair were a thought browner and your gown's a most rare fashion i' faith I saw the Duchess of Milan's gown that they praise so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "O! that exceeds, they say.",
          "plainText": "O that exceeds they say",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "By my troth 's but a night-gown in respect of yours: cloth o' gold, and cuts, and laced with silver, set with pearls, down sleeves, side sleeves, and skirts round, underborne with a bluish tinsel; but for a fine, quaint, graceful, and excellent fashion, yours is worth ten on't.",
          "plainText": "By my troth 's but a nightgown in respect of yours cloth o' gold and cuts and laced with silver set with pearls down sleeves side sleeves and skirts round underborne with a bluish tinsel but for a fine quaint graceful and excellent fashion yours is worth ten on't",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "God give me joy to wear it! for my heart is exceeding heavy.",
          "plainText": "God give me joy to wear it for my heart is exceeding heavy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "'Twill be heavier soon by the weight of a man.",
          "plainText": "'Twill be heavier soon by the weight of a man",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Fie upon thee! art not ashamed?",
          "plainText": "Fie upon thee art not ashamed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Of what, lady? of speaking honourably? Is not marriage honourable in a beggar? Is not your lord honourable without marriage? I think you would have me say, saving your reverence, 'a husband:' an bad thinking do not wrest true speaking, I'll offend nobody. Is there any harm in 'the heavier for a husband'? None, I think, and it be the right husband and the right wife; otherwise 'tis light, and not heavy: ask my Lady Beatrice else; here she comes.",
          "plainText": "Of what lady of speaking honourably Is not marriage honourable in a beggar Is not your lord honourable without marriage I think you would have me say saving your reverence 'a husband' an bad thinking do not wrest true speaking I'll offend nobody Is there any harm in 'the heavier for a husband' None I think and it be the right husband and the right wife otherwise 'tis light and not heavy ask my Lady Beatrice else here she comes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-stage-003",
      "type": "stage",
      "text": "Enter Beatrice."
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Good morrow, coz.",
          "plainText": "Good morrow coz",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Good morrow, sweet Hero.",
          "plainText": "Good morrow sweet Hero",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Why, how now? do you speak in the sick tune?",
          "plainText": "Why how now do you speak in the sick tune",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I am out of all other tune, methinks.",
          "plainText": "I am out of all other tune methinks",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Clap's into 'Light o' love'; that goes without a burden: do you sing it, and I'll dance it.",
          "plainText": "Clap's into 'Light o' love' that goes without a burden do you sing it and I'll dance it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Ye, light o' love with your heels! then, if your husband have stables enough, you'll see he shall lack no barnes.",
          "plainText": "Ye light o' love with your heels then if your husband have stables enough you'll see he shall lack no barnes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "O illegitimate construction! I scorn that with my heels.",
          "plainText": "O illegitimate construction I scorn that with my heels",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "'Tis almost five o'clock, cousin; 'tis time you were ready. By my troth, I am exceeding ill. Heigh-ho!",
          "plainText": "'Tis almost five o'clock cousin 'tis time you were ready By my troth I am exceeding ill Heighho",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "For a hawk, a horse, or a husband?",
          "plainText": "For a hawk a horse or a husband",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-025",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "For the letter that begins them all, H.",
          "plainText": "For the letter that begins them all H",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-026",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Well, and you be not turned Turk, there's no more sailing by the star.",
          "plainText": "Well and you be not turned Turk there's no more sailing by the star",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-027",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "What means the fool, trow?",
          "plainText": "What means the fool trow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-028",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Nothing I; but God send everyone their heart's desire!",
          "plainText": "Nothing I but God send everyone their heart's desire",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-029",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "These gloves the Count sent me; they are an excellent perfume.",
          "plainText": "These gloves the Count sent me they are an excellent perfume",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-030",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "I am stuffed, cousin, I cannot smell.",
          "plainText": "I am stuffed cousin I cannot smell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-031",
      "type": "speech",
      "speaker": {
        "id": "margaret",
        "name": "MARGARET",
        "displayName": "Margaret"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "A maid, and stuffed! there's goodly catching of cold.",
          "plainText": "A maid and stuffed there's goodly catching of cold",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-4-speech-032",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "O, God help me! God help me! how long have you professed apprehension?",
