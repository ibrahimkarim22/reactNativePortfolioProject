      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HERO.\nThere thou prick’st her with a thistle.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@98537/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@98537/line-2",
          "start": 6,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4453618,
        "end": 4453693,
        "line": 164951,
        "column": 1,
        "path": "chap25/p@98537",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "HERO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
