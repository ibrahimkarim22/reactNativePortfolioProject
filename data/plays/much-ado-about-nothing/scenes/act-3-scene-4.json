      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nWell, and you be not turned Turk, there’s no more sailing by the star.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@97476/line-1",
          "start": 0,
          "end": 9,
