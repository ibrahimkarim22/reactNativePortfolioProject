    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@96774",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nClap’s into ‘Light o’ love’; that goes without a burden: do you sing it, and I’ll dance it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@96774/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@96774/line-2",
