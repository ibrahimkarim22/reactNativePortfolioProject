    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@94649",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nTroth, I think your other rebato were better.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@94649/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@94649/line-2",
          "start": 10,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4449730,
        "end": 4449815,
        "line": 164777,
        "column": 1,
        "path": "chap25/p@94649",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@94738",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HERO.\nNo, pray thee, good Meg, I’ll wear this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@94738/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@94738/line-2",
          "start": 6,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4449819,
        "end": 4449895,
        "line": 164782,
        "column": 1,
        "path": "chap25/p@94738",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "HERO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@94818",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nBy my troth’s not so good; and I warrant your cousin will say so.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@94818/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@94818/line-2",
          "start": 10,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4449899,
        "end": 4450004,
        "line": 164787,
        "column": 1,
        "path": "chap25/p@94818",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@94927",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HERO.\nMy cousin’s a fool, and thou art another: I’ll wear none but this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@94927/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@94927/line-2",
          "start": 6,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4450008,
        "end": 4450110,
        "line": 164792,
        "column": 1,
        "path": "chap25/p@94927",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "HERO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@95033",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nI like the new tire within excellently, if the hair were a thought browner; and your gown’s a most rare fashion, i’ faith. I saw the Duchess of Milan’s gown that they praise so.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95033/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95033/line-2",
          "start": 10,
          "end": 187,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4450114,
        "end": 4450333,
        "line": 164797,
        "column": 1,
        "path": "chap25/p@95033",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@95256",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HERO.\nO! that exceeds, they say.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95256/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95256/line-2",
          "start": 6,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4450337,
        "end": 4450399,
        "line": 164804,
        "column": 1,
        "path": "chap25/p@95256",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "HERO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@95322",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nBy my troth ’s but a night-gown in respect of yours: cloth o’ gold, and cuts, and laced with silver, set with pearls, down sleeves, side sleeves, and skirts round, underborne with a bluish tinsel; but for a fine, quaint, graceful, and excellent fashion, yours is worth ten on’t.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95322/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95322/line-2",
          "start": 10,
          "end": 288,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4450403,
        "end": 4450724,
        "line": 164809,
        "column": 1,
        "path": "chap25/p@95322",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@95647",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HERO.\nGod give me joy to wear it! for my heart is exceeding heavy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95647/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95647/line-2",
          "start": 6,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4450728,
        "end": 4450824,
        "line": 164817,
        "column": 1,
        "path": "chap25/p@95647",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "HERO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@95747",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\n’Twill be heavier soon by the weight of a man.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95747/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95747/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4450828,
        "end": 4450914,
        "line": 164822,
        "column": 1,
        "path": "chap25/p@95747",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@95837",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HERO.\nFie upon thee! art not ashamed?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95837/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95837/line-2",
          "start": 6,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4450918,
        "end": 4450985,
        "line": 164827,
        "column": 1,
        "path": "chap25/p@95837",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "HERO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@95908",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nOf what, lady? of speaking honourably? Is not marriage honourable in a beggar? Is not your lord honourable without marriage? I think you would have me say, saving your reverence, ‘a husband:’ an bad thinking do not wrest true speaking, I’ll offend nobody. Is there any harm in ‘the heavier for a husband’? None, I think, and it be the right husband and the right wife; otherwise ’tis light, and not heavy: ask my Lady Beatrice else; here she comes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95908/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@95908/line-2",
          "start": 10,
          "end": 458,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4450989,
        "end": 4451483,
        "line": 164832,
        "column": 1,
        "path": "chap25/p@95908",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.4/p@96406",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Beatrice.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@96406/line-1",
