      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HERO.\nWhy, how now? do you speak in the sick tune?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.4/p@96609/line-1",
