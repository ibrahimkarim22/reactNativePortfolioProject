        "start": 4452741,
        "end": 4452835,
        "line": 164910,
        "column": 1,
        "path": "chap25/p@97660",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
