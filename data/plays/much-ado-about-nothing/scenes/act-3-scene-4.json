      "sourceRef": {
        "start": 4452557,
        "end": 4452667,
        "line": 164900,
        "column": 1,
        "path": "chap25/p@97476",
        "anchor": "sceneIII_25.4"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
