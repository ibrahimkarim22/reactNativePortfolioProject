    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@100067",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Leonato and Dogberry and Verges.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 18,
          "end": 26,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 31,
          "end": 37,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100067/line-1",
          "start": 0,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4455148,
        "end": 4455305,
        "line": 165007,
        "column": 1,
        "path": "chap25/p@100067",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@100228",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEONATO.\nWhat would you with me, honest neighbour?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100228/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100228/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4455309,
        "end": 4455389,
        "line": 165011,
        "column": 1,
        "path": "chap25/p@100228",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "LEONATO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@100312",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOGBERRY.\nMarry, sir, I would have some confidence with you, that decerns you nearly.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100312/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100312/line-2",
          "start": 10,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4455393,
        "end": 4455508,
        "line": 165016,
        "column": 1,
        "path": "chap25/p@100312",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "DOGBERRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@100431",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEONATO.\nBrief, I pray you; for you see it is a busy time with me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100431/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100431/line-2",
          "start": 9,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4455512,
        "end": 4455608,
        "line": 165021,
        "column": 1,
        "path": "chap25/p@100431",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "LEONATO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@100531",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOGBERRY.\nMarry, this it is, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100531/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100531/line-2",
          "start": 10,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4455612,
        "end": 4455675,
        "line": 165026,
        "column": 1,
        "path": "chap25/p@100531",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "DOGBERRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@100598",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VERGES.\nYes, in truth it is, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100598/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100598/line-2",
          "start": 8,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4455679,
        "end": 4455742,
        "line": 165031,
        "column": 1,
        "path": "chap25/p@100598",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "VERGES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@100665",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEONATO.\nWhat is it, my good friends?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100665/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100665/line-2",
          "start": 9,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4455746,
        "end": 4455813,
        "line": 165036,
        "column": 1,
        "path": "chap25/p@100665",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "LEONATO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@100736",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOGBERRY.\nGoodman Verges, sir, speaks a little off the matter: an old man, sir, and his wits are not so blunt as, God help, I would desire they were; but, in faith, honest as the skin between his brows.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100736/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100736/line-2",
          "start": 10,
          "end": 202,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4455817,
        "end": 4456051,
        "line": 165041,
        "column": 1,
        "path": "chap25/p@100736",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "DOGBERRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@100974",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VERGES.\nYes, I thank God, I am as honest as any man living, that is an old man and no honester than I.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100974/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@100974/line-2",
          "start": 8,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4456055,
        "end": 4456188,
        "line": 165048,
        "column": 1,
        "path": "chap25/p@100974",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "VERGES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@101111",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOGBERRY.\nComparisons are odorous: palabras, neighbour Verges.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101111/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101111/line-2",
          "start": 10,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4456192,
        "end": 4456284,
        "line": 165054,
        "column": 1,
        "path": "chap25/p@101111",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "DOGBERRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@101207",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEONATO.\nNeighbours, you are tedious.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101207/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101207/line-2",
          "start": 9,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4456288,
        "end": 4456355,
        "line": 165059,
        "column": 1,
        "path": "chap25/p@101207",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "LEONATO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@101278",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOGBERRY.\nIt pleases your worship to say so, but we are the poor Duke’s officers; but truly, for mine own part, if I were as tedious as a king, I could find in my heart to bestow it all of your worship.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101278/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101278/line-2",
          "start": 10,
          "end": 202,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4456359,
        "end": 4456593,
        "line": 165064,
        "column": 1,
        "path": "chap25/p@101278",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "DOGBERRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@101516",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEONATO.\nAll thy tediousness on me! ah?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101516/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101516/line-2",
          "start": 9,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4456597,
        "end": 4456666,
        "line": 165071,
        "column": 1,
        "path": "chap25/p@101516",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "LEONATO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@101589",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOGBERRY.\nYea, and ’twere a thousand pound more than ’tis; for I hear as good exclamation on your worship, as of any man in the city, and though I be but a poor man, I am glad to hear it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101589/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101589/line-2",
          "start": 10,
          "end": 187,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4456670,
        "end": 4456889,
        "line": 165076,
        "column": 1,
        "path": "chap25/p@101589",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "DOGBERRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@101812",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VERGES.\nAnd so am I.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101812/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101812/line-2",
          "start": 8,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4456893,
        "end": 4456943,
        "line": 165083,
        "column": 1,
        "path": "chap25/p@101812",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "VERGES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@101866",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEONATO.\nI would fain know what you have to say.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101866/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101866/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4456947,
        "end": 4457025,
        "line": 165088,
        "column": 1,
        "path": "chap25/p@101866",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "LEONATO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@101948",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VERGES.\nMarry, sir, our watch tonight, excepting your worship’s presence, ha’ ta’en a couple of as arrant knaves as any in Messina.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101948/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@101948/line-2",
          "start": 8,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4457029,
        "end": 4457191,
        "line": 165093,
        "column": 1,
        "path": "chap25/p@101948",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "VERGES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@102114",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOGBERRY.\nA good old man, sir; he will be talking; as they say, ‘when the age is in, the wit is out.’ God help us! it is a world to see! Well said, i’ faith, neighbour Verges: well, God’s a good man; and two men ride of a horse, one must ride behind. An honest soul, i’ faith, sir; by my troth he is, as ever broke bread; but God is to be worshipped: all men are not alike; alas! good neighbour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@102114/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIII_25.5/p@102114/line-2",
          "start": 10,
          "end": 395,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4457195,
        "end": 4457625,
        "line": 165099,
        "column": 1,
        "path": "chap25/p@102114",
        "anchor": "sceneIII_25.5"
      },
      "speakerLabel": "DOGBERRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIII_25.5/p@102548",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LEONATO.\nIndeed, neighbour, he comes too short of you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
