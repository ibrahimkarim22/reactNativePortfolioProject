      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST WATCH.\nAnd that Count Claudio did mean, upon his words, to disgrace Hero before the whole assembly, and not marry her.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIV_25.2/p@127176/line-1",
