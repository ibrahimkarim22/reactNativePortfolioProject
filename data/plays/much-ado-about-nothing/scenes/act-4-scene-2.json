      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOGBERRY.\nO villain! thou wilt be condemned into everlasting redemption for this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
