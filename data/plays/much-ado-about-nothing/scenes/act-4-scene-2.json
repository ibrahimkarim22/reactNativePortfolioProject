      },
      "speakerLabel": "SECOND WATCH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "much-ado-about-nothing/sceneIV_25.2/p@127562",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEXTON.\nAnd this is more, masters, than you can deny. Prince John is this morning secretly stolen away: Hero was in this manner accused, in this manner refused, and, upon the grief of this, suddenly died. Master Constable, let these men be bound, and brought to Leonato’s: I will go before and show him their examination.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIV_25.2/p@127562/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneIV_25.2/p@127562/line-2",
          "start": 8,
          "end": 321,
          "sourceLineNumber": null
