      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Dogberry, Verges, and Sexton, in gowns; and the Watch, with Conrade and Borachio.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 22,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 28,
          "end": 34,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 66,
          "end": 73,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 78,
          "end": 86,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIV_25.2/p@123917/line-1",
          "start": 0,
          "end": 87,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4478998,
        "end": 4479234,
        "line": 166003,
        "column": 1,
