      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOGBERRY.\nPray thee, fellow, peace: I do not like thy look, I promise thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
