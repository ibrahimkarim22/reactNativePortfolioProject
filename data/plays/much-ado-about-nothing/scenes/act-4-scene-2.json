      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOGBERRY.\nWrite down Prince John a villain. Why, this is flat perjury, to call a Prince’s brother villain.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneIV_25.2/p@126438/line-1",
