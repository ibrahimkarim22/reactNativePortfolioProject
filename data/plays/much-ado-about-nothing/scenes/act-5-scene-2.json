        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@149754/line-1",
          "start": 0,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4504835,
        "end": 4504961,
        "line": 167042,
        "column": 1,
        "path": "chap25/p@149754",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": null,
