      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Benedick and Margaret, meeting.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        },
        {
