        "status": "not-applicable"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@149884",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nPray thee, sweet Mistress Margaret, deserve well at my hands by helping me to the speech of Beatrice.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@149884/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@149884/line-2",
          "start": 10,
          "end": 111,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4504965,
        "end": 4505107,
        "line": 167046,
        "column": 1,
        "path": "chap25/p@149884",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@150030",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nWill you then write me a sonnet in praise of my beauty?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150030/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150030/line-2",
          "start": 10,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4505111,
        "end": 4505206,
        "line": 167052,
        "column": 1,
        "path": "chap25/p@150030",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@150129",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nIn so high a style, Margaret, that no man living shall come over it; for, in most comely truth, thou deservest it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150129/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150129/line-2",
          "start": 10,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4505210,
        "end": 4505365,
        "line": 167057,
        "column": 1,
        "path": "chap25/p@150129",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@150288",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nTo have no man come over me! why, shall I always keep below stairs?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150288/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150288/line-2",
          "start": 10,
          "end": 77,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4505369,
        "end": 4505476,
        "line": 167063,
        "column": 1,
        "path": "chap25/p@150288",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@150399",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nThy wit is as quick as the greyhound’s mouth; it catches.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150399/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150399/line-2",
          "start": 10,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4505480,
        "end": 4505577,
        "line": 167068,
        "column": 1,
        "path": "chap25/p@150399",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@150500",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nAnd yours as blunt as the fencer’s foils, which hit, but hurt not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150500/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150500/line-2",
          "start": 10,
          "end": 76,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4505581,
        "end": 4505687,
        "line": 167073,
        "column": 1,
        "path": "chap25/p@150500",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@150610",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nA most manly wit, Margaret; it will not hurt a woman: and so, I pray thee, call Beatrice. I give thee the bucklers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150610/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150610/line-2",
          "start": 10,
          "end": 125,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4505691,
        "end": 4505847,
        "line": 167078,
        "column": 1,
        "path": "chap25/p@150610",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@150770",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nGive us the swords, we have bucklers of our own.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150770/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150770/line-2",
          "start": 10,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4505851,
        "end": 4505939,
        "line": 167084,
        "column": 1,
        "path": "chap25/p@150770",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@150862",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nIf you use them, Margaret, you must put in the pikes with a vice; and they are dangerous weapons for maids.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150862/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@150862/line-2",
          "start": 10,
          "end": 117,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4505943,
        "end": 4506091,
        "line": 167089,
        "column": 1,
        "path": "chap25/p@150862",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@151014",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARGARET.\nWell, I will call Beatrice to you, who I think hath legs.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@151014/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@151014/line-2",
          "start": 10,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4506095,
        "end": 4506192,
        "line": 167095,
        "column": 1,
        "path": "chap25/p@151014",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@151115",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nAnd therefore will come.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@151115/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@151115/line-2",
          "start": 10,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4506196,
        "end": 4506260,
        "line": 167100,
        "column": 1,
        "path": "chap25/p@151115",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@151183",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit Margaret.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 15
        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@151183/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4506264,
        "end": 4506342,
        "line": 167105,
        "column": 1,
        "path": "chap25/p@151183",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@151265",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "    The god of love,\n    That sits above,\n And knows me, and knows me,\n   How pitiful I deserve,—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@151265/line-1",
          "start": 0,
          "end": 20,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@151265/line-2",
          "start": 21,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@151265/line-3",
          "start": 42,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@151265/line-4",
          "start": 71,
          "end": 97,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4506346,
        "end": 4506483,
        "line": 167109,
        "column": 1,
        "path": "chap25/p@151265",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@151406",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "I mean, in singing: but in loving, Leander the good swimmer, Troilus the first employer of panders, and a whole book full of these quondam carpet-mongers, whose names yet run smoothly in the even road of a blank verse, why, they were never so truly turned over and over as my poor self in love. Marry, I cannot show it in rime; I have tried: I can find out no rime to ‘lady’ but ‘baby’, an innocent rime; for ‘scorn,’ ‘horn’, a hard rime; for ‘school’, ‘fool’, a babbling rime; very ominous endings: no, I was not born under a riming planet, nor I cannot woo in festival terms.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@151406/line-1",
          "start": 0,
          "end": 577,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4506487,
        "end": 4507097,
        "line": 167116,
        "column": 1,
        "path": "chap25/p@151406",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@152020",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Beatrice.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152020/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4507101,
        "end": 4507175,
        "line": 167128,
        "column": 1,
        "path": "chap25/p@152020",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@152098",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Sweet Beatrice, wouldst thou come when I called thee?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152098/line-1",
          "start": 0,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4507179,
        "end": 4507257,
        "line": 167132,
        "column": 1,
        "path": "chap25/p@152098",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@152180",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nYea, signior; and depart when you bid me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152180/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152180/line-2",
          "start": 10,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4507261,
        "end": 4507342,
        "line": 167136,
        "column": 1,
        "path": "chap25/p@152180",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@152265",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nO, stay but till then!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152265/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152265/line-2",
          "start": 10,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4507346,
        "end": 4507408,
        "line": 167141,
        "column": 1,
        "path": "chap25/p@152265",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@152331",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\n‘Then’ is spoken; fare you well now: and yet, ere I go, let me go with that I came for; which is, with knowing what hath passed between you and Claudio.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152331/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152331/line-2",
          "start": 10,
          "end": 162,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4507412,
        "end": 4507606,
        "line": 167146,
        "column": 1,
        "path": "chap25/p@152331",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@152529",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nOnly foul words; and thereupon I will kiss thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152529/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152529/line-2",
          "start": 10,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4507610,
        "end": 4507698,
        "line": 167153,
        "column": 1,
        "path": "chap25/p@152529",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@152621",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nFoul words is but foul wind, and foul wind is but foul breath, and foul breath is noisome; therefore I will depart unkissed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152621/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152621/line-2",
          "start": 10,
          "end": 134,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4507702,
        "end": 4507867,
        "line": 167158,
        "column": 1,
        "path": "chap25/p@152621",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@152790",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nThou hast frighted the word out of his right sense, so forcible is thy wit. But I must tell thee plainly, Claudio undergoes my challenge, and either I must shortly hear from him, or I will subscribe him a coward. And, I pray thee now, tell me, for which of my bad parts didst thou first fall in love with me?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152790/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@152790/line-2",
          "start": 10,
          "end": 318,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4507871,
        "end": 4508222,
        "line": 167164,
        "column": 1,
        "path": "chap25/p@152790",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@153145",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nFor them all together; which maintained so politic a state of evil that they will not admit any good part to intermingle with them. But for which of my good parts did you first suffer love for me?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153145/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153145/line-2",
          "start": 10,
          "end": 206,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4508226,
        "end": 4508464,
        "line": 167172,
        "column": 1,
        "path": "chap25/p@153145",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@153387",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\n‘Suffer love,’ a good epithet! I do suffer love indeed, for I love thee against my will.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153387/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153387/line-2",
          "start": 10,
          "end": 98,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4508468,
        "end": 4508597,
        "line": 167179,
        "column": 1,
        "path": "chap25/p@153387",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@153520",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nIn spite of your heart, I think. Alas, poor heart! If you spite it for my sake, I will spite it for yours; for I will never love that which my friend hates.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153520/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153520/line-2",
          "start": 10,
          "end": 166,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4508601,
        "end": 4508798,
        "line": 167185,
        "column": 1,
        "path": "chap25/p@153520",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@153721",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nThou and I are too wise to woo peaceably.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153721/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153721/line-2",
          "start": 10,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4508802,
        "end": 4508883,
        "line": 167191,
        "column": 1,
        "path": "chap25/p@153721",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@153806",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nIt appears not in this confession: there’s not one wise man among twenty that will praise himself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153806/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153806/line-2",
          "start": 10,
          "end": 108,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4508887,
        "end": 4509026,
        "line": 167196,
        "column": 1,
        "path": "chap25/p@153806",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@153949",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nAn old, an old instance, Beatrice, that lived in the time of good neighbours. If a man do not erect in this age his own tomb ere he dies, he shall live no longer in monument than the bell rings and the widow weeps.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153949/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@153949/line-2",
          "start": 10,
          "end": 224,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4509030,
        "end": 4509286,
        "line": 167202,
        "column": 1,
        "path": "chap25/p@153949",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@154209",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nAnd how long is that think you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154209/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154209/line-2",
          "start": 10,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4509290,
        "end": 4509360,
        "line": 167209,
        "column": 1,
        "path": "chap25/p@154209",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@154283",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nQuestion: why, an hour in clamour and a quarter in rheum: therefore is it most expedient for the wise,—if Don Worm, his conscience, find no impediment to the contrary,—to be the trumpet of his own virtues, as I am to myself. So much for praising myself, who, I myself will bear witness, is praiseworthy. And now tell me, how doth your cousin?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154283/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154283/line-2",
          "start": 10,
          "end": 352,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4509364,
        "end": 4509750,
        "line": 167213,
        "column": 1,
        "path": "chap25/p@154283",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@154673",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nVery ill.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154673/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154673/line-2",
          "start": 10,
          "end": 19,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4509754,
        "end": 4509803,
        "line": 167222,
        "column": 1,
        "path": "chap25/p@154673",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@154726",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nAnd how do you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154726/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154726/line-2",
          "start": 10,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4509807,
        "end": 4509862,
        "line": 167227,
        "column": 1,
        "path": "chap25/p@154726",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@154785",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nVery ill too.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154785/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154785/line-2",
          "start": 10,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4509866,
        "end": 4509919,
        "line": 167232,
        "column": 1,
        "path": "chap25/p@154785",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@154842",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nServe God, love me, and mend. There will I leave you too, for here comes one in haste.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154842/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154842/line-2",
          "start": 10,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4509923,
        "end": 4510050,
        "line": 167237,
        "column": 1,
        "path": "chap25/p@154842",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BENEDICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@154973",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Ursula.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 12,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@154973/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4510054,
        "end": 4510126,
        "line": 167243,
        "column": 1,
        "path": "chap25/p@154973",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@155049",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "URSULA.\nMadam, you must come to your uncle. Yonder’s old coil at home: it is proved, my Lady Hero hath been falsely accused, the Prince and Claudio mightily abused; and Don John is the author of all, who is fled and gone. Will you come presently?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@155049/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@155049/line-2",
          "start": 8,
          "end": 246,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4510130,
        "end": 4510409,
        "line": 167247,
        "column": 1,
        "path": "chap25/p@155049",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "URSULA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@155332",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEATRICE.\nWill you go hear this news, signior?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@155332/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@155332/line-2",
          "start": 10,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4510413,
        "end": 4510489,
        "line": 167255,
        "column": 1,
        "path": "chap25/p@155332",
        "anchor": "sceneV_25.2"
      },
      "speakerLabel": "BEATRICE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.2/p@155412",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENEDICK.\nI will live in thy heart, die in thy lap, and be buried in thy eyes; and moreover I will go with thee to thy uncle’s.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@155412/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.2/p@155412/line-2",
          "start": 10,
          "end": 127,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4510493,
        "end": 4510651,
        "line": 167260,
        "column": 1,
        "path": "chap25/p@155412",
        "anchor": "sceneV_25.2"
