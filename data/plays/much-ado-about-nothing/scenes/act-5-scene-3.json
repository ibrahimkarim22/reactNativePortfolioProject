    {
      "id": "much-ado-about-nothing/sceneV_25.3/p@156071",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "  Done to death by slanderous tongues\n    Was the Hero that here lies:\n  Death, in guerdon of her wrongs,\n    Gives her fame which never dies.\n  So the life that died with shame\n  Lives in death with glorious fame.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@156071/line-1",
          "start": 0,
          "end": 37,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@156071/line-2",
          "start": 38,
          "end": 70,
          "sourceLineNumber": null
        },
        {
