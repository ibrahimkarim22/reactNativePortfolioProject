    },
    {
      "id": "much-ado-about-nothing/sceneV_25.3/p@157339",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLAUDIO.\nGood morrow, masters: each his several way.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@157339/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
