    {
      "id": "much-ado-about-nothing/sceneV_25.3/p@156548",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": " Pardon, goddess of the night,\n  Those that slew thy virgin knight;\n  For the which, with songs of woe,\n  Round about her tomb they go.\n     Midnight, assist our moan;\n     Help us to sigh and groan,\n        Heavily, heavily:\n     Graves, yawn and yield your dead,\n     Till death be uttered,\n        Heavily, heavily.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@156548/line-1",
          "start": 0,
          "end": 30,
          "sourceLineNumber": null
        },
