          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4512420,
        "end": 4512502,
        "line": 167347,
        "column": 1,
        "path": "chap25/p@157339",
        "anchor": "sceneV_25.3"
      },
      "speakerLabel": "CLAUDIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.3/p@157425",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON PEDRO.\nCome, let us hence, and put on other weeds;\nAnd then to Leonato’s we will go.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@157425/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@157425/line-2",
          "start": 11,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@157425/line-3",
          "start": 55,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4512506,
        "end": 4512629,
        "line": 167352,
        "column": 1,
        "path": "chap25/p@157425",
        "anchor": "sceneV_25.3"
      },
      "speakerLabel": "DON PEDRO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.3/p@157552",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLAUDIO.\nAnd Hymen now with luckier issue speed’s,\nThan this for whom we rend’red up this woe!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@157552/line-1",
