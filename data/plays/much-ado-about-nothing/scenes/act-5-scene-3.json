    {
      "id": "much-ado-about-nothing/sceneV_25.3/p@156940",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLAUDIO.\nNow, unto thy bones good night!\nYearly will I do this rite.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@156940/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@156940/line-2",
          "start": 9,
          "end": 40,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@156940/line-3",
          "start": 41,
          "end": 68,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4512021,
        "end": 4512124,
        "line": 167332,
        "column": 1,
        "path": "chap25/p@156940",
        "anchor": "sceneV_25.3"
      },
      "speakerLabel": "CLAUDIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "much-ado-about-nothing/sceneV_25.3/p@157047",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DON PEDRO.\nGood morrow, masters: put your torches out.\nThe wolves have prey’d; and look, the gentle day,\nBefore the wheels of Phoebus, round about\nDapples the drowsy East with spots of grey.\nThanks to you all, and leave us: fare you well.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@157047/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "much-ado-about-nothing/sceneV_25.3/p@157047/line-2",
          "start": 11,
          "end": 54,
          "sourceLineNumber": null
        },
        {
