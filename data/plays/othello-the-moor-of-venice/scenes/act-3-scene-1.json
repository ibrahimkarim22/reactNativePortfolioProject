          "start": 70,
          "end": 111,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@91243/line-5",
          "start": 112,
          "end": 133,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
