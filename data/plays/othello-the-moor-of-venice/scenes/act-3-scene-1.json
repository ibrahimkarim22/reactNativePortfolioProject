    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@90717",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nGood morrow, good lieutenant; I am sorry\nFor your displeasure, but all will sure be well.\nThe general and his wife are talking of it,\nAnd she speaks for you stoutly: the Moor replies\nThat he you hurt is of great fame in Cyprus\nAnd great affinity, and that in wholesome wisdom\nHe might not but refuse you; but he protests he loves you\nAnd needs no other suitor but his likings\nTo take the safest occasion by the front\nTo bring you in again.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@90717/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@90717/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@90717/line-3",
          "start": 49,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@90717/line-4",
          "start": 98,
          "end": 141,
          "sourceLineNumber": null
        },
