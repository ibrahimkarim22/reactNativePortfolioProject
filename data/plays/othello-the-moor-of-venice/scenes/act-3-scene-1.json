      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89989",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CASSIO.\nWhy, no. The day had broke\nBefore we parted. I have made bold, Iago,\nTo send in to your wife. My suit to her\nIs, that she will to virtuous Desdemona\nProcure me some access.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89989/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89989/line-2",
          "start": 8,
          "end": 34,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89989/line-3",
          "start": 35,
          "end": 76,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89989/line-4",
          "start": 77,
          "end": 116,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89989/line-5",
          "start": 117,
          "end": 156,
          "sourceLineNumber": null
        },
        {
