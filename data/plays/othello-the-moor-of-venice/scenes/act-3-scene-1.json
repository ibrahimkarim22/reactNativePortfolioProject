      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IAGO.\nYou have not been a-bed, then?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89919/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89919/line-2",
          "start": 6,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4611870,
        "end": 4611936,
        "line": 171117,
        "column": 1,
        "path": "chap26/p@89919",
