    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@90223",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IAGO.\nI’ll send her to you presently,\nAnd I’ll devise a mean to draw the Moor\nOut of the way, that your converse and business\nMay be more free.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
