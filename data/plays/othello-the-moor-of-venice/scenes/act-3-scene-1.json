      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 11,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@87826/line-1",
