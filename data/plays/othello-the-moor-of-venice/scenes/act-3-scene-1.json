          "end": 12,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4609777,
        "end": 4609848,
        "line": 171011,
        "column": 1,
        "path": "chap26/p@87826",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": null,
