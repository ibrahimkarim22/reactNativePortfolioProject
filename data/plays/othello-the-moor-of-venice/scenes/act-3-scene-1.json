      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nPray you, come in.\nI will bestow you where you shall have time\nTo speak your bosom freely.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
