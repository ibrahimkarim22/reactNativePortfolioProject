    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@87633",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CASSIO.\nMasters, play here, I will content your pains,\nSomething that’s brief; and bid “Good morrow, general.”",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@87633/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@87633/line-2",
          "start": 8,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@87633/line-3",
          "start": 55,
          "end": 110,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4609584,
        "end": 4609729,
        "line": 171001,
        "column": 1,
