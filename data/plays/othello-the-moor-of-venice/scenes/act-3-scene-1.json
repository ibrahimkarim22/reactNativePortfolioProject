        "status": "not-applicable"
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@87901",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nWhy, masters, have your instruments been in Naples, that they speak i’ the nose thus?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@87901/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@87901/line-2",
          "start": 7,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4609852,
        "end": 4609975,
        "line": 171015,
        "column": 1,
        "path": "chap26/p@87901",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88028",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST MUSICIAN.\nHow, sir, how?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88028/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88028/line-2",
          "start": 16,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4609979,
        "end": 4610039,
        "line": 171021,
        "column": 1,
        "path": "chap26/p@88028",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "FIRST MUSICIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88092",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nAre these, I pray you, wind instruments?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88092/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88092/line-2",
          "start": 7,
          "end": 47,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4610043,
        "end": 4610120,
        "line": 171026,
        "column": 1,
        "path": "chap26/p@88092",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88173",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST MUSICIAN.\nAy, marry, are they, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88173/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88173/line-2",
          "start": 16,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4610124,
        "end": 4610195,
        "line": 171031,
        "column": 1,
        "path": "chap26/p@88173",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "FIRST MUSICIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88248",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nO, thereby hangs a tail.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88248/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88248/line-2",
          "start": 7,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4610199,
        "end": 4610260,
        "line": 171036,
        "column": 1,
        "path": "chap26/p@88248",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88313",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST MUSICIAN.\nWhereby hangs a tale, sir?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88313/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88313/line-2",
          "start": 16,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4610264,
        "end": 4610336,
        "line": 171041,
        "column": 1,
        "path": "chap26/p@88313",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "FIRST MUSICIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88389",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nMarry, sir, by many a wind instrument that I know. But, masters, here’s money for you: and the general so likes your music, that he desires you, for love’s sake, to make no more noise with it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88389/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88389/line-2",
          "start": 7,
          "end": 199,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4610340,
        "end": 4610571,
        "line": 171046,
        "column": 1,
        "path": "chap26/p@88389",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88624",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST MUSICIAN.\nWell, sir, we will not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88624/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88624/line-2",
          "start": 16,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4610575,
        "end": 4610644,
        "line": 171053,
        "column": 1,
        "path": "chap26/p@88624",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "FIRST MUSICIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88697",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nIf you have any music that may not be heard, to’t again. But, as they say, to hear music the general does not greatly care.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88697/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88697/line-2",
          "start": 7,
          "end": 130,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4610648,
        "end": 4610809,
        "line": 171058,
        "column": 1,
        "path": "chap26/p@88697",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88862",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST MUSICIAN.\nWe have none such, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88862/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88862/line-2",
          "start": 16,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4610813,
        "end": 4610882,
        "line": 171064,
        "column": 1,
        "path": "chap26/p@88862",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "FIRST MUSICIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88935",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nThen put up your pipes in your bag, for I’ll away. Go, vanish into air, away!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88935/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@88935/line-2",
          "start": 7,
          "end": 84,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4610886,
        "end": 4611000,
        "line": 171069,
        "column": 1,
        "path": "chap26/p@88935",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89053",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt Musicians.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 18
        }
      ],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89053/line-1",
          "start": 0,
          "end": 19,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4611004,
        "end": 4611055,
        "line": 171074,
        "column": 1,
        "path": "chap26/p@89053",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89108",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CASSIO.\nDost thou hear, mine honest friend?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89108/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89108/line-2",
          "start": 8,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4611059,
        "end": 4611132,
        "line": 171078,
        "column": 1,
        "path": "chap26/p@89108",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "CASSIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89185",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nNo, I hear not your honest friend. I hear you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89185/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89185/line-2",
          "start": 7,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4611136,
        "end": 4611219,
        "line": 171083,
        "column": 1,
        "path": "chap26/p@89185",
        "anchor": "sceneIII_26.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "othello-the-moor-of-venice/sceneIII_26.1/p@89272",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CASSIO.\nPrithee, keep up thy quillets. There’s a poor piece of gold for thee: if the gentlewoman that attends the general’s wife be stirring, tell her there’s one Cassio entreats her a little favour of speech. Wilt thou do this?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
