        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.2/p@22097",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nDrew sleep out of mine eyes, blood from my cheeks,\nMusings into my mind, with thousand doubts\nHow I might stop this tempest ere it came;\nAnd finding little comfort to relieve them,\nI thought it princely charity to grieve them.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.2/p@22097/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.2/p@22097/line-2",
          "start": 10,
          "end": 60,
          "sourceLineNumber": null
        },
        {
