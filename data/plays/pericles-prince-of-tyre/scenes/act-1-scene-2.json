    {
      "id": "pericles-prince-of-tyre/sceneI_27.2/p@19997",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS. [Kneeling.]\nI have ground the axe myself;\nDo but you strike the blow.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 12,
