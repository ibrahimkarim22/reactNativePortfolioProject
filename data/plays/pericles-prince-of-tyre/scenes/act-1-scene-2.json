      "sourceRef": {
        "start": 4758984,
        "end": 4759035,
        "line": 177587,
        "column": 1,
        "path": "chap27/p@22042",
        "anchor": "sceneI_27.2"
      },
      "speakerLabel": "HELICANUS.",
      "attribution": {
