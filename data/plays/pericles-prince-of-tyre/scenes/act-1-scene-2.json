        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.2/p@23026",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELCANUS.\nWe’ll mingle our bloods together in the earth,\nFrom whence we had our being and our birth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.2/p@23026/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.2/p@23026/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.2/p@23026/line-3",
          "start": 57,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4759968,
        "end": 4760103,
        "line": 177621,
        "column": 1,
        "path": "chap27/p@23026",
        "anchor": "sceneI_27.2"
      },
      "speakerLabel": "HELCANUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.2/p@23165",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nTyre, I now look from thee then, and to Tarsus\nIntend my travel, where I’ll hear from thee;\nAnd by whose letters I’ll dispose myself.\nThe care I had and have of subjects’ good\nOn thee I lay, whose wisdom’s strength can bear it.\nI’ll take thy word for faith, not ask thine oath:\nWho shuns not to break one will sure crack both:\nBut in our orbs we’ll live so round and safe,\nThat time of both this truth shall ne’er convince,\nThou show’dst a subject’s shine, I a true prince.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
