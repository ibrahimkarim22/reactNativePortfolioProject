    {
      "id": "pericles-prince-of-tyre/sceneI_27.2/p@20463",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS.\nTo bear with patience\nSuch griefs as you yourself do lay upon yourself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
