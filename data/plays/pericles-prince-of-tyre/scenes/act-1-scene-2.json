    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.2/p@20123",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nRise, prithee, rise.\nSit down: thou art no flatterer:\nI thank thee for it; and heaven forbid\nThat kings should let their ears hear their faults hid!\nFit counsellor and servant for a prince,\nWho by thy wisdom makest a prince thy servant,\nWhat wouldst thou have me do?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.2/p@20123/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
