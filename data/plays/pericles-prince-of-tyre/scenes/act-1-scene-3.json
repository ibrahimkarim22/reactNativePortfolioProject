      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@23861/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4760803,
        "end": 4760874,
        "line": 177645,
        "column": 1,
        "path": "chap27/p@23861",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": null,
