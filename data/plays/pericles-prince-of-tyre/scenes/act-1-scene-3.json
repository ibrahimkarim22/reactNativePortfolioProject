        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@23936",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THALIARD.\nSo, this is Tyre, and this the court. Here must I kill King Pericles; and if I do it not, I am sure to be hanged at home: ’tis dangerous. Well, I perceive he was a wise fellow, and had good discretion, that, being bid to ask what he would of the king, desired he might know none of his secrets: now do I see he had some reason for’t; for if a king bid a man be a villain, he’s bound by the indenture of his oath to be one. Husht, here come the lords of Tyre.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@23936/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@23936/line-2",
          "start": 10,
          "end": 468,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4760878,
        "end": 4761382,
        "line": 177647,
        "column": 1,
        "path": "chap27/p@23936",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": "THALIARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@24444",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Helicanus and Escanes with other Lords of Tyre.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 15,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 20,
          "end": 27,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24444/line-1",
          "start": 0,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4761386,
        "end": 4761527,
        "line": 177658,
        "column": 1,
        "path": "chap27/p@24444",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@24589",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS.\nYou shall not need, my fellow peers of Tyre,\nFurther to question me of your king’s departure:\nHis seal’d commission, left in trust with me,\nDoth speak sufficiently he’s gone to travel.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24589/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24589/line-2",
          "start": 11,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24589/line-3",
          "start": 56,
          "end": 104,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24589/line-4",
          "start": 105,
          "end": 150,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24589/line-5",
          "start": 151,
          "end": 195,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4761531,
        "end": 4761771,
        "line": 177661,
        "column": 1,
        "path": "chap27/p@24589",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": "HELICANUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@24833",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THALIARD.\n[Aside.] How? the king gone?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 11,
          "end": 17
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24833/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24833/line-2",
          "start": 10,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4761775,
        "end": 4761850,
        "line": 177669,
        "column": 1,
        "path": "chap27/p@24833",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": "THALIARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@24912",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS.\nIf further yet you will be satisfied,\nWhy, as it were unlicensed of your loves,\nHe would depart, I’ll give some light unto you.\nBeing at Antioch—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24912/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24912/line-2",
          "start": 11,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24912/line-3",
          "start": 49,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24912/line-4",
          "start": 91,
          "end": 138,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@24912/line-5",
          "start": 139,
          "end": 156,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4761854,
        "end": 4762055,
        "line": 177674,
        "column": 1,
        "path": "chap27/p@24912",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": "HELICANUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@25117",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THALIARD.\n[Aside.] What from Antioch?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 11,
          "end": 17
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25117/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25117/line-2",
          "start": 10,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4762059,
        "end": 4762133,
        "line": 177682,
        "column": 1,
        "path": "chap27/p@25117",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": "THALIARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@25195",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS.\nRoyal Antiochus—on what cause I know not\nTook some displeasure at him; at least he judged so:\nAnd doubting lest that he had err’d or sinn’d,\nTo show his sorrow, he’d correct himself;\nSo puts himself unto the shipman’s toil,\nWith whom each minute threatens life or death.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25195/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25195/line-2",
          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25195/line-3",
          "start": 52,
          "end": 104,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25195/line-4",
          "start": 105,
          "end": 151,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25195/line-5",
          "start": 152,
          "end": 193,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25195/line-6",
          "start": 194,
          "end": 234,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25195/line-7",
          "start": 235,
          "end": 281,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4762137,
        "end": 4762473,
        "line": 177687,
        "column": 1,
        "path": "chap27/p@25195",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": "HELICANUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@25535",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THALIARD.\n[Aside.] Well, I perceive\nI shall not be hang’d now, although I would;\nBut since he’s gone, the king’s seas must please\nHe ’scaped the land, to perish at the sea.\nI’ll present myself. Peace to the lords of Tyre!",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 11,
          "end": 17
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25535/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25535/line-2",
          "start": 10,
          "end": 35,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25535/line-3",
          "start": 36,
          "end": 80,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25535/line-4",
          "start": 81,
          "end": 129,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25535/line-5",
          "start": 130,
          "end": 172,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25535/line-6",
          "start": 173,
          "end": 221,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4762477,
        "end": 4762755,
        "line": 177697,
        "column": 1,
        "path": "chap27/p@25535",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": "THALIARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@25817",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS.\nLord Thaliard from Antiochus is welcome.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25817/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25817/line-2",
          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4762759,
        "end": 4762840,
        "line": 177706,
        "column": 1,
        "path": "chap27/p@25817",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": "HELICANUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@25902",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THALIARD.\nFrom him I come\nWith message unto princely Pericles;\nBut since my landing I have understood\nYour lord has betook himself to unknown travels,\nMy message must return from whence it came.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25902/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25902/line-2",
          "start": 10,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25902/line-3",
          "start": 26,
          "end": 62,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25902/line-4",
          "start": 63,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25902/line-5",
          "start": 102,
          "end": 150,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@25902/line-6",
          "start": 151,
          "end": 194,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4762844,
        "end": 4763088,
        "line": 177711,
        "column": 1,
        "path": "chap27/p@25902",
        "anchor": "sceneI_27.3"
      },
      "speakerLabel": "THALIARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.3/p@26150",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS.\nWe have no reason to desire it,\nCommended to our master, not to us:\nYet, ere you shall depart, this we desire,\nAs friends to Antioch, we may feast in Tyre.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@26150/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@26150/line-2",
          "start": 11,
          "end": 42,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@26150/line-3",
          "start": 43,
          "end": 78,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@26150/line-4",
          "start": 79,
          "end": 121,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.3/p@26150/line-5",
          "start": 122,
          "end": 166,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4763092,
        "end": 4763303,
        "line": 177720,
        "column": 1,
