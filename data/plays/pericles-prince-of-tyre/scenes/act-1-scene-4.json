    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@29320",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIONYZA.\nOur cheeks and hollow eyes do witness it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@29320/line-1",
