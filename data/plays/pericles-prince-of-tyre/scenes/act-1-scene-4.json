      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@31259",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Pericles with Attendants.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@31259/line-1",
          "start": 0,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4768201,
        "end": 4768291,
        "line": 177892,
        "column": 1,
        "path": "chap27/p@31259",
        "anchor": "sceneI_27.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@31353",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nLord governor, for so we hear you are,\nLet not our ships and number of our men\nBe like a beacon fired to amaze your eyes.\nWe have heard your miseries as far as Tyre,\nAnd seen the desolation of your streets:\nNor come we to add sorrow to your tears,\nBut to relieve them of their heavy load;\nAnd these our ships, you happily may think\nAre like the Trojan horse was stuff’d within\nWith bloody veins, expecting overthrow,\nAre stored with corn to make your needy bread,\nAnd give them life whom hunger starved half dead.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@31353/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@31353/line-2",
          "start": 10,
          "end": 48,
          "sourceLineNumber": null
        },
        {
