          "start": 6,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4766637,
        "end": 4766699,
        "line": 177829,
        "column": 1,
        "path": "chap27/p@29695",
        "anchor": "sceneI_27.4"
      },
      "speakerLabel": "LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@29761",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEON.\nHere.\nSpeak out thy sorrows which thou bring’st in haste,\nFor comfort is too far for us to expect.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@29761/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@29761/line-2",
          "start": 7,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@29761/line-3",
          "start": 13,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@29761/line-4",
          "start": 65,
          "end": 105,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4766703,
        "end": 4766848,
        "line": 177834,
        "column": 1,
        "path": "chap27/p@29761",
        "anchor": "sceneI_27.4"
      },
      "speakerLabel": "CLEON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@29910",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORD.\nWe have descried, upon our neighbouring shore,\nA portly sail of ships make hitherward.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@29910/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@29910/line-2",
          "start": 6,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@29910/line-3",
          "start": 53,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4766852,
        "end": 4766979,
        "line": 177841,
        "column": 1,
        "path": "chap27/p@29910",
        "anchor": "sceneI_27.4"
      },
      "speakerLabel": "LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@30041",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEON.\nI thought as much.\nOne sorrow never comes but brings an heir,\nThat may succeed as his inheritor;\nAnd so in ours: some neighbouring nation,\nTaking advantage of our misery,\nThat stuff’d the hollow vessels with their power,\nTo beat us down, the which are down already;\nAnd make a conquest of unhappy me,\nWhereas no glory’s got to overcome.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@30041/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@30041/line-2",
          "start": 7,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@30041/line-3",
          "start": 26,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@30041/line-4",
          "start": 69,
          "end": 103,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@30041/line-5",
          "start": 104,
          "end": 145,
          "sourceLineNumber": null
        },
        {
