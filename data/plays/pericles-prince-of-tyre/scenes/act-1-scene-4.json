          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4766262,
        "end": 4766342,
        "line": 177814,
        "column": 1,
        "path": "chap27/p@29320",
        "anchor": "sceneI_27.4"
      },
      "speakerLabel": "DIONYZA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@29404",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEON.\nO, let those cities that of plenty’s cup\nAnd her prosperities so largely taste,\nWith their superflous riots, hear these tears!\nThe misery of Tarsus may be theirs.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@29404/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
