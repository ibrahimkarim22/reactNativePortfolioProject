          "end": 7,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4768040,
        "end": 4768076,
        "line": 177884,
        "column": 1,
        "path": "chap27/p@31098",
        "anchor": "sceneI_27.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@31138",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEON.\nWelcome is peace, if he on peace consist;\nIf wars, we are unable to resist.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@31138/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
