        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@31965",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALL.\nThe gods of Greece protect you!\nAnd we’ll pray for you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@31965/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@31965/line-2",
          "start": 5,
          "end": 36,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@31965/line-3",
          "start": 37,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4768907,
        "end": 4769002,
        "line": 177912,
        "column": 1,
        "path": "chap27/p@31965",
        "anchor": "sceneI_27.4"
      },
      "speakerLabel": "ALL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@32064",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nArise, I pray you, rise:\nWe do not look for reverence, but for love,\nAnd harbourage for ourself, our ships and men.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@32064/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@32064/line-2",
          "start": 10,
          "end": 34,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@32064/line-3",
          "start": 35,
          "end": 78,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@32064/line-4",
          "start": 79,
          "end": 125,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
