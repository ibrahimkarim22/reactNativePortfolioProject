          "start": 9,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4764639,
        "end": 4764699,
        "line": 177767,
        "column": 1,
        "path": "chap27/p@27697",
        "anchor": "sceneI_27.4"
      },
      "speakerLabel": "DIONYZA.",
