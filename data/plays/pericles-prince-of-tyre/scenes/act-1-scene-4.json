    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@30458",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORD.\nThat’s the least fear; for, by the semblance\nOf their white flags display’d, they bring us peace,\nAnd come to us as favourers, not as foes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@30458/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@30458/line-2",
          "start": 6,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@30458/line-3",
          "start": 51,
          "end": 103,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@30458/line-4",
          "start": 104,
          "end": 145,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4767400,
        "end": 4767585,
        "line": 177860,
        "column": 1,
        "path": "chap27/p@30458",
        "anchor": "sceneI_27.4"
      },
      "speakerLabel": "LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@30647",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEON.\nThou speak’st like him’s untutor’d to repeat:\nWho makes the fairest show means most deceit.\nBut bring they what they will and what they can,\nWhat need we fear?\nThe ground’s the lowest, and we are half way there.\nGo tell their general we attend him here,\nTo know for what he comes, and whence he comes,\nAnd what he craves.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@30647/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
