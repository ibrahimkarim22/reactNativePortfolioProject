      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIONYZA.\nI’ll do my best, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@27697/line-1",
