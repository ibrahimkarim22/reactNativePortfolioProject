      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORD.\nWhere’s the lord governor?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@29695/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
