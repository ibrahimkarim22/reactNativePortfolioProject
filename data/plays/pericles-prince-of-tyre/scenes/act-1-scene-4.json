    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@26655",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEON.\nMy Dionyza, shall we rest us here,\nAnd by relating tales of others’ griefs,\nSee if ’twill teach us to forget our own?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@26655/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@26655/line-2",
          "start": 7,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@26655/line-3",
          "start": 42,
          "end": 82,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@26655/line-4",
          "start": 83,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4763597,
        "end": 4763761,
        "line": 177736,
        "column": 1,
        "path": "chap27/p@26655",
        "anchor": "sceneI_27.4"
      },
      "speakerLabel": "CLEON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneI_27.4/p@26823",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIONYZA.\nThat were to blow at fire in hope to quench it;\nFor who digs hills because they do aspire\nThrows down one mountain to cast up a higher.\nO my distressed lord, even such our griefs are;\nHere they’re but felt, and seen with mischief’s eyes,\nBut like to groves, being topp’d, they higher rise.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@26823/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneI_27.4/p@26823/line-2",
          "start": 9,
          "end": 56,
          "sourceLineNumber": null
        },
        {
