        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@45398",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nAre the knights ready to begin the triumph?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45398/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45398/line-2",
          "start": 11,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4782340,
        "end": 4782424,
        "line": 178386,
        "column": 1,
        "path": "chap27/p@45398",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@45486",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nThey are, my liege;\nAnd stay your coming to present themselves.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45486/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45486/line-2",
          "start": 12,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45486/line-3",
          "start": 32,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4782428,
        "end": 4782538,
        "line": 178391,
        "column": 1,
        "path": "chap27/p@45486",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@45600",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nReturn them, we are ready; and our daughter,\nIn honour of whose birth these triumphs are,\nSits here, like beauty’s child, whom Nature gat\nFor men to see, and seeing wonder at.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45600/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45600/line-2",
          "start": 11,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45600/line-3",
          "start": 56,
          "end": 100,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45600/line-4",
          "start": 101,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45600/line-5",
          "start": 149,
          "end": 186,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4782542,
        "end": 4782773,
        "line": 178397,
        "column": 1,
        "path": "chap27/p@45600",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@45835",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit a Lord.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 12,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 13
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45835/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4782777,
        "end": 4782850,
        "line": 178405,
        "column": 1,
        "path": "chap27/p@45835",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@45912",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THAISA.\nIt pleaseth you, my royal father, to express\nMy commendations great, whose merit’s less.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45912/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45912/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@45912/line-3",
          "start": 53,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4782854,
        "end": 4782985,
        "line": 178407,
        "column": 1,
        "path": "chap27/p@45912",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "THAISA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@46047",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nIt’s fit it should be so; for princes are\nA model, which heaven makes like to itself:\nAs jewels lose their glory if neglected,\nSo princes their renowns if not respected.\n’Tis now your honour, daughter, to entertain\nThe labour of each knight in his device.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46047/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46047/line-2",
          "start": 11,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46047/line-3",
          "start": 53,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46047/line-4",
          "start": 97,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46047/line-5",
          "start": 138,
          "end": 180,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46047/line-6",
          "start": 181,
          "end": 225,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46047/line-7",
          "start": 226,
          "end": 266,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4782989,
        "end": 4783310,
        "line": 178413,
        "column": 1,
        "path": "chap27/p@46047",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@46372",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THAISA.\nWhich, to preserve mine honour, I’ll perform.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46372/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46372/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4783314,
        "end": 4783397,
        "line": 178423,
        "column": 1,
        "path": "chap27/p@46372",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "THAISA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@46459",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "The first Knight passes by, and his Squire presents his shield to Thaisa.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46459/line-1",
          "start": 0,
          "end": 73,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4783401,
        "end": 4783503,
        "line": 178428,
        "column": 1,
        "path": "chap27/p@46459",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@46565",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nWho is the first that doth prefer himself?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46565/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46565/line-2",
          "start": 11,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4783507,
        "end": 4783590,
        "line": 178432,
        "column": 1,
        "path": "chap27/p@46565",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@46652",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THAISA.\nA knight of Sparta, my renowned father;\nAnd the device he bears upon his shield\nIs a black Ethiope reaching at the sun:\nThe word, Lux tua vita mihi.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 138,
          "end": 156
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46652/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46652/line-2",
          "start": 8,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46652/line-3",
          "start": 48,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46652/line-4",
          "start": 88,
          "end": 127,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46652/line-5",
          "start": 128,
          "end": 156,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4783594,
        "end": 4783802,
        "line": 178437,
        "column": 1,
        "path": "chap27/p@46652",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "THAISA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@46864",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nHe loves you well that holds his life of you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46864/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46864/line-2",
          "start": 11,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4783806,
        "end": 4783892,
        "line": 178445,
        "column": 1,
        "path": "chap27/p@46864",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@46954",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "The second Knight passes by, and his Squire presents his shield to Thaisa.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@46954/line-1",
          "start": 0,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4783896,
        "end": 4783999,
        "line": 178450,
        "column": 1,
        "path": "chap27/p@46954",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@47061",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Who is the second that presents himself?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47061/line-1",
          "start": 0,
          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4784003,
        "end": 4784068,
        "line": 178454,
        "column": 1,
        "path": "chap27/p@47061",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@47130",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THAISA.\nA prince of Macedon, my royal father;\nAnd the device he bears upon his shield\nIs an arm’d knight that’s conquer’d by a lady;\nThe motto thus, in Spanish, Piu por dulzura que por forza.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 161,
          "end": 191
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47130/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47130/line-2",
          "start": 8,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47130/line-3",
          "start": 46,
          "end": 85,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47130/line-4",
          "start": 86,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47130/line-5",
          "start": 133,
          "end": 191,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4784072,
        "end": 4784315,
        "line": 178458,
        "column": 1,
        "path": "chap27/p@47130",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "THAISA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@47377",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "The third Knight passes by, and his Squire presents his shield to Thaisa.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47377/line-1",
          "start": 0,
          "end": 73,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4784319,
        "end": 4784421,
        "line": 178466,
        "column": 1,
        "path": "chap27/p@47377",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@47483",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nAnd what’s the third?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47483/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47483/line-2",
          "start": 11,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4784425,
        "end": 4784487,
        "line": 178470,
        "column": 1,
        "path": "chap27/p@47483",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@47549",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THAISA.\nThe third of Antioch;\nAnd his device, a wreath of chivalry;\nThe word, Me pompae provexit apex.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 78,
          "end": 102
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47549/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47549/line-2",
          "start": 8,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47549/line-3",
          "start": 30,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47549/line-4",
          "start": 68,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4784491,
        "end": 4784640,
        "line": 178475,
        "column": 1,
        "path": "chap27/p@47549",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "THAISA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@47702",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "The fourth Knight passes by, and his Squire presents his shield to Thaisa.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47702/line-1",
          "start": 0,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4784644,
        "end": 4784747,
        "line": 178482,
        "column": 1,
        "path": "chap27/p@47702",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@47809",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nWhat is the fourth?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47809/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47809/line-2",
          "start": 11,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4784751,
        "end": 4784811,
        "line": 178486,
        "column": 1,
        "path": "chap27/p@47809",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@47873",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THAISA.\nA burning torch that’s turned upside down;\nThe word, Quod me alit me extinguit.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 61,
          "end": 87
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47873/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47873/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@47873/line-3",
          "start": 51,
          "end": 87,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4784815,
        "end": 4784944,
        "line": 178491,
        "column": 1,
        "path": "chap27/p@47873",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "THAISA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@48006",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nWhich shows that beauty hath his power and will,\nWhich can as well inflame as it can kill.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48006/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48006/line-2",
          "start": 11,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48006/line-3",
          "start": 60,
          "end": 101,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4784948,
        "end": 4785084,
        "line": 178497,
        "column": 1,
        "path": "chap27/p@48006",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@48146",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "The fifth Knight passes by, and his Squire presents his shield to Thaisa.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48146/line-1",
          "start": 0,
          "end": 73,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4785088,
        "end": 4785190,
        "line": 178503,
        "column": 1,
        "path": "chap27/p@48146",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@48252",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THAISA.\nThe fifth, an hand environed with clouds,\nHolding out gold that’s by the touchstone tried;\nThe motto thus, Sic spectanda fides.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 115,
          "end": 135
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48252/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48252/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48252/line-3",
          "start": 50,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48252/line-4",
          "start": 99,
          "end": 135,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4785194,
        "end": 4785376,
        "line": 178507,
        "column": 1,
        "path": "chap27/p@48252",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "THAISA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@48438",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "The sixth Knight, Pericles, passes in rusty armour with bases, and unaccompanied. He presents his device directly to Thaisa.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 18,
          "end": 27,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48438/line-1",
          "start": 0,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4785380,
        "end": 4785564,
        "line": 178514,
        "column": 1,
        "path": "chap27/p@48438",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@48626",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nAnd what’s the sixth and last, the which the knight himself\nWith such a graceful courtesy deliver’d?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48626/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48626/line-2",
          "start": 11,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48626/line-3",
          "start": 71,
          "end": 111,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4785568,
        "end": 4785714,
        "line": 178519,
        "column": 1,
        "path": "chap27/p@48626",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@48776",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THAISA.\nHe seems to be a stranger; but his present is\nA wither’d branch, that’s only green at top;\nThe motto, In hac spe vivo.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 110,
          "end": 126
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48776/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48776/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48776/line-3",
          "start": 54,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48776/line-4",
          "start": 99,
          "end": 126,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4785718,
        "end": 4785891,
        "line": 178525,
        "column": 1,
        "path": "chap27/p@48776",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "THAISA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@48953",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nA pretty moral;\nFrom the dejected state wherein he is,\nHe hopes by you his fortunes yet may flourish.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48953/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48953/line-2",
          "start": 11,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48953/line-3",
          "start": 27,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@48953/line-4",
          "start": 66,
          "end": 112,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4785895,
        "end": 4786047,
        "line": 178532,
        "column": 1,
        "path": "chap27/p@48953",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@49109",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nHe had need mean better than his outward show\nCan any way speak in his just commend;\nFor by his rusty outside he appears\nTo have practised more the whipstock than the lance.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49109/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49109/line-2",
          "start": 12,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49109/line-3",
          "start": 58,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49109/line-4",
          "start": 97,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49109/line-5",
          "start": 133,
          "end": 185,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4786051,
        "end": 4786281,
        "line": 178539,
        "column": 1,
        "path": "chap27/p@49109",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@49343",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nHe well may be a stranger, for he comes\nTo an honour’d triumph strangely furnished.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49343/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49343/line-2",
          "start": 13,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49343/line-3",
          "start": 53,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4786285,
        "end": 4786416,
        "line": 178547,
        "column": 1,
        "path": "chap27/p@49343",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@49478",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD LORD.\nAnd on set purpose let his armour rust\nUntil this day, to scour it in the dust.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49478/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49478/line-2",
          "start": 12,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49478/line-3",
          "start": 51,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4786420,
        "end": 4786546,
        "line": 178553,
        "column": 1,
        "path": "chap27/p@49478",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "THIRD LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@49608",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMONIDES.\nOpinion’s but a fool, that makes us scan\nThe outward habit by the inward man.\nBut stay, the knights are coming.\nWe will withdraw into the gallery.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49608/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49608/line-2",
          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49608/line-3",
          "start": 52,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49608/line-4",
          "start": 89,
          "end": 122,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49608/line-5",
          "start": 123,
          "end": 157,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4786550,
        "end": 4786752,
        "line": 178559,
        "column": 1,
        "path": "chap27/p@49608",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": "SIMONIDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.2/p@49814",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt. Great shouts within, and all cry ‘The mean Knight!’]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 41
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.2/p@49814/line-1",
          "start": 0,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4786756,
        "end": 4786847,
        "line": 178567,
        "column": 1,
        "path": "chap27/p@49814",
        "anchor": "sceneII_27.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    }
  ],
