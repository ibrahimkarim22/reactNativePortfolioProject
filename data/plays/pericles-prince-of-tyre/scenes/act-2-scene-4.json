          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@57327/line-1",
          "start": 0,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4794269,
        "end": 4794383,
        "line": 178859,
        "column": 1,
        "path": "chap27/p@57327",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@57445",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS.\nNo, Escanes, know this of me,\nAntiochus from incest lived not free:\nFor which the most high gods not minding longer\nTo withhold the vengeance that they had in store\nDue to this heinous capital offence,\nEven in the height and pride of all his glory,\nWhen he was seated in a chariot\nOf an inestimable value, and his daughter with him,\nA fire from heaven came and shrivell’d up\nTheir bodies, even to loathing, for they so stunk,\nThat all those eyes adored them ere their fall\nScorn now their hand should give them burial.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@57445/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@57445/line-2",
          "start": 11,
          "end": 40,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@57445/line-3",
          "start": 41,
          "end": 78,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@57445/line-4",
          "start": 79,
          "end": 126,
          "sourceLineNumber": null
        },
        {
