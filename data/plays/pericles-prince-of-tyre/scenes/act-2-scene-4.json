    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@58063",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ESCANES.\n’Twas very strange",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58063/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58063/line-2",
          "start": 9,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4795005,
        "end": 4795062,
        "line": 178877,
        "column": 1,
        "path": "chap27/p@58063",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "ESCANES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@58124",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS.\nAnd yet but justice; for though this king were great;\nHis greatness was no guard to bar heaven’s shaft,\nBut sin had his reward.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58124/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58124/line-2",
          "start": 11,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58124/line-3",
          "start": 65,
          "end": 114,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58124/line-4",
          "start": 115,
          "end": 138,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4795066,
        "end": 4795244,
        "line": 178882,
        "column": 1,
        "path": "chap27/p@58124",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "HELICANUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@58306",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ESCANES.\n’Tis very true.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58306/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58306/line-2",
          "start": 9,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4795248,
        "end": 4795302,
        "line": 178889,
        "column": 1,
        "path": "chap27/p@58306",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "ESCANES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@58364",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter two or three Lords.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 19,
          "end": 24,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58364/line-1",
          "start": 0,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4795306,
        "end": 4795387,
        "line": 178894,
        "column": 1,
        "path": "chap27/p@58364",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@58449",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nSee, not a man in private conference\nOr council has respect with him but he.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58449/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58449/line-2",
          "start": 12,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58449/line-3",
          "start": 49,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4795391,
        "end": 4795514,
        "line": 178896,
        "column": 1,
        "path": "chap27/p@58449",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@58576",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nIt shall no longer grieve without reproof.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58576/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58576/line-2",
          "start": 13,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4795518,
        "end": 4795603,
        "line": 178902,
        "column": 1,
        "path": "chap27/p@58576",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "SECOND LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@58665",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD LORD.\nAnd cursed be he that will not second it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58665/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58665/line-2",
          "start": 12,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4795607,
        "end": 4795690,
        "line": 178907,
        "column": 1,
        "path": "chap27/p@58665",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "THIRD LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@58752",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nFollow me, then. Lord Helicane, a word.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58752/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58752/line-2",
          "start": 12,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4795694,
        "end": 4795775,
        "line": 178912,
        "column": 1,
        "path": "chap27/p@58752",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@58837",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS.\nWith me? and welcome: happy day, my lords.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58837/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58837/line-2",
          "start": 11,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4795779,
        "end": 4795862,
        "line": 178917,
        "column": 1,
        "path": "chap27/p@58837",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "HELICANUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@58924",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nKnow that our griefs are risen to the top,\nAnd now at length they overflow their banks.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58924/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58924/line-2",
          "start": 12,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@58924/line-3",
          "start": 55,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4795866,
        "end": 4796000,
        "line": 178922,
        "column": 1,
        "path": "chap27/p@58924",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@59062",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HELICANUS.\nYour griefs! for what? Wrong not your prince you love.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59062/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59062/line-2",
          "start": 11,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4796004,
        "end": 4796099,
        "line": 178928,
        "column": 1,
        "path": "chap27/p@59062",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "HELICANUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@59161",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST LORD.\nWrong not yourself, then, noble Helicane;\nBut if the prince do live, let us salute him.\nOr know what ground’s made happy by his breath.\nIf in the world he live, we’ll seek him out;\nIf in his grave he rest, we’ll find him there.\nWe’ll be resolved he lives to govern us,\nOr dead, give’s cause to mourn his funeral,\nAnd leave us to our free election.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59161/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59161/line-2",
          "start": 12,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59161/line-3",
          "start": 54,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59161/line-4",
          "start": 100,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59161/line-5",
          "start": 148,
          "end": 192,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59161/line-6",
          "start": 193,
          "end": 239,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59161/line-7",
          "start": 240,
          "end": 280,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59161/line-8",
          "start": 281,
          "end": 324,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneII_27.4/p@59161/line-9",
          "start": 325,
          "end": 359,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4796103,
        "end": 4796527,
        "line": 178933,
        "column": 1,
        "path": "chap27/p@59161",
        "anchor": "sceneII_27.4"
      },
      "speakerLabel": "FIRST LORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneII_27.4/p@59589",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND LORD.\nWhose death’s indeed the strongest in our censure:\nAnd knowing this kingdom is without a head,—\nLike goodly buildings left without a roof\nSoon fall to ruin,—your noble self,\nThat best know how to rule and how to reign,\nWe thus submit unto,—our sovereign.",
      "separatorAfter": "\n\n",
      "spans": [],
