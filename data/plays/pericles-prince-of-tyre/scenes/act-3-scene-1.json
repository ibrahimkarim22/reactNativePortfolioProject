    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71443",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nHow? how, Lychorida?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71443/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71443/line-2",
          "start": 10,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4808385,
        "end": 4808445,
        "line": 179366,
        "column": 1,
        "path": "chap27/p@71443",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "PERICLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71507",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LYCHORIDA.\nPatience, good sir; do not assist the storm.\nHere’s all that is left living of your queen,\nA little daughter: for the sake of it,\nBe manly, and take comfort.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71507/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71507/line-2",
          "start": 11,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71507/line-3",
          "start": 56,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71507/line-4",
          "start": 102,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71507/line-5",
          "start": 141,
          "end": 168,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4808449,
        "end": 4808662,
        "line": 179371,
        "column": 1,
        "path": "chap27/p@71507",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "LYCHORIDA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71724",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nO you gods!\nWhy do you make us love your goodly gifts,\nAnd snatch them straight away? We here below\nRecall not what we give, and therein may\nVie honour with you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71724/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71724/line-2",
          "start": 10,
          "end": 21,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71724/line-3",
          "start": 22,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71724/line-4",
          "start": 65,
          "end": 109,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71724/line-5",
          "start": 110,
          "end": 150,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71724/line-6",
          "start": 151,
          "end": 171,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
