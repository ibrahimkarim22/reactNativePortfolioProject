        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71949",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LYCHORIDA.\nPatience, good sir.\nEven for this charge.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71949/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71949/line-2",
          "start": 11,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71949/line-3",
          "start": 31,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4808891,
        "end": 4808978,
        "line": 179388,
        "column": 1,
        "path": "chap27/p@71949",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "LYCHORIDA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72040",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nNow, mild may be thy life!\nFor a more blustrous birth had never babe:\nQuiet and gentle thy conditions! for\nThou art the rudeliest welcome to this world\nThat ever was prince’s child. Happy what follows!\nThou hast as chiding a nativity\nAs fire, air, water, earth, and heaven can make,\nTo herald thee from the womb.\nEven at the first thy loss is more than can\nThy portage quit, with all thou canst find here,\nNow, the good gods throw their best eyes upon’t!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72040/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
