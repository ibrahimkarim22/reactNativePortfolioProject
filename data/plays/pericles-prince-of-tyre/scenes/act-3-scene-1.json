    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74501",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit Lychorida.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 16,
          "className": "charname"
        },
        {
