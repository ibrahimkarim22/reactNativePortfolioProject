          "start": 145,
          "end": 171,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4809689,
        "end": 4809905,
        "line": 179417,
        "column": 1,
        "path": "chap27/p@72747",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "PERICLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72967",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SAILOR.\nSlack the bolins there! Thou wilt not, wilt thou? Blow, and split thyself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72967/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72967/line-2",
          "start": 14,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4809909,
        "end": 4810027,
        "line": 179425,
        "column": 1,
        "path": "chap27/p@72967",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "FIRST SAILOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73089",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SAILOR.\nBut sea-room, and the brine and cloudy billow kiss the moon, I care not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73089/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73089/line-2",
          "start": 15,
          "end": 87,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4810031,
        "end": 4810148,
        "line": 179430,
        "column": 1,
        "path": "chap27/p@73089",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "SECOND SAILOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73210",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SAILOR.\nSir, your queen must overboard: the sea works high, the wind is loud and will not lie till the ship be cleared of the dead.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73210/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73210/line-2",
          "start": 14,
          "end": 137,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4810152,
        "end": 4810320,
        "line": 179435,
        "column": 1,
        "path": "chap27/p@73210",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "FIRST SAILOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73382",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nThat’s your superstition.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73382/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
