      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72667",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SAILOR.\nWhat courage, sir? God save you!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72667/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72667/line-2",
          "start": 14,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4809609,
        "end": 4809685,
        "line": 179412,
        "column": 1,
        "path": "chap27/p@72667",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "FIRST SAILOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72747",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nCourage enough: I do not fear the flaw;\nIt hath done to me the worst. Yet, for the love\nOf this poor infant, this fresh new sea-farer,\nI would it would be quiet.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72747/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72747/line-2",
          "start": 10,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72747/line-3",
          "start": 50,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@72747/line-4",
          "start": 98,
          "end": 144,
          "sourceLineNumber": null
        },
        {
