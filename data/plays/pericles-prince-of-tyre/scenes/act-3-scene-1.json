          "start": 1,
          "end": 16
        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74501/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4811443,
        "end": 4811519,
        "line": 179480,
        "column": 1,
        "path": "chap27/p@74501",
