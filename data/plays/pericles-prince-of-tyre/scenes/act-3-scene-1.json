    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@71236",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LYCHORIDA.\nHere is a thing too young for such a place,\nWho, if it had conceit, would die, as I\nAm like to do: take in your arms this piece\nOf your dead queen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
