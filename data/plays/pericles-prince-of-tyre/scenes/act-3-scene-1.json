          "start": 10,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4810324,
        "end": 4810389,
        "line": 179441,
        "column": 1,
        "path": "chap27/p@73382",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "PERICLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73451",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SAILOR.\nPardon us, sir; with us at sea it has been still observed; and we are strong in custom. Therefore briefly yield her; for she must overboard straight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73451/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73451/line-2",
          "start": 14,
          "end": 163,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4810393,
        "end": 4810587,
        "line": 179446,
        "column": 1,
        "path": "chap27/p@73451",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "FIRST SAILOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73649",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nAs you think meet. Most wretched queen!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73649/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73649/line-2",
          "start": 10,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4810591,
        "end": 4810670,
        "line": 179452,
        "column": 1,
        "path": "chap27/p@73649",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "PERICLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73732",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LYCHORIDA.\nHere she lies, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73732/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73732/line-2",
          "start": 11,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4810674,
        "end": 4810734,
        "line": 179457,
        "column": 1,
        "path": "chap27/p@73732",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "LYCHORIDA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73796",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nA terrible childbed hast thou had, my dear;\nNo light, no fire: th’unfriendly elements\nForgot thee utterly; nor have I time\nTo give thee hallow’d to thy grave, but straight\nMust cast thee, scarcely coffin’d, in the ooze;\nWhere, for a monument upon thy bones,\nAnd e’er-remaining lamps, the belching whale\nAnd humming water must o’erwhelm thy corpse,\nLying with simple shells. O Lychorida.\nBid Nestor bring me spices, ink and paper,\nMy casket and my jewels; and bid Nicander\nBring me the satin coffer: lay the babe\nUpon the pillow: hie thee, whiles I say\nA priestly farewell to her: suddenly, woman.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@73796/line-1",
          "start": 0,
          "end": 9,
