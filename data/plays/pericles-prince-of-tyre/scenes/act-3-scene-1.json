    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74581",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SAILOR.\nSir, we have a chest beneath the hatches, caulked and bitumed ready.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74581/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74581/line-2",
          "start": 15,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4811523,
        "end": 4811636,
        "line": 179482,
        "column": 1,
        "path": "chap27/p@74581",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "SECOND SAILOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74698",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nI thank thee. Mariner, say what coast is this?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74698/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74698/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4811640,
        "end": 4811726,
        "line": 179487,
        "column": 1,
        "path": "chap27/p@74698",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "PERICLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74788",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SAILOR.\nWe are near Tarsus.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74788/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74788/line-2",
          "start": 15,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4811730,
        "end": 4811794,
        "line": 179492,
        "column": 1,
        "path": "chap27/p@74788",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "SECOND SAILOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74856",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nThither, gentle mariner,\nAlter thy course for Tyre. When canst thou reach it?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74856/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74856/line-2",
          "start": 10,
          "end": 34,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74856/line-3",
          "start": 35,
          "end": 87,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4811798,
        "end": 4811920,
        "line": 179497,
        "column": 1,
        "path": "chap27/p@74856",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "PERICLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74982",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SAILOR.\nBy break of day, if the wind cease.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74982/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@74982/line-2",
          "start": 15,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4811924,
        "end": 4812004,
        "line": 179503,
        "column": 1,
        "path": "chap27/p@74982",
        "anchor": "sceneIII_27.1"
      },
      "speakerLabel": "SECOND SAILOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.1/p@75066",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nO, make for Tarsus!\nThere will I visit Cleon, for the babe\nCannot hold out to Tyrus. There I’ll leave it\nAt careful nursing. Go thy ways, good mariner:\nI’ll bring the body presently.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.1/p@75066/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
