          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83200/line-3",
          "start": 53,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83200/line-4",
          "start": 100,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83200/line-5",
