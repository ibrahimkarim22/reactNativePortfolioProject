        }
      ],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83008/line-1",
          "start": 0,
          "end": 69,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4819950,
        "end": 4820138,
        "line": 179823,
        "column": 1,
        "path": "chap27/p@83008",
        "anchor": "sceneIII_27.3"
