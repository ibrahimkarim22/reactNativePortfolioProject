      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85164",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nMadam, my thanks and prayers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85164/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85164/line-2",
          "start": 10,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4822106,
        "end": 4822175,
        "line": 179894,
        "column": 1,
        "path": "chap27/p@85164",
        "anchor": "sceneIII_27.3"
      },
      "speakerLabel": "PERICLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85237",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEON.\nWe’ll bring your grace e’en to the edge o’the shore,\nThen give you up to the mask’d Neptune and\nThe gentlest winds of heaven.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85237/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85237/line-2",
          "start": 7,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85237/line-3",
          "start": 60,
          "end": 102,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85237/line-4",
          "start": 103,
          "end": 132,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4822179,
        "end": 4822351,
        "line": 179899,
        "column": 1,
        "path": "chap27/p@85237",
        "anchor": "sceneIII_27.3"
      },
      "speakerLabel": "CLEON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85413",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nI will embrace your offer. Come, dearest madam.\nO, no tears, Lychorida, no tears.\nLook to your little mistress, on whose grace\nYou may depend hereafter. Come, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85413/line-1",
