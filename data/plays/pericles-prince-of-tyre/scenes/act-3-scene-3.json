    {
      "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85031",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIONYZA.\nI have one myself,\nWho shall not be more dear to my respect\nThan yours, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85031/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85031/line-2",
          "start": 9,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85031/line-3",
          "start": 28,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@85031/line-4",
          "start": 69,
          "end": 89,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
