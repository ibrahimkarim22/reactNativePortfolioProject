          "end": 83,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@84206/line-4",
          "start": 84,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@84206/line-5",
          "start": 136,
          "end": 183,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@84206/line-6",
