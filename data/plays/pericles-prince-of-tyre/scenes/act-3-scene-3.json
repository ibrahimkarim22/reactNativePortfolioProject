        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.3/p@84655",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nI believe you;\nYour honour and your goodness teach me to’t,\nWithout your vows. Till she be married, madam,\nBy bright Diana, whom we honour, all\nUnscissored shall this hair of mine remain,\nThough I show ill in’t. So I take my leave.\nGood madam, make me blessed in your care\nIn bringing up my child.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@84655/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
