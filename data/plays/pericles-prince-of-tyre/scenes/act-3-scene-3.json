      "sourceRef": {
        "start": 4820715,
        "end": 4821144,
        "line": 179849,
        "column": 1,
        "path": "chap27/p@83773",
        "anchor": "sceneIII_27.3"
      },
      "speakerLabel": "PERICLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.3/p@84206",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEON.\nFear not, my lord, but think\nYour grace, that fed my country with your corn,\nFor which the people’s prayers still fall upon you,\nMust in your child be thought on. If neglection\nShould therein make me vile, the common body,\nBy you relieved, would force me to my duty:\nBut if to that my nature need a spur,\nThe gods revenge it upon me and mine,\nTo the end of generation!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@84206/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@84206/line-2",
          "start": 7,
          "end": 35,
          "sourceLineNumber": null
        },
        {
