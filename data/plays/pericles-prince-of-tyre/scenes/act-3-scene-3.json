    {
      "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83467",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEON.\nYour shafts of fortune, though they hurt you mortally,\nYet glance full wanderingly on us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83467/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83467/line-2",
          "start": 7,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83467/line-3",
          "start": 62,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4820409,
        "end": 4820540,
        "line": 179836,
        "column": 1,
        "path": "chap27/p@83467",
        "anchor": "sceneIII_27.3"
      },
      "speakerLabel": "CLEON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83602",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIONYZA.\nO, your sweet queen!\nThat the strict fates had pleased you had brought her hither,\nTo have bless’d mine eyes with her!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83602/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83602/line-2",
          "start": 9,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83602/line-3",
          "start": 30,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83602/line-4",
          "start": 92,
          "end": 127,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4820544,
        "end": 4820711,
        "line": 179842,
        "column": 1,
        "path": "chap27/p@83602",
        "anchor": "sceneIII_27.3"
      },
      "speakerLabel": "DIONYZA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83773",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nWe cannot but obey\nThe powers above us. Could I rage and roar\nAs doth the sea she lies in, yet the end\nMust be as ’tis. My gentle babe Marina,\nWhom, for she was born at sea, I have named so,\nHere I charge your charity withal,\nLeaving her the infant of your care;\nBeseeching you to give her princely training,\nThat she may be manner’d as she is born.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83773/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83773/line-2",
          "start": 10,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83773/line-3",
          "start": 29,
          "end": 71,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83773/line-4",
          "start": 72,
          "end": 112,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83773/line-5",
          "start": 113,
          "end": 152,
          "sourceLineNumber": null
        },
