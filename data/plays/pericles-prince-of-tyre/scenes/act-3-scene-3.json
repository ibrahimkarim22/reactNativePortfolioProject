        "status": "not-applicable"
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83200",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PERICLES.\nMost honour’d Cleon, I must needs be gone;\nMy twelve months are expired, and Tyrus stands\nIn a litigious peace. You and your lady,\nTake from my heart all thankfulness! The gods\nMake up the rest upon you!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.3/p@83200/line-1",
