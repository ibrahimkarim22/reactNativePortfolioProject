    {
      "id": "pericles-prince-of-tyre/sceneIII_27.4/p@86423",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CERIMON.\nMadam, if this you purpose as ye speak,\nDiana’s temple is not distant far,\nWhere you may abide till your date expire.\nMoreover, if you please, a niece of mine\nShall there attend you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
