        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIII_27.4/p@86065",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THAISA.\nIt is my lord’s.\nThat I was shipp’d at sea, I well remember,\nEven on my groaning time; but whether there\nDeliver’d, by the holy gods,\nI cannot rightly say. But since King Pericles,\nMy wedded lord, I ne’er shall see again,\nA vestal livery will I take me to,\nAnd never more have joy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.4/p@86065/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
