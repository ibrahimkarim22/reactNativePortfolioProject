    {
      "id": "pericles-prince-of-tyre/sceneIII_27.4/p@85888",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CERIMON.\nMadam, this letter, and some certain jewels,\nLay with you in your coffer, which are\nAt your command. Know you the character?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.4/p@85888/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.4/p@85888/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.4/p@85888/line-3",
          "start": 54,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIII_27.4/p@85888/line-4",
          "start": 93,
          "end": 133,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4822830,
        "end": 4823003,
        "line": 179920,
        "column": 1,
        "path": "chap27/p@85888",
        "anchor": "sceneIII_27.4"
      },
      "speakerLabel": "CERIMON.",
      "attribution": {
