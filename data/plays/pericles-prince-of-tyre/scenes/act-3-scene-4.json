    {
      "id": "pericles-prince-of-tyre/sceneIII_27.4/p@86668",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THAISA.\nMy recompense is thanks, that’s all;\nYet my good will is great, though the gift small.",
