    {
      "id": "pericles-prince-of-tyre/sceneIV_27.3/p@107343",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEON.\nHeavens forgive it!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.3/p@107343/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.3/p@107343/line-2",
          "start": 7,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4844285,
        "end": 4844341,
        "line": 180760,
        "column": 1,
        "path": "chap27/p@107343",
        "anchor": "sceneIV_27.3"
      },
      "speakerLabel": "CLEON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIV_27.3/p@107403",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIONYZA.\nAnd as for Pericles, what should he say?\nWe wept after her hearse, and yet we mourn.\nHer monument is almost finish’d, and her epitaphs\nIn glittering golden characters express\nA general praise to her, and care in us\nAt whose expense ’tis done.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.3/p@107403/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.3/p@107403/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
        },
        {
