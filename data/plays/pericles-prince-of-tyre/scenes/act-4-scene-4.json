    {
      "id": "pericles-prince-of-tyre/sceneIV_27.4/p@110890",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "No visor does become black villany\nSo well as soft and tender flattery.\nLet Pericles believe his daughter’s dead,\nAnd bear his courses to be ordered\nBy Lady Fortune; while our scene must play\nHis daughter’s woe and heavy well-a-day\nIn her unholy service. Patience, then,\nAnd think you now are all in Mytilene.",
      "separatorAfter": "\n\n",
