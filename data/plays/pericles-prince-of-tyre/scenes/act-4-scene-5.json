    {
      "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111495",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nDid you ever hear the like?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111495/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111495/line-2",
          "start": 17,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4848437,
        "end": 4848511,
        "line": 180875,
        "column": 1,
        "path": "chap27/p@111495",
        "anchor": "sceneIV_27.5"
      },
      "speakerLabel": "FIRST GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111573",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND GENTLEMAN.\nNo, nor never shall do in such a place as this, she being once gone.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111573/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111573/line-2",
          "start": 18,
          "end": 86,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4848515,
        "end": 4848631,
        "line": 180880,
        "column": 1,
        "path": "chap27/p@111573",
        "anchor": "sceneIV_27.5"
      },
      "speakerLabel": "SECOND GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 17
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111693",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nBut to have divinity preached there! did you ever dream of such a thing?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111693/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111693/line-2",
          "start": 17,
          "end": 89,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4848635,
        "end": 4848754,
        "line": 180885,
        "column": 1,
        "path": "chap27/p@111693",
        "anchor": "sceneIV_27.5"
      },
      "speakerLabel": "FIRST GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111816",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND GENTLEMAN.\nNo, no. Come, I am for no more bawdy houses: shall’s go hear the vestals sing?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111816/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111816/line-2",
          "start": 18,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4848758,
        "end": 4848885,
        "line": 180890,
        "column": 1,
        "path": "chap27/p@111816",
        "anchor": "sceneIV_27.5"
      },
      "speakerLabel": "SECOND GENTLEMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 17
      }
    },
    {
      "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111947",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST GENTLEMAN.\nI’ll do anything now that is virtuous; but I am out of the road of rutting for ever.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111947/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "pericles-prince-of-tyre/sceneIV_27.5/p@111947/line-2",
          "start": 17,
          "end": 101,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
