  },
  "content": [
    {
      "id": "pericles-prince-of-tyre-5-2-stage-001",
      "type": "stage",
      "text": "Enter Gower before the temple of Diana at Ephesus."
    },
    {
      "id": "pericles-prince-of-tyre-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "gower",
        "name": "GOWER",
        "displayName": "Gower"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Now our sands are almost run;",
          "plainText": "Now our sands are almost run",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "More a little, and then dumb.",
          "plainText": "More a little and then dumb",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "This, my last boon, give me,",
          "plainText": "This my last boon give me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "For such kindness must relieve me,",
          "plainText": "For such kindness must relieve me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "That you aptly will suppose",
          "plainText": "That you aptly will suppose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "What pageantry, what feats, what shows,",
          "plainText": "What pageantry what feats what shows",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "What minstrelsy, and pretty din,",
          "plainText": "What minstrelsy and pretty din",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "The regent made in Mytilene",
          "plainText": "The regent made in Mytilene",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "To greet the king. So he thrived,",
          "plainText": "To greet the king So he thrived",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "That he is promised to be wived",
          "plainText": "That he is promised to be wived",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "To fair Marina; but in no wise",
          "plainText": "To fair Marina but in no wise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "Till he had done his sacrifice,",
          "plainText": "Till he had done his sacrifice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "As Dian bade: whereto being bound,",
          "plainText": "As Dian bade whereto being bound",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "The interim, pray you, all confound.",
          "plainText": "The interim pray you all confound",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "In feather'd briefness sails are fill'd,",
          "plainText": "In feather'd briefness sails are fill'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "And wishes fall out as they're will'd.",
          "plainText": "And wishes fall out as they're will'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "At Ephesus, the temple see,",
          "plainText": "At Ephesus the temple see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Our king and all his company.",
          "plainText": "Our king and all his company",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "That he can hither come so soon,",
          "plainText": "That he can hither come so soon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-5-2-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "Is by your fancy's thankful doom.",
          "plainText": "Is by your fancy's thankful doom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-5-2-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}