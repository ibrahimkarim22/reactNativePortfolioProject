    {
      "id": "pericles-prince-of-tyre/sceneII_27.0/p@33578",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Dumb-show. Enter at one door Pericles talking with Cleon; all the train with them. Enter at another door a Gentleman with a letter to Pericles; Pericles shows the letter to Cleon; gives the Messenger a reward, and knights him. Exit Pericles at one door, and Cleon at another.",
      "separatorAfter": "\n\n",
      "spans": [
