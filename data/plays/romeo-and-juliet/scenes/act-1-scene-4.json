    {
      "id": "romeo-and-juliet/sceneI_30.4/p@40331",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENVOLIO.\nThis wind you talk of blows us from ourselves:\nSupper is done, and we shall come too late.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneI_30.4/p@40331/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneI_30.4/p@40331/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneI_30.4/p@40331/line-3",
          "start": 57,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5339331,
        "end": 5339466,
        "line": 198482,
        "column": 1,
        "path": "chap30/p@40331",
        "anchor": "sceneI_30.4"
      },
      "speakerLabel": "BENVOLIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "romeo-and-juliet/sceneI_30.4/p@40470",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nI fear too early: for my mind misgives\nSome consequence yet hanging in the stars,\nShall bitterly begin his fearful date\nWith this night’s revels; and expire the term\nOf a despised life, clos’d in my breast\nBy some vile forfeit of untimely death.\nBut he that hath the steerage of my course\nDirect my suit. On, lusty gentlemen!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
