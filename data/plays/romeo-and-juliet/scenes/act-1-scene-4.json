      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nPeace, peace, Mercutio, peace,\nThou talk’st of nothing.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
