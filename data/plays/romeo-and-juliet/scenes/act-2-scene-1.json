    "title": "SCENE I. An open place adjoining Capulet's Garden.",
    "location": "An open place adjoining Capulet's Garden.",
    "orderInPlay": 6
  },
  "content": [
    {
      "id": "romeo-and-juliet-2-1-stage-001",
      "type": "stage",
      "text": "Enter Romeo."
    },
    {
      "id": "romeo-and-juliet-2-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Can I go forward when my heart is here?",
          "plainText": "Can I go forward when my heart is here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Turn back, dull earth, and find thy centre out.",
          "plainText": "Turn back dull earth and find thy centre out",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-1-stage-002",
      "type": "stage",
      "text": "[He climbs the wall and leaps down within it.]"
    },
    {
      "id": "romeo-and-juliet-2-1-stage-003",
      "type": "stage",
      "text": "Enter Benvolio and Mercutio."
    },
    {
      "id": "romeo-and-juliet-2-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "benvolio",
        "name": "BENVOLIO",
        "displayName": "Benvolio"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Romeo! My cousin Romeo! Romeo!",
          "plainText": "Romeo My cousin Romeo Romeo",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "mercutio",
        "name": "MERCUTIO",
        "displayName": "Mercutio"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "He is wise,",
          "plainText": "He is wise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "And on my life hath stol'n him home to bed.",
          "plainText": "And on my life hath stol'n him home to bed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "benvolio",
        "name": "BENVOLIO",
        "displayName": "Benvolio"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "He ran this way, and leap'd this orchard wall:",
          "plainText": "He ran this way and leap'd this orchard wall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Call, good Mercutio.",
          "plainText": "Call good Mercutio",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "mercutio",
        "name": "MERCUTIO",
        "displayName": "Mercutio"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Nay, I'll conjure too.",
          "plainText": "Nay I'll conjure too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Romeo! Humours! Madman! Passion! Lover!",
          "plainText": "Romeo Humours Madman Passion Lover",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Appear thou in the likeness of a sigh,",
          "plainText": "Appear thou in the likeness of a sigh",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Speak but one rhyme, and I am satisfied;",
          "plainText": "Speak but one rhyme and I am satisfied",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "Cry but 'Ah me!' Pronounce but Love and dove;",
          "plainText": "Cry but 'Ah me' Pronounce but Love and dove",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "Speak to my gossip Venus one fair word,",
          "plainText": "Speak to my gossip Venus one fair word",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0014",
          "number": 14,
          "speechLineNumber": 7,
          "text": "One nickname for her purblind son and heir,",
          "plainText": "One nickname for her purblind son and heir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0015",
          "number": 15,
          "speechLineNumber": 8,
          "text": "Young Abraham Cupid, he that shot so trim",
          "plainText": "Young Abraham Cupid he that shot so trim",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0016",
          "number": 16,
          "speechLineNumber": 9,
          "text": "When King Cophetua lov'd the beggar-maid.",
          "plainText": "When King Cophetua lov'd the beggarmaid",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0017",
          "number": 17,
          "speechLineNumber": 10,
          "text": "He heareth not, he stirreth not, he moveth not;",
          "plainText": "He heareth not he stirreth not he moveth not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0018",
          "number": 18,
          "speechLineNumber": 11,
          "text": "The ape is dead, and I must conjure him.",
          "plainText": "The ape is dead and I must conjure him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0019",
          "number": 19,
          "speechLineNumber": 12,
          "text": "I conjure thee by Rosaline's bright eyes,",
          "plainText": "I conjure thee by Rosaline's bright eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0020",
          "number": 20,
          "speechLineNumber": 13,
          "text": "By her high forehead and her scarlet lip,",
          "plainText": "By her high forehead and her scarlet lip",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0021",
          "number": 21,
          "speechLineNumber": 14,
          "text": "By her fine foot, straight leg, and quivering thigh,",
          "plainText": "By her fine foot straight leg and quivering thigh",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0022",
          "number": 22,
          "speechLineNumber": 15,
          "text": "And the demesnes that there adjacent lie,",
          "plainText": "And the demesnes that there adjacent lie",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0023",
          "number": 23,
          "speechLineNumber": 16,
          "text": "That in thy likeness thou appear to us.",
          "plainText": "That in thy likeness thou appear to us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "benvolio",
        "name": "BENVOLIO",
        "displayName": "Benvolio"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "An if he hear thee, thou wilt anger him.",
          "plainText": "An if he hear thee thou wilt anger him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "mercutio",
        "name": "MERCUTIO",
        "displayName": "Mercutio"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "This cannot anger him. 'Twould anger him",
          "plainText": "This cannot anger him 'Twould anger him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "To raise a spirit in his mistress' circle,",
          "plainText": "To raise a spirit in his mistress' circle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "Of some strange nature, letting it there stand",
          "plainText": "Of some strange nature letting it there stand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "Till she had laid it, and conjur'd it down;",
          "plainText": "Till she had laid it and conjur'd it down",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "That were some spite. My invocation",
          "plainText": "That were some spite My invocation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "Is fair and honest, and, in his mistress' name,",
          "plainText": "Is fair and honest and in his mistress' name",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0031",
          "number": 31,
          "speechLineNumber": 7,
          "text": "I conjure only but to raise up him.",
          "plainText": "I conjure only but to raise up him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "benvolio",
        "name": "BENVOLIO",
        "displayName": "Benvolio"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Come, he hath hid himself among these trees",
          "plainText": "Come he hath hid himself among these trees",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "To be consorted with the humorous night.",
          "plainText": "To be consorted with the humorous night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "Blind is his love, and best befits the dark.",
          "plainText": "Blind is his love and best befits the dark",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "mercutio",
        "name": "MERCUTIO",
        "displayName": "Mercutio"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "If love be blind, love cannot hit the mark.",
          "plainText": "If love be blind love cannot hit the mark",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "Now will he sit under a medlar tree,",
          "plainText": "Now will he sit under a medlar tree",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "And wish his mistress were that kind of fruit",
          "plainText": "And wish his mistress were that kind of fruit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0038",
          "number": 38,
          "speechLineNumber": 4,
          "text": "As maids call medlars when they laugh alone.",
          "plainText": "As maids call medlars when they laugh alone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0039",
          "number": 39,
          "speechLineNumber": 5,
          "text": "O Romeo, that she were, O that she were",
          "plainText": "O Romeo that she were O that she were",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0040",
          "number": 40,
          "speechLineNumber": 6,
          "text": "An open-arse and thou a poperin pear!",
          "plainText": "An openarse and thou a poperin pear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0041",
          "number": 41,
          "speechLineNumber": 7,
          "text": "Romeo, good night. I'll to my truckle-bed.",
          "plainText": "Romeo good night I'll to my trucklebed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0042",
          "number": 42,
          "speechLineNumber": 8,
          "text": "This field-bed is too cold for me to sleep.",
          "plainText": "This fieldbed is too cold for me to sleep",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0043",
          "number": 43,
          "speechLineNumber": 9,
          "text": "Come, shall we go?",
          "plainText": "Come shall we go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "benvolio",
        "name": "BENVOLIO",
        "displayName": "Benvolio"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Go then; for 'tis in vain",
          "plainText": "Go then for 'tis in vain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-1-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "To seek him here that means not to be found.",
          "plainText": "To seek him here that means not to be found",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-1-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}