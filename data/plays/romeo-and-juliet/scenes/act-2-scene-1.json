    {
      "id": "romeo-and-juliet/sceneII_30.1/p@54038",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENVOLIO.\nGo then; for ’tis in vain\nTo seek him here that means not to be found.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
