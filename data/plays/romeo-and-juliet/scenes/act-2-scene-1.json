          "start": 10,
          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5350887,
        "end": 5350957,
        "line": 198936,
        "column": 1,
        "path": "chap30/p@51887",
        "anchor": "sceneII_30.1"
      },
      "speakerLabel": "BENVOLIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.1/p@51961",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MERCUTIO.\nHe is wise,\nAnd on my life hath stol’n him home to bed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.1/p@51961/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.1/p@51961/line-2",
          "start": 10,
          "end": 21,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.1/p@51961/line-3",
          "start": 22,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5350961,
        "end": 5351061,
        "line": 198941,
        "column": 1,
        "path": "chap30/p@51961",
        "anchor": "sceneII_30.1"
      },
      "speakerLabel": "MERCUTIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.1/p@52065",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BENVOLIO.\nHe ran this way, and leap’d this orchard wall:\nCall, good Mercutio.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.1/p@52065/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.1/p@52065/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.1/p@52065/line-3",
          "start": 57,
          "end": 77,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5351065,
        "end": 5351177,
        "line": 198947,
        "column": 1,
        "path": "chap30/p@52065",
        "anchor": "sceneII_30.1"
      },
      "speakerLabel": "BENVOLIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.1/p@52181",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MERCUTIO.\nNay, I’ll conjure too.\nRomeo! Humours! Madman! Passion! Lover!\nAppear thou in the likeness of a sigh,\nSpeak but one rhyme, and I am satisfied;\nCry but ‘Ah me!’ Pronounce but Love and dove;\nSpeak to my gossip Venus one fair word,\nOne nickname for her purblind son and heir,\nYoung Abraham Cupid, he that shot so trim\nWhen King Cophetua lov’d the beggar-maid.\nHe heareth not, he stirreth not, he moveth not;\nThe ape is dead, and I must conjure him.\nI conjure thee by Rosaline’s bright eyes,\nBy her high forehead and her scarlet lip,\nBy her fine foot, straight leg, and quivering thigh,\nAnd the demesnes that there adjacent lie,\nThat in thy likeness thou appear to us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.1/p@52181/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
