      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nNot in a grave\nTo lay one in, another out to have.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.3/p@70824/line-1",
