          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.3/p@69342/line-3",
          "start": 53,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.3/p@69342/line-4",
          "start": 91,
          "end": 131,
          "sourceLineNumber": null
