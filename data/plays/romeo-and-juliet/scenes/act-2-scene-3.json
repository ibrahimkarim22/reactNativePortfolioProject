      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nThat’s my good son. But where hast thou been then?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.3/p@68752/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.3/p@68752/line-2",
          "start": 16,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5367752,
        "end": 5367848,
        "line": 199544,
        "column": 1,
        "path": "chap30/p@68752",
        "anchor": "sceneII_30.3"
      },
      "speakerLabel": "FRIAR LAWRENCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.3/p@68852",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nI’ll tell thee ere thou ask it me again.\nI have been feasting with mine enemy,\nWhere on a sudden one hath wounded me\nThat’s by me wounded. Both our remedies\nWithin thy help and holy physic lies.\nI bear no hatred, blessed man; for lo,\nMy intercession likewise steads my foe.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.3/p@68852/line-1",
