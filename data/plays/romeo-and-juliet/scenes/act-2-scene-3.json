      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nGod pardon sin. Wast thou with Rosaline?",
      "separatorAfter": "\n\n",
      "spans": [],
