      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.3/p@70929",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nI pray thee chide me not, her I love now\nDoth grace for grace and love for love allow.\nThe other did not so.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
