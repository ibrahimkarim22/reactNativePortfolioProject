      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nFor doting, not for loving, pupil mine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
