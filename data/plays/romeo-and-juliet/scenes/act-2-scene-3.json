        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.3/p@71088",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nO, she knew well\nThy love did read by rote, that could not spell.\nBut come young waverer, come go with me,\nIn one respect I’ll thy assistant be;\nFor this alliance may so happy prove,\nTo turn your households’ rancour to pure love.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
