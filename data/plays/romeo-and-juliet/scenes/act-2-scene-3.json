      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nThou chidd’st me oft for loving Rosaline.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
