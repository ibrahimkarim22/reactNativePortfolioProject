      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nBe plain, good son, and homely in thy drift;\nRiddling confession finds but riddling shrift.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.3/p@69196/line-1",
