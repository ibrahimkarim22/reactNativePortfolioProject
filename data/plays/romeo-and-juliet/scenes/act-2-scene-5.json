    {
      "id": "romeo-and-juliet/sceneII_30.5/p@85795",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nNow, good sweet Nurse,—O Lord, why look’st thou sad?\nThough news be sad, yet tell them merrily;\nIf good, thou sham’st the music of sweet news\nBy playing it to me with so sour a face.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@85795/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@85795/line-2",
