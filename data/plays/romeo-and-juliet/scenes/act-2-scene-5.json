        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.5/p@87662",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nI’faith, I am sorry that thou art not well.\nSweet, sweet, sweet Nurse, tell me, what says my love?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87662/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87662/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87662/line-3",
          "start": 52,
          "end": 106,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5386662,
        "end": 5386803,
        "line": 200301,
        "column": 1,
        "path": "chap30/p@87662",
        "anchor": "sceneII_30.5"
      },
      "speakerLabel": "JULIET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.5/p@87807",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NURSE.\nYour love says like an honest gentleman,\nAnd a courteous, and a kind, and a handsome,\nAnd I warrant a virtuous,—Where is your mother?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87807/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87807/line-2",
          "start": 7,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87807/line-3",
          "start": 48,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87807/line-4",
          "start": 93,
          "end": 140,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5386807,
        "end": 5386987,
        "line": 200307,
        "column": 1,
        "path": "chap30/p@87807",
        "anchor": "sceneII_30.5"
      },
      "speakerLabel": "NURSE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.5/p@87991",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nWhere is my mother? Why, she is within.\nWhere should she be? How oddly thou repliest.\n‘Your love says, like an honest gentleman,\n‘Where is your mother?’",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87991/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87991/line-2",
          "start": 8,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87991/line-3",
          "start": 48,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87991/line-4",
          "start": 94,
          "end": 136,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@87991/line-5",
          "start": 137,
          "end": 160,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5386991,
        "end": 5387196,
        "line": 200314,
        "column": 1,
        "path": "chap30/p@87991",
