        "cueEnd": 7
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.5/p@88200",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NURSE.\nO God’s lady dear,\nAre you so hot? Marry, come up, I trow.\nIs this the poultice for my aching bones?\nHenceforward do your messages yourself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88200/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88200/line-2",
          "start": 7,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88200/line-3",
          "start": 26,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88200/line-4",
          "start": 66,
          "end": 107,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88200/line-5",
          "start": 108,
          "end": 147,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
