      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.5/p@88396",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nHere’s such a coil. Come, what says Romeo?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88396/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88396/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5387396,
        "end": 5387476,
        "line": 200330,
        "column": 1,
        "path": "chap30/p@88396",
        "anchor": "sceneII_30.5"
      },
      "speakerLabel": "JULIET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.5/p@88480",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NURSE.\nHave you got leave to go to shrift today?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88480/line-1",
