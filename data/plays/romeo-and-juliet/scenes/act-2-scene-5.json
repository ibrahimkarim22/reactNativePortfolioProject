        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.5/p@88562",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nI have.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88562/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88562/line-2",
          "start": 8,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5387562,
        "end": 5387607,
        "line": 200340,
        "column": 1,
        "path": "chap30/p@88562",
        "anchor": "sceneII_30.5"
      },
      "speakerLabel": "JULIET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.5/p@88611",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NURSE.\nThen hie you hence to Friar Lawrence’ cell;\nThere stays a husband to make you a wife.\nNow comes the wanton blood up in your cheeks,\nThey’ll be in scarlet straight at any news.\nHie you to church. I must another way,\nTo fetch a ladder by the which your love\nMust climb a bird’s nest soon when it is dark.\nI am the drudge, and toil in your delight;\nBut you shall bear the burden soon at night.\nGo. I’ll to dinner; hie you to the cell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.5/p@88611/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
