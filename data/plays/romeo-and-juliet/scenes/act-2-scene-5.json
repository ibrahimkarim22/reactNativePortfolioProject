    {
      "id": "romeo-and-juliet/sceneII_30.5/p@89128",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nHie to high fortune! Honest Nurse, farewell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
