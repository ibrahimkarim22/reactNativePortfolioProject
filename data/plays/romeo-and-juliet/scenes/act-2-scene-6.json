    {
      "id": "romeo-and-juliet/sceneII_30.6/p@89454",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nSo smile the heavens upon this holy act\nThat after-hours with sorrow chide us not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89454/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89454/line-2",
          "start": 16,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89454/line-3",
          "start": 56,
          "end": 98,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5388454,
        "end": 5388587,
        "line": 200371,
        "column": 1,
        "path": "chap30/p@89454",
        "anchor": "sceneII_30.6"
      },
      "speakerLabel": "FRIAR LAWRENCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.6/p@89591",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nAmen, amen, but come what sorrow can,\nIt cannot countervail the exchange of joy\nThat one short minute gives me in her sight.\nDo thou but close our hands with holy words,\nThen love-devouring death do what he dare,\nIt is enough I may but call her mine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89591/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89591/line-2",
          "start": 7,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89591/line-3",
          "start": 45,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89591/line-4",
          "start": 87,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89591/line-5",
          "start": 132,
          "end": 176,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89591/line-6",
          "start": 177,
          "end": 219,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89591/line-7",
          "start": 220,
          "end": 257,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5388591,
        "end": 5388903,
        "line": 200377,
        "column": 1,
        "path": "chap30/p@89591",
        "anchor": "sceneII_30.6"
      },
      "speakerLabel": "ROMEO.",
      "attribution": {
