    {
      "id": "romeo-and-juliet/sceneII_30.6/p@90365",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Here comes the lady. O, so light a foot\nWill ne’er wear out the everlasting flint.\nA lover may bestride the gossamers\nThat idles in the wanton summer air\nAnd yet not fall; so light is vanity.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90365/line-1",
          "start": 0,
          "end": 39,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90365/line-2",
          "start": 40,
          "end": 82,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90365/line-3",
          "start": 83,
          "end": 117,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90365/line-4",
          "start": 118,
          "end": 153,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90365/line-5",
          "start": 154,
          "end": 191,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5389365,
        "end": 5389601,
        "line": 200400,
        "column": 1,
        "path": "chap30/p@90365",
        "anchor": "sceneII_30.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.6/p@90605",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nGood even to my ghostly confessor.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90605/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90605/line-2",
          "start": 8,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5389605,
        "end": 5389677,
        "line": 200408,
        "column": 1,
        "path": "chap30/p@90605",
        "anchor": "sceneII_30.6"
      },
      "speakerLabel": "JULIET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.6/p@90681",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nRomeo shall thank thee, daughter, for us both.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90681/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90681/line-2",
          "start": 16,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5389681,
        "end": 5389773,
        "line": 200413,
        "column": 1,
        "path": "chap30/p@90681",
        "anchor": "sceneII_30.6"
      },
      "speakerLabel": "FRIAR LAWRENCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.6/p@90777",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nAs much to him, else is his thanks too much.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90777/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90777/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5389777,
        "end": 5389859,
        "line": 200418,
        "column": 1,
        "path": "chap30/p@90777",
        "anchor": "sceneII_30.6"
      },
      "speakerLabel": "JULIET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.6/p@90863",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nAh, Juliet, if the measure of thy joy\nBe heap’d like mine, and that thy skill be more\nTo blazon it, then sweeten with thy breath\nThis neighbour air, and let rich music’s tongue\nUnfold the imagin’d happiness that both\nReceive in either by this dear encounter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90863/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90863/line-2",
          "start": 7,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90863/line-3",
          "start": 45,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90863/line-4",
          "start": 93,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90863/line-5",
          "start": 136,
          "end": 183,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90863/line-6",
          "start": 184,
          "end": 223,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@90863/line-7",
          "start": 224,
          "end": 265,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5389863,
        "end": 5390183,
        "line": 200423,
        "column": 1,
        "path": "chap30/p@90863",
        "anchor": "sceneII_30.6"
      },
      "speakerLabel": "ROMEO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.6/p@91187",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nConceit more rich in matter than in words,\nBrags of his substance, not of ornament.\nThey are but beggars that can count their worth;\nBut my true love is grown to such excess,\nI cannot sum up sum of half my wealth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@91187/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@91187/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@91187/line-3",
          "start": 51,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@91187/line-4",
          "start": 92,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@91187/line-5",
          "start": 141,
          "end": 182,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@91187/line-6",
          "start": 183,
          "end": 221,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5390187,
        "end": 5390458,
        "line": 200433,
        "column": 1,
        "path": "chap30/p@91187",
        "anchor": "sceneII_30.6"
      },
      "speakerLabel": "JULIET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.6/p@91462",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nCome, come with me, and we will make short work,\nFor, by your leaves, you shall not stay alone\nTill holy church incorporate two in one.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@91462/line-1",
          "start": 0,
