        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneII_30.6/p@89907",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nThese violent delights have violent ends,\nAnd in their triumph die; like fire and powder,\nWhich as they kiss consume. The sweetest honey\nIs loathsome in his own deliciousness,\nAnd in the taste confounds the appetite.\nTherefore love moderately: long love doth so;\nToo swift arrives as tardy as too slow.\n",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89907/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneII_30.6/p@89907/line-2",
          "start": 16,
          "end": 57,
          "sourceLineNumber": null
        },
        {
