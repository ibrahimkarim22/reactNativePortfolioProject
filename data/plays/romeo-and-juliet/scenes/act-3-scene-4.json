  "scene": {
    "id": "romeo-and-juliet-3-4",
    "act": 3,
    "scene": 4,
    "label": "Act 3, Scene 4",
    "title": "SCENE IV. A Room in Capulet's House.",
    "location": "A Room in Capulet's House.",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "romeo-and-juliet-3-4-stage-001",
      "type": "stage",
      "text": "Enter Capulet, Lady Capulet and Paris."
    },
    {
      "id": "romeo-and-juliet-3-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-3-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Things have fallen out, sir, so unluckily",
          "plainText": "Things have fallen out sir so unluckily",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "That we have had no time to move our daughter.",
          "plainText": "That we have had no time to move our daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Look you, she lov'd her kinsman Tybalt dearly,",
          "plainText": "Look you she lov'd her kinsman Tybalt dearly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And so did I. Well, we were born to die.",
          "plainText": "And so did I Well we were born to die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "'Tis very late; she'll not come down tonight.",
          "plainText": "'Tis very late she'll not come down tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "I promise you, but for your company,",
          "plainText": "I promise you but for your company",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "I would have been abed an hour ago.",
          "plainText": "I would have been abed an hour ago",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-3-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-3-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "These times of woe afford no tune to woo.",
          "plainText": "These times of woe afford no tune to woo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Madam, good night. Commend me to your daughter.",
          "plainText": "Madam good night Commend me to your daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-3-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lady-capulet",
        "name": "LADY CAPULET",
        "displayName": "Lady Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-3-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "I will, and know her mind early tomorrow;",
          "plainText": "I will and know her mind early tomorrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "Tonight she's mew'd up to her heaviness.",
          "plainText": "Tonight she's mew'd up to her heaviness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-3-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-3-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Sir Paris, I will make a desperate tender",
          "plainText": "Sir Paris I will make a desperate tender",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Of my child's love. I think she will be rul'd",
          "plainText": "Of my child's love I think she will be rul'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "In all respects by me; nay more, I doubt it not.",
          "plainText": "In all respects by me nay more I doubt it not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "Wife, go you to her ere you go to bed,",
          "plainText": "Wife go you to her ere you go to bed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "Acquaint her here of my son Paris' love,",
          "plainText": "Acquaint her here of my son Paris' love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "And bid her, mark you me, on Wednesday next,",
          "plainText": "And bid her mark you me on Wednesday next",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0018",
          "number": 18,
          "speechLineNumber": 7,
          "text": "But, soft, what day is this?",
          "plainText": "But soft what day is this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-3-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-3-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Monday, my lord.",
          "plainText": "Monday my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-3-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-3-4-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Monday! Ha, ha! Well, Wednesday is too soon,",
          "plainText": "Monday Ha ha Well Wednesday is too soon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "A Thursday let it be; a Thursday, tell her,",
          "plainText": "A Thursday let it be a Thursday tell her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "She shall be married to this noble earl.",
          "plainText": "She shall be married to this noble earl",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Will you be ready? Do you like this haste?",
          "plainText": "Will you be ready Do you like this haste",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "We'll keep no great ado,—a friend or two,",
          "plainText": "We'll keep no great adoa friend or two",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0025",
          "number": 25,
          "speechLineNumber": 6,
          "text": "For, hark you, Tybalt being slain so late,",
          "plainText": "For hark you Tybalt being slain so late",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0026",
          "number": 26,
          "speechLineNumber": 7,
          "text": "It may be thought we held him carelessly,",
          "plainText": "It may be thought we held him carelessly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0027",
          "number": 27,
          "speechLineNumber": 8,
          "text": "Being our kinsman, if we revel much.",
          "plainText": "Being our kinsman if we revel much",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0028",
          "number": 28,
          "speechLineNumber": 9,
          "text": "Therefore we'll have some half a dozen friends,",
          "plainText": "Therefore we'll have some half a dozen friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0029",
          "number": 29,
          "speechLineNumber": 10,
          "text": "And there an end. But what say you to Thursday?",
          "plainText": "And there an end But what say you to Thursday",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-3-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-3-4-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "My lord, I would that Thursday were tomorrow.",
          "plainText": "My lord I would that Thursday were tomorrow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-3-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-3-4-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Well, get you gone. A Thursday be it then.",
          "plainText": "Well get you gone A Thursday be it then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Go you to Juliet ere you go to bed,",
          "plainText": "Go you to Juliet ere you go to bed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "Prepare her, wife, against this wedding day.",
          "plainText": "Prepare her wife against this wedding day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "Farewell, my lord.—Light to my chamber, ho!",
          "plainText": "Farewell my lordLight to my chamber ho",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0035",
          "number": 35,
          "speechLineNumber": 5,
          "text": "Afore me, it is so very very late that we",
          "plainText": "Afore me it is so very very late that we",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-3-4-line-0036",
          "number": 36,
          "speechLineNumber": 6,
          "text": "May call it early by and by. Good night.",
          "plainText": "May call it early by and by Good night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-3-4-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}