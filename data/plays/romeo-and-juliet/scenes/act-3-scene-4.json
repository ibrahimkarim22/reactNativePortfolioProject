          "start": 7,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5423868,
        "end": 5423950,
        "line": 201588,
        "column": 1,
        "path": "chap30/p@124868",
        "anchor": "sceneIII_30.4"
      },
      "speakerLabel": "PARIS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneIII_30.4/p@124954",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPULET.\nWell, get you gone. A Thursday be it then.\nGo you to Juliet ere you go to bed,\nPrepare her, wife, against this wedding day.\nFarewell, my lord.—Light to my chamber, ho!\nAfore me, it is so very very late that we\nMay call it early by and by. Good night.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
