    },
    {
      "id": "romeo-and-juliet/sceneIII_30.4/p@124868",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nMy lord, I would that Thursday were tomorrow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@124868/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
