    {
      "id": "romeo-and-juliet/sceneIII_30.4/p@123658",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nThese times of woe afford no tune to woo.\nMadam, good night. Commend me to your daughter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@123658/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@123658/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@123658/line-3",
          "start": 49,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5422658,
        "end": 5422789,
        "line": 201546,
        "column": 1,
        "path": "chap30/p@123658",
        "anchor": "sceneIII_30.4"
      },
      "speakerLabel": "PARIS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneIII_30.4/p@123793",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LADY CAPULET.\nI will, and know her mind early tomorrow;\nTonight she’s mew’d up to her heaviness.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@123793/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@123793/line-2",
          "start": 14,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@123793/line-3",
          "start": 56,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5422793,
        "end": 5422924,
        "line": 201552,
        "column": 1,
        "path": "chap30/p@123793",
        "anchor": "sceneIII_30.4"
      },
      "speakerLabel": "LADY CAPULET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "romeo-and-juliet/sceneIII_30.4/p@123928",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPULET.\nSir Paris, I will make a desperate tender\nOf my child’s love. I think she will be rul’d\nIn all respects by me; nay more, I doubt it not.\nWife, go you to her ere you go to bed,\nAcquaint her here of my son Paris’ love,\nAnd bid her, mark you me, on Wednesday next,\nBut, soft, what day is this?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@123928/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
