      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nMonday, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@124291/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@124291/line-2",
          "start": 7,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5423291,
        "end": 5423344,
        "line": 201569,
        "column": 1,
        "path": "chap30/p@124291",
        "anchor": "sceneIII_30.4"
      },
      "speakerLabel": "PARIS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneIII_30.4/p@124348",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPULET.\nMonday! Ha, ha! Well, Wednesday is too soon,\nA Thursday let it be; a Thursday, tell her,\nShe shall be married to this noble earl.\nWill you be ready? Do you like this haste?\nWe’ll keep no great ado,—a friend or two,\nFor, hark you, Tybalt being slain so late,\nIt may be thought we held him carelessly,\nBeing our kinsman, if we revel much.\nTherefore we’ll have some half a dozen friends,\nAnd there an end. But what say you to Thursday?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@124348/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@124348/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@124348/line-3",
          "start": 54,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIII_30.4/p@124348/line-4",
          "start": 98,
          "end": 138,
          "sourceLineNumber": null
        },
        {
