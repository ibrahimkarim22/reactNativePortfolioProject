      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nNurse, will you go with me into my closet,\nTo help me sort such needful ornaments\nAs you think fit to furnish me tomorrow?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
