    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@148255",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Sirrah, go hire me twenty cunning cooks.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148255/line-1",
          "start": 0,
          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5447255,
        "end": 5447318,
        "line": 202446,
        "column": 1,
        "path": "chap30/p@148255",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@148322",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SERVANT.\nYou shall have none ill, sir; for I’ll try if they can lick their fingers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148322/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148322/line-2",
          "start": 16,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5447322,
        "end": 5447441,
        "line": 202449,
        "column": 1,
        "path": "chap30/p@148322",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": "SECOND SERVANT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@148445",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPULET.\nHow canst thou try them so?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148445/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148445/line-2",
          "start": 9,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5447445,
        "end": 5447511,
        "line": 202454,
        "column": 1,
        "path": "chap30/p@148445",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": "CAPULET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@148515",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SERVANT.\nMarry, sir, ’tis an ill cook that cannot lick his own fingers; therefore he that cannot lick his fingers goes not with me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148515/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148515/line-2",
          "start": 16,
          "end": 138,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5447515,
        "end": 5447682,
        "line": 202459,
        "column": 1,
        "path": "chap30/p@148515",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": "SECOND SERVANT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@148686",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPULET.\nGo, begone.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148686/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148686/line-2",
          "start": 9,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
