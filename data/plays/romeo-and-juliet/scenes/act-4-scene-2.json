    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@148824",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "We shall be much unfurnish’d for this time.\nWhat, is my daughter gone to Friar Lawrence?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148824/line-1",
          "start": 0,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148824/line-2",
          "start": 44,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5447824,
        "end": 5447942,
        "line": 202471,
        "column": 1,
        "path": "chap30/p@148824",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@148946",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NURSE.\nAy, forsooth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148946/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@148946/line-2",
          "start": 7,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5447946,
        "end": 5447996,
        "line": 202476,
        "column": 1,
        "path": "chap30/p@148946",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": "NURSE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@149000",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPULET.\nWell, he may chance to do some good on her.\nA peevish self-will’d harlotry it is.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149000/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149000/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149000/line-3",
          "start": 53,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5448000,
        "end": 5448125,
        "line": 202481,
        "column": 1,
        "path": "chap30/p@149000",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": "CAPULET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@149129",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Juliet.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 12,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149129/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5448129,
        "end": 5448197,
        "line": 202487,
        "column": 1,
        "path": "chap30/p@149129",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@149201",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NURSE.\nSee where she comes from shrift with merry look.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149201/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149201/line-2",
          "start": 7,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5448201,
        "end": 5448286,
        "line": 202489,
        "column": 1,
        "path": "chap30/p@149201",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": "NURSE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@149290",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPULET.\nHow now, my headstrong. Where have you been gadding?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149290/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149290/line-2",
          "start": 9,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5448290,
        "end": 5448381,
        "line": 202494,
        "column": 1,
        "path": "chap30/p@149290",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": "CAPULET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@149385",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nWhere I have learnt me to repent the sin\nOf disobedient opposition\nTo you and your behests; and am enjoin’d\nBy holy Lawrence to fall prostrate here,\nTo beg your pardon. Pardon, I beseech you.\nHenceforward I am ever rul’d by you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149385/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149385/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149385/line-3",
          "start": 49,
          "end": 74,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149385/line-4",
          "start": 75,
          "end": 115,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149385/line-5",
          "start": 116,
          "end": 156,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149385/line-6",
          "start": 157,
          "end": 199,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149385/line-7",
          "start": 200,
          "end": 236,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5448385,
        "end": 5448676,
        "line": 202499,
        "column": 1,
        "path": "chap30/p@149385",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": "JULIET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@149680",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPULET.\nSend for the County, go tell him of this.\nI’ll have this knot knit up tomorrow morning.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149680/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149680/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149680/line-3",
          "start": 51,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5448680,
        "end": 5448811,
        "line": 202509,
        "column": 1,
        "path": "chap30/p@149680",
        "anchor": "sceneIV_30.2"
      },
      "speakerLabel": "CAPULET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.2/p@149815",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIET.\nI met the youthful lord at Lawrence’ cell,\nAnd gave him what becomed love I might,\nNot stepping o’er the bounds of modesty.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149815/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149815/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.2/p@149815/line-3",
          "start": 51,
          "end": 90,
          "sourceLineNumber": null
        },
