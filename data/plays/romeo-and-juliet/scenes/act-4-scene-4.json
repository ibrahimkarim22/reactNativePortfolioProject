    {
      "id": "romeo-and-juliet/sceneIV_30.4/p@155282",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPULET.\nCome, stir, stir, stir! The second cock hath crow’d,\nThe curfew bell hath rung, ’tis three o’clock.\nLook to the bak’d meats, good Angelica;\nSpare not for cost.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155282/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155282/line-2",
          "start": 9,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155282/line-3",
          "start": 62,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155282/line-4",
          "start": 109,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155282/line-5",
          "start": 149,
          "end": 168,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5454282,
        "end": 5454495,
        "line": 202685,
        "column": 1,
        "path": "chap30/p@155282",
        "anchor": "sceneIV_30.4"
      },
      "speakerLabel": "CAPULET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.4/p@155499",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NURSE.\nGo, you cot-quean, go,\nGet you to bed; faith, you’ll be sick tomorrow\nFor this night’s watching.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155499/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155499/line-2",
          "start": 7,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155499/line-3",
          "start": 30,
          "end": 76,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155499/line-4",
          "start": 77,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5454499,
        "end": 5454642,
        "line": 202693,
        "column": 1,
        "path": "chap30/p@155499",
        "anchor": "sceneIV_30.4"
      },
      "speakerLabel": "NURSE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.4/p@155646",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPULET.\nNo, not a whit. What! I have watch’d ere now\nAll night for lesser cause, and ne’er been sick.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155646/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155646/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@155646/line-3",
          "start": 54,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5454646,
        "end": 5454783,
        "line": 202700,
        "column": 1,
        "path": "chap30/p@155646",
        "anchor": "sceneIV_30.4"
      },
      "speakerLabel": "CAPULET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.4/p@155787",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LADY CAPULET.\nAy, you have been a mouse-hunt in your time;\nBut I will watch you from such watching now.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
