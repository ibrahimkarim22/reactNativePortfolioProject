    {
      "id": "romeo-and-juliet/sceneIV_30.4/p@156532",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "—Sirrah, fetch drier logs.\nCall Peter, he will show thee where they are.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@156532/line-1",
