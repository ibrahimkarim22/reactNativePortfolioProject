        "column": 1,
        "path": "chap30/p@156233",
        "anchor": "sceneIV_30.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "romeo-and-juliet/sceneIV_30.4/p@156288",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SERVANT.\nThings for the cook, sir; but I know not what.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@156288/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneIV_30.4/p@156288/line-2",
          "start": 15,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
