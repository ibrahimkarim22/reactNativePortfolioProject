    },
    {
      "id": "romeo-and-juliet/sceneV_30.1/p@170500",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "APOTHECARY.\nSuch mortal drugs I have, but Mantua’s law\nIs death to any he that utters them.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170500/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170500/line-2",
          "start": 12,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170500/line-3",
          "start": 55,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5469500,
        "end": 5469626,
        "line": 203254,
        "column": 1,
        "path": "chap30/p@170500",
        "anchor": "sceneV_30.1"
      },
      "speakerLabel": "APOTHECARY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "romeo-and-juliet/sceneV_30.1/p@170630",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nArt thou so bare and full of wretchedness,\nAnd fear’st to die? Famine is in thy cheeks,\nNeed and oppression starveth in thine eyes,\nContempt and beggary hangs upon thy back.\nThe world is not thy friend, nor the world’s law;\nThe world affords no law to make thee rich;\nThen be not poor, but break it and take this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170630/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170630/line-2",
          "start": 7,
          "end": 49,
          "sourceLineNumber": null
        },
        {
