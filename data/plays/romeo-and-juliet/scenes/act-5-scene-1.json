    {
      "id": "romeo-and-juliet/sceneV_30.1/p@167458",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "News from Verona! How now, Balthasar?\nDost thou not bring me letters from the Friar?\nHow doth my lady? Is my father well?\nHow fares my Juliet? That I ask again;\nFor nothing can be ill if she be well.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@167458/line-1",
