      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "APOTHECARY.\nMy poverty, but not my will consents.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@171014/line-1",
