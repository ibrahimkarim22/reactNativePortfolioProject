    {
      "id": "romeo-and-juliet/sceneV_30.1/p@170023",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "APOTHECARY.\nWho calls so loud?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170023/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170023/line-2",
          "start": 12,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5469023,
        "end": 5469083,
        "line": 203237,
        "column": 1,
        "path": "chap30/p@170023",
        "anchor": "sceneV_30.1"
      },
      "speakerLabel": "APOTHECARY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "romeo-and-juliet/sceneV_30.1/p@170087",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nCome hither, man. I see that thou art poor.\nHold, there is forty ducats. Let me have\nA dram of poison, such soon-speeding gear\nAs will disperse itself through all the veins,\nThat the life-weary taker may fall dead,\nAnd that the trunk may be discharg’d of breath\nAs violently as hasty powder fir’d\nDoth hurry from the fatal cannon’s womb.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170087/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170087/line-2",
          "start": 7,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170087/line-3",
          "start": 51,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170087/line-4",
          "start": 92,
          "end": 133,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@170087/line-5",
          "start": 134,
          "end": 180,
          "sourceLineNumber": null
        },
        {
