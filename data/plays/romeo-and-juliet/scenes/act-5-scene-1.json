      }
    },
    {
      "id": "romeo-and-juliet/sceneV_30.1/p@171097",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nI pay thy poverty, and not thy will.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@171097/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@171097/line-2",
          "start": 7,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5470097,
        "end": 5470170,
        "line": 203276,
        "column": 1,
        "path": "chap30/p@171097",
        "anchor": "sceneV_30.1"
      },
      "speakerLabel": "ROMEO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "romeo-and-juliet/sceneV_30.1/p@171174",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "APOTHECARY.\nPut this in any liquid thing you will\nAnd drink it off; and, if you had the strength\nOf twenty men, it would despatch you straight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@171174/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@171174/line-2",
          "start": 12,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@171174/line-3",
          "start": 50,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@171174/line-4",
          "start": 97,
          "end": 143,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5470174,
        "end": 5470357,
        "line": 203281,
        "column": 1,
        "path": "chap30/p@171174",
        "anchor": "sceneV_30.1"
      },
      "speakerLabel": "APOTHECARY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "romeo-and-juliet/sceneV_30.1/p@171361",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROMEO.\nThere is thy gold, worse poison to men’s souls,\nDoing more murder in this loathsome world\nThan these poor compounds that thou mayst not sell.\nI sell thee poison, thou hast sold me none.\nFarewell, buy food, and get thyself in flesh.\nCome, cordial and not poison, go with me\nTo Juliet’s grave, for there must I use thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.1/p@171361/line-1",
          "start": 0,
