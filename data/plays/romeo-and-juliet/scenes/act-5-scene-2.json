        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "romeo-and-juliet/sceneV_30.2/p@173245",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR JOHN.\nBrother, I’ll go and bring it thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@173245/line-1",
