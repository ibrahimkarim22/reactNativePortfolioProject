    {
      "id": "romeo-and-juliet/sceneV_30.2/p@172105",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nThis same should be the voice of Friar John.\nWelcome from Mantua. What says Romeo?\nOr, if his mind be writ, give me his letter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172105/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172105/line-2",
          "start": 16,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172105/line-3",
          "start": 61,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172105/line-4",
          "start": 99,
          "end": 143,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5471105,
        "end": 5471288,
        "line": 203312,
        "column": 1,
        "path": "chap30/p@172105",
        "anchor": "sceneV_30.2"
      },
      "speakerLabel": "FRIAR LAWRENCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "romeo-and-juliet/sceneV_30.2/p@172292",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR JOHN.\nGoing to find a barefoot brother out,\nOne of our order, to associate me,\nHere in this city visiting the sick,\nAnd finding him, the searchers of the town,\nSuspecting that we both were in a house\nWhere the infectious pestilence did reign,\nSeal’d up the doors, and would not let us forth,\nSo that my speed to Mantua there was stay’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172292/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172292/line-2",
          "start": 12,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172292/line-3",
          "start": 50,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172292/line-4",
          "start": 85,
          "end": 121,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172292/line-5",
          "start": 122,
          "end": 165,
          "sourceLineNumber": null
        },
        {
