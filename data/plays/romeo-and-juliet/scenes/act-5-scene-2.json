    {
      "id": "romeo-and-juliet/sceneV_30.2/p@172703",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nWho bare my letter then to Romeo?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172703/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172703/line-2",
          "start": 16,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5471703,
        "end": 5471782,
        "line": 203331,
        "column": 1,
        "path": "chap30/p@172703",
        "anchor": "sceneV_30.2"
      },
      "speakerLabel": "FRIAR LAWRENCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "romeo-and-juliet/sceneV_30.2/p@172786",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR JOHN.\nI could not send it,—here it is again,—\nNor get a messenger to bring it thee,\nSo fearful were they of infection.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172786/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172786/line-2",
          "start": 12,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172786/line-3",
          "start": 52,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172786/line-4",
          "start": 90,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5471786,
        "end": 5471950,
        "line": 203336,
        "column": 1,
        "path": "chap30/p@172786",
        "anchor": "sceneV_30.2"
      },
      "speakerLabel": "FRIAR JOHN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "romeo-and-juliet/sceneV_30.2/p@172954",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nUnhappy fortune! By my brotherhood,\nThe letter was not nice, but full of charge,\nOf dear import, and the neglecting it\nMay do much danger. Friar John, go hence,\nGet me an iron crow and bring it straight\nUnto my cell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172954/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172954/line-2",
          "start": 16,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172954/line-3",
          "start": 52,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172954/line-4",
          "start": 97,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172954/line-5",
          "start": 135,
          "end": 176,
          "sourceLineNumber": null
        },
        {
          "id": "romeo-and-juliet/sceneV_30.2/p@172954/line-6",
