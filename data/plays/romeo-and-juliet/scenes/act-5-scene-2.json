    {
      "id": "romeo-and-juliet/sceneV_30.2/p@173365",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FRIAR LAWRENCE.\nNow must I to the monument alone.\nWithin this three hours will fair Juliet wake.\nShe will beshrew me much that Romeo\nHath had no notice of these accidents;\nBut I will write again to Mantua,\nAnd keep her at my cell till Romeo come.\nPoor living corse, clos’d in a dead man’s tomb.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
