    "label": "Act 1, Scene 3",
    "title": "SCENE III. London. Before the Tower.",
    "location": "London. Before the Tower.",
    "orderInPlay": 3
  },
  "content": [
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-stage-001",
      "type": "stage",
      "text": "Enter the Duke of Gloucester with his Servingmen in blue coats."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I am come to survey the Tower this day.",
          "plainText": "I am come to survey the Tower this day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Since Henry's death, I fear, there is conveyance.",
          "plainText": "Since Henry's death I fear there is conveyance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Where be these warders that they wait not here?",
          "plainText": "Where be these warders that they wait not here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Open the gates; 'tis Gloucester that calls.",
          "plainText": "Open the gates 'tis Gloucester that calls",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "first-warder",
        "name": "FIRST WARDER",
        "displayName": "First Warder"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "[Within.] Who's there that knocks so imperiously?",
          "plainText": "Within Who's there that knocks so imperiously",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-servingman",
        "name": "FIRST SERVINGMAN",
        "displayName": "First Servingman"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "It is the noble Duke of Gloucester.",
          "plainText": "It is the noble Duke of Gloucester",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-warder",
        "name": "SECOND WARDER",
        "displayName": "Second Warder"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "[Within.] Whoe'er he be, you may not be let in.",
          "plainText": "Within Whoe'er he be you may not be let in",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "first-servingman",
        "name": "FIRST SERVINGMAN",
        "displayName": "First Servingman"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Villains, answer you so the Lord Protector?",
          "plainText": "Villains answer you so the Lord Protector",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "first-warder",
        "name": "FIRST WARDER",
        "displayName": "First Warder"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "[Within.] The Lord protect him, so we answer him.",
          "plainText": "Within The Lord protect him so we answer him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "We do no otherwise than we are will'd.",
          "plainText": "We do no otherwise than we are will'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Who willed you? Or whose will stands but mine?",
          "plainText": "Who willed you Or whose will stands but mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "There's none Protector of the realm but I.",
          "plainText": "There's none Protector of the realm but I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Break up the gates, I'll be your warrantize.",
          "plainText": "Break up the gates I'll be your warrantize",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "Shall I be flouted thus by dunghill grooms?",
          "plainText": "Shall I be flouted thus by dunghill grooms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-stage-002",
      "type": "stage",
      "text": "[Gloucester's men rush at the Tower gates, and Woodville, the Lieutenant, speaks within.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "woodville",
        "name": "WOODVILLE",
        "displayName": "Woodville"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "What noise is this? What traitors have we here?",
          "plainText": "What noise is this What traitors have we here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Lieutenant, is it you whose voice I hear?",
          "plainText": "Lieutenant is it you whose voice I hear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Open the gates; here's Gloucester that would enter.",
          "plainText": "Open the gates here's Gloucester that would enter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "woodville",
        "name": "WOODVILLE",
        "displayName": "Woodville"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Have patience, noble Duke; I may not open;",
          "plainText": "Have patience noble Duke I may not open",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "The Cardinal of Winchester forbids.",
          "plainText": "The Cardinal of Winchester forbids",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "From him I have express commandment",
          "plainText": "From him I have express commandment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "That thou nor none of thine shall be let in.",
          "plainText": "That thou nor none of thine shall be let in",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Faint-hearted Woodville, prizest him 'fore me?",
          "plainText": "Fainthearted Woodville prizest him 'fore me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Arrogant Winchester, that haughty prelate",
          "plainText": "Arrogant Winchester that haughty prelate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "Whom Henry, our late sovereign, ne'er could brook?",
          "plainText": "Whom Henry our late sovereign ne'er could brook",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Thou art no friend to God or to the King.",
          "plainText": "Thou art no friend to God or to the King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "Open the gates, or I'll shut thee out shortly.",
          "plainText": "Open the gates or I'll shut thee out shortly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "servingmen",
        "name": "SERVINGMEN",
        "displayName": "Servingmen"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Open the gates unto the Lord Protector,",
          "plainText": "Open the gates unto the Lord Protector",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Or we'll burst them open, if that you come not quickly.",
          "plainText": "Or we'll burst them open if that you come not quickly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-stage-003",
      "type": "stage",
      "text": "Enter to the Protector at the Tower gates Winchester and his men in tawny coats."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "winchester",
        "name": "WINCHESTER",
        "displayName": "Winchester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "How now, ambitious Humphrey! What means this?",
          "plainText": "How now ambitious Humphrey What means this",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Peel'd priest, dost thou command me to be shut out?",
          "plainText": "Peel'd priest dost thou command me to be shut out",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "winchester",
        "name": "WINCHESTER",
        "displayName": "Winchester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "I do, thou most usurping proditor,",
          "plainText": "I do thou most usurping proditor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "And not Protector, of the King or realm.",
          "plainText": "And not Protector of the King or realm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Stand back, thou manifest conspirator,",
          "plainText": "Stand back thou manifest conspirator",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Thou that contrived'st to murder our dead lord;",
          "plainText": "Thou that contrived'st to murder our dead lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Thou that giv'st whores indulgences to sin:",
          "plainText": "Thou that giv'st whores indulgences to sin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "I'll canvass thee in thy broad cardinal's hat,",
          "plainText": "I'll canvass thee in thy broad cardinal's hat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0037",
          "number": 37,
          "speechLineNumber": 5,
          "text": "If thou proceed in this thy insolence.",
          "plainText": "If thou proceed in this thy insolence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "winchester",
        "name": "WINCHESTER",
        "displayName": "Winchester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Nay, stand thou back; I will not budge a foot.",
          "plainText": "Nay stand thou back I will not budge a foot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "This be Damascus, be thou cursed Cain,",
          "plainText": "This be Damascus be thou cursed Cain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "To slay thy brother Abel, if thou wilt.",
          "plainText": "To slay thy brother Abel if thou wilt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "I will not slay thee, but I'll drive thee back.",
          "plainText": "I will not slay thee but I'll drive thee back",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Thy scarlet robes, as a child's bearing-cloth,",
          "plainText": "Thy scarlet robes as a child's bearingcloth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "I'll use to carry thee out of this place.",
          "plainText": "I'll use to carry thee out of this place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "winchester",
        "name": "WINCHESTER",
        "displayName": "Winchester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Do what thou dar'st, I beard thee to thy face.",
          "plainText": "Do what thou dar'st I beard thee to thy face",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "What, am I dared and bearded to my face?",
          "plainText": "What am I dared and bearded to my face",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "Draw, men, for all this privileged place.",
          "plainText": "Draw men for all this privileged place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "Blue coats to tawny coats. Priest, beware your beard;",
          "plainText": "Blue coats to tawny coats Priest beware your beard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "I mean to tug it and to cuff you soundly.",
          "plainText": "I mean to tug it and to cuff you soundly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0049",
          "number": 49,
          "speechLineNumber": 5,
          "text": "Under my feet I'll stamp thy cardinal's hat;",
          "plainText": "Under my feet I'll stamp thy cardinal's hat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0050",
          "number": 50,
          "speechLineNumber": 6,
          "text": "In spite of Pope or dignities of church,",
          "plainText": "In spite of Pope or dignities of church",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0051",
          "number": 51,
          "speechLineNumber": 7,
          "text": "Here by the cheeks I'll drag thee up and down.",
          "plainText": "Here by the cheeks I'll drag thee up and down",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "winchester",
        "name": "WINCHESTER",
        "displayName": "Winchester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Gloucester, thou wilt answer this before the Pope.",
          "plainText": "Gloucester thou wilt answer this before the Pope",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Winchester goose, I cry, \"a rope, a rope!\"",
          "plainText": "Winchester goose I cry a rope a rope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "Now beat them hence; why do you let them stay?",
          "plainText": "Now beat them hence why do you let them stay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0055",
          "number": 55,
          "speechLineNumber": 3,
          "text": "Thee I'll chase hence, thou wolf in sheep's array.",
          "plainText": "Thee I'll chase hence thou wolf in sheep's array",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0056",
          "number": 56,
          "speechLineNumber": 4,
          "text": "Out, tawny coats! Out, scarlet hypocrite!",
          "plainText": "Out tawny coats Out scarlet hypocrite",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-stage-004",
      "type": "stage",
      "text": "Here Gloucester's men beat out the Cardinal's men, and enter in the hurly-burly the Mayor of London and his Officers."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "mayor",
        "name": "MAYOR",
        "displayName": "Mayor"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Fie, lords, that you, being supreme magistrates,",
          "plainText": "Fie lords that you being supreme magistrates",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "Thus contumeliously should break the peace!",
          "plainText": "Thus contumeliously should break the peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Peace, Mayor! Thou know'st little of my wrongs.",
          "plainText": "Peace Mayor Thou know'st little of my wrongs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "Here's Beaufort, that regards nor God nor king,",
          "plainText": "Here's Beaufort that regards nor God nor king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "Hath here distrain'd the Tower to his use.",
          "plainText": "Hath here distrain'd the Tower to his use",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "winchester",
        "name": "WINCHESTER",
        "displayName": "Winchester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Here's Gloucester, a foe to citizens,",
          "plainText": "Here's Gloucester a foe to citizens",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "One that still motions war and never peace,",
          "plainText": "One that still motions war and never peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "O'ercharging your free purses with large fines;",
          "plainText": "O'ercharging your free purses with large fines",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "That seeks to overthrow religion,",
          "plainText": "That seeks to overthrow religion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0066",
          "number": 66,
          "speechLineNumber": 5,
          "text": "Because he is Protector of the realm,",
          "plainText": "Because he is Protector of the realm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0067",
          "number": 67,
          "speechLineNumber": 6,
          "text": "And would have armour here out of the Tower,",
          "plainText": "And would have armour here out of the Tower",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0068",
          "number": 68,
          "speechLineNumber": 7,
          "text": "To crown himself king and suppress the Prince.",
          "plainText": "To crown himself king and suppress the Prince",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "I will not answer thee with words, but blows.",
          "plainText": "I will not answer thee with words but blows",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-stage-005",
      "type": "stage",
      "text": "[Here they skirmish again.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "mayor",
        "name": "MAYOR",
        "displayName": "Mayor"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Nought rests for me in this tumultuous strife",
          "plainText": "Nought rests for me in this tumultuous strife",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "But to make open proclamation.",
          "plainText": "But to make open proclamation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0072",
          "number": 72,
          "speechLineNumber": 3,
          "text": "Come, officer, as loud as e'er thou canst, cry.",
          "plainText": "Come officer as loud as e'er thou canst cry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "officer",
        "name": "OFFICER",
        "displayName": "Officer"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "All manner of men assembled here in arms this day against God's peace and the King's, we charge and command you, in his Highness' name, to repair to your several dwelling-places; and not to wear, handle, or use any sword, weapon, or dagger, henceforward, upon pain of death.",
          "plainText": "All manner of men assembled here in arms this day against God's peace and the King's we charge and command you in his Highness' name to repair to your several dwellingplaces and not to wear handle or use any sword weapon or dagger henceforward upon pain of death",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Cardinal, I'll be no breaker of the law;",
          "plainText": "Cardinal I'll be no breaker of the law",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "But we shall meet and break our minds at large.",
          "plainText": "But we shall meet and break our minds at large",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "winchester",
        "name": "WINCHESTER",
        "displayName": "Winchester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Gloucester, we will meet, to thy cost, be sure;",
          "plainText": "Gloucester we will meet to thy cost be sure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0077",
          "number": 77,
          "speechLineNumber": 2,
          "text": "Thy heart-blood I will have for this day's work.",
          "plainText": "Thy heartblood I will have for this day's work",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-031",
      "type": "speech",
      "speaker": {
        "id": "mayor",
        "name": "MAYOR",
        "displayName": "Mayor"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "I'll call for clubs, if you will not away.",
          "plainText": "I'll call for clubs if you will not away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0079",
          "number": 79,
          "speechLineNumber": 2,
          "text": "This Cardinal's more haughty than the devil.",
          "plainText": "This Cardinal's more haughty than the devil",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-032",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "Mayor, farewell. Thou dost but what thou mayst.",
          "plainText": "Mayor farewell Thou dost but what thou mayst",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-033",
      "type": "speech",
      "speaker": {
        "id": "winchester",
        "name": "WINCHESTER",
        "displayName": "Winchester"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "Abominable Gloucester, guard thy head,",
          "plainText": "Abominable Gloucester guard thy head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0082",
          "number": 82,
          "speechLineNumber": 2,
          "text": "For I intend to have it ere long.",
          "plainText": "For I intend to have it ere long",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-stage-006",
      "type": "stage",
      "text": "[Exeunt, severally, Gloucester and Winchester with their Servingmen.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-3-speech-034",
      "type": "speech",
      "speaker": {
        "id": "mayor",
        "name": "MAYOR",
        "displayName": "Mayor"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "See the coast clear'd, and then we will depart.",
          "plainText": "See the coast clear'd and then we will depart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-3-line-0084",
