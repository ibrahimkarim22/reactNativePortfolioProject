  "scene": {
    "id": "the-first-part-of-henry-the-sixth-1-5",
    "act": 1,
    "scene": 5,
    "label": "Act 1, Scene 5",
    "title": "SCENE V. Before Orleans.",
    "location": "Before Orleans.",
    "orderInPlay": 5
  },
  "content": [
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-stage-001",
      "type": "stage",
      "text": "Here an alarum again, and Talbot pursueth the Dauphin and driveth him; then enter Joan la Pucelle, driving Englishmen before her, and exit after them. Then re-enter Talbot."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Where is my strength, my valour, and my force?",
          "plainText": "Where is my strength my valour and my force",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Our English troops retire, I cannot stay them.",
          "plainText": "Our English troops retire I cannot stay them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "A woman clad in armour chaseth them.",
          "plainText": "A woman clad in armour chaseth them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-stage-002",
      "type": "stage",
      "text": "Enter La Pucelle."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Come, come, 'tis only I that must disgrace thee.",
          "plainText": "Come come 'tis only I that must disgrace thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-stage-003",
      "type": "stage",
      "text": "[Here they fight.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Heavens, can you suffer hell so to prevail?",
          "plainText": "Heavens can you suffer hell so to prevail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "My breast I'll burst with straining of my courage,",
          "plainText": "My breast I'll burst with straining of my courage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "And from my shoulders crack my arms asunder,",
          "plainText": "And from my shoulders crack my arms asunder",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "But I will chastise this high-minded strumpet.",
          "plainText": "But I will chastise this highminded strumpet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-stage-004",
      "type": "stage",
      "text": "[They fight again.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Talbot, farewell; thy hour is not yet come.",
          "plainText": "Talbot farewell thy hour is not yet come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "I must go victual Orleans forthwith.",
          "plainText": "I must go victual Orleans forthwith",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-stage-005",
      "type": "stage",
      "text": "[A short alarum. Then enter the town with soldiers.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "My thoughts are whirled like a potter's wheel;",
          "plainText": "My thoughts are whirled like a potter's wheel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "I know not where I am, nor what I do.",
          "plainText": "I know not where I am nor what I do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "A witch by fear, not force, like Hannibal,",
          "plainText": "A witch by fear not force like Hannibal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "Drives back our troops and conquers as she lists.",
          "plainText": "Drives back our troops and conquers as she lists",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "So bees with smoke and doves with noisome stench",
          "plainText": "So bees with smoke and doves with noisome stench",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0016",
          "number": 16,
          "speechLineNumber": 6,
          "text": "Are from their hives and houses driven away.",
          "plainText": "Are from their hives and houses driven away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0017",
          "number": 17,
          "speechLineNumber": 7,
          "text": "They call'd us for our fierceness, English dogs;",
          "plainText": "They call'd us for our fierceness English dogs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-1-5-line-0018",
          "number": 18,
          "speechLineNumber": 8,
          "text": "Now like to whelps we crying run away.",
          "plainText": "Now like to whelps we crying run away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-stage-007",
      "type": "stage",
      "text": "[A short alarum.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-stage-008",
      "type": "stage",
      "text": "[Alarum. Here another skirmish.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-1-5-stage-009",
      "type": "stage",
      "text": "[Exit Talbot. Alarum; retreat.]"
    }
  ]
}