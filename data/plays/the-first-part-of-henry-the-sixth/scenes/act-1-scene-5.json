    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@39638",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nWhere is my strength, my valour, and my force?\nOur English troops retire, I cannot stay them.\nA woman clad in armour chaseth them.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@39638/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@39638/line-2",
          "start": 8,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@39638/line-3",
          "start": 55,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@39638/line-4",
          "start": 102,
          "end": 138,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
