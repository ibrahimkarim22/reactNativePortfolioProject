          "start": 0,
          "end": 18,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2125904,
        "end": 2125950,
        "line": 78121,
        "column": 1,
        "path": "chap12/p@40217",
        "anchor": "sceneI_12.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40267",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nHeavens, can you suffer hell so to prevail?\nMy breast I’ll burst with straining of my courage,\nAnd from my shoulders crack my arms asunder,\nBut I will chastise this high-minded strumpet.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40267/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40267/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40267/line-3",
          "start": 52,
          "end": 102,
          "sourceLineNumber": null
        },
        {
