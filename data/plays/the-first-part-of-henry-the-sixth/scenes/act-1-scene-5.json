      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[They fight again.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 18
        }
      ],
      "lines": [
        {
