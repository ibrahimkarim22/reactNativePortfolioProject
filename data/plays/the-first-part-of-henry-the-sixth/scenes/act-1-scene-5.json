    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@41510",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Hark, countrymen, either renew the fight,\nOr tear the lions out of England’s coat;\nRenounce your soil, give sheep in lions’ stead.\nSheep run not half so treacherous from the wolf,\nOr horse or oxen from the leopard,\nAs you fly from your oft-subdued slaves.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@41510/line-1",
          "start": 0,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@41510/line-2",
          "start": 42,
          "end": 82,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@41510/line-3",
          "start": 83,
          "end": 130,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@41510/line-4",
