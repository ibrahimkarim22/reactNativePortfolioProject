      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 6
        }
      ],
      "lines": [
