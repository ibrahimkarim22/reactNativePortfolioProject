        "path": "chap12/p@39820",
        "anchor": "sceneI_12.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@39896",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Here, here she comes. I’ll have a bout with thee;\nDevil or devil’s dam, I’ll conjure thee.\nBlood will I draw on thee, thou art a witch,\nAnd straightway give thy soul to him thou serv’st.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@39896/line-1",
          "start": 0,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@39896/line-2",
          "start": 50,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@39896/line-3",
          "start": 91,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@39896/line-4",
          "start": 136,
          "end": 186,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2125583,
        "end": 2125809,
        "line": 78109,
        "column": 1,
        "path": "chap12/p@39896",
        "anchor": "sceneI_12.5"
      },
      "speakerLabel": null,
