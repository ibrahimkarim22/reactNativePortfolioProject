      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Here they fight.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 17
        }
      ],
      "lines": [
        {
