      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40126",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nCome, come, ’tis only I that must disgrace thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40126/line-1",
