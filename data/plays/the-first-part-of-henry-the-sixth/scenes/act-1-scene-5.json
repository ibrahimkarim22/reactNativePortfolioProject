    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40561",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nTalbot, farewell; thy hour is not yet come.\nI must go victual Orleans forthwith.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40561/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40561/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40561/line-3",
          "start": 53,
          "end": 89,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2126248,
        "end": 2126372,
        "line": 78133,
        "column": 1,
        "path": "chap12/p@40561",
        "anchor": "sceneI_12.5"
      },
      "speakerLabel": "PUCELLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40689",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[A short alarum. Then enter the town with soldiers.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 51
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40689/line-1",
          "start": 0,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2126376,
        "end": 2126456,
        "line": 78139,
        "column": 1,
        "path": "chap12/p@40689",
        "anchor": "sceneI_12.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40773",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "O’ertake me, if thou canst. I scorn thy strength.\nGo, go, cheer up thy hungry-starved men;\nHelp Salisbury to make his testament.\nThis day is ours, as many more shall be.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40773/line-1",
          "start": 0,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40773/line-2",
          "start": 50,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40773/line-3",
          "start": 91,
          "end": 128,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.5/p@40773/line-4",
          "start": 129,
          "end": 169,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2126460,
        "end": 2126669,
        "line": 78141,
        "column": 1,
        "path": "chap12/p@40773",
        "anchor": "sceneI_12.5"
      },
      "speakerLabel": null,
      "attribution": {
