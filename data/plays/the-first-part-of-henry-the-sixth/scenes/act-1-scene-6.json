    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@43302",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALENÇON.\nAll France will be replete with mirth and joy\nWhen they shall hear how we have play’d the men.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@43302/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@43302/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@43302/line-3",
          "start": 55,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2128989,
        "end": 2129127,
        "line": 78218,
        "column": 1,
        "path": "chap12/p@43302",
        "anchor": "sceneI_12.6"
      },
      "speakerLabel": "ALENÇON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@43444",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\n’Tis Joan, not we, by whom the day is won;\nFor which I will divide my crown with her,\nAnd all the priests and friars in my realm\nShall in procession sing her endless praise.\nA statelier pyramis to her I’ll rear\nThan Rhodope’s of Memphis ever was;\nIn memory of her when she is dead,\nHer ashes, in an urn more precious\nThan the rich-jewel’d coffer of Darius,\nTransported shall be at high festivals\nBefore the kings and queens of France.\nNo longer on Saint Denis will we cry,\nBut Joan la Pucelle shall be France’s saint.\nCome in, and let us banquet royally\nAfter this golden day of victory.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
