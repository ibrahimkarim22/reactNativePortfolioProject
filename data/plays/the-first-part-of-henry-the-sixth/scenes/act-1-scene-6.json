    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@42528",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nAdvance our waving colours on the walls;\nRescued is Orleans from the English.\nThus Joan la Pucelle hath perform’d her word.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@42528/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@42528/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@42528/line-3",
          "start": 50,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@42528/line-4",
          "start": 87,
          "end": 132,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2128215,
        "end": 2128387,
        "line": 78192,
        "column": 1,
        "path": "chap12/p@42528",
