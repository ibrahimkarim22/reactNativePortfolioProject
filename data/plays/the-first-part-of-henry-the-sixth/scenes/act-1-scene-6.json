    {
      "id": "the-first-part-of-henry-the-sixth/sceneI_12.6/p@43067",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "REIGNIER.\nWhy ring not bells aloud throughout the town?\nDauphin, command the citizens make bonfires\nAnd feast and banquet in the open streets\nTo celebrate the joy that God hath given us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
