  "scene": {
    "id": "the-first-part-of-henry-the-sixth-2-1",
    "act": 2,
    "scene": 1,
    "label": "Act 2, Scene 1",
    "title": "SCENE I. Before Orleans.",
    "location": "Before Orleans.",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-stage-001",
      "type": "stage",
      "text": "Enter a Sergeant of a band, with two Sentinels."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "sergeant",
        "name": "SERGEANT",
        "displayName": "Sergeant"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Sirs, take your places and be vigilant.",
          "plainText": "Sirs take your places and be vigilant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "If any noise or soldier you perceive",
          "plainText": "If any noise or soldier you perceive",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Near to the walls, by some apparent sign",
          "plainText": "Near to the walls by some apparent sign",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Let us have knowledge at the court of guard.",
          "plainText": "Let us have knowledge at the court of guard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "first-sentinel",
        "name": "FIRST SENTINEL",
        "displayName": "First Sentinel"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Sergeant, you shall.",
          "plainText": "Sergeant you shall",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-stage-002",
      "type": "stage",
      "text": "[Exit Sergeant.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-stage-003",
      "type": "stage",
      "text": "Enter Talbot, Bedford, Burgundy, and forces, with scaling-ladders."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Lord Regent, and redoubted Burgundy,",
          "plainText": "Lord Regent and redoubted Burgundy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "By whose approach the regions of Artois,",
          "plainText": "By whose approach the regions of Artois",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "Walloon and Picardy are friends to us,",
          "plainText": "Walloon and Picardy are friends to us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "This happy night the Frenchmen are secure,",
          "plainText": "This happy night the Frenchmen are secure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "Having all day caroused and banqueted.",
          "plainText": "Having all day caroused and banqueted",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0011",
          "number": 11,
          "speechLineNumber": 6,
          "text": "Embrace we then this opportunity,",
          "plainText": "Embrace we then this opportunity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0012",
          "number": 12,
          "speechLineNumber": 7,
          "text": "As fitting best to quittance their deceit",
          "plainText": "As fitting best to quittance their deceit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0013",
          "number": 13,
          "speechLineNumber": 8,
          "text": "Contriv'd by art and baleful sorcery.",
          "plainText": "Contriv'd by art and baleful sorcery",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "bedford",
        "name": "BEDFORD",
        "displayName": "Bedford"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Coward of France, how much he wrongs his fame,",
          "plainText": "Coward of France how much he wrongs his fame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Despairing of his own arm's fortitude,",
          "plainText": "Despairing of his own arm's fortitude",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "To join with witches and the help of hell!",
          "plainText": "To join with witches and the help of hell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Traitors have never other company.",
          "plainText": "Traitors have never other company",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "But what's that Pucelle whom they term so pure?",
          "plainText": "But what's that Pucelle whom they term so pure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "A maid, they say.",
          "plainText": "A maid they say",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "bedford",
        "name": "BEDFORD",
        "displayName": "Bedford"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "A maid! And be so martial!",
          "plainText": "A maid And be so martial",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Pray God she prove not masculine ere long,",
          "plainText": "Pray God she prove not masculine ere long",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "If underneath the standard of the French",
          "plainText": "If underneath the standard of the French",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "She carry armour as she hath begun.",
          "plainText": "She carry armour as she hath begun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Well, let them practice and converse with spirits.",
          "plainText": "Well let them practice and converse with spirits",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "God is our fortress, in whose conquering name",
          "plainText": "God is our fortress in whose conquering name",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "Let us resolve to scale their flinty bulwarks.",
          "plainText": "Let us resolve to scale their flinty bulwarks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "bedford",
        "name": "BEDFORD",
        "displayName": "Bedford"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Ascend, brave Talbot; we will follow thee.",
          "plainText": "Ascend brave Talbot we will follow thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Not all together. Better far, I guess,",
          "plainText": "Not all together Better far I guess",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "That we do make our entrance several ways,",
          "plainText": "That we do make our entrance several ways",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "That if it chance the one of us do fail,",
          "plainText": "That if it chance the one of us do fail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0031",
          "number": 31,
          "speechLineNumber": 4,
          "text": "The other yet may rise against their force.",
          "plainText": "The other yet may rise against their force",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "bedford",
        "name": "BEDFORD",
        "displayName": "Bedford"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Agreed. I'll to yond corner.",
          "plainText": "Agreed I'll to yond corner",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "And I to this.",
          "plainText": "And I to this",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "And here will Talbot mount, or make his grave.",
          "plainText": "And here will Talbot mount or make his grave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Now, Salisbury, for thee, and for the right",
          "plainText": "Now Salisbury for thee and for the right",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Of English Henry, shall this night appear",
          "plainText": "Of English Henry shall this night appear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "How much in duty I am bound to both.",
          "plainText": "How much in duty I am bound to both",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "sentinel",
        "name": "SENTINEL",
        "displayName": "Sentinel"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Arm! Arm! The enemy doth make assault!",
          "plainText": "Arm Arm The enemy doth make assault",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-stage-004",
      "type": "stage",
      "text": "[Cry: \"St George,\" \"A Talbot!\"]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-stage-005",
      "type": "stage",
      "text": "The French leap over the walls in their shirts. Enter several ways the Bastard of Orleans, Alençon and Reignier, half ready and half unready."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Unready! Ay, and glad we 'scap'd so well.",
          "plainText": "Unready Ay and glad we 'scap'd so well",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "reignier",
        "name": "REIGNIER",
        "displayName": "Reignier"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "'Twas time, I trow, to wake and leave our beds,",
          "plainText": "'Twas time I trow to wake and leave our beds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Hearing alarums at our chamber-doors.",
          "plainText": "Hearing alarums at our chamberdoors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "I think this Talbot be a fiend of hell.",
          "plainText": "I think this Talbot be a fiend of hell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "reignier",
        "name": "REIGNIER",
        "displayName": "Reignier"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "If not of hell, the heavens, sure, favour him.",
          "plainText": "If not of hell the heavens sure favour him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-stage-006",
      "type": "stage",
      "text": "Enter Charles and La Pucelle."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Tut, holy Joan was his defensive guard.",
          "plainText": "Tut holy Joan was his defensive guard",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Is this thy cunning, thou deceitful dame?",
          "plainText": "Is this thy cunning thou deceitful dame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "Didst thou at first, to flatter us withal,",
          "plainText": "Didst thou at first to flatter us withal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "Make us partakers of a little gain,",
          "plainText": "Make us partakers of a little gain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "That now our loss might be ten times so much?",
          "plainText": "That now our loss might be ten times so much",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Wherefore is Charles impatient with his friend?",
          "plainText": "Wherefore is Charles impatient with his friend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "At all times will you have my power alike?",
          "plainText": "At all times will you have my power alike",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "Sleeping or waking, must I still prevail,",
          "plainText": "Sleeping or waking must I still prevail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "Or will you blame and lay the fault on me?",
          "plainText": "Or will you blame and lay the fault on me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0053",
          "number": 53,
          "speechLineNumber": 5,
          "text": "Improvident soldiers, had your watch been good,",
          "plainText": "Improvident soldiers had your watch been good",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0054",
          "number": 54,
          "speechLineNumber": 6,
          "text": "This sudden mischief never could have fall'n.",
          "plainText": "This sudden mischief never could have fall'n",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Duke of Alençon, this was your default,",
          "plainText": "Duke of Alenon this was your default",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "That, being captain of the watch tonight,",
          "plainText": "That being captain of the watch tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "Did look no better to that weighty charge.",
          "plainText": "Did look no better to that weighty charge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Mine was secure.",
          "plainText": "Mine was secure",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "reignier",
        "name": "REIGNIER",
        "displayName": "Reignier"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "And so was mine, my lord.",
          "plainText": "And so was mine my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "And for myself, most part of all this night,",
          "plainText": "And for myself most part of all this night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "Within her quarter and mine own precinct",
          "plainText": "Within her quarter and mine own precinct",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0062",
          "number": 62,
          "speechLineNumber": 3,
          "text": "I was employ'd in passing to and fro",
          "plainText": "I was employ'd in passing to and fro",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0063",
          "number": 63,
          "speechLineNumber": 4,
          "text": "About relieving of the sentinels.",
          "plainText": "About relieving of the sentinels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0064",
          "number": 64,
          "speechLineNumber": 5,
          "text": "Then how or which way should they first break in?",
          "plainText": "Then how or which way should they first break in",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Question, my lords, no further of the case,",
          "plainText": "Question my lords no further of the case",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "How or which way; 'tis sure they found some place",
          "plainText": "How or which way 'tis sure they found some place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0067",
          "number": 67,
          "speechLineNumber": 3,
          "text": "But weakly guarded, where the breach was made.",
          "plainText": "But weakly guarded where the breach was made",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0068",
          "number": 68,
          "speechLineNumber": 4,
          "text": "And now there rests no other shift but this:",
          "plainText": "And now there rests no other shift but this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0069",
          "number": 69,
          "speechLineNumber": 5,
          "text": "To gather our soldiers, scattered and dispersed,",
          "plainText": "To gather our soldiers scattered and dispersed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0070",
          "number": 70,
          "speechLineNumber": 6,
          "text": "And lay new platforms to endamage them.",
          "plainText": "And lay new platforms to endamage them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-stage-007",
      "type": "stage",
      "text": "Alarum. Enter an English Soldier, crying \"A Talbot! A Talbot!\" They fly, leaving their clothes behind."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "I'll be so bold to take what they have left.",
          "plainText": "I'll be so bold to take what they have left",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "The cry of \"Talbot\" serves me for a sword;",
          "plainText": "The cry of Talbot serves me for a sword",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "For I have loaden me with many spoils,",
          "plainText": "For I have loaden me with many spoils",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-1-line-0074",
          "number": 74,
          "speechLineNumber": 4,
          "text": "Using no other weapon but his name.",
          "plainText": "Using no other weapon but his name",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-1-stage-008",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}