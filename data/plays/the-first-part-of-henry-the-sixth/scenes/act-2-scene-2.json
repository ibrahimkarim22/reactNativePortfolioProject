      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53919",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nWell then, alone, since there’s no remedy,\nI mean to prove this lady’s courtesy.\nCome hither, Captain. [Whispers.] You perceive my mind?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
