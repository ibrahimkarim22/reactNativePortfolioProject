      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@51868",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEDFORD.\n’Tis thought, Lord Talbot, when the fight began,\nRous’d on the sudden from their drowsy beds,\nThey did amongst the troops of armed men\nLeap o’er the walls for refuge in the field.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@51868/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
