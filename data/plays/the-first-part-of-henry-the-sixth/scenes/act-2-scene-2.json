    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53202",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BURGUNDY.\nIs it even so? Nay, then I see our wars\nWill turn unto a peaceful comic sport,\nWhen ladies crave to be encounter’d with.\nYou may not, my lord, despise her gentle suit.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53202/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53202/line-2",
          "start": 10,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53202/line-3",
          "start": 50,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53202/line-4",
          "start": 89,
          "end": 130,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53202/line-5",
          "start": 131,
          "end": 177,
          "sourceLineNumber": null
        }
      ],
