          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53428/line-3",
          "start": 53,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53428/line-4",
          "start": 95,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53428/line-5",
          "start": 135,
          "end": 180,
          "sourceLineNumber": null
        },
