        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53428",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nNe’er trust me then; for when a world of men\nCould not prevail with all their oratory,\nYet hath a woman’s kindness over-ruled.\nAnd therefore tell her I return great thanks,\nAnd in submission will attend on her.\nWill not your honours bear me company?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53428/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
