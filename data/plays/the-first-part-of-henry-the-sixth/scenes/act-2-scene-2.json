          "start": 129,
          "end": 163,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2137348,
        "end": 2137551,
        "line": 78532,
        "column": 1,
        "path": "chap12/p@51661",
        "anchor": "sceneII_12.2"
      },
      "speakerLabel": null,
