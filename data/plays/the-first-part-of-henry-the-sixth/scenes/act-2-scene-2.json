      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nBring forth the body of old Salisbury,\nAnd here advance it in the market-place,\nThe middle centre of this cursed town.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
