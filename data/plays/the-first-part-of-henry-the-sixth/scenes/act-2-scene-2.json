    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@53744",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEDFORD.\nNo, truly, it is more than manners will;\nAnd I have heard it said, unbidden guests\nAre often welcomest when they are gone.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
