    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@50573",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BEDFORD.\nThe day begins to break, and night is fled,\nWhose pitchy mantle over-veil’d the earth.\nHere sound retreat and cease our hot pursuit.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
