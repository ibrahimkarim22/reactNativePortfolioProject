    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@51661",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "But, lords, in all our bloody massacre,\nI muse we met not with the Dauphin’s grace,\nHis new-come champion, virtuous Joan of Arc,\nNor any of his false confederates.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.2/p@51661/line-1",
          "start": 0,
          "end": 39,
          "sourceLineNumber": null
        },
        {
