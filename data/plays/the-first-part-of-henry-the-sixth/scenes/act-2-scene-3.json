          "start": 10,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2143150,
        "end": 2143216,
        "line": 78750,
        "column": 1,
        "path": "chap12/p@57463",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57533",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nI am indeed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57533/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
