    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56691",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nTo me, blood-thirsty lord;\nAnd for that cause I train’d thee to my house.\nLong time thy shadow hath been thrall to me,\nFor in my gallery thy picture hangs.\nBut now the substance shall endure the like,\nAnd I will chain these legs and arms of thine,\nThat hast by tyranny these many years\nWasted our country, slain our citizens,\nAnd sent our sons and husbands captivate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56691/line-1",
