  "scene": {
    "id": "the-first-part-of-henry-the-sixth-2-3",
    "act": 2,
    "scene": 3,
    "label": "Act 2, Scene 3",
    "title": "SCENE III. Auvergne. The Countess's castle.",
    "location": "Auvergne. The Countess's castle.",
    "orderInPlay": 9
  },
  "content": [
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-stage-001",
      "type": "stage",
      "text": "Enter the Countess and her Porter."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Porter, remember what I gave in charge;",
          "plainText": "Porter remember what I gave in charge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And when you have done so, bring the keys to me.",
          "plainText": "And when you have done so bring the keys to me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "porter",
        "name": "PORTER",
        "displayName": "Porter"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Madam, I will.",
          "plainText": "Madam I will",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "The plot is laid. If all things fall out right,",
          "plainText": "The plot is laid If all things fall out right",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "I shall as famous be by this exploit",
          "plainText": "I shall as famous be by this exploit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "As Scythian Tomyris by Cyrus' death.",
          "plainText": "As Scythian Tomyris by Cyrus' death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "Great is the rumour of this dreadful knight,",
          "plainText": "Great is the rumour of this dreadful knight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "And his achievements of no less account.",
          "plainText": "And his achievements of no less account",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 6,
          "text": "Fain would mine eyes be witness with mine ears,",
          "plainText": "Fain would mine eyes be witness with mine ears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 7,
          "text": "To give their censure of these rare reports.",
          "plainText": "To give their censure of these rare reports",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-stage-003",
      "type": "stage",
      "text": "Enter Messenger and Talbot."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Madam, according as your ladyship desired,",
          "plainText": "Madam according as your ladyship desired",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "By message craved, so is Lord Talbot come.",
          "plainText": "By message craved so is Lord Talbot come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "And he is welcome. What, is this the man?",
          "plainText": "And he is welcome What is this the man",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Madam, it is.",
          "plainText": "Madam it is",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Is this the scourge of France?",
          "plainText": "Is this the scourge of France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Is this the Talbot, so much fear'd abroad",
          "plainText": "Is this the Talbot so much fear'd abroad",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "That with his name the mothers still their babes?",
          "plainText": "That with his name the mothers still their babes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "I see report is fabulous and false.",
          "plainText": "I see report is fabulous and false",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 5,
          "text": "I thought I should have seen some Hercules,",
          "plainText": "I thought I should have seen some Hercules",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 6,
          "text": "A second Hector, for his grim aspect,",
          "plainText": "A second Hector for his grim aspect",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 7,
          "text": "And large proportion of his strong-knit limbs.",
          "plainText": "And large proportion of his strongknit limbs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 8,
          "text": "Alas, this is a child, a silly dwarf!",
          "plainText": "Alas this is a child a silly dwarf",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 9,
          "text": "It cannot be this weak and writhled shrimp",
          "plainText": "It cannot be this weak and writhled shrimp",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 10,
          "text": "Should strike such terror to his enemies.",
          "plainText": "Should strike such terror to his enemies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Madam, I have been bold to trouble you;",
          "plainText": "Madam I have been bold to trouble you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "But since your ladyship is not at leisure,",
          "plainText": "But since your ladyship is not at leisure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "I'll sort some other time to visit you.",
          "plainText": "I'll sort some other time to visit you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "What means he now? Go ask him whither he goes.",
          "plainText": "What means he now Go ask him whither he goes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Stay, my Lord Talbot, for my lady craves",
          "plainText": "Stay my Lord Talbot for my lady craves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "To know the cause of your abrupt departure.",
          "plainText": "To know the cause of your abrupt departure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Marry, for that she's in a wrong belief,",
          "plainText": "Marry for that she's in a wrong belief",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "I go to certify her Talbot's here.",
          "plainText": "I go to certify her Talbot's here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-stage-004",
      "type": "stage",
      "text": "Enter Porter with keys."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "If thou be he, then art thou prisoner.",
          "plainText": "If thou be he then art thou prisoner",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Prisoner! To whom?",
          "plainText": "Prisoner To whom",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "To me, blood-thirsty lord;",
          "plainText": "To me bloodthirsty lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "And for that cause I train'd thee to my house.",
          "plainText": "And for that cause I train'd thee to my house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "Long time thy shadow hath been thrall to me,",
          "plainText": "Long time thy shadow hath been thrall to me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0038",
          "number": 38,
          "speechLineNumber": 4,
          "text": "For in my gallery thy picture hangs.",
          "plainText": "For in my gallery thy picture hangs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0039",
          "number": 39,
          "speechLineNumber": 5,
          "text": "But now the substance shall endure the like,",
          "plainText": "But now the substance shall endure the like",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0040",
          "number": 40,
          "speechLineNumber": 6,
          "text": "And I will chain these legs and arms of thine,",
          "plainText": "And I will chain these legs and arms of thine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0041",
          "number": 41,
          "speechLineNumber": 7,
          "text": "That hast by tyranny these many years",
          "plainText": "That hast by tyranny these many years",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0042",
          "number": 42,
          "speechLineNumber": 8,
          "text": "Wasted our country, slain our citizens,",
          "plainText": "Wasted our country slain our citizens",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0043",
          "number": 43,
          "speechLineNumber": 9,
          "text": "And sent our sons and husbands captivate.",
          "plainText": "And sent our sons and husbands captivate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Ha, ha, ha!",
          "plainText": "Ha ha ha",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Laughest thou, wretch? Thy mirth shall turn to moan.",
          "plainText": "Laughest thou wretch Thy mirth shall turn to moan",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "I laugh to see your ladyship so fond",
          "plainText": "I laugh to see your ladyship so fond",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "To think that you have aught but Talbot's shadow",
          "plainText": "To think that you have aught but Talbot's shadow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "Whereon to practice your severity.",
          "plainText": "Whereon to practice your severity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Why, art not thou the man?",
          "plainText": "Why art not thou the man",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "I am indeed.",
          "plainText": "I am indeed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Then have I substance too.",
          "plainText": "Then have I substance too",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "No, no, I am but shadow of myself.",
          "plainText": "No no I am but shadow of myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "You are deceived, my substance is not here;",
          "plainText": "You are deceived my substance is not here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "For what you see is but the smallest part",
          "plainText": "For what you see is but the smallest part",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0055",
          "number": 55,
          "speechLineNumber": 4,
          "text": "And least proportion of humanity.",
          "plainText": "And least proportion of humanity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0056",
          "number": 56,
          "speechLineNumber": 5,
          "text": "I tell you, madam, were the whole frame here,",
          "plainText": "I tell you madam were the whole frame here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0057",
          "number": 57,
          "speechLineNumber": 6,
          "text": "It is of such a spacious lofty pitch",
          "plainText": "It is of such a spacious lofty pitch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0058",
          "number": 58,
          "speechLineNumber": 7,
          "text": "Your roof were not sufficient to contain 't.",
          "plainText": "Your roof were not sufficient to contain 't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "This is a riddling merchant for the nonce;",
          "plainText": "This is a riddling merchant for the nonce",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "He will be here, and yet he is not here.",
          "plainText": "He will be here and yet he is not here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "How can these contrarieties agree?",
          "plainText": "How can these contrarieties agree",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "That will I show you presently.",
          "plainText": "That will I show you presently",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-stage-005",
      "type": "stage",
      "text": "Winds his horn. Drums strike up; a peal of ordnance. Enter Soldiers."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Victorious Talbot, pardon my abuse.",
          "plainText": "Victorious Talbot pardon my abuse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "I find thou art no less than fame hath bruited,",
          "plainText": "I find thou art no less than fame hath bruited",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "And more than may be gather'd by thy shape.",
          "plainText": "And more than may be gather'd by thy shape",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "Let my presumption not provoke thy wrath,",
          "plainText": "Let my presumption not provoke thy wrath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0067",
          "number": 67,
          "speechLineNumber": 5,
          "text": "For I am sorry that with reverence",
          "plainText": "For I am sorry that with reverence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0068",
          "number": 68,
          "speechLineNumber": 6,
          "text": "I did not entertain thee as thou art.",
          "plainText": "I did not entertain thee as thou art",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Be not dismay'd, fair lady, nor misconster",
          "plainText": "Be not dismay'd fair lady nor misconster",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "The mind of Talbot, as you did mistake",
          "plainText": "The mind of Talbot as you did mistake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0071",
          "number": 71,
          "speechLineNumber": 3,
          "text": "The outward composition of his body.",
          "plainText": "The outward composition of his body",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0072",
          "number": 72,
          "speechLineNumber": 4,
          "text": "What you have done hath not offended me;",
          "plainText": "What you have done hath not offended me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0073",
          "number": 73,
          "speechLineNumber": 5,
          "text": "Nor other satisfaction do I crave",
          "plainText": "Nor other satisfaction do I crave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0074",
          "number": 74,
          "speechLineNumber": 6,
          "text": "But only, with your patience, that we may",
          "plainText": "But only with your patience that we may",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0075",
          "number": 75,
          "speechLineNumber": 7,
          "text": "Taste of your wine and see what cates you have,",
          "plainText": "Taste of your wine and see what cates you have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0076",
          "number": 76,
          "speechLineNumber": 8,
          "text": "For soldiers' stomachs always serve them well.",
          "plainText": "For soldiers' stomachs always serve them well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "countess",
        "name": "COUNTESS",
        "displayName": "Countess"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "With all my heart, and think me honoured",
          "plainText": "With all my heart and think me honoured",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-3-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "To feast so great a warrior in my house.",
          "plainText": "To feast so great a warrior in my house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-3-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}