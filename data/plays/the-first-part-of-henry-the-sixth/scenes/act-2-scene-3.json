          "start": 379,
          "end": 420,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2141135,
        "end": 2141630,
        "line": 78670,
        "column": 1,
        "path": "chap12/p@55448",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
