      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57195",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nLaughest thou, wretch? Thy mirth shall turn to moan.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57195/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57195/line-2",
          "start": 10,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2142882,
        "end": 2142974,
        "line": 78738,
        "column": 1,
        "path": "chap12/p@57195",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57291",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nI laugh to see your ladyship so fond\nTo think that you have aught but Talbot’s shadow\nWhereon to practice your severity.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57291/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57291/line-2",
          "start": 8,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57291/line-3",
          "start": 45,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57291/line-4",
          "start": 94,
          "end": 128,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2142978,
        "end": 2143146,
        "line": 78743,
        "column": 1,
        "path": "chap12/p@57291",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
