    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@54679",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nThe plot is laid. If all things fall out right,\nI shall as famous be by this exploit\nAs Scythian Tomyris by Cyrus’ death.\nGreat is the rumour of this dreadful knight,\nAnd his achievements of no less account.\nFain would mine eyes be witness with mine ears,\nTo give their censure of these rare reports.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@54679/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@54679/line-2",
          "start": 10,
          "end": 57,
          "sourceLineNumber": null
        },
