        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@55947",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nMadam, I have been bold to trouble you;\nBut since your ladyship is not at leisure,\nI’ll sort some other time to visit you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@55947/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@55947/line-2",
          "start": 8,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@55947/line-3",
          "start": 48,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@55947/line-4",
          "start": 91,
          "end": 130,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2141634,
        "end": 2141804,
        "line": 78684,
        "column": 1,
        "path": "chap12/p@55947",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56121",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nWhat means he now? Go ask him whither he goes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56121/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56121/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2141808,
        "end": 2141894,
        "line": 78691,
        "column": 1,
        "path": "chap12/p@56121",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56211",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nStay, my Lord Talbot, for my lady craves\nTo know the cause of your abrupt departure.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56211/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56211/line-2",
          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56211/line-3",
          "start": 52,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2141898,
        "end": 2142028,
        "line": 78696,
        "column": 1,
        "path": "chap12/p@56211",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56345",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nMarry, for that she’s in a wrong belief,\nI go to certify her Talbot’s here.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56345/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56345/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@56345/line-3",
          "start": 49,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2142032,
        "end": 2142150,
        "line": 78702,
        "column": 1,
        "path": "chap12/p@56345",
        "anchor": "sceneII_12.3"
      },
