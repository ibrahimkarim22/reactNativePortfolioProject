    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@59005",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nBe not dismay’d, fair lady, nor misconster\nThe mind of Talbot, as you did mistake\nThe outward composition of his body.\nWhat you have done hath not offended me;\nNor other satisfaction do I crave\nBut only, with your patience, that we may\nTaste of your wine and see what cates you have,\nFor soldiers’ stomachs always serve them well.",
      "separatorAfter": "\n\n",
      "spans": [],
