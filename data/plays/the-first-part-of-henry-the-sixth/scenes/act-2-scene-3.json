        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57463",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nWhy, art not thou the man?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57463/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
