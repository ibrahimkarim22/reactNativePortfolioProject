          "start": 8,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2143220,
        "end": 2143270,
        "line": 78755,
        "column": 1,
        "path": "chap12/p@57533",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57587",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nThen have I substance too.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57587/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57587/line-2",
          "start": 10,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2143274,
        "end": 2143340,
        "line": 78760,
        "column": 1,
        "path": "chap12/p@57587",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57657",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nNo, no, I am but shadow of myself.\nYou are deceived, my substance is not here;\nFor what you see is but the smallest part\nAnd least proportion of humanity.\nI tell you, madam, were the whole frame here,\nIt is of such a spacious lofty pitch\nYour roof were not sufficient to contain ’t.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57657/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57657/line-2",
          "start": 8,
          "end": 42,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57657/line-3",
          "start": 43,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57657/line-4",
          "start": 87,
          "end": 128,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57657/line-5",
          "start": 129,
          "end": 162,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57657/line-6",
          "start": 163,
          "end": 208,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57657/line-7",
          "start": 209,
          "end": 245,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@57657/line-8",
          "start": 246,
          "end": 290,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2143344,
        "end": 2143694,
        "line": 78765,
        "column": 1,
        "path": "chap12/p@57657",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58011",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nThis is a riddling merchant for the nonce;\nHe will be here, and yet he is not here.\nHow can these contrarieties agree?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58011/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58011/line-2",
          "start": 10,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58011/line-3",
          "start": 53,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58011/line-4",
          "start": 94,
          "end": 128,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2143698,
        "end": 2143866,
        "line": 78776,
        "column": 1,
        "path": "chap12/p@58011",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "COUNTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58183",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nThat will I show you presently.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58183/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58183/line-2",
          "start": 8,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2143870,
        "end": 2143939,
        "line": 78783,
        "column": 1,
        "path": "chap12/p@58183",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58256",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Winds his horn. Drums strike up; a peal of ordnance. Enter Soldiers.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 59,
          "end": 67,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58256/line-1",
          "start": 0,
          "end": 68,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2143943,
        "end": 2144067,
        "line": 78788,
        "column": 1,
        "path": "chap12/p@58256",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58384",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "How say you, madam? Are you now persuaded\nThat Talbot is but shadow of himself?\nThese are his substance, sinews, arms and strength,\nWith which he yoketh your rebellious necks,\nRazeth your cities and subverts your towns,\nAnd in a moment makes them desolate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58384/line-1",
          "start": 0,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58384/line-2",
          "start": 42,
          "end": 79,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58384/line-3",
          "start": 80,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58384/line-4",
          "start": 132,
          "end": 175,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58384/line-5",
          "start": 176,
          "end": 219,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58384/line-6",
          "start": 220,
          "end": 256,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2144071,
        "end": 2144377,
        "line": 78791,
        "column": 1,
        "path": "chap12/p@58384",
        "anchor": "sceneII_12.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58694",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COUNTESS.\nVictorious Talbot, pardon my abuse.\nI find thou art no less than fame hath bruited,\nAnd more than may be gather’d by thy shape.\nLet my presumption not provoke thy wrath,\nFor I am sorry that with reverence\nI did not entertain thee as thou art.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneII_12.3/p@58694/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
