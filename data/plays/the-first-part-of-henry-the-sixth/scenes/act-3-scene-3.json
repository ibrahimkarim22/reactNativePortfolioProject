    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@102412",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BURGUNDY.\nEither she hath bewitch’d me with her words,\nOr nature makes me suddenly relent.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@102412/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
