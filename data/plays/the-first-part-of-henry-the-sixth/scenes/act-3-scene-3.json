    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98608",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Charles, the Bastard of Orleans, Alençon, La Pucelle and forces.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 58,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98608/line-1",
          "start": 0,
          "end": 70,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2184295,
        "end": 2184421,
        "line": 80230,
        "column": 1,
        "path": "chap12/p@98608",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98738",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nDismay not, princes, at this accident,\nNor grieve that Rouen is so recovered.\nCare is no cure, but rather corrosive,\nFor things that are not to be remedied.\nLet frantic Talbot triumph for a while\nAnd like a peacock sweep along his tail;\nWe’ll pull his plumes and take away his train,\nIf Dauphin and the rest will be but ruled.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98738/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98738/line-2",
          "start": 9,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98738/line-3",
          "start": 48,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98738/line-4",
          "start": 87,
          "end": 125,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98738/line-5",
          "start": 126,
          "end": 165,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98738/line-6",
          "start": 166,
          "end": 204,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98738/line-7",
          "start": 205,
          "end": 245,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98738/line-8",
          "start": 246,
          "end": 292,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@98738/line-9",
          "start": 293,
          "end": 335,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2184425,
        "end": 2184825,
        "line": 80233,
        "column": 1,
        "path": "chap12/p@98738",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": "PUCELLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99142",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\nWe have been guided by thee hitherto,\nAnd of thy cunning had no diffidence.\nOne sudden foil shall never breed distrust",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99142/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99142/line-2",
          "start": 9,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99142/line-3",
          "start": 47,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99142/line-4",
          "start": 85,
          "end": 127,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2184829,
        "end": 2184996,
        "line": 80245,
        "column": 1,
        "path": "chap12/p@99142",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": "CHARLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99313",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nSearch out thy wit for secret policies,\nAnd we will make thee famous through the world.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99313/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99313/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99313/line-3",
          "start": 49,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2185000,
        "end": 2185131,
        "line": 80252,
        "column": 1,
        "path": "chap12/p@99313",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": "BASTARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99448",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALENÇON.\nWe’ll set thy statue in some holy place,\nAnd have thee reverenced like a blessed saint.\nEmploy thee then, sweet virgin, for our good.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99448/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99448/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99448/line-3",
          "start": 50,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99448/line-4",
          "start": 97,
          "end": 142,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2185135,
        "end": 2185317,
        "line": 80258,
        "column": 1,
        "path": "chap12/p@99448",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": "ALENÇON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99634",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nThen thus it must be; this doth Joan devise:\nBy fair persuasions mix’d with sugar’d words\nWe will entice the Duke of Burgundy\nTo leave the Talbot and to follow us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99634/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99634/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99634/line-3",
          "start": 54,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99634/line-4",
          "start": 99,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99634/line-5",
          "start": 135,
          "end": 172,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2185321,
        "end": 2185538,
        "line": 80265,
        "column": 1,
        "path": "chap12/p@99634",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": "PUCELLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99855",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\nAy, marry, sweeting, if we could do that,\nFrance were no place for Henry’s warriors;\nNor should that nation boast it so with us,\nBut be extirped from our provinces.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99855/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99855/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99855/line-3",
          "start": 51,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99855/line-4",
          "start": 94,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@99855/line-5",
          "start": 138,
          "end": 173,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2185542,
        "end": 2185760,
        "line": 80273,
        "column": 1,
        "path": "chap12/p@99855",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": "CHARLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100077",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALENÇON.\nFor ever should they be expulsed from France,\nAnd not have title of an earldom here.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100077/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100077/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100077/line-3",
          "start": 55,
          "end": 93,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2185764,
        "end": 2185892,
        "line": 80281,
        "column": 1,
        "path": "chap12/p@100077",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": "ALENÇON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100209",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nYour honours shall perceive how I will work\nTo bring this matter to the wished end.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100209/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100209/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100209/line-3",
          "start": 53,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2185896,
        "end": 2186023,
        "line": 80287,
        "column": 1,
        "path": "chap12/p@100209",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": "PUCELLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100340",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Drum sounds afar off.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 22
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100340/line-1",
          "start": 0,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2186027,
        "end": 2186078,
        "line": 80293,
        "column": 1,
        "path": "chap12/p@100340",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100395",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Hark! By the sound of drum you may perceive\nTheir powers are marching unto Paris-ward.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100395/line-1",
          "start": 0,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100395/line-2",
          "start": 44,
          "end": 86,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2186082,
        "end": 2186198,
        "line": 80295,
        "column": 1,
        "path": "chap12/p@100395",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100515",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Here sound an English march.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 29
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100515/line-1",
          "start": 0,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2186202,
        "end": 2186260,
        "line": 80300,
        "column": 1,
        "path": "chap12/p@100515",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100577",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "There goes the Talbot, with his colours spread,\nAnd all the troops of English after him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100577/line-1",
          "start": 0,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100577/line-2",
          "start": 48,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2186264,
        "end": 2186382,
        "line": 80302,
        "column": 1,
        "path": "chap12/p@100577",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100699",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[French march.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 14
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100699/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2186386,
        "end": 2186429,
        "line": 80307,
        "column": 1,
        "path": "chap12/p@100699",
        "anchor": "sceneIII_12.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100746",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Now in the rearward comes the Duke and his.\nFortune in favour makes him lag behind.\nSummon a parley; we will talk with him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@100746/line-1",
          "start": 0,
          "end": 43,
          "sourceLineNumber": null
