    {
      "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@103460",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BURGUNDY.\nI am vanquished; these haughty words of hers\nHave batter’d me like roaring cannon-shot,\nAnd made me almost yield upon my knees.\nForgive me, country, and sweet countrymen!\nAnd, lords, accept this hearty kind embrace.\nMy forces and my power of men are yours.\nSo, farewell, Talbot; I’ll no longer trust thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.3/p@103460/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
