        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIII_12.4/p@104497/line-1",
          "start": 0,
          "end": 157,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2190184,
        "end": 2190458,
        "line": 80443,
        "column": 1,
        "path": "chap12/p@104497",
