      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nYes, if it please your Majesty, my liege.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
