      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nIs this the Lord Talbot, uncle Gloucester,\nThat hath so long been resident in France?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
