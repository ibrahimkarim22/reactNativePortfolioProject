{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "the-first-part-of-henry-the-sixth",
    "title": "The First Part of Henry the Sixth",
    "author": "William Shakespeare",
    "genre": "History"
  },
  "source": {
    "name": "Project Gutenberg",
    "ebookNumber": 100,
    "rights": "Public domain in the USA",
    "sourceFile": "pg100-images.html"
  },
  "scene": {
    "id": "the-first-part-of-henry-the-sixth-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. Before Bordeaux.",
    "location": "Before Bordeaux.",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "the-first-part-of-henry-the-sixth-4-2-stage-001",
      "type": "stage",
      "text": "Enter Talbot with trump and drum."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Go to the gates of Bordeaux, trumpeter.",
          "plainText": "Go to the gates of Bordeaux trumpeter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Summon their general unto the wall.",
          "plainText": "Summon their general unto the wall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-2-stage-002",
      "type": "stage",
      "text": "Trumpet sounds. Enter General and others aloft."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "general",
        "name": "GENERAL",
        "displayName": "General"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Thou ominous and fearful owl of death,",
          "plainText": "Thou ominous and fearful owl of death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Our nation's terror and their bloody scourge!",
          "plainText": "Our nation's terror and their bloody scourge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "The period of thy tyranny approacheth.",
          "plainText": "The period of thy tyranny approacheth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "On us thou canst not enter but by death;",
          "plainText": "On us thou canst not enter but by death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 5,
          "text": "For, I protest, we are well fortified",
          "plainText": "For I protest we are well fortified",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 6,
          "text": "And strong enough to issue out and fight.",
          "plainText": "And strong enough to issue out and fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 7,
          "text": "If thou retire, the Dauphin, well appointed,",
          "plainText": "If thou retire the Dauphin well appointed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 8,
          "text": "Stands with the snares of war to tangle thee.",
          "plainText": "Stands with the snares of war to tangle thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 9,
          "text": "On either hand thee there are squadrons pitch'd",
          "plainText": "On either hand thee there are squadrons pitch'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 10,
          "text": "To wall thee from the liberty of flight;",
          "plainText": "To wall thee from the liberty of flight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 11,
          "text": "And no way canst thou turn thee for redress",
          "plainText": "And no way canst thou turn thee for redress",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 12,
          "text": "But Death doth front thee with apparent spoil,",
          "plainText": "But Death doth front thee with apparent spoil",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 13,
          "text": "And pale Destruction meets thee in the face.",
          "plainText": "And pale Destruction meets thee in the face",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 14,
          "text": "Ten thousand French have ta'en the sacrament",
          "plainText": "Ten thousand French have ta'en the sacrament",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 15,
          "text": "To rive their dangerous artillery",
          "plainText": "To rive their dangerous artillery",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 16,
          "text": "Upon no Christian soul but English Talbot.",
          "plainText": "Upon no Christian soul but English Talbot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 17,
          "text": "Lo, there thou stand'st, a breathing valiant man",
          "plainText": "Lo there thou stand'st a breathing valiant man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 18,
          "text": "Of an invincible unconquer'd spirit.",
          "plainText": "Of an invincible unconquer'd spirit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 19,
          "text": "This is the latest glory of thy praise",
          "plainText": "This is the latest glory of thy praise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 20,
          "text": "That I, thy enemy, due thee withal;",
          "plainText": "That I thy enemy due thee withal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 21,
          "text": "For ere the glass, that now begins to run,",
          "plainText": "For ere the glass that now begins to run",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 22,
          "text": "Finish the process of his sandy hour,",
          "plainText": "Finish the process of his sandy hour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 23,
          "text": "These eyes, that see thee now well coloured,",
          "plainText": "These eyes that see thee now well coloured",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 24,
          "text": "Shall see thee wither'd, bloody, pale, and dead.",
          "plainText": "Shall see thee wither'd bloody pale and dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-2-stage-003",
      "type": "stage",
      "text": "[Drum afar off.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-2-stage-004",
      "type": "stage",
      "text": "[Exeunt General, etc.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "He fables not; I hear the enemy.",
          "plainText": "He fables not I hear the enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Out, some light horsemen, and peruse their wings.",
          "plainText": "Out some light horsemen and peruse their wings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "O, negligent and heedless discipline!",
          "plainText": "O negligent and heedless discipline",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "How are we park'd and bounded in a pale,",
          "plainText": "How are we park'd and bounded in a pale",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "A little herd of England's timorous deer,",
          "plainText": "A little herd of England's timorous deer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0032",
          "number": 32,
          "speechLineNumber": 6,
          "text": "Mazed with a yelping kennel of French curs!",
          "plainText": "Mazed with a yelping kennel of French curs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0033",
          "number": 33,
          "speechLineNumber": 7,
          "text": "If we be English deer, be then in blood;",
          "plainText": "If we be English deer be then in blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0034",
          "number": 34,
          "speechLineNumber": 8,
          "text": "Not rascal-like, to fall down with a pinch,",
          "plainText": "Not rascallike to fall down with a pinch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0035",
          "number": 35,
          "speechLineNumber": 9,
          "text": "But rather, moody-mad and desperate stags,",
          "plainText": "But rather moodymad and desperate stags",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0036",
          "number": 36,
          "speechLineNumber": 10,
          "text": "Turn on the bloody hounds with heads of steel",
          "plainText": "Turn on the bloody hounds with heads of steel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0037",
          "number": 37,
          "speechLineNumber": 11,
          "text": "And make the cowards stand aloof at bay.",
          "plainText": "And make the cowards stand aloof at bay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0038",
          "number": 38,
          "speechLineNumber": 12,
          "text": "Sell every man his life as dear as mine,",
          "plainText": "Sell every man his life as dear as mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0039",
          "number": 39,
          "speechLineNumber": 13,
          "text": "And they shall find dear deer of us, my friends.",
          "plainText": "And they shall find dear deer of us my friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0040",
          "number": 40,
          "speechLineNumber": 14,
          "text": "God and Saint George, Talbot and England's right,",
          "plainText": "God and Saint George Talbot and England's right",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-2-line-0041",
          "number": 41,
          "speechLineNumber": 15,
          "text": "Prosper our colours in this dangerous fight!",
          "plainText": "Prosper our colours in this dangerous fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-2-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}