    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.2/p@121661",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Hark, hark, the Dauphin’s drum, a warning bell,\nSings heavy music to thy timorous soul,\nAnd mine shall ring thy dire departure out.",
