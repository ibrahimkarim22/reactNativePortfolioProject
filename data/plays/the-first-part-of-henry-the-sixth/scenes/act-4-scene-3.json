        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124642",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCY.\nO, send some succour to the distress’d lord!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124642/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124642/line-2",
          "start": 6,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2210329,
        "end": 2210409,
        "line": 81092,
        "column": 1,
        "path": "chap12/p@124642",
        "anchor": "sceneIV_12.3"
      },
      "speakerLabel": "LUCY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124726",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nHe dies, we lose; I break my warlike word;\nWe mourn, France smiles; we lose, they daily get,\nAll long of this vile traitor Somerset.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124726/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124726/line-2",
          "start": 6,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124726/line-3",
          "start": 49,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124726/line-4",
          "start": 99,
          "end": 138,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2210413,
        "end": 2210591,
        "line": 81097,
        "column": 1,
        "path": "chap12/p@124726",
        "anchor": "sceneIV_12.3"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124908",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCY.\nThen God take mercy on brave Talbot’s soul,\nAnd on his son young John, who two hours since\nI met in travel toward his warlike father.\nThis seven years did not Talbot see his son;\nAnd now they meet where both their lives are done.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124908/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124908/line-2",
          "start": 6,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124908/line-3",
          "start": 50,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124908/line-4",
          "start": 97,
          "end": 139,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124908/line-5",
          "start": 140,
          "end": 184,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124908/line-6",
          "start": 185,
          "end": 235,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2210595,
        "end": 2210880,
        "line": 81104,
        "column": 1,
        "path": "chap12/p@124908",
        "anchor": "sceneIV_12.3"
      },
      "speakerLabel": "LUCY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@125197",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nAlas, what joy shall noble Talbot have\nTo bid his young son welcome to his grave?\nAway! Vexation almost stops my breath,\nThat sunder’d friends greet in the hour of death.\nLucy, farewell. No more my fortune can\nBut curse the cause I cannot aid the man.\nMaine, Blois, Poictiers, and Tours, are won away,\nLong all of Somerset and his delay.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@125197/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@125197/line-2",
          "start": 6,
          "end": 44,
          "sourceLineNumber": null
