      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Sir William Lucy.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 22,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123871/line-1",
          "start": 0,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2209558,
        "end": 2209636,
        "line": 81069,
        "column": 1,
        "path": "chap12/p@123871",
        "anchor": "sceneIV_12.3"
