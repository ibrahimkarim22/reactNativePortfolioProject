        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124329",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nO God, that Somerset, who in proud heart\nDoth stop my cornets, were in Talbot’s place!\nSo should we save a valiant gentleman\nBy forfeiting a traitor and a coward.\nMad ire and wrathful fury makes me weep\nThat thus we die while remiss traitors sleep.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124329/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124329/line-2",
          "start": 6,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124329/line-3",
          "start": 47,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124329/line-4",
          "start": 93,
          "end": 130,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124329/line-5",
          "start": 131,
          "end": 168,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124329/line-6",
          "start": 169,
          "end": 208,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@124329/line-7",
          "start": 209,
          "end": 254,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2210016,
        "end": 2210325,
        "line": 81082,
        "column": 1,
        "path": "chap12/p@124329",
        "anchor": "sceneIV_12.3"
      },
      "speakerLabel": "YORK.",
      "attribution": {
