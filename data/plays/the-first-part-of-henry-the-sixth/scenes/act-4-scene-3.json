    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123953",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCY.\nThou princely leader of our English strength,\nNever so needful on the earth of France,\nSpur to the rescue of the noble Talbot,\nWho now is girdled with a waist of iron,\nAnd hemm’d about with grim destruction.\nTo Bordeaux, warlike Duke! To Bordeaux, York!\nElse farewell, Talbot, France, and England’s honour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123953/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123953/line-2",
          "start": 6,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123953/line-3",
          "start": 52,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123953/line-4",
          "start": 93,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123953/line-5",
          "start": 133,
          "end": 173,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123953/line-6",
          "start": 174,
          "end": 213,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123953/line-7",
          "start": 214,
          "end": 259,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123953/line-8",
          "start": 260,
          "end": 312,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2209640,
        "end": 2210012,
        "line": 81071,
        "column": 1,
        "path": "chap12/p@123953",
        "anchor": "sceneIV_12.3"
      },
      "speakerLabel": "LUCY.",
      "attribution": {
