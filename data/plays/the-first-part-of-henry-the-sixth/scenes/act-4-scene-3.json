    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@122987",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nAre not the speedy scouts return’d again\nThat dogg’d the mighty army of the Dauphin?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@122987/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@122987/line-2",
          "start": 6,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@122987/line-3",
          "start": 47,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2208674,
        "end": 2208799,
        "line": 81039,
        "column": 1,
        "path": "chap12/p@122987",
        "anchor": "sceneIV_12.3"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123116",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nThey are return’d, my lord, and give it out\nThat he is march’d to Bordeaux with his power,\nTo fight with Talbot. As he march’d along,\nBy your espials were discovered\nTwo mightier troops than that the Dauphin led,\nWhich join’d with him and made their march for Bordeaux.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.3/p@123116/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
