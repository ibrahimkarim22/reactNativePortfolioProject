      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.4/p@126891",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Sir William Lucy.",
      "separatorAfter": "\n\n",
      "spans": [
