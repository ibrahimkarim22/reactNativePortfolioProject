    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.4/p@126295",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOMERSET.\nIt is too late; I cannot send them now.\nThis expedition was by York and Talbot\nToo rashly plotted. All our general force\nMight with a sally of the very town\nBe buckled with. The over-daring Talbot\nHath sullied all his gloss of former honour\nBy this unheedful, desperate, wild adventure.\nYork set him on to fight and die in shame\nThat, Talbot dead, great York might bear the name.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.4/p@126295/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.4/p@126295/line-2",
          "start": 10,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.4/p@126295/line-3",
          "start": 50,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.4/p@126295/line-4",
          "start": 89,
          "end": 130,
          "sourceLineNumber": null
        },
        {
