      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@130210",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JOHN TALBOT.\nHe that flies so will ne’er return again.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@130210/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
