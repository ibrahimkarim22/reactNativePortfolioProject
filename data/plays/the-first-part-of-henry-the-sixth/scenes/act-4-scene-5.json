    "title": "SCENE V. The English camp near Bordeaux.",
    "location": "The English camp near Bordeaux.",
    "orderInPlay": 20
  },
  "content": [
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-stage-001",
      "type": "stage",
      "text": "Enter Talbot and John his son."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "O young John Talbot, I did send for thee",
          "plainText": "O young John Talbot I did send for thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "To tutor thee in stratagems of war,",
          "plainText": "To tutor thee in stratagems of war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "That Talbot's name might be in thee revived",
          "plainText": "That Talbot's name might be in thee revived",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "When sapless age and weak unable limbs",
          "plainText": "When sapless age and weak unable limbs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Should bring thy father to his drooping chair.",
          "plainText": "Should bring thy father to his drooping chair",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "But—O malignant and ill-boding stars!—",
          "plainText": "ButO malignant and illboding stars",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Now thou art come unto a feast of death,",
          "plainText": "Now thou art come unto a feast of death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "A terrible and unavoided danger.",
          "plainText": "A terrible and unavoided danger",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Therefore, dear boy, mount on my swiftest horse,",
          "plainText": "Therefore dear boy mount on my swiftest horse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "And I'll direct thee how thou shalt escape",
          "plainText": "And I'll direct thee how thou shalt escape",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "By sudden flight. Come, dally not, be gone.",
          "plainText": "By sudden flight Come dally not be gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "john-talbot",
        "name": "JOHN TALBOT",
        "displayName": "John Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Is my name Talbot? And am I your son?",
          "plainText": "Is my name Talbot And am I your son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "And shall I fly? O, if you love my mother,",
          "plainText": "And shall I fly O if you love my mother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Dishonour not her honourable name,",
          "plainText": "Dishonour not her honourable name",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "To make a bastard and a slave of me!",
          "plainText": "To make a bastard and a slave of me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "The world will say, he is not Talbot's blood,",
          "plainText": "The world will say he is not Talbot's blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "That basely fled when noble Talbot stood.",
          "plainText": "That basely fled when noble Talbot stood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Fly, to revenge my death if I be slain.",
          "plainText": "Fly to revenge my death if I be slain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "john-talbot",
        "name": "JOHN TALBOT",
        "displayName": "John Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "He that flies so will ne'er return again.",
          "plainText": "He that flies so will ne'er return again",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "If we both stay, we both are sure to die.",
          "plainText": "If we both stay we both are sure to die",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "john-talbot",
        "name": "JOHN TALBOT",
        "displayName": "John Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Then let me stay and, father, do you fly.",
          "plainText": "Then let me stay and father do you fly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "Your loss is great, so your regard should be;",
          "plainText": "Your loss is great so your regard should be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "My worth unknown, no loss is known in me.",
          "plainText": "My worth unknown no loss is known in me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "Upon my death the French can little boast;",
          "plainText": "Upon my death the French can little boast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "In yours they will, in you all hopes are lost.",
          "plainText": "In yours they will in you all hopes are lost",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0026",
          "number": 26,
          "speechLineNumber": 6,
          "text": "Flight cannot stain the honour you have won;",
          "plainText": "Flight cannot stain the honour you have won",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0027",
          "number": 27,
          "speechLineNumber": 7,
          "text": "But mine it will, that no exploit have done.",
          "plainText": "But mine it will that no exploit have done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0028",
          "number": 28,
          "speechLineNumber": 8,
          "text": "You fled for vantage, everyone will swear;",
          "plainText": "You fled for vantage everyone will swear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0029",
          "number": 29,
          "speechLineNumber": 9,
          "text": "But if I bow, they'll say it was for fear.",
          "plainText": "But if I bow they'll say it was for fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0030",
          "number": 30,
          "speechLineNumber": 10,
          "text": "There is no hope that ever I will stay",
          "plainText": "There is no hope that ever I will stay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0031",
          "number": 31,
          "speechLineNumber": 11,
          "text": "If the first hour I shrink and run away.",
          "plainText": "If the first hour I shrink and run away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0032",
          "number": 32,
          "speechLineNumber": 12,
          "text": "Here on my knee I beg mortality,",
          "plainText": "Here on my knee I beg mortality",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0033",
          "number": 33,
          "speechLineNumber": 13,
          "text": "Rather than life preserved with infamy.",
          "plainText": "Rather than life preserved with infamy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Shall all thy mother's hopes lie in one tomb?",
          "plainText": "Shall all thy mother's hopes lie in one tomb",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "john-talbot",
        "name": "JOHN TALBOT",
        "displayName": "John Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Ay, rather than I'll shame my mother's womb.",
          "plainText": "Ay rather than I'll shame my mother's womb",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Upon my blessing, I command thee go.",
          "plainText": "Upon my blessing I command thee go",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "john-talbot",
        "name": "JOHN TALBOT",
        "displayName": "John Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "To fight I will, but not to fly the foe.",
          "plainText": "To fight I will but not to fly the foe",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Part of thy father may be saved in thee.",
          "plainText": "Part of thy father may be saved in thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "john-talbot",
        "name": "JOHN TALBOT",
        "displayName": "John Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "No part of him but will be shame in me.",
          "plainText": "No part of him but will be shame in me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Thou never hadst renown, nor canst not lose it.",
          "plainText": "Thou never hadst renown nor canst not lose it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "john-talbot",
        "name": "JOHN TALBOT",
        "displayName": "John Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Yes, your renowned name; shall flight abuse it?",
          "plainText": "Yes your renowned name shall flight abuse it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Thy father's charge shall clear thee from that stain.",
          "plainText": "Thy father's charge shall clear thee from that stain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "john-talbot",
        "name": "JOHN TALBOT",
        "displayName": "John Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "You cannot witness for me, being slain.",
          "plainText": "You cannot witness for me being slain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "If death be so apparent, then both fly.",
          "plainText": "If death be so apparent then both fly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "And leave my followers here to fight and die?",
          "plainText": "And leave my followers here to fight and die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "My age was never tainted with such shame.",
          "plainText": "My age was never tainted with such shame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "john-talbot",
        "name": "JOHN TALBOT",
        "displayName": "John Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "And shall my youth be guilty of such blame?",
          "plainText": "And shall my youth be guilty of such blame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "No more can I be sever'd from your side",
          "plainText": "No more can I be sever'd from your side",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0049",
          "number": 49,
          "speechLineNumber": 3,
          "text": "Than can yourself yourself in twain divide.",
          "plainText": "Than can yourself yourself in twain divide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0050",
          "number": 50,
          "speechLineNumber": 4,
          "text": "Stay, go, do what you will, the like do I;",
          "plainText": "Stay go do what you will the like do I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0051",
          "number": 51,
          "speechLineNumber": 5,
          "text": "For live I will not, if my father die.",
          "plainText": "For live I will not if my father die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-4-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Then here I take my leave of thee, fair son,",
          "plainText": "Then here I take my leave of thee fair son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Born to eclipse thy life this afternoon.",
          "plainText": "Born to eclipse thy life this afternoon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "Come, side by side together live and die,",
          "plainText": "Come side by side together live and die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-4-5-line-0055",
          "number": 55,
          "speechLineNumber": 4,
          "text": "And soul with soul from France to heaven fly.",
          "plainText": "And soul with soul from France to heaven fly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
