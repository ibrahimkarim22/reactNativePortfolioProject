          "start": 13,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2215897,
        "end": 2215981,
        "line": 81278,
        "column": 1,
        "path": "chap12/p@130210",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "JOHN TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@130298",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nIf we both stay, we both are sure to die.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@130298/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@130298/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2215985,
        "end": 2216064,
        "line": 81283,
        "column": 1,
        "path": "chap12/p@130298",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@130381",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JOHN TALBOT.\nThen let me stay and, father, do you fly.\nYour loss is great, so your regard should be;\nMy worth unknown, no loss is known in me.\nUpon my death the French can little boast;\nIn yours they will, in you all hopes are lost.\nFlight cannot stain the honour you have won;\nBut mine it will, that no exploit have done.\nYou fled for vantage, everyone will swear;\nBut if I bow, they’ll say it was for fear.\nThere is no hope that ever I will stay\nIf the first hour I shrink and run away.\nHere on my knee I beg mortality,\nRather than life preserved with infamy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@130381/line-1",
          "start": 0,
          "end": 12,
