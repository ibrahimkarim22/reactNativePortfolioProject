    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131123",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JOHN TALBOT.\nAy, rather than I’ll shame my mother’s womb.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131123/line-1",
