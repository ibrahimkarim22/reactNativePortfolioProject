          "start": 13,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2216810,
        "end": 2216897,
        "line": 81310,
        "column": 1,
        "path": "chap12/p@131123",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "JOHN TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131214",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nUpon my blessing, I command thee go.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131214/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131214/line-2",
          "start": 8,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2216901,
        "end": 2216975,
        "line": 81315,
        "column": 1,
        "path": "chap12/p@131214",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131292",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JOHN TALBOT.\nTo fight I will, but not to fly the foe.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131292/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131292/line-2",
          "start": 13,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2216979,
        "end": 2217062,
        "line": 81320,
        "column": 1,
        "path": "chap12/p@131292",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "JOHN TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131379",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nPart of thy father may be saved in thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131379/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131379/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2217066,
        "end": 2217144,
        "line": 81325,
        "column": 1,
        "path": "chap12/p@131379",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131461",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JOHN TALBOT.\nNo part of him but will be shame in me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131461/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131461/line-2",
          "start": 13,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2217148,
        "end": 2217230,
        "line": 81330,
        "column": 1,
        "path": "chap12/p@131461",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "JOHN TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131547",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nThou never hadst renown, nor canst not lose it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131547/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131547/line-2",
          "start": 8,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2217234,
        "end": 2217319,
        "line": 81335,
        "column": 1,
        "path": "chap12/p@131547",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131636",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JOHN TALBOT.\nYes, your renowned name; shall flight abuse it?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131636/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131636/line-2",
          "start": 13,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2217323,
        "end": 2217413,
        "line": 81340,
        "column": 1,
        "path": "chap12/p@131636",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "JOHN TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131730",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nThy father’s charge shall clear thee from that stain.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131730/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131730/line-2",
          "start": 8,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2217417,
        "end": 2217508,
        "line": 81345,
        "column": 1,
        "path": "chap12/p@131730",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131825",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JOHN TALBOT.\nYou cannot witness for me, being slain.\nIf death be so apparent, then both fly.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131825/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131825/line-2",
          "start": 13,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131825/line-3",
          "start": 53,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2217512,
        "end": 2217639,
        "line": 81350,
        "column": 1,
        "path": "chap12/p@131825",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "JOHN TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131956",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nAnd leave my followers here to fight and die?\nMy age was never tainted with such shame.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131956/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131956/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131956/line-3",
          "start": 54,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2217643,
        "end": 2217773,
        "line": 81356,
        "column": 1,
        "path": "chap12/p@131956",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132090",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JOHN TALBOT.\nAnd shall my youth be guilty of such blame?\nNo more can I be sever’d from your side\nThan can yourself yourself in twain divide.\nStay, go, do what you will, the like do I;\nFor live I will not, if my father die.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132090/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132090/line-2",
          "start": 13,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132090/line-3",
          "start": 57,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132090/line-4",
          "start": 97,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132090/line-5",
          "start": 141,
          "end": 183,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132090/line-6",
          "start": 184,
          "end": 222,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2217777,
        "end": 2218049,
        "line": 81362,
        "column": 1,
        "path": "chap12/p@132090",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "JOHN TALBOT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132366",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nThen here I take my leave of thee, fair son,\nBorn to eclipse thy life this afternoon.\nCome, side by side together live and die,\nAnd soul with soul from France to heaven fly.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132366/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132366/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132366/line-3",
          "start": 53,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132366/line-4",
          "start": 94,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@132366/line-5",
          "start": 136,
          "end": 181,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
