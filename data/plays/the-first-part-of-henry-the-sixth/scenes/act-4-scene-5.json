    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131036",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nShall all thy mother’s hopes lie in one tomb?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131036/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.5/p@131036/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2216723,
        "end": 2216806,
        "line": 81305,
        "column": 1,
        "path": "chap12/p@131036",
        "anchor": "sceneIV_12.5"
      },
      "speakerLabel": "TALBOT.",
      "attribution": {
