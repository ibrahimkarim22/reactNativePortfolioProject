    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.6/p@133148",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JOHN TALBOT.\nO, twice my father, twice am I thy son!\nThe life thou gav’st me first was lost and done,\nTill with thy warlike sword, despite of fate,\nTo my determined time thou gav’st new date.",
