    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.6/p@135596",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nThen follow thou thy desperate sire of Crete,\nThou Icarus; thy life to me is sweet.\nIf thou wilt fight, fight by thy father’s side,\nAnd, commendable proved, let’s die in pride.",
