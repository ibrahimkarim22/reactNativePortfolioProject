    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.6/p@132852",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TALBOT.\nSaint George and victory! Fight, soldiers, fight!\nThe Regent hath with Talbot broke his word,\nAnd left us to the rage of France his sword.\nWhere is John Talbot? Pause, and take thy breath;\nI gave thee life and rescued thee from death.",
      "separatorAfter": "\n\n",
