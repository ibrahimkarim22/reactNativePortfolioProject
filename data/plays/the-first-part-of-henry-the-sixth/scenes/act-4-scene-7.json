        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": "CHARLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139087",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Sir William Lucy and a French Herald.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 22,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 36,
          "end": 42,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139087/line-1",
          "start": 0,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2224774,
        "end": 2224903,
        "line": 81564,
        "column": 1,
        "path": "chap12/p@139087",
        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139220",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCY.\nHerald, conduct me to the Dauphin’s tent,\nTo know who hath obtain’d the glory of the day.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139220/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139220/line-2",
          "start": 6,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139220/line-3",
          "start": 48,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2224907,
        "end": 2225037,
        "line": 81567,
        "column": 1,
        "path": "chap12/p@139220",
        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": "LUCY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139354",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\nOn what submissive message art thou sent?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139354/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139354/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2225041,
        "end": 2225121,
        "line": 81573,
        "column": 1,
        "path": "chap12/p@139354",
        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": "CHARLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139438",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCY.\nSubmission, Dauphin! ’Tis a mere French word.\nWe English warriors wot not what it means.\nI come to know what prisoners thou hast ta’en,\nAnd to survey the bodies of the dead.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139438/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139438/line-2",
          "start": 6,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139438/line-3",
          "start": 52,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139438/line-4",
          "start": 95,
          "end": 141,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139438/line-5",
          "start": 142,
          "end": 179,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2225125,
        "end": 2225349,
        "line": 81578,
        "column": 1,
        "path": "chap12/p@139438",
        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": "LUCY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139666",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\nFor prisoners ask’st thou? Hell our prison is.\nBut tell me whom thou seek’st.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139666/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139666/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139666/line-3",
          "start": 56,
          "end": 86,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2225353,
        "end": 2225474,
        "line": 81586,
        "column": 1,
        "path": "chap12/p@139666",
        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": "CHARLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139791",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCY.\nBut where’s the great Alcides of the field,\nValiant Lord Talbot, Earl of Shrewsbury,\nCreated for his rare success in arms\nGreat Earl of Washford, Waterford, and Valence,\nLord Talbot of Goodrig and Urchinfield,\nLord Strange of Blackmere, Lord Verdun of Alton,\nLord Cromwell of Wingfield, Lord Furnival of Sheffield,\nThe thrice victorious Lord of Falconbridge,\nKnight of the noble Order of Saint George,\nWorthy Saint Michael, and the Golden Fleece,\nGreat Marshal to Henry the Sixth\nOf all his wars within the realm of France?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139791/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@139791/line-2",
          "start": 6,
          "end": 49,
          "sourceLineNumber": null
        },
        {
