          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138811/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138811/line-3",
          "start": 55,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2224498,
        "end": 2224636,
        "line": 81552,
        "column": 1,
        "path": "chap12/p@138811",
        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": "BASTARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138953",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\nO, no, forbear! For that which we have fled\nDuring the life, let us not wrong it dead.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138953/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138953/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138953/line-3",
          "start": 53,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
