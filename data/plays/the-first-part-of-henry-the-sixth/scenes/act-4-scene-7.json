    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140409",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nHere’s a silly stately style indeed!\nThe Turk, that two and fifty kingdoms hath,\nWrites not so tedious a style as this.\nHim that thou magnifiest with all these titles\nStinking and fly-blown lies here at our feet.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140409/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140409/line-2",
          "start": 9,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140409/line-3",
          "start": 46,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140409/line-4",
          "start": 90,
          "end": 128,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140409/line-5",
          "start": 129,
          "end": 175,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140409/line-6",
          "start": 176,
          "end": 221,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2226096,
        "end": 2226367,
        "line": 81608,
        "column": 1,
        "path": "chap12/p@140409",
        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": "PUCELLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCY.\nIs Talbot slain, the Frenchman’s only scourge,\nYour kingdom’s terror and black Nemesis?\nO, were mine eye-balls into bullets turn’d,\nThat I in rage might shoot them at your faces!\nO, that I could but call these dead to life!\nIt were enough to fright the realm of France.\nWere but his picture left amongst you here,\nIt would amaze the proudest of you all.\nGive me their bodies, that I may bear them hence\nAnd give them burial as beseems their worth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-2",
          "start": 6,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-3",
          "start": 53,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-4",
          "start": 94,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-5",
          "start": 138,
          "end": 184,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-6",
          "start": 185,
          "end": 229,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-7",
          "start": 230,
          "end": 275,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-8",
          "start": 276,
          "end": 319,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-9",
          "start": 320,
          "end": 359,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-10",
