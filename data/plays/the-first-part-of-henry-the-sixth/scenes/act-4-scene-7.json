        "end": 2223814,
        "line": 81522,
        "column": 1,
        "path": "chap12/p@138000",
        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": "CHARLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138131",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nHow the young whelp of Talbot’s, raging-wood,\nDid flesh his puny sword in Frenchmen’s blood!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138131/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138131/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138131/line-3",
          "start": 55,
          "end": 101,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2223818,
        "end": 2223954,
        "line": 81528,
        "column": 1,
        "path": "chap12/p@138131",
        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": "BASTARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138271",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nOnce I encounter’d him, and thus I said:\n“Thou maiden youth, be vanquish’d by a maid.”\nBut with a proud majestical high scorn\nHe answer’d thus: “Young Talbot was not born\nTo be the pillage of a giglot wench.”\nSo, rushing in the bowels of the French,\nHe left me proudly, as unworthy fight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138271/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138271/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138271/line-3",
          "start": 50,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138271/line-4",
          "start": 96,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138271/line-5",
          "start": 135,
          "end": 179,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138271/line-6",
          "start": 180,
          "end": 217,
          "sourceLineNumber": null
        },
