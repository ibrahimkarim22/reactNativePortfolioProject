    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138000",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\nHad York and Somerset brought rescue in,\nWe should have found a bloody day of this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138000/line-1",
