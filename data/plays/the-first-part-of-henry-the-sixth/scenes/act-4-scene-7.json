          "end": 408,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@140684/line-11",
          "start": 409,
          "end": 453,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2226371,
        "end": 2226899,
        "line": 81617,
        "column": 1,
        "path": "chap12/p@140684",
        "anchor": "sceneIV_12.7"
      },
      "speakerLabel": "LUCY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@141216",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nI think this upstart is old Talbot’s ghost,\nHe speaks with such a proud commanding spirit.\nFor God’s sake, let him have them; to keep them here,\nThey would but stink and putrify the air.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@141216/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@141216/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
