    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138632",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BURGUNDY.\nDoubtless he would have made a noble knight.\nSee, where he lies inhearsed in the arms\nOf the most bloody nurser of his harms.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138632/line-1",
          "start": 0,
          "end": 9,
