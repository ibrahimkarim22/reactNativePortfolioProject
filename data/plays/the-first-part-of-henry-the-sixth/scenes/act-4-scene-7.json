    {
      "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138811",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BASTARD.\nHew them to pieces, hack their bones asunder,\nWhose life was England’s glory, Gallia’s wonder.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneIV_12.7/p@138811/line-1",
