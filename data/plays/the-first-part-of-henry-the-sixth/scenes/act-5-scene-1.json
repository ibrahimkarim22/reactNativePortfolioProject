      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Sennet. Enter King, Gloucester and Exeter.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 14,
          "end": 30,
          "className": "charname"
        },
        {
          "tag": "span",
