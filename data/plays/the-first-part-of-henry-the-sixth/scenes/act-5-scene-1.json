        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142199",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nHave you perused the letters from the Pope,\nThe Emperor, and the Earl of Armagnac?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142199/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142199/line-2",
          "start": 12,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142199/line-3",
          "start": 56,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2227886,
        "end": 2228015,
        "line": 81671,
        "column": 1,
        "path": "chap12/p@142199",
        "anchor": "sceneV_12.1"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142332",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nI have, my lord; and their intent is this:\nThey humbly sue unto your Excellence\nTo have a godly peace concluded of\nBetween the realms of England and of France.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142332/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142332/line-2",
          "start": 12,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142332/line-3",
          "start": 55,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142332/line-4",
          "start": 92,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142332/line-5",
          "start": 127,
          "end": 171,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2228019,
        "end": 2228235,
        "line": 81677,
        "column": 1,
        "path": "chap12/p@142332",
        "anchor": "sceneV_12.1"
      },
      "speakerLabel": "GLOUCESTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142552",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nHow doth your Grace affect their motion?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142552/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142552/line-2",
          "start": 12,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2228239,
        "end": 2228321,
        "line": 81685,
        "column": 1,
        "path": "chap12/p@142552",
        "anchor": "sceneV_12.1"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142638",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nWell, my good lord, and as the only means\nTo stop effusion of our Christian blood\nAnd stablish quietness on every side.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142638/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142638/line-2",
          "start": 12,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142638/line-3",
          "start": 54,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142638/line-4",
          "start": 94,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2228325,
        "end": 2228496,
        "line": 81690,
        "column": 1,
        "path": "chap12/p@142638",
        "anchor": "sceneV_12.1"
      },
      "speakerLabel": "GLOUCESTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142813",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nAy, marry, uncle, for I always thought\nIt was both impious and unnatural\nThat such immanity and bloody strife\nShould reign among professors of one faith.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142813/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142813/line-2",
          "start": 12,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142813/line-3",
          "start": 51,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142813/line-4",
          "start": 85,
          "end": 121,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@142813/line-5",
          "start": 122,
          "end": 165,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2228500,
        "end": 2228710,
        "line": 81697,
        "column": 1,
        "path": "chap12/p@142813",
        "anchor": "sceneV_12.1"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143027",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nBeside, my lord, the sooner to effect\nAnd surer bind this knot of amity,\nThe Earl of Armagnac, near knit to Charles,\nA man of great authority in France,\nProffers his only daughter to your Grace\nIn marriage, with a large and sumptuous dowry.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143027/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143027/line-2",
          "start": 12,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143027/line-3",
          "start": 50,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143027/line-4",
          "start": 85,
          "end": 128,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143027/line-5",
          "start": 129,
          "end": 164,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143027/line-6",
          "start": 165,
          "end": 205,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143027/line-7",
          "start": 206,
          "end": 252,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2228714,
        "end": 2229021,
        "line": 81705,
        "column": 1,
        "path": "chap12/p@143027",
        "anchor": "sceneV_12.1"
      },
      "speakerLabel": "GLOUCESTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143338",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nMarriage, uncle! Alas, my years are young!\nAnd fitter is my study and my books\nThan wanton dalliance with a paramour.\nYet call th’ ambassadors; and, as you please,\nSo let them have their answers every one.\nI shall be well content with any choice\nTends to God’s glory and my country’s weal.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143338/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143338/line-2",
          "start": 12,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143338/line-3",
          "start": 55,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143338/line-4",
          "start": 91,
          "end": 129,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143338/line-5",
          "start": 130,
          "end": 175,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143338/line-6",
          "start": 176,
          "end": 217,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143338/line-7",
          "start": 218,
          "end": 257,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143338/line-8",
          "start": 258,
          "end": 301,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2229025,
        "end": 2229386,
        "line": 81715,
        "column": 1,
        "path": "chap12/p@143338",
        "anchor": "sceneV_12.1"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143703",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Winchester in Cardinal’s habit, a  Legate and two Ambassadors.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 16,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 41,
          "end": 47,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143703/line-1",
          "start": 0,
          "end": 68,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2229390,
        "end": 2229545,
        "line": 81726,
        "column": 1,
        "path": "chap12/p@143703",
        "anchor": "sceneV_12.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143862",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EXETER.\nWhat, is my Lord of Winchester install’d\nAnd call’d unto a cardinal’s degree?\nThen I perceive that will be verified\nHenry the Fifth did sometime prophesy:\n“If once he come to be a cardinal,\nHe’ll make his cap co-equal with the crown.”",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143862/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143862/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143862/line-3",
          "start": 49,
          "end": 85,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143862/line-4",
          "start": 86,
          "end": 123,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143862/line-5",
          "start": 124,
          "end": 162,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143862/line-6",
          "start": 163,
          "end": 197,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@143862/line-7",
          "start": 198,
          "end": 242,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2229549,
        "end": 2229846,
        "line": 81730,
        "column": 1,
        "path": "chap12/p@143862",
        "anchor": "sceneV_12.1"
      },
      "speakerLabel": "EXETER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@144163",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nMy Lords Ambassadors, your several suits\nHave been consider’d and debated on.\nYour purpose is both good and reasonable;\nAnd therefore are we certainly resolved\nTo draw conditions of a friendly peace,\nWhich by my Lord of Winchester we mean\nShall be transported presently to France.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@144163/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@144163/line-2",
          "start": 12,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@144163/line-3",
          "start": 53,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@144163/line-4",
          "start": 90,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@144163/line-5",
          "start": 132,
          "end": 171,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@144163/line-6",
          "start": 172,
          "end": 211,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@144163/line-7",
          "start": 212,
          "end": 250,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@144163/line-8",
          "start": 251,
          "end": 292,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2229850,
        "end": 2230202,
        "line": 81740,
        "column": 1,
        "path": "chap12/p@144163",
        "anchor": "sceneV_12.1"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.1/p@144519",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nAnd for the proffer of my lord your master,\nI have inform’d his Highness so at large,\nAs liking of the lady’s virtuous gifts,\nHer beauty and the value of her dower,\nHe doth intend she shall be England’s Queen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
