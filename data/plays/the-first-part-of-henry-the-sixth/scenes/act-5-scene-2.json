    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146006",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Charles, Burgundy, Alençon, Bastard, Reignier, La Pucelle and forces.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 63,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146006/line-1",
          "start": 0,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2231693,
        "end": 2231824,
        "line": 81800,
        "column": 1,
        "path": "chap12/p@146006",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146141",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\nThese news, my lords, may cheer our drooping spirits:\n’Tis said the stout Parisians do revolt\nAnd turn again unto the warlike French.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146141/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146141/line-2",
          "start": 9,
          "end": 62,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146141/line-3",
          "start": 63,
          "end": 102,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146141/line-4",
          "start": 103,
          "end": 142,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2231828,
        "end": 2232010,
        "line": 81803,
        "column": 1,
        "path": "chap12/p@146141",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": "CHARLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146327",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALENÇON.\nThen march to Paris, royal Charles of France,\nAnd keep not back your powers in dalliance.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146327/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146327/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146327/line-3",
          "start": 55,
          "end": 98,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2232014,
        "end": 2232147,
        "line": 81810,
        "column": 1,
        "path": "chap12/p@146327",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": "ALENÇON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146464",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nPeace be amongst them, if they turn to us;\nElse ruin combat with their palaces!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146464/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146464/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146464/line-3",
          "start": 52,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2232151,
        "end": 2232274,
        "line": 81816,
        "column": 1,
        "path": "chap12/p@146464",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": "PUCELLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146591",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Scout.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 11,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146591/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2232278,
        "end": 2232345,
        "line": 81822,
        "column": 1,
        "path": "chap12/p@146591",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146662",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCOUT.\nSuccess unto our valiant general,\nAnd happiness to his accomplices!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146662/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146662/line-2",
          "start": 7,
          "end": 40,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146662/line-3",
          "start": 41,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2232349,
        "end": 2232458,
        "line": 81824,
        "column": 1,
        "path": "chap12/p@146662",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": "SCOUT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146775",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\nWhat tidings send our scouts? I prithee, speak.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146775/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146775/line-2",
          "start": 9,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2232462,
        "end": 2232548,
        "line": 81830,
        "column": 1,
        "path": "chap12/p@146775",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": "CHARLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146865",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCOUT.\nThe English army, that divided was\nInto two parties, is now conjoin’d in one,\nAnd means to give you battle presently.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146865/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146865/line-2",
          "start": 7,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146865/line-3",
          "start": 42,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@146865/line-4",
          "start": 85,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2232552,
        "end": 2232716,
        "line": 81835,
        "column": 1,
        "path": "chap12/p@146865",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": "SCOUT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147033",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\nSomewhat too sudden, sirs, the warning is;\nBut we will presently provide for them.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147033/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147033/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147033/line-3",
          "start": 52,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2232720,
        "end": 2232846,
        "line": 81842,
        "column": 1,
        "path": "chap12/p@147033",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": "CHARLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147163",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BURGUNDY.\nI trust the ghost of Talbot is not there.\nNow he is gone, my lord, you need not fear.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147163/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147163/line-2",
          "start": 10,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147163/line-3",
          "start": 52,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2232850,
        "end": 2232980,
        "line": 81848,
        "column": 1,
        "path": "chap12/p@147163",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": "BURGUNDY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147297",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PUCELLE.\nOf all base passions, fear is most accursed.\nCommand the conquest, Charles, it shall be thine;\nLet Henry fret and all the world repine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147297/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147297/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147297/line-3",
          "start": 54,
          "end": 103,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147297/line-4",
          "start": 104,
          "end": 144,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2232984,
        "end": 2233168,
        "line": 81854,
        "column": 1,
        "path": "chap12/p@147297",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": "PUCELLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147485",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHARLES.\nThen on, my lords; and France be fortunate!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147485/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147485/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2233172,
        "end": 2233254,
        "line": 81861,
        "column": 1,
        "path": "chap12/p@147485",
        "anchor": "sceneV_12.2"
      },
      "speakerLabel": "CHARLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.2/p@147571",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt.]",
      "separatorAfter": "\n\n",
      "spans": [
