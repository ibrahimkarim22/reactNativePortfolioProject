    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@171418",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nYour wondrous rare description, noble earl,\nOf beauteous Margaret hath astonish’d me.\nHer virtues graced with external gifts\nDo breed love’s settled passions in my heart,\nAnd like as rigor of tempestuous gusts\nProvokes the mightiest hulk against the tide,\nSo am I driven by breath of her renown\nEither to suffer shipwreck or arrive\nWhere I may have fruition of her love.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@171418/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@171418/line-2",
          "start": 12,
          "end": 55,
          "sourceLineNumber": null
        },
        {
