    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172450",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nAnd otherwise will Henry ne’er presume.\nTherefore, my Lord Protector, give consent\nThat Margaret may be England’s royal queen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172450/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172450/line-2",
          "start": 12,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172450/line-3",
          "start": 52,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172450/line-4",
          "start": 95,
          "end": 138,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2258137,
        "end": 2258315,
        "line": 82802,
        "column": 1,
        "path": "chap12/p@172450",
        "anchor": "sceneV_12.5"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
