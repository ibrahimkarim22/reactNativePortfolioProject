      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172632",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nSo should I give consent to flatter sin.\nYou know, my lord, your Highness is betroth’d\nUnto another lady of esteem.\nHow shall we then dispense with that contract,\nAnd not deface your honour with reproach?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172632/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172632/line-2",
          "start": 12,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172632/line-3",
          "start": 53,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172632/line-4",
          "start": 99,
          "end": 127,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172632/line-5",
          "start": 128,
          "end": 174,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172632/line-6",
          "start": 175,
          "end": 216,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2258319,
        "end": 2258585,
        "line": 82809,
        "column": 1,
        "path": "chap12/p@172632",
        "anchor": "sceneV_12.5"
      },
      "speakerLabel": "GLOUCESTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172902",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SUFFOLK.\nAs doth a ruler with unlawful oaths;\nOr one that, at a triumph having vow’d\nTo try his strength, forsaketh yet the lists\nBy reason of his adversary’s odds.\nA poor earl’s daughter is unequal odds,\nAnd therefore may be broke without offence.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172902/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172902/line-2",
          "start": 9,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172902/line-3",
          "start": 46,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172902/line-4",
          "start": 85,
          "end": 129,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-henry-the-sixth/sceneV_12.5/p@172902/line-5",
          "start": 130,
          "end": 164,
          "sourceLineNumber": null
        },
        {
