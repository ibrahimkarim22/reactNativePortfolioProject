    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneI_9.1/p@5947",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nIt seems then that the tidings of this broil\nBrake off our business for the Holy Land.",
