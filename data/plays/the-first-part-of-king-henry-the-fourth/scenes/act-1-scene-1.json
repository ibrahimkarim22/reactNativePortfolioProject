      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WESTMORELAND.\nIn faith, it is a conquest for a prince to boast of.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneI_9.1/p@7390/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
