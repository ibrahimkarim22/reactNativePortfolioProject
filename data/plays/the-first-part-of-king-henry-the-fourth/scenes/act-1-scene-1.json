    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneI_9.1/p@8397",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WESTMORELAND.\nThis is his uncle’s teaching, this is Worcester,\nMalevolent to you in all aspects,\nWhich makes him prune himself, and bristle up\nThe crest of youth against your dignity.",
      "separatorAfter": "\n\n",
      "spans": [],
