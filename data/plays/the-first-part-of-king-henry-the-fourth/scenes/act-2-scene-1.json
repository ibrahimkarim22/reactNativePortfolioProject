        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41573",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nAt hand, quoth pick-purse.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41573/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41573/line-2",
          "start": 13,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1552698,
        "end": 1552767,
        "line": 58620,
        "column": 1,
        "path": "chap09/p@41573",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41646",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GADSHILL.\nThat’s even as fair as “at hand, quoth the chamberlain,” for thou variest no more from picking of purses than giving direction doth from labouring; thou layest the plot how.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41646/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41646/line-2",
          "start": 10,
          "end": 183,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1552771,
        "end": 1552986,
        "line": 58625,
        "column": 1,
        "path": "chap09/p@41646",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "GADSHILL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41865",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nGood morrow, Master Gadshill. It holds current that I told you yesternight: there’s a franklin in the Wild of Kent hath brought three hundred marks with him in gold. I heard him tell it to one of his company last night at supper; a kind of auditor, one that hath abundance of charge too, God knows what. They are up already, and call for eggs and butter. They will away presently.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41865/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41865/line-2",
          "start": 13,
          "end": 393,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1552990,
        "end": 1553418,
        "line": 58632,
        "column": 1,
        "path": "chap09/p@41865",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@42297",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GADSHILL.\nSirrah, if they meet not with Saint Nicholas’ clerks, I’ll give thee this neck.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@42297/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@42297/line-2",
          "start": 10,
          "end": 89,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1553422,
        "end": 1553542,
        "line": 58642,
        "column": 1,
        "path": "chap09/p@42297",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "GADSHILL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@42421",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nNo, I’ll none of it. I pray thee, keep that for the hangman, for I know thou worshippest Saint Nicholas as truly as a man of falsehood may.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@42421/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@42421/line-2",
          "start": 13,
          "end": 152,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1553546,
        "end": 1553729,
        "line": 58648,
        "column": 1,
        "path": "chap09/p@42421",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@42608",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GADSHILL.\nWhat talkest thou to me of the hangman? If I hang, I’ll make a fat pair of gallows; for, if I hang, old Sir John hangs with me, and thou knowest he is no starveling. Tut, there are other Troyans that thou dream’st not of, the which for sport sake are content to do the profession some grace, that would, if matters should be looked into, for their own credit sake make all whole. I am joined with no foot-land-rakers, no long-staff sixpenny strikers, none of these mad mustachio purple-hued malt-worms, but with nobility and tranquillity, burgomasters and great oneyers, such as can hold in, such as will strike sooner than speak, and speak sooner than drink, and drink sooner than pray: and yet, zounds, I lie, for they pray continually to their saint the commonwealth, or rather not pray to her, but prey on her, for they ride up and down on her, and make her their boots.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@42608/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@42608/line-2",
          "start": 10,
          "end": 884,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1553733,
        "end": 1554658,
        "line": 58654,
        "column": 1,
        "path": "chap09/p@42608",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "GADSHILL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43537",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nWhat, the commonwealth their boots? Will she hold out water in foul way?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43537/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43537/line-2",
          "start": 13,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1554662,
        "end": 1554777,
        "line": 58670,
        "column": 1,
        "path": "chap09/p@43537",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43656",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GADSHILL.\nShe will, she will; justice hath liquored her. We steal as in a castle, cock-sure; we have the receipt of fern-seed, we walk invisible.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43656/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43656/line-2",
          "start": 10,
          "end": 145,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1554781,
        "end": 1554957,
        "line": 58675,
        "column": 1,
        "path": "chap09/p@43656",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "GADSHILL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43836",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nNay, by my faith, I think you are more beholding to the night than to fern-seed for your walking invisible.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43836/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43836/line-2",
          "start": 13,
          "end": 120,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1554961,
        "end": 1555112,
        "line": 58681,
        "column": 1,
        "path": "chap09/p@43836",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43991",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GADSHILL.\nGive me thy hand. Thou shalt have a share in our purchase, as I am a true man.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43991/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@43991/line-2",
          "start": 10,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1555116,
        "end": 1555234,
        "line": 58687,
        "column": 1,
        "path": "chap09/p@43991",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "GADSHILL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@44113",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CHAMBERLAIN.\nNay, rather let me have it, as you are a false thief.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@44113/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@44113/line-2",
          "start": 13,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1555238,
        "end": 1555334,
        "line": 58692,
        "column": 1,
        "path": "chap09/p@44113",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "CHAMBERLAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@44213",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
