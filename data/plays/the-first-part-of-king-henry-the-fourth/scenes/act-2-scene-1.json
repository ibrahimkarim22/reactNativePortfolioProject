        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38485",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CARRIER.\nHeigh-ho! an it be not four by the day, I’ll be hang’d. Charles’ wain is over the new chimney, and yet our horse not pack’d.—What, ostler!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38485/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38485/line-2",
          "start": 15,
          "end": 153,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1549610,
        "end": 1549795,
        "line": 58494,
        "column": 1,
        "path": "chap09/p@38485",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "FIRST CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38674",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OSTLER.\n[within.] Anon, anon.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 9,
          "end": 16
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38674/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38674/line-2",
          "start": 8,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1549799,
        "end": 1549865,
        "line": 58501,
        "column": 1,
        "path": "chap09/p@38674",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "OSTLER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38744",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CARRIER.\nI prithee, Tom, beat Cut’s saddle, put a few flocks in the point; poor jade is wrung in the withers out of all cess.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38744/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38744/line-2",
          "start": 15,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1549869,
        "end": 1550031,
        "line": 58506,
        "column": 1,
        "path": "chap09/p@38744",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "FIRST CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38910",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter another Carrier.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 14,
          "end": 21,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38910/line-1",
          "start": 0,
          "end": 22,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1550035,
        "end": 1550114,
        "line": 58512,
        "column": 1,
        "path": "chap09/p@38910",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38993",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CARRIER.\nPeas and beans are as dank here as a dog, and that is the next way to give poor jades the bots. This house is turned upside down since Robin ostler died.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38993/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38993/line-2",
          "start": 16,
          "end": 169,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1550118,
        "end": 1550318,
        "line": 58515,
        "column": 1,
        "path": "chap09/p@38993",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "SECOND CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39197",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CARRIER.\nPoor fellow never joyed since the price of oats rose, it was the death of him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39197/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39197/line-2",
          "start": 15,
          "end": 93,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1550322,
        "end": 1550445,
        "line": 58521,
        "column": 1,
        "path": "chap09/p@39197",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "FIRST CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39324",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CARRIER.\nI think this be the most villainous house in all London road for fleas. I am stung like a tench.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39324/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39324/line-2",
          "start": 16,
          "end": 112,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1550449,
        "end": 1550592,
        "line": 58526,
        "column": 1,
        "path": "chap09/p@39324",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "SECOND CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39471",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CARRIER.\nLike a tench! By the Mass, there is ne’er a king christen could be better bit than I have been since the first cock.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39471/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39471/line-2",
          "start": 15,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1550596,
        "end": 1550758,
        "line": 58532,
        "column": 1,
        "path": "chap09/p@39471",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "FIRST CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39637",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CARRIER.\nWhy, they will allow us ne’er a jordan, and then we leak in your chimney, and your chamber-lye breeds fleas like a loach.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39637/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39637/line-2",
          "start": 16,
          "end": 137,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1550762,
        "end": 1550930,
        "line": 58538,
        "column": 1,
        "path": "chap09/p@39637",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "SECOND CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39809",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CARRIER.\nWhat, ostler! Come away and be hanged, come away.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39809/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39809/line-2",
          "start": 15,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1550934,
        "end": 1551028,
        "line": 58544,
        "column": 1,
        "path": "chap09/p@39809",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "FIRST CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39907",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CARRIER.\nI have a gammon of bacon and two razes of ginger, to be delivered as far as Charing Cross.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39907/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@39907/line-2",
          "start": 16,
          "end": 106,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1551032,
        "end": 1551169,
        "line": 58549,
        "column": 1,
        "path": "chap09/p@39907",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "SECOND CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40048",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CARRIER.\nGod’s body! The turkeys in my pannier are quite starved.—What, ostler! A plague on thee! Hast thou never an eye in thy head? Canst not hear? An ’twere not as good deed as drink to break the pate on thee, I am a very villain. Come, and be hanged. Hast no faith in thee?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40048/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40048/line-2",
          "start": 15,
          "end": 283,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1551173,
        "end": 1551489,
        "line": 58555,
        "column": 1,
        "path": "chap09/p@40048",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "FIRST CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40368",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Gadshill.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40368/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1551493,
        "end": 1551565,
        "line": 58563,
        "column": 1,
        "path": "chap09/p@40368",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40444",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GADSHILL.\nGood morrow, carriers. What’s o’clock?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40444/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40444/line-2",
          "start": 10,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1551569,
        "end": 1551647,
        "line": 58566,
        "column": 1,
        "path": "chap09/p@40444",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "GADSHILL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40526",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CARRIER.\nI think it be two o’clock.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40526/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40526/line-2",
          "start": 15,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1551651,
        "end": 1551722,
        "line": 58571,
        "column": 1,
        "path": "chap09/p@40526",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "FIRST CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40601",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GADSHILL.\nI prithee, lend me thy lantern, to see my gelding in the stable.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40601/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40601/line-2",
          "start": 10,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1551726,
        "end": 1551830,
        "line": 58576,
        "column": 1,
        "path": "chap09/p@40601",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "GADSHILL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40709",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST CARRIER.\nNay, by God, soft! I know a trick worth two of that, i’faith.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40709/line-1",
          "start": 0,
