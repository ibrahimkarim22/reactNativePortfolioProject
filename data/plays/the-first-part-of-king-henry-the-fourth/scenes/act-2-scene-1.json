      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter a Carrier with a lantern in his hand.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 15,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@38381/line-1",
          "start": 0,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1549506,
        "end": 1549606,
        "line": 58491,
        "column": 1,
        "path": "chap09/p@38381",
