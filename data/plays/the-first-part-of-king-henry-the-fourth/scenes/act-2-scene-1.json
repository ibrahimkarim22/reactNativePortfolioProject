    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40819",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GADSHILL.\nI pray thee, lend me thine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40819/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40819/line-2",
          "start": 10,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1551944,
        "end": 1552011,
        "line": 58586,
        "column": 1,
        "path": "chap09/p@40819",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "GADSHILL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40890",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CARRIER.\nAy, when? Canst tell? “Lend me thy lantern,” quoth he! Marry, I’ll see thee hanged first.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40890/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@40890/line-2",
          "start": 16,
          "end": 105,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1552015,
        "end": 1552151,
        "line": 58591,
        "column": 1,
        "path": "chap09/p@40890",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "SECOND CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41030",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GADSHILL.\nSirrah carrier, what time do you mean to come to London?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41030/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41030/line-2",
          "start": 10,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1552155,
        "end": 1552251,
        "line": 58597,
        "column": 1,
        "path": "chap09/p@41030",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "GADSHILL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41130",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND CARRIER.\nTime enough to go to bed with a candle, I warrant thee. Come, neighbour Mugs, we’ll call up the gentlemen. They will along with company, for they have great charge.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41130/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41130/line-2",
          "start": 16,
          "end": 180,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1552255,
        "end": 1552467,
        "line": 58602,
        "column": 1,
        "path": "chap09/p@41130",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "SECOND CARRIER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41346",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt Carriers.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 16,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 17
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41346/line-1",
          "start": 0,
          "end": 18,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1552471,
        "end": 1552549,
        "line": 58609,
        "column": 1,
        "path": "chap09/p@41346",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41428",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GADSHILL.\nWhat, ho! Chamberlain!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41428/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41428/line-2",
          "start": 10,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1552553,
        "end": 1552615,
        "line": 58612,
        "column": 1,
        "path": "chap09/p@41428",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": "GADSHILL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41494",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Chamberlain.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 17,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.1/p@41494/line-1",
          "start": 0,
          "end": 18,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1552619,
        "end": 1552694,
        "line": 58617,
        "column": 1,
        "path": "chap09/p@41494",
        "anchor": "sceneII_9.1"
      },
      "speakerLabel": null,
