      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.3/p@57474",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LADY PERCY.\nCome, come, you paraquito, answer me\nDirectly unto this question that I ask.\nIn faith, I’ll break thy little finger, Harry,\nIf thou wilt not tell me all things true.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.3/p@57474/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
