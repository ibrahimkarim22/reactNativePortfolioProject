      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOTSPUR.\nWhy, my horse, my love, my horse.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.3/p@56984/line-1",
