    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.3/p@58057",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LADY PERCY.\nDo you not love me? Do you not indeed?\nWell, do not, then, for since you love me not,\nI will not love myself. Do you not love me?\nNay, tell me if you speak in jest or no.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.3/p@58057/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.3/p@58057/line-2",
          "start": 12,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.3/p@58057/line-3",
          "start": 51,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.3/p@58057/line-4",
          "start": 98,
          "end": 141,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.3/p@58057/line-5",
          "start": 142,
          "end": 182,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1569182,
        "end": 1569409,
        "line": 59204,
        "column": 1,
        "path": "chap09/p@58057",
        "anchor": "sceneII_9.3"
      },
      "speakerLabel": "LADY PERCY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneII_9.3/p@58288",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOTSPUR.\nCome, wilt thou see me ride?\nAnd when I am a-horseback I will swear\nI love thee infinitely. But hark you, Kate,\nI must not have you henceforth question me\nWhither I go, nor reason whereabout.\nWhither I must, I must; and, to conclude,\nThis evening must I leave you, gentle Kate.\nI know you wise, but yet no farther wise\nThan Harry Percy’s wife; constant you are,\nBut yet a woman; and for secrecy,\nNo lady closer, for I well believe\nThou wilt not utter what thou dost not know;\nAnd so far will I trust thee, gentle Kate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
