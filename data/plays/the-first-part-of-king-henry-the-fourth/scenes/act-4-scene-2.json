      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@144206",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WESTMORELAND.\nHe is, Sir John. I fear we shall stay too long.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
