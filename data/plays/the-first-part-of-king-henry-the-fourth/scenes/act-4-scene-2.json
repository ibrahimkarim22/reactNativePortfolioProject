    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143457",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nTut, tut, good enough to toss; food for powder, food for powder, they’ll fill a pit as well as better. Tush, man, mortal men, mortal men.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143457/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143457/line-2",
          "start": 10,
          "end": 147,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1654582,
        "end": 1654760,
        "line": 62326,
        "column": 1,
        "path": "chap09/p@143457",
        "anchor": "sceneIV_9.2"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143639",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WESTMORELAND.\nAy, but, Sir John, methinks they are exceeding poor and bare, too beggarly.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143639/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143639/line-2",
          "start": 14,
          "end": 89,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1654764,
        "end": 1654883,
        "line": 62332,
        "column": 1,
        "path": "chap09/p@143639",
        "anchor": "sceneIV_9.2"
      },
      "speakerLabel": "WESTMORELAND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143762",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nFaith, for their poverty, I know not where they had that; and for their bareness, I am sure they never learned that of me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143762/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143762/line-2",
          "start": 10,
          "end": 132,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1654887,
        "end": 1655050,
        "line": 62337,
        "column": 1,
        "path": "chap09/p@143762",
        "anchor": "sceneIV_9.2"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143929",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PRINCE.\nNo, I’ll be sworn, unless you call three fingers on the ribs bare. But, sirrah, make haste. Percy is already in the field.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@143929/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
