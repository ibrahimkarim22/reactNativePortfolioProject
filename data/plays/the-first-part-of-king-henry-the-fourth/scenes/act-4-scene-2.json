      },
      "speakerLabel": "BARDOLPH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140334",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 6
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140334/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1651459,
        "end": 1651496,
        "line": 62249,
        "column": 1,
        "path": "chap09/p@140334",
        "anchor": "sceneIV_9.2"
      },
      "speakerLabel": null,
