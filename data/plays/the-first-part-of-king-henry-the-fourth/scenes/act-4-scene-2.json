      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BARDOLPH.\nWill you give me money, captain?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@139866/line-1",
