    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140003",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BARDOLPH.\nThis bottle makes an angel.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140003/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140003/line-2",
          "start": 10,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1651128,
        "end": 1651195,
        "line": 62232,
        "column": 1,
        "path": "chap09/p@140003",
        "anchor": "sceneIV_9.2"
      },
      "speakerLabel": "BARDOLPH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140074",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nAn if it do, take it for thy labour. An if it make twenty, take them all, I’ll answer the coinage. Bid my lieutenant Peto meet me at town’s end.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140074/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140074/line-2",
          "start": 10,
          "end": 154,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1651199,
        "end": 1651385,
        "line": 62237,
        "column": 1,
        "path": "chap09/p@140074",
        "anchor": "sceneIV_9.2"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140264",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BARDOLPH.\nI will, captain: farewell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140264/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@140264/line-2",
          "start": 10,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
