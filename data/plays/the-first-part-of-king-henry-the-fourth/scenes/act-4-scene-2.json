    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@144135",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nWhat, is the King encamped?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.2/p@144135/line-1",
