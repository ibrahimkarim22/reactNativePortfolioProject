          "start": 57,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152873/line-4",
          "start": 100,
          "end": 144,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152873/line-5",
          "start": 145,
          "end": 187,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152873/line-6",
          "start": 188,
          "end": 224,
          "sourceLineNumber": null
        },
