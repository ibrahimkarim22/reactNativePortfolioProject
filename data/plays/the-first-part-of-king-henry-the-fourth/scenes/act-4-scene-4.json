    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@151452",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCHBISHOP.\nHie, good Sir Michael; bear this sealed brief\nWith winged haste to the Lord Marshal,\nThis to my cousin Scroop, and all the rest\nTo whom they are directed. If you knew\nHow much they do import, you would make haste.",
      "separatorAfter": "\n\n",
      "spans": [],
