    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@153191",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR MICHAEL.\nDoubt not, my lord, they shall be well opposed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@153191/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@153191/line-2",
          "start": 13,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1664316,
        "end": 1664406,
        "line": 62690,
        "column": 1,
        "path": "chap09/p@153191",
        "anchor": "sceneIV_9.4"
      },
      "speakerLabel": "SIR MICHAEL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@153285",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCHBISHOP.\nI hope no less, yet needful ’tis to fear;\nAnd to prevent the worst, Sir Michael, speed.\nFor if Lord Percy thrive not, ere the King\nDismiss his power he means to visit us,\nFor he hath heard of our confederacy,\nAnd ’tis but wisdom to make strong against him.\nTherefore make haste. I must go write again\nTo other friends; and so, farewell, Sir Michael.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@153285/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
