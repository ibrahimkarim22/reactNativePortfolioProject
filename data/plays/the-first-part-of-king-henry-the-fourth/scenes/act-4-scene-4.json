    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152488",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR MICHAEL.\nWhy, my good lord, you need not fear,\nThere is Douglas and Lord Mortimer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152488/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152488/line-2",
          "start": 13,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152488/line-3",
          "start": 51,
          "end": 86,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1663613,
        "end": 1663734,
        "line": 62662,
        "column": 1,
        "path": "chap09/p@152488",
        "anchor": "sceneIV_9.4"
      },
      "speakerLabel": "SIR MICHAEL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152613",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCHBISHOP.\nNo, Mortimer is not there.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152613/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152613/line-2",
          "start": 12,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1663738,
        "end": 1663806,
        "line": 62668,
        "column": 1,
        "path": "chap09/p@152613",
        "anchor": "sceneIV_9.4"
      },
      "speakerLabel": "ARCHBISHOP.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152685",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR MICHAEL.\nBut there is Mordake, Vernon, Lord Harry Percy,\nAnd there is my Lord of Worcester, and a head\nOf gallant warriors, noble gentlemen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152685/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152685/line-2",
          "start": 13,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152685/line-3",
          "start": 61,
          "end": 106,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152685/line-4",
          "start": 107,
          "end": 144,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1663810,
        "end": 1663994,
        "line": 62673,
        "column": 1,
        "path": "chap09/p@152685",
        "anchor": "sceneIV_9.4"
      },
      "speakerLabel": "SIR MICHAEL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152873",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCHBISHOP.\nAnd so there is. But yet the King hath drawn\nThe special head of all the land together:\nThe Prince of Wales, Lord John of Lancaster,\nThe noble Westmoreland, and warlike Blunt,\nAnd many more corrivals and dear men\nOf estimation and command in arms.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneIV_9.4/p@152873/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
