      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR MICHAEL.\nMy good lord,\nI guess their tenour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
