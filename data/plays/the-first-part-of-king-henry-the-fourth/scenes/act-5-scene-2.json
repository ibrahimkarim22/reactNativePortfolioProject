      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nMy lord, prepare. The King comes on apace.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.2/p@167178/line-1",
