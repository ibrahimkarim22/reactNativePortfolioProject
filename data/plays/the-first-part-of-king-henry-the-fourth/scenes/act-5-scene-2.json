    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.2/p@164184",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WORCESTER.\nI told him gently of our grievances,\nOf his oath-breaking; which he mended thus,\nBy now forswearing that he is forsworn.\nHe calls us rebels, traitors, and will scourge\nWith haughty arms this hateful name in us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
