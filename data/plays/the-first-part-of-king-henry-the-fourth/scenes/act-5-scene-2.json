          "start": 11,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1677694,
        "end": 1677769,
        "line": 63121,
        "column": 1,
        "path": "chap09/p@166569",
        "anchor": "sceneV_9.2"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.2/p@166648",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOTSPUR.\nI cannot read them now.—\nO gentlemen, the time of life is short!\nTo spend that shortness basely were too long\nIf life did ride upon a dial’s point,\nStill ending at the arrival of an hour.\nAnd if we live, we live to tread on kings;\nIf die, brave death, when princes die with us!\nNow, for our consciences, the arms are fair\nWhen the intent of bearing them is just.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.2/p@166648/line-1",
