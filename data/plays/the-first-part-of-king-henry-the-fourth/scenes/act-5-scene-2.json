      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WORCESTER.\nThe Prince of Wales stepp’d forth before the King,\nAnd, nephew, challenged you to single fight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.2/p@164769/line-1",
