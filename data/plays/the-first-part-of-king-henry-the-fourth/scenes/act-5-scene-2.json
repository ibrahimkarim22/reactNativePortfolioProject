    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.2/p@166569",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nMy lord, here are letters for you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.2/p@166569/line-1",
          "start": 0,
          "end": 10,
