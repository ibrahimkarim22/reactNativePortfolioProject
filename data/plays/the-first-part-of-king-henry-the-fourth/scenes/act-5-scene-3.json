    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@170205",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Alarums. Enter Falstaff solus.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 15,
          "end": 23,
          "className": "charname"
        }
      ],
      "lines": [
        {
