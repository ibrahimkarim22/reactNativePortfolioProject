        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168173",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BLUNT.\nWhat is thy name that in the battle thus\nThou crossest me? What honour dost thou seek\nUpon my head?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168173/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168173/line-2",
          "start": 7,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168173/line-3",
          "start": 48,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168173/line-4",
          "start": 93,
          "end": 106,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1679298,
        "end": 1679444,
        "line": 63172,
        "column": 1,
        "path": "chap09/p@168173",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "BLUNT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168323",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOUGLAS.\nKnow then my name is Douglas,\nAnd I do haunt thee in the battle thus\nBecause some tell me that thou art a king.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168323/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168323/line-2",
          "start": 9,
          "end": 38,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168323/line-3",
          "start": 39,
          "end": 77,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168323/line-4",
          "start": 78,
          "end": 120,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1679448,
        "end": 1679608,
        "line": 63179,
        "column": 1,
        "path": "chap09/p@168323",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "DOUGLAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168487",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BLUNT.\nThey tell thee true.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168487/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168487/line-2",
          "start": 7,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1679612,
        "end": 1679669,
        "line": 63186,
        "column": 1,
        "path": "chap09/p@168487",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "BLUNT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168548",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOUGLAS.\nThe Lord of Stafford dear today hath bought\nThy likeness, for instead of thee, King Harry,\nThis sword hath ended him. So shall it thee,\nUnless thou yield thee as my prisoner.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168548/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168548/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168548/line-3",
          "start": 53,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168548/line-4",
          "start": 100,
          "end": 144,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168548/line-5",
          "start": 145,
          "end": 183,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1679673,
        "end": 1679901,
        "line": 63191,
        "column": 1,
        "path": "chap09/p@168548",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "DOUGLAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168780",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BLUNT.\nI was not born a yielder, thou proud Scot,\nAnd thou shalt find a king that will revenge\nLord Stafford’s death.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168780/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168780/line-2",
          "start": 7,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168780/line-3",
          "start": 50,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168780/line-4",
          "start": 95,
          "end": 117,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1679905,
        "end": 1680062,
        "line": 63199,
        "column": 1,
        "path": "chap09/p@168780",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "BLUNT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168941",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[They fight, and Blunt is slain.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 17,
          "end": 22,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 32
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@168941/line-1",
          "start": 0,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1680066,
        "end": 1680160,
        "line": 63206,
        "column": 1,
        "path": "chap09/p@168941",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169039",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Hotspur.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169039/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1680164,
        "end": 1680235,
        "line": 63210,
        "column": 1,
        "path": "chap09/p@169039",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169114",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOTSPUR.\nO Douglas, hadst thou fought at Holmedon thus,\nI never had triumphed upon a Scot.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169114/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169114/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169114/line-3",
          "start": 56,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1680239,
        "end": 1680364,
        "line": 63213,
        "column": 1,
        "path": "chap09/p@169114",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "HOTSPUR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169243",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOUGLAS.\nAll’s done, all’s won; here breathless lies the King.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169243/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169243/line-2",
          "start": 9,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1680368,
        "end": 1680460,
        "line": 63219,
        "column": 1,
        "path": "chap09/p@169243",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "DOUGLAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169339",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOTSPUR.\nWhere?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169339/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169339/line-2",
          "start": 9,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1680464,
        "end": 1680509,
        "line": 63224,
        "column": 1,
        "path": "chap09/p@169339",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "HOTSPUR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169388",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOUGLAS.\nHere.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169388/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169388/line-2",
          "start": 9,
          "end": 14,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1680513,
        "end": 1680557,
        "line": 63229,
        "column": 1,
        "path": "chap09/p@169388",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "DOUGLAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169436",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOTSPUR.\nThis, Douglas? No, I know this face full well.\nA gallant knight he was, his name was Blunt,\nSemblably furnish’d like the King himself.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169436/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169436/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169436/line-3",
          "start": 56,
          "end": 100,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169436/line-4",
          "start": 101,
          "end": 143,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1680561,
        "end": 1680744,
        "line": 63234,
        "column": 1,
        "path": "chap09/p@169436",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "HOTSPUR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169623",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOUGLAS.\nA fool go with thy soul, whither it goes!\nA borrow’d title hast thou bought too dear.\nWhy didst thou tell me that thou wert a king?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169623/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169623/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169623/line-3",
          "start": 51,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169623/line-4",
          "start": 95,
          "end": 140,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1680748,
        "end": 1680928,
        "line": 63241,
        "column": 1,
        "path": "chap09/p@169623",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "DOUGLAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169807",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOTSPUR.\nThe King hath many marching in his coats.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169807/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@169807/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1680932,
        "end": 1681012,
        "line": 63248,
        "column": 1,
