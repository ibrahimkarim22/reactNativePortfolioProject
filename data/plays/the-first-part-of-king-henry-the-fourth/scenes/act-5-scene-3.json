    "title": "SCENE III. Plain between the Camps.",
    "location": "Plain between the Camps.",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-stage-001",
      "type": "stage",
      "text": "The King enters with his power. Alarum to the battle. Then enter Douglas and Sir Walter Blunt."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "blunt",
        "name": "BLUNT",
        "displayName": "Blunt"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "What is thy name that in the battle thus",
          "plainText": "What is thy name that in the battle thus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Thou crossest me? What honour dost thou seek",
          "plainText": "Thou crossest me What honour dost thou seek",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Upon my head?",
          "plainText": "Upon my head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "douglas",
        "name": "DOUGLAS",
        "displayName": "Douglas"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Know then my name is Douglas,",
          "plainText": "Know then my name is Douglas",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "And I do haunt thee in the battle thus",
          "plainText": "And I do haunt thee in the battle thus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Because some tell me that thou art a king.",
          "plainText": "Because some tell me that thou art a king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "blunt",
        "name": "BLUNT",
        "displayName": "Blunt"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "They tell thee true.",
          "plainText": "They tell thee true",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "douglas",
        "name": "DOUGLAS",
        "displayName": "Douglas"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "The Lord of Stafford dear today hath bought",
          "plainText": "The Lord of Stafford dear today hath bought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Thy likeness, for instead of thee, King Harry,",
          "plainText": "Thy likeness for instead of thee King Harry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "This sword hath ended him. So shall it thee,",
          "plainText": "This sword hath ended him So shall it thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Unless thou yield thee as my prisoner.",
          "plainText": "Unless thou yield thee as my prisoner",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "blunt",
        "name": "BLUNT",
        "displayName": "Blunt"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "I was not born a yielder, thou proud Scot,",
          "plainText": "I was not born a yielder thou proud Scot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "And thou shalt find a king that will revenge",
          "plainText": "And thou shalt find a king that will revenge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Lord Stafford's death.",
          "plainText": "Lord Stafford's death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-stage-002",
      "type": "stage",
      "text": "[They fight, and Blunt is slain.]"
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-stage-003",
      "type": "stage",
      "text": "Enter Hotspur."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "hotspur",
        "name": "HOTSPUR",
        "displayName": "Hotspur"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "O Douglas, hadst thou fought at Holmedon thus,",
          "plainText": "O Douglas hadst thou fought at Holmedon thus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "I never had triumphed upon a Scot.",
          "plainText": "I never had triumphed upon a Scot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "douglas",
        "name": "DOUGLAS",
        "displayName": "Douglas"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "All's done, all's won; here breathless lies the King.",
          "plainText": "All's done all's won here breathless lies the King",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "hotspur",
        "name": "HOTSPUR",
        "displayName": "Hotspur"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Where?",
          "plainText": "Where",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "douglas",
        "name": "DOUGLAS",
        "displayName": "Douglas"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Here.",
          "plainText": "Here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "hotspur",
        "name": "HOTSPUR",
        "displayName": "Hotspur"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "This, Douglas? No, I know this face full well.",
          "plainText": "This Douglas No I know this face full well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "A gallant knight he was, his name was Blunt,",
          "plainText": "A gallant knight he was his name was Blunt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "Semblably furnish'd like the King himself.",
          "plainText": "Semblably furnish'd like the King himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "douglas",
        "name": "DOUGLAS",
        "displayName": "Douglas"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "A fool go with thy soul, whither it goes!",
          "plainText": "A fool go with thy soul whither it goes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "A borrow'd title hast thou bought too dear.",
          "plainText": "A borrow'd title hast thou bought too dear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "Why didst thou tell me that thou wert a king?",
          "plainText": "Why didst thou tell me that thou wert a king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "hotspur",
        "name": "HOTSPUR",
        "displayName": "Hotspur"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "The King hath many marching in his coats.",
          "plainText": "The King hath many marching in his coats",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "douglas",
        "name": "DOUGLAS",
        "displayName": "Douglas"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Now, by my sword, I will kill all his coats;",
          "plainText": "Now by my sword I will kill all his coats",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "I'll murder all his wardrobe, piece by piece,",
          "plainText": "I'll murder all his wardrobe piece by piece",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "Until I meet the King.",
          "plainText": "Until I meet the King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "hotspur",
        "name": "HOTSPUR",
        "displayName": "Hotspur"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Up, and away!",
          "plainText": "Up and away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "Our soldiers stand full fairly for the day.",
          "plainText": "Our soldiers stand full fairly for the day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-stage-005",
      "type": "stage",
      "text": "Alarums. Enter Falstaff solus."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Though I could scape shot-free at London, I fear the shot here. Here's no scoring but upon the pate.—Soft! who are you? Sir Walter Blunt. There's honour for you. Here's no vanity. I am as hot as molten lead, and as heavy too. God keep lead out of me, I need no more weight than mine own bowels. I have led my ragamuffins where they are peppered. There's not three of my hundred and fifty left alive, and they are for the town's end, to beg during life. But who comes here?",
          "plainText": "Though I could scape shotfree at London I fear the shot here Here's no scoring but upon the pateSoft who are you Sir Walter Blunt There's honour for you Here's no vanity I am as hot as molten lead and as heavy too God keep lead out of me I need no more weight than mine own bowels I have led my ragamuffins where they are peppered There's not three of my hundred and fifty left alive and they are for the town's end to beg during life But who comes here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-stage-006",
      "type": "stage",
      "text": "Enter Prince Henry."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "What, stand'st thou idle here? Lend me thy sword.",
          "plainText": "What stand'st thou idle here Lend me thy sword",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Many a nobleman lies stark and stiff",
          "plainText": "Many a nobleman lies stark and stiff",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Under the hoofs of vaunting enemies,",
          "plainText": "Under the hoofs of vaunting enemies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "Whose deaths are yet unrevenged. I prithee",
          "plainText": "Whose deaths are yet unrevenged I prithee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0037",
          "number": 37,
          "speechLineNumber": 5,
          "text": "Lend me thy sword.",
          "plainText": "Lend me thy sword",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "O Hal, I prithee give me leave to breathe awhile. Turk Gregory never did such deeds in arms as I have done this day. I have paid Percy, I have made him sure.",
          "plainText": "O Hal I prithee give me leave to breathe awhile Turk Gregory never did such deeds in arms as I have done this day I have paid Percy I have made him sure",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
