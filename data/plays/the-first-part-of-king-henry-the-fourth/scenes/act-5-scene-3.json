      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOTSPUR.\nUp, and away!\nOur soldiers stand full fairly for the day.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@170057/line-1",
