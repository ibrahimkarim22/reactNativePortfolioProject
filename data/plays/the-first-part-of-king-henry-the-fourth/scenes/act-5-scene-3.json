    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@171894",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PRINCE.\nWhat, is it a time to jest and dally now?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@171894/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@171894/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1683019,
        "end": 1683098,
        "line": 63327,
        "column": 1,
        "path": "chap09/p@171894",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "PRINCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@171977",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Throws it at him, and exit.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 28
        }
      ],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@171977/line-1",
          "start": 0,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1683102,
        "end": 1683161,
        "line": 63332,
        "column": 1,
        "path": "chap09/p@171977",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@172040",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nWell, if Percy be alive, I’ll pierce him. If he do come in my way, so; if he do not, if I come in his willingly, let him make a carbonado of me. I like not such grinning honour as Sir Walter hath. Give me life, which if I can save, so: if not, honour comes unlooked for, and there’s an end.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@172040/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@172040/line-2",
          "start": 10,
          "end": 300,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1683165,
        "end": 1683498,
        "line": 63335,
        "column": 1,
        "path": "chap09/p@172040",
        "anchor": "sceneV_9.3"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.3/p@172377",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit.]",
      "separatorAfter": "\n\n",
