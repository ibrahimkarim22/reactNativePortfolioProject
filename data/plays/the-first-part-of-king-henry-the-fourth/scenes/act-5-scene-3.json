      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "The King enters with his power. Alarum to the battle.\nThen enter Douglas and Sir Walter Blunt.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 4,
          "end": 8,
          "className": "charname"
        },
