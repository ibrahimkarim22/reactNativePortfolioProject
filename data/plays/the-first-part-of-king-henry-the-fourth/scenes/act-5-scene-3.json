      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOUGLAS.\nNow, by my sword, I will kill all his coats;\nI’ll murder all his wardrobe, piece by piece,\nUntil I meet the King.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
