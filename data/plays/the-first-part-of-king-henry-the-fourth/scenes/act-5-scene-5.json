    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185784",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCASTER.\nI thank your Grace for this high courtesy,\nWhich I shall give away immediately.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185784/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185784/line-2",
          "start": 11,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185784/line-3",
          "start": 54,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1696909,
        "end": 1697034,
        "line": 63799,
        "column": 1,
        "path": "chap09/p@185784",
        "anchor": "sceneV_9.5"
      },
      "speakerLabel": "LANCASTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185913",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nThen this remains, that we divide our power.\nYou, son John, and my cousin Westmoreland,\nTowards York shall bend you with your dearest speed\nTo meet Northumberland and the prelate Scroop,\nWho, as we hear, are busily in arms.\nMyself and you, son Harry, will towards Wales,\nTo fight with Glendower and the Earl of March.\nRebellion in this land shall lose his sway,\nMeeting the check of such another day,\nAnd since this business so fair is done,\nLet us not leave till all our own be won.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185913/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185913/line-2",
          "start": 6,
