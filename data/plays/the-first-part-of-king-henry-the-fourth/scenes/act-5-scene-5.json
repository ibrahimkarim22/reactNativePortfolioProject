      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nBear Worcester to the death, and Vernon too.\nOther offenders we will pause upon.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
