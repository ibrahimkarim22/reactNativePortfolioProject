    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185378",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nWith all my heart.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185378/line-1",
