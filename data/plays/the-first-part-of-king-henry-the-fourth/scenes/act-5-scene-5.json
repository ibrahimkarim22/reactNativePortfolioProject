    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@184507",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WORCESTER.\nWhat I have done my safety urged me to;\nAnd I embrace this fortune patiently,\nSince not to be avoided it falls on me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@184507/line-1",
