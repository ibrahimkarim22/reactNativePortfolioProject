      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "How goes the field?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@184938/line-1",
