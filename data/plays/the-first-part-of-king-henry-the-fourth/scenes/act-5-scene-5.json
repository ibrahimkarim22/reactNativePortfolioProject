  "scene": {
    "id": "the-first-part-of-king-henry-the-fourth-5-5",
    "act": 5,
    "scene": 5,
    "label": "Act 5, Scene 5",
    "title": "SCENE V. Another Part of the Field.",
    "location": "Another Part of the Field.",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-stage-001",
      "type": "stage",
      "text": "The trumpets sound. Enter King Henry, Prince Henry, Lancaster, Westmoreland and others, with Worcester and Vernon prisoners."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Thus ever did rebellion find rebuke.",
          "plainText": "Thus ever did rebellion find rebuke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Ill-spirited Worcester, did not we send grace,",
          "plainText": "Illspirited Worcester did not we send grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Pardon, and terms of love to all of you?",
          "plainText": "Pardon and terms of love to all of you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And wouldst thou turn our offers contrary?",
          "plainText": "And wouldst thou turn our offers contrary",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Misuse the tenour of thy kinsman's trust?",
          "plainText": "Misuse the tenour of thy kinsman's trust",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Three knights upon our party slain today,",
          "plainText": "Three knights upon our party slain today",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "A noble earl, and many a creature else,",
          "plainText": "A noble earl and many a creature else",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Had been alive this hour,",
          "plainText": "Had been alive this hour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "If, like a Christian, thou hadst truly borne",
          "plainText": "If like a Christian thou hadst truly borne",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Betwixt our armies true intelligence.",
          "plainText": "Betwixt our armies true intelligence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "worcester",
        "name": "WORCESTER",
        "displayName": "Worcester"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "What I have done my safety urged me to;",
          "plainText": "What I have done my safety urged me to",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "And I embrace this fortune patiently,",
          "plainText": "And I embrace this fortune patiently",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Since not to be avoided it falls on me.",
          "plainText": "Since not to be avoided it falls on me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Bear Worcester to the death, and Vernon too.",
          "plainText": "Bear Worcester to the death and Vernon too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Other offenders we will pause upon.",
          "plainText": "Other offenders we will pause upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-stage-002",
      "type": "stage",
      "text": "[Exeunt Worcester and Vernon, guarded.]"
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "The noble Scot, Lord Douglas, when he saw",
          "plainText": "The noble Scot Lord Douglas when he saw",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "The fortune of the day quite turn'd from him,",
          "plainText": "The fortune of the day quite turn'd from him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "The noble Percy slain, and all his men",
          "plainText": "The noble Percy slain and all his men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "Upon the foot of fear, fled with the rest,",
          "plainText": "Upon the foot of fear fled with the rest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "And, falling from a hill, he was so bruised",
          "plainText": "And falling from a hill he was so bruised",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0021",
          "number": 21,
          "speechLineNumber": 6,
          "text": "That the pursuers took him. At my tent",
          "plainText": "That the pursuers took him At my tent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0022",
          "number": 22,
          "speechLineNumber": 7,
          "text": "The Douglas is, and I beseech your Grace",
          "plainText": "The Douglas is and I beseech your Grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0023",
          "number": 23,
          "speechLineNumber": 8,
          "text": "I may dispose of him.",
          "plainText": "I may dispose of him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "With all my heart.",
          "plainText": "With all my heart",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Then, brother John of Lancaster, to you",
          "plainText": "Then brother John of Lancaster to you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "This honourable bounty shall belong.",
          "plainText": "This honourable bounty shall belong",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "Go to the Douglas and deliver him",
          "plainText": "Go to the Douglas and deliver him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "Up to his pleasure, ransomless and free.",
          "plainText": "Up to his pleasure ransomless and free",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "His valours shown upon our crests today",
          "plainText": "His valours shown upon our crests today",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "Hath taught us how to cherish such high deeds,",
          "plainText": "Hath taught us how to cherish such high deeds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0031",
          "number": 31,
          "speechLineNumber": 7,
          "text": "Even in the bosom of our adversaries.",
          "plainText": "Even in the bosom of our adversaries",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lancaster",
        "name": "LANCASTER",
        "displayName": "Lancaster"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "I thank your Grace for this high courtesy,",
          "plainText": "I thank your Grace for this high courtesy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Which I shall give away immediately.",
          "plainText": "Which I shall give away immediately",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Then this remains, that we divide our power.",
          "plainText": "Then this remains that we divide our power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "You, son John, and my cousin Westmoreland,",
          "plainText": "You son John and my cousin Westmoreland",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Towards York shall bend you with your dearest speed",
          "plainText": "Towards York shall bend you with your dearest speed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "To meet Northumberland and the prelate Scroop,",
          "plainText": "To meet Northumberland and the prelate Scroop",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "Who, as we hear, are busily in arms.",
          "plainText": "Who as we hear are busily in arms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0039",
          "number": 39,
          "speechLineNumber": 6,
          "text": "Myself and you, son Harry, will towards Wales,",
          "plainText": "Myself and you son Harry will towards Wales",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0040",
          "number": 40,
          "speechLineNumber": 7,
          "text": "To fight with Glendower and the Earl of March.",
          "plainText": "To fight with Glendower and the Earl of March",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0041",
          "number": 41,
          "speechLineNumber": 8,
          "text": "Rebellion in this land shall lose his sway,",
          "plainText": "Rebellion in this land shall lose his sway",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0042",
          "number": 42,
          "speechLineNumber": 9,
          "text": "Meeting the check of such another day,",
          "plainText": "Meeting the check of such another day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0043",
          "number": 43,
          "speechLineNumber": 10,
          "text": "And since this business so fair is done,",
          "plainText": "And since this business so fair is done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-5-5-line-0044",
          "number": 44,
          "speechLineNumber": 11,
          "text": "Let us not leave till all our own be won.",
          "plainText": "Let us not leave till all our own be won",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-5-5-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}