          "start": 6,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1696503,
        "end": 1696557,
        "line": 63783,
        "column": 1,
        "path": "chap09/p@185378",
        "anchor": "sceneV_9.5"
      },
      "speakerLabel": "KING.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185436",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PRINCE.\nThen, brother John of Lancaster, to you\nThis honourable bounty shall belong.\nGo to the Douglas and deliver him\nUp to his pleasure, ransomless and free.\nHis valours shown upon our crests today\nHath taught us how to cherish such high deeds,\nEven in the bosom of our adversaries.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185436/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth/sceneV_9.5/p@185436/line-2",
          "start": 8,
          "end": 47,
          "sourceLineNumber": null
        },
        {
