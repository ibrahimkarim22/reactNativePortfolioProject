    {
      "id": "the-merchant-of-venice/sceneII_22.1/p@34321",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nYou must take your chance,\nAnd either not attempt to choose at all,\nOr swear before you choose, if you choose wrong\nNever to speak to lady afterward\nIn way of marriage. Therefore be advis’d.",
