    {
      "id": "the-merchant-of-venice/sceneII_22.3/p@47972",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nAdieu! tears exhibit my tongue, most beautiful pagan, most sweet Jew! If a Christian do not play the knave and get thee, I am much deceived. But, adieu! These foolish drops do something drown my manly spirit. Adieu!",
