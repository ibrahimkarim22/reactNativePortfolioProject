      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I am sorry thou wilt leave my father so.",
          "plainText": "I am sorry thou wilt leave my father so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Our house is hell, and thou, a merry devil,",
          "plainText": "Our house is hell and thou a merry devil",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Didst rob it of some taste of tediousness.",
          "plainText": "Didst rob it of some taste of tediousness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "But fare thee well, there is a ducat for thee,",
          "plainText": "But fare thee well there is a ducat for thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "And, Launcelet, soon at supper shalt thou see",
          "plainText": "And Launcelet soon at supper shalt thou see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Lorenzo, who is thy new master's guest.",
          "plainText": "Lorenzo who is thy new master's guest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Give him this letter, do it secretly.",
          "plainText": "Give him this letter do it secretly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "And so farewell. I would not have my father",
          "plainText": "And so farewell I would not have my father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "See me in talk with thee.",
          "plainText": "See me in talk with thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
