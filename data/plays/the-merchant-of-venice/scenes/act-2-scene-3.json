    {
      "id": "the-merchant-of-venice/sceneII_22.3/p@48381",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Alack, what heinous sin is it in me\nTo be ashamed to be my father’s child!\nBut though I am a daughter to his blood,\nI am not to his manners. O Lorenzo,\nIf thou keep promise, I shall end this strife,\nBecome a Christian and thy loving wife.",
      "separatorAfter": "\n\n",
      "spans": [],
