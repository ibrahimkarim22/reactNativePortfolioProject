      "classes": [
        "drama"
      ],
      "text": "GRATIANO.\nWas not that letter from fair Jessica?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50997/line-1",
