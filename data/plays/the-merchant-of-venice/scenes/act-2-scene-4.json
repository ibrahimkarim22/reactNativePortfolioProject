    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@48787",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Gratiano, Lorenzo, Salarino and Solanio.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 33,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 38,
          "end": 45,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@48787/line-1",
          "start": 0,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3932783,
        "end": 3932915,
        "line": 145371,
        "column": 1,
        "path": "chap22/p@48787",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@48923",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nNay, we will slink away in supper-time,\nDisguise us at my lodging, and return\nAll in an hour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@48923/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@48923/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@48923/line-3",
          "start": 49,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@48923/line-4",
          "start": 87,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3932919,
        "end": 3933061,
        "line": 145374,
        "column": 1,
        "path": "chap22/p@48923",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@49069",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GRATIANO.\nWe have not made good preparation.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49069/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49069/line-2",
          "start": 10,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3933065,
        "end": 3933139,
        "line": 145381,
        "column": 1,
        "path": "chap22/p@49069",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "GRATIANO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@49147",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALARINO.\nWe have not spoke us yet of torch-bearers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49147/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49147/line-2",
          "start": 10,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3933143,
        "end": 3933225,
        "line": 145386,
        "column": 1,
        "path": "chap22/p@49147",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "SALARINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@49233",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLANIO.\n’Tis vile, unless it may be quaintly order’d,\nAnd better in my mind not undertook.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49233/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49233/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49233/line-3",
          "start": 55,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3933229,
        "end": 3933355,
        "line": 145391,
        "column": 1,
        "path": "chap22/p@49233",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "SOLANIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@49363",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\n’Tis now but four o’clock, we have two hours\nTo furnish us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49363/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49363/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49363/line-3",
          "start": 54,
          "end": 68,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3933359,
        "end": 3933462,
        "line": 145397,
        "column": 1,
        "path": "chap22/p@49363",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@49470",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Launcelet with a letter.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 15,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49470/line-1",
          "start": 0,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3933466,
        "end": 3933551,
        "line": 145403,
        "column": 1,
        "path": "chap22/p@49470",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@49559",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Friend Launcelet, what’s the news?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49559/line-1",
          "start": 0,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3933555,
        "end": 3933614,
        "line": 145405,
        "column": 1,
        "path": "chap22/p@49559",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@49622",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nAnd it shall please you to break up this, it shall seem to signify.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49622/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49622/line-2",
          "start": 11,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3933618,
        "end": 3933726,
        "line": 145409,
        "column": 1,
        "path": "chap22/p@49622",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@49734",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nI know the hand, in faith ’tis a fair hand,\nAnd whiter than the paper it writ on\nIs the fair hand that writ.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49734/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49734/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49734/line-3",
          "start": 53,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49734/line-4",
          "start": 90,
          "end": 117,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3933730,
        "end": 3933887,
        "line": 145414,
        "column": 1,
        "path": "chap22/p@49734",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@49895",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GRATIANO.\nLove news, in faith.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49895/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49895/line-2",
          "start": 10,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3933891,
        "end": 3933951,
        "line": 145421,
        "column": 1,
        "path": "chap22/p@49895",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "GRATIANO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@49959",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nBy your leave, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49959/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@49959/line-2",
          "start": 11,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3933955,
        "end": 3934015,
        "line": 145426,
        "column": 1,
        "path": "chap22/p@49959",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@50023",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nWhither goest thou?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50023/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50023/line-2",
          "start": 9,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3934019,
        "end": 3934077,
        "line": 145431,
        "column": 1,
        "path": "chap22/p@50023",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@50085",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nMarry, sir, to bid my old master the Jew to sup tonight with my new master the Christian.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50085/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50085/line-2",
          "start": 11,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3934081,
        "end": 3934212,
        "line": 145436,
        "column": 1,
        "path": "chap22/p@50085",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@50220",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nHold here, take this. Tell gentle Jessica\nI will not fail her, speak it privately.\nGo, gentlemen,",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50220/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50220/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50220/line-3",
          "start": 51,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50220/line-4",
          "start": 92,
          "end": 106,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3934216,
        "end": 3934362,
        "line": 145442,
        "column": 1,
        "path": "chap22/p@50220",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@50370",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit Launcelet.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 15,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 16
        }
      ],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50370/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3934366,
        "end": 3934441,
        "line": 145449,
        "column": 1,
        "path": "chap22/p@50370",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@50449",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Will you prepare you for this masque tonight?\nI am provided of a torch-bearer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50449/line-1",
          "start": 0,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50449/line-2",
          "start": 46,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3934445,
        "end": 3934553,
        "line": 145451,
        "column": 1,
        "path": "chap22/p@50449",
        "anchor": "sceneII_22.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.4/p@50561",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALARINO.\nAy, marry, I’ll be gone about it straight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50561/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.4/p@50561/line-2",
          "start": 10,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
