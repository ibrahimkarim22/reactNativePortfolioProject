      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nHis words were “Farewell, mistress,” nothing else.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@54475/line-1",
