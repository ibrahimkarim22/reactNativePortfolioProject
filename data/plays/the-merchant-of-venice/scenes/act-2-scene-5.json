      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nI beseech you, sir, go. My young master doth expect your reproach.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@53032/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@53032/line-2",
          "start": 11,
          "end": 77,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3937028,
        "end": 3937135,
        "line": 145551,
        "column": 1,
        "path": "chap22/p@53032",
        "anchor": "sceneII_22.5"
      },
