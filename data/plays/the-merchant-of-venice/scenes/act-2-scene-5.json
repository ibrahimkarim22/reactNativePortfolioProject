    {
      "id": "the-merchant-of-venice/sceneII_22.5/p@54115",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nI will go before, sir.\nMistress, look out at window for all this.\n    There will come a Christian by\n    Will be worth a Jewess’ eye.",
      "separatorAfter": "\n\n",
      "spans": [],
