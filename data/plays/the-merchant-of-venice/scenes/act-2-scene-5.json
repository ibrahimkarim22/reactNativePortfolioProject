      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nCall you? What is your will?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@52557/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@52557/line-2",
          "start": 9,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3936553,
        "end": 3936620,
        "line": 145534,
        "column": 1,
        "path": "chap22/p@52557",
        "anchor": "sceneII_22.5"
      },
      "speakerLabel": "JESSICA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.5/p@52628",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHYLOCK.\nI am bid forth to supper, Jessica.\nThere are my keys. But wherefore should I go?\nI am not bid for love, they flatter me.\nBut yet I’ll go in hate, to feed upon\nThe prodigal Christian. Jessica, my girl,\nLook to my house. I am right loath to go;\nThere is some ill a-brewing towards my rest,\nFor I did dream of money-bags tonight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@52628/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@52628/line-2",
          "start": 9,
          "end": 43,
          "sourceLineNumber": null
        },
        {
