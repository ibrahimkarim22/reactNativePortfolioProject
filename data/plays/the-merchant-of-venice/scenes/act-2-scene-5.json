        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.5/p@53143",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHYLOCK.\nSo do I his.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@53143/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
