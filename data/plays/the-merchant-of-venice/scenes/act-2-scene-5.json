          "start": 9,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3937139,
        "end": 3937190,
        "line": 145556,
        "column": 1,
        "path": "chap22/p@53143",
        "anchor": "sceneII_22.5"
      },
      "speakerLabel": "SHYLOCK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.5/p@53198",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nAnd they have conspired together. I will not say you shall see a masque, but if you do, then it was not for nothing that my nose fell a-bleeding on Black Monday last at six o’clock i’ th’ morning, falling out that year on Ash-Wednesday was four year in th’ afternoon.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@53198/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@53198/line-2",
          "start": 11,
          "end": 278,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3937194,
        "end": 3937505,
        "line": 145561,
        "column": 1,
        "path": "chap22/p@53198",
        "anchor": "sceneII_22.5"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.5/p@53513",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHYLOCK.\nWhat, are there masques? Hear you me, Jessica,\nLock up my doors, and when you hear the drum\nAnd the vile squealing of the wry-neck’d fife,\nClamber not you up to the casements then,\nNor thrust your head into the public street\nTo gaze on Christian fools with varnish’d faces,\nBut stop my house’s ears, I mean my casements.\nLet not the sound of shallow fopp’ry enter\nMy sober house. By Jacob’s staff I swear\nI have no mind of feasting forth tonight.\nBut I will go. Go you before me, sirrah.\nSay I will come.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.5/p@53513/line-1",
          "start": 0,
          "end": 8,
