    {
      "id": "the-merchant-of-venice/sceneII_22.5/p@51915",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHYLOCK.\nWell, thou shalt see, thy eyes shall be thy judge,\nThe difference of old Shylock and Bassanio.—\nWhat, Jessica!—Thou shalt not gormandize\nAs thou hast done with me;—What, Jessica!—\nAnd sleep, and snore, and rend apparel out.\nWhy, Jessica, I say!",
      "separatorAfter": "\n\n",
      "spans": [],
