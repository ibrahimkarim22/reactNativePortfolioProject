    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@59552",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nFie, fie, Gratiano! where are all the rest?\n’Tis nine o’clock, our friends all stay for you.\nNo masque tonight, the wind is come about;\nBassanio presently will go aboard.\nI have sent twenty out to seek for you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@59552/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@59552/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@59552/line-3",
          "start": 53,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@59552/line-4",
          "start": 102,
          "end": 144,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@59552/line-5",
          "start": 145,
          "end": 179,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@59552/line-6",
          "start": 180,
          "end": 219,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3943548,
        "end": 3943817,
        "line": 145793,
        "column": 1,
        "path": "chap22/p@59552",
        "anchor": "sceneII_22.6"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@59825",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GRATIANO.\nI am glad on’t. I desire no more delight\nThan to be under sail and gone tonight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
