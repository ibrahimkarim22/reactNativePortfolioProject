      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GRATIANO.\nNow, by my hood, a gentle, and no Jew.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
