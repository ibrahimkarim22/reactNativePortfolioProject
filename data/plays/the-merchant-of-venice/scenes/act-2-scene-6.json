    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@58721",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nBeshrew me but I love her heartily,\nFor she is wise, if I can judge of her,\nAnd fair she is, if that mine eyes be true,\nAnd true she is, as she hath prov’d herself.\nAnd therefore, like herself, wise, fair, and true,\nShall she be placed in my constant soul.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@58721/line-1",
          "start": 0,
          "end": 8,
