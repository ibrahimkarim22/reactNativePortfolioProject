      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nDescend, for you must be my torch-bearer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57934/line-1",
