          "start": 10,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3939574,
        "end": 3939638,
        "line": 145640,
        "column": 1,
        "path": "chap22/p@55578",
        "anchor": "sceneII_22.6"
      },
      "speakerLabel": "SALARINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@55646",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GRATIANO.\nAnd it is marvel he out-dwells his hour,\nFor lovers ever run before the clock.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@55646/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@55646/line-2",
          "start": 10,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@55646/line-3",
          "start": 51,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3939642,
        "end": 3939765,
        "line": 145645,
        "column": 1,
        "path": "chap22/p@55646",
        "anchor": "sceneII_22.6"
      },
      "speakerLabel": "GRATIANO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@55773",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALARINO.\nO ten times faster Venus’ pigeons fly\nTo seal love’s bonds new-made than they are wont\nTo keep obliged faith unforfeited!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@55773/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@55773/line-2",
          "start": 10,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@55773/line-3",
          "start": 48,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@55773/line-4",
          "start": 97,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3939769,
        "end": 3939940,
        "line": 145651,
        "column": 1,
        "path": "chap22/p@55773",
        "anchor": "sceneII_22.6"
      },
      "speakerLabel": "SALARINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@55948",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GRATIANO.\nThat ever holds: who riseth from a feast\nWith that keen appetite that he sits down?\nWhere is the horse that doth untread again\nHis tedious measures with the unbated fire\nThat he did pace them first? All things that are,\nAre with more spirit chased than enjoy’d.\nHow like a younger or a prodigal\nThe scarfed bark puts from her native bay,\nHugg’d and embraced by the strumpet wind!\nHow like the prodigal doth she return\nWith over-weather’d ribs and ragged sails,\nLean, rent, and beggar’d by the strumpet wind!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
