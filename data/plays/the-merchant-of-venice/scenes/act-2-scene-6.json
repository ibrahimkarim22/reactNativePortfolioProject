      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GRATIANO.\nThis is the penthouse under which Lorenzo\nDesired us to make stand.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@55462/line-1",
          "start": 0,
          "end": 9,
