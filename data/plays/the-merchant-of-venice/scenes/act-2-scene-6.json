      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nWhat! must I hold a candle to my shames?\nThey in themselves, good sooth, are too too light.\nWhy, ’tis an office of discovery, love,\nAnd I should be obscur’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@58018/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
