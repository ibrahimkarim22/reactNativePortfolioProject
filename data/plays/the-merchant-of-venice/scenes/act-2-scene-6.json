      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@57006",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Jessica above, in boy’s clothes.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57006/line-1",
          "start": 0,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3941002,
        "end": 3941095,
        "line": 145690,
        "column": 1,
        "path": "chap22/p@57006",
        "anchor": "sceneII_22.6"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@57103",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nWho are you? Tell me, for more certainty,\nAlbeit I’ll swear that I do know your tongue.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57103/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57103/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57103/line-3",
          "start": 51,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3941099,
        "end": 3941230,
        "line": 145692,
        "column": 1,
        "path": "chap22/p@57103",
        "anchor": "sceneII_22.6"
      },
      "speakerLabel": "JESSICA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@57238",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nLorenzo, and thy love.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57238/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57238/line-2",
          "start": 9,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3941234,
        "end": 3941295,
        "line": 145698,
        "column": 1,
        "path": "chap22/p@57238",
        "anchor": "sceneII_22.6"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@57303",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nLorenzo certain, and my love indeed,\nFor who love I so much? And now who knows\nBut you, Lorenzo, whether I am yours?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57303/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57303/line-2",
          "start": 9,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57303/line-3",
          "start": 46,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57303/line-4",
          "start": 88,
          "end": 125,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3941299,
        "end": 3941464,
        "line": 145703,
        "column": 1,
        "path": "chap22/p@57303",
        "anchor": "sceneII_22.6"
      },
      "speakerLabel": "JESSICA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@57472",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nHeaven and thy thoughts are witness that thou art.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57472/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57472/line-2",
          "start": 9,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3941468,
        "end": 3941557,
        "line": 145710,
        "column": 1,
        "path": "chap22/p@57472",
        "anchor": "sceneII_22.6"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@57565",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nHere, catch this casket; it is worth the pains.\nI am glad ’tis night, you do not look on me,\nFor I am much asham’d of my exchange.\nBut love is blind, and lovers cannot see\nThe pretty follies that themselves commit,\nFor if they could, Cupid himself would blush\nTo see me thus transformed to a boy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@57565/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
