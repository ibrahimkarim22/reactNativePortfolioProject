    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@56627",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALARINO.\nHere comes Lorenzo, more of this hereafter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@56627/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@56627/line-2",
          "start": 10,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3940623,
        "end": 3940706,
        "line": 145676,
        "column": 1,
        "path": "chap22/p@56627",
        "anchor": "sceneII_22.6"
      },
      "speakerLabel": "SALARINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.6/p@56714",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nSweet friends, your patience for my long abode.\nNot I but my affairs have made you wait.\nWhen you shall please to play the thieves for wives,\nI’ll watch as long for you then. Approach.\nHere dwells my father Jew. Ho! who’s within?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@56714/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@56714/line-2",
          "start": 9,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@56714/line-3",
          "start": 57,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@56714/line-4",
          "start": 98,
          "end": 150,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@56714/line-5",
          "start": 151,
          "end": 193,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.6/p@56714/line-6",
          "start": 194,
          "end": 238,
          "sourceLineNumber": null
        }
      ],
