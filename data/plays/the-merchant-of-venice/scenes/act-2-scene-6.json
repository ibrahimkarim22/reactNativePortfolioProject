      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "What, art thou come? On, gentlemen, away!\nOur masquing mates by this time for us stay.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
