    {
      "id": "the-merchant-of-venice/sceneII_22.7/p@63487",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PRINCE OF MOROCCO.\nO hell! what have we here?\nA carrion Death, within whose empty eye\nThere is a written scroll. I’ll read the writing.",
      "separatorAfter": "\n\n",
      "spans": [],
