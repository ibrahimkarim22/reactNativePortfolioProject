    {
      "id": "the-merchant-of-venice/sceneII_22.7/p@60841",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nThe one of them contains my picture, prince.\nIf you choose that, then I am yours withal.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.7/p@60841/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.7/p@60841/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.7/p@60841/line-3",
          "start": 53,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3944837,
        "end": 3944968,
        "line": 145833,
        "column": 1,
        "path": "chap22/p@60841",
        "anchor": "sceneII_22.7"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
