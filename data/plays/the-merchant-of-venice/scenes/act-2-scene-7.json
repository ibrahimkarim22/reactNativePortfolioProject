    {
      "id": "the-merchant-of-venice/sceneII_22.7/p@64069",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "   Cold indeed and labour lost,\n   Then farewell heat, and welcome frost.\nPortia, adieu! I have too griev’d a heart\nTo take a tedious leave. Thus losers part.",
      "separatorAfter": "\n\n",
