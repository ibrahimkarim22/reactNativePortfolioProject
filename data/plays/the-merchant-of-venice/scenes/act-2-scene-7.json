    {
      "id": "the-merchant-of-venice/sceneII_22.7/p@60259",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nGo, draw aside the curtains and discover\nThe several caskets to this noble prince.\nNow make your choice.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.7/p@60259/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.7/p@60259/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.7/p@60259/line-3",
          "start": 49,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.7/p@60259/line-4",
          "start": 91,
          "end": 112,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3944255,
        "end": 3944407,
        "line": 145815,
        "column": 1,
        "path": "chap22/p@60259",
        "anchor": "sceneII_22.7"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.7/p@60415",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PRINCE OF MOROCCO.\nThe first, of gold, who this inscription bears,\n“Who chooseth me shall gain what many men desire.”\nThe second, silver, which this promise carries,\n“Who chooseth me shall get as much as he deserves.”\nThis third, dull lead, with warning all as blunt,\n“Who chooseth me must give and hazard all he hath.”\nHow shall I know if I do choose the right?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
