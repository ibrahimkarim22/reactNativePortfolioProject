    {
      "id": "the-merchant-of-venice/sceneII_22.8/p@67360",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLANIO.\nI think he only loves the world for him.\nI pray thee, let us go and find him out\nAnd quicken his embraced heaviness\nWith some delight or other.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@67360/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@67360/line-2",
