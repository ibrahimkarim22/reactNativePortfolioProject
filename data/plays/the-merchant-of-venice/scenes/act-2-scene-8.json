  "scene": {
    "id": "the-merchant-of-venice-2-8",
    "act": 2,
    "scene": 8,
    "label": "Act 2, Scene 8",
    "title": "SCENE VIII. Venice. A street.",
    "location": "Venice. A street.",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "the-merchant-of-venice-2-8-stage-001",
      "type": "stage",
      "text": "Enter Salarino and Solanio."
    },
    {
      "id": "the-merchant-of-venice-2-8-speech-001",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-8-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Why, man, I saw Bassanio under sail;",
          "plainText": "Why man I saw Bassanio under sail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "With him is Gratiano gone along;",
          "plainText": "With him is Gratiano gone along",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And in their ship I am sure Lorenzo is not.",
          "plainText": "And in their ship I am sure Lorenzo is not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-8-speech-002",
      "type": "speech",
      "speaker": {
        "id": "solanio",
        "name": "SOLANIO",
        "displayName": "Solanio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-8-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "The villain Jew with outcries rais'd the Duke,",
          "plainText": "The villain Jew with outcries rais'd the Duke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Who went with him to search Bassanio's ship.",
          "plainText": "Who went with him to search Bassanio's ship",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-8-speech-003",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-8-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "He came too late, the ship was under sail;",
          "plainText": "He came too late the ship was under sail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "But there the Duke was given to understand",
          "plainText": "But there the Duke was given to understand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "That in a gondola were seen together",
          "plainText": "That in a gondola were seen together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Lorenzo and his amorous Jessica.",
          "plainText": "Lorenzo and his amorous Jessica",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "Besides, Antonio certified the Duke",
          "plainText": "Besides Antonio certified the Duke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0011",
          "number": 11,
          "speechLineNumber": 6,
          "text": "They were not with Bassanio in his ship.",
          "plainText": "They were not with Bassanio in his ship",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-8-speech-004",
      "type": "speech",
      "speaker": {
        "id": "solanio",
        "name": "SOLANIO",
        "displayName": "Solanio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-8-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "I never heard a passion so confus'd,",
          "plainText": "I never heard a passion so confus'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "So strange, outrageous, and so variable",
          "plainText": "So strange outrageous and so variable",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "As the dog Jew did utter in the streets.",
          "plainText": "As the dog Jew did utter in the streets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "\"My daughter! O my ducats! O my daughter!",
          "plainText": "My daughter O my ducats O my daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "Fled with a Christian! O my Christian ducats!",
          "plainText": "Fled with a Christian O my Christian ducats",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "Justice! the law! my ducats and my daughter!",
          "plainText": "Justice the law my ducats and my daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0018",
          "number": 18,
          "speechLineNumber": 7,
          "text": "A sealed bag, two sealed bags of ducats,",
          "plainText": "A sealed bag two sealed bags of ducats",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0019",
          "number": 19,
          "speechLineNumber": 8,
          "text": "Of double ducats, stol'n from me by my daughter!",
          "plainText": "Of double ducats stol'n from me by my daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0020",
          "number": 20,
          "speechLineNumber": 9,
          "text": "And jewels, two stones, two rich and precious stones,",
          "plainText": "And jewels two stones two rich and precious stones",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0021",
          "number": 21,
          "speechLineNumber": 10,
          "text": "Stol'n by my daughter! Justice! find the girl,",
          "plainText": "Stol'n by my daughter Justice find the girl",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0022",
          "number": 22,
          "speechLineNumber": 11,
          "text": "She hath the stones upon her and the ducats.\"",
          "plainText": "She hath the stones upon her and the ducats",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-8-speech-005",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-8-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Why, all the boys in Venice follow him,",
          "plainText": "Why all the boys in Venice follow him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Crying, his stones, his daughter, and his ducats.",
          "plainText": "Crying his stones his daughter and his ducats",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-8-speech-006",
      "type": "speech",
      "speaker": {
        "id": "solanio",
        "name": "SOLANIO",
        "displayName": "Solanio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-8-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Let good Antonio look he keep his day",
          "plainText": "Let good Antonio look he keep his day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Or he shall pay for this.",
          "plainText": "Or he shall pay for this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-8-speech-007",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-8-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Marry, well rememb'red.",
          "plainText": "Marry well rememb'red",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "I reason'd with a Frenchman yesterday,",
          "plainText": "I reason'd with a Frenchman yesterday",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "Who told me, in the narrow seas that part",
          "plainText": "Who told me in the narrow seas that part",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "The French and English, there miscarried",
          "plainText": "The French and English there miscarried",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "A vessel of our country richly fraught.",
          "plainText": "A vessel of our country richly fraught",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0032",
          "number": 32,
          "speechLineNumber": 6,
          "text": "I thought upon Antonio when he told me,",
          "plainText": "I thought upon Antonio when he told me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0033",
          "number": 33,
          "speechLineNumber": 7,
          "text": "And wish'd in silence that it were not his.",
          "plainText": "And wish'd in silence that it were not his",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-8-speech-008",
      "type": "speech",
      "speaker": {
        "id": "solanio",
        "name": "SOLANIO",
        "displayName": "Solanio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-8-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "You were best to tell Antonio what you hear,",
          "plainText": "You were best to tell Antonio what you hear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Yet do not suddenly, for it may grieve him.",
          "plainText": "Yet do not suddenly for it may grieve him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-8-speech-009",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-8-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "A kinder gentleman treads not the earth.",
          "plainText": "A kinder gentleman treads not the earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "I saw Bassanio and Antonio part,",
          "plainText": "I saw Bassanio and Antonio part",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0038",
          "number": 38,
          "speechLineNumber": 3,
          "text": "Bassanio told him he would make some speed",
          "plainText": "Bassanio told him he would make some speed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0039",
          "number": 39,
          "speechLineNumber": 4,
          "text": "Of his return. He answered \"Do not so,",
          "plainText": "Of his return He answered Do not so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0040",
          "number": 40,
          "speechLineNumber": 5,
          "text": "Slubber not business for my sake, Bassanio,",
          "plainText": "Slubber not business for my sake Bassanio",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0041",
          "number": 41,
          "speechLineNumber": 6,
          "text": "But stay the very riping of the time,",
          "plainText": "But stay the very riping of the time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0042",
          "number": 42,
          "speechLineNumber": 7,
          "text": "And for the Jew's bond which he hath of me,",
          "plainText": "And for the Jew's bond which he hath of me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0043",
          "number": 43,
          "speechLineNumber": 8,
          "text": "Let it not enter in your mind of love:",
          "plainText": "Let it not enter in your mind of love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0044",
          "number": 44,
          "speechLineNumber": 9,
          "text": "Be merry, and employ your chiefest thoughts",
          "plainText": "Be merry and employ your chiefest thoughts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0045",
          "number": 45,
          "speechLineNumber": 10,
          "text": "To courtship, and such fair ostents of love",
          "plainText": "To courtship and such fair ostents of love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0046",
          "number": 46,
          "speechLineNumber": 11,
          "text": "As shall conveniently become you there.\"",
          "plainText": "As shall conveniently become you there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0047",
          "number": 47,
          "speechLineNumber": 12,
          "text": "And even there, his eye being big with tears,",
          "plainText": "And even there his eye being big with tears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0048",
          "number": 48,
          "speechLineNumber": 13,
          "text": "Turning his face, he put his hand behind him,",
          "plainText": "Turning his face he put his hand behind him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0049",
          "number": 49,
          "speechLineNumber": 14,
          "text": "And with affection wondrous sensible",
          "plainText": "And with affection wondrous sensible",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-8-line-0050",
          "number": 50,
          "speechLineNumber": 15,
          "text": "He wrung Bassanio's hand, and so they parted.",
          "plainText": "He wrung Bassanio's hand and so they parted",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-8-speech-010",
      "type": "speech",
      "speaker": {
        "id": "solanio",
        "name": "SOLANIO",
        "displayName": "Solanio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-8-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "I think he only loves the world for him.",
          "plainText": "I think he only loves the world for him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
