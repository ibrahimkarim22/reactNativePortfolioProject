    {
      "id": "the-merchant-of-venice/sceneII_22.8/p@64707",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALARINO.\nWhy, man, I saw Bassanio under sail;\nWith him is Gratiano gone along;\nAnd in their ship I am sure Lorenzo is not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@64707/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@64707/line-2",
          "start": 10,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@64707/line-3",
          "start": 47,
          "end": 79,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@64707/line-4",
          "start": 80,
          "end": 123,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3948703,
        "end": 3948866,
        "line": 145940,
        "column": 1,
        "path": "chap22/p@64707",
        "anchor": "sceneII_22.8"
      },
      "speakerLabel": "SALARINO.",
