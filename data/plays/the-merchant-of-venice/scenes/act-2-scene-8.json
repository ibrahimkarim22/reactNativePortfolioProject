    {
      "id": "the-merchant-of-venice/sceneII_22.8/p@65894",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALARINO.\nWhy, all the boys in Venice follow him,\nCrying, his stones, his daughter, and his ducats.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@65894/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@65894/line-2",
          "start": 10,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@65894/line-3",
          "start": 50,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3949890,
        "end": 3950024,
        "line": 145978,
        "column": 1,
        "path": "chap22/p@65894",
        "anchor": "sceneII_22.8"
      },
      "speakerLabel": "SALARINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.8/p@66032",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLANIO.\nLet good Antonio look he keep his day\nOr he shall pay for this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@66032/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@66032/line-2",
          "start": 9,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@66032/line-3",
          "start": 47,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3950028,
        "end": 3950135,
        "line": 145984,
        "column": 1,
        "path": "chap22/p@66032",
        "anchor": "sceneII_22.8"
      },
      "speakerLabel": "SOLANIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.8/p@66143",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALARINO.\nMarry, well rememb’red.\nI reason’d with a Frenchman yesterday,\nWho told me, in the narrow seas that part\nThe French and English, there miscarried\nA vessel of our country richly fraught.\nI thought upon Antonio when he told me,\nAnd wish’d in silence that it were not his.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@66143/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@66143/line-2",
          "start": 10,
          "end": 33,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@66143/line-3",
          "start": 34,
          "end": 72,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@66143/line-4",
          "start": 73,
          "end": 114,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@66143/line-5",
          "start": 115,
          "end": 155,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@66143/line-6",
          "start": 156,
          "end": 195,
          "sourceLineNumber": null
        },
        {
