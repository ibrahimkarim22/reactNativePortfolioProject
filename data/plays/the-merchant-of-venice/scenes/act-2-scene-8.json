    {
      "id": "the-merchant-of-venice/sceneII_22.8/p@64874",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLANIO.\nThe villain Jew with outcries rais’d the Duke,\nWho went with him to search Bassanio’s ship.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@64874/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@64874/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@64874/line-3",
          "start": 56,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3948870,
        "end": 3949005,
        "line": 145947,
        "column": 1,
        "path": "chap22/p@64874",
        "anchor": "sceneII_22.8"
      },
      "speakerLabel": "SOLANIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.8/p@65013",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALARINO.\nHe came too late, the ship was under sail;\nBut there the Duke was given to understand\nThat in a gondola were seen together\nLorenzo and his amorous Jessica.\nBesides, Antonio certified the Duke\nThey were not with Bassanio in his ship.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@65013/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@65013/line-2",
          "start": 10,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@65013/line-3",
          "start": 53,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@65013/line-4",
          "start": 96,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@65013/line-5",
          "start": 133,
          "end": 165,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@65013/line-6",
          "start": 166,
          "end": 201,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.8/p@65013/line-7",
          "start": 202,
          "end": 242,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3949009,
        "end": 3949306,
        "line": 145953,
        "column": 1,
        "path": "chap22/p@65013",
        "anchor": "sceneII_22.8"
      },
      "speakerLabel": "SALARINO.",
