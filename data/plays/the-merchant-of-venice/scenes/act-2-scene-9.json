  "scene": {
    "id": "the-merchant-of-venice-2-9",
    "act": 2,
    "scene": 9,
    "label": "Act 2, Scene 9",
    "title": "SCENE IX. Belmont. A room in Portia's house.",
    "location": "Belmont. A room in Portia's house.",
    "orderInPlay": 12
  },
  "content": [
    {
      "id": "the-merchant-of-venice-2-9-stage-001",
      "type": "stage",
      "text": "Enter Nerissa and a Servitor."
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-001",
      "type": "speech",
      "speaker": {
        "id": "nerissa",
        "name": "NERISSA",
        "displayName": "Nerissa"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Quick, quick, I pray thee, draw the curtain straight.",
          "plainText": "Quick quick I pray thee draw the curtain straight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The Prince of Arragon hath ta'en his oath,",
          "plainText": "The Prince of Arragon hath ta'en his oath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And comes to his election presently.",
          "plainText": "And comes to his election presently",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-stage-002",
      "type": "stage",
      "text": "Flourish of cornets. Enter the Prince of Arragon, his train, and Portia."
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-002",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Behold, there stand the caskets, noble Prince,",
          "plainText": "Behold there stand the caskets noble Prince",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "If you choose that wherein I am contain'd,",
          "plainText": "If you choose that wherein I am contain'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Straight shall our nuptial rites be solemniz'd.",
          "plainText": "Straight shall our nuptial rites be solemniz'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "But if you fail, without more speech, my lord,",
          "plainText": "But if you fail without more speech my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "You must be gone from hence immediately.",
          "plainText": "You must be gone from hence immediately",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-003",
      "type": "speech",
      "speaker": {
        "id": "arragon",
        "name": "ARRAGON",
        "displayName": "Arragon"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "I am enjoin'd by oath to observe three things:",
          "plainText": "I am enjoin'd by oath to observe three things",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "First, never to unfold to anyone",
          "plainText": "First never to unfold to anyone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Which casket 'twas I chose; next, if I fail",
          "plainText": "Which casket 'twas I chose next if I fail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "Of the right casket, never in my life",
          "plainText": "Of the right casket never in my life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "To woo a maid in way of marriage;",
          "plainText": "To woo a maid in way of marriage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0014",
          "number": 14,
          "speechLineNumber": 6,
          "text": "Lastly,",
          "plainText": "Lastly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0015",
          "number": 15,
          "speechLineNumber": 7,
          "text": "If I do fail in fortune of my choice,",
          "plainText": "If I do fail in fortune of my choice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0016",
          "number": 16,
          "speechLineNumber": 8,
          "text": "Immediately to leave you and be gone.",
          "plainText": "Immediately to leave you and be gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-004",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "To these injunctions everyone doth swear",
          "plainText": "To these injunctions everyone doth swear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "That comes to hazard for my worthless self.",
          "plainText": "That comes to hazard for my worthless self",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-005",
      "type": "speech",
      "speaker": {
        "id": "arragon",
        "name": "ARRAGON",
        "displayName": "Arragon"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "And so have I address'd me. Fortune now",
          "plainText": "And so have I address'd me Fortune now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "To my heart's hope! Gold, silver, and base lead.",
          "plainText": "To my heart's hope Gold silver and base lead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "\"Who chooseth me must give and hazard all he hath.\"",
          "plainText": "Who chooseth me must give and hazard all he hath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "You shall look fairer ere I give or hazard.",
          "plainText": "You shall look fairer ere I give or hazard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "What says the golden chest? Ha! let me see:",
          "plainText": "What says the golden chest Ha let me see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "\"Who chooseth me shall gain what many men desire.\"",
          "plainText": "Who chooseth me shall gain what many men desire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0025",
          "number": 25,
          "speechLineNumber": 7,
          "text": "What many men desire! that \"many\" may be meant",
          "plainText": "What many men desire that many may be meant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0026",
          "number": 26,
          "speechLineNumber": 8,
          "text": "By the fool multitude, that choose by show,",
          "plainText": "By the fool multitude that choose by show",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0027",
          "number": 27,
          "speechLineNumber": 9,
          "text": "Not learning more than the fond eye doth teach,",
          "plainText": "Not learning more than the fond eye doth teach",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0028",
          "number": 28,
          "speechLineNumber": 10,
          "text": "Which pries not to th' interior, but like the martlet",
          "plainText": "Which pries not to th' interior but like the martlet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0029",
          "number": 29,
          "speechLineNumber": 11,
          "text": "Builds in the weather on the outward wall,",
          "plainText": "Builds in the weather on the outward wall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0030",
          "number": 30,
          "speechLineNumber": 12,
          "text": "Even in the force and road of casualty.",
          "plainText": "Even in the force and road of casualty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0031",
          "number": 31,
          "speechLineNumber": 13,
          "text": "I will not choose what many men desire,",
          "plainText": "I will not choose what many men desire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0032",
          "number": 32,
          "speechLineNumber": 14,
          "text": "Because I will not jump with common spirits",
          "plainText": "Because I will not jump with common spirits",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0033",
          "number": 33,
          "speechLineNumber": 15,
          "text": "And rank me with the barbarous multitudes.",
          "plainText": "And rank me with the barbarous multitudes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0034",
          "number": 34,
          "speechLineNumber": 16,
          "text": "Why, then to thee, thou silver treasure-house,",
          "plainText": "Why then to thee thou silver treasurehouse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0035",
          "number": 35,
          "speechLineNumber": 17,
          "text": "Tell me once more what title thou dost bear.",
          "plainText": "Tell me once more what title thou dost bear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0036",
          "number": 36,
          "speechLineNumber": 18,
          "text": "\"Who chooseth me shall get as much as he deserves.\"",
          "plainText": "Who chooseth me shall get as much as he deserves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0037",
          "number": 37,
          "speechLineNumber": 19,
          "text": "And well said too; for who shall go about",
          "plainText": "And well said too for who shall go about",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0038",
          "number": 38,
          "speechLineNumber": 20,
          "text": "To cozen fortune, and be honourable",
          "plainText": "To cozen fortune and be honourable",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0039",
          "number": 39,
          "speechLineNumber": 21,
          "text": "Without the stamp of merit? Let none presume",
          "plainText": "Without the stamp of merit Let none presume",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0040",
          "number": 40,
          "speechLineNumber": 22,
          "text": "To wear an undeserved dignity.",
          "plainText": "To wear an undeserved dignity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0041",
          "number": 41,
          "speechLineNumber": 23,
          "text": "O that estates, degrees, and offices",
          "plainText": "O that estates degrees and offices",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0042",
          "number": 42,
          "speechLineNumber": 24,
          "text": "Were not deriv'd corruptly, and that clear honour",
          "plainText": "Were not deriv'd corruptly and that clear honour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0043",
          "number": 43,
          "speechLineNumber": 25,
          "text": "Were purchas'd by the merit of the wearer!",
          "plainText": "Were purchas'd by the merit of the wearer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0044",
          "number": 44,
          "speechLineNumber": 26,
          "text": "How many then should cover that stand bare?",
          "plainText": "How many then should cover that stand bare",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0045",
          "number": 45,
          "speechLineNumber": 27,
          "text": "How many be commanded that command?",
          "plainText": "How many be commanded that command",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0046",
          "number": 46,
          "speechLineNumber": 28,
          "text": "How much low peasantry would then be gleaned",
          "plainText": "How much low peasantry would then be gleaned",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0047",
          "number": 47,
          "speechLineNumber": 29,
          "text": "From the true seed of honour? And how much honour",
          "plainText": "From the true seed of honour And how much honour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0048",
          "number": 48,
          "speechLineNumber": 30,
          "text": "Pick'd from the chaff and ruin of the times,",
          "plainText": "Pick'd from the chaff and ruin of the times",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0049",
          "number": 49,
          "speechLineNumber": 31,
          "text": "To be new varnish'd? Well, but to my choice.",
          "plainText": "To be new varnish'd Well but to my choice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0050",
          "number": 50,
          "speechLineNumber": 32,
          "text": "\"Who chooseth me shall get as much as he deserves.\"",
          "plainText": "Who chooseth me shall get as much as he deserves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0051",
          "number": 51,
          "speechLineNumber": 33,
          "text": "I will assume desert. Give me a key for this,",
          "plainText": "I will assume desert Give me a key for this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0052",
          "number": 52,
          "speechLineNumber": 34,
          "text": "And instantly unlock my fortunes here.",
          "plainText": "And instantly unlock my fortunes here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-stage-003",
      "type": "stage",
      "text": "[He opens the silver casket.]"
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-006",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Too long a pause for that which you find there.",
          "plainText": "Too long a pause for that which you find there",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
