    {
      "id": "the-merchant-of-venice/sceneII_22.9/p@71841",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Still more fool I shall appear\nBy the time I linger here.\nWith one fool’s head I came to woo,\nBut I go away with two.\nSweet, adieu! I’ll keep my oath,\nPatiently to bear my wroth.",
      "separatorAfter": "\n\n",
      "spans": [],
