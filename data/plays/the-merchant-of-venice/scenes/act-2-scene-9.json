      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-007",
      "type": "speech",
      "speaker": {
        "id": "arragon",
        "name": "ARRAGON",
        "displayName": "Arragon"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "What's here? The portrait of a blinking idiot",
          "plainText": "What's here The portrait of a blinking idiot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "Presenting me a schedule! I will read it.",
          "plainText": "Presenting me a schedule I will read it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0056",
          "number": 56,
          "speechLineNumber": 3,
          "text": "How much unlike art thou to Portia!",
          "plainText": "How much unlike art thou to Portia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0057",
          "number": 57,
          "speechLineNumber": 4,
          "text": "How much unlike my hopes and my deservings!",
          "plainText": "How much unlike my hopes and my deservings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0058",
          "number": 58,
          "speechLineNumber": 5,
          "text": "\"Who chooseth me shall have as much as he deserves.\"",
          "plainText": "Who chooseth me shall have as much as he deserves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0059",
          "number": 59,
          "speechLineNumber": 6,
          "text": "Did I deserve no more than a fool's head?",
          "plainText": "Did I deserve no more than a fool's head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0060",
          "number": 60,
          "speechLineNumber": 7,
          "text": "Is that my prize? Are my deserts no better?",
          "plainText": "Is that my prize Are my deserts no better",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-008",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "To offend and judge are distinct offices,",
          "plainText": "To offend and judge are distinct offices",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "And of opposed natures.",
          "plainText": "And of opposed natures",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-009",
      "type": "speech",
      "speaker": {
        "id": "arragon",
        "name": "ARRAGON",
        "displayName": "Arragon"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "What is here?",
          "plainText": "What is here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-stage-004",
      "type": "stage",
      "text": "[Exit Arragon with his train.]"
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-010",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Thus hath the candle sing'd the moth.",
          "plainText": "Thus hath the candle sing'd the moth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "O, these deliberate fools! When they do choose,",
          "plainText": "O these deliberate fools When they do choose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "They have the wisdom by their wit to lose.",
          "plainText": "They have the wisdom by their wit to lose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-011",
      "type": "speech",
      "speaker": {
        "id": "nerissa",
        "name": "NERISSA",
        "displayName": "Nerissa"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "The ancient saying is no heresy:",
          "plainText": "The ancient saying is no heresy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "Hanging and wiving goes by destiny.",
          "plainText": "Hanging and wiving goes by destiny",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-012",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Come, draw the curtain, Nerissa.",
          "plainText": "Come draw the curtain Nerissa",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-stage-005",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-013",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Where is my lady?",
          "plainText": "Where is my lady",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-014",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Here. What would my lord?",
          "plainText": "Here What would my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-015",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Madam, there is alighted at your gate",
          "plainText": "Madam there is alighted at your gate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "A young Venetian, one that comes before",
          "plainText": "A young Venetian one that comes before",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0074",
          "number": 74,
          "speechLineNumber": 3,
          "text": "To signify th' approaching of his lord,",
          "plainText": "To signify th' approaching of his lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0075",
          "number": 75,
          "speechLineNumber": 4,
          "text": "From whom he bringeth sensible regreets;",
          "plainText": "From whom he bringeth sensible regreets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0076",
          "number": 76,
          "speechLineNumber": 5,
          "text": "To wit (besides commends and courteous breath)",
          "plainText": "To wit besides commends and courteous breath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0077",
          "number": 77,
          "speechLineNumber": 6,
          "text": "Gifts of rich value; yet I have not seen",
          "plainText": "Gifts of rich value yet I have not seen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0078",
          "number": 78,
          "speechLineNumber": 7,
          "text": "So likely an ambassador of love.",
          "plainText": "So likely an ambassador of love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0079",
          "number": 79,
          "speechLineNumber": 8,
          "text": "A day in April never came so sweet,",
          "plainText": "A day in April never came so sweet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0080",
          "number": 80,
          "speechLineNumber": 9,
          "text": "To show how costly summer was at hand,",
          "plainText": "To show how costly summer was at hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0081",
          "number": 81,
          "speechLineNumber": 10,
          "text": "As this fore-spurrer comes before his lord.",
          "plainText": "As this forespurrer comes before his lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-016",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "No more, I pray thee. I am half afeard",
          "plainText": "No more I pray thee I am half afeard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0083",
          "number": 83,
          "speechLineNumber": 2,
          "text": "Thou wilt say anon he is some kin to thee,",
          "plainText": "Thou wilt say anon he is some kin to thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0084",
          "number": 84,
          "speechLineNumber": 3,
          "text": "Thou spend'st such high-day wit in praising him.",
          "plainText": "Thou spend'st such highday wit in praising him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0085",
          "number": 85,
          "speechLineNumber": 4,
          "text": "Come, come, Nerissa, for I long to see",
          "plainText": "Come come Nerissa for I long to see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-9-line-0086",
          "number": 86,
          "speechLineNumber": 5,
          "text": "Quick Cupid's post that comes so mannerly.",
          "plainText": "Quick Cupid's post that comes so mannerly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-speech-017",
      "type": "speech",
      "speaker": {
        "id": "nerissa",
        "name": "NERISSA",
        "displayName": "Nerissa"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-9-line-0087",
          "number": 87,
          "speechLineNumber": 1,
          "text": "Bassanio, Lord Love, if thy will it be!",
          "plainText": "Bassanio Lord Love if thy will it be",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-9-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
