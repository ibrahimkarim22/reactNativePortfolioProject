    {
      "id": "the-merchant-of-venice/sceneII_22.9/p@68212",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nBehold, there stand the caskets, noble Prince,\nIf you choose that wherein I am contain’d,\nStraight shall our nuptial rites be solemniz’d.\nBut if you fail, without more speech, my lord,\nYou must be gone from hence immediately.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.9/p@68212/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.9/p@68212/line-2",
          "start": 8,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.9/p@68212/line-3",
          "start": 55,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.9/p@68212/line-4",
          "start": 98,
          "end": 145,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.9/p@68212/line-5",
          "start": 146,
          "end": 192,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.9/p@68212/line-6",
          "start": 193,
          "end": 233,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
