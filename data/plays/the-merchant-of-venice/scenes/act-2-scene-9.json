    {
      "id": "the-merchant-of-venice/sceneII_22.9/p@70768",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nToo long a pause for that which you find there.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneII_22.9/p@70768/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneII_22.9/p@70768/line-2",
          "start": 8,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3954764,
        "end": 3954849,
        "line": 146123,
        "column": 1,
        "path": "chap22/p@70768",
        "anchor": "sceneII_22.9"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-merchant-of-venice/sceneII_22.9/p@70857",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARRAGON.\nWhat’s here? The portrait of a blinking idiot\nPresenting me a schedule! I will read it.\nHow much unlike art thou to Portia!\nHow much unlike my hopes and my deservings!\n“Who chooseth me shall have as much as he deserves.”\nDid I deserve no more than a fool’s head?\nIs that my prize? Are my deserts no better?",
