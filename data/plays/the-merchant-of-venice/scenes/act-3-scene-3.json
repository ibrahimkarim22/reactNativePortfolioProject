        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.3/p@100618",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALARINO.\nI am sure the Duke\nWill never grant this forfeiture to hold.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100618/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100618/line-2",
          "start": 10,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100618/line-3",
          "start": 29,
          "end": 70,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3984614,
        "end": 3984719,
        "line": 147111,
        "column": 1,
        "path": "chap22/p@100618",
        "anchor": "sceneIII_22.3"
      },
      "speakerLabel": "SALARINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.3/p@100727",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nThe Duke cannot deny the course of law,\nFor the commodity that strangers have\nWith us in Venice, if it be denied,\n’Twill much impeach the justice of the state,\nSince that the trade and profit of the city\nConsisteth of all nations. Therefore, go.\nThese griefs and losses have so bated me\nThat I shall hardly spare a pound of flesh\nTomorrow to my bloody creditor.\nWell, gaoler, on, pray God Bassanio come\nTo see me pay his debt, and then I care not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100727/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
