    {
      "id": "the-merchant-of-venice/sceneIII_22.3/p@99347",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nHear me yet, good Shylock.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99347/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99347/line-2",
          "start": 9,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3983343,
        "end": 3983408,
        "line": 147062,
        "column": 1,
        "path": "chap22/p@99347",
        "anchor": "sceneIII_22.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.3/p@99416",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHYLOCK.\nI’ll have my bond, speak not against my bond.\nI have sworn an oath that I will have my bond.\nThou call’dst me dog before thou hadst a cause,\nBut since I am a dog, beware my fangs;\nThe Duke shall grant me justice. I do wonder,\nThou naughty gaoler, that thou art so fond\nTo come abroad with him at his request.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99416/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99416/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99416/line-3",
          "start": 55,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99416/line-4",
          "start": 102,
          "end": 149,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99416/line-5",
          "start": 150,
          "end": 188,
          "sourceLineNumber": null
        },
        {
