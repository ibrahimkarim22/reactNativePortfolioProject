    {
      "id": "the-merchant-of-venice/sceneIII_22.3/p@100241",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALARINO.\nIt is the most impenetrable cur\nThat ever kept with men.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100241/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100241/line-2",
          "start": 10,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100241/line-3",
          "start": 42,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3984237,
        "end": 3984338,
        "line": 147095,
        "column": 1,
        "path": "chap22/p@100241",
        "anchor": "sceneIII_22.3"
      },
      "speakerLabel": "SALARINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.3/p@100346",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nLet him alone.\nI’ll follow him no more with bootless prayers.\nHe seeks my life, his reason well I know:\nI oft deliver’d from his forfeitures\nMany that have at times made moan to me.\nTherefore he hates me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100346/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100346/line-2",
          "start": 9,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100346/line-3",
          "start": 24,
          "end": 70,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100346/line-4",
          "start": 71,
          "end": 112,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100346/line-5",
          "start": 113,
          "end": 149,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100346/line-6",
          "start": 150,
          "end": 190,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@100346/line-7",
          "start": 191,
          "end": 213,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3984342,
        "end": 3984610,
        "line": 147101,
        "column": 1,
        "path": "chap22/p@100346",
        "anchor": "sceneIII_22.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
