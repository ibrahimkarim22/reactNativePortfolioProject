      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nI pray thee hear me speak.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99797/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99797/line-2",
          "start": 9,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3983793,
        "end": 3983858,
        "line": 147078,
        "column": 1,
        "path": "chap22/p@99797",
        "anchor": "sceneIII_22.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.3/p@99866",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHYLOCK.\nI’ll have my bond. I will not hear thee speak.\nI’ll have my bond, and therefore speak no more.\nI’ll not be made a soft and dull-eyed fool,\nTo shake the head, relent, and sigh, and yield\nTo Christian intercessors. Follow not,\nI’ll have no speaking, I will have my bond.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99866/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99866/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
