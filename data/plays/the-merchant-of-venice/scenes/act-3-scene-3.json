    {
      "id": "the-merchant-of-venice/sceneIII_22.3/p@99186",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHYLOCK.\nGaoler, look to him. Tell not me of mercy.\nThis is the fool that lent out money gratis.\nGaoler, look to him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99186/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99186/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99186/line-3",
          "start": 52,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.3/p@99186/line-4",
          "start": 97,
          "end": 117,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3983182,
        "end": 3983339,
        "line": 147055,
        "column": 1,
        "path": "chap22/p@99186",
        "anchor": "sceneIII_22.3"
      },
      "speakerLabel": "SHYLOCK.",
      "attribution": {
