      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nCome on, Nerissa, I have work in hand\nThat you yet know not of; we’ll see our husbands\nBefore they think of us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
