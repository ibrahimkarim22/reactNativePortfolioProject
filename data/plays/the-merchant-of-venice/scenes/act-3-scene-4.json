    {
      "id": "the-merchant-of-venice/sceneIII_22.4/p@105799",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nFie, what a question’s that,\nIf thou wert near a lewd interpreter!\nBut come, I’ll tell thee all my whole device\nWhen I am in my coach, which stays for us\nAt the park gate; and therefore haste away,\nFor we must measure twenty miles today.",
      "separatorAfter": "\n\n",
      "spans": [],
