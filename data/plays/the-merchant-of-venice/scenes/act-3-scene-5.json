      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@110339",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nPast all expressing. It is very meet\nThe Lord Bassanio live an upright life,\nFor having such a blessing in his lady,\nHe finds the joys of heaven here on earth,\nAnd if on earth he do not merit it,\nIn reason he should never come to heaven.\nWhy, if two gods should play some heavenly match,\nAnd on the wager lay two earthly women,\nAnd Portia one, there must be something else\nPawn’d with the other, for the poor rude world\nHath not her fellow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@110339/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
