      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 6
        }
      ],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109892/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3993888,
        "end": 3993923,
        "line": 147419,
        "column": 1,
        "path": "chap22/p@109892",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@109931",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nO dear discretion, how his words are suited!\nThe fool hath planted in his memory\nAn army of good words, and I do know\nA many fools that stand in better place,\nGarnish’d like him, that for a tricksy word\nDefy the matter. How cheer’st thou, Jessica?\nAnd now, good sweet, say thy opinion,\nHow dost thou like the Lord Bassanio’s wife?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109931/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109931/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109931/line-3",
          "start": 54,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109931/line-4",
          "start": 90,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109931/line-5",
          "start": 127,
          "end": 167,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109931/line-6",
          "start": 168,
          "end": 211,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109931/line-7",
          "start": 212,
          "end": 256,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109931/line-8",
          "start": 257,
          "end": 294,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109931/line-9",
          "start": 295,
          "end": 339,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3993927,
        "end": 3994331,
        "line": 147421,
