        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@110977",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nNay, but ask my opinion too of that.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@110977/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@110977/line-2",
          "start": 9,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3994973,
        "end": 3995048,
        "line": 147454,
        "column": 1,
        "path": "chap22/p@110977",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "JESSICA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@111056",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nI will anon. First let us go to dinner.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@111056/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@111056/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3995052,
        "end": 3995130,
        "line": 147459,
        "column": 1,
        "path": "chap22/p@111056",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@111138",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nNay, let me praise you while I have a stomach.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@111138/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@111138/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3995134,
        "end": 3995219,
        "line": 147464,
        "column": 1,
        "path": "chap22/p@111138",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "JESSICA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@111227",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nNo pray thee, let it serve for table-talk.\nThen howsome’er thou speak’st, ’mong other things\nI shall digest it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@111227/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@111227/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@111227/line-3",
          "start": 52,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@111227/line-4",
          "start": 102,
          "end": 120,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3995223,
        "end": 3995383,
        "line": 147469,
        "column": 1,
        "path": "chap22/p@111227",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@111391",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nWell, I’ll set you forth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@111391/line-1",
