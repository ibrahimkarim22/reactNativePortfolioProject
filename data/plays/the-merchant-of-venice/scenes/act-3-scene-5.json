      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@110872",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nEven such a husband\nHast thou of me as she is for a wife.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@110872/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@110872/line-2",
          "start": 9,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@110872/line-3",
          "start": 29,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3994868,
        "end": 3994969,
        "line": 147448,
        "column": 1,
        "path": "chap22/p@110872",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
