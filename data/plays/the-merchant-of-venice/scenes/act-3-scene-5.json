  "content": [
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/h3@106144",
      "type": "heading",
      "tag": "h3",
      "classes": [],
      "text": "SCENE V. The same. A garden.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "b",
          "start": 0,
          "end": 28
        }
      ],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/h3@106144/line-1",
          "start": 0,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3990140,
        "end": 3990211,
        "line": 147288,
        "column": 1,
        "path": "chap22/h3@106144",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@106219",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Launcelet and Jessica.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 15,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 20,
          "end": 27,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@106219/line-1",
          "start": 0,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3990215,
        "end": 3990329,
        "line": 147290,
        "column": 1,
        "path": "chap22/p@106219",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@106337",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nYes, truly, for look you, the sins of the father are to be laid upon the children, therefore, I promise you, I fear you. I was always plain with you, and so now I speak my agitation of the matter. Therefore be of good cheer, for truly I think you are damn’d. There is but one hope in it that can do you any good, and that is but a kind of bastard hope neither.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@106337/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@106337/line-2",
          "start": 11,
          "end": 371,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3990333,
        "end": 3990738,
        "line": 147293,
        "column": 1,
        "path": "chap22/p@106337",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@106746",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nAnd what hope is that, I pray thee?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@106746/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@106746/line-2",
          "start": 9,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3990742,
        "end": 3990816,
        "line": 147302,
        "column": 1,
        "path": "chap22/p@106746",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "JESSICA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@106824",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nMarry, you may partly hope that your father got you not, that you are not the Jew’s daughter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@106824/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@106824/line-2",
          "start": 11,
          "end": 104,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3990820,
        "end": 3990955,
        "line": 147307,
        "column": 1,
        "path": "chap22/p@106824",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@106963",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nThat were a kind of bastard hope indeed; so the sins of my mother should be visited upon me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@106963/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@106963/line-2",
          "start": 9,
          "end": 101,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3990959,
        "end": 3991091,
        "line": 147313,
        "column": 1,
        "path": "chap22/p@106963",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "JESSICA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@107099",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nTruly then I fear you are damn’d both by father and mother; thus when I shun Scylla your father, I fall into Charybdis your mother. Well, you are gone both ways.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107099/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107099/line-2",
          "start": 11,
          "end": 172,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3991095,
        "end": 3991299,
        "line": 147319,
        "column": 1,
        "path": "chap22/p@107099",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@107307",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nI shall be saved by my husband. He hath made me a Christian.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107307/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107307/line-2",
          "start": 9,
          "end": 69,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3991303,
        "end": 3991402,
        "line": 147326,
        "column": 1,
        "path": "chap22/p@107307",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "JESSICA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@107410",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nTruly the more to blame he, we were Christians enow before, e’en as many as could well live one by another. This making of Christians will raise the price of hogs; if we grow all to be pork-eaters, we shall not shortly have a rasher on the coals for money.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107410/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107410/line-2",
          "start": 11,
          "end": 267,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3991406,
        "end": 3991706,
        "line": 147331,
        "column": 1,
        "path": "chap22/p@107410",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@107714",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Lorenzo.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107714/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3991710,
        "end": 3991779,
        "line": 147339,
        "column": 1,
        "path": "chap22/p@107714",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@107787",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nI’ll tell my husband, Launcelet, what you say. Here he comes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107787/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107787/line-2",
          "start": 9,
          "end": 70,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3991783,
        "end": 3991883,
        "line": 147341,
        "column": 1,
        "path": "chap22/p@107787",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "JESSICA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@107891",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nI shall grow jealous of you shortly, Launcelet, if you thus get my wife into corners!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107891/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@107891/line-2",
          "start": 9,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3991887,
        "end": 3992012,
        "line": 147346,
        "column": 1,
        "path": "chap22/p@107891",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@108020",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JESSICA.\nNay, you need not fear us, Lorenzo. Launcelet and I are out. He tells me flatly there’s no mercy for me in heaven, because I am a Jew’s daughter; and he says you are no good member of the commonwealth, for in converting Jews to Christians you raise the price of pork.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@108020/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@108020/line-2",
          "start": 9,
          "end": 276,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3992016,
        "end": 3992325,
        "line": 147352,
        "column": 1,
        "path": "chap22/p@108020",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "JESSICA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@108333",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nI shall answer that better to the commonwealth than you can the getting up of the negro’s belly! The Moor is with child by you, Launcelet.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@108333/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@108333/line-2",
          "start": 9,
          "end": 147,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3992329,
        "end": 3992507,
        "line": 147360,
        "column": 1,
        "path": "chap22/p@108333",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@108515",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nIt is much that the Moor should be more than reason; but if she be less than an honest woman, she is indeed more than I took her for.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@108515/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@108515/line-2",
          "start": 11,
          "end": 144,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3992511,
        "end": 3992686,
        "line": 147366,
        "column": 1,
        "path": "chap22/p@108515",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@108694",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nHow every fool can play upon the word! I think the best grace of wit will shortly turn into silence, and discourse grow commendable in none only but parrots. Go in, sirrah; bid them prepare for dinner.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@108694/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@108694/line-2",
          "start": 9,
          "end": 210,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3992690,
        "end": 3992932,
        "line": 147372,
        "column": 1,
        "path": "chap22/p@108694",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@108940",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nThat is done, sir, they have all stomachs.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@108940/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@108940/line-2",
          "start": 11,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3992936,
        "end": 3993019,
        "line": 147379,
        "column": 1,
        "path": "chap22/p@108940",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@109027",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nGoodly Lord, what a wit-snapper are you! Then bid them prepare dinner.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109027/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109027/line-2",
          "start": 9,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3993023,
        "end": 3993132,
        "line": 147384,
        "column": 1,
        "path": "chap22/p@109027",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@109140",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nThat is done too, sir, only “cover” is the word.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109140/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109140/line-2",
          "start": 11,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3993136,
        "end": 3993225,
        "line": 147389,
        "column": 1,
        "path": "chap22/p@109140",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@109233",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nWill you cover, then, sir?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109233/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109233/line-2",
          "start": 9,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3993229,
        "end": 3993294,
        "line": 147394,
        "column": 1,
        "path": "chap22/p@109233",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@109302",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nNot so, sir, neither. I know my duty.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109302/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109302/line-2",
          "start": 11,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3993298,
        "end": 3993376,
        "line": 147399,
        "column": 1,
        "path": "chap22/p@109302",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@109384",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORENZO.\nYet more quarrelling with occasion! Wilt thou show the whole wealth of thy wit in an instant? I pray thee understand a plain man in his plain meaning: go to thy fellows, bid them cover the table, serve in the meat, and we will come in to dinner.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109384/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109384/line-2",
          "start": 9,
          "end": 254,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3993380,
        "end": 3993667,
        "line": 147404,
        "column": 1,
        "path": "chap22/p@109384",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LORENZO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIII_22.5/p@109675",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LAUNCELET.\nFor the table, sir, it shall be served in; for the meat, sir, it shall be covered; for your coming in to dinner, sir, why, let it be as humours and conceits shall govern.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109675/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIII_22.5/p@109675/line-2",
          "start": 11,
          "end": 181,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 3993671,
        "end": 3993884,
        "line": 147412,
        "column": 1,
        "path": "chap22/p@109675",
        "anchor": "sceneIII_22.5"
      },
      "speakerLabel": "LAUNCELET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
