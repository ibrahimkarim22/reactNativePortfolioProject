    {
      "id": "the-merchant-of-venice/sceneIV_22.2/p@139255",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nInquire the Jew’s house out, give him this deed,\nAnd let him sign it, we’ll away tonight,\nAnd be a day before our husbands home.\nThis deed will be well welcome to Lorenzo.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139255/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139255/line-2",
          "start": 8,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139255/line-3",
          "start": 57,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139255/line-4",
          "start": 98,
          "end": 136,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139255/line-5",
          "start": 137,
          "end": 179,
          "sourceLineNumber": null
        }
      ],
