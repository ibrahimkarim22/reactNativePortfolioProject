      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GRATIANO.\nThat will I do.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139952/line-1",
