          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139952/line-2",
          "start": 10,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4023948,
        "end": 4024003,
        "line": 148557,
        "column": 1,
        "path": "chap22/p@139952",
        "anchor": "sceneIV_22.2"
      },
      "speakerLabel": "GRATIANO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIV_22.2/p@140011",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NERISSA.\nSir, I would speak with you.\n[Aside to Portia.]\nI’ll see if I can get my husband’s ring,\nWhich I did make him swear to keep for ever.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 39,
          "end": 54
        }
      ],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@140011/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@140011/line-2",
          "start": 9,
          "end": 37,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@140011/line-3",
          "start": 38,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@140011/line-4",
          "start": 57,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@140011/line-5",
          "start": 98,
          "end": 142,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4024007,
        "end": 4024201,
        "line": 148562,
        "column": 1,
        "path": "chap22/p@140011",
        "anchor": "sceneIV_22.2"
      },
      "speakerLabel": "NERISSA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIV_22.2/p@140209",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\n[To Nerissa.] Thou mayst, I warrant. We shall have old swearing\nThat they did give the rings away to men;\nBut we’ll outface them, and outswear them too.\nAway! make haste! Thou know’st where I will tarry.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 9,
          "end": 19
        }
      ],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@140209/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@140209/line-2",
          "start": 8,
          "end": 71,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@140209/line-3",
          "start": 72,
          "end": 113,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@140209/line-4",
          "start": 114,
          "end": 160,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@140209/line-5",
          "start": 161,
          "end": 211,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4024205,
        "end": 4024468,
        "line": 148570,
        "column": 1,
        "path": "chap22/p@140209",
        "anchor": "sceneIV_22.2"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIV_22.2/p@140476",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NERISSA.\nCome, good sir, will you show me to this house?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
