      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIV_22.2/p@139557",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GRATIANO.\nFair sir, you are well o’erta’en.\nMy Lord Bassanio upon more advice,\nHath sent you here this ring, and doth entreat\nYour company at dinner.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139557/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139557/line-2",
          "start": 10,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139557/line-3",
          "start": 44,
          "end": 78,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139557/line-4",
          "start": 79,
          "end": 125,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139557/line-5",
          "start": 126,
          "end": 149,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4023553,
        "end": 4023747,
        "line": 148541,
        "column": 1,
        "path": "chap22/p@139557",
        "anchor": "sceneIV_22.2"
      },
      "speakerLabel": "GRATIANO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merchant-of-venice/sceneIV_22.2/p@139755",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PORTIA.\nThat cannot be;\nHis ring I do accept most thankfully,\nAnd so I pray you tell him. Furthermore,\nI pray you show my youth old Shylock’s house.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139755/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139755/line-2",
          "start": 8,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139755/line-3",
          "start": 24,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139755/line-4",
          "start": 62,
          "end": 102,
          "sourceLineNumber": null
        },
        {
          "id": "the-merchant-of-venice/sceneIV_22.2/p@139755/line-5",
          "start": 103,
          "end": 148,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4023751,
        "end": 4023944,
        "line": 148549,
        "column": 1,
        "path": "chap22/p@139755",
        "anchor": "sceneIV_22.2"
      },
      "speakerLabel": "PORTIA.",
      "attribution": {
