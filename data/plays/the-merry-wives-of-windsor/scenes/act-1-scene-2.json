    {
      "id": "the-merry-wives-of-windsor/sceneI_23.2/p@23087",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EVANS.\nGo your ways, and ask of Doctor Caius’ house which is the way. And there dwells one Mistress Quickly, which is in the manner of his nurse, or his dry nurse, or his cook, or his laundry, his washer and his wringer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneI_23.2/p@23087/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneI_23.2/p@23087/line-2",
          "start": 7,
          "end": 220,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4066549,
        "end": 4066801,
        "line": 150329,
        "column": 1,
        "path": "chap23/p@23087",
        "anchor": "sceneI_23.2"
      },
      "speakerLabel": "EVANS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneI_23.2/p@23343",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIMPLE.\nWell, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneI_23.2/p@23343/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneI_23.2/p@23343/line-2",
          "start": 8,
          "end": 18,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4066805,
        "end": 4066853,
        "line": 150336,
        "column": 1,
        "path": "chap23/p@23343",
        "anchor": "sceneI_23.2"
      },
      "speakerLabel": "SIMPLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneI_23.2/p@23395",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EVANS.\nNay, it is petter yet. Give her this letter. For it is a ’oman that altogether’s acquaintance with Mistress Anne Page; and the letter is to desire and require her to solicit your master’s desires to Mistress Anne Page. I pray you be gone. I will make an end of my dinner; there’s pippins and cheese to come.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneI_23.2/p@23395/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
