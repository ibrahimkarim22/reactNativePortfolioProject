    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87468",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD\nWell met, Mistress Page. Whither go you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87468/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87468/line-2",
          "start": 5,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4130930,
        "end": 4131005,
        "line": 152797,
        "column": 1,
        "path": "chap23/p@87468",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "FORD",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87547",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nTruly, sir, to see your wife. Is she at home?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87547/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87547/line-2",
          "start": 15,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4131009,
        "end": 4131099,
        "line": 152802,
        "column": 1,
        "path": "chap23/p@87547",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87641",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nAy, and as idle as she may hang together, for want of company. I think if your husbands were dead you two would marry.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87641/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87641/line-2",
          "start": 6,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4131103,
        "end": 4131258,
        "line": 152807,
        "column": 1,
        "path": "chap23/p@87641",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87800",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nBe sure of that—two other husbands.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87800/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87800/line-2",
          "start": 15,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4131262,
        "end": 4131342,
        "line": 152813,
        "column": 1,
        "path": "chap23/p@87800",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87884",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nWhere had you this pretty weathercock?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87884/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87884/line-2",
          "start": 6,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4131346,
        "end": 4131420,
        "line": 152818,
        "column": 1,
        "path": "chap23/p@87884",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87962",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nI cannot tell what the dickens his name is my husband had him of. What do you call your knight’s name, sirrah?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87962/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87962/line-2",
          "start": 15,
          "end": 125,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4131424,
        "end": 4131580,
        "line": 152823,
        "column": 1,
        "path": "chap23/p@87962",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88122",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROBIN.\nSir John Falstaff.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88122/line-1",
          "start": 0,
          "end": 6,
