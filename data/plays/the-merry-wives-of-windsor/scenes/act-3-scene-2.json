    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@86954",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nNay, keep your way, little gallant. You were wont to be a follower, but now you are a leader. Whether had you rather, lead mine eyes, or eye your master’s heels?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@86954/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@86954/line-2",
          "start": 15,
          "end": 176,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4130416,
        "end": 4130624,
        "line": 152776,
        "column": 1,
        "path": "chap23/p@86954",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87166",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ROBIN.\nI had rather, forsooth, go before you like a man than follow him like a dwarf.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87166/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87166/line-2",
          "start": 7,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4130628,
        "end": 4130743,
        "line": 152783,
        "column": 1,
        "path": "chap23/p@87166",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "ROBIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87285",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nO, you are a flattering boy! Now I see you’ll be a courtier.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87285/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@87285/line-2",
          "start": 15,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4130747,
        "end": 4130852,
        "line": 152788,
        "column": 1,
        "path": "chap23/p@87285",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
