      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nSir John Falstaff!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88181/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88181/line-2",
          "start": 6,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4131643,
        "end": 4131697,
        "line": 152834,
        "column": 1,
        "path": "chap23/p@88181",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88239",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nHe, he; I can never hit on’s name. There is such a league between my good man and he! Is your wife at home indeed?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88239/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88239/line-2",
          "start": 15,
          "end": 129,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4131701,
        "end": 4131861,
        "line": 152839,
        "column": 1,
        "path": "chap23/p@88239",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88403",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nIndeed she is.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88403/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88403/line-2",
          "start": 6,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4131865,
        "end": 4131915,
        "line": 152845,
        "column": 1,
        "path": "chap23/p@88403",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88457",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nBy your leave, sir, I am sick till I see her.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88457/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88457/line-2",
          "start": 15,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4131919,
        "end": 4132009,
        "line": 152850,
        "column": 1,
        "path": "chap23/p@88457",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88551",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt Mistress Page and Robin.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 21,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 26,
          "end": 31,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 32
        }
      ],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@88551/line-1",
          "start": 0,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4132013,
        "end": 4132139,
        "line": 152855,
        "column": 1,
        "path": "chap23/p@88551",
        "anchor": "sceneIII_23.2"
      },
