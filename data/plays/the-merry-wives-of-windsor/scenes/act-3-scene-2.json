      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD\n[Aside.] I think I shall drink in pipe-wine first with him; I’ll make him dance.—Will you go, gentles?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 6,
          "end": 11
        }
      ],
      "lines": [
