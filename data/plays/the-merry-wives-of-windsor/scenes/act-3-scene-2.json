      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@92440",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALL.\nHave with you to see this monster.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@92440/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
