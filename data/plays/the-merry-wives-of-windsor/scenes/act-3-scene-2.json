        "evidence": "reviewed-source-cue"
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@89938",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nTrust me, a good knot. I have good cheer at home, and I pray you all go with me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@89938/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@89938/line-2",
          "start": 6,
          "end": 86,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4133400,
        "end": 4133517,
        "line": 152887,
        "column": 1,
        "path": "chap23/p@89938",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90059",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nI must excuse myself, Master Ford.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90059/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90059/line-2",
          "start": 9,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4133521,
        "end": 4133594,
        "line": 152893,
        "column": 1,
        "path": "chap23/p@90059",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90136",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SLENDER.\nAnd so must I, sir; we have appointed to dine with Mistress Anne, and I would not break with her for more money than I’ll speak of.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90136/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90136/line-2",
          "start": 9,
          "end": 140,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4133598,
        "end": 4133769,
        "line": 152898,
        "column": 1,
        "path": "chap23/p@90136",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "SLENDER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90311",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nWe have lingered about a match between Anne Page and my cousin Slender, and this day we shall have our answer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90311/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90311/line-2",
          "start": 9,
          "end": 119,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4133773,
        "end": 4133923,
        "line": 152904,
        "column": 1,
        "path": "chap23/p@90311",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90465",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SLENDER.\nI hope I have your good will, father Page.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90465/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90465/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4133927,
        "end": 4134008,
        "line": 152910,
        "column": 1,
        "path": "chap23/p@90465",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "SLENDER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90550",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAGE.\nYou have, Master Slender, I stand wholly for you.—But my wife, Master doctor, is for you altogether.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90550/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90550/line-2",
          "start": 6,
          "end": 106,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4134012,
        "end": 4134149,
        "line": 152915,
        "column": 1,
        "path": "chap23/p@90550",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90691",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAIUS.\nAy, be-gar; and de maid is love-a me! My nursh-a Quickly tell me so mush.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90691/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90691/line-2",
          "start": 7,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4134153,
        "end": 4134263,
        "line": 152921,
        "column": 1,
        "path": "chap23/p@90691",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "CAIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90805",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOST.\nWhat say you to young Master Fenton? He capers, he dances, he has eyes of youth, he writes verses, he speaks holiday, he smells April and May. He will carry ’t, he will carry ’t. ’Tis in his buttons he will carry ’t.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90805/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@90805/line-2",
          "start": 6,
          "end": 222,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4134267,
        "end": 4134521,
        "line": 152926,
        "column": 1,
        "path": "chap23/p@90805",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "HOST.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@91063",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAGE.\nNot by my consent, I promise you. The gentleman is of no having. He kept company with the wild Prince and Poins. He is of too high a region, he knows too much. No, he shall not knit a knot in his fortunes with the finger of my substance. If he take her, let him take her simply. The wealth I have waits on my consent, and my consent goes not that way.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@91063/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@91063/line-2",
          "start": 6,
          "end": 357,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4134525,
        "end": 4134916,
        "line": 152933,
        "column": 1,
        "path": "chap23/p@91063",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@91458",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nI beseech you, heartily, some of you go home with me to dinner. Besides your cheer, you shall have sport: I will show you a monster. Master Doctor, you shall go; so shall you, Master Page, and you, Sir Hugh.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@91458/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@91458/line-2",
          "start": 6,
          "end": 213,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4134920,
        "end": 4135165,
        "line": 152942,
        "column": 1,
        "path": "chap23/p@91458",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@91707",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nWell, fare you well. We shall have the freer wooing at Master Page’s.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@91707/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@91707/line-2",
          "start": 9,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4135169,
        "end": 4135277,
        "line": 152949,
        "column": 1,
        "path": "chap23/p@91707",
        "anchor": "sceneIII_23.2"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
