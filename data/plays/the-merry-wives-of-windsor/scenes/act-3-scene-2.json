      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW, PAGE, etc.\nWell met, Master Ford.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@89862/line-1",
          "start": 0,
          "end": 19,
