      "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@92093",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOST\nFarewell, my hearts. I will to my honest knight Falstaff, and drink canary with him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIII_23.2/p@92093/line-1",
