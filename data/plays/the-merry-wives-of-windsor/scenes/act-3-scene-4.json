  },
  "content": [
    {
      "id": "the-merry-wives-of-windsor-3-4-stage-001",
      "type": "stage",
      "text": "Enter Fenton and Anne Page."
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "fenton",
        "name": "FENTON",
        "displayName": "Fenton"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I see I cannot get thy father's love;",
          "plainText": "I see I cannot get thy father's love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Therefore no more turn me to him, sweet Nan.",
          "plainText": "Therefore no more turn me to him sweet Nan",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "anne",
        "name": "ANNE",
        "displayName": "Anne"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Alas, how then?",
          "plainText": "Alas how then",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "fenton",
        "name": "FENTON",
        "displayName": "Fenton"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Why, thou must be thyself.",
          "plainText": "Why thou must be thyself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "He doth object I am too great of birth,",
          "plainText": "He doth object I am too great of birth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "And that my state being galled with my expense,",
          "plainText": "And that my state being galled with my expense",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "I seek to heal it only by his wealth.",
          "plainText": "I seek to heal it only by his wealth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "Besides these, other bars he lays before me:",
          "plainText": "Besides these other bars he lays before me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0009",
          "number": 9,
          "speechLineNumber": 6,
          "text": "My riots past, my wild societies—",
          "plainText": "My riots past my wild societies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0010",
          "number": 10,
          "speechLineNumber": 7,
          "text": "And tells me 'tis a thing impossible",
          "plainText": "And tells me 'tis a thing impossible",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0011",
          "number": 11,
          "speechLineNumber": 8,
          "text": "I should love thee but as a property.",
          "plainText": "I should love thee but as a property",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "anne",
        "name": "ANNE",
        "displayName": "Anne"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Maybe he tells you true.",
          "plainText": "Maybe he tells you true",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "fenton",
        "name": "FENTON",
        "displayName": "Fenton"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "No, heaven so speed me in my time to come!",
          "plainText": "No heaven so speed me in my time to come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Albeit I will confess thy father's wealth",
          "plainText": "Albeit I will confess thy father's wealth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "Was the first motive that I wooed thee, Anne,",
          "plainText": "Was the first motive that I wooed thee Anne",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "Yet, wooing thee, I found thee of more value",
          "plainText": "Yet wooing thee I found thee of more value",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0017",
          "number": 17,
          "speechLineNumber": 5,
          "text": "Than stamps in gold or sums in sealed bags.",
          "plainText": "Than stamps in gold or sums in sealed bags",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0018",
          "number": 18,
          "speechLineNumber": 6,
          "text": "And 'tis the very riches of thyself",
          "plainText": "And 'tis the very riches of thyself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0019",
          "number": 19,
          "speechLineNumber": 7,
          "text": "That now I aim at.",
          "plainText": "That now I aim at",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "anne",
        "name": "ANNE",
        "displayName": "Anne"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Gentle Master Fenton,",
          "plainText": "Gentle Master Fenton",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Yet seek my father's love, still seek it, sir.",
          "plainText": "Yet seek my father's love still seek it sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "If opportunity and humblest suit",
          "plainText": "If opportunity and humblest suit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Cannot attain it, why then—hark you hither.",
          "plainText": "Cannot attain it why thenhark you hither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-stage-002",
      "type": "stage",
      "text": "[They talk apart.]"
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-stage-003",
      "type": "stage",
      "text": "Enter Shallow, Slender and Mistress Quickly."
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Break their talk, Mistress Quickly. My kinsman shall speak for himself.",
          "plainText": "Break their talk Mistress Quickly My kinsman shall speak for himself",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "I'll make a shaft or a bolt on 't. 'Slid, 'tis but venturing.",
          "plainText": "I'll make a shaft or a bolt on 't 'Slid 'tis but venturing",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Be not dismayed.",
          "plainText": "Be not dismayed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "No, she shall not dismay me. I care not for that, but that I am afeard.",
          "plainText": "No she shall not dismay me I care not for that but that I am afeard",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Hark ye, Master Slender would speak a word with you.",
          "plainText": "Hark ye Master Slender would speak a word with you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "anne",
        "name": "ANNE",
        "displayName": "Anne"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I come to him.",
          "plainText": "I come to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "[Aside.] This is my father's choice.",
          "plainText": "Aside This is my father's choice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "O, what a world of vile ill-favoured faults",
          "plainText": "O what a world of vile illfavoured faults",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "Looks handsome in three hundred pounds a year!",
          "plainText": "Looks handsome in three hundred pounds a year",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "And how does good Master Fenton? Pray you, a word with you.",
          "plainText": "And how does good Master Fenton Pray you a word with you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-stage-004",
      "type": "stage",
      "text": "[They talk aside.]"
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "[To Slender.] She's coming; to her, coz. O boy, thou hadst a father!",
          "plainText": "To Slender She's coming to her coz O boy thou hadst a father",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "I had a father, Mistress Anne; my uncle can tell you good jests of him.—Pray you, uncle, tell Mistress Anne the jest how my father stole two geese out of a pen, good uncle.",
          "plainText": "I had a father Mistress Anne my uncle can tell you good jests of himPray you uncle tell Mistress Anne the jest how my father stole two geese out of a pen good uncle",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Mistress Anne, my cousin loves you.",
          "plainText": "Mistress Anne my cousin loves you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Ay, that I do, as well as I love any woman in Gloucestershire.",
          "plainText": "Ay that I do as well as I love any woman in Gloucestershire",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "He will maintain you like a gentlewoman.",
          "plainText": "He will maintain you like a gentlewoman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Ay, that I will, come cut and long-tail, under the degree of a squire.",
          "plainText": "Ay that I will come cut and longtail under the degree of a squire",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "He will make you a hundred and fifty pounds jointure.",
          "plainText": "He will make you a hundred and fifty pounds jointure",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "anne",
        "name": "ANNE",
        "displayName": "Anne"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Good Master Shallow, let him woo for himself.",
          "plainText": "Good Master Shallow let him woo for himself",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Marry, I thank you for it, I thank you for that good comfort.—She calls you, coz; I'll leave you.",
          "plainText": "Marry I thank you for it I thank you for that good comfortShe calls you coz I'll leave you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "anne",
        "name": "ANNE",
        "displayName": "Anne"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Now, Master Slender.",
          "plainText": "Now Master Slender",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Now, good Mistress Anne.",
          "plainText": "Now good Mistress Anne",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-025",
      "type": "speech",
      "speaker": {
        "id": "anne",
        "name": "ANNE",
        "displayName": "Anne"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "What is your will?",
          "plainText": "What is your will",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-026",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "My will? 'Od's heartlings, that's a pretty jest indeed! I ne'er made my will yet, I thank heaven. I am not such a sickly creature, I give heaven praise.",
          "plainText": "My will 'Od's heartlings that's a pretty jest indeed I ne'er made my will yet I thank heaven I am not such a sickly creature I give heaven praise",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-027",
      "type": "speech",
      "speaker": {
        "id": "anne",
        "name": "ANNE",
        "displayName": "Anne"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "I mean, Master Slender, what would you with me?",
          "plainText": "I mean Master Slender what would you with me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-028",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Truly, for mine own part I would little or nothing with you. Your father and my uncle hath made motions. If it be my luck, so; if not, happy man be his dole. They can tell you how things go better than I can. You may ask your father. Here he comes.",
          "plainText": "Truly for mine own part I would little or nothing with you Your father and my uncle hath made motions If it be my luck so if not happy man be his dole They can tell you how things go better than I can You may ask your father Here he comes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-stage-005",
      "type": "stage",
      "text": "Enter Page and Mistress Page."
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-029",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Now, Master Slender.—Love him, daughter Anne.—",
          "plainText": "Now Master SlenderLove him daughter Anne",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Why, how now? What does Master Fenton here?",
          "plainText": "Why how now What does Master Fenton here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "You wrong me, sir, thus still to haunt my house.",
          "plainText": "You wrong me sir thus still to haunt my house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "I told you, sir, my daughter is disposed of.",
          "plainText": "I told you sir my daughter is disposed of",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-030",
      "type": "speech",
      "speaker": {
        "id": "fenton",
        "name": "FENTON",
        "displayName": "Fenton"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Nay, Master Page, be not impatient.",
          "plainText": "Nay Master Page be not impatient",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-031",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Good Master Fenton, come not to my child.",
          "plainText": "Good Master Fenton come not to my child",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-032",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "She is no match for you.",
          "plainText": "She is no match for you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-033",
      "type": "speech",
      "speaker": {
        "id": "fenton",
        "name": "FENTON",
        "displayName": "Fenton"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Sir, will you hear me?",
          "plainText": "Sir will you hear me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-034",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "No, good Master Fenton.—",
          "plainText": "No good Master Fenton",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "Come, Master Shallow; come, son Slender, in.—",
          "plainText": "Come Master Shallow come son Slender in",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0059",
          "number": 59,
          "speechLineNumber": 3,
          "text": "Knowing my mind, you wrong me, Master Fenton.",
          "plainText": "Knowing my mind you wrong me Master Fenton",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-stage-006",
      "type": "stage",
      "text": "[Exeunt Page, Shallow and Slender.]"
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-035",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Speak to Mistress Page.",
          "plainText": "Speak to Mistress Page",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-036",
      "type": "speech",
      "speaker": {
        "id": "fenton",
        "name": "FENTON",
        "displayName": "Fenton"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Good Mistress Page, for that I love your daughter",
          "plainText": "Good Mistress Page for that I love your daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "In such a righteous fashion as I do,",
          "plainText": "In such a righteous fashion as I do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "Perforce, against all checks, rebukes, and manners,",
          "plainText": "Perforce against all checks rebukes and manners",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0064",
          "number": 64,
          "speechLineNumber": 4,
          "text": "I must advance the colours of my love",
          "plainText": "I must advance the colours of my love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0065",
          "number": 65,
          "speechLineNumber": 5,
          "text": "And not retire. Let me have your good will.",
          "plainText": "And not retire Let me have your good will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-037",
      "type": "speech",
      "speaker": {
        "id": "anne",
        "name": "ANNE",
        "displayName": "Anne"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Good mother, do not marry me to yond fool.",
          "plainText": "Good mother do not marry me to yond fool",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-038",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "I mean it not; I seek you a better husband.",
          "plainText": "I mean it not I seek you a better husband",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-039",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "That's my master, Master Doctor.",
          "plainText": "That's my master Master Doctor",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-040",
      "type": "speech",
      "speaker": {
        "id": "anne",
        "name": "ANNE",
        "displayName": "Anne"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Alas, I had rather be set quick i' th' earth,",
          "plainText": "Alas I had rather be set quick i' th' earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "And bowled to death with turnips.",
          "plainText": "And bowled to death with turnips",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-041",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Come, trouble not yourself, good Master Fenton,",
          "plainText": "Come trouble not yourself good Master Fenton",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "I will not be your friend, nor enemy.",
          "plainText": "I will not be your friend nor enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "My daughter will I question how she loves you,",
          "plainText": "My daughter will I question how she loves you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0074",
          "number": 74,
          "speechLineNumber": 4,
          "text": "And as I find her, so am I affected.",
          "plainText": "And as I find her so am I affected",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0075",
          "number": 75,
          "speechLineNumber": 5,
          "text": "Till then, farewell, sir. She must needs go in;",
          "plainText": "Till then farewell sir She must needs go in",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0076",
          "number": 76,
          "speechLineNumber": 6,
          "text": "Her father will be angry.",
          "plainText": "Her father will be angry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-042",
      "type": "speech",
      "speaker": {
        "id": "fenton",
        "name": "FENTON",
        "displayName": "Fenton"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Farewell, gentle mistress. Farewell, Nan.",
          "plainText": "Farewell gentle mistress Farewell Nan",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-stage-007",
      "type": "stage",
      "text": "[Exeunt Mistress Page and Anne.]"
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-043",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "This is my doing now. \"Nay,\" said I, \"will you cast away your child on a fool, and a physician? Look on Master Fenton.\" This is my doing.",
          "plainText": "This is my doing now Nay said I will you cast away your child on a fool and a physician Look on Master Fenton This is my doing",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-4-speech-044",
      "type": "speech",
      "speaker": {
        "id": "fenton",
        "name": "FENTON",
        "displayName": "Fenton"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "I thank thee; and I pray thee, once tonight",
          "plainText": "I thank thee and I pray thee once tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-3-4-line-0080",
          "number": 80,
