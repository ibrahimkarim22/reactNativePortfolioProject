  "content": [
    {
      "id": "the-merry-wives-of-windsor-4-1-stage-001",
      "type": "stage",
      "text": "Enter Mistress Page, Mistress Quickly and William."
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Is he at Master Ford's already, think'st thou?",
          "plainText": "Is he at Master Ford's already think'st thou",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Sure he is by this; or will be presently. But truly he is very courageous mad about his throwing into the water. Mistress Ford desires you to come suddenly.",
          "plainText": "Sure he is by this or will be presently But truly he is very courageous mad about his throwing into the water Mistress Ford desires you to come suddenly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "I'll be with her by and by. I'll but bring my young man here to school. Look where his master comes; 'tis a playing day, I see.",
          "plainText": "I'll be with her by and by I'll but bring my young man here to school Look where his master comes 'tis a playing day I see",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-stage-002",
      "type": "stage",
      "text": "Enter Sir Hugh Evans."
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "No, Master Slender is let the boys leave to play.",
          "plainText": "No Master Slender is let the boys leave to play",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Blessing of his heart!",
          "plainText": "Blessing of his heart",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Sir Hugh, my husband says my son profits nothing in the world at his book. I pray you ask him some questions in his accidence.",
          "plainText": "Sir Hugh my husband says my son profits nothing in the world at his book I pray you ask him some questions in his accidence",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Come hither, William. Hold up your head, come.",
          "plainText": "Come hither William Hold up your head come",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Come on, sirrah. Hold up your head. Answer your master, be not afraid.",
          "plainText": "Come on sirrah Hold up your head Answer your master be not afraid",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "William, how many numbers is in nouns?",
          "plainText": "William how many numbers is in nouns",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Two.",
          "plainText": "Two",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Truly, I thought there had been one number more, because they say \"'Od's nouns.\"",
          "plainText": "Truly I thought there had been one number more because they say 'Od's nouns",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Peace your tattlings! What is \"fair,\" William?",
          "plainText": "Peace your tattlings What is fair William",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Pulcher.",
          "plainText": "Pulcher",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Polecats? There are fairer things than polecats, sure.",
          "plainText": "Polecats There are fairer things than polecats sure",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "You are a very simplicity 'oman; I pray you, peace.—What is lapis, William?",
          "plainText": "You are a very simplicity 'oman I pray you peaceWhat is lapis William",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "A stone.",
          "plainText": "A stone",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "And what is \"a stone,\" William?",
          "plainText": "And what is a stone William",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "A pebble.",
          "plainText": "A pebble",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "No, it is lapis. I pray you remember in your prain.",
          "plainText": "No it is lapis I pray you remember in your prain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Lapis.",
          "plainText": "Lapis",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "That is a good William. What is he, William, that does lend articles?",
          "plainText": "That is a good William What is he William that does lend articles",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Articles are borrowed of the pronoun, and be thus declined: singulariter, nominativo, hic, haec, hoc.",
          "plainText": "Articles are borrowed of the pronoun and be thus declined singulariter nominativo hic haec hoc",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Nominativo, hig, haeg, hog, pray you, mark: genitivo, huius. Well, what is your accusative case?",
          "plainText": "Nominativo hig haeg hog pray you mark genitivo huius Well what is your accusative case",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Accusativo, hinc.",
          "plainText": "Accusativo hinc",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "I pray you, have your remembrance, child. Accusativo, hung, hang, hog.",
          "plainText": "I pray you have your remembrance child Accusativo hung hang hog",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "\"Hang-hog\" is Latin for bacon, I warrant you.",
          "plainText": "Hanghog is Latin for bacon I warrant you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Leave your prabbles, 'oman.—What is the focative case, William?",
          "plainText": "Leave your prabbles 'omanWhat is the focative case William",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "O—vocativo—O—",
          "plainText": "OvocativoO",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Remember, William; focative is caret.",
          "plainText": "Remember William focative is caret",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "mistress-quickly",
        "name": "MISTRESS QUICKLY",
        "displayName": "Mistress Quickly"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "And that's a good root.",
          "plainText": "And that's a good root",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-031",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "'Oman, forbear.",
          "plainText": "'Oman forbear",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-1-speech-032",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Peace.",
          "plainText": "Peace",
