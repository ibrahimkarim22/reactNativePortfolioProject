      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Sir, the Germans desire to have three of your horses. The Duke himself will be tomorrow at court, and they are going to meet him.",
          "plainText": "Sir the Germans desire to have three of your horses The Duke himself will be tomorrow at court and they are going to meet him",
