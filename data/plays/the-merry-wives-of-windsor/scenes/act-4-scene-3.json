      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "They shall have my horses, but I'll make them pay, I'll sauce them. They have had my house a week at command; I have turned away my other guests. They must come off, I'll sauce them. Come.",
