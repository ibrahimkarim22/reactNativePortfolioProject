      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@143887/line-1",
          "start": 0,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4187349,
        "end": 4187463,
        "line": 155086,
        "column": 1,
        "path": "chap23/p@143887",
        "anchor": "sceneIV_23.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144005",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BARDOLPH.\nSir, the Germans desire to have three of your horses. The Duke himself will be tomorrow at court, and they are going to meet him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144005/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144005/line-2",
          "start": 10,
          "end": 139,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4187467,
        "end": 4187637,
        "line": 155091,
        "column": 1,
        "path": "chap23/p@144005",
        "anchor": "sceneIV_23.3"
      },
      "speakerLabel": "BARDOLPH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144179",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOST.\nWhat duke should that be comes so secretly? I hear not of him in the court. Let me speak with the gentlemen. They speak English?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144179/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144179/line-2",
          "start": 6,
          "end": 134,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4187641,
        "end": 4187806,
        "line": 155097,
        "column": 1,
        "path": "chap23/p@144179",
        "anchor": "sceneIV_23.3"
      },
      "speakerLabel": "HOST.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144348",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BARDOLPH.\nAy, sir. I’ll call them to you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144348/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144348/line-2",
          "start": 10,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4187810,
        "end": 4187881,
        "line": 155103,
        "column": 1,
        "path": "chap23/p@144348",
        "anchor": "sceneIV_23.3"
      },
      "speakerLabel": "BARDOLPH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144423",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOST.\nThey shall have my horses, but I’ll make them pay, I’ll sauce them. They have had my house a week at command; I have turned away my other guests. They must come off, I’ll sauce them. Come.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144423/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.3/p@144423/line-2",
          "start": 6,
          "end": 194,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4187885,
        "end": 4188111,
        "line": 155108,
        "column": 1,
        "path": "chap23/p@144423",
        "anchor": "sceneIV_23.3"
      },
      "speakerLabel": "HOST.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
