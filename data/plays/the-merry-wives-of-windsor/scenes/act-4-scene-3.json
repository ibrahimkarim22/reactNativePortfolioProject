      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "What duke should that be comes so secretly? I hear not of him in the court. Let me speak with the gentlemen. They speak English?",
          "plainText": "What duke should that be comes so secretly I hear not of him in the court Let me speak with the gentlemen They speak English",
