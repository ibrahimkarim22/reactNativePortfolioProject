      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Ay, sir. I'll call them to you.",
          "plainText": "Ay sir I'll call them to you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
