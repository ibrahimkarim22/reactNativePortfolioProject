          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0071",
          "number": 71,
          "speechLineNumber": 4,
          "text": "And marry her at Eton.—Go, send to Falstaff straight.",
          "plainText": "And marry her at EtonGo send to Falstaff straight",
