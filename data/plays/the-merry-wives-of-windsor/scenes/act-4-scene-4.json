      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nFear not you that. Go, get us properties\nAnd tricking for our fairies.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@149472/line-1",
