      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nMy Nan shall be the queen of all the fairies,\nFinely attired in a robe of white.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@148998/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@148998/line-2",
          "start": 15,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@148998/line-3",
          "start": 61,
          "end": 95,
          "sourceLineNumber": null
        }
