        "name": "FORD",
        "displayName": "Ford"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "That will be excellent. I'll go buy them vizards.",
