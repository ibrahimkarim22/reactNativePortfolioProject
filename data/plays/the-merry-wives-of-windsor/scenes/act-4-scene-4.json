      },
      "speakerLabel": "FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@148752",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EVANS.\nI will teach the children their behaviours, and I will be like a jackanapes also, to burn the knight with my taber.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@148752/line-1",
