          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "And mock him home to Windsor.",
          "plainText": "And mock him home to Windsor",
