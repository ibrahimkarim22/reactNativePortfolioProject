      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nGo, Mistress Ford.\nSend quickly to Sir John to know his mind.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@149833/line-1",
