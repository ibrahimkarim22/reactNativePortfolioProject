          "number": 56,
          "speechLineNumber": 1,
          "text": "And till he tell the truth,",
          "plainText": "And till he tell the truth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0057",
          "number": 57,
          "speechLineNumber": 2,
          "text": "Let the supposed fairies pinch him sound",
