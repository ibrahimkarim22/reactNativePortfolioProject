      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nThe children must\nBe practised well to this, or they’ll ne’er do ’t.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
