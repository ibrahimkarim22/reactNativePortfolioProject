    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@144772",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Page, Ford, Mistress Page, Mistress Ford and Sir Hugh Evans.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 46,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 51,
          "end": 65,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@144772/line-1",
          "start": 0,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4188234,
        "end": 4188390,
        "line": 155119,
        "column": 1,
        "path": "chap23/p@144772",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@144932",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EVANS.\n’Tis one of the best discretions of a ’oman as ever I did look upon.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@144932/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@144932/line-2",
          "start": 7,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4188394,
        "end": 4188499,
        "line": 155124,
        "column": 1,
        "path": "chap23/p@144932",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "EVANS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145041",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAGE.\nAnd did he send you both these letters at an instant?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145041/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145041/line-2",
          "start": 6,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4188503,
        "end": 4188592,
        "line": 155129,
        "column": 1,
        "path": "chap23/p@145041",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145134",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nWithin a quarter of an hour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145134/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145134/line-2",
          "start": 15,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4188596,
        "end": 4188669,
        "line": 155134,
        "column": 1,
        "path": "chap23/p@145134",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145211",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nPardon me, wife. Henceforth, do what thou wilt.\nI rather will suspect the sun with cold\nThan thee with wantonness. Now doth thy honour stand,\nIn him that was of late an heretic,\nAs firm as faith.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145211/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145211/line-2",
          "start": 6,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145211/line-3",
          "start": 54,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145211/line-4",
          "start": 94,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145211/line-5",
          "start": 148,
          "end": 183,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145211/line-6",
          "start": 184,
          "end": 201,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4188673,
        "end": 4188924,
        "line": 155139,
        "column": 1,
        "path": "chap23/p@145211",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145466",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAGE.\n’Tis well, ’tis well, no more.\nBe not as extreme in submission as in offence.\nBut let our plot go forward. Let our wives\nYet once again, to make us public sport,\nAppoint a meeting with this old fat fellow,\nWhere we may take him and disgrace him for it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145466/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145466/line-2",
          "start": 6,
          "end": 36,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145466/line-3",
          "start": 37,
          "end": 83,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145466/line-4",
          "start": 84,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145466/line-5",
          "start": 127,
          "end": 167,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145466/line-6",
          "start": 168,
          "end": 211,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145466/line-7",
          "start": 212,
          "end": 258,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4188928,
        "end": 4189241,
        "line": 155148,
        "column": 1,
        "path": "chap23/p@145466",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145783",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nThere is no better way than that they spoke of.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145783/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145783/line-2",
          "start": 6,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4189245,
        "end": 4189328,
        "line": 155158,
        "column": 1,
        "path": "chap23/p@145783",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145870",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAGE.\nHow? To send him word they’ll meet him in the park at midnight? Fie, fie, he’ll never come.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145870/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@145870/line-2",
          "start": 6,
          "end": 97,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4189332,
        "end": 4189460,
        "line": 155163,
        "column": 1,
        "path": "chap23/p@145870",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146002",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EVANS.\nYou say he has been thrown in the rivers, and has been grievously peaten as an old ’oman. Methinks there should be terrors in him, that he should not come. Methinks his flesh is punished; he shall have no desires.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146002/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146002/line-2",
          "start": 7,
          "end": 220,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4189464,
        "end": 4189716,
        "line": 155169,
        "column": 1,
        "path": "chap23/p@146002",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "EVANS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146258",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAGE.\nSo think I too.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146258/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146258/line-2",
          "start": 6,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4189720,
        "end": 4189771,
        "line": 155176,
        "column": 1,
        "path": "chap23/p@146258",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146313",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS FORD.\nDevise but how you’ll use him when he comes,\nAnd let us two devise to bring him thither.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146313/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146313/line-2",
          "start": 15,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146313/line-3",
          "start": 60,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4189775,
        "end": 4189913,
        "line": 155181,
        "column": 1,
        "path": "chap23/p@146313",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "MISTRESS FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nThere is an old tale goes that Herne the hunter,\nSometime a keeper here in Windsor Forest,\nDoth all the winter time, at still midnight,\nWalk round about an oak, with great ragged horns,\nAnd there he blasts the tree, and takes the cattle,\nAnd makes milch-kine yield blood, and shakes a chain\nIn a most hideous and dreadful manner.\nYou have heard of such a spirit, and well you know\nThe superstitious idle-headed eld\nReceived and did deliver to our age,\nThis tale of Herne the hunter for a truth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-2",
          "start": 15,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-3",
          "start": 64,
          "end": 105,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-4",
          "start": 106,
          "end": 150,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-5",
          "start": 151,
          "end": 200,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-6",
          "start": 201,
          "end": 252,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-7",
          "start": 253,
          "end": 305,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-8",
          "start": 306,
          "end": 344,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-9",
          "start": 345,
          "end": 395,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-10",
          "start": 396,
          "end": 429,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-11",
          "start": 430,
          "end": 466,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@146455/line-12",
          "start": 467,
          "end": 509,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4189917,
        "end": 4190506,
        "line": 155187,
        "column": 1,
        "path": "chap23/p@146455",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@147048",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAGE.\nWhy, yet there want not many that do fear\nIn deep of night to walk by this Herne’s oak.\nBut what of this?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@147048/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@147048/line-2",
          "start": 6,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@147048/line-3",
          "start": 48,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@147048/line-4",
          "start": 94,
          "end": 111,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4190510,
        "end": 4190661,
        "line": 155202,
        "column": 1,
        "path": "chap23/p@147048",
        "anchor": "sceneIV_23.4"
      },
      "speakerLabel": "PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@147203",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS FORD.\nMarry, this is our device,\nThat Falstaff at that oak shall meet with us,\nDisguised like Herne, with huge horns on his head.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@147203/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@147203/line-2",
          "start": 15,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@147203/line-3",
          "start": 42,
          "end": 87,
          "sourceLineNumber": null
        },
        {
