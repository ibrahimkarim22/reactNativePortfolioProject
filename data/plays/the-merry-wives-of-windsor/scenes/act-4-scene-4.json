      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nThe truth being known,\nWe’ll all present ourselves, dis-horn the spirit,\nAnd mock him home to Windsor.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@148478/line-1",
