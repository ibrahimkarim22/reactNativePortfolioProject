  "content": [
    {
      "id": "the-merry-wives-of-windsor-4-4-stage-001",
      "type": "stage",
      "text": "Enter Page, Ford, Mistress Page, Mistress Ford and Sir Hugh Evans."
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "'Tis one of the best discretions of a 'oman as ever I did look upon.",
          "plainText": "'Tis one of the best discretions of a 'oman as ever I did look upon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "And did he send you both these letters at an instant?",
          "plainText": "And did he send you both these letters at an instant",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Within a quarter of an hour.",
          "plainText": "Within a quarter of an hour",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "ford",
        "name": "FORD",
        "displayName": "Ford"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Pardon me, wife. Henceforth, do what thou wilt.",
          "plainText": "Pardon me wife Henceforth do what thou wilt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "I rather will suspect the sun with cold",
          "plainText": "I rather will suspect the sun with cold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Than thee with wantonness. Now doth thy honour stand,",
          "plainText": "Than thee with wantonness Now doth thy honour stand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "In him that was of late an heretic,",
          "plainText": "In him that was of late an heretic",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "As firm as faith.",
          "plainText": "As firm as faith",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "'Tis well, 'tis well, no more.",
          "plainText": "'Tis well 'tis well no more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Be not as extreme in submission as in offence.",
          "plainText": "Be not as extreme in submission as in offence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "But let our plot go forward. Let our wives",
          "plainText": "But let our plot go forward Let our wives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "Yet once again, to make us public sport,",
          "plainText": "Yet once again to make us public sport",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "Appoint a meeting with this old fat fellow,",
          "plainText": "Appoint a meeting with this old fat fellow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0014",
          "number": 14,
          "speechLineNumber": 6,
          "text": "Where we may take him and disgrace him for it.",
          "plainText": "Where we may take him and disgrace him for it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "ford",
        "name": "FORD",
        "displayName": "Ford"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "There is no better way than that they spoke of.",
          "plainText": "There is no better way than that they spoke of",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "How? To send him word they'll meet him in the park at midnight? Fie, fie, he'll never come.",
          "plainText": "How To send him word they'll meet him in the park at midnight Fie fie he'll never come",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "You say he has been thrown in the rivers, and has been grievously peaten as an old 'oman. Methinks there should be terrors in him, that he should not come. Methinks his flesh is punished; he shall have no desires.",
          "plainText": "You say he has been thrown in the rivers and has been grievously peaten as an old 'oman Methinks there should be terrors in him that he should not come Methinks his flesh is punished he shall have no desires",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "So think I too.",
          "plainText": "So think I too",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "mistress-ford",
        "name": "MISTRESS FORD",
        "displayName": "Mistress Ford"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Devise but how you'll use him when he comes,",
          "plainText": "Devise but how you'll use him when he comes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "And let us two devise to bring him thither.",
          "plainText": "And let us two devise to bring him thither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "There is an old tale goes that Herne the hunter,",
          "plainText": "There is an old tale goes that Herne the hunter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "Sometime a keeper here in Windsor Forest,",
          "plainText": "Sometime a keeper here in Windsor Forest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "Doth all the winter time, at still midnight,",
          "plainText": "Doth all the winter time at still midnight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "Walk round about an oak, with great ragged horns,",
          "plainText": "Walk round about an oak with great ragged horns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "And there he blasts the tree, and takes the cattle,",
          "plainText": "And there he blasts the tree and takes the cattle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0026",
          "number": 26,
          "speechLineNumber": 6,
          "text": "And makes milch-kine yield blood, and shakes a chain",
          "plainText": "And makes milchkine yield blood and shakes a chain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0027",
          "number": 27,
          "speechLineNumber": 7,
          "text": "In a most hideous and dreadful manner.",
          "plainText": "In a most hideous and dreadful manner",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0028",
          "number": 28,
          "speechLineNumber": 8,
          "text": "You have heard of such a spirit, and well you know",
          "plainText": "You have heard of such a spirit and well you know",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0029",
          "number": 29,
          "speechLineNumber": 9,
          "text": "The superstitious idle-headed eld",
          "plainText": "The superstitious idleheaded eld",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0030",
          "number": 30,
          "speechLineNumber": 10,
          "text": "Received and did deliver to our age,",
          "plainText": "Received and did deliver to our age",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0031",
          "number": 31,
          "speechLineNumber": 11,
          "text": "This tale of Herne the hunter for a truth.",
          "plainText": "This tale of Herne the hunter for a truth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Why, yet there want not many that do fear",
          "plainText": "Why yet there want not many that do fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "In deep of night to walk by this Herne's oak.",
          "plainText": "In deep of night to walk by this Herne's oak",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "But what of this?",
          "plainText": "But what of this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "mistress-ford",
        "name": "MISTRESS FORD",
        "displayName": "Mistress Ford"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Marry, this is our device,",
          "plainText": "Marry this is our device",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "That Falstaff at that oak shall meet with us,",
          "plainText": "That Falstaff at that oak shall meet with us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "Disguised like Herne, with huge horns on his head.",
          "plainText": "Disguised like Herne with huge horns on his head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Well, let it not be doubted but he'll come,",
          "plainText": "Well let it not be doubted but he'll come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "And in this shape; when you have brought him thither,",
          "plainText": "And in this shape when you have brought him thither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "What shall be done with him? What is your plot?",
          "plainText": "What shall be done with him What is your plot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-4-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "That likewise have we thought upon, and thus:",
          "plainText": "That likewise have we thought upon and thus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Nan Page my daughter, and my little son,",
          "plainText": "Nan Page my daughter and my little son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "And three or four more of their growth, we'll dress",
          "plainText": "And three or four more of their growth we'll dress",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "Like urchins, oafs and fairies, green and white,",
          "plainText": "Like urchins oafs and fairies green and white",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "With rounds of waxen tapers on their heads",
          "plainText": "With rounds of waxen tapers on their heads",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "And rattles in their hands. Upon a sudden,",
          "plainText": "And rattles in their hands Upon a sudden",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0047",
          "number": 47,
          "speechLineNumber": 7,
          "text": "As Falstaff, she, and I are newly met,",
          "plainText": "As Falstaff she and I are newly met",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0048",
          "number": 48,
          "speechLineNumber": 8,
          "text": "Let them from forth a sawpit rush at once",
          "plainText": "Let them from forth a sawpit rush at once",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0049",
          "number": 49,
          "speechLineNumber": 9,
          "text": "With some diffused song; upon their sight",
          "plainText": "With some diffused song upon their sight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0050",
          "number": 50,
          "speechLineNumber": 10,
          "text": "We two in great amazedness will fly.",
          "plainText": "We two in great amazedness will fly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0051",
          "number": 51,
          "speechLineNumber": 11,
          "text": "Then let them all encircle him about,",
          "plainText": "Then let them all encircle him about",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0052",
          "number": 52,
          "speechLineNumber": 12,
          "text": "And fairy-like, to pinch the unclean knight,",
          "plainText": "And fairylike to pinch the unclean knight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0053",
          "number": 53,
          "speechLineNumber": 13,
          "text": "And ask him why, that hour of fairy revel,",
          "plainText": "And ask him why that hour of fairy revel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0054",
          "number": 54,
          "speechLineNumber": 14,
          "text": "In their so sacred paths he dares to tread",
          "plainText": "In their so sacred paths he dares to tread",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0055",
          "number": 55,
          "speechLineNumber": 15,
          "text": "In shape profane.",
          "plainText": "In shape profane",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
