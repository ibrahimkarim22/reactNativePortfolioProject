          "number": 63,
          "speechLineNumber": 2,
          "text": "Be practised well to this, or they'll ne'er do 't.",
          "plainText": "Be practised well to this or they'll ne'er do 't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
