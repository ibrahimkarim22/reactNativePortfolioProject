      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nNay, I’ll to him again in name of Brook.\nHe’ll tell me all his purpose. Sure, he’ll come.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@149338/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
