      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.4/p@149132",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAGE.\nThat silk will I go buy.\n[Aside.] And in that time\nShall Master Slender steal my Nan away,\nAnd marry her at Eton.—Go, send to Falstaff straight.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 32,
          "end": 37
        }
      ],
      "lines": [
        {
