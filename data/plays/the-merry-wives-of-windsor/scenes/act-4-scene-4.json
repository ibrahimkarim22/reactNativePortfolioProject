          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merry-wives-of-windsor-4-4-line-0058",
          "number": 58,
          "speechLineNumber": 3,
          "text": "And burn him with their tapers.",
