    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.6/p@158568",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOST.\nMaster Fenton, talk not to me. My mind is heavy. I will give over all.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.6/p@158568/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.6/p@158568/line-2",
          "start": 6,
          "end": 76,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4202030,
        "end": 4202136,
        "line": 155652,
        "column": 1,
        "path": "chap23/p@158568",
        "anchor": "sceneIV_23.6"
      },
      "speakerLabel": "HOST.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.6/p@158678",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FENTON.\nYet hear me speak. Assist me in my purpose,\nAnd, as I am a gentleman, I’ll give thee\nA hundred pound in gold more than your loss.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
