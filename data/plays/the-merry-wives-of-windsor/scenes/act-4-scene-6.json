          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.6/p@158678/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.6/p@158678/line-3",
          "start": 52,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.6/p@158678/line-4",
          "start": 93,
          "end": 137,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4202140,
        "end": 4202317,
        "line": 155657,
        "column": 1,
        "path": "chap23/p@158678",
        "anchor": "sceneIV_23.6"
      },
