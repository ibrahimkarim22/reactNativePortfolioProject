    {
      "id": "the-merry-wives-of-windsor/sceneIV_23.6/p@160819",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOST.\nWhich means she to deceive, father or mother?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneIV_23.6/p@160819/line-1",
