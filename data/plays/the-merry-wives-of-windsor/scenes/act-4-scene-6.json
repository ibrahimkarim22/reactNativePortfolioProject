      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FENTON.\nSo shall I evermore be bound to thee;\nBesides, I’ll make a present recompense.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
