      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOST.\nWell, husband your device; I’ll to the vicar.\nBring you the maid, you shall not lack a priest.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
