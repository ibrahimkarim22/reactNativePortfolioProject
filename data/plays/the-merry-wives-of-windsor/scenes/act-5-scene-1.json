    {
      "id": "the-merry-wives-of-windsor/sceneV_23.1/p@161769",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nPrithee, no more prattling. Go. I’ll hold. This is the third time; I hope good luck lies in odd numbers. Away, go! They say there is divinity in odd numbers, either in nativity, chance, or death. Away!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.1/p@161769/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.1/p@161769/line-2",
          "start": 10,
          "end": 211,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4205231,
        "end": 4205474,
        "line": 155751,
        "column": 1,
        "path": "chap23/p@161769",
        "anchor": "sceneV_23.1"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162016",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS QUICKLY.\nI’ll provide you a chain, and I’ll do what I can to get you a pair of horns.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162016/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162016/line-2",
          "start": 18,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4205478,
        "end": 4205602,
        "line": 155758,
        "column": 1,
        "path": "chap23/p@162016",
        "anchor": "sceneV_23.1"
      },
      "speakerLabel": "MISTRESS QUICKLY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 17
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162144",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nAway, I say; time wears. Hold up your head, and mince.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162144/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
