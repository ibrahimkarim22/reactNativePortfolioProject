    {
      "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162404",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "How now, Master Brook! Master Brook, the matter will be known tonight or never. Be you in the park about midnight, at Herne’s oak, and you shall see wonders.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162404/line-1",
          "start": 0,
          "end": 157,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4205866,
        "end": 4206050,
        "line": 155775,
        "column": 1,
        "path": "chap23/p@162404",
        "anchor": "sceneV_23.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162592",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FORD.\nWent you not to her yesterday, sir, as you told me you had appointed?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162592/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162592/line-2",
          "start": 6,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4206054,
        "end": 4206159,
        "line": 155781,
        "column": 1,
        "path": "chap23/p@162592",
        "anchor": "sceneV_23.1"
      },
      "speakerLabel": "FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162701",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nI went to her, Master Brook, as you see, like a poor old man, but I came from her, Master Brook, like a poor old woman. That same knave Ford, her husband, hath the finest mad devil of jealousy in him, Master Brook, that ever governed frenzy. I will tell you he beat me grievously, in the shape of a woman; for in the shape of man, Master Brook, I fear not Goliath with a weaver’s beam, because I know also life is a shuttle. I am in haste. Go along with me; I’ll tell you all, Master Brook. Since I plucked geese, played truant, and whipped top, I knew not what ’twas to be beaten till lately. Follow me, I’ll tell you strange things of this knave Ford, on whom tonight I will be revenged, and I will deliver his wife into your hand. Follow. Strange things in hand, Master Brook! Follow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162701/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.1/p@162701/line-2",
          "start": 10,
          "end": 797,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4206163,
        "end": 4207000,
        "line": 155786,
        "column": 1,
