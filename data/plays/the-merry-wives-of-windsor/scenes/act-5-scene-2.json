  "content": [
    {
      "id": "the-merry-wives-of-windsor-5-2-stage-001",
      "type": "stage",
      "text": "Enter Page, Shallow and Slender."
    },
    {
      "id": "the-merry-wives-of-windsor-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Come, come. We'll couch i' the castle ditch till we see the light of our fairies. Remember, son Slender, my daughter—",
          "plainText": "Come come We'll couch i' the castle ditch till we see the light of our fairies Remember son Slender my daughter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Ay, forsooth. I have spoke with her, and we have a nay-word how to know one another. I come to her in white and cry \"mum\"; she cries \"budget\"; and by that we know one another.",
          "plainText": "Ay forsooth I have spoke with her and we have a nayword how to know one another I come to her in white and cry mum she cries budget and by that we know one another",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "That's good too. But what needs either your \"mum\" or her \"budget\"? The white will decipher her well enough. It hath struck ten o'clock.",
          "plainText": "That's good too But what needs either your mum or her budget The white will decipher her well enough It hath struck ten o'clock",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "The night is dark. Light and spirits will become it well. Heaven prosper our sport! No man means evil but the devil, and we shall know him by his horns. Let's away; follow me.",
          "plainText": "The night is dark Light and spirits will become it well Heaven prosper our sport No man means evil but the devil and we shall know him by his horns Let's away follow me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-2-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
