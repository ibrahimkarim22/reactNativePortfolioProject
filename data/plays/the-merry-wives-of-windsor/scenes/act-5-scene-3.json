    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@164668",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Mistress Page, Mistress Ford and Doctor Caius.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 34,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 39,
          "end": 51,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@164668/line-1",
          "start": 0,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4208130,
        "end": 4208272,
        "line": 155840,
        "column": 1,
        "path": "chap23/p@164668",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@164814",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nMaster Doctor, my daughter is in green. When you see your time, take her by the hand, away with her to the deanery, and dispatch it quickly. Go before into the park. We two must go together.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@164814/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@164814/line-2",
          "start": 15,
          "end": 205,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4208276,
        "end": 4208513,
        "line": 155845,
        "column": 1,
        "path": "chap23/p@164814",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165055",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAIUS.\nI know vat I have to do. Adieu.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165055/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165055/line-2",
          "start": 7,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4208517,
        "end": 4208585,
        "line": 155852,
        "column": 1,
        "path": "chap23/p@165055",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": "CAIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165127",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nFare you well, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165127/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165127/line-2",
          "start": 15,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4208589,
        "end": 4208653,
        "line": 155857,
        "column": 1,
        "path": "chap23/p@165127",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165195",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit Caius.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 11,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 12
        }
      ],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165195/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4208657,
        "end": 4208728,
        "line": 155862,
        "column": 1,
        "path": "chap23/p@165195",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165270",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "My husband will not rejoice so much at the abuse of Falstaff as he will chafe at the doctor’s marrying my daughter. But ’tis no matter. Better a little chiding than a great deal of heartbreak.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165270/line-1",
          "start": 0,
          "end": 192,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4208732,
        "end": 4208951,
        "line": 155864,
        "column": 1,
        "path": "chap23/p@165270",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165493",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS FORD.\nWhere is Nan now, and her troop of fairies, and the Welsh devil Hugh?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165493/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165493/line-2",
          "start": 15,
          "end": 84,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4208955,
        "end": 4209069,
        "line": 155870,
        "column": 1,
        "path": "chap23/p@165493",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": "MISTRESS FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165611",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nThey are all couched in a pit hard by Herne’s oak, with obscured lights, which, at the very instant of Falstaff’s and our meeting, they will at once display to the night.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165611/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165611/line-2",
          "start": 15,
          "end": 185,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4209073,
        "end": 4209290,
        "line": 155875,
        "column": 1,
        "path": "chap23/p@165611",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165832",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS FORD.\nThat cannot choose but amaze him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165832/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165832/line-2",
          "start": 15,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4209294,
        "end": 4209372,
        "line": 155882,
        "column": 1,
        "path": "chap23/p@165832",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": "MISTRESS FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165914",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nIf he be not amazed, he will be mocked; if he be amazed, he will every way be mocked.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165914/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@165914/line-2",
          "start": 15,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4209376,
        "end": 4209507,
        "line": 155887,
        "column": 1,
        "path": "chap23/p@165914",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166049",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS FORD.\nWe’ll betray him finely.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166049/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166049/line-2",
          "start": 15,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4209511,
        "end": 4209580,
        "line": 155893,
        "column": 1,
        "path": "chap23/p@166049",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": "MISTRESS FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166122",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS PAGE.\nAgainst such lewdsters and their lechery,\nThose that betray them do no treachery.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166122/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166122/line-2",
          "start": 15,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166122/line-3",
          "start": 57,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4209584,
        "end": 4209715,
        "line": 155898,
        "column": 1,
        "path": "chap23/p@166122",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": "MISTRESS PAGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166257",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MISTRESS FORD.\nThe hour draws on. To the oak, to the oak!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166257/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166257/line-2",
          "start": 15,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 4209719,
        "end": 4209806,
        "line": 155904,
        "column": 1,
        "path": "chap23/p@166257",
        "anchor": "sceneV_23.3"
      },
      "speakerLabel": "MISTRESS FORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-merry-wives-of-windsor/sceneV_23.3/p@166348",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 8
        }
      ],
      "lines": [
