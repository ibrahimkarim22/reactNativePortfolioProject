    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@37921",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HASTINGS.\nIf he should do so,\nHe leaves his back unarm’d, the French and Welsh\nBaying him at the heels: never fear that.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
