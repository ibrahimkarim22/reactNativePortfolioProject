        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34240",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HASTINGS.\nOur present musters grow upon the file\nTo five and twenty thousand men of choice;\nAnd our supplies live largely in the hope\nOf great Northumberland, whose bosom burns\nWith an incensed fire of injuries.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34240/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34240/line-2",
          "start": 10,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34240/line-3",
          "start": 49,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34240/line-4",
          "start": 92,
          "end": 133,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34240/line-5",
          "start": 134,
          "end": 176,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34240/line-6",
          "start": 177,
          "end": 211,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1731947,
        "end": 1732208,
        "line": 64932,
        "column": 1,
        "path": "chap10/p@34240",
        "anchor": "sceneI_10.3"
      },
      "speakerLabel": "HASTINGS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34505",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORD BARDOLPH.\nThe question then, Lord Hastings, standeth thus:\nWhether our present five and twenty thousand\nMay hold up head without Northumberland.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34505/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34505/line-2",
          "start": 15,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34505/line-3",
          "start": 64,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34505/line-4",
          "start": 109,
          "end": 149,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1732212,
        "end": 1732401,
        "line": 64941,
        "column": 1,
        "path": "chap10/p@34505",
        "anchor": "sceneI_10.3"
      },
      "speakerLabel": "LORD BARDOLPH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34698",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HASTINGS.\nWith him we may.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34698/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34698/line-2",
          "start": 10,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1732405,
        "end": 1732461,
        "line": 64948,
        "column": 1,
        "path": "chap10/p@34698",
        "anchor": "sceneI_10.3"
      },
      "speakerLabel": "HASTINGS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34758",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORD BARDOLPH.\nYea, marry, there’s the point:\nBut if without him we be thought too feeble,\nMy judgement is, we should not step too far\nTill we had his assistance by the hand;\nFor in a theme so bloody-faced as this\nConjecture, expectation, and surmise\nOf aids incertain should not be admitted.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34758/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34758/line-2",
          "start": 15,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34758/line-3",
          "start": 46,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34758/line-4",
          "start": 91,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34758/line-5",
          "start": 135,
          "end": 174,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34758/line-6",
          "start": 175,
          "end": 213,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34758/line-7",
          "start": 214,
          "end": 250,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@34758/line-8",
          "start": 251,
          "end": 292,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
