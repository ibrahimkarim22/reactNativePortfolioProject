    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33732",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCHBISHOP.\nThus have you heard our cause and known our means,\nAnd, my most noble friends, I pray you all\nSpeak plainly your opinions of our hopes.\nAnd first, Lord Marshal, what say you to it?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33732/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33732/line-2",
          "start": 12,
          "end": 62,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33732/line-3",
          "start": 63,
          "end": 105,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33732/line-4",
          "start": 106,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33732/line-5",
          "start": 148,
          "end": 192,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1731439,
        "end": 1731676,
        "line": 64915,
        "column": 1,
        "path": "chap10/p@33732",
        "anchor": "sceneI_10.3"
      },
      "speakerLabel": "ARCHBISHOP.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33973",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MOWBRAY.\nI well allow the occasion of our arms,\nBut gladly would be better satisfied\nHow in our means we should advance ourselves\nTo look with forehead bold and big enough\nUpon the power and puissance of the King.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33973/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33973/line-2",
          "start": 9,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33973/line-3",
          "start": 48,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33973/line-4",
          "start": 85,
          "end": 129,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33973/line-5",
          "start": 130,
          "end": 171,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@33973/line-6",
          "start": 172,
          "end": 213,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1731680,
        "end": 1731943,
        "line": 64923,
        "column": 1,
        "path": "chap10/p@33973",
        "anchor": "sceneI_10.3"
      },
      "speakerLabel": "MOWBRAY.",
      "attribution": {
