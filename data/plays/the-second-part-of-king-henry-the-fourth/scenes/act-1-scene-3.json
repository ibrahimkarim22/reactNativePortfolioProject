    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@37385",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HASTINGS.\nTo us no more; nay, not so much, Lord Bardolph;\nFor his divisions, as the times do brawl,\nAre in three heads: one power against the French,\nAnd one against Glendower; perforce a third\nMust take up us. So is the unfirm king\nIn three divided, and his coffers sound\nWith hollow poverty and emptiness.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@37385/line-1",
          "start": 0,
          "end": 9,
