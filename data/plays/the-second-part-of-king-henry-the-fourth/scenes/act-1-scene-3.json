      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35114",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCHBISHOP.\n’Tis very true, Lord Bardolph, for indeed\nIt was young Hotspur’s case at Shrewsbury.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35114/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35114/line-2",
          "start": 12,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35114/line-3",
          "start": 54,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1732821,
        "end": 1732952,
        "line": 64964,
        "column": 1,
        "path": "chap10/p@35114",
        "anchor": "sceneI_10.3"
      },
      "speakerLabel": "ARCHBISHOP.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35249",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LORD BARDOLPH.\nIt was, my lord; who lined himself with hope,\nEating the air on promise of supply,\nFlatt’ring himself in project of a power\nMuch smaller than the smallest of his thoughts,\nAnd so, with great imagination\nProper to madmen, led his powers to death\nAnd winking leap’d into destruction.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35249/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35249/line-2",
          "start": 15,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35249/line-3",
          "start": 61,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35249/line-4",
          "start": 98,
          "end": 138,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35249/line-5",
          "start": 139,
          "end": 186,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35249/line-6",
          "start": 187,
          "end": 217,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35249/line-7",
          "start": 218,
          "end": 259,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneI_10.3/p@35249/line-8",
          "start": 260,
          "end": 296,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1732956,
        "end": 1733312,
        "line": 64970,
        "column": 1,
        "path": "chap10/p@35249",
        "anchor": "sceneI_10.3"
      },
      "speakerLabel": "LORD BARDOLPH.",
      "attribution": {
