    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneII_10.3/p@62197",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NORTHUMBERLAND.\nI pray thee, loving wife, and gentle daughter,\nGive even way unto my rough affairs;\nPut not you on the visage of the times\nAnd be like them to Percy troublesome.",
