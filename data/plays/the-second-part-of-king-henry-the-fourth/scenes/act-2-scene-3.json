    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneII_10.3/p@64485",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NORTHUMBERLAND.\nBeshrew your heart,\nFair daughter, you do draw my spirits from me\nWith new lamenting ancient oversights.\nBut I must go and meet with danger there,\nOr it will seek me in another place,\nAnd find me worse provided.",
