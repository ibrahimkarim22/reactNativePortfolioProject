    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneII_10.3/p@62568",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "NORTHUMBERLAND.\nAlas, sweet wife, my honour is at pawn,\nAnd, but my going, nothing can redeem it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneII_10.3/p@62568/line-1",
