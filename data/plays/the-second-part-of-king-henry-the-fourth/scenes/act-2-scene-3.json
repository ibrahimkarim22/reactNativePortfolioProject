          "start": 16,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneII_10.3/p@62568/line-3",
          "start": 56,
          "end": 97,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1760275,
        "end": 1760407,
        "line": 65993,
        "column": 1,
        "path": "chap10/p@62568",
        "anchor": "sceneII_10.3"
      },
