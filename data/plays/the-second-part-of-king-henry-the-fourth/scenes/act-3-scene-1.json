      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nWhy then, good morrow to you all, my lords.\nHave you read o’er the letters that I sent you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIII_10.1/p@92157/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
