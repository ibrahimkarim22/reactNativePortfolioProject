    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIII_10.1/p@92530",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nIt is but as a body yet distemper’d,\nWhich to his former strength may be restored\nWith good advice and little medicine.\nMy Lord Northumberland will soon be cool’d.",
      "separatorAfter": "\n\n",
