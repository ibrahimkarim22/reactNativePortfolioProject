      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nWe have, my liege.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIII_10.1/p@92293/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
