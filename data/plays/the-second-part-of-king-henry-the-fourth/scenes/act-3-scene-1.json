          "start": 6,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIII_10.1/p@92354/line-3",
          "start": 48,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIII_10.1/p@92354/line-4",
          "start": 89,
          "end": 132,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1790061,
        "end": 1790233,
        "line": 67101,
        "column": 1,
        "path": "chap10/p@92354",
        "anchor": "sceneIII_10.1"
      },
      "speakerLabel": "KING.",
      "attribution": {
