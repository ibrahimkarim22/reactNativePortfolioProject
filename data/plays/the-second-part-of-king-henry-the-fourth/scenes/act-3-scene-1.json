      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIII_10.1/p@92354",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nThen you perceive the body of our kingdom\nHow foul it is, what rank diseases grow,\nAnd with what danger, near the heart of it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIII_10.1/p@92354/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
