          "start": 9,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1790000,
        "end": 1790057,
        "line": 67096,
        "column": 1,
        "path": "chap10/p@92293",
        "anchor": "sceneIII_10.1"
      },
      "speakerLabel": "WARWICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
