    "label": "Act 3, Scene 1",
    "title": "SCENE I. Westminster. The palace.",
    "location": "Westminster. The palace.",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-stage-001",
      "type": "stage",
      "text": "Enter the King in his nightgown, with a Page."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Go call the Earls of Surrey and of Warwick;",
          "plainText": "Go call the Earls of Surrey and of Warwick",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "But, ere they come, bid them o'er-read these letters",
          "plainText": "But ere they come bid them o'erread these letters",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And well consider of them. Make good speed.",
          "plainText": "And well consider of them Make good speed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-stage-002",
      "type": "stage",
      "text": "[Exit Page.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-stage-003",
      "type": "stage",
      "text": "Enter Warwick and Surrey."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Many good morrows to your Majesty!",
          "plainText": "Many good morrows to your Majesty",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Is it good morrow, lords?",
          "plainText": "Is it good morrow lords",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "'Tis one o'clock, and past.",
          "plainText": "'Tis one o'clock and past",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Why then, good morrow to you all, my lords.",
          "plainText": "Why then good morrow to you all my lords",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Have you read o'er the letters that I sent you?",
          "plainText": "Have you read o'er the letters that I sent you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "We have, my liege.",
          "plainText": "We have my liege",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Then you perceive the body of our kingdom",
          "plainText": "Then you perceive the body of our kingdom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "How foul it is, what rank diseases grow,",
          "plainText": "How foul it is what rank diseases grow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "And with what danger, near the heart of it.",
          "plainText": "And with what danger near the heart of it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "It is but as a body yet distemper'd,",
          "plainText": "It is but as a body yet distemper'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Which to his former strength may be restored",
          "plainText": "Which to his former strength may be restored",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "With good advice and little medicine.",
          "plainText": "With good advice and little medicine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "My Lord Northumberland will soon be cool'd.",
          "plainText": "My Lord Northumberland will soon be cool'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "O God, that one might read the book of fate,",
          "plainText": "O God that one might read the book of fate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "And see the revolution of the times",
          "plainText": "And see the revolution of the times",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Make mountains level, and the continent,",
          "plainText": "Make mountains level and the continent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "Weary of solid firmness, melt itself",
          "plainText": "Weary of solid firmness melt itself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Into the sea, and other times to see",
          "plainText": "Into the sea and other times to see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "The beachy girdle of the ocean",
          "plainText": "The beachy girdle of the ocean",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 7,
          "text": "Too wide for Neptune's hips; how chance's mocks",
          "plainText": "Too wide for Neptune's hips how chance's mocks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 8,
          "text": "And changes fill the cup of alteration",
          "plainText": "And changes fill the cup of alteration",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 9,
          "text": "With divers liquors! O, if this were seen,",
          "plainText": "With divers liquors O if this were seen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 10,
          "text": "The happiest youth, viewing his progress through,",
          "plainText": "The happiest youth viewing his progress through",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 11,
          "text": "What perils past, what crosses to ensue,",
          "plainText": "What perils past what crosses to ensue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0028",
          "number": 28,
          "speechLineNumber": 12,
          "text": "Would shut the book, and sit him down and die.",
          "plainText": "Would shut the book and sit him down and die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0029",
          "number": 29,
          "speechLineNumber": 13,
          "text": "'Tis not ten years gone",
          "plainText": "'Tis not ten years gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0030",
          "number": 30,
          "speechLineNumber": 14,
          "text": "Since Richard and Northumberland, great friends,",
          "plainText": "Since Richard and Northumberland great friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0031",
          "number": 31,
          "speechLineNumber": 15,
          "text": "Did feast together, and in two years after",
          "plainText": "Did feast together and in two years after",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0032",
          "number": 32,
          "speechLineNumber": 16,
          "text": "Were they at wars. It is but eight years since",
          "plainText": "Were they at wars It is but eight years since",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0033",
          "number": 33,
          "speechLineNumber": 17,
          "text": "This Percy was the man nearest my soul,",
          "plainText": "This Percy was the man nearest my soul",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0034",
          "number": 34,
          "speechLineNumber": 18,
          "text": "Who like a brother toil'd in my affairs",
          "plainText": "Who like a brother toil'd in my affairs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0035",
          "number": 35,
          "speechLineNumber": 19,
          "text": "And laid his love and life under my foot,",
          "plainText": "And laid his love and life under my foot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0036",
          "number": 36,
          "speechLineNumber": 20,
          "text": "Yea, for my sake, even to the eyes of Richard",
          "plainText": "Yea for my sake even to the eyes of Richard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0037",
          "number": 37,
          "speechLineNumber": 21,
          "text": "Gave him defiance. But which of you was by—",
          "plainText": "Gave him defiance But which of you was by",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0038",
          "number": 38,
          "speechLineNumber": 22,
          "text": "[To Warwick.] You, cousin Nevil, as I may remember—",
          "plainText": "To Warwick You cousin Nevil as I may remember",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0039",
          "number": 39,
          "speechLineNumber": 23,
          "text": "When Richard, with his eye brimful of tears,",
          "plainText": "When Richard with his eye brimful of tears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0040",
          "number": 40,
          "speechLineNumber": 24,
          "text": "Then check'd and rated by Northumberland,",
          "plainText": "Then check'd and rated by Northumberland",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0041",
          "number": 41,
          "speechLineNumber": 25,
          "text": "Did speak these words, now proved a prophecy?",
          "plainText": "Did speak these words now proved a prophecy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0042",
          "number": 42,
          "speechLineNumber": 26,
          "text": "\"Northumberland, thou ladder by the which",
          "plainText": "Northumberland thou ladder by the which",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0043",
          "number": 43,
          "speechLineNumber": 27,
          "text": "My cousin Bolingbroke ascends my throne\"",
          "plainText": "My cousin Bolingbroke ascends my throne",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0044",
          "number": 44,
          "speechLineNumber": 28,
          "text": "Though then, God knows, I had no such intent,",
          "plainText": "Though then God knows I had no such intent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0045",
          "number": 45,
          "speechLineNumber": 29,
          "text": "But that necessity so bow'd the state",
          "plainText": "But that necessity so bow'd the state",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0046",
          "number": 46,
          "speechLineNumber": 30,
          "text": "That I and greatness were compell'd to kiss—",
          "plainText": "That I and greatness were compell'd to kiss",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0047",
          "number": 47,
          "speechLineNumber": 31,
          "text": "\"The time shall come,\" thus did he follow it,",
          "plainText": "The time shall come thus did he follow it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0048",
          "number": 48,
          "speechLineNumber": 32,
          "text": "\"The time will come, that foul sin, gathering head,",
          "plainText": "The time will come that foul sin gathering head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0049",
          "number": 49,
          "speechLineNumber": 33,
          "text": "Shall break into corruption\"—so went on,",
          "plainText": "Shall break into corruptionso went on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0050",
          "number": 50,
          "speechLineNumber": 34,
          "text": "Foretelling this same time's condition",
          "plainText": "Foretelling this same time's condition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0051",
          "number": 51,
          "speechLineNumber": 35,
          "text": "And the division of our amity.",
          "plainText": "And the division of our amity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "There is a history in all men's lives",
          "plainText": "There is a history in all men's lives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Figuring the natures of the times deceased;",
          "plainText": "Figuring the natures of the times deceased",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "The which observed, a man may prophesy,",
          "plainText": "The which observed a man may prophesy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0055",
          "number": 55,
          "speechLineNumber": 4,
          "text": "With a near aim, of the main chance of things",
          "plainText": "With a near aim of the main chance of things",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0056",
          "number": 56,
          "speechLineNumber": 5,
          "text": "As yet not come to life, who in their seeds",
          "plainText": "As yet not come to life who in their seeds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0057",
          "number": 57,
          "speechLineNumber": 6,
          "text": "And weak beginning lie intreasured.",
          "plainText": "And weak beginning lie intreasured",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0058",
          "number": 58,
          "speechLineNumber": 7,
          "text": "Such things become the hatch and brood of time;",
          "plainText": "Such things become the hatch and brood of time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0059",
          "number": 59,
          "speechLineNumber": 8,
          "text": "And by the necessary form of this",
          "plainText": "And by the necessary form of this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0060",
          "number": 60,
          "speechLineNumber": 9,
          "text": "King Richard might create a perfect guess",
          "plainText": "King Richard might create a perfect guess",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0061",
          "number": 61,
          "speechLineNumber": 10,
          "text": "That great Northumberland, then false to him,",
          "plainText": "That great Northumberland then false to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0062",
          "number": 62,
          "speechLineNumber": 11,
          "text": "Would of that seed grow to a greater falseness,",
          "plainText": "Would of that seed grow to a greater falseness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0063",
          "number": 63,
          "speechLineNumber": 12,
          "text": "Which should not find a ground to root upon,",
          "plainText": "Which should not find a ground to root upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0064",
          "number": 64,
          "speechLineNumber": 13,
          "text": "Unless on you.",
          "plainText": "Unless on you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Are these things then necessities?",
          "plainText": "Are these things then necessities",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "Then let us meet them like necessities;",
          "plainText": "Then let us meet them like necessities",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0067",
          "number": 67,
          "speechLineNumber": 3,
          "text": "And that same word even now cries out on us.",
          "plainText": "And that same word even now cries out on us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0068",
          "number": 68,
          "speechLineNumber": 4,
          "text": "They say the bishop and Northumberland",
          "plainText": "They say the bishop and Northumberland",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0069",
          "number": 69,
          "speechLineNumber": 5,
          "text": "Are fifty thousand strong.",
          "plainText": "Are fifty thousand strong",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "It cannot be, my lord.",
          "plainText": "It cannot be my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "Rumour doth double, like the voice and echo,",
          "plainText": "Rumour doth double like the voice and echo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0072",
          "number": 72,
          "speechLineNumber": 3,
          "text": "The numbers of the feared. Please it your Grace",
          "plainText": "The numbers of the feared Please it your Grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0073",
          "number": 73,
          "speechLineNumber": 4,
          "text": "To go to bed. Upon my soul, my lord,",
          "plainText": "To go to bed Upon my soul my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0074",
          "number": 74,
          "speechLineNumber": 5,
          "text": "The powers that you already have sent forth",
          "plainText": "The powers that you already have sent forth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0075",
          "number": 75,
          "speechLineNumber": 6,
          "text": "Shall bring this prize in very easily.",
          "plainText": "Shall bring this prize in very easily",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0076",
          "number": 76,
          "speechLineNumber": 7,
          "text": "To comfort you the more, I have received",
          "plainText": "To comfort you the more I have received",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0077",
          "number": 77,
          "speechLineNumber": 8,
          "text": "A certain instance that Glendower is dead.",
          "plainText": "A certain instance that Glendower is dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0078",
          "number": 78,
          "speechLineNumber": 9,
          "text": "Your majesty hath been this fortnight ill,",
          "plainText": "Your majesty hath been this fortnight ill",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0079",
          "number": 79,
          "speechLineNumber": 10,
          "text": "And these unseason'd hours perforce must add",
          "plainText": "And these unseason'd hours perforce must add",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0080",
          "number": 80,
          "speechLineNumber": 11,
          "text": "Unto your sickness.",
          "plainText": "Unto your sickness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-3-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "I will take your counsel.",
          "plainText": "I will take your counsel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0082",
          "number": 82,
          "speechLineNumber": 2,
          "text": "And were these inward wars once out of hand,",
          "plainText": "And were these inward wars once out of hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-3-1-line-0083",
          "number": 83,
          "speechLineNumber": 3,
          "text": "We would, dear lords, unto the Holy Land.",
          "plainText": "We would dear lords unto the Holy Land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
