    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIII_10.1/p@95071",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING.\nAre these things then necessities?\nThen let us meet them like necessities;\nAnd that same word even now cries out on us.\nThey say the bishop and Northumberland\nAre fifty thousand strong.",
      "separatorAfter": "\n\n",
      "spans": [],
