          "start": 10,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1838241,
        "end": 1838300,
        "line": 68788,
        "column": 1,
        "path": "chap10/p@140534",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140597",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCASTER.\nThine’s too thick to shine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140597/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140597/line-2",
          "start": 11,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1838304,
        "end": 1838372,
        "line": 68793,
        "column": 1,
        "path": "chap10/p@140597",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "LANCASTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140669",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nLet it do something, my good lord, that may do me good, and call it what you will.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140669/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140669/line-2",
          "start": 10,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1838376,
        "end": 1838499,
        "line": 68798,
        "column": 1,
        "path": "chap10/p@140669",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140796",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCASTER.\nIs thy name Colevile?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140796/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140796/line-2",
          "start": 11,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1838503,
        "end": 1838565,
        "line": 68804,
        "column": 1,
        "path": "chap10/p@140796",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "LANCASTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140862",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COLEVILE.\nIt is, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140862/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140862/line-2",
          "start": 10,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1838569,
        "end": 1838624,
        "line": 68809,
        "column": 1,
        "path": "chap10/p@140862",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "COLEVILE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140921",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCASTER.\nA famous rebel art thou, Colevile.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140921/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@140921/line-2",
          "start": 11,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1838628,
        "end": 1838703,
        "line": 68814,
        "column": 1,
        "path": "chap10/p@140921",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "LANCASTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141000",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nAnd a famous true subject took him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141000/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141000/line-2",
          "start": 10,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1838707,
        "end": 1838782,
        "line": 68819,
        "column": 1,
        "path": "chap10/p@141000",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141079",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "COLEVILE.\nI am, my lord, but as my betters are\nThat led me hither. Had they been ruled by me,\nYou should have won them dearer than you have.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141079/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141079/line-2",
          "start": 10,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141079/line-3",
          "start": 47,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141079/line-4",
          "start": 94,
          "end": 140,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1838786,
        "end": 1838966,
        "line": 68824,
        "column": 1,
        "path": "chap10/p@141079",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "COLEVILE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141263",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nI know not how they sold themselves, but thou, like a kind fellow, gavest thyself away gratis, and I thank thee for thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141263/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141263/line-2",
          "start": 10,
          "end": 131,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1838970,
        "end": 1839132,
        "line": 68831,
        "column": 1,
        "path": "chap10/p@141263",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141429",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Westmoreland.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 18,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141429/line-1",
          "start": 0,
          "end": 19,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1839136,
        "end": 1839210,
        "line": 68837,
        "column": 1,
        "path": "chap10/p@141429",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141507",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCASTER.\nNow, have you left pursuit?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141507/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141507/line-2",
          "start": 11,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1839214,
        "end": 1839282,
        "line": 68839,
        "column": 1,
        "path": "chap10/p@141507",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "LANCASTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141579",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WESTMORELAND.\nRetreat is made and execution stay’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141579/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141579/line-2",
          "start": 14,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1839286,
        "end": 1839367,
        "line": 68844,
        "column": 1,
        "path": "chap10/p@141579",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "WESTMORELAND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141664",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCASTER.\nSend Colevile with his confederates\nTo York, to present execution.\nBlunt, lead him hence, and see you guard him sure.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141664/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141664/line-2",
          "start": 11,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141664/line-3",
          "start": 47,
          "end": 77,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141664/line-4",
          "start": 78,
          "end": 128,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1839371,
        "end": 1839539,
        "line": 68849,
        "column": 1,
        "path": "chap10/p@141664",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "LANCASTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141836",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt Blunt and others with Colevile.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 13,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 30,
          "end": 38,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 39
        }
      ],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141836/line-1",
          "start": 0,
          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1839543,
        "end": 1839673,
        "line": 68856,
        "column": 1,
        "path": "chap10/p@141836",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141970",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "And now dispatch we toward the court, my lords.\nI hear the King my father is sore sick.\nOur news shall go before us to his Majesty,\nWhich, cousin, you shall bear to comfort him,\nAnd we with sober speed will follow you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141970/line-1",
          "start": 0,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141970/line-2",
          "start": 48,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141970/line-3",
          "start": 88,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141970/line-4",
          "start": 132,
          "end": 177,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@141970/line-5",
          "start": 178,
          "end": 218,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1839677,
        "end": 1839940,
        "line": 68859,
        "column": 1,
        "path": "chap10/p@141970",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@142237",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nMy lord, I beseech you give me leave to go through Gloucestershire, and, when you come to court, stand my good lord, pray, in your good report.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@142237/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@142237/line-2",
          "start": 10,
          "end": 153,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1839944,
        "end": 1840128,
        "line": 68867,
        "column": 1,
        "path": "chap10/p@142237",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@142425",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCASTER.\nFare you well, Falstaff. I, in my condition,\nShall better speak of you than you deserve.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@142425/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@142425/line-2",
          "start": 11,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneIV_10.3/p@142425/line-3",
          "start": 56,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1840132,
        "end": 1840266,
        "line": 68873,
        "column": 1,
        "path": "chap10/p@142425",
        "anchor": "sceneIV_10.3"
      },
      "speakerLabel": "LANCASTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
