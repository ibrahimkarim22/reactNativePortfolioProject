    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167527",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Shallow, Falstaff, Bardolph and Page.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 33,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 38,
          "end": 42,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167527/line-1",
          "start": 0,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1865234,
        "end": 1865363,
        "line": 69671,
        "column": 1,
        "path": "chap10/p@167527",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167660",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nBy cock and pie, sir, you shall not away tonight.\nWhat, Davy, I say!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167660/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167660/line-2",
          "start": 9,
          "end": 58,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167660/line-3",
          "start": 59,
          "end": 77,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1865367,
        "end": 1865479,
        "line": 69674,
        "column": 1,
        "path": "chap10/p@167660",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167776",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FALSTAFF.\nYou must excuse me, Master Robert Shallow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167776/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167776/line-2",
          "start": 10,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1865483,
        "end": 1865565,
        "line": 69680,
        "column": 1,
        "path": "chap10/p@167776",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "FALSTAFF.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167862",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nI will not excuse you, you shall not be excused. Excuses shall not be admitted, there is no excuse shall serve, you shall not be excused. Why, Davy!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167862/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@167862/line-2",
          "start": 9,
          "end": 157,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1865569,
        "end": 1865757,
        "line": 69685,
        "column": 1,
        "path": "chap10/p@167862",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168054",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Davy.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 10,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168054/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1865761,
        "end": 1865827,
        "line": 69691,
        "column": 1,
        "path": "chap10/p@168054",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168124",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAVY.\nHere, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168124/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168124/line-2",
          "start": 6,
          "end": 16,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1865831,
        "end": 1865877,
        "line": 69693,
        "column": 1,
        "path": "chap10/p@168124",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "DAVY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168174",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nDavy, Davy, Davy, Davy, let me see, Davy, let me see, Davy, let me see. Yea, marry, William cook, bid him come hither. Sir John, you shall not be excused.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168174/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168174/line-2",
          "start": 9,
          "end": 163,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1865881,
        "end": 1866075,
        "line": 69698,
        "column": 1,
        "path": "chap10/p@168174",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168372",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAVY.\nMarry, sir, thus: those precepts cannot be served; and again, sir—shall we sow the hade land with wheat?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168372/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168372/line-2",
          "start": 6,
          "end": 110,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1866079,
        "end": 1866220,
        "line": 69704,
        "column": 1,
        "path": "chap10/p@168372",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "DAVY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168517",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nWith red wheat, Davy. But for William cook, are there no young pigeons?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168517/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168517/line-2",
          "start": 9,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1866224,
        "end": 1866334,
        "line": 69710,
        "column": 1,
        "path": "chap10/p@168517",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168631",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAVY.\nYes, sir. Here is now the smith’s note for shoeing and plough-irons.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168631/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168631/line-2",
          "start": 6,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1866338,
        "end": 1866442,
        "line": 69715,
        "column": 1,
        "path": "chap10/p@168631",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "DAVY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168739",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nLet it be cast and paid. Sir John, you shall not be excused.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168739/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168739/line-2",
          "start": 9,
          "end": 69,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1866446,
        "end": 1866545,
        "line": 69720,
        "column": 1,
        "path": "chap10/p@168739",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168842",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAVY.\nNow, sir, a new link to the bucket must needs be had. And, sir, do you mean to stop any of William’s wages, about the sack he lost the other day at Hinckley fair?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168842/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@168842/line-2",
          "start": 6,
          "end": 168,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1866549,
        "end": 1866749,
        "line": 69725,
        "column": 1,
        "path": "chap10/p@168842",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "DAVY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169046",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nHe shall answer it. Some pigeons, Davy, a couple of short-legged hens, a joint of mutton, and any pretty little tiny kickshaws, tell William cook.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169046/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169046/line-2",
          "start": 9,
          "end": 155,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1866753,
        "end": 1866939,
        "line": 69732,
        "column": 1,
        "path": "chap10/p@169046",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169236",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAVY.\nDoth the man of war stay all night, sir?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169236/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169236/line-2",
          "start": 6,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1866943,
        "end": 1867019,
        "line": 69738,
        "column": 1,
        "path": "chap10/p@169236",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "DAVY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169316",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nYea, Davy, I will use him well: a friend i’ th’ court is better than a penny in purse. Use his men well, Davy, for they are arrant knaves, and will backbite.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169316/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169316/line-2",
          "start": 9,
          "end": 166,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1867023,
        "end": 1867221,
        "line": 69743,
        "column": 1,
        "path": "chap10/p@169316",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169518",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAVY.\nNo worse than they are backbitten, sir, for they have marvellous foul linen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169518/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169518/line-2",
          "start": 6,
          "end": 82,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1867225,
        "end": 1867337,
        "line": 69750,
        "column": 1,
        "path": "chap10/p@169518",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "DAVY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169634",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHALLOW.\nWell conceited, Davy. About thy business, Davy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169634/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169634/line-2",
          "start": 9,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1867341,
        "end": 1867427,
        "line": 69755,
        "column": 1,
        "path": "chap10/p@169634",
        "anchor": "sceneV_10.1"
      },
      "speakerLabel": "SHALLOW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169724",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAVY.\nI beseech you, sir, to countenance William Visor of Woncot against Clement Perkes o’ th’ hill.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.1/p@169724/line-1",
