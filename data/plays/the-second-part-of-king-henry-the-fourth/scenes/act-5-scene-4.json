      "classes": [],
      "text": "SCENE IV. London. A street.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "b",
          "start": 0,
          "end": 27
        }
      ],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/h3@190319/line-1",
          "start": 0,
          "end": 27,
