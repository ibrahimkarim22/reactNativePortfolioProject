    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190391",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Beadles, dragging in Hostess Quickly and Doll Tearsheet.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 27,
          "end": 42,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 47,
          "end": 61,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190391/line-1",
          "start": 0,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1888098,
        "end": 1888277,
        "line": 70541,
        "column": 1,
        "path": "chap10/p@190391",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190574",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOSTESS.\nNo, thou arrant knave. I would to God that I might die, that I might have thee hanged. Thou hast drawn my shoulder out of joint.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190574/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190574/line-2",
          "start": 9,
          "end": 137,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1888281,
        "end": 1888449,
        "line": 70545,
        "column": 1,
        "path": "chap10/p@190574",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "HOSTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190746",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST BEADLE.\nThe constables have delivered her over to me, and she shall have whipping-cheer enough, I warrant her. There hath been a man or two lately killed about her.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190746/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190746/line-2",
          "start": 14,
          "end": 170,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1888453,
        "end": 1888654,
        "line": 70551,
        "column": 1,
        "path": "chap10/p@190746",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "FIRST BEADLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190951",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOLL.\nNut-hook, nut-hook, you lie! Come on, I’ll tell thee what, thou damned tripe-visaged rascal, an the child I now go with do miscarry, thou wert better thou hadst struck thy mother, thou paper-faced villain.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190951/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@190951/line-2",
          "start": 6,
          "end": 211,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1888658,
        "end": 1888901,
        "line": 70557,
        "column": 1,
        "path": "chap10/p@190951",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "DOLL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191198",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOSTESS.\nO the Lord, that Sir John were come! He would make this a bloody day to somebody. But I pray God the fruit of her womb miscarry!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191198/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191198/line-2",
          "start": 9,
          "end": 137,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1888905,
        "end": 1889073,
        "line": 70564,
        "column": 1,
        "path": "chap10/p@191198",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "HOSTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191370",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST BEADLE.\nIf it do, you shall have a dozen of cushions again; you have but eleven now. Come, I charge you both go with me, for the man is dead that you and Pistol beat amongst you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191370/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191370/line-2",
          "start": 14,
          "end": 184,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1889077,
        "end": 1889293,
        "line": 70570,
        "column": 1,
        "path": "chap10/p@191370",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "FIRST BEADLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191590",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOLL.\nI’ll tell you what, you thin man in a censer, I will have you as soundly swinged for this, you bluebottle rogue, you filthy famished correctioner, if you be not swinged, I’ll forswear half-kirtles.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191590/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191590/line-2",
          "start": 6,
          "end": 203,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1889297,
        "end": 1889532,
        "line": 70577,
        "column": 1,
        "path": "chap10/p@191590",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "DOLL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191829",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST BEADLE.\nCome, come, you she knight-errant, come.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191829/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191829/line-2",
          "start": 14,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1889536,
        "end": 1889620,
        "line": 70584,
        "column": 1,
        "path": "chap10/p@191829",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "FIRST BEADLE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191917",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOSTESS.\nO God, that right should thus overcome might! Well, of sufferance comes ease.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191917/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@191917/line-2",
          "start": 9,
          "end": 86,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1889624,
        "end": 1889740,
        "line": 70589,
        "column": 1,
        "path": "chap10/p@191917",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "HOSTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192037",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOLL.\nCome, you rogue, come, bring me to a justice.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192037/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192037/line-2",
          "start": 6,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1889744,
        "end": 1889825,
        "line": 70594,
        "column": 1,
        "path": "chap10/p@192037",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "DOLL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192122",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOSTESS.\nAy, come, you starved bloodhound.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192122/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192122/line-2",
          "start": 9,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1889829,
        "end": 1889901,
        "line": 70599,
        "column": 1,
        "path": "chap10/p@192122",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "HOSTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192198",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOLL.\nGoodman death, goodman bones!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192198/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192198/line-2",
          "start": 6,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1889905,
        "end": 1889970,
        "line": 70604,
        "column": 1,
        "path": "chap10/p@192198",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "DOLL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192267",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HOSTESS.\nThou atomy, thou!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192267/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192267/line-2",
          "start": 9,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1889974,
        "end": 1890030,
        "line": 70609,
        "column": 1,
        "path": "chap10/p@192267",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "HOSTESS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192327",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOLL.\nCome, you thin thing, come, you rascal!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192327/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192327/line-2",
          "start": 6,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1890034,
        "end": 1890109,
        "line": 70614,
        "column": 1,
        "path": "chap10/p@192327",
        "anchor": "sceneV_10.4"
      },
      "speakerLabel": "DOLL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192406",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST BEADLE.\nVery well.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192406/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth/sceneV_10.4/p@192406/line-2",
          "start": 14,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 1890113,
        "end": 1890167,
        "line": 70619,
        "column": 1,
        "path": "chap10/p@192406",
