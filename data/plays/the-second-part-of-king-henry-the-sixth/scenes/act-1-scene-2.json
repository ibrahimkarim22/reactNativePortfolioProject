    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneI_13.2/p@20767",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nMethought this staff, mine office-badge in court,\nWas broke in twain; by whom I have forgot,\nBut, as I think, it was by th’ Cardinal,\nAnd on the pieces of the broken wand\nWere placed the heads of Edmund, Duke of Somerset\nAnd William de la Pole, first Duke of Suffolk.\nThis was my dream; what it doth bode, God knows.",
      "separatorAfter": "\n\n",
      "spans": [],
