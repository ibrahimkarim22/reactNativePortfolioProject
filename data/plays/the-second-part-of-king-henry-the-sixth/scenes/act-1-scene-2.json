    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneI_13.2/p@22122",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ELEANOR.\nWhat, what, my lord! Are you so choleric\nWith Eleanor for telling but her dream?\nNext time I’ll keep my dreams unto myself,\nAnd not be checked.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
