      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GLOUCESTER.\nI go. Come, Nell, thou wilt ride with us?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
