  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-001",
      "type": "stage",
      "text": "Enter the Witch Margery Jourdain, the two Priests, Hume, Southwell and Bolingbroke."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "hume",
        "name": "HUME",
        "displayName": "Hume"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Come, my masters. The duchess, I tell you, expects performance of your promises.",
          "plainText": "Come my masters The duchess I tell you expects performance of your promises",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "bolingbroke",
        "name": "BOLINGBROKE",
        "displayName": "Bolingbroke"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Master Hume, we are therefore provided. Will her ladyship behold and hear our exorcisms?",
          "plainText": "Master Hume we are therefore provided Will her ladyship behold and hear our exorcisms",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "hume",
        "name": "HUME",
        "displayName": "Hume"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Ay, what else? Fear you not her courage.",
          "plainText": "Ay what else Fear you not her courage",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "bolingbroke",
        "name": "BOLINGBROKE",
        "displayName": "Bolingbroke"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I have heard her reported to be a woman of an invincible spirit. But it shall be convenient, Master Hume, that you be by her aloft while we be busy below; and so, I pray you go, in God's name, and leave us.",
          "plainText": "I have heard her reported to be a woman of an invincible spirit But it shall be convenient Master Hume that you be by her aloft while we be busy below and so I pray you go in God's name and leave us",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-002",
      "type": "stage",
      "text": "[Exit Hume.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-003",
      "type": "stage",
      "text": "Enter Duchess aloft, Hume following."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "eleanor",
        "name": "ELEANOR",
        "displayName": "Eleanor"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Well said, my masters; and welcome all. To this gear, the sooner the better.",
          "plainText": "Well said my masters and welcome all To this gear the sooner the better",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "bolingbroke",
        "name": "BOLINGBROKE",
        "displayName": "Bolingbroke"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Patience, good lady; wizards know their times.",
          "plainText": "Patience good lady wizards know their times",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Deep night, dark night, the silent of the night,",
          "plainText": "Deep night dark night the silent of the night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "The time of night when Troy was set on fire,",
          "plainText": "The time of night when Troy was set on fire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "The time when screech-owls cry and ban-dogs howl,",
          "plainText": "The time when screechowls cry and bandogs howl",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "And spirits walk and ghosts break up their graves;",
          "plainText": "And spirits walk and ghosts break up their graves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0011",
          "number": 11,
          "speechLineNumber": 6,
          "text": "That time best fits the work we have in hand.",
          "plainText": "That time best fits the work we have in hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0012",
          "number": 12,
          "speechLineNumber": 7,
          "text": "Madam, sit you and fear not. Whom we raise",
          "plainText": "Madam sit you and fear not Whom we raise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0013",
          "number": 13,
          "speechLineNumber": 8,
          "text": "We will make fast within a hallowed verge.",
          "plainText": "We will make fast within a hallowed verge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-004",
      "type": "stage",
      "text": "[Here they do the ceremonies belonging, and make the circle; Bolingbroke or Southwell reads \"Conjuro te\", etc. It thunders and lightens terribly; then the Spirit riseth.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "spirit",
        "name": "SPIRIT",
        "displayName": "Spirit"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Adsum.",
          "plainText": "Adsum",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "m-jourdain",
        "name": "M. JOURDAIN",
        "displayName": "M. Jourdain"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Asnath,",
          "plainText": "Asnath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "By the eternal God, whose name and power",
          "plainText": "By the eternal God whose name and power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "Thou tremblest at, answer that I shall ask;",
          "plainText": "Thou tremblest at answer that I shall ask",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "For till thou speak thou shalt not pass from hence.",
          "plainText": "For till thou speak thou shalt not pass from hence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "spirit",
        "name": "SPIRIT",
        "displayName": "Spirit"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Ask what thou wilt. That I had said and done!",
          "plainText": "Ask what thou wilt That I had said and done",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "bolingbroke",
        "name": "BOLINGBROKE",
        "displayName": "Bolingbroke"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "[Reads.] First of the King: what shall of him become?",
          "plainText": "Reads First of the King what shall of him become",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "spirit",
        "name": "SPIRIT",
        "displayName": "Spirit"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "The duke yet lives that Henry shall depose,",
          "plainText": "The duke yet lives that Henry shall depose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "But him outlive and die a violent death.",
          "plainText": "But him outlive and die a violent death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-005",
      "type": "stage",
      "text": "[As the Spirit speaks, Southwell writes the answer.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "bolingbroke",
        "name": "BOLINGBROKE",
        "displayName": "Bolingbroke"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "[Reads.] What fates await the Duke of Suffolk?",
          "plainText": "Reads What fates await the Duke of Suffolk",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "spirit",
        "name": "SPIRIT",
        "displayName": "Spirit"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "By water shall he die and take his end.",
          "plainText": "By water shall he die and take his end",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "bolingbroke",
        "name": "BOLINGBROKE",
        "displayName": "Bolingbroke"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "[Reads.] What shall befall the Duke of Somerset?",
          "plainText": "Reads What shall befall the Duke of Somerset",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "spirit",
        "name": "SPIRIT",
        "displayName": "Spirit"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Let him shun castles.",
          "plainText": "Let him shun castles",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "Safer shall he be upon the sandy plains",
          "plainText": "Safer shall he be upon the sandy plains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "Than where castles mounted stand.",
          "plainText": "Than where castles mounted stand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "Have done, for more I hardly can endure.",
          "plainText": "Have done for more I hardly can endure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "bolingbroke",
        "name": "BOLINGBROKE",
        "displayName": "Bolingbroke"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Descend to darkness and the burning lake!",
          "plainText": "Descend to darkness and the burning lake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "False fiend, avoid!",
          "plainText": "False fiend avoid",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-006",
      "type": "stage",
      "text": "[Thunder and lightning. Exit Spirit.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-007",
      "type": "stage",
      "text": "Enter the Duke of York and the Duke of Buckingham with their Guard, and Sir Humphrey Stafford, and break in."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Lay hands upon these traitors and their trash.",
          "plainText": "Lay hands upon these traitors and their trash",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Beldam, I think we watched you at an inch.",
          "plainText": "Beldam I think we watched you at an inch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "What, madam, are you there? The King and commonweal",
          "plainText": "What madam are you there The King and commonweal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "Are deeply indebted for this piece of pains.",
          "plainText": "Are deeply indebted for this piece of pains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "My Lord Protector will, I doubt it not,",
          "plainText": "My Lord Protector will I doubt it not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "See you well guerdoned for these good deserts.",
          "plainText": "See you well guerdoned for these good deserts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "eleanor",
        "name": "ELEANOR",
        "displayName": "Eleanor"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Not half so bad as thine to England's king,",
          "plainText": "Not half so bad as thine to England's king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "Injurious duke, that threatest where's no cause.",
          "plainText": "Injurious duke that threatest where's no cause",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "buckingham",
        "name": "BUCKINGHAM",
        "displayName": "Buckingham"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "True, madam, none at all. What call you this?",
          "plainText": "True madam none at all What call you this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Away with them! Let them be clapped up close",
          "plainText": "Away with them Let them be clapped up close",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "And kept asunder.—You, madam, shall with us.—",
          "plainText": "And kept asunderYou madam shall with us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "Stafford, take her to thee.",
          "plainText": "Stafford take her to thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-008",
      "type": "stage",
      "text": "[Exit Stafford.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-009",
      "type": "stage",
      "text": "[Exeunt above, Duchess and Hume, guarded.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-010",
      "type": "stage",
      "text": "[Exeunt guard with Jourdain, Southwell, Bolingbroke, etc.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Lord Buckingham, methinks you watched her well.",
          "plainText": "Lord Buckingham methinks you watched her well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "A pretty plot, well chosen to build upon!",
          "plainText": "A pretty plot well chosen to build upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "Now, pray, my lord, let's see the devil's writ.",
          "plainText": "Now pray my lord let's see the devil's writ",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "What have we here?",
          "plainText": "What have we here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0048",
          "number": 48,
          "speechLineNumber": 5,
          "text": "[Reads.] The duke yet lives that Henry shall depose.",
          "plainText": "Reads The duke yet lives that Henry shall depose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0049",
          "number": 49,
          "speechLineNumber": 6,
          "text": "But him outlive and die a violent death.",
          "plainText": "But him outlive and die a violent death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0050",
          "number": 50,
          "speechLineNumber": 7,
          "text": "Why, this is just",
          "plainText": "Why this is just",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0051",
          "number": 51,
          "speechLineNumber": 8,
          "text": "Aio te, Aeacida, Romanos vincere posse.",
          "plainText": "Aio te Aeacida Romanos vincere posse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0052",
          "number": 52,
          "speechLineNumber": 9,
          "text": "Well, to the rest:",
          "plainText": "Well to the rest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0053",
          "number": 53,
          "speechLineNumber": 10,
          "text": "Tell me what fate awaits the Duke of Suffolk?",
          "plainText": "Tell me what fate awaits the Duke of Suffolk",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0054",
          "number": 54,
          "speechLineNumber": 11,
          "text": "By water shall he die and take his end.",
          "plainText": "By water shall he die and take his end",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0055",
          "number": 55,
          "speechLineNumber": 12,
          "text": "What shall betide the Duke of Somerset?",
          "plainText": "What shall betide the Duke of Somerset",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0056",
          "number": 56,
          "speechLineNumber": 13,
          "text": "Let him shun castles;",
          "plainText": "Let him shun castles",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0057",
          "number": 57,
          "speechLineNumber": 14,
          "text": "Safer shall he be upon the sandy plains",
          "plainText": "Safer shall he be upon the sandy plains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0058",
          "number": 58,
          "speechLineNumber": 15,
          "text": "Than where castles mounted stand.",
          "plainText": "Than where castles mounted stand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0059",
          "number": 59,
          "speechLineNumber": 16,
          "text": "Come, come, my lords, these oracles",
          "plainText": "Come come my lords these oracles",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0060",
          "number": 60,
          "speechLineNumber": 17,
          "text": "Are hardly attained, and hardly understood.",
          "plainText": "Are hardly attained and hardly understood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0061",
          "number": 61,
          "speechLineNumber": 18,
          "text": "The King is now in progress towards Saint Albans,",
          "plainText": "The King is now in progress towards Saint Albans",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0062",
          "number": 62,
          "speechLineNumber": 19,
          "text": "With him the husband of this lovely lady.",
          "plainText": "With him the husband of this lovely lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0063",
          "number": 63,
          "speechLineNumber": 20,
          "text": "Thither go these news as fast as horse can carry them.",
          "plainText": "Thither go these news as fast as horse can carry them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0064",
          "number": 64,
          "speechLineNumber": 21,
          "text": "A sorry breakfast for my Lord Protector.",
          "plainText": "A sorry breakfast for my Lord Protector",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "buckingham",
        "name": "BUCKINGHAM",
        "displayName": "Buckingham"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Your Grace shall give me leave, my Lord of York,",
          "plainText": "Your Grace shall give me leave my Lord of York",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "To be the post, in hope of his reward.",
          "plainText": "To be the post in hope of his reward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-1-4-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "At your pleasure, my good lord.",
          "plainText": "At your pleasure my good lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-011",
      "type": "stage",
      "text": "[Exit Buckingham.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-012",
      "type": "stage",
      "text": "Enter a Servingman."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-1-4-stage-013",
