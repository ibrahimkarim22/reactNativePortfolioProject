      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nMy heart assures me that the Earl of Warwick\nShall one day make the Duke of York a king.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneII_13.2/p@65580/line-1",
