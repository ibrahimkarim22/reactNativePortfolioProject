    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneII_13.2/p@65486",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALISBURY.\nMy lord, break we off; we know your mind at full.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneII_13.2/p@65486/line-1",
