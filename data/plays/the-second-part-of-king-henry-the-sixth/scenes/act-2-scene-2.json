      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOTH.\nLong live our sovereign Richard, England’s king!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneII_13.2/p@64729/line-1",
