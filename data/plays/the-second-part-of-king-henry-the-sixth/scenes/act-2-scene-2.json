      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALISBURY.\nMy lord, I long to hear it at full.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneII_13.2/p@61586/line-1",
