          "start": 48,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127633/line-4",
          "start": 93,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127633/line-5",
