    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127125",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nHow fares my lord? Speak, Beaufort, to thy sovereign.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127125/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127125/line-2",
          "start": 12,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2389939,
        "end": 2390034,
        "line": 87243,
        "column": 1,
        "path": "chap13/p@127125",
        "anchor": "sceneIII_13.3"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127224",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CARDINAL.\nIf thou be’st Death, I’ll give thee England’s treasure,\nEnough to purchase such another island,\nSo thou wilt let me live and feel no pain.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127224/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127224/line-2",
          "start": 10,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127224/line-3",
          "start": 66,
          "end": 105,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127224/line-4",
          "start": 106,
          "end": 148,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2390038,
        "end": 2390226,
        "line": 87248,
        "column": 1,
        "path": "chap13/p@127224",
        "anchor": "sceneIII_13.3"
      },
      "speakerLabel": "CARDINAL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127416",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nAh, what a sign it is of evil life\nWhere death’s approach is seen so terrible!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127416/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127416/line-2",
          "start": 12,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127416/line-3",
          "start": 47,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2390230,
        "end": 2390355,
        "line": 87255,
        "column": 1,
        "path": "chap13/p@127416",
        "anchor": "sceneIII_13.3"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127545",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nBeaufort, it is thy sovereign speaks to thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127545/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127545/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2390359,
        "end": 2390443,
        "line": 87261,
        "column": 1,
        "path": "chap13/p@127545",
        "anchor": "sceneIII_13.3"
      },
      "speakerLabel": "WARWICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127633",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CARDINAL.\nBring me unto my trial when you will.\nDied he not in his bed? Where should he die?\nCan I make men live, whe’er they will or no?\nO, torture me no more! I will confess.\nAlive again? Then show me where he is.\nI’ll give a thousand pound to look upon him.\nHe hath no eyes, the dust hath blinded them.\nComb down his hair; look, look, it stands upright,\nLike lime-twigs set to catch my winged soul.\nGive me some drink, and bid the apothecary\nBring the strong poison that I bought of him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@127633/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
