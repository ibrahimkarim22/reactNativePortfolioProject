    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128480",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nSee how the pangs of death do make him grin!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128480/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128480/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2391294,
        "end": 2391377,
        "line": 87290,
        "column": 1,
        "path": "chap13/p@128480",
        "anchor": "sceneIII_13.3"
      },
      "speakerLabel": "WARWICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128567",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SALISBURY.\nDisturb him not; let him pass peaceably.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128567/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128567/line-2",
          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2391381,
        "end": 2391462,
        "line": 87295,
        "column": 1,
        "path": "chap13/p@128567",
        "anchor": "sceneIII_13.3"
      },
      "speakerLabel": "SALISBURY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128652",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nPeace to his soul, if God’s good pleasure be!\nLord Cardinal, if thou think’st on heaven’s bliss,\nHold up thy hand, make signal of thy hope.\nHe dies and makes no sign. O God, forgive him!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128652/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128652/line-2",
          "start": 12,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128652/line-3",
          "start": 58,
          "end": 108,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128652/line-4",
          "start": 109,
          "end": 151,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128652/line-5",
          "start": 152,
          "end": 198,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2391466,
        "end": 2391709,
        "line": 87300,
        "column": 1,
        "path": "chap13/p@128652",
        "anchor": "sceneIII_13.3"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
