    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128207",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nO Thou eternal mover of the heavens,\nLook with a gentle eye upon this wretch!\nO, beat away the busy meddling fiend\nThat lays strong siege unto this wretch’s soul,\nAnd from his bosom purge this black despair!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128207/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128207/line-2",
          "start": 12,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128207/line-3",
          "start": 49,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128207/line-4",
          "start": 90,
          "end": 126,
          "sourceLineNumber": null
        },
