      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128899",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nSo bad a death argues a monstrous life.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128899/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128899/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2391713,
        "end": 2391791,
        "line": 87308,
        "column": 1,
        "path": "chap13/p@128899",
        "anchor": "sceneIII_13.3"
      },
      "speakerLabel": "WARWICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128981",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nForbear to judge, for we are sinners all.\nClose up his eyes, and draw the curtain close,\nAnd let us all to meditation.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIII_13.3/p@128981/line-1",
