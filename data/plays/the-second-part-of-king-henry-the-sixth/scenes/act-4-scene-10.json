    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@176118",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CADE.\nBrave thee? Ay, by the best blood that ever was broached, and beard thee too. Look on me well: I have eat no meat these five days, yet come thou and thy five men, and if I do not leave you all as dead as a doornail, I pray God I may never eat grass more.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@176118/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@176118/line-2",
          "start": 6,
          "end": 260,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2438932,
        "end": 2439225,
        "line": 89015,
        "column": 1,
        "path": "chap13/p@176118",
        "anchor": "sceneIV_13.10"
      },
      "speakerLabel": "CADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@176415",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IDEN.\nNay, it shall ne’er be said, while England stands,\nThat Alexander Iden, an esquire of Kent,\nTook odds to combat a poor famished man.\nOppose thy steadfast-gazing eyes to mine,\nSee if thou canst outface me with thy looks.\nSet limb to limb and thou art far the lesser;\nThy hand is but a finger to my fist,\nThy leg a stick compared with this truncheon.\nMy foot shall fight with all the strength thou hast;\nAnd if mine arm be heaved in the air,\nThy grave is digged already in the earth.\nAs for words, whose greatness answers words,\nLet this my sword report what speech forbears.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@176415/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
