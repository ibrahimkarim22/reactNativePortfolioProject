    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@175025",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "IDEN.\nLord, who would live turmoiled in the court\nAnd may enjoy such quiet walks as these?\nThis small inheritance my father left me\nContenteth me, and worth a monarchy.\nI seek not to wax great by others’ waning,\nOr gather wealth, I care not with what envy;\nSufficeth that I have maintains my state\nAnd sends the poor well pleased from my gate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@175025/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@175025/line-2",
          "start": 6,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@175025/line-3",
          "start": 50,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@175025/line-4",
          "start": 91,
          "end": 131,
          "sourceLineNumber": null
        },
        {
