          "end": 183,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@175785/line-6",
          "start": 184,
          "end": 227,
          "sourceLineNumber": null
