          "start": 47,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@175785/line-4",
          "start": 97,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@175785/line-5",
