    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.10/p@178119",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CADE.\nIden, farewell, and be proud of thy victory. Tell Kent from me she hath lost her best man, and exhort all the world to be cowards; for I, that never feared any, am vanquished by famine, not by valour.",
      "separatorAfter": "\n\n",
