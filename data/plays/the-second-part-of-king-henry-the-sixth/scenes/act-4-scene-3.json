      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@150872",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CADE.\nWhere’s Dick, the butcher of Ashford?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@150872/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@150872/line-2",
          "start": 6,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2413686,
        "end": 2413759,
        "line": 88183,
        "column": 1,
        "path": "chap13/p@150872",
        "anchor": "sceneIV_13.3"
      },
      "speakerLabel": "CADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@150949",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DICK.\nHere, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@150949/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@150949/line-2",
          "start": 6,
          "end": 16,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2413763,
        "end": 2413809,
        "line": 88188,
        "column": 1,
        "path": "chap13/p@150949",
        "anchor": "sceneIV_13.3"
      },
      "speakerLabel": "DICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@150999",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CADE.\nThey fell before thee like sheep and oxen, and thou behaved’st thyself as if thou hadst been in thine own slaughterhouse. Therefore thus will I reward thee: the Lent shall be as long again as it is, and thou shalt have a licence to kill for a hundred lacking one.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@150999/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@150999/line-2",
          "start": 6,
          "end": 269,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2413813,
        "end": 2414115,
        "line": 88193,
        "column": 1,
        "path": "chap13/p@150999",
        "anchor": "sceneIV_13.3"
      },
      "speakerLabel": "CADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151305",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DICK.\nI desire no more.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151305/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151305/line-2",
          "start": 6,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2414119,
        "end": 2414172,
        "line": 88201,
        "column": 1,
        "path": "chap13/p@151305",
        "anchor": "sceneIV_13.3"
      },
      "speakerLabel": "DICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151362",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CADE.\nAnd, to speak truth, thou deservest no less. This monument of the victory will I bear. [putting on Sir Humphrey’s brigandine] And the bodies shall be dragged at my horse heels till I do come to London, where we will have the Mayor’s sword borne before us.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 94,
          "end": 130
        }
      ],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151362/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151362/line-2",
          "start": 6,
          "end": 261,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2414176,
        "end": 2414477,
        "line": 88206,
        "column": 1,
        "path": "chap13/p@151362",
        "anchor": "sceneIV_13.3"
      },
      "speakerLabel": "CADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151667",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DICK.\nIf we mean to thrive and do good, break open the gaols and let out the prisoners.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151667/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151667/line-2",
          "start": 6,
          "end": 87,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2414481,
        "end": 2414599,
        "line": 88214,
        "column": 1,
        "path": "chap13/p@151667",
        "anchor": "sceneIV_13.3"
      },
      "speakerLabel": "DICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151789",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CADE.\nFear not that, I warrant thee. Come, let’s march towards London.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151789/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151789/line-2",
          "start": 6,
          "end": 70,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2414603,
        "end": 2414703,
        "line": 88220,
        "column": 1,
        "path": "chap13/p@151789",
        "anchor": "sceneIV_13.3"
      },
      "speakerLabel": "CADE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@151893",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt.]",
      "separatorAfter": "\n\n",
