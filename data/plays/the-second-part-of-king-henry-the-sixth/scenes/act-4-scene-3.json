      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "[Alarums to the fight, wherein both the Staffords are slain. Enter Cade and the rest.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 40,
          "end": 49,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 67,
          "end": 71,
