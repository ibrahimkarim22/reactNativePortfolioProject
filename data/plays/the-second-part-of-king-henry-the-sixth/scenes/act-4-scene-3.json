        }
      ],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.3/p@150698/line-1",
          "start": 0,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
