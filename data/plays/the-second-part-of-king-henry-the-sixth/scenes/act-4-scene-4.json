          "start": 12,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2418417,
        "end": 2418502,
        "line": 88353,
        "column": 1,
        "path": "chap13/p@155603",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "BUCKINGHAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155692",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nCome, Margaret. God, our hope, will succour us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155692/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155692/line-2",
          "start": 12,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2418506,
        "end": 2418595,
        "line": 88358,
        "column": 1,
        "path": "chap13/p@155692",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155785",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN MARGARET.\n[Aside.] My hope is gone, now Suffolk is deceased.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 17,
          "end": 22
        }
      ],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155785/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155785/line-2",
          "start": 16,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2418599,
        "end": 2418702,
        "line": 88363,
        "column": 1,
        "path": "chap13/p@155785",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "QUEEN MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155892",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nFarewell, my lord. Trust not the Kentish rebels.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155892/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155892/line-2",
          "start": 12,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2418706,
        "end": 2418796,
        "line": 88368,
        "column": 1,
        "path": "chap13/p@155892",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155986",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BUCKINGHAM.\nTrust nobody, for fear you be betrayed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155986/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
