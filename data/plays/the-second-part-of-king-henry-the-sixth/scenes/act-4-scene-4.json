    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153316",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nLord Saye, Jack Cade hath sworn to have thy head.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153316/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153316/line-2",
          "start": 12,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2416130,
        "end": 2416221,
        "line": 88266,
        "column": 1,
        "path": "chap13/p@153316",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153411",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SAYE.\nAy, but I hope your highness shall have his.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153411/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153411/line-2",
          "start": 6,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2416225,
        "end": 2416305,
        "line": 88271,
        "column": 1,
        "path": "chap13/p@153411",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "SAYE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153495",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nHow now, madam?\nStill lamenting and mourning for Suffolk’s death?\nI fear me, love, if that I had been dead,\nThou wouldst not have mourned so much for me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153495/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153495/line-2",
          "start": 12,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153495/line-3",
          "start": 28,
          "end": 77,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153495/line-4",
          "start": 78,
          "end": 119,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153495/line-5",
          "start": 120,
          "end": 165,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2416309,
        "end": 2416519,
        "line": 88276,
        "column": 1,
        "path": "chap13/p@153495",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153709",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN MARGARET.\nNo, my love, I should not mourn, but die for thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153709/line-1",
          "start": 0,
