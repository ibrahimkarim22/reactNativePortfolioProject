    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@152653",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BUCKINGHAM.\nWhat answer makes your grace to the rebels’ supplication?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@152653/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@152653/line-2",
          "start": 12,
          "end": 69,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2415467,
        "end": 2415566,
        "line": 88243,
        "column": 1,
        "path": "chap13/p@152653",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "BUCKINGHAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@152756",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nI’ll send some holy bishop to entreat,\nFor God forbid so many simple souls\nShould perish by the sword! And I myself,\nRather than bloody war shall cut them short,\nWill parley with Jack Cade their general.\nBut stay, I’ll read it over once again.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@152756/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@152756/line-2",
          "start": 12,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@152756/line-3",
          "start": 51,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@152756/line-4",
          "start": 87,
          "end": 128,
          "sourceLineNumber": null
        },
        {
