          "start": 12,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2418800,
        "end": 2418881,
        "line": 88373,
        "column": 1,
        "path": "chap13/p@155986",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "BUCKINGHAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@156071",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SAYE.\nThe trust I have is in mine innocence,\nAnd therefore am I bold and resolute.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@156071/line-1",
