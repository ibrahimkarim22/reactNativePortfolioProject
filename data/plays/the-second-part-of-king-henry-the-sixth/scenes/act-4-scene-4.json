    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155603",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BUCKINGHAM.\nThen linger not, my lord; away, take horse!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155603/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
