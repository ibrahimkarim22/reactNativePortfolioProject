    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154550",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nO graceless men! They know not what they do.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154550/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154550/line-2",
          "start": 12,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2417364,
        "end": 2417450,
        "line": 88311,
        "column": 1,
        "path": "chap13/p@154550",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154640",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BUCKINGHAM.\nMy gracious lord, retire to Killingworth\nUntil a power be raised to put them down.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154640/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154640/line-2",
          "start": 12,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154640/line-3",
          "start": 53,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2417454,
        "end": 2417583,
        "line": 88316,
        "column": 1,
        "path": "chap13/p@154640",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "BUCKINGHAM.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154773",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN MARGARET.\nAh, were the Duke of Suffolk now alive,\nThese Kentish rebels would be soon appeased!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154773/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154773/line-2",
          "start": 16,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154773/line-3",
          "start": 56,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2417587,
        "end": 2417722,
        "line": 88322,
        "column": 1,
        "path": "chap13/p@154773",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "QUEEN MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154912",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nLord Saye, the traitors hate thee;\nTherefore away with us to Killingworth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154912/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154912/line-2",
          "start": 12,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@154912/line-3",
          "start": 47,
          "end": 86,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2417726,
        "end": 2417847,
        "line": 88328,
        "column": 1,
        "path": "chap13/p@154912",
        "anchor": "sceneIV_13.4"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155037",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SAYE.\nSo might your grace’s person be in danger.\nThe sight of me is odious in their eyes;\nAnd therefore in this city will I stay\nAnd live alone as secret as I may.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155037/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155037/line-2",
          "start": 6,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155037/line-3",
          "start": 49,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155037/line-4",
          "start": 90,
          "end": 128,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155037/line-5",
          "start": 129,
          "end": 163,
          "sourceLineNumber": null
        }
      ],
