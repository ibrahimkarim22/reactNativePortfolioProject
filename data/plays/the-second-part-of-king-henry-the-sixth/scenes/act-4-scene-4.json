    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153070",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN MARGARET.\n[Aside.] Ah, barbarous villains! Hath this lovely face\nRuled, like a wandering planet, over me,\nAnd could it not enforce them to relent\nThat were unworthy to behold the same?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 17,
          "end": 22
        }
      ],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153070/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153070/line-2",
          "start": 16,
          "end": 70,
          "sourceLineNumber": null
