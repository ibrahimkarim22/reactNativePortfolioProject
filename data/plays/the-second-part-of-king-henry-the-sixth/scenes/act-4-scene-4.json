      },
      "speakerLabel": "QUEEN MARGARET.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@153809",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter a Messenger.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 17,
          "className": "charname"
        }
      ],
      "lines": [
