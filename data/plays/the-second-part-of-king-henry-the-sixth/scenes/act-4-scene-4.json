    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155332",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nJack Cade hath gotten London Bridge;\nThe citizens fly and forsake their houses.\nThe rascal people, thirsting after prey,\nJoin with the traitor, and they jointly swear\nTo spoil the city and your royal court.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155332/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155332/line-2",
          "start": 11,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155332/line-3",
          "start": 48,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155332/line-4",
          "start": 91,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155332/line-5",
          "start": 132,
          "end": 177,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.4/p@155332/line-6",
          "start": 178,
          "end": 217,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
