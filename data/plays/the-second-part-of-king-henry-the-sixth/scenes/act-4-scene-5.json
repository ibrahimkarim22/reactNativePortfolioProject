    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.5/p@156447",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCALES.\nHow now? Is Jack Cade slain?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.5/p@156447/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.5/p@156447/line-2",
          "start": 8,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2419261,
        "end": 2419327,
        "line": 88391,
        "column": 1,
        "path": "chap13/p@156447",
        "anchor": "sceneIV_13.5"
      },
      "speakerLabel": "SCALES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.5/p@156517",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "1 CITIZEN.\nNo, my lord, nor likely to be slain; for they have won the Bridge, killing all those that withstand them. The Lord Mayor craves aid of your honour from the Tower to defend the city from the rebels.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.5/p@156517/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.5/p@156517/line-2",
          "start": 11,
          "end": 208,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2419331,
        "end": 2419571,
        "line": 88396,
        "column": 1,
        "path": "chap13/p@156517",
        "anchor": "sceneIV_13.5"
      },
      "speakerLabel": "1 CITIZEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.5/p@156761",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SCALES.\nSuch aid as I can spare you shall command,\nBut I am troubled here with them myself;\nThe rebels have assayed to win the Tower.\nBut get you to Smithfield and gather head,\nAnd thither I will send you Matthew Gough.\nFight for your king, your country, and your lives!\nAnd so farewell, for I must hence again.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.5/p@156761/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
