          "start": 9,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2420608,
        "end": 2420668,
        "line": 88431,
        "column": 1,
        "path": "chap13/p@157794",
        "anchor": "sceneIV_13.6"
      },
