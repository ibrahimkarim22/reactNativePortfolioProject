    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.6/p@157858",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CADE.\nKnock him down there.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.6/p@157858/line-1",
