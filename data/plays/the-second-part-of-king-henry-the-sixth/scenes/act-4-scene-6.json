    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.6/p@157382",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CADE.\nNow is Mortimer lord of this city. And here, sitting upon London Stone, I charge and command that, of the city’s cost, the Pissing Conduit run nothing but claret wine this first year of our reign. And now henceforward it shall be treason for any that calls me other than Lord Mortimer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.6/p@157382/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.6/p@157382/line-2",
          "start": 6,
          "end": 291,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
