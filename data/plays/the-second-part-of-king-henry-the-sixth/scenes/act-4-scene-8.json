    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@166640",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CADE.\nUp Fish Street! Down Saint Magnus’ Corner! Kill and knock down! Throw them into Thames! [Sound a parley.] What noise is this I hear? Dare any be so bold to sound retreat or parley when I command them kill?",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 95,
          "end": 109
        }
      ],
