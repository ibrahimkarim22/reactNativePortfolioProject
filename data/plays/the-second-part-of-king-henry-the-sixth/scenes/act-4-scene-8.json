    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@168514",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALL.\nWe’ll follow Cade! We’ll follow Cade!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@168514/line-1",
          "start": 0,
          "end": 4,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@168514/line-2",
          "start": 5,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2431328,
        "end": 2431400,
        "line": 88792,
        "column": 1,
        "path": "chap13/p@168514",
        "anchor": "sceneIV_13.8"
      },
      "speakerLabel": "ALL.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 4
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@168590",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLIFFORD.\nIs Cade the son of Henry the Fifth,\nThat thus you do exclaim you’ll go with him?\nWill he conduct you through the heart of France\nAnd make the meanest of you earls and dukes?\nAlas, he hath no home, no place to fly to,\nNor knows he how to live but by the spoil,\nUnless by robbing of your friends and us.\nWere ’t not a shame that whilst you live at jar\nThe fearful French, whom you late vanquished,\nShould make a start o’er seas and vanquish you?\nMethinks already in this civil broil\nI see them lording it in London streets,\nCrying “Villiago!” unto all they meet.\nBetter ten thousand base-born Cades miscarry\nThan you should stoop unto a Frenchman’s mercy.\nTo France, to France, and get what you have lost!\nSpare England, for it is your native coast.\nHenry hath money, you are strong and manly;\nGod on our side, doubt not of victory.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 540,
          "end": 549
        }
      ],
