      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALL.\nA Clifford! A Clifford! We’ll follow the King and Clifford.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@169561/line-1",
          "start": 0,
