    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@167027",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BUCKINGHAM.\nAy, here they be that dare and will disturb thee.\nKnow, Cade, we come ambassadors from the King\nUnto the commons, whom thou hast misled,\nAnd here pronounce free pardon to them all\nThat will forsake thee and go home in peace.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@167027/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@167027/line-2",
          "start": 12,
          "end": 61,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@167027/line-3",
          "start": 62,
          "end": 107,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@167027/line-4",
          "start": 108,
          "end": 148,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.8/p@167027/line-5",
          "start": 149,
          "end": 191,
          "sourceLineNumber": null
        },
        {
