    "location": "Kenilworth Castle",
    "orderInPlay": 20
  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-stage-001",
      "type": "stage",
      "text": "Sound trumpets. Enter King, Queen and Somerset on the terrace, aloft."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Was ever king that joyed an earthly throne",
          "plainText": "Was ever king that joyed an earthly throne",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And could command no more content than I?",
          "plainText": "And could command no more content than I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "No sooner was I crept out of my cradle",
          "plainText": "No sooner was I crept out of my cradle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "But I was made a king at nine months old.",
          "plainText": "But I was made a king at nine months old",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Was never subject longed to be a king",
          "plainText": "Was never subject longed to be a king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "As I do long and wish to be a subject.",
          "plainText": "As I do long and wish to be a subject",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-stage-002",
      "type": "stage",
      "text": "Enter Buckingham and old Clifford."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-002",
      "type": "speech",
      "speaker": {
        "id": "buckingham",
        "name": "BUCKINGHAM",
        "displayName": "Buckingham"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Health and glad tidings to your majesty!",
          "plainText": "Health and glad tidings to your majesty",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Why, Buckingham, is the traitor Cade surprised?",
          "plainText": "Why Buckingham is the traitor Cade surprised",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Or is he but retired to make him strong?",
          "plainText": "Or is he but retired to make him strong",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-stage-003",
      "type": "stage",
      "text": "Enter below multitudes with halters about their necks."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-004",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "He is fled, my lord, and all his powers do yield,",
          "plainText": "He is fled my lord and all his powers do yield",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "And humbly thus, with halters on their necks,",
          "plainText": "And humbly thus with halters on their necks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "Expect your highness' doom of life or death.",
          "plainText": "Expect your highness' doom of life or death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-005",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Then, heaven, set ope thy everlasting gates",
          "plainText": "Then heaven set ope thy everlasting gates",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "To entertain my vows of thanks and praise!",
          "plainText": "To entertain my vows of thanks and praise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "Soldiers, this day have you redeemed your lives",
          "plainText": "Soldiers this day have you redeemed your lives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "And showed how well you love your prince and country.",
          "plainText": "And showed how well you love your prince and country",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0017",
          "number": 17,
          "speechLineNumber": 5,
          "text": "Continue still in this so good a mind,",
          "plainText": "Continue still in this so good a mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0018",
          "number": 18,
          "speechLineNumber": 6,
          "text": "And Henry, though he be infortunate,",
          "plainText": "And Henry though he be infortunate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0019",
          "number": 19,
          "speechLineNumber": 7,
          "text": "Assure yourselves, will never be unkind.",
          "plainText": "Assure yourselves will never be unkind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0020",
          "number": 20,
          "speechLineNumber": 8,
          "text": "And so, with thanks and pardon to you all,",
          "plainText": "And so with thanks and pardon to you all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0021",
          "number": 21,
          "speechLineNumber": 9,
          "text": "I do dismiss you to your several countries.",
          "plainText": "I do dismiss you to your several countries",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-006",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "God save the King! God save the King!",
          "plainText": "God save the King God save the King",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-stage-004",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-007",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Please it your grace to be advertised",
          "plainText": "Please it your grace to be advertised",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "The Duke of York is newly come from Ireland,",
          "plainText": "The Duke of York is newly come from Ireland",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "And with a puissant and a mighty power",
          "plainText": "And with a puissant and a mighty power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "Of gallowglasses and stout kerns",
          "plainText": "Of gallowglasses and stout kerns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "Is marching hitherward in proud array,",
          "plainText": "Is marching hitherward in proud array",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0028",
          "number": 28,
          "speechLineNumber": 6,
          "text": "And still proclaimeth, as he comes along,",
          "plainText": "And still proclaimeth as he comes along",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0029",
          "number": 29,
          "speechLineNumber": 7,
          "text": "His arms are only to remove from thee",
          "plainText": "His arms are only to remove from thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0030",
          "number": 30,
          "speechLineNumber": 8,
          "text": "The Duke of Somerset, whom he terms a traitor.",
          "plainText": "The Duke of Somerset whom he terms a traitor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-008",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Thus stands my state, 'twixt Cade and York distressed,",
          "plainText": "Thus stands my state 'twixt Cade and York distressed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Like to a ship that, having scaped a tempest,",
          "plainText": "Like to a ship that having scaped a tempest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "Is straightway calmed and boarded with a pirate.",
          "plainText": "Is straightway calmed and boarded with a pirate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "But now is Cade driven back, his men dispersed,",
          "plainText": "But now is Cade driven back his men dispersed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0035",
          "number": 35,
          "speechLineNumber": 5,
          "text": "And now is York in arms to second him.",
          "plainText": "And now is York in arms to second him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0036",
          "number": 36,
          "speechLineNumber": 6,
          "text": "I pray thee, Buckingham, go and meet him,",
          "plainText": "I pray thee Buckingham go and meet him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0037",
          "number": 37,
          "speechLineNumber": 7,
          "text": "And ask him what's the reason of these arms.",
          "plainText": "And ask him what's the reason of these arms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0038",
          "number": 38,
          "speechLineNumber": 8,
          "text": "Tell him I'll send Duke Edmund to the Tower.—",
          "plainText": "Tell him I'll send Duke Edmund to the Tower",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0039",
          "number": 39,
          "speechLineNumber": 9,
          "text": "And, Somerset, we will commit thee thither,",
          "plainText": "And Somerset we will commit thee thither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0040",
          "number": 40,
          "speechLineNumber": 10,
          "text": "Until his army be dismissed from him.",
          "plainText": "Until his army be dismissed from him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-009",
      "type": "speech",
      "speaker": {
        "id": "somerset",
        "name": "SOMERSET",
        "displayName": "Somerset"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "My lord, I'll yield myself to prison willingly,",
          "plainText": "My lord I'll yield myself to prison willingly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Or unto death, to do my country good.",
          "plainText": "Or unto death to do my country good",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-010",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "In any case, be not too rough in terms,",
          "plainText": "In any case be not too rough in terms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "For he is fierce and cannot brook hard language.",
          "plainText": "For he is fierce and cannot brook hard language",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-9-speech-011",
      "type": "speech",
      "speaker": {
        "id": "buckingham",
        "name": "BUCKINGHAM",
        "displayName": "Buckingham"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-9-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "I will, my lord, and doubt not so to deal",
          "plainText": "I will my lord and doubt not so to deal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
