    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@171600",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLIFFORD.\nHe is fled, my lord, and all his powers do yield,\nAnd humbly thus, with halters on their necks,\nExpect your highness’ doom of life or death.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@171600/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@171600/line-2",
          "start": 10,
          "end": 59,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@171600/line-3",
          "start": 60,
          "end": 105,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@171600/line-4",
          "start": 106,
          "end": 150,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2434414,
        "end": 2434604,
        "line": 88885,
        "column": 1,
        "path": "chap13/p@171600",
        "anchor": "sceneIV_13.9"
      },
      "speakerLabel": "CLIFFORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@171794",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nThen, heaven, set ope thy everlasting gates\nTo entertain my vows of thanks and praise!\nSoldiers, this day have you redeemed your lives\nAnd showed how well you love your prince and country.\nContinue still in this so good a mind,\nAnd Henry, though he be infortunate,\nAssure yourselves, will never be unkind.\nAnd so, with thanks and pardon to you all,\nI do dismiss you to your several countries.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@171794/line-1",
