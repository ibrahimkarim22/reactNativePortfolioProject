    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@172425",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nPlease it your grace to be advertised\nThe Duke of York is newly come from Ireland,\nAnd with a puissant and a mighty power\nOf gallowglasses and stout kerns\nIs marching hitherward in proud array,\nAnd still proclaimeth, as he comes along,\nHis arms are only to remove from thee\nThe Duke of Somerset, whom he terms a traitor.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@172425/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@172425/line-2",
          "start": 11,
          "end": 48,
          "sourceLineNumber": null
        },
        {
