    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@171292",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BUCKINGHAM.\nHealth and glad tidings to your majesty!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
