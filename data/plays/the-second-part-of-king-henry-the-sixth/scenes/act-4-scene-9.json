    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@170855",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nWas ever king that joyed an earthly throne\nAnd could command no more content than I?\nNo sooner was I crept out of my cradle\nBut I was made a king at nine months old.\nWas never subject longed to be a king\nAs I do long and wish to be a subject.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
