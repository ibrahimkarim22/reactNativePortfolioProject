          "start": 12,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2434106,
        "end": 2434188,
        "line": 88872,
        "column": 1,
        "path": "chap13/p@171292",
        "anchor": "sceneIV_13.9"
      },
