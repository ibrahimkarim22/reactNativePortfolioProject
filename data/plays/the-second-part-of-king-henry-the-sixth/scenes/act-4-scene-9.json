    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@171378",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nWhy, Buckingham, is the traitor Cade surprised?\nOr is he but retired to make him strong?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneIV_13.9/p@171378/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
