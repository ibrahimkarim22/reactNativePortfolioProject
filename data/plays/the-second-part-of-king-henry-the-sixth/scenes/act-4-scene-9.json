      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOMERSET.\nMy lord, I’ll yield myself to prison willingly,\nOr unto death, to do my country good.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
