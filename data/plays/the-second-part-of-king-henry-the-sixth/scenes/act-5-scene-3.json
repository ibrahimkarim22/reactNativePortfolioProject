    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneV_13.3/p@201164",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nAfter them? Nay, before them, if we can.\nNow, by my hand, lords, ’twas a glorious day.\nSaint Albans battle won by famous York\nShall be eternized in all age to come.\nSound drums and trumpets, and to London all;\nAnd more such days as these to us befall!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
