    {
      "id": "the-second-part-of-king-henry-the-sixth/sceneV_13.3/p@200434",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Now, by my sword, well hast thou fought today.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth/sceneV_13.3/p@200434/line-1",
          "start": 0,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
