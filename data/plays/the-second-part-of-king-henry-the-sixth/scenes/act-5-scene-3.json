  "scene": {
    "id": "the-second-part-of-king-henry-the-sixth-5-3",
    "act": 5,
    "scene": 3,
    "label": "Act 5, Scene 3",
    "title": "SCENE III. Fields near Saint Albans",
    "location": "Fields near Saint Albans",
    "orderInPlay": 24
  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-3-stage-001",
      "type": "stage",
      "text": "Alarum. Retreat. Enter York, Richard, Warwick and Soldiers with drum and colours."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Of Salisbury, who can report of him,",
          "plainText": "Of Salisbury who can report of him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "That winter lion, who in rage forgets",
          "plainText": "That winter lion who in rage forgets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Aged contusions and all brush of time,",
          "plainText": "Aged contusions and all brush of time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And, like a gallant in the brow of youth,",
          "plainText": "And like a gallant in the brow of youth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Repairs him with occasion? This happy day",
          "plainText": "Repairs him with occasion This happy day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Is not itself, nor have we won one foot,",
          "plainText": "Is not itself nor have we won one foot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "If Salisbury be lost.",
          "plainText": "If Salisbury be lost",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "My noble father,",
          "plainText": "My noble father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Three times today I holp him to his horse,",
          "plainText": "Three times today I holp him to his horse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Three times bestrid him; thrice I led him off,",
          "plainText": "Three times bestrid him thrice I led him off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Persuaded him from any further act;",
          "plainText": "Persuaded him from any further act",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "But still, where danger was, still there I met him,",
          "plainText": "But still where danger was still there I met him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "And like rich hangings in a homely house,",
          "plainText": "And like rich hangings in a homely house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0014",
          "number": 14,
          "speechLineNumber": 7,
          "text": "So was his will in his old feeble body.",
          "plainText": "So was his will in his old feeble body",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0015",
          "number": 15,
          "speechLineNumber": 8,
          "text": "But, noble as he is, look where he comes.",
          "plainText": "But noble as he is look where he comes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-3-stage-002",
      "type": "stage",
      "text": "Enter Salisbury."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "salisbury",
        "name": "SALISBURY",
        "displayName": "Salisbury"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "By th' mass, so did we all. I thank you, Richard.",
          "plainText": "By th' mass so did we all I thank you Richard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "God knows how long it is I have to live,",
          "plainText": "God knows how long it is I have to live",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "And it hath pleased him that three times today",
          "plainText": "And it hath pleased him that three times today",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "You have defended me from imminent death.",
          "plainText": "You have defended me from imminent death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "Well, lords, we have not got that which we have;",
          "plainText": "Well lords we have not got that which we have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0021",
          "number": 21,
          "speechLineNumber": 6,
          "text": "'Tis not enough our foes are this time fled,",
          "plainText": "'Tis not enough our foes are this time fled",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0022",
          "number": 22,
          "speechLineNumber": 7,
          "text": "Being opposites of such repairing nature.",
          "plainText": "Being opposites of such repairing nature",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "I know our safety is to follow them;",
          "plainText": "I know our safety is to follow them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "For, as I hear, the King is fled to London",
          "plainText": "For as I hear the King is fled to London",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "To call a present court of parliament.",
          "plainText": "To call a present court of parliament",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "Let us pursue him ere the writs go forth.",
          "plainText": "Let us pursue him ere the writs go forth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "What says Lord Warwick? Shall we after them?",
          "plainText": "What says Lord Warwick Shall we after them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "After them? Nay, before them, if we can.",
          "plainText": "After them Nay before them if we can",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "Now, by my hand, lords, 'twas a glorious day.",
          "plainText": "Now by my hand lords 'twas a glorious day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "Saint Albans battle won by famous York",
          "plainText": "Saint Albans battle won by famous York",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0031",
          "number": 31,
          "speechLineNumber": 4,
          "text": "Shall be eternized in all age to come.",
          "plainText": "Shall be eternized in all age to come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0032",
          "number": 32,
          "speechLineNumber": 5,
          "text": "Sound drums and trumpets, and to London all;",
          "plainText": "Sound drums and trumpets and to London all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-3-line-0033",
          "number": 33,
          "speechLineNumber": 6,
          "text": "And more such days as these to us befall!",
          "plainText": "And more such days as these to us befall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}