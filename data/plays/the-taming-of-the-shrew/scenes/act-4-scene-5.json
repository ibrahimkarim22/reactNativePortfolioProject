        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134365",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "VINCENTIO.\nLucentio, gentle sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134365/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134365/line-2",
          "start": 11,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5627234,
        "end": 5627280,
        "line": 208947,
        "column": 1,
        "path": "chap31/p@134365",
        "anchor": "sceneIV_31.5"
      },
      "speakerLabel": "VINCENTIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PETRUCHIO.\nHappily met; the happier for thy son.\nAnd now by law, as well as reverend age,\nI may entitle thee my loving father:\nThe sister to my wife, this gentlewoman,\nThy son by this hath married. Wonder not,\nNor be not griev’d: she is of good esteem,\nHer dowry wealthy, and of worthy birth;\nBeside, so qualified as may beseem\nThe spouse of any noble gentleman.\nLet me embrace with old Vincentio;\nAnd wander we to see thy honest son,\nWho will of thy arrival be full joyous.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-2",
          "start": 11,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-3",
          "start": 49,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-4",
          "start": 90,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-5",
          "start": 127,
          "end": 167,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-6",
          "start": 168,
          "end": 209,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-7",
          "start": 210,
          "end": 252,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-8",
          "start": 253,
          "end": 292,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-9",
          "start": 293,
          "end": 327,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-10",
          "start": 328,
          "end": 362,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-11",
          "start": 363,
          "end": 397,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-12",
          "start": 398,
          "end": 434,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134415/line-13",
          "start": 435,
          "end": 474,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5627284,
        "end": 5627827,
        "line": 208951,
        "column": 1,
        "path": "chap31/p@134415",
        "anchor": "sceneIV_31.5"
      },
      "speakerLabel": "PETRUCHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134962",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "VINCENTIO.\nBut is this true? or is it else your pleasure,\nLike pleasant travellers, to break a jest\nUpon the company you overtake?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134962/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134962/line-2",
          "start": 11,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134962/line-3",
          "start": 58,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134962/line-4",
          "start": 100,
          "end": 130,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5627831,
        "end": 5627985,
        "line": 208966,
        "column": 1,
        "path": "chap31/p@134962",
        "anchor": "sceneIV_31.5"
      },
      "speakerLabel": "VINCENTIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@135120",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "HORTENSIO.\nI do assure thee, father, so it is.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@135120/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@135120/line-2",
          "start": 11,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5627989,
        "end": 5628049,
        "line": 208972,
        "column": 1,
        "path": "chap31/p@135120",
        "anchor": "sceneIV_31.5"
      },
      "speakerLabel": "HORTENSIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@135184",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PETRUCHIO.\nCome, go along, and see the truth hereof;\nFor our first merriment hath made thee jealous.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@135184/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@135184/line-2",
          "start": 11,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@135184/line-3",
          "start": 53,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5628053,
        "end": 5628172,
        "line": 208976,
        "column": 1,
        "path": "chap31/p@135184",
        "anchor": "sceneIV_31.5"
      },
      "speakerLabel": "PETRUCHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@135307",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt all but Hortensio.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 16,
          "end": 26,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 26
        }
      ],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@135307/line-1",
          "start": 0,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5628176,
        "end": 5628261,
        "line": 208981,
        "column": 1,
        "path": "chap31/p@135307",
        "anchor": "sceneIV_31.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@135396",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "HORTENSIO.\nWell, Petruchio, this has put me in heart.\nHave to my widow! and if she be froward,\nThen hast thou taught Hortensio to be untoward.",
      "separatorAfter": "\n\n",
      "spans": [],
