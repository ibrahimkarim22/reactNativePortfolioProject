    },
    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134055",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "VINCENTIO.\nFair sir, and you my merry mistress,\nThat with your strange encounter much amaz’d me,\nMy name is called Vincentio; my dwelling Pisa;\nAnd bound I am to Padua, there to visit\nA son of mine, which long I have not seen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134055/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134055/line-2",
          "start": 11,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134055/line-3",
          "start": 48,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134055/line-4",
          "start": 97,
          "end": 143,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134055/line-5",
          "start": 144,
          "end": 183,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134055/line-6",
          "start": 184,
          "end": 226,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
