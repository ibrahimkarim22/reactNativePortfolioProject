    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@131416",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PETRUCHIO.\nNow by my mother’s son, and that’s myself,\nIt shall be moon, or star, or what I list,\nOr ere I journey to your father’s house.\nGo on and fetch our horses back again.\nEvermore cross’d and cross’d; nothing but cross’d!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@131416/line-1",
