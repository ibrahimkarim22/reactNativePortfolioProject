    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@132063",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PETRUCHIO.\nNay, then you lie; it is the blessed sun.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@132063/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@132063/line-2",
          "start": 11,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5624932,
        "end": 5624998,
        "line": 208868,
        "column": 1,
        "path": "chap31/p@132063",
        "anchor": "sceneIV_31.5"
      },
      "speakerLabel": "PETRUCHIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@132133",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KATHERINA.\nThen, God be bless’d, it is the blessed sun;\nBut sun it is not when you say it is not,\nAnd the moon changes even as your mind.\nWhat you will have it nam’d, even that it is,\nAnd so it shall be so for Katherine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@132133/line-1",
