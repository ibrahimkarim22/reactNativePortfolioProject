    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@131747",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "KATHERINA.\nForward, I pray, since we have come so far,\nAnd be it moon, or sun, or what you please;\nAnd if you please to call it a rush-candle,\nHenceforth I vow it shall be so for me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
