      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "HORTENSIO.\nPetruchio, go thy ways; the field is won.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@132391/line-1",
