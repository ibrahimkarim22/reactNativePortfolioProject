        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134319",
      "type": "speech",
      "tag": "p",
      "classes": [],
      "text": "PETRUCHIO.\nWhat is his name?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134319/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@134319/line-2",
          "start": 11,
          "end": 28,
          "sourceLineNumber": null
        }
