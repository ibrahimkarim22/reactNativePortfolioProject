    {
      "id": "the-taming-of-the-shrew/sceneIV_31.5/p@132720",
      "type": "passage",
      "tag": "p",
      "classes": [],
      "text": "[To Vincentio] Good morrow, gentle mistress; where away?\nTell me, sweet Kate, and tell me truly too,\nHast thou beheld a fresher gentlewoman?\nSuch war of white and red within her cheeks!\nWhat stars do spangle heaven with such beauty\nAs those two eyes become that heavenly face?\nFair lovely maid, once more good day to thee.\nSweet Kate, embrace her for her beauty’s sake.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 13
        }
      ],
      "lines": [
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@132720/line-1",
          "start": 0,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "the-taming-of-the-shrew/sceneIV_31.5/p@132720/line-2",
          "start": 57,
          "end": 100,
          "sourceLineNumber": null
        },
        {
