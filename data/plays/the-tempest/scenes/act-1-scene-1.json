      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nHang, cur, hang, you whoreson, insolent noisemaker! We are less afraid to be drowned than thou art.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
