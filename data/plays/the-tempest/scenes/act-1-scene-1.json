      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "A confused noise within: “Mercy on us!”—\n“We split, we split!”—“Farewell, my wife and children!”—\n“Farewell, brother!”—“We split, we split, we split!”",
      "separatorAfter": "\n\n",
      "spans": [
