      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@4925",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Re-enter Boatswain.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 9,
          "end": 18,
          "className": "charname"
        }
      ],
      "lines": [
        {
