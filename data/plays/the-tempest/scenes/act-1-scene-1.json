    {
      "id": "the-tempest/sceneI_32.1/p@3017",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Mariners.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@3017/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5653745,
        "end": 5653817,
        "line": 210060,
        "column": 1,
        "path": "chap32/p@3017",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@3093",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOATSWAIN.\nHeigh, my hearts! cheerly, cheerly, my hearts! yare, yare! Take in the topsail. Tend to th’ master’s whistle. Blow till thou burst thy wind, if room enough.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@3093/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@3093/line-2",
          "start": 11,
          "end": 167,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5653821,
        "end": 5654020,
        "line": 210063,
        "column": 1,
        "path": "chap32/p@3093",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "BOATSWAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@3296",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Alonso, Sebastian, Antonio, Ferdinand, Gonzalo and others.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 52,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@3296/line-1",
          "start": 0,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5654024,
        "end": 5654146,
        "line": 210070,
        "column": 1,
        "path": "chap32/p@3296",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@3422",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALONSO.\nGood boatswain, have care. Where’s the master?\nPlay the men.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@3422/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@3422/line-2",
          "start": 8,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@3422/line-3",
          "start": 55,
          "end": 68,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5654150,
        "end": 5654253,
        "line": 210074,
        "column": 1,
        "path": "chap32/p@3422",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "ALONSO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@3529",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOATSWAIN.\nI pray now, keep below.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@3529/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@3529/line-2",
          "start": 11,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5654257,
        "end": 5654321,
        "line": 210080,
        "column": 1,
        "path": "chap32/p@3529",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "BOATSWAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@3597",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nWhere is the master, boson?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@3597/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@3597/line-2",
          "start": 9,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5654325,
        "end": 5654391,
        "line": 210085,
        "column": 1,
        "path": "chap32/p@3597",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@3667",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOATSWAIN.\nDo you not hear him? You mar our labour: keep your cabins: you do assist the storm.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@3667/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@3667/line-2",
          "start": 11,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5654395,
        "end": 5654520,
        "line": 210090,
        "column": 1,
        "path": "chap32/p@3667",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "BOATSWAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@3796",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GONZALO.\nNay, good, be patient.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@3796/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@3796/line-2",
          "start": 9,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5654524,
        "end": 5654585,
        "line": 210096,
        "column": 1,
        "path": "chap32/p@3796",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "GONZALO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@3861",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOATSWAIN.\nWhen the sea is. Hence! What cares these roarers for the name of king? To cabin! silence! Trouble us not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@3861/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@3861/line-2",
          "start": 11,
          "end": 116,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5654589,
        "end": 5654736,
        "line": 210101,
        "column": 1,
        "path": "chap32/p@3861",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "BOATSWAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@4012",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GONZALO.\nGood, yet remember whom thou hast aboard.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@4012/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@4012/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5654740,
        "end": 5654820,
        "line": 210107,
        "column": 1,
        "path": "chap32/p@4012",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "GONZALO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@4096",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOATSWAIN.\nNone that I more love than myself. You are a counsellor: if you can command these elements to silence, and work the peace of the present, we will not hand a rope more. Use your authority: if you cannot, give thanks you have lived so long, and make yourself ready in your cabin for the mischance of the hour, if it so hap.—Cheerly, good hearts!—Out of our way, I say.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@4096/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@4096/line-2",
          "start": 11,
          "end": 377,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5654824,
        "end": 5655235,
        "line": 210112,
        "column": 1,
        "path": "chap32/p@4096",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "BOATSWAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@4511",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 6
        }
      ],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@4511/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5655239,
        "end": 5655275,
        "line": 210121,
        "column": 1,
        "path": "chap32/p@4511",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@4551",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GONZALO.\nI have great comfort from this fellow. Methinks he hath no drowning mark upon him. His complexion is perfect gallows. Stand fast, good Fate, to his hanging! Make the rope of his destiny our cable, for our own doth little advantage! If he be not born to be hang’d, our case is miserable.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@4551/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@4551/line-2",
          "start": 9,
          "end": 295,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5655279,
        "end": 5655607,
        "line": 210123,
        "column": 1,
        "path": "chap32/p@4551",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "GONZALO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@4883",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 8
        }
      ],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@4883/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5655611,
        "end": 5655649,
