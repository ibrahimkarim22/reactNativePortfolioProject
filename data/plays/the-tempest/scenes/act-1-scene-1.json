      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nA pox o’ your throat, you bawling, blasphemous, incharitable dog!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
