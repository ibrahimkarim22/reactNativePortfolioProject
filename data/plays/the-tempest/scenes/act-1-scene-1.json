    {
      "id": "the-tempest/sceneI_32.1/p@2772",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "BOATSWAIN.\nHere, master: what cheer?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@2772/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@2772/line-2",
          "start": 11,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5653500,
        "end": 5653566,
        "line": 210047,
        "column": 1,
        "path": "chap32/p@2772",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "BOATSWAIN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@2842",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MASTER.\nGood! Speak to the mariners: fall to ’t yarely, or we run ourselves aground: bestir, bestir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneI_32.1/p@2842/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneI_32.1/p@2842/line-2",
          "start": 8,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5653570,
        "end": 5653701,
        "line": 210052,
        "column": 1,
        "path": "chap32/p@2842",
        "anchor": "sceneI_32.1"
      },
      "speakerLabel": "MASTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-tempest/sceneI_32.1/p@2977",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
