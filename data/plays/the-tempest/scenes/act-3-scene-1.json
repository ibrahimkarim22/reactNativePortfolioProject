    {
      "id": "the-tempest/sceneIII_32.1/p@73976",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FERDINAND.\nNo, noble mistress; ’tis fresh morning with me\nWhen you are by at night. I do beseech you—\nChiefly that I might set it in my prayers—\nWhat is your name?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
