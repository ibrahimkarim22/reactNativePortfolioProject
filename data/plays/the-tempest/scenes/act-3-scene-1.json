      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MIRANDA.\nAnd mine, with my heart in ’t: and now farewell\nTill half an hour hence.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
