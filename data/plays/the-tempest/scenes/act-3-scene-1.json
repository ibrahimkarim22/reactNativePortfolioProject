          "end": 163,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5724704,
        "end": 5724912,
        "line": 212927,
        "column": 1,
        "path": "chap32/p@73976",
        "anchor": "sceneIII_32.1"
      },
      "speakerLabel": "FERDINAND.",
