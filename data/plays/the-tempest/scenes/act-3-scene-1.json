      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FERDINAND.\nMy mistress, dearest;\nAnd I thus humble ever.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
