      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FERDINAND.\nAy, with a heart as willing\nAs bondage e’er of freedom: here’s my hand.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
