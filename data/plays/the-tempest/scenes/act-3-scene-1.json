      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MIRANDA.\nIt would become me\nAs well as it does you: and I should do it\nWith much more ease; for my good will is to it,\nAnd yours it is against.",
      "separatorAfter": "\n\n",
      "spans": [],
