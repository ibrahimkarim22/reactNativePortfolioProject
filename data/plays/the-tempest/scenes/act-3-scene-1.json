    {
      "id": "the-tempest/sceneIII_32.1/p@72763",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MIRANDA.\nAlas now, pray you,\nWork not so hard: I would the lightning had\nBurnt up those logs that you are enjoin’d to pile!\nPray, set it down and rest you. When this burns,\n’Twill weep for having wearied you. My father\nIs hard at study; pray, now, rest yourself:\nHe’s safe for these three hours.",
      "separatorAfter": "\n\n",
      "spans": [],
