        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-tempest/sceneIII_32.1/p@74188",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MIRANDA.\nMiranda—O my father!\nI have broke your hest to say so.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneIII_32.1/p@74188/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneIII_32.1/p@74188/line-2",
          "start": 9,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "the-tempest/sceneIII_32.1/p@74188/line-3",
          "start": 30,
          "end": 63,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5724916,
        "end": 5725014,
        "line": 212935,
        "column": 1,
        "path": "chap32/p@74188",
        "anchor": "sceneIII_32.1"
      },
      "speakerLabel": "MIRANDA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-tempest/sceneIII_32.1/p@74290",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FERDINAND.\nAdmir’d Miranda!\nIndeed, the top of admiration; worth\nWhat’s dearest to the world! Full many a lady\nI have ey’d with best regard, and many a time\nTh’ harmony of their tongues hath into bondage\nBrought my too diligent ear: for several virtues\nHave I lik’d several women; never any\nWith so full soul but some defect in her\nDid quarrel with the noblest grace she ow’d,\nAnd put it to the foil: but you, O you,\nSo perfect and so peerless, are created\nOf every creature’s best.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-tempest/sceneIII_32.1/p@74290/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
