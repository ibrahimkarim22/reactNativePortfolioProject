      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Edward, Richard and Montague.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 21,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 26,
          "end": 34,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@24638/line-1",
          "start": 0,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489029,
        "end": 2489150,
        "line": 90926,
        "column": 1,
        "path": "chap14/p@24638",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@24763",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nBrother, though I be youngest, give me leave.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@24763/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@24763/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489154,
        "end": 2489238,
        "line": 90929,
        "column": 1,
        "path": "chap14/p@24763",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@24851",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDWARD.\nNo, I can better play the orator.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@24851/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@24851/line-2",
          "start": 8,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489242,
        "end": 2489313,
        "line": 90934,
        "column": 1,
        "path": "chap14/p@24851",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "EDWARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@24926",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MONTAGUE.\nBut I have reasons strong and forcible.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@24926/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@24926/line-2",
          "start": 10,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489317,
        "end": 2489396,
        "line": 90939,
        "column": 1,
        "path": "chap14/p@24926",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "MONTAGUE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25009",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter the Duke of York.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 10,
          "end": 22,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25009/line-1",
          "start": 0,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489400,
        "end": 2489478,
        "line": 90944,
        "column": 1,
        "path": "chap14/p@25009",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25091",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nWhy, how now, sons and brother, at a strife?\nWhat is your quarrel? How began it first?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25091/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25091/line-2",
          "start": 6,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25091/line-3",
          "start": 51,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489482,
        "end": 2489609,
        "line": 90946,
        "column": 1,
        "path": "chap14/p@25091",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25222",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDWARD.\nNo quarrel, but a slight contention.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25222/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25222/line-2",
          "start": 8,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489613,
        "end": 2489687,
        "line": 90952,
        "column": 1,
        "path": "chap14/p@25222",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "EDWARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25300",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nAbout what?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25300/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25300/line-2",
          "start": 6,
          "end": 17,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489691,
        "end": 2489738,
        "line": 90957,
        "column": 1,
        "path": "chap14/p@25300",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25351",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nAbout that which concerns your Grace and us:\nThe crown of England, father, which is yours.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25351/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25351/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25351/line-3",
          "start": 54,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489742,
        "end": 2489876,
        "line": 90962,
        "column": 1,
        "path": "chap14/p@25351",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25489",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nMine, boy? Not till King Henry be dead.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25489/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25489/line-2",
          "start": 6,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489880,
        "end": 2489955,
        "line": 90968,
        "column": 1,
        "path": "chap14/p@25489",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25568",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nYour right depends not on his life or death.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25568/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25568/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2489959,
        "end": 2490042,
        "line": 90973,
        "column": 1,
        "path": "chap14/p@25568",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25655",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDWARD.\nNow you are heir, therefore enjoy it now.\nBy giving the house of Lancaster leave to breathe,\nIt will outrun you, father, in the end.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25655/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25655/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25655/line-3",
          "start": 50,
          "end": 100,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25655/line-4",
          "start": 101,
          "end": 140,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2490046,
        "end": 2490226,
        "line": 90978,
        "column": 1,
        "path": "chap14/p@25655",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "EDWARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25839",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nI took an oath that he should quietly reign.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25839/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25839/line-2",
          "start": 6,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2490230,
        "end": 2490310,
        "line": 90985,
        "column": 1,
        "path": "chap14/p@25839",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25923",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDWARD.\nBut for a kingdom any oath may be broken.\nI would break a thousand oaths to reign one year.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25923/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25923/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@25923/line-3",
          "start": 50,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2490314,
        "end": 2490448,
        "line": 90990,
        "column": 1,
        "path": "chap14/p@25923",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "EDWARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@26061",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nNo; God forbid your Grace should be forsworn.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@26061/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@26061/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2490452,
        "end": 2490536,
        "line": 90996,
        "column": 1,
        "path": "chap14/p@26061",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@26149",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "YORK.\nI shall be, if I claim by open war.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@26149/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@26149/line-2",
          "start": 6,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2490540,
        "end": 2490611,
        "line": 91001,
        "column": 1,
        "path": "chap14/p@26149",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "YORK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@26224",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nI’ll prove the contrary if you’ll hear me speak.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@26224/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.2/p@26224/line-2",
          "start": 9,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2490615,
        "end": 2490702,
        "line": 91006,
        "column": 1,
        "path": "chap14/p@26224",
        "anchor": "sceneI_14.2"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
