      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nThe Queen, with all the northern earls and lords\nIntend here to besiege you in your castle.\nShe is hard by with twenty thousand men;\nAnd therefore fortify your hold, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
