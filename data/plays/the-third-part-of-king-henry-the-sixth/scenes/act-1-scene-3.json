    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30128",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLIFFORD.\nChaplain, away! Thy priesthood saves thy life.\nAs for the brat of this accursed duke\nWhose father slew my father, he shall die.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30128/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30128/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30128/line-3",
          "start": 57,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30128/line-4",
          "start": 95,
          "end": 137,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2494519,
        "end": 2494696,
        "line": 91141,
        "column": 1,
        "path": "chap14/p@30128",
        "anchor": "sceneI_14.3"
      },
      "speakerLabel": "CLIFFORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30309",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TUTOR.\nAnd I, my lord, will bear him company.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30309/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30309/line-2",
          "start": 7,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2494700,
        "end": 2494775,
        "line": 91148,
        "column": 1,
        "path": "chap14/p@30309",
        "anchor": "sceneI_14.3"
      },
      "speakerLabel": "TUTOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30388",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLIFFORD.\nSoldiers, away with him!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30388/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30388/line-2",
          "start": 10,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2494779,
        "end": 2494843,
        "line": 91153,
        "column": 1,
        "path": "chap14/p@30388",
        "anchor": "sceneI_14.3"
      },
      "speakerLabel": "CLIFFORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30456",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TUTOR.\nAh, Clifford, murder not this innocent child,\nLest thou be hated both of God and man.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30456/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30456/line-2",
          "start": 7,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30456/line-3",
          "start": 53,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2494847,
        "end": 2494974,
        "line": 91158,
        "column": 1,
        "path": "chap14/p@30456",
        "anchor": "sceneI_14.3"
      },
      "speakerLabel": "TUTOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30587",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit, dragged off by Soldiers.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 31
        }
      ],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30587/line-1",
          "start": 0,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2494978,
        "end": 2495038,
        "line": 91164,
        "column": 1,
        "path": "chap14/p@30587",
        "anchor": "sceneI_14.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30651",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLIFFORD.\nHow now? Is he dead already? Or is it fear\nThat makes him close his eyes? I’ll open them.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30651/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30651/line-2",
          "start": 10,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30651/line-3",
          "start": 53,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2495042,
        "end": 2495176,
        "line": 91166,
        "column": 1,
        "path": "chap14/p@30651",
        "anchor": "sceneI_14.3"
      },
      "speakerLabel": "CLIFFORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30789",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RUTLAND.\nSo looks the pent-up lion o’er the wretch\nThat trembles under his devouring paws;\nAnd so he walks, insulting o’er his prey,\nAnd so he comes to rend his limbs asunder.\nAh, gentle Clifford, kill me with thy sword,\nAnd not with such a cruel threat’ning look.\nSweet Clifford, hear me speak before I die.\nI am too mean a subject for thy wrath;\nBe thou revenged on men, and let me live.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30789/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30789/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30789/line-3",
          "start": 51,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30789/line-4",
          "start": 91,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30789/line-5",
          "start": 133,
          "end": 175,
          "sourceLineNumber": null
        },
        {
