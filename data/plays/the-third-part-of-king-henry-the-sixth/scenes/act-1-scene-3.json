        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31252",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLIFFORD.\nIn vain thou speak’st, poor boy; my father’s blood\nHath stopped the passage where thy words should enter.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31252/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31252/line-2",
          "start": 10,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31252/line-3",
          "start": 61,
          "end": 115,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2495643,
        "end": 2495793,
        "line": 91185,
        "column": 1,
        "path": "chap14/p@31252",
        "anchor": "sceneI_14.3"
      },
      "speakerLabel": "CLIFFORD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31406",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RUTLAND.\nThen let my father’s blood open it again;\nHe is a man, and, Clifford, cope with him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31406/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31406/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31406/line-3",
          "start": 51,
          "end": 93,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2495797,
        "end": 2495925,
        "line": 91191,
        "column": 1,
        "path": "chap14/p@31406",
        "anchor": "sceneI_14.3"
      },
      "speakerLabel": "RUTLAND.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31538",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLIFFORD.\nHad I thy brethren here, their lives and thine\nWere not revenge sufficient for me.\nNo, if I digged up thy forefathers’ graves\nAnd hung their rotten coffins up in chains,\nIt could not slake mine ire nor ease my heart.\nThe sight of any of the house of York\nIs as a fury to torment my soul;\nAnd till I root out their accursed line\nAnd leave not one alive, I live in hell.\nTherefore—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31538/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@31538/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        },
        {
