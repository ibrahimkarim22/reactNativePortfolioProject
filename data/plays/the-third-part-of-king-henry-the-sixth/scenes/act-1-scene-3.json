          "start": 176,
          "end": 220,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30789/line-7",
          "start": 221,
          "end": 264,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30789/line-8",
          "start": 265,
          "end": 308,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30789/line-9",
          "start": 309,
          "end": 347,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30789/line-10",
          "start": 348,
          "end": 389,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2495180,
        "end": 2495639,
        "line": 91172,
        "column": 1,
        "path": "chap14/p@30789",
