    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@30041",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Clifford and Soldiers.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
