    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@29903",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RUTLAND.\nAh, whither shall I fly to scape their hands?\nAh, tutor, look where bloody Clifford comes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@29903/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@29903/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneI_14.3/p@29903/line-3",
          "start": 55,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
