      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GEORGE.\nOur hap is loss, our hope but sad despair;\nOur ranks are broke and ruin follows us.\nWhat counsel give you? Whither shall we fly?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
