    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.3/p@68332",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nAh, Warwick, why hast thou withdrawn thyself?\nThy brother’s blood the thirsty earth hath drunk,\nBroached with the steely point of Clifford’s lance;\nAnd in the very pangs of death he cried,\nLike to a dismal clangor heard from far,\n“Warwick, revenge! Brother, revenge my death!”\nSo, underneath the belly of their steeds,\nThat stained their fetlocks in his smoking blood,\nThe noble gentleman gave up the ghost.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.3/p@68332/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
