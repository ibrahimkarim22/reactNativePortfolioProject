    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.3/p@68125",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EDWARD.\nBootless is flight, they follow us with wings;\nAnd weak we are and cannot shun pursuit.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.3/p@68125/line-1",
