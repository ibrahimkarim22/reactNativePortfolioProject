      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nNay, Warwick, single out some other chase;\nFor I myself will hunt this wolf to death.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
