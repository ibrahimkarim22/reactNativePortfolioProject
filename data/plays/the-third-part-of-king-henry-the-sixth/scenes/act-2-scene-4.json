    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.4/p@71115",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLIFFORD.\nNow, Richard, I am with thee here alone.\nThis is the hand that stabbed thy father York,\nAnd this the hand that slew thy brother Rutland;\nAnd here’s the heart that triumphs in their death\nAnd cheers these hands that slew thy sire and brother\nTo execute the like upon thyself;\nAnd so have at thee!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
