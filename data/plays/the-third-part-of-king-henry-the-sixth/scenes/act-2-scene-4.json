    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.4/p@70889",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nNow, Clifford, I have singled thee alone.\nSuppose this arm is for the Duke of York,\nAnd this for Rutland; both bound to revenge,\nWert thou environed with a brazen wall.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.4/p@70889/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.4/p@70889/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.4/p@70889/line-3",
          "start": 51,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.4/p@70889/line-4",
          "start": 93,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneII_14.4/p@70889/line-5",
          "start": 138,
          "end": 177,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
