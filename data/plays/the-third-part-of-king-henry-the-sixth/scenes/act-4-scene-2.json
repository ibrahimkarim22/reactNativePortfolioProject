    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.2/p@134225",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GEORGE.\nFear not that, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.2/p@134225/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.2/p@134225/line-2",
          "start": 8,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2598616,
        "end": 2598677,
        "line": 94668,
        "column": 1,
        "path": "chap14/p@134225",
        "anchor": "sceneIV_14.2"
      },
