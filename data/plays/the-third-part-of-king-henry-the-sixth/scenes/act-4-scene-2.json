  "scene": {
    "id": "the-third-part-of-king-henry-the-sixth-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. A Plain in Warwickshire",
    "location": "A Plain in Warwickshire",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-2-stage-001",
      "type": "stage",
      "text": "Enter Warwick and Oxford in England, with French Soldiers."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Trust me, my lord, all hitherto goes well;",
          "plainText": "Trust me my lord all hitherto goes well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The common people by numbers swarm to us.",
          "plainText": "The common people by numbers swarm to us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-2-stage-002",
      "type": "stage",
      "text": "Enter George (Duke of Clarence) and Somerset."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Fear not that, my lord.",
          "plainText": "Fear not that my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Then, gentle Clarence, welcome unto Warwick;",
          "plainText": "Then gentle Clarence welcome unto Warwick",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "And welcome, Somerset. I hold it cowardice",
          "plainText": "And welcome Somerset I hold it cowardice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "To rest mistrustful where a noble heart",
          "plainText": "To rest mistrustful where a noble heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "Hath pawned an open hand in sign of love;",
          "plainText": "Hath pawned an open hand in sign of love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "Else might I think that Clarence, Edward's brother,",
          "plainText": "Else might I think that Clarence Edward's brother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 6,
          "text": "Were but a feigned friend to our proceedings.",
          "plainText": "Were but a feigned friend to our proceedings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 7,
          "text": "But welcome, sweet Clarence; my daughter shall be thine.",
          "plainText": "But welcome sweet Clarence my daughter shall be thine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 8,
          "text": "And now what rests but, in night's coverture,",
          "plainText": "And now what rests but in night's coverture",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 9,
          "text": "Thy brother being carelessly encamped,",
          "plainText": "Thy brother being carelessly encamped",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 10,
          "text": "His soldiers lurking in the towns about,",
          "plainText": "His soldiers lurking in the towns about",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 11,
          "text": "And but attended by a simple guard,",
          "plainText": "And but attended by a simple guard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 12,
          "text": "We may surprise and take him at our pleasure?",
          "plainText": "We may surprise and take him at our pleasure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 13,
          "text": "Our scouts have found the adventure very easy;",
          "plainText": "Our scouts have found the adventure very easy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 14,
          "text": "That, as Ulysses and stout Diomede",
          "plainText": "That as Ulysses and stout Diomede",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 15,
          "text": "With sleight and manhood stole to Rhesus' tents,",
          "plainText": "With sleight and manhood stole to Rhesus' tents",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 16,
          "text": "And brought from thence the Thracian fatal steeds,",
          "plainText": "And brought from thence the Thracian fatal steeds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 17,
          "text": "So we, well covered with the night's black mantle,",
          "plainText": "So we well covered with the night's black mantle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 18,
          "text": "At unawares may beat down Edward's guard,",
          "plainText": "At unawares may beat down Edward's guard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 19,
          "text": "And seize himself. I say not, slaughter him,",
          "plainText": "And seize himself I say not slaughter him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 20,
          "text": "For I intend but only to surprise him.",
          "plainText": "For I intend but only to surprise him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 21,
          "text": "You that will follow me to this attempt,",
          "plainText": "You that will follow me to this attempt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 22,
          "text": "Applaud the name of Henry with your leader.",
          "plainText": "Applaud the name of Henry with your leader",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-2-stage-003",
      "type": "stage",
      "text": "[They all cry \"Henry!\"]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-2-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}