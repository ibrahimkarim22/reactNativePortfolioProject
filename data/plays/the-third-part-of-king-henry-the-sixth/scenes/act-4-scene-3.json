    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@139619",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "But Henry now shall wear the English crown\nAnd be true king indeed, thou but the shadow.\nMy lord of Somerset, at my request,\nSee that forthwith Duke Edward be conveyed\nUnto my brother, Archbishop of York.\nWhen I have fought with Pembroke and his fellows,\nI’ll follow you and tell what answer\nLewis and the Lady Bona send to him.\nNow, for a while farewell, good Duke of York.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@139619/line-1",
          "start": 0,
