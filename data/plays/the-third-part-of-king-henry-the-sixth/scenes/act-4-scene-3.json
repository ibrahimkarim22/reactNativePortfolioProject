    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@139105",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nYea, brother of Clarence, art thou here too?\nNay, then I see that Edward needs must down.\nYet, Warwick, in despite of all mischance\nOf thee thyself and all thy complices,\nEdward will always bear himself as king.\nThough Fortune’s malice overthrow my state,\nMy mind exceeds the compass of her wheel.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@139105/line-1",
