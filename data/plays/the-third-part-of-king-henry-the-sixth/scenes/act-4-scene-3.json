      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@135720",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter three Watchmen to guard the King’s tent.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 12,
          "end": 20,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@135720/line-1",
          "start": 0,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2600111,
        "end": 2600213,
        "line": 94710,
        "column": 1,
        "path": "chap14/p@135720",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@135826",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "1 WATCHMAN.\nCome on, my masters, each man take his stand.\nThe King by this is set him down to sleep.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@135826/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@135826/line-2",
          "start": 12,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@135826/line-3",
          "start": 58,
          "end": 100,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2600217,
        "end": 2600352,
        "line": 94713,
        "column": 1,
        "path": "chap14/p@135826",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "1 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@135965",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "2 WATCHMAN.\nWhat, will he not to bed?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@135965/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@135965/line-2",
          "start": 12,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2600356,
        "end": 2600423,
        "line": 94719,
        "column": 1,
        "path": "chap14/p@135965",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "2 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136036",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "1 WATCHMAN.\nWhy, no; for he hath made a solemn vow\nNever to lie and take his natural rest\nTill Warwick or himself be quite suppressed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136036/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136036/line-2",
          "start": 12,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136036/line-3",
          "start": 51,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136036/line-4",
          "start": 90,
          "end": 134,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2600427,
        "end": 2600601,
        "line": 94724,
        "column": 1,
        "path": "chap14/p@136036",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "1 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136214",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "2 WATCHMAN.\nTomorrow, then, belike shall be the day,\nIf Warwick be so near as men report.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136214/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136214/line-2",
          "start": 12,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136214/line-3",
          "start": 53,
          "end": 89,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2600605,
        "end": 2600729,
        "line": 94731,
        "column": 1,
        "path": "chap14/p@136214",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "2 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136342",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "3 WATCHMAN.\nBut say, I pray, what nobleman is that\nThat with the King here resteth in his tent?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136342/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136342/line-2",
          "start": 12,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136342/line-3",
          "start": 51,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2600733,
        "end": 2600863,
        "line": 94737,
        "column": 1,
        "path": "chap14/p@136342",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "3 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136476",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "1 WATCHMAN.\n’Tis the Lord Hastings, the King’s chiefest friend.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136476/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136476/line-2",
          "start": 12,
          "end": 63,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2600867,
        "end": 2600960,
        "line": 94743,
        "column": 1,
        "path": "chap14/p@136476",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "1 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136573",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "3 WATCHMAN.\nO, is it so? But why commands the King\nThat his chief followers lodge in towns about him,\nWhile he himself keeps in the cold field?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136573/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136573/line-2",
          "start": 12,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136573/line-3",
          "start": 51,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136573/line-4",
          "start": 102,
          "end": 143,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2600964,
        "end": 2601147,
        "line": 94748,
        "column": 1,
        "path": "chap14/p@136573",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "3 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136760",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "2 WATCHMAN.\n’Tis the more honour, because more dangerous.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136760/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136760/line-2",
          "start": 12,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2601151,
        "end": 2601238,
        "line": 94755,
        "column": 1,
        "path": "chap14/p@136760",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "2 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136851",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "3 WATCHMAN.\nAy, but give me worship and quietness;\nI like it better than dangerous honour.\nIf Warwick knew in what estate he stands,\n’Tis to be doubted he would waken him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136851/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136851/line-2",
          "start": 12,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136851/line-3",
          "start": 51,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136851/line-4",
          "start": 91,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@136851/line-5",
          "start": 133,
          "end": 171,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2601242,
        "end": 2601458,
        "line": 94760,
        "column": 1,
        "path": "chap14/p@136851",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "3 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137071",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "1 WATCHMAN.\nUnless our halberds did shut up his passage.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137071/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137071/line-2",
          "start": 12,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2601462,
        "end": 2601548,
        "line": 94768,
        "column": 1,
        "path": "chap14/p@137071",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "1 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137161",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "2 WATCHMAN.\nAy, wherefore else guard we his royal tent\nBut to defend his person from night-foes?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137161/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137161/line-2",
          "start": 12,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137161/line-3",
          "start": 55,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2601552,
        "end": 2601683,
        "line": 94773,
        "column": 1,
        "path": "chap14/p@137161",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "2 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137296",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Warwick, George (Duke of Clarence), Oxford, Somerset and French Soldiers, silent all.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 58,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137296/line-1",
          "start": 0,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2601687,
        "end": 2601834,
        "line": 94779,
        "column": 1,
        "path": "chap14/p@137296",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137447",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nThis is his tent; and see where stand his guard.\nCourage, my masters! Honour now or never!\nBut follow me, and Edward shall be ours.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137447/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137447/line-2",
          "start": 9,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137447/line-3",
          "start": 58,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137447/line-4",
          "start": 100,
          "end": 140,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2601838,
        "end": 2602018,
        "line": 94782,
        "column": 1,
        "path": "chap14/p@137447",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "WARWICK.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137631",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "1 WATCHMAN.\nWho goes there?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137631/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@137631/line-2",
          "start": 12,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2602022,
        "end": 2602079,
        "line": 94789,
        "column": 1,
        "path": "chap14/p@137631",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "1 WATCHMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
