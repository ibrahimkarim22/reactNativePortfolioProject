      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Takes off his crown.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 21
        }
      ],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@139565/line-1",
          "start": 0,
          "end": 22,
