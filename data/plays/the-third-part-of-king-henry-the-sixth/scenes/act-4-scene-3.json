      "text": "SCENE III. Edward’s Camp near Warwick",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "b",
          "start": 0,
          "end": 37
        }
      ],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/h3@135637/line-1",
          "start": 0,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2600028,
        "end": 2600107,
        "line": 94708,
        "column": 1,
