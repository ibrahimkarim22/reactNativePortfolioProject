      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nRichard and Hastings.\nLet them go. Here is the Duke.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@138417/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@138417/line-2",
          "start": 9,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@138417/line-3",
          "start": 31,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
