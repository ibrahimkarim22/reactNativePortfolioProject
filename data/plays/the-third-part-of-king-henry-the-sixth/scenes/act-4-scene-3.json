    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@140412",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OXFORD.\nWhat now remains, my lords, for us to do,\nBut march to London with our soldiers?",
      "separatorAfter": "\n\n",
      "spans": [],
