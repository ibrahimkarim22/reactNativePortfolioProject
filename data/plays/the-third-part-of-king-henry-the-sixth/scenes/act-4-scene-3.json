      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[They begin to lead him out forcibly.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 37
        }
      ],
      "lines": [
        {
