    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@138517",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nThe Duke? Why, Warwick, when we parted,\nThou call’dst me king?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@138517/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@138517/line-2",
          "start": 13,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@138517/line-3",
          "start": 53,
          "end": 75,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2602908,
        "end": 2603018,
        "line": 94822,
        "column": 1,
        "path": "chap14/p@138517",
        "anchor": "sceneIV_14.3"
      },
      "speakerLabel": "KING EDWARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@138631",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nAy, but the case is altered.\nWhen you disgraced me in my embassade,\nThen I degraded you from being king,\nAnd come now to create you Duke of York.\nAlas, how should you govern any kingdom\nThat know not how to use ambassadors,\nNor how to be contented with one wife,\nNor how to use your brothers brotherly,\nNor how to study for the people’s welfare,\nNor how to shroud yourself from enemies?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@138631/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
