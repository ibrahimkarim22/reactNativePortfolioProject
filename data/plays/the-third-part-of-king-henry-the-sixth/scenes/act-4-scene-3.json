    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@140132",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nWhat fates impose, that men must needs abide;\nIt boots not to resist both wind and tide.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.3/p@140132/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
