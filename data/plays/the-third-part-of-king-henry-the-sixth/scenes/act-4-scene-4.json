        "status": "not-applicable"
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@140953",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RIVERS.\nMadam, what makes you in this sudden change?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@140953/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@140953/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2605344,
        "end": 2605426,
        "line": 94903,
        "column": 1,
        "path": "chap14/p@140953",
        "anchor": "sceneIV_14.4"
      },
      "speakerLabel": "RIVERS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141039",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN ELIZABETH.\nWhy, brother Rivers, are you yet to learn\nWhat late misfortune is befall’n King Edward?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141039/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141039/line-2",
          "start": 17,
          "end": 58,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141039/line-3",
          "start": 59,
          "end": 104,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2605430,
        "end": 2605569,
        "line": 94908,
        "column": 1,
        "path": "chap14/p@141039",
        "anchor": "sceneIV_14.4"
      },
      "speakerLabel": "QUEEN ELIZABETH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141182",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RIVERS.\nWhat, loss of some pitched battle against Warwick?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141182/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141182/line-2",
          "start": 8,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2605573,
        "end": 2605661,
        "line": 94914,
        "column": 1,
        "path": "chap14/p@141182",
        "anchor": "sceneIV_14.4"
      },
      "speakerLabel": "RIVERS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141274",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN ELIZABETH.\nNo, but the loss of his own royal person.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141274/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141274/line-2",
          "start": 17,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2605665,
        "end": 2605753,
        "line": 94919,
        "column": 1,
        "path": "chap14/p@141274",
        "anchor": "sceneIV_14.4"
      },
      "speakerLabel": "QUEEN ELIZABETH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141366",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RIVERS.\nThen is my sovereign slain?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141366/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141366/line-2",
          "start": 8,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2605757,
        "end": 2605822,
        "line": 94924,
        "column": 1,
        "path": "chap14/p@141366",
        "anchor": "sceneIV_14.4"
      },
      "speakerLabel": "RIVERS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141435",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN ELIZABETH.\nAy, almost slain, for he is taken prisoner,\nEither betrayed by falsehood of his guard\nOr by his foe surprised at unawares;\nAnd, as I further have to understand,\nIs new committed to the Bishop of York,\nFell Warwick’s brother and by that our foe.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141435/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141435/line-2",
          "start": 17,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141435/line-3",
          "start": 61,
          "end": 102,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141435/line-4",
          "start": 103,
          "end": 139,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141435/line-5",
          "start": 140,
          "end": 177,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141435/line-6",
          "start": 178,
          "end": 217,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141435/line-7",
          "start": 218,
          "end": 261,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2605826,
        "end": 2606142,
        "line": 94929,
        "column": 1,
        "path": "chap14/p@141435",
        "anchor": "sceneIV_14.4"
      },
      "speakerLabel": "QUEEN ELIZABETH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141755",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RIVERS.\nThese news, I must confess, are full of grief;\nYet, gracious madam, bear it as you may.\nWarwick may lose that now hath won the day.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141755/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141755/line-2",
          "start": 8,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141755/line-3",
          "start": 55,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141755/line-4",
          "start": 96,
          "end": 139,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2606146,
        "end": 2606325,
        "line": 94939,
        "column": 1,
        "path": "chap14/p@141755",
        "anchor": "sceneIV_14.4"
      },
      "speakerLabel": "RIVERS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN ELIZABETH.\nTill then, fair hope must hinder life’s decay;\nAnd I the rather wean me from despair\nFor love of Edward’s offspring in my womb.\nThis is it that makes me bridle passion\nAnd bear with mildness my misfortune’s cross,\nAy, ay, for this I draw in many a tear\nAnd stop the rising of blood-sucking sighs,\nLest with my sighs or tears I blast or drown\nKing Edward’s fruit, true heir to th’ English crown.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938/line-2",
          "start": 17,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938/line-3",
          "start": 64,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938/line-4",
          "start": 102,
          "end": 144,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938/line-5",
          "start": 145,
          "end": 184,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938/line-6",
          "start": 185,
          "end": 230,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938/line-7",
          "start": 231,
          "end": 269,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938/line-8",
          "start": 270,
          "end": 313,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938/line-9",
          "start": 314,
          "end": 358,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@141938/line-10",
          "start": 359,
          "end": 411,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2606329,
        "end": 2606810,
        "line": 94946,
        "column": 1,
        "path": "chap14/p@141938",
        "anchor": "sceneIV_14.4"
      },
      "speakerLabel": "QUEEN ELIZABETH.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@142423",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RIVERS.\nBut, madam, where is Warwick then become?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@142423/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@142423/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2606814,
        "end": 2606893,
        "line": 94959,
        "column": 1,
        "path": "chap14/p@142423",
        "anchor": "sceneIV_14.4"
      },
      "speakerLabel": "RIVERS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@142506",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN ELIZABETH.\nI am informed that he comes towards London\nTo set the crown once more on Henry’s head.\nGuess thou the rest: King Edward’s friends must down.\nBut to prevent the tyrant’s violence—\nFor trust not him that hath once broken faith—\nI’ll hence forthwith unto the sanctuary\nTo save at least the heir of Edward’s right.\nThere shall I rest secure from force and fraud.\nCome, therefore, let us fly while we may fly.\nIf Warwick take us, we are sure to die.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@142506/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.4/p@142506/line-2",
          "start": 17,
          "end": 59,
          "sourceLineNumber": null
        },
