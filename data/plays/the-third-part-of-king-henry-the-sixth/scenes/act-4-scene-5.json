      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144111",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUNTSMAN.\nThis way, my lord, for this way lies the game.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144111/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144111/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2608502,
        "end": 2608588,
        "line": 95005,
        "column": 1,
        "path": "chap14/p@144111",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "HUNTSMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144201",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nNay, this way, man. See where the huntsmen stand.\nNow, brother of Gloucester, Lord Hastings, and the rest,\nStand you thus close to steal the Bishop’s deer?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144201/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144201/line-2",
          "start": 13,
          "end": 62,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144201/line-3",
          "start": 63,
          "end": 119,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144201/line-4",
          "start": 120,
          "end": 168,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2608592,
        "end": 2608800,
        "line": 95010,
        "column": 1,
        "path": "chap14/p@144201",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "KING EDWARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144413",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nBrother, the time and case requireth haste;\nYour horse stands ready at the park corner.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144413/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144413/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144413/line-3",
          "start": 53,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2608804,
        "end": 2608935,
        "line": 95017,
        "column": 1,
        "path": "chap14/p@144413",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144548",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nBut whither shall we then?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144548/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144548/line-2",
          "start": 13,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2608939,
        "end": 2609008,
        "line": 95023,
        "column": 1,
        "path": "chap14/p@144548",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "KING EDWARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144621",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HASTINGS.\nTo Lynn, my lord, and shipped from thence to Flanders.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144621/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144621/line-2",
          "start": 10,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2609012,
        "end": 2609106,
        "line": 95028,
        "column": 1,
        "path": "chap14/p@144621",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "HASTINGS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144719",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nWell guessed, believe me, for that was my meaning.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144719/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144719/line-2",
          "start": 9,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2609110,
        "end": 2609199,
        "line": 95033,
        "column": 1,
        "path": "chap14/p@144719",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144812",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nStanley, I will requite thy forwardness.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144812/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144812/line-2",
          "start": 13,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2609203,
        "end": 2609286,
        "line": 95038,
        "column": 1,
        "path": "chap14/p@144812",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "KING EDWARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144899",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nBut wherefore stay we? ’Tis no time to talk.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144899/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144899/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2609290,
        "end": 2609373,
        "line": 95043,
        "column": 1,
        "path": "chap14/p@144899",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144986",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nHuntsman, what sayst thou? Wilt thou go along?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144986/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@144986/line-2",
          "start": 13,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2609377,
        "end": 2609466,
        "line": 95048,
        "column": 1,
        "path": "chap14/p@144986",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "KING EDWARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@145079",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HUNTSMAN.\nBetter do so than tarry and be hanged.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@145079/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@145079/line-2",
          "start": 10,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2609470,
        "end": 2609548,
        "line": 95053,
        "column": 1,
        "path": "chap14/p@145079",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "HUNTSMAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@145161",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nCome then, away! Let’s ha’ no more ado.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@145161/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@145161/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2609552,
        "end": 2609630,
        "line": 95058,
        "column": 1,
        "path": "chap14/p@145161",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@145243",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nBishop, farewell; shield thee from Warwick’s frown,\nAnd pray that I may repossess the crown.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@145243/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
