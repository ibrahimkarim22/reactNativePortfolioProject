    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@143979",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter King Edward and a Huntsman with him.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 17,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 24,
          "end": 32,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.5/p@143979/line-1",
          "start": 0,
          "end": 42,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2608370,
        "end": 2608498,
        "line": 95002,
        "column": 1,
        "path": "chap14/p@143979",
        "anchor": "sceneIV_14.5"
      },
      "speakerLabel": null,
