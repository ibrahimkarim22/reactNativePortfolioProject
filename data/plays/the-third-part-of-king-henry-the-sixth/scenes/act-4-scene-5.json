      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Richard (Duke of Gloucester), Lord Hastings, Sir William Stanley and others.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 70,
          "className": "charname"
        }
      ],
