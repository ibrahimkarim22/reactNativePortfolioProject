      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GEORGE.\nA little fire is quickly trodden out,\nWhich, being suffered, rivers cannot quench.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.8/p@158903/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.8/p@158903/line-2",
          "start": 8,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.8/p@158903/line-3",
          "start": 46,
          "end": 90,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2623294,
        "end": 2623419,
        "line": 95557,
        "column": 1,
        "path": "chap14/p@158903",
