      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EXETER.\nThe doubt is that he will seduce the rest.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.8/p@160877/line-1",
