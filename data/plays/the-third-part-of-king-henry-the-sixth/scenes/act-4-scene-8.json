    "location": "London. The Palace",
    "orderInPlay": 21
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-stage-001",
      "type": "stage",
      "text": "Flourish. Enter King Henry, Warwick, Montague, George (Duke of Clarence), Oxford and Exeter."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-001",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "What counsel, lords? Edward from Belgia,",
          "plainText": "What counsel lords Edward from Belgia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "With hasty Germans and blunt Hollanders,",
          "plainText": "With hasty Germans and blunt Hollanders",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Hath passed in safety through the Narrow Seas,",
          "plainText": "Hath passed in safety through the Narrow Seas",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And with his troops doth march amain to London;",
          "plainText": "And with his troops doth march amain to London",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "And many giddy people flock to him.",
          "plainText": "And many giddy people flock to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-002",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Let's levy men and beat him back again.",
          "plainText": "Let's levy men and beat him back again",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-003",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "A little fire is quickly trodden out,",
          "plainText": "A little fire is quickly trodden out",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Which, being suffered, rivers cannot quench.",
          "plainText": "Which being suffered rivers cannot quench",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-004",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "In Warwickshire I have true-hearted friends,",
          "plainText": "In Warwickshire I have truehearted friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Not mutinous in peace, yet bold in war.",
          "plainText": "Not mutinous in peace yet bold in war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Those will I muster up; and thou, son Clarence,",
          "plainText": "Those will I muster up and thou son Clarence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "Shalt stir up in Suffolk, Norfolk, and in Kent",
          "plainText": "Shalt stir up in Suffolk Norfolk and in Kent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "The knights and gentlemen to come with thee.",
          "plainText": "The knights and gentlemen to come with thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0014",
          "number": 14,
          "speechLineNumber": 6,
          "text": "Thou, brother Montague, in Buckingham,",
          "plainText": "Thou brother Montague in Buckingham",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0015",
          "number": 15,
          "speechLineNumber": 7,
          "text": "Northampton, and in Leicestershire shalt find",
          "plainText": "Northampton and in Leicestershire shalt find",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0016",
          "number": 16,
          "speechLineNumber": 8,
          "text": "Men well inclined to hear what thou command'st.",
          "plainText": "Men well inclined to hear what thou command'st",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0017",
          "number": 17,
          "speechLineNumber": 9,
          "text": "And thou, brave Oxford, wondrous well beloved,",
          "plainText": "And thou brave Oxford wondrous well beloved",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0018",
          "number": 18,
          "speechLineNumber": 10,
          "text": "In Oxfordshire shalt muster up thy friends.",
          "plainText": "In Oxfordshire shalt muster up thy friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0019",
          "number": 19,
          "speechLineNumber": 11,
          "text": "My sovereign, with the loving citizens,",
          "plainText": "My sovereign with the loving citizens",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0020",
          "number": 20,
          "speechLineNumber": 12,
          "text": "Like to his island girt in with the ocean,",
          "plainText": "Like to his island girt in with the ocean",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0021",
          "number": 21,
          "speechLineNumber": 13,
          "text": "Or modest Dian circled with her nymphs,",
          "plainText": "Or modest Dian circled with her nymphs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0022",
          "number": 22,
          "speechLineNumber": 14,
          "text": "Shall rest in London till we come to him.",
          "plainText": "Shall rest in London till we come to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0023",
          "number": 23,
          "speechLineNumber": 15,
          "text": "Fair lords, take leave and stand not to reply.",
          "plainText": "Fair lords take leave and stand not to reply",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0024",
          "number": 24,
          "speechLineNumber": 16,
          "text": "Farewell, my sovereign.",
          "plainText": "Farewell my sovereign",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-005",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Farewell, my Hector, and my Troy's true hope.",
          "plainText": "Farewell my Hector and my Troy's true hope",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-006",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "In sign of truth, I kiss your Highness' hand.",
          "plainText": "In sign of truth I kiss your Highness' hand",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-007",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Well-minded Clarence, be thou fortunate.",
          "plainText": "Wellminded Clarence be thou fortunate",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-008",
      "type": "speech",
      "speaker": {
        "id": "montague",
        "name": "MONTAGUE",
        "displayName": "Montague"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Comfort, my lord; and so I take my leave.",
          "plainText": "Comfort my lord and so I take my leave",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-009",
      "type": "speech",
      "speaker": {
        "id": "oxford",
        "name": "OXFORD",
        "displayName": "Oxford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "And thus [kissing Henry's hand] I seal my truth, and bid adieu.",
          "plainText": "And thus kissing Henry's hand I seal my truth and bid adieu",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-010",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Sweet Oxford, and my loving Montague,",
          "plainText": "Sweet Oxford and my loving Montague",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "And all at once, once more a happy farewell.",
          "plainText": "And all at once once more a happy farewell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-011",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Farewell, sweet lords; let's meet at Coventry.",
          "plainText": "Farewell sweet lords let's meet at Coventry",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-stage-002",
      "type": "stage",
      "text": "[Exeunt all but King Henry and Exeter.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-012",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Here at the palace will I rest a while.",
          "plainText": "Here at the palace will I rest a while",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Cousin of Exeter, what thinks your lordship?",
          "plainText": "Cousin of Exeter what thinks your lordship",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Methinks the power that Edward hath in field",
          "plainText": "Methinks the power that Edward hath in field",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "Should not be able to encounter mine.",
          "plainText": "Should not be able to encounter mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-013",
      "type": "speech",
      "speaker": {
        "id": "exeter",
        "name": "EXETER",
        "displayName": "Exeter"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "The doubt is that he will seduce the rest.",
          "plainText": "The doubt is that he will seduce the rest",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-014",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "That's not my fear; my meed hath got me fame.",
          "plainText": "That's not my fear my meed hath got me fame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "I have not stopped mine ears to their demands,",
          "plainText": "I have not stopped mine ears to their demands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "Nor posted off their suits with slow delays;",
          "plainText": "Nor posted off their suits with slow delays",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0041",
          "number": 41,
          "speechLineNumber": 4,
          "text": "My pity hath been balm to heal their wounds,",
          "plainText": "My pity hath been balm to heal their wounds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0042",
          "number": 42,
          "speechLineNumber": 5,
          "text": "My mildness hath allayed their swelling griefs,",
          "plainText": "My mildness hath allayed their swelling griefs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0043",
          "number": 43,
          "speechLineNumber": 6,
          "text": "My mercy dried their water-flowing tears.",
          "plainText": "My mercy dried their waterflowing tears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0044",
          "number": 44,
          "speechLineNumber": 7,
          "text": "I have not been desirous of their wealth",
          "plainText": "I have not been desirous of their wealth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0045",
          "number": 45,
          "speechLineNumber": 8,
          "text": "Nor much oppressed them with great subsidies,",
          "plainText": "Nor much oppressed them with great subsidies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0046",
          "number": 46,
          "speechLineNumber": 9,
          "text": "Nor forward of revenge, though they much erred.",
          "plainText": "Nor forward of revenge though they much erred",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0047",
          "number": 47,
          "speechLineNumber": 10,
          "text": "Then why should they love Edward more than me?",
          "plainText": "Then why should they love Edward more than me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0048",
          "number": 48,
          "speechLineNumber": 11,
          "text": "No, Exeter, these graces challenge grace;",
          "plainText": "No Exeter these graces challenge grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0049",
          "number": 49,
          "speechLineNumber": 12,
          "text": "And when the lion fawns upon the lamb,",
          "plainText": "And when the lion fawns upon the lamb",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0050",
          "number": 50,
          "speechLineNumber": 13,
          "text": "The lamb will never cease to follow him.",
          "plainText": "The lamb will never cease to follow him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-stage-003",
      "type": "stage",
      "text": "[Shout within \"A York! A York!\"]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-015",
      "type": "speech",
      "speaker": {
        "id": "exeter",
        "name": "EXETER",
        "displayName": "Exeter"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Hark, hark, my lord, what shouts are these?",
          "plainText": "Hark hark my lord what shouts are these",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-stage-004",
      "type": "stage",
      "text": "Enter King Edward, Richard (Duke of Gloucester) and Soldiers."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-016",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Seize on the shame-faced Henry, bear him hence,",
          "plainText": "Seize on the shamefaced Henry bear him hence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "And once again proclaim us King of England.",
          "plainText": "And once again proclaim us King of England",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "You are the fount that makes small brooks to flow.",
          "plainText": "You are the fount that makes small brooks to flow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0055",
          "number": 55,
          "speechLineNumber": 4,
          "text": "Now stops thy spring; my sea shall suck them dry",
          "plainText": "Now stops thy spring my sea shall suck them dry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0056",
          "number": 56,
          "speechLineNumber": 5,
          "text": "And swell so much the higher by their ebb.",
          "plainText": "And swell so much the higher by their ebb",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0057",
          "number": 57,
          "speechLineNumber": 6,
          "text": "Hence with him to the Tower. Let him not speak.",
          "plainText": "Hence with him to the Tower Let him not speak",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-stage-005",
      "type": "stage",
      "text": "[Exeunt some with King Henry.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-speech-017",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Away betimes, before his forces join,",
          "plainText": "Away betimes before his forces join",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "And take the great-grown traitor unawares.",
          "plainText": "And take the greatgrown traitor unawares",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-8-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "Brave warriors, march amain towards Coventry.",
          "plainText": "Brave warriors march amain towards Coventry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-8-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
