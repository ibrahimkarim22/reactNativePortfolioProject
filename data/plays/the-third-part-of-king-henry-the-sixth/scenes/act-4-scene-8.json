    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.8/p@158543",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nWhat counsel, lords? Edward from Belgia,\nWith hasty Germans and blunt Hollanders,\nHath passed in safety through the Narrow Seas,\nAnd with his troops doth march amain to London;\nAnd many giddy people flock to him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
