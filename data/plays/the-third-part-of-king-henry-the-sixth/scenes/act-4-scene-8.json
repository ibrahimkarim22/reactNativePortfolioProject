    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneIV_14.8/p@161913",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nSeize on the shame-faced Henry, bear him hence,\nAnd once again proclaim us King of England.\nYou are the fount that makes small brooks to flow.\nNow stops thy spring; my sea shall suck them dry\nAnd swell so much the higher by their ebb.\nHence with him to the Tower. Let him not speak.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
