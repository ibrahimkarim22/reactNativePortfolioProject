    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.2/p@173667",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nWhy, then I would not fly. Ah, Montague!\nIf thou be there, sweet brother, take my hand\nAnd with thy lips keep in my soul awhile.\nThou lov’st me not; for, brother, if thou didst,\nThy tears would wash this cold congealed blood\nThat glues my lips and will not let me speak.\nCome quickly, Montague, or I am dead.",
      "separatorAfter": "\n\n",
      "spans": [],
