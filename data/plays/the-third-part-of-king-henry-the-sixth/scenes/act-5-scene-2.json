    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.2/p@171803",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nSo, lie thou there. Die thou, and die our fear,\nFor Warwick was a bug that feared us all.\nNow, Montague, sit fast; I seek for thee,\nThat Warwick’s bones may keep thine company.",
