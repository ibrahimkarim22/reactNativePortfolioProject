      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WARWICK.\nSweet rest his soul! Fly, lords, and save yourselves,\nFor Warwick bids you all farewell, to meet in heaven.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.2/p@174463/line-1",
