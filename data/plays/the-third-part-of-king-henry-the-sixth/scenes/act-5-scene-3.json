    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.3/p@176001",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nWe are advertised by our loving friends\nThat they do hold their course toward Tewkesbury.\nWe, having now the best at Barnet field,\nWill thither straight, for willingness rids way;\nAnd, as we march, our strength will be augmented\nIn every county as we go along.\nStrike up the drum! cry “Courage!” and away.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
