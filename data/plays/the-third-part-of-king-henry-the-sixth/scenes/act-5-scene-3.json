  "scene": {
    "id": "the-third-part-of-king-henry-the-sixth-5-3",
    "act": 5,
    "scene": 3,
    "label": "Act 5, Scene 3",
    "title": "SCENE III. Another Part of the Field",
    "location": "Another Part of the Field",
    "orderInPlay": 24
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-3-stage-001",
      "type": "stage",
      "text": "Flourish. Enter King Edward in triumph, with Richard, George and the rest."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Thus far our fortune keeps an upward course,",
          "plainText": "Thus far our fortune keeps an upward course",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And we are graced with wreaths of victory.",
          "plainText": "And we are graced with wreaths of victory",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "But in the midst of this bright-shining day,",
          "plainText": "But in the midst of this brightshining day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "I spy a black, suspicious, threat'ning cloud",
          "plainText": "I spy a black suspicious threat'ning cloud",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "That will encounter with our glorious sun",
          "plainText": "That will encounter with our glorious sun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Ere he attain his easeful western bed.",
          "plainText": "Ere he attain his easeful western bed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "I mean, my lords, those powers that the Queen",
          "plainText": "I mean my lords those powers that the Queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Hath raised in Gallia have arrived our coast",
          "plainText": "Hath raised in Gallia have arrived our coast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "And, as we hear, march on to fight with us.",
          "plainText": "And as we hear march on to fight with us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "A little gale will soon disperse that cloud",
          "plainText": "A little gale will soon disperse that cloud",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "And blow it to the source from whence it came;",
          "plainText": "And blow it to the source from whence it came",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "Thy very beams will dry those vapours up,",
          "plainText": "Thy very beams will dry those vapours up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "For every cloud engenders not a storm.",
          "plainText": "For every cloud engenders not a storm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "The Queen is valued thirty thousand strong,",
          "plainText": "The Queen is valued thirty thousand strong",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "And Somerset, with Oxford, fled to her.",
          "plainText": "And Somerset with Oxford fled to her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "If she have time to breathe, be well assured",
          "plainText": "If she have time to breathe be well assured",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "Her faction will be full as strong as ours.",
          "plainText": "Her faction will be full as strong as ours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "We are advertised by our loving friends",
          "plainText": "We are advertised by our loving friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "That they do hold their course toward Tewkesbury.",
          "plainText": "That they do hold their course toward Tewkesbury",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "We, having now the best at Barnet field,",
          "plainText": "We having now the best at Barnet field",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "Will thither straight, for willingness rids way;",
          "plainText": "Will thither straight for willingness rids way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0022",
          "number": 22,
          "speechLineNumber": 5,
          "text": "And, as we march, our strength will be augmented",
          "plainText": "And as we march our strength will be augmented",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0023",
          "number": 23,
          "speechLineNumber": 6,
          "text": "In every county as we go along.",
          "plainText": "In every county as we go along",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-3-line-0024",
          "number": 24,
          "speechLineNumber": 7,
          "text": "Strike up the drum! cry \"Courage!\" and away.",
          "plainText": "Strike up the drum cry Courage and away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}