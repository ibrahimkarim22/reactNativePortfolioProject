    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.3/p@175543",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GEORGE.\nA little gale will soon disperse that cloud\nAnd blow it to the source from whence it came;\nThy very beams will dry those vapours up,\nFor every cloud engenders not a storm.",
      "separatorAfter": "\n\n",
      "spans": [],
