    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.4/p@179125",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OXFORD.\nWomen and children of so high a courage,\nAnd warriors faint! Why, ’twere perpetual shame.\nO, brave young Prince, thy famous grandfather\nDoth live again in thee. Long mayst thou live\nTo bear his image and renew his glories!",
      "separatorAfter": "\n\n",
      "spans": [],
