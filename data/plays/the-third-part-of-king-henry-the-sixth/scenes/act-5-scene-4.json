    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.4/p@180507",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nBrave followers, yonder stands the thorny wood\nWhich by the heaven’s assistance and your strength\nMust by the roots be hewn up yet ere night.\nI need not add more fuel to your fire,\nFor, well I wot, ye blaze to burn them out.\nGive signal to the fight, and to it, lords!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.4/p@180507/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
