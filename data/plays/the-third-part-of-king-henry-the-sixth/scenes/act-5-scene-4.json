      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "OXFORD.\nI thought no less. It is his policy\nTo haste thus fast, to find us unprovided.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.4/p@179986/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
