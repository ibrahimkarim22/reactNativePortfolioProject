    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.4/p@179856",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nPrepare you, lords, for Edward is at hand\nReady to fight; therefore be resolute.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.4/p@179856/line-1",
