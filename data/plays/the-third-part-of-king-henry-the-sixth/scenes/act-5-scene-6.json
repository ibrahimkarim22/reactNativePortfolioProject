  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-stage-001",
      "type": "stage",
      "text": "Enter King Henry and Richard, with the Lieutenant on the walls."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Good day, my lord. What, at your book so hard?",
          "plainText": "Good day my lord What at your book so hard",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Ay, my good lord—my lord, I should say rather.",
          "plainText": "Ay my good lordmy lord I should say rather",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "'Tis sin to flatter; \"good\" was little better:",
          "plainText": "'Tis sin to flatter good was little better",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "\"Good Gloucester\" and \"good devil\" were alike,",
          "plainText": "Good Gloucester and good devil were alike",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "And both preposterous; therefore, not \"good lord\".",
          "plainText": "And both preposterous therefore not good lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Sirrah, leave us to ourselves; we must confer.",
          "plainText": "Sirrah leave us to ourselves we must confer",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-stage-002",
      "type": "stage",
      "text": "[Exit Lieutenant.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "So flies the reckless shepherd from the wolf;",
          "plainText": "So flies the reckless shepherd from the wolf",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "So first the harmless sheep doth yield his fleece,",
          "plainText": "So first the harmless sheep doth yield his fleece",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "And next his throat unto the butcher's knife.",
          "plainText": "And next his throat unto the butcher's knife",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "What scene of death hath Roscius now to act?",
          "plainText": "What scene of death hath Roscius now to act",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Suspicion always haunts the guilty mind;",
          "plainText": "Suspicion always haunts the guilty mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "The thief doth fear each bush an officer.",
          "plainText": "The thief doth fear each bush an officer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "The bird that hath been limed in a bush",
          "plainText": "The bird that hath been limed in a bush",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "With trembling wings misdoubteth every bush;",
          "plainText": "With trembling wings misdoubteth every bush",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "And I, the hapless male to one sweet bird,",
          "plainText": "And I the hapless male to one sweet bird",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "Have now the fatal object in my eye",
          "plainText": "Have now the fatal object in my eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0017",
          "number": 17,
          "speechLineNumber": 5,
          "text": "Where my poor young was limed, was caught, and killed.",
          "plainText": "Where my poor young was limed was caught and killed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-007",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Why, what a peevish fool was that of Crete",
          "plainText": "Why what a peevish fool was that of Crete",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "That taught his son the office of a fowl!",
          "plainText": "That taught his son the office of a fowl",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "And yet, for all his wings, the fool was drowned.",
          "plainText": "And yet for all his wings the fool was drowned",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-008",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "I, Daedalus; my poor boy, Icarus;",
          "plainText": "I Daedalus my poor boy Icarus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "Thy father, Minos, that denied our course;",
          "plainText": "Thy father Minos that denied our course",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "The sun that seared the wings of my sweet boy,",
          "plainText": "The sun that seared the wings of my sweet boy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "Thy brother Edward; and thyself, the sea",
          "plainText": "Thy brother Edward and thyself the sea",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "Whose envious gulf did swallow up his life.",
          "plainText": "Whose envious gulf did swallow up his life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0026",
          "number": 26,
          "speechLineNumber": 6,
          "text": "Ah, kill me with thy weapon, not with words!",
          "plainText": "Ah kill me with thy weapon not with words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0027",
          "number": 27,
          "speechLineNumber": 7,
          "text": "My breast can better brook thy dagger's point",
          "plainText": "My breast can better brook thy dagger's point",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0028",
          "number": 28,
          "speechLineNumber": 8,
          "text": "Than can my ears that tragic history.",
          "plainText": "Than can my ears that tragic history",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0029",
          "number": 29,
          "speechLineNumber": 9,
          "text": "But wherefore dost thou come? Is 't for my life?",
          "plainText": "But wherefore dost thou come Is 't for my life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-009",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Think'st thou I am an executioner?",
          "plainText": "Think'st thou I am an executioner",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-010",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "A persecutor I am sure thou art.",
          "plainText": "A persecutor I am sure thou art",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "If murdering innocents be executing,",
          "plainText": "If murdering innocents be executing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "Why, then thou art an executioner.",
          "plainText": "Why then thou art an executioner",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-011",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Thy son I killed for his presumption.",
          "plainText": "Thy son I killed for his presumption",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-012",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Hadst thou been killed when first thou didst presume,",
          "plainText": "Hadst thou been killed when first thou didst presume",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "Thou hadst not lived to kill a son of mine.",
          "plainText": "Thou hadst not lived to kill a son of mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "And thus I prophesy: that many a thousand",
          "plainText": "And thus I prophesy that many a thousand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0038",
          "number": 38,
          "speechLineNumber": 4,
          "text": "Which now mistrust no parcel of my fear,",
          "plainText": "Which now mistrust no parcel of my fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0039",
          "number": 39,
          "speechLineNumber": 5,
          "text": "And many an old man's sigh, and many a widow's,",
          "plainText": "And many an old man's sigh and many a widow's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0040",
          "number": 40,
          "speechLineNumber": 6,
          "text": "And many an orphan's water-standing eye,",
          "plainText": "And many an orphan's waterstanding eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0041",
          "number": 41,
          "speechLineNumber": 7,
          "text": "Men for their sons', wives for their husbands',",
          "plainText": "Men for their sons' wives for their husbands'",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0042",
          "number": 42,
          "speechLineNumber": 8,
          "text": "Orphans for their parents' timeless death,",
          "plainText": "Orphans for their parents' timeless death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0043",
          "number": 43,
          "speechLineNumber": 9,
          "text": "Shall rue the hour that ever thou wast born.",
          "plainText": "Shall rue the hour that ever thou wast born",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0044",
          "number": 44,
          "speechLineNumber": 10,
          "text": "The owl shrieked at thy birth, an evil sign;",
          "plainText": "The owl shrieked at thy birth an evil sign",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0045",
          "number": 45,
          "speechLineNumber": 11,
          "text": "The night-crow cried, aboding luckless time;",
          "plainText": "The nightcrow cried aboding luckless time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0046",
          "number": 46,
          "speechLineNumber": 12,
          "text": "Dogs howled, and hideous tempest shook down trees;",
          "plainText": "Dogs howled and hideous tempest shook down trees",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0047",
          "number": 47,
          "speechLineNumber": 13,
          "text": "The raven rooked her on the chimney's top,",
          "plainText": "The raven rooked her on the chimney's top",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0048",
          "number": 48,
          "speechLineNumber": 14,
          "text": "And chatt'ring pies in dismal discord sung;",
          "plainText": "And chatt'ring pies in dismal discord sung",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0049",
          "number": 49,
          "speechLineNumber": 15,
          "text": "Thy mother felt more than a mother's pain,",
          "plainText": "Thy mother felt more than a mother's pain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0050",
          "number": 50,
          "speechLineNumber": 16,
          "text": "And yet brought forth less than a mother's hope,",
          "plainText": "And yet brought forth less than a mother's hope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0051",
          "number": 51,
          "speechLineNumber": 17,
          "text": "To wit, an indigested and deformed lump,",
          "plainText": "To wit an indigested and deformed lump",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0052",
          "number": 52,
          "speechLineNumber": 18,
          "text": "Not like the fruit of such a goodly tree.",
          "plainText": "Not like the fruit of such a goodly tree",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0053",
          "number": 53,
          "speechLineNumber": 19,
          "text": "Teeth hadst thou in thy head when thou wast born,",
          "plainText": "Teeth hadst thou in thy head when thou wast born",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0054",
          "number": 54,
          "speechLineNumber": 20,
          "text": "To signify thou cam'st to bite the world;",
          "plainText": "To signify thou cam'st to bite the world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0055",
          "number": 55,
          "speechLineNumber": 21,
          "text": "And, if the rest be true which I have heard,",
          "plainText": "And if the rest be true which I have heard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0056",
          "number": 56,
          "speechLineNumber": 22,
          "text": "Thou cam'st—",
          "plainText": "Thou cam'st",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-013",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "I'll hear no more. Die, prophet, in thy speech.",
          "plainText": "I'll hear no more Die prophet in thy speech",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-stage-003",
      "type": "stage",
      "text": "[Stabs him.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-014",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Ay, and for much more slaughter after this.",
          "plainText": "Ay and for much more slaughter after this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "O God, forgive my sins, and pardon thee!",
          "plainText": "O God forgive my sins and pardon thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-stage-004",
      "type": "stage",
      "text": "[Dies.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-speech-015",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "What, will the aspiring blood of Lancaster",
          "plainText": "What will the aspiring blood of Lancaster",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "Sink in the ground? I thought it would have mounted.",
          "plainText": "Sink in the ground I thought it would have mounted",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0062",
          "number": 62,
          "speechLineNumber": 3,
          "text": "See how my sword weeps for the poor King's death.",
          "plainText": "See how my sword weeps for the poor King's death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0063",
          "number": 63,
          "speechLineNumber": 4,
          "text": "O, may such purple tears be always shed",
          "plainText": "O may such purple tears be always shed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0064",
          "number": 64,
          "speechLineNumber": 5,
          "text": "From those that wish the downfall of our house!",
          "plainText": "From those that wish the downfall of our house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0065",
          "number": 65,
          "speechLineNumber": 6,
          "text": "If any spark of life be yet remaining,",
          "plainText": "If any spark of life be yet remaining",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-6-line-0066",
          "number": 66,
          "speechLineNumber": 7,
          "text": "Down, down to hell; and say I sent thee thither—",
          "plainText": "Down down to hell and say I sent thee thither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-stage-005",
      "type": "stage",
      "text": "[Stabs him again.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-6-stage-006",
      "type": "stage",
      "text": "[Exit with the body.]"
    }
  ]
}