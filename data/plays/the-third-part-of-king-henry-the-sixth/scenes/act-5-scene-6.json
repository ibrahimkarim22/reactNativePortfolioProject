          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2653268,
        "end": 2653353,
        "line": 96614,
        "column": 1,
        "path": "chap14/p@188877",
        "anchor": "sceneV_14.6"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
