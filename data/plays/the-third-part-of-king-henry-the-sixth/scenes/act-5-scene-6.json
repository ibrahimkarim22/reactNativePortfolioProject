          "start": 0,
          "end": 18,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2653357,
        "end": 2653433,
        "line": 96619,
        "column": 1,
        "path": "chap14/p@188966",
        "anchor": "sceneV_14.6"
      },
      "speakerLabel": null,
