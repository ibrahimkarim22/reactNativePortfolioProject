      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188877",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nSirrah, leave us to ourselves; we must confer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188877/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
