    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188536",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nGood day, my lord. What, at your book so hard?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188536/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188536/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2652927,
        "end": 2653012,
        "line": 96601,
        "column": 1,
        "path": "chap14/p@188536",
        "anchor": "sceneV_14.6"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188625",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nAy, my good lord—my lord, I should say rather.\n’Tis sin to flatter; “good” was little better:\n“Good Gloucester” and “good devil” were alike,\nAnd both preposterous; therefore, not “good lord”.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188625/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188625/line-2",
          "start": 12,
          "end": 58,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188625/line-3",
          "start": 59,
          "end": 105,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188625/line-4",
          "start": 106,
          "end": 152,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@188625/line-5",
          "start": 153,
          "end": 203,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2653016,
        "end": 2653264,
        "line": 96606,
        "column": 1,
        "path": "chap14/p@188625",
