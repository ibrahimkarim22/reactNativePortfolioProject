    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190367",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nThink’st thou I am an executioner?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190367/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190367/line-2",
          "start": 9,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2654758,
        "end": 2654831,
        "line": 96664,
        "column": 1,
        "path": "chap14/p@190367",
        "anchor": "sceneV_14.6"
      },
      "speakerLabel": "RICHARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190444",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING HENRY.\nA persecutor I am sure thou art.\nIf murdering innocents be executing,\nWhy, then thou art an executioner.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190444/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190444/line-2",
          "start": 12,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190444/line-3",
          "start": 45,
          "end": 81,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190444/line-4",
          "start": 82,
          "end": 116,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2654835,
        "end": 2654991,
        "line": 96669,
        "column": 1,
        "path": "chap14/p@190444",
        "anchor": "sceneV_14.6"
      },
      "speakerLabel": "KING HENRY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190604",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "RICHARD.\nThy son I killed for his presumption.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190604/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.6/p@190604/line-2",
          "start": 9,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
