          "start": 13,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196178/line-3",
          "start": 50,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2660569,
        "end": 2660700,
        "line": 96835,
        "column": 1,
        "path": "chap14/p@196178",
        "anchor": "sceneV_14.7"
      },
      "speakerLabel": "KING EDWARD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196313",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GEORGE.\nWhat will your Grace have done with Margaret?\nReignier, her father, to the King of France\nHath pawned the Sicils and Jerusalem,\nAnd hither have they sent it for her ransom.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196313/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196313/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196313/line-3",
          "start": 54,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196313/line-4",
          "start": 98,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196313/line-5",
          "start": 136,
          "end": 180,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 2660704,
        "end": 2660929,
        "line": 96841,
        "column": 1,
        "path": "chap14/p@196313",
        "anchor": "sceneV_14.7"
      },
      "speakerLabel": "GEORGE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196542",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nAway with her and waft her hence to France.\nAnd now what rests but that we spend the time\nWith stately triumphs, mirthful comic shows,\nSuch as befits the pleasure of the court?\nSound drums and trumpets! Farewell, sour annoy!\nFor here, I hope, begins our lasting joy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196542/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196542/line-2",
          "start": 13,
          "end": 56,
          "sourceLineNumber": null
        },
        {
