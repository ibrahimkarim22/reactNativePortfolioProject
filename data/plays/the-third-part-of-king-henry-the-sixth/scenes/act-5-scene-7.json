      ],
      "sourceRef": {
        "start": 2660208,
        "end": 2660302,
        "line": 96822,
        "column": 1,
        "path": "chap14/p@195817",
        "anchor": "sceneV_14.7"
      },
      "speakerLabel": "QUEEN ELIZABETH.",
      "attribution": {
