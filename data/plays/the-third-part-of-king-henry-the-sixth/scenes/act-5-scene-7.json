      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "QUEEN ELIZABETH.\nThanks, noble Clarence; worthy brother, thanks.",
      "separatorAfter": "\n\n",
      "spans": [],
