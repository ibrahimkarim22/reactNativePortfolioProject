    {
      "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196178",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "KING EDWARD.\nNow am I seated as my soul delights,\nHaving my country’s peace and brothers’ loves.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth/sceneV_14.7/p@196178/line-1",
