      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GEORGE.\nThe duty that I owe unto your Majesty\nI seal upon the lips of this sweet babe.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
