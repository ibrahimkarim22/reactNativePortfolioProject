    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@23768",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nNor need’st thou much importune me to that\nWhereon this month I have been hammering.\nI have considered well his loss of time,\nAnd how he cannot be a perfect man,\nNot being tried and tutored in the world.\nExperience is by industry achieved\nAnd perfected by the swift course of time.\nThen tell me whither were I best to send him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@23768/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@23768/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@23768/line-3",
          "start": 52,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@23768/line-4",
          "start": 94,
          "end": 134,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@23768/line-5",
