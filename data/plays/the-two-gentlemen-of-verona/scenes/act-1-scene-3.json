      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25346",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "And in good time! Now will we break with him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25346/line-1",
          "start": 0,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6506656,
        "end": 6506726,
        "line": 243690,
        "column": 1,
        "path": "chap37/p@25346",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25420",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nSweet love, sweet lines, sweet life!\nHere is her hand, the agent of her heart;\nHere is her oath for love, her honour’s pawn.\nO, that our fathers would applaud our loves\nTo seal our happiness with their consents.\nO heavenly Julia!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25420/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25420/line-2",
          "start": 9,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25420/line-3",
          "start": 46,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25420/line-4",
          "start": 88,
          "end": 133,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25420/line-5",
          "start": 134,
          "end": 177,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25420/line-6",
          "start": 178,
          "end": 220,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25420/line-7",
          "start": 221,
          "end": 238,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6506730,
        "end": 6507023,
        "line": 243694,
        "column": 1,
        "path": "chap37/p@25420",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25717",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nHow now? What letter are you reading there?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25717/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25717/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6507027,
        "end": 6507109,
        "line": 243704,
        "column": 1,
        "path": "chap37/p@25717",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25803",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nMay’t please your lordship, ’tis a word or two\nOf commendations sent from Valentine,\nDelivered by a friend that came from him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25803/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25803/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25803/line-3",
          "start": 56,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25803/line-4",
          "start": 94,
          "end": 135,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6507113,
        "end": 6507288,
        "line": 243709,
        "column": 1,
        "path": "chap37/p@25803",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25982",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nLend me the letter. Let me see what news.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25982/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@25982/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6507292,
        "end": 6507372,
        "line": 243716,
        "column": 1,
        "path": "chap37/p@25982",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26066",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nThere is no news, my lord, but that he writes\nHow happily he lives, how well beloved\nAnd daily graced by the Emperor,\nWishing me with him, partner of his fortune.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26066/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26066/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26066/line-3",
          "start": 55,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26066/line-4",
          "start": 94,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26066/line-5",
          "start": 127,
          "end": 171,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6507376,
        "end": 6507592,
        "line": 243721,
        "column": 1,
        "path": "chap37/p@26066",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26286",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nAnd how stand you affected to his wish?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26286/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26286/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6507596,
        "end": 6507674,
        "line": 243729,
        "column": 1,
        "path": "chap37/p@26286",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26368",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nAs one relying on your lordship’s will,\nAnd not depending on his friendly wish.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26368/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26368/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26368/line-3",
          "start": 49,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6507678,
        "end": 6507801,
        "line": 243734,
        "column": 1,
        "path": "chap37/p@26368",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nMy will is something sorted with his wish.\nMuse not that I thus suddenly proceed,\nFor what I will, I will, and there an end.\nI am resolved that thou shalt spend some time\nWith Valentinus in the Emperor’s court.\nWhat maintenance he from his friends receives,\nLike exhibition thou shalt have from me.\nTomorrow be in readiness to go.\nExcuse it not, for I am peremptory.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495/line-3",
          "start": 52,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495/line-4",
          "start": 91,
          "end": 133,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495/line-5",
          "start": 134,
          "end": 179,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495/line-6",
          "start": 180,
          "end": 219,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495/line-7",
          "start": 220,
          "end": 266,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495/line-8",
          "start": 267,
          "end": 307,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495/line-9",
          "start": 308,
          "end": 339,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26495/line-10",
          "start": 340,
          "end": 375,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6507805,
        "end": 6508250,
        "line": 243740,
        "column": 1,
        "path": "chap37/p@26495",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26944",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nMy lord, I cannot be so soon provided;\nPlease you deliberate a day or two.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26944/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26944/line-2",
          "start": 9,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@26944/line-3",
          "start": 48,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6508254,
        "end": 6508372,
        "line": 243753,
        "column": 1,
        "path": "chap37/p@26944",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@27066",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nLook what thou want’st shall be sent after thee.\nNo more of stay. Tomorrow thou must go.\nCome on, Pantino, you shall be employed\nTo hasten on his expedition.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@27066/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@27066/line-2",
          "start": 9,
          "end": 57,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@27066/line-3",
          "start": 58,
          "end": 97,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@27066/line-4",
          "start": 98,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@27066/line-5",
          "start": 138,
          "end": 166,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6508376,
        "end": 6508587,
        "line": 243759,
        "column": 1,
        "path": "chap37/p@27066",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@27281",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt Antonio and Pantino.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 15,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 20,
          "end": 27,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 28
        }
      ],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@27281/line-1",
          "start": 0,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6508591,
        "end": 6508713,
        "line": 243767,
        "column": 1,
        "path": "chap37/p@27281",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@27407",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nThus have I shunned the fire for fear of burning\nAnd drenched me in the sea, where I am drowned.\nI feared to show my father Julia’s letter\nLest he should take exceptions to my love,\nAnd with the vantage of mine own excuse\nHath he excepted most against my love.\nO, how this spring of love resembleth\nThe uncertain glory of an April day,\nWhich now shows all the beauty of the sun,\nAnd by an by a cloud takes all away.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@27407/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
