        "end": 6505706,
        "line": 243650,
        "column": 1,
        "path": "chap37/p@24342",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24400",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PANTINO.\n’Twere good, I think, your lordship sent him thither.\nThere shall he practise tilts and tournaments,\nHear sweet discourse, converse with noblemen,\nAnd be in eye of every exercise\nWorthy his youth and nobleness of birth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24400/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24400/line-2",
          "start": 9,
          "end": 62,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24400/line-3",
          "start": 63,
          "end": 109,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24400/line-4",
          "start": 110,
          "end": 155,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24400/line-5",
          "start": 156,
          "end": 187,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24400/line-6",
          "start": 188,
          "end": 228,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6505710,
        "end": 6505988,
        "line": 243655,
        "column": 1,
        "path": "chap37/p@24400",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "PANTINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24682",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nI like thy counsel; well hast thou advised,\nAnd that thou mayst perceive how well I like it,\nThe execution of it shall make known.\nEven with the speediest expedition\nI will dispatch him to the Emperor’s court.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24682/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24682/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24682/line-3",
          "start": 53,
          "end": 101,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24682/line-4",
          "start": 102,
          "end": 139,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24682/line-5",
          "start": 140,
          "end": 174,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24682/line-6",
          "start": 175,
          "end": 218,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6505992,
        "end": 6506260,
        "line": 243664,
        "column": 1,
        "path": "chap37/p@24682",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
