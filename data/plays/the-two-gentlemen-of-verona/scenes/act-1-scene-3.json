        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24954",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PANTINO.\nTomorrow, may it please you, Don Alphonso\nWith other gentlemen of good esteem\nAre journeying to salute the Emperor\nAnd to commend their service to his will.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24954/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24954/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24954/line-3",
          "start": 51,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24954/line-4",
          "start": 87,
          "end": 123,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24954/line-5",
          "start": 124,
          "end": 165,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
