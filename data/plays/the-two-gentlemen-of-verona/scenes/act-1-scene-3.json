    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24173",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PANTINO.\nI think your lordship is not ignorant\nHow his companion, youthful Valentine,\nAttends the Emperor in his royal court.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24173/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24173/line-2",
          "start": 9,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24173/line-3",
          "start": 47,
          "end": 85,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24173/line-4",
          "start": 86,
          "end": 125,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6505483,
        "end": 6505648,
        "line": 243643,
        "column": 1,
        "path": "chap37/p@24173",
        "anchor": "sceneI_37.3"
      },
      "speakerLabel": "PANTINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24342",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nI know it well.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24342/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneI_37.3/p@24342/line-2",
          "start": 9,
          "end": 24,
          "sourceLineNumber": null
        }
