      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIA.\nAnd seal the bargain with a holy kiss.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@40249/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@40249/line-2",
          "start": 7,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6521559,
        "end": 6521634,
        "line": 244389,
        "column": 1,
        "path": "chap37/p@40249",
        "anchor": "sceneII_37.2"
      },
      "speakerLabel": "JULIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@40328",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nHere is my hand for my true constancy.\nAnd when that hour o’erslips me in the day\nWherein I sigh not, Julia, for thy sake,\nThe next ensuing hour some foul mischance\nTorment me for my love’s forgetfulness.\nMy father stays my coming; answer not.\nThe tide is now—nay, not thy tide of tears,\nThat tide will stay me longer than I should.\nJulia, farewell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@40328/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
