    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@40835",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "What, gone without a word?\nAy, so true love should do. It cannot speak,\nFor truth hath better deeds than words to grace it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@40835/line-1",
