          "start": 7,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6521083,
        "end": 6521147,
        "line": 244364,
        "column": 1,
        "path": "chap37/p@39773",
        "anchor": "sceneII_37.2"
      },
      "speakerLabel": "JULIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@39841",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nWhen possibly I can, I will return.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@39841/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@39841/line-2",
          "start": 9,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6521151,
        "end": 6521225,
        "line": 244369,
        "column": 1,
        "path": "chap37/p@39841",
        "anchor": "sceneII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@39919",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIA.\nIf you turn not, you will return the sooner.\nKeep this remembrance for thy Julia’s sake.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@39919/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@39919/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@39919/line-3",
          "start": 52,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6521229,
        "end": 6521359,
        "line": 244374,
        "column": 1,
        "path": "chap37/p@39919",
        "anchor": "sceneII_37.2"
      },
      "speakerLabel": "JULIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
