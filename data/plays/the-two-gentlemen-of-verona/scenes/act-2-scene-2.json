      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nGo, I come, I come.\nAlas, this parting strikes poor lovers dumb.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@41149/line-1",
