      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Gives her a ring.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 18
        }
      ],
      "lines": [
