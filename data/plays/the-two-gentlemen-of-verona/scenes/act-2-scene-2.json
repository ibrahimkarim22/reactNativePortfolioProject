        "end": 6521079,
        "line": 244359,
        "column": 1,
        "path": "chap37/p@39702",
        "anchor": "sceneII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@39773",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIA.\nI must, where is no remedy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@39773/line-1",
