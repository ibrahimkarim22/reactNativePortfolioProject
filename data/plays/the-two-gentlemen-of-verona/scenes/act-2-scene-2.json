      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nWhy, then we’ll make exchange. Here, take you this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.2/p@40104/line-1",
