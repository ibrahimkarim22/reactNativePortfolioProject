          "start": 9,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6525558,
        "end": 6525609,
        "line": 244513,
        "column": 1,
        "path": "chap37/p@44248",
        "anchor": "sceneII_37.3"
      },
      "speakerLabel": "PANTINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44303",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nLose the tide, and the voyage, and the master, and the service, and the tied? Why, man, if the river were dry, I am able to fill it with my tears; if the wind were down, I could drive the boat with my sighs.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44303/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44303/line-2",
          "start": 7,
          "end": 214,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6525613,
        "end": 6525859,
        "line": 244518,
        "column": 1,
        "path": "chap37/p@44303",
        "anchor": "sceneII_37.3"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44553",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PANTINO.\nCome, come away, man. I was sent to call thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44553/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44553/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6525863,
        "end": 6525948,
        "line": 244525,
        "column": 1,
        "path": "chap37/p@44553",
        "anchor": "sceneII_37.3"
      },
      "speakerLabel": "PANTINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44642",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nSir, call me what thou dar’st.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44642/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44642/line-2",
          "start": 7,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6525952,
        "end": 6526019,
        "line": 244530,
        "column": 1,
        "path": "chap37/p@44642",
        "anchor": "sceneII_37.3"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44713",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PANTINO.\nWill thou go?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
