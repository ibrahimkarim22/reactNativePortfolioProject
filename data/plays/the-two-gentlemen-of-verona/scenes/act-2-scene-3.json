        "anchor": "sceneII_37.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@43256",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PANTINO.\nLance, away, away! Aboard! Thy master is shipped, and thou art to post after with oars. What’s the matter? Why weep’st thou, man? Away, ass. You’ll lose the tide if you tarry any longer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@43256/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@43256/line-2",
          "start": 9,
          "end": 195,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6524566,
        "end": 6524793,
        "line": 244468,
        "column": 1,
        "path": "chap37/p@43256",
        "anchor": "sceneII_37.3"
      },
      "speakerLabel": "PANTINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@43487",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nIt is no matter if the tied were lost, for it is the unkindest tied that ever any man tied.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@43487/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@43487/line-2",
          "start": 7,
          "end": 98,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6524797,
        "end": 6524926,
        "line": 244475,
        "column": 1,
        "path": "chap37/p@43487",
        "anchor": "sceneII_37.3"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@43620",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PANTINO.\nWhat’s the unkindest tide?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@43620/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
