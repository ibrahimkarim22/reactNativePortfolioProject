      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nIn thy tale.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44195/line-1",
