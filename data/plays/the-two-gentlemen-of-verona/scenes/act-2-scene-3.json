        "end": 6525554,
        "line": 244508,
        "column": 1,
        "path": "chap37/p@44195",
        "anchor": "sceneII_37.3"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44248",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PANTINO.\nIn thy tail!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.3/p@44248/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
