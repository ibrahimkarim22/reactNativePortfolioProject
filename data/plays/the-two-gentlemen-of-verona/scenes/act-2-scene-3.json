          "start": 9,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6525432,
        "end": 6525501,
        "line": 244503,
        "column": 1,
        "path": "chap37/p@44122",
        "anchor": "sceneII_37.3"
      },
      "speakerLabel": "PANTINO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
