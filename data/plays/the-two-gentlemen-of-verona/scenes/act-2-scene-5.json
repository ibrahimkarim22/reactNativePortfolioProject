      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61908",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nAt thy service.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
