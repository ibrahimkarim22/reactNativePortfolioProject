        }
      ],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@58593/line-1",
          "start": 0,
          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6539903,
        "end": 6540033,
        "line": 245182,
        "column": 1,
        "path": "chap37/p@58593",
        "anchor": "sceneII_37.5"
