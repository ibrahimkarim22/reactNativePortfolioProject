      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@58727",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nLance, by mine honesty, welcome to Milan!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@58727/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@58727/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6540037,
        "end": 6540115,
        "line": 245187,
        "column": 1,
        "path": "chap37/p@58727",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@58809",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nForswear not thyself, sweet youth, for I am not welcome. I reckon this always, that a man is never undone till he be hanged, nor never welcome to a place till some certain shot be paid and the hostess say “Welcome”.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@58809/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@58809/line-2",
          "start": 7,
          "end": 222,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6540119,
        "end": 6540373,
        "line": 245192,
        "column": 1,
        "path": "chap37/p@58809",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59067",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nCome on, you madcap. I’ll to the alehouse with you presently, where, for one shot of five pence, thou shalt have five thousand welcomes. But, sirrah, how did thy master part with Madam Julia?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59067/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59067/line-2",
          "start": 7,
          "end": 198,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6540377,
        "end": 6540607,
        "line": 245199,
        "column": 1,
        "path": "chap37/p@59067",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59301",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nMarry, after they closed in earnest, they parted very fairly in jest.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59301/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59301/line-2",
          "start": 7,
          "end": 76,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6540611,
        "end": 6540717,
        "line": 245206,
        "column": 1,
        "path": "chap37/p@59301",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59411",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nBut shall she marry him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59411/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59411/line-2",
          "start": 7,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6540721,
        "end": 6540782,
        "line": 245211,
        "column": 1,
        "path": "chap37/p@59411",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59476",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nNo.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59476/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59476/line-2",
          "start": 7,
          "end": 10,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6540786,
        "end": 6540826,
        "line": 245216,
        "column": 1,
        "path": "chap37/p@59476",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59520",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nHow then? Shall he marry her?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59520/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59520/line-2",
          "start": 7,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6540830,
        "end": 6540896,
        "line": 245221,
        "column": 1,
        "path": "chap37/p@59520",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59590",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nNo, neither.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59590/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59590/line-2",
          "start": 7,
          "end": 19,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6540900,
        "end": 6540949,
        "line": 245226,
        "column": 1,
        "path": "chap37/p@59590",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59643",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nWhat, are they broken?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59643/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59643/line-2",
          "start": 7,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6540953,
        "end": 6541012,
        "line": 245231,
        "column": 1,
        "path": "chap37/p@59643",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59706",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nNo, they are both as whole as a fish.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59706/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59706/line-2",
          "start": 7,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6541016,
        "end": 6541090,
        "line": 245236,
        "column": 1,
        "path": "chap37/p@59706",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59784",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nWhy then, how stands the matter with them?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59784/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59784/line-2",
          "start": 7,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6541094,
        "end": 6541173,
        "line": 245241,
        "column": 1,
        "path": "chap37/p@59784",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59867",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nMarry, thus: when it stands well with him, it stands well with her.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59867/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59867/line-2",
          "start": 7,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6541177,
        "end": 6541281,
        "line": 245246,
        "column": 1,
        "path": "chap37/p@59867",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59975",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nWhat an ass art thou! I understand thee not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59975/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@59975/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6541285,
        "end": 6541366,
        "line": 245251,
        "column": 1,
        "path": "chap37/p@59975",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60060",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nWhat a block art thou that thou canst not! My staff understands me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60060/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60060/line-2",
          "start": 7,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6541370,
        "end": 6541474,
        "line": 245256,
        "column": 1,
        "path": "chap37/p@60060",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60168",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nWhat thou sayst?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60168/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60168/line-2",
          "start": 7,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6541478,
        "end": 6541531,
        "line": 245261,
        "column": 1,
        "path": "chap37/p@60168",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60225",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nAy, and what I do too. Look thee, I’ll but lean, and my staff understands me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60225/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60225/line-2",
          "start": 7,
          "end": 84,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6541535,
        "end": 6541649,
        "line": 245266,
        "column": 1,
        "path": "chap37/p@60225",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60343",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nIt stands under thee indeed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60343/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60343/line-2",
          "start": 7,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6541653,
        "end": 6541718,
        "line": 245271,
        "column": 1,
        "path": "chap37/p@60343",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60412",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nWhy, stand-under and under-stand is all one.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60412/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
