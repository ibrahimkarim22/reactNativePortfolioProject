    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60497",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nBut tell me true, will’t be a match?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60497/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60497/line-2",
          "start": 7,
          "end": 43,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6541807,
        "end": 6541880,
        "line": 245281,
        "column": 1,
        "path": "chap37/p@60497",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60574",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nAsk my dog. If he say “Ay”, it will; if he say “No”, it will; if he shake his tail and say nothing, it will.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60574/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60574/line-2",
          "start": 7,
          "end": 115,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6541884,
        "end": 6542030,
        "line": 245286,
        "column": 1,
        "path": "chap37/p@60574",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60724",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nThe conclusion is, then, that it will.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60724/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60724/line-2",
          "start": 7,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6542034,
        "end": 6542109,
        "line": 245292,
        "column": 1,
        "path": "chap37/p@60724",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60803",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nThou shalt never get such a secret from me but by a parable.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60803/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60803/line-2",
          "start": 7,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6542113,
        "end": 6542210,
        "line": 245297,
        "column": 1,
        "path": "chap37/p@60803",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60904",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\n’Tis well that I get it so. But, Lance, how sayst thou that my master is become a notable lover?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60904/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@60904/line-2",
          "start": 7,
          "end": 103,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6542214,
        "end": 6542348,
        "line": 245302,
        "column": 1,
        "path": "chap37/p@60904",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61042",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nI never knew him otherwise.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61042/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61042/line-2",
          "start": 7,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6542352,
        "end": 6542416,
        "line": 245308,
        "column": 1,
        "path": "chap37/p@61042",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61110",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nThan how?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61110/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61110/line-2",
          "start": 7,
          "end": 16,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6542420,
        "end": 6542466,
        "line": 245313,
        "column": 1,
        "path": "chap37/p@61110",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61160",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nA notable lubber, as thou reportest him to be.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61160/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61160/line-2",
          "start": 7,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6542470,
        "end": 6542553,
        "line": 245318,
        "column": 1,
        "path": "chap37/p@61160",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61247",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nWhy, thou whoreson ass, thou mistak’st me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61247/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61247/line-2",
          "start": 7,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6542557,
        "end": 6542636,
        "line": 245323,
        "column": 1,
        "path": "chap37/p@61247",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61330",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nWhy, fool, I meant not thee, I meant thy master.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61330/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61330/line-2",
          "start": 7,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6542640,
        "end": 6542725,
        "line": 245328,
        "column": 1,
        "path": "chap37/p@61330",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61419",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nI tell thee, my master is become a hot lover.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61419/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61419/line-2",
          "start": 7,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6542729,
        "end": 6542811,
        "line": 245333,
        "column": 1,
        "path": "chap37/p@61419",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61505",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nWhy, I tell thee, I care not though he burn himself in love. If thou wilt, go with me to the alehouse; if not, thou art an Hebrew, a Jew, and not worth the name of a Christian.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61505/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61505/line-2",
          "start": 7,
          "end": 183,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6542815,
        "end": 6543030,
        "line": 245338,
        "column": 1,
        "path": "chap37/p@61505",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61724",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SPEED.\nWhy?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61724/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61724/line-2",
          "start": 7,
          "end": 11,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6543034,
        "end": 6543075,
        "line": 245345,
        "column": 1,
        "path": "chap37/p@61724",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "SPEED.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61769",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LANCE.\nBecause thou hast not so much charity in thee as to go to the ale with a Christian. Wilt thou go?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61769/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.5/p@61769/line-2",
          "start": 7,
          "end": 104,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6543079,
        "end": 6543214,
        "line": 245350,
        "column": 1,
        "path": "chap37/p@61769",
        "anchor": "sceneII_37.5"
      },
      "speakerLabel": "LANCE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
