      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66495",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCETTA.\nBut in what habit will you go along?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66495/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66495/line-2",
          "start": 9,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6547805,
        "end": 6547880,
        "line": 245491,
        "column": 1,
        "path": "chap37/p@66495",
        "anchor": "sceneII_37.7"
      },
      "speakerLabel": "LUCETTA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66574",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIA.\nNot like a woman, for I would prevent\nThe loose encounters of lascivious men.\nGentle Lucetta, fit me with such weeds\nAs may beseem some well-reputed page.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66574/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66574/line-2",
          "start": 7,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66574/line-3",
          "start": 45,
          "end": 84,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66574/line-4",
          "start": 85,
          "end": 123,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66574/line-5",
          "start": 124,
          "end": 161,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6547884,
        "end": 6548090,
        "line": 245496,
        "column": 1,
        "path": "chap37/p@66574",
        "anchor": "sceneII_37.7"
      },
      "speakerLabel": "JULIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66784",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCETTA.\nWhy then, your ladyship must cut your hair.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66784/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66784/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6548094,
        "end": 6548176,
        "line": 245504,
        "column": 1,
        "path": "chap37/p@66784",
        "anchor": "sceneII_37.7"
      },
      "speakerLabel": "LUCETTA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66870",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIA.\nNo, girl, I’ll knit it up in silken strings\nWith twenty odd-conceited true-love knots.\nTo be fantastic may become a youth\nOf greater time than I shall show to be.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66870/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@66870/line-2",
