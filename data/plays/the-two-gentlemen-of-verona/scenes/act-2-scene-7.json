    {
      "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@64476",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIA.\nCounsel, Lucetta; gentle girl, assist me,\nAnd ev’n in kind love I do conjure thee,\nWho art the table wherein all my thoughts\nAre visibly charactered and engraved,\nTo lesson me and tell me some good mean\nHow with my honour I may undertake\nA journey to my loving Proteus.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@64476/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@64476/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@64476/line-3",
          "start": 49,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@64476/line-4",
          "start": 90,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneII_37.7/p@64476/line-5",
          "start": 132,
          "end": 169,
          "sourceLineNumber": null
        },
        {
