        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93128",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Proteus.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93128/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6574438,
        "end": 6574511,
        "line": 246580,
        "column": 1,
        "path": "chap37/p@93128",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93205",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "How now, Sir Proteus? Is your countryman,\nAccording to our proclamation, gone?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93205/line-1",
          "start": 0,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93205/line-2",
          "start": 42,
          "end": 78,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6574515,
        "end": 6574623,
        "line": 246584,
        "column": 1,
        "path": "chap37/p@93205",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93317",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nGone, my good lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93317/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93317/line-2",
          "start": 9,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6574627,
        "end": 6574685,
        "line": 246589,
        "column": 1,
        "path": "chap37/p@93317",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93379",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nMy daughter takes his going grievously.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93379/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93379/line-2",
          "start": 6,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6574689,
        "end": 6574764,
        "line": 246594,
        "column": 1,
        "path": "chap37/p@93379",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93458",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nA little time, my lord, will kill that grief.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93458/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93458/line-2",
          "start": 9,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6574768,
        "end": 6574852,
        "line": 246599,
        "column": 1,
        "path": "chap37/p@93458",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93546",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nSo I believe, but Thurio thinks not so.\nProteus, the good conceit I hold of thee,\nFor thou hast shown some sign of good desert,\nMakes me the better to confer with thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93546/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93546/line-2",
          "start": 6,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93546/line-3",
          "start": 46,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93546/line-4",
          "start": 88,
          "end": 133,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93546/line-5",
          "start": 134,
          "end": 174,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6574856,
        "end": 6575075,
        "line": 246604,
        "column": 1,
        "path": "chap37/p@93546",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93769",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nLonger than I prove loyal to your Grace\nLet me not live to look upon your Grace.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93769/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93769/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93769/line-3",
          "start": 49,
          "end": 89,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6575079,
        "end": 6575203,
        "line": 246612,
        "column": 1,
        "path": "chap37/p@93769",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93897",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nThou know’st how willingly I would effect\nThe match between Sir Thurio and my daughter?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93897/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93897/line-2",
          "start": 6,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@93897/line-3",
          "start": 48,
          "end": 93,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6575207,
        "end": 6575335,
        "line": 246618,
        "column": 1,
        "path": "chap37/p@93897",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94029",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nI do, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94029/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94029/line-2",
          "start": 9,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6575339,
        "end": 6575392,
        "line": 246624,
        "column": 1,
        "path": "chap37/p@94029",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94086",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nAnd also, I think, thou art not ignorant\nHow she opposes her against my will?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94086/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94086/line-2",
          "start": 6,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94086/line-3",
          "start": 47,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6575396,
        "end": 6575514,
        "line": 246629,
        "column": 1,
        "path": "chap37/p@94086",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94208",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nShe did, my lord, when Valentine was here.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94208/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94208/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6575518,
        "end": 6575599,
        "line": 246635,
        "column": 1,
        "path": "chap37/p@94208",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94293",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nAy, and perversely she persevers so.\nWhat might we do to make the girl forget\nThe love of Valentine, and love Sir Thurio?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94293/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94293/line-2",
          "start": 6,
          "end": 42,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94293/line-3",
          "start": 43,
          "end": 83,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94293/line-4",
          "start": 84,
          "end": 127,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6575603,
        "end": 6575770,
        "line": 246640,
        "column": 1,
        "path": "chap37/p@94293",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94464",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nThe best way is to slander Valentine\nWith falsehood, cowardice, and poor descent,\nThree things that women highly hold in hate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94464/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94464/line-2",
          "start": 9,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94464/line-3",
          "start": 46,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94464/line-4",
          "start": 91,
          "end": 135,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6575774,
        "end": 6575949,
        "line": 246647,
        "column": 1,
        "path": "chap37/p@94464",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94643",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nAy, but she’ll think that it is spoke in hate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94643/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94643/line-2",
          "start": 6,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6575953,
        "end": 6576035,
        "line": 246654,
        "column": 1,
        "path": "chap37/p@94643",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94729",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nAy, if his enemy deliver it;\nTherefore it must with circumstance be spoken\nBy one whom she esteemeth as his friend.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94729/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94729/line-2",
          "start": 9,
          "end": 37,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94729/line-3",
          "start": 38,
          "end": 83,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94729/line-4",
          "start": 84,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6576039,
        "end": 6576203,
        "line": 246659,
        "column": 1,
        "path": "chap37/p@94729",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94897",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nThen you must undertake to slander him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94897/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94897/line-2",
          "start": 6,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6576207,
        "end": 6576282,
        "line": 246666,
        "column": 1,
        "path": "chap37/p@94897",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94976",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nAnd that, my lord, I shall be loath to do.\n’Tis an ill office for a gentleman,\nEspecially against his very friend.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94976/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94976/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94976/line-3",
          "start": 52,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@94976/line-4",
          "start": 88,
          "end": 123,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6576286,
        "end": 6576449,
        "line": 246671,
        "column": 1,
        "path": "chap37/p@94976",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95143",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nWhere your good word cannot advantage him,\nYour slander never can endamage him;\nTherefore the office is indifferent,\nBeing entreated to it by your friend.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95143/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95143/line-2",
          "start": 6,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95143/line-3",
          "start": 49,
          "end": 85,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95143/line-4",
          "start": 86,
          "end": 122,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95143/line-5",
          "start": 123,
          "end": 160,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6576453,
        "end": 6576658,
        "line": 246678,
        "column": 1,
        "path": "chap37/p@95143",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95352",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nYou have prevailed, my lord. If I can do it\nBy aught that I can speak in his dispraise,\nShe shall not long continue love to him.\nBut say this weed her love from Valentine,\nIt follows not that she will love Sir Thurio.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95352/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95352/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95352/line-3",
          "start": 53,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95352/line-4",
          "start": 97,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95352/line-5",
          "start": 138,
          "end": 180,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95352/line-6",
          "start": 181,
          "end": 226,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6576662,
        "end": 6576938,
        "line": 246686,
        "column": 1,
        "path": "chap37/p@95352",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95632",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THURIO.\nTherefore, as you unwind her love from him,\nLest it should ravel and be good to none,\nYou must provide to bottom it on me,\nWhich must be done by praising me as much\nAs you in worth dispraise Sir Valentine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95632/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95632/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95632/line-3",
          "start": 52,
          "end": 93,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95632/line-4",
          "start": 94,
          "end": 130,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95632/line-5",
          "start": 131,
          "end": 172,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95632/line-6",
          "start": 173,
          "end": 213,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6576942,
        "end": 6577205,
        "line": 246695,
        "column": 1,
        "path": "chap37/p@95632",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "THURIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nAnd, Proteus, we dare trust you in this kind\nBecause we know, on Valentine’s report,\nYou are already Love’s firm votary\nAnd cannot soon revolt and change your mind.\nUpon this warrant shall you have access\nWhere you with Silvia may confer at large—\nFor she is lumpish, heavy, melancholy,\nAnd, for your friend’s sake, will be glad of you—\nWhere you may temper her by your persuasion\nTo hate young Valentine and love my friend.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899/line-2",
          "start": 6,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899/line-3",
          "start": 51,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899/line-4",
          "start": 91,
          "end": 125,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899/line-5",
          "start": 126,
          "end": 170,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899/line-6",
          "start": 171,
          "end": 210,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899/line-7",
          "start": 211,
          "end": 253,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899/line-8",
          "start": 254,
          "end": 292,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899/line-9",
          "start": 293,
          "end": 342,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@95899/line-10",
