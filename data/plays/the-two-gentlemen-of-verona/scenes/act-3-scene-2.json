      "sourceRef": {
        "start": 6577209,
        "end": 6577714,
        "line": 246704,
        "column": 1,
        "path": "chap37/p@95899",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96408",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nAs much as I can do I will effect.\nBut you, Sir Thurio, are not sharp enough.\nYou must lay lime to tangle her desires\nBy wailful sonnets, whose composed rhymes\nShould be full-fraught with serviceable vows.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96408/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96408/line-2",
          "start": 9,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96408/line-3",
          "start": 44,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96408/line-4",
          "start": 87,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96408/line-5",
          "start": 127,
          "end": 168,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96408/line-6",
          "start": 169,
          "end": 214,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6577718,
        "end": 6577982,
        "line": 246718,
        "column": 1,
        "path": "chap37/p@96408",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96676",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nAy, much is the force of heaven-bred poesy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96676/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96676/line-2",
          "start": 6,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6577986,
        "end": 6578065,
        "line": 246727,
        "column": 1,
        "path": "chap37/p@96676",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96759",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nSay that upon the altar of her beauty\nYou sacrifice your tears, your sighs, your heart.\nWrite till your ink be dry, and with your tears\nMoist it again, and frame some feeling line\nThat may discover such integrity.\nFor Orpheus’ lute was strung with poets’ sinews,\nWhose golden touch could soften steel and stones,\nMake tigers tame, and huge leviathans\nForsake unsounded deeps to dance on sands.\nAfter your dire-lamenting elegies,\nVisit by night your lady’s chamber-window\nWith some sweet consort; to their instruments\nTune a deploring dump; the night’s dead silence\nWill well become such sweet-complaining grievance.\nThis, or else nothing, will inherit her.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96759/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96759/line-2",
          "start": 9,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96759/line-3",
          "start": 47,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@96759/line-4",
          "start": 97,
          "end": 144,
          "sourceLineNumber": null
        },
