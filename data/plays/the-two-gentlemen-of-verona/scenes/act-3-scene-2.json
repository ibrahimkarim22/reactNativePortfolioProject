      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Duke and Thurio.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 10,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 15,
          "end": 21,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92436/line-1",
          "start": 0,
          "end": 22,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6573746,
        "end": 6573858,
        "line": 246553,
        "column": 1,
        "path": "chap37/p@92436",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92552",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nSir Thurio, fear not but that she will love you\nNow Valentine is banished from her sight.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92552/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92552/line-2",
          "start": 6,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92552/line-3",
          "start": 54,
          "end": 95,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6573862,
        "end": 6573992,
        "line": 246558,
        "column": 1,
        "path": "chap37/p@92552",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92686",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THURIO.\nSince his exile she hath despised me most,\nForsworn my company and railed at me,\nThat I am desperate of obtaining her.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92686/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92686/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92686/line-3",
          "start": 51,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92686/line-4",
          "start": 89,
          "end": 126,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6573996,
        "end": 6574162,
        "line": 246564,
        "column": 1,
        "path": "chap37/p@92686",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "THURIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92856",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nThis weak impress of love is as a figure\nTrenched in ice, which with an hour’s heat\nDissolves to water and doth lose his form.\nA little time will melt her frozen thoughts,\nAnd worthless Valentine shall be forgot.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92856/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92856/line-2",
          "start": 6,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92856/line-3",
          "start": 47,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92856/line-4",
          "start": 90,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92856/line-5",
          "start": 133,
          "end": 177,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneIII_37.2/p@92856/line-6",
          "start": 178,
          "end": 218,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6574166,
        "end": 6574434,
        "line": 246571,
        "column": 1,
        "path": "chap37/p@92856",
        "anchor": "sceneIII_37.2"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
