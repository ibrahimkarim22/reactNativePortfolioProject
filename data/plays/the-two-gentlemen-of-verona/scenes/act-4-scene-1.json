  "content": [
    {
      "id": "the-two-gentlemen-of-verona-4-1-stage-001",
      "type": "stage",
      "text": "Enter certain Outlaws."
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Fellows, stand fast. I see a passenger.",
          "plainText": "Fellows stand fast I see a passenger",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "If there be ten, shrink not, but down with 'em.",
          "plainText": "If there be ten shrink not but down with 'em",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-stage-002",
      "type": "stage",
      "text": "Enter Valentine and Speed."
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "third-outlaw",
        "name": "THIRD OUTLAW",
        "displayName": "Third Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Stand, sir, and throw us that you have about ye.",
          "plainText": "Stand sir and throw us that you have about ye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "If not, we'll make you sit, and rifle you.",
          "plainText": "If not we'll make you sit and rifle you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Sir, we are undone: these are the villains",
          "plainText": "Sir we are undone these are the villains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "That all the travellers do fear so much.",
          "plainText": "That all the travellers do fear so much",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "My friends—",
          "plainText": "My friends",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "That's not so, sir. We are your enemies.",
          "plainText": "That's not so sir We are your enemies",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Peace! We'll hear him.",
          "plainText": "Peace We'll hear him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "third-outlaw",
        "name": "THIRD OUTLAW",
        "displayName": "Third Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Ay, by my beard, will we, for he is a proper man.",
          "plainText": "Ay by my beard will we for he is a proper man",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Then know that I have little wealth to lose.",
          "plainText": "Then know that I have little wealth to lose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "A man I am crossed with adversity;",
          "plainText": "A man I am crossed with adversity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "My riches are these poor habiliments,",
          "plainText": "My riches are these poor habiliments",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "Of which if you should here disfurnish me,",
          "plainText": "Of which if you should here disfurnish me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "You take the sum and substance that I have.",
          "plainText": "You take the sum and substance that I have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Whither travel you?",
          "plainText": "Whither travel you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "To Verona.",
          "plainText": "To Verona",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Whence came you?",
          "plainText": "Whence came you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "From Milan.",
          "plainText": "From Milan",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "third-outlaw",
        "name": "THIRD OUTLAW",
        "displayName": "Third Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Have you long sojourned there?",
          "plainText": "Have you long sojourned there",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Some sixteen months, and longer might have stayed",
          "plainText": "Some sixteen months and longer might have stayed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "If crooked fortune had not thwarted me.",
          "plainText": "If crooked fortune had not thwarted me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "What, were you banished thence?",
          "plainText": "What were you banished thence",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "I was.",
          "plainText": "I was",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "For what offence?",
          "plainText": "For what offence",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "For that which now torments me to rehearse;",
          "plainText": "For that which now torments me to rehearse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "I killed a man, whose death I much repent,",
          "plainText": "I killed a man whose death I much repent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "But yet I slew him manfully in fight,",
          "plainText": "But yet I slew him manfully in fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "Without false vantage or base treachery.",
          "plainText": "Without false vantage or base treachery",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Why, ne'er repent it, if it were done so.",
          "plainText": "Why ne'er repent it if it were done so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "But were you banished for so small a fault?",
          "plainText": "But were you banished for so small a fault",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "I was, and held me glad of such a doom.",
          "plainText": "I was and held me glad of such a doom",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Have you the tongues?",
          "plainText": "Have you the tongues",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "My youthful travel therein made me happy,",
          "plainText": "My youthful travel therein made me happy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Or else I often had been miserable.",
          "plainText": "Or else I often had been miserable",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "third-outlaw",
        "name": "THIRD OUTLAW",
        "displayName": "Third Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "By the bare scalp of Robin Hood's fat friar,",
          "plainText": "By the bare scalp of Robin Hood's fat friar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "This fellow were a king for our wild faction.",
          "plainText": "This fellow were a king for our wild faction",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "We'll have him. Sirs, a word.",
          "plainText": "We'll have him Sirs a word",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Master, be one of them. It's an honourable kind of thievery.",
          "plainText": "Master be one of them It's an honourable kind of thievery",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Peace, villain.",
          "plainText": "Peace villain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Tell us this: have you anything to take to?",
          "plainText": "Tell us this have you anything to take to",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Nothing but my fortune.",
          "plainText": "Nothing but my fortune",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "third-outlaw",
        "name": "THIRD OUTLAW",
        "displayName": "Third Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Know then that some of us are gentlemen,",
          "plainText": "Know then that some of us are gentlemen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "Such as the fury of ungoverned youth",
          "plainText": "Such as the fury of ungoverned youth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Thrust from the company of awful men.",
          "plainText": "Thrust from the company of awful men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "Myself was from Verona banished",
          "plainText": "Myself was from Verona banished",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0047",
          "number": 47,
          "speechLineNumber": 5,
          "text": "For practising to steal away a lady,",
          "plainText": "For practising to steal away a lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0048",
          "number": 48,
          "speechLineNumber": 6,
          "text": "An heir, and near allied unto the Duke.",
          "plainText": "An heir and near allied unto the Duke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-031",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "And I from Mantua, for a gentleman",
          "plainText": "And I from Mantua for a gentleman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Who, in my mood, I stabbed unto the heart.",
          "plainText": "Who in my mood I stabbed unto the heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-032",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "And I for suchlike petty crimes as these.",
          "plainText": "And I for suchlike petty crimes as these",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "But to the purpose, for we cite our faults,",
          "plainText": "But to the purpose for we cite our faults",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "That they may hold excused our lawless lives;",
          "plainText": "That they may hold excused our lawless lives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "And partly, seeing you are beautified",
          "plainText": "And partly seeing you are beautified",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0055",
          "number": 55,
          "speechLineNumber": 5,
          "text": "With goodly shape, and by your own report",
          "plainText": "With goodly shape and by your own report",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0056",
          "number": 56,
          "speechLineNumber": 6,
          "text": "A linguist, and a man of such perfection",
          "plainText": "A linguist and a man of such perfection",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0057",
          "number": 57,
          "speechLineNumber": 7,
          "text": "As we do in our quality much want—",
          "plainText": "As we do in our quality much want",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-033",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Indeed because you are a banished man,",
          "plainText": "Indeed because you are a banished man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "Therefore, above the rest, we parley to you.",
          "plainText": "Therefore above the rest we parley to you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "Are you content to be our general?",
          "plainText": "Are you content to be our general",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0061",
          "number": 61,
          "speechLineNumber": 4,
          "text": "To make a virtue of necessity",
          "plainText": "To make a virtue of necessity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0062",
          "number": 62,
          "speechLineNumber": 5,
          "text": "And live as we do in this wilderness?",
          "plainText": "And live as we do in this wilderness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-034",
      "type": "speech",
      "speaker": {
        "id": "third-outlaw",
        "name": "THIRD OUTLAW",
        "displayName": "Third Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "What sayst thou? Wilt thou be of our consort?",
          "plainText": "What sayst thou Wilt thou be of our consort",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "Say \"Ay\", and be the captain of us all,",
          "plainText": "Say Ay and be the captain of us all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "We'll do thee homage and be ruled by thee,",
          "plainText": "We'll do thee homage and be ruled by thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "Love thee as our commander and our king.",
          "plainText": "Love thee as our commander and our king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-035",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "But if thou scorn our courtesy, thou diest.",
          "plainText": "But if thou scorn our courtesy thou diest",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-036",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Thou shalt not live to brag what we have offered.",
          "plainText": "Thou shalt not live to brag what we have offered",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-037",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "I take your offer and will live with you,",
          "plainText": "I take your offer and will live with you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "Provided that you do no outrages",
          "plainText": "Provided that you do no outrages",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0071",
          "number": 71,
          "speechLineNumber": 3,
          "text": "On silly women or poor passengers.",
          "plainText": "On silly women or poor passengers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-speech-038",
      "type": "speech",
      "speaker": {
        "id": "third-outlaw",
        "name": "THIRD OUTLAW",
        "displayName": "Third Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "No, we detest such vile base practices.",
          "plainText": "No we detest such vile base practices",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "Come, go with us; we'll bring thee to our crews",
          "plainText": "Come go with us we'll bring thee to our crews",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0074",
          "number": 74,
          "speechLineNumber": 3,
          "text": "And show thee all the treasure we have got,",
          "plainText": "And show thee all the treasure we have got",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-1-line-0075",
          "number": 75,
          "speechLineNumber": 4,
          "text": "Which, with ourselves, all rest at thy dispose.",
          "plainText": "Which with ourselves all rest at thy dispose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-1-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}