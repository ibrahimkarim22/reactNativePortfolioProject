    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.1/p@128337",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EGLAMOUR.\nFear not. The forest is not three leagues off;\nIf we recover that, we are sure enough.",
      "separatorAfter": "\n\n",
      "spans": [],
