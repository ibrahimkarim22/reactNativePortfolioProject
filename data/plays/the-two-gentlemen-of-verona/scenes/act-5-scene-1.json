    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.1/p@128178",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SILVIA.\nAmen, amen. Go on, good Eglamour,\nOut at the postern by the abbey wall.\nI fear I am attended by some spies.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
