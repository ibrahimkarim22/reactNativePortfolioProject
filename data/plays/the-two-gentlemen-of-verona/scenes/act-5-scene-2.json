    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128605",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Thurio, Proteus and Julia.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 21,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 26,
          "end": 31,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128605/line-1",
          "start": 0,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6609915,
        "end": 6610037,
        "line": 248051,
        "column": 1,
        "path": "chap37/p@128605",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128731",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THURIO.\nSir Proteus, what says Silvia to my suit?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128731/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128731/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610041,
        "end": 6610120,
        "line": 248056,
        "column": 1,
        "path": "chap37/p@128731",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "THURIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128814",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nO, sir, I find her milder than she was,\nAnd yet she takes exceptions at your person.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128814/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128814/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128814/line-3",
          "start": 49,
          "end": 93,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610124,
        "end": 6610252,
        "line": 248061,
        "column": 1,
        "path": "chap37/p@128814",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128946",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THURIO.\nWhat? That my leg is too long?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128946/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@128946/line-2",
          "start": 8,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610256,
        "end": 6610324,
        "line": 248067,
        "column": 1,
        "path": "chap37/p@128946",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "THURIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129018",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nNo, that it is too little.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129018/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129018/line-2",
          "start": 9,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610328,
        "end": 6610393,
        "line": 248072,
        "column": 1,
        "path": "chap37/p@129018",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129087",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THURIO.\nI’ll wear a boot to make it somewhat rounder.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129087/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129087/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610397,
        "end": 6610480,
        "line": 248077,
        "column": 1,
        "path": "chap37/p@129087",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "THURIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129174",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIA.\n[Aside.] But love will not be spurred to what it loathes.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 8,
          "end": 13
        }
      ],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129174/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129174/line-2",
          "start": 7,
          "end": 64,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610484,
        "end": 6610585,
        "line": 248082,
        "column": 1,
        "path": "chap37/p@129174",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "JULIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129279",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THURIO.\nWhat says she to my face?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129279/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129279/line-2",
          "start": 8,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610589,
        "end": 6610652,
        "line": 248087,
        "column": 1,
        "path": "chap37/p@129279",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "THURIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129346",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nShe says it is a fair one.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129346/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129346/line-2",
          "start": 9,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610656,
        "end": 6610721,
        "line": 248092,
        "column": 1,
        "path": "chap37/p@129346",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129415",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THURIO.\nNay, then, the wanton lies; my face is black.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129415/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129415/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610725,
        "end": 6610808,
        "line": 248097,
        "column": 1,
        "path": "chap37/p@129415",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "THURIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129502",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nBut pearls are fair; and the old saying is,\n“Black men are pearls in beauteous ladies’ eyes.”",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129502/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129502/line-2",
          "start": 9,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129502/line-3",
          "start": 53,
          "end": 102,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610812,
        "end": 6610949,
        "line": 248102,
        "column": 1,
        "path": "chap37/p@129502",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129643",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIA.\n[Aside.] ’Tis true, such pearls as put out ladies’ eyes,\nFor I had rather wink than look on them.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 8,
          "end": 13
        }
      ],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129643/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129643/line-2",
          "start": 7,
          "end": 63,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129643/line-3",
          "start": 64,
          "end": 104,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6610953,
        "end": 6611099,
        "line": 248108,
        "column": 1,
        "path": "chap37/p@129643",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "JULIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129793",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THURIO.\nHow likes she my discourse?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129793/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129793/line-2",
          "start": 8,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6611103,
        "end": 6611168,
        "line": 248114,
        "column": 1,
        "path": "chap37/p@129793",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "THURIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129862",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nIll, when you talk of war.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129862/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129862/line-2",
          "start": 9,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6611172,
        "end": 6611237,
        "line": 248119,
        "column": 1,
        "path": "chap37/p@129862",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "PROTEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129931",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THURIO.\nBut well when I discourse of love and peace.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129931/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@129931/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6611241,
        "end": 6611323,
        "line": 248124,
        "column": 1,
        "path": "chap37/p@129931",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "THURIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@130017",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JULIA.\n[Aside.] But better, indeed, when you hold your peace.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 8,
          "end": 13
        }
      ],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@130017/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@130017/line-2",
          "start": 7,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6611327,
        "end": 6611425,
        "line": 248129,
        "column": 1,
        "path": "chap37/p@130017",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "JULIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@130119",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THURIO.\nWhat says she to my valour?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@130119/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@130119/line-2",
          "start": 8,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6611429,
        "end": 6611494,
        "line": 248134,
        "column": 1,
        "path": "chap37/p@130119",
        "anchor": "sceneV_37.2"
      },
      "speakerLabel": "THURIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@130188",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PROTEUS.\nO, sir, she makes no doubt of that.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@130188/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.2/p@130188/line-2",
          "start": 9,
