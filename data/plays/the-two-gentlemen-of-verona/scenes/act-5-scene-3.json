      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SILVIA.\nA thousand more mischances than this one\nHave learned me how to brook this patiently.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
