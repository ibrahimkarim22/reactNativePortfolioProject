    },
    {
      "id": "the-two-gentlemen-of-verona/sceneV_37.3/p@133276",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST OUTLAW.\nWhere is the gentleman that was with her?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona/sceneV_37.3/p@133276/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
