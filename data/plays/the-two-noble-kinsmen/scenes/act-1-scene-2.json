      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCITE.\nOur uncle Creon.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.2/p@24896/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
