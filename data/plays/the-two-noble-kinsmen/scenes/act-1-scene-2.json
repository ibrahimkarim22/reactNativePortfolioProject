          "start": 193,
          "end": 220,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6651818,
        "end": 6652093,
        "line": 249625,
        "column": 1,
        "path": "chap38/p@25560",
        "anchor": "sceneI_38.2"
      },
      "speakerLabel": "ARCITE.",
      "attribution": {
