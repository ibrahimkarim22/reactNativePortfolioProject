    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.2/p@25560",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCITE.\nClear-spirited cousin,\nLet’s leave his court, that we may nothing share\nOf his loud infamy; for our milk\nWill relish of the pasture, and we must\nBe vile or disobedient; not his kinsmen\nIn blood unless in quality.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.2/p@25560/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.2/p@25560/line-2",
          "start": 8,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.2/p@25560/line-3",
          "start": 31,
          "end": 79,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.2/p@25560/line-4",
          "start": 80,
          "end": 112,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.2/p@25560/line-5",
          "start": 113,
          "end": 152,
          "sourceLineNumber": null
        },
        {
