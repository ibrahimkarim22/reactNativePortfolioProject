        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.2/p@25839",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PALAMON.\nNothing truer.\nI think the echoes of his shames have deafed\nThe ears of heavenly justice. Widows’ cries\nDescend again into their throats and have not\nDue audience of the gods.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.2/p@25839/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.2/p@25839/line-2",
          "start": 9,
          "end": 23,
          "sourceLineNumber": null
        },
        {
