    {
      "id": "the-two-noble-kinsmen/sceneI_38.2/p@23298",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PALAMON.\nYes, I pity\nDecays where’er I find them, but such most\nThat, sweating in an honourable toil,\nAre paid with ice to cool ’em.",
