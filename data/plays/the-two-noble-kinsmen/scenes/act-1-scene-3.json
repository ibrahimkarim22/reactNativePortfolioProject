    {
      "id": "the-two-noble-kinsmen/sceneI_38.3/p@29081",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nThanks, sir. Remember me\nTo our all-royal brother, for whose speed\nThe great Bellona I’ll solicit; and\nSince in our terrene state petitions are not\nWithout gifts understood, I’ll offer to her\nWhat I shall be advised she likes. Our hearts\nAre in his army, in his tent.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@29081/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@29081/line-2",
          "start": 8,
          "end": 32,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@29081/line-3",
          "start": 33,
          "end": 74,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@29081/line-4",
          "start": 75,
          "end": 110,
          "sourceLineNumber": null
        },
        {
