          "start": 156,
          "end": 199,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@29081/line-7",
          "start": 200,
          "end": 245,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@29081/line-8",
          "start": 246,
          "end": 275,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6655339,
        "end": 6655674,
        "line": 249762,
        "column": 1,
        "path": "chap38/p@29081",
        "anchor": "sceneI_38.3"
