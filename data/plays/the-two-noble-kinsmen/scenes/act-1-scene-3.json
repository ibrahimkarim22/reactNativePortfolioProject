    {
      "id": "the-two-noble-kinsmen/sceneI_38.3/p@29819",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PIRITHOUS.\nPeace be to you\nAs I pursue this war, which shall be then\nBeyond further requiring.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@29819/line-1",
