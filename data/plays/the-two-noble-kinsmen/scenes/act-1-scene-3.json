      ],
      "sourceRef": {
        "start": 6654681,
        "end": 6654733,
        "line": 249737,
        "column": 1,
        "path": "chap38/p@28423",
        "anchor": "sceneI_38.3"
      },
      "speakerLabel": "PIRITHOUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.3/p@28479",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HIPPOLYTA.\nSir, farewell. Repeat my wishes\nTo our great lord, of whose success I dare not\nMake any timorous question; yet I wish him\nExcess and overflow of power, an ’t might be,\nTo dure ill-dealing fortune. Speed to him!\nStore never hurts good governors.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28479/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28479/line-2",
          "start": 11,
          "end": 42,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28479/line-3",
          "start": 43,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28479/line-4",
          "start": 90,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28479/line-5",
          "start": 133,
          "end": 178,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28479/line-6",
          "start": 179,
          "end": 221,
          "sourceLineNumber": null
        },
        {
