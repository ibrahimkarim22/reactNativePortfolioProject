    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.3/p@29420",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HIPPOLYTA.\nIn ’s bosom.\nWe have been soldiers, and we cannot weep\nWhen our friends don their helms, or put to sea,\nOr tell of babes broached on the lance, or women\nThat have sod their infants in—and after eat them—\nThe brine they wept at killing ’em. Then if\nYou stay to see of us such spinsters, we\nShould hold you here for ever.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@29420/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@29420/line-2",
          "start": 11,
          "end": 23,
          "sourceLineNumber": null
        },
        {
