    {
      "id": "the-two-noble-kinsmen/sceneI_38.3/p@28793",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PIRITHOUS.\nThough I know\nHis ocean needs not my poor drops, yet they\nMust yield their tribute there. My precious maid,\nThose best affections that the heavens infuse\nIn their best-tempered pieces keep enthroned\nIn your dear heart!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28793/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28793/line-2",
          "start": 11,
          "end": 24,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28793/line-3",
          "start": 25,
          "end": 68,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28793/line-4",
          "start": 69,
          "end": 118,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28793/line-5",
          "start": 119,
          "end": 164,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28793/line-6",
          "start": 165,
          "end": 209,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@28793/line-7",
