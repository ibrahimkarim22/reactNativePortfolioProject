    {
      "id": "the-two-noble-kinsmen/sceneI_38.3/p@30037",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nHow his longing\nFollows his friend! Since his depart, his sports,\nThough craving seriousness and skill, passed slightly\nHis careless execution, where nor gain\nMade him regard, or loss consider, but\nPlaying one business in his hand, another\nDirecting in his head, his mind nurse equal\nTo these so differing twins. Have you observed him\nSince our great lord departed?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@30037/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@30037/line-2",
          "start": 8,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@30037/line-3",
          "start": 24,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@30037/line-4",
          "start": 74,
          "end": 127,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.3/p@30037/line-5",
