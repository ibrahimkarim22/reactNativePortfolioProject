    {
      "id": "the-two-noble-kinsmen/sceneI_38.4/p@34380",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST QUEEN.\nTo thee no star be dark!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@34380/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@34380/line-2",
          "start": 13,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6660638,
        "end": 6660705,
        "line": 249917,
        "column": 1,
        "path": "chap38/p@34380",
        "anchor": "sceneI_38.4"
      },
      "speakerLabel": "FIRST QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.4/p@34451",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND QUEEN.\nBoth heaven and earth\nFriend thee for ever!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@34451/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@34451/line-2",
          "start": 14,
          "end": 35,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@34451/line-3",
          "start": 36,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6660709,
        "end": 6660801,
        "line": 249922,
        "column": 1,
        "path": "chap38/p@34451",
        "anchor": "sceneI_38.4"
      },
      "speakerLabel": "SECOND QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.4/p@34547",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD QUEEN.\nAll the good that may\nBe wished upon thy head, I cry “Amen” to ’t!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@34547/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@34547/line-2",
          "start": 13,
          "end": 34,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@34547/line-3",
          "start": 35,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6660805,
        "end": 6660919,
        "line": 249928,
        "column": 1,
        "path": "chap38/p@34547",
        "anchor": "sceneI_38.4"
      },
      "speakerLabel": "THIRD QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.4/p@34665",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THESEUS.\nTh’ impartial gods, who from the mounted heavens\nView us their mortal herd, behold who err\nAnd, in their time, chastise. Go and find out\nThe bones of your dead lords and honour them\nWith treble ceremony, rather than a gap\nShould be in their dear rites, we would supply ’t,\nBut those we will depute which shall invest\nYou in your dignities and even each thing\nOur haste does leave imperfect. So, adieu,\nAnd heaven’s good eyes look on you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@34665/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@34665/line-2",
