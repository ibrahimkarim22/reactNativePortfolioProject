    {
      "id": "the-two-noble-kinsmen/sceneI_38.4/p@34063",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Cornets. A battle struck within; then a retreat. Flourish. Then enter, Theseus, as victor, with a Herald, other Lords, and Soldiers. The three Queens meet him and fall on their faces before him.",
      "separatorAfter": "\n\n",
      "spans": [
