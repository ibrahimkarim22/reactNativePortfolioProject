    {
      "id": "the-two-noble-kinsmen/sceneI_38.4/p@35238",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter a Herald and Soldiers bearing Palamon and Arcite on hearses.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 8,
          "end": 14,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 36,
          "end": 43,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 48,
          "end": 54,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.4/p@35238/line-1",
          "start": 0,
          "end": 66,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6661496,
