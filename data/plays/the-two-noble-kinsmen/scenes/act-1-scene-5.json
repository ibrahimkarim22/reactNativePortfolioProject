          "start": 14,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6664696,
        "end": 6664758,
        "line": 250057,
        "column": 1,
        "path": "chap38/p@38438",
        "anchor": "sceneI_38.5"
      },
      "speakerLabel": "SECOND QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.5/p@38504",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST QUEEN.\nYours this way. Heavens lend\nA thousand differing ways to one sure end.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38504/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38504/line-2",
          "start": 13,
          "end": 41,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38504/line-3",
          "start": 42,
          "end": 84,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6664762,
        "end": 6664881,
        "line": 250062,
        "column": 1,
        "path": "chap38/p@38504",
        "anchor": "sceneI_38.5"
      },
      "speakerLabel": "FIRST QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.5/p@38627",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD QUEEN.\nThis world’s a city full of straying streets,\nAnd death’s the market-place where each one meets.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38627/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38627/line-2",
          "start": 13,
          "end": 58,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38627/line-3",
          "start": 59,
          "end": 109,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6664885,
        "end": 6665029,
        "line": 250068,
        "column": 1,
        "path": "chap38/p@38627",
        "anchor": "sceneI_38.5"
      },
      "speakerLabel": "THIRD QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.5/p@38775",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt severally.]",
