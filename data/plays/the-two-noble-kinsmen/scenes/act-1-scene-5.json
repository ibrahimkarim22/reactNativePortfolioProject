          "start": 0,
          "end": 30,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38105/line-2",
          "start": 31,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38105/line-3",
          "start": 68,
          "end": 100,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38105/line-4",
          "start": 101,
          "end": 133,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
