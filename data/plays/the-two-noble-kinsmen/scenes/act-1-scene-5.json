    {
      "id": "the-two-noble-kinsmen/sceneI_38.5/p@38105",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Come, all sad and solemn shows\nThat are quick-eyed Pleasure’s foes;\nWe convent naught else but woes.\nWe convent naught else but woes.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 0,
          "end": 133
        }
      ],
      "lines": [
