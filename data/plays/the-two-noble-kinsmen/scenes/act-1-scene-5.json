    {
      "id": "the-two-noble-kinsmen/sceneI_38.5/p@37839",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Urns and odours bring away;\nVapours, sighs, darken the day;\nOur dole more deadly looks than dying;\nBalms and gums and heavy cheers,\nSacred vials filled with tears,\nAnd clamours through the wild air flying.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 0,
          "end": 205
        }
      ],
      "lines": [
