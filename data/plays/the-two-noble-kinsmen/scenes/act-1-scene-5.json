      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.5/p@38289",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD QUEEN.\nThis funeral path brings to your household’s grave.\nJoy seize on you again; peace sleep with him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38289/line-1",
          "start": 0,
          "end": 12,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38289/line-2",
          "start": 13,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38289/line-3",
          "start": 65,
          "end": 110,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6664547,
        "end": 6664692,
        "line": 250051,
        "column": 1,
        "path": "chap38/p@38289",
        "anchor": "sceneI_38.5"
      },
      "speakerLabel": "THIRD QUEEN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 12
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneI_38.5/p@38438",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND QUEEN.\nAnd this to yours.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneI_38.5/p@38438/line-1",
          "start": 0,
          "end": 13,
          "sourceLineNumber": null
        },
        {
