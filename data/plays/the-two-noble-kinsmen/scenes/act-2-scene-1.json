  "content": [
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/h3@38931",
      "type": "heading",
      "tag": "h3",
      "classes": [],
      "text": "SCENE I. Athens. A garden, with a castle in the background",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "b",
          "start": 0,
          "end": 58
        }
      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/h3@38931/line-1",
          "start": 0,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
