      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@39010",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Jailer and Wooer.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 12,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 17,
          "end": 22,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@39010/line-1",
          "start": 0,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6665268,
        "end": 6665381,
        "line": 250084,
        "column": 1,
        "path": "chap38/p@39010",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@39127",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAILER.\nI may depart with little while I live; something I may cast to you, not much. Alas, the prison I keep, though it be for great ones, yet they seldom come; before one salmon, you shall take a number of minnows. I am given out to be better lined than it can appear to me report is a true speaker. I would I were really that I am delivered to be. Marry, what I have, be it what it will, I will assure upon my daughter at the day of my death.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@39127/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@39127/line-2",
          "start": 8,
          "end": 445,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6665385,
        "end": 6665865,
        "line": 250089,
        "column": 1,
        "path": "chap38/p@39127",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "JAILER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@39611",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WOOER.\nSir, I demand no more than your own offer, and I will estate your daughter in what I have promised.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@39611/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@39611/line-2",
          "start": 7,
          "end": 106,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6665869,
        "end": 6666006,
        "line": 250099,
        "column": 1,
        "path": "chap38/p@39611",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "WOOER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@39752",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAILER.\nWell, we will talk more of this when the solemnity is past. But have you a full promise of her? When that shall be seen, I tender my consent.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@39752/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@39752/line-2",
          "start": 8,
          "end": 149,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6666010,
        "end": 6666190,
        "line": 250105,
        "column": 1,
        "path": "chap38/p@39752",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "JAILER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@39936",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter the Jailer’s Daughter, carrying rushes.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 19,
          "end": 28,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@39936/line-1",
          "start": 0,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6666194,
        "end": 6666298,
        "line": 250111,
        "column": 1,
        "path": "chap38/p@39936",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@40044",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WOOER.\nI have sir. Here she comes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40044/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40044/line-2",
          "start": 7,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6666302,
        "end": 6666366,
        "line": 250115,
        "column": 1,
        "path": "chap38/p@40044",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "WOOER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@40112",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAILER.\nYour friend and I have chanced to name you here, upon the old business. But no more of that now; so soon as the court hurry is over, we will have an end of it. I’ th’ meantime, look tenderly to the two prisoners. I can tell you they are princes.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40112/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40112/line-2",
          "start": 8,
          "end": 253,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6666370,
        "end": 6666656,
        "line": 250120,
        "column": 1,
        "path": "chap38/p@40112",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "JAILER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@40402",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAUGHTER.\nThese strewings are for their chamber. ’Tis pity they are in prison, and ’twere pity they should be out. I do think they have patience to make any adversity ashamed. The prison itself is proud of ’em, and they have all the world in their chamber.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40402/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40402/line-2",
          "start": 10,
          "end": 256,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6666660,
        "end": 6666949,
        "line": 250128,
        "column": 1,
        "path": "chap38/p@40402",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "DAUGHTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@40695",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAILER.\nThey are famed to be a pair of absolute men.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40695/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40695/line-2",
          "start": 8,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6666953,
        "end": 6667035,
        "line": 250136,
        "column": 1,
        "path": "chap38/p@40695",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "JAILER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@40781",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAUGHTER.\nBy my troth, I think fame but stammers ’em; they stand a grise above the reach of report.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40781/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40781/line-2",
          "start": 10,
          "end": 99,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6667039,
        "end": 6667169,
        "line": 250141,
        "column": 1,
        "path": "chap38/p@40781",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "DAUGHTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@40915",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAILER.\nI heard them reported in the battle to be the only doers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40915/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@40915/line-2",
          "start": 8,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6667173,
        "end": 6667268,
        "line": 250147,
        "column": 1,
        "path": "chap38/p@40915",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "JAILER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@41014",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAUGHTER.\nNay, most likely, for they are noble sufferers. I marvel how they would have looked had they been victors, that with such a constant nobility enforce a freedom out of bondage, making misery their mirth and affliction a toy to jest at.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41014/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41014/line-2",
          "start": 10,
          "end": 244,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6667272,
        "end": 6667549,
        "line": 250152,
        "column": 1,
        "path": "chap38/p@41014",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "DAUGHTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@41295",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAILER.\nDo they so?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41295/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41295/line-2",
          "start": 8,
          "end": 19,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6667553,
        "end": 6667602,
        "line": 250160,
        "column": 1,
        "path": "chap38/p@41295",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "JAILER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@41348",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAUGHTER.\nIt seems to me they have no more sense of their captivity than I of ruling Athens. They eat well, look merrily, discourse of many things, but nothing of their own restraint and disasters. Yet sometime a divided sigh, martyred as ’twere i’ th’ deliverance, will break from one of them—when the other presently gives it so sweet a rebuke that I could wish myself a sigh to be so chid, or at least a sigher to be comforted.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41348/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41348/line-2",
          "start": 10,
          "end": 430,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6667606,
        "end": 6668071,
        "line": 250165,
        "column": 1,
        "path": "chap38/p@41348",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "DAUGHTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@41817",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "WOOER.\nI never saw ’em.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41817/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41817/line-2",
          "start": 7,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6668075,
        "end": 6668128,
        "line": 250175,
        "column": 1,
        "path": "chap38/p@41817",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "WOOER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@41874",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAILER.\nThe Duke himself came privately in the night, and so did they.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41874/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41874/line-2",
          "start": 8,
          "end": 70,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6668132,
        "end": 6668232,
        "line": 250180,
        "column": 1,
        "path": "chap38/p@41874",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": "JAILER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@41978",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Palamon and Arcite, above.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 18,
          "end": 25,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@41978/line-1",
          "start": 0,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6668236,
        "end": 6668358,
        "line": 250185,
        "column": 1,
        "path": "chap38/p@41978",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@42104",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "What the reason of it is, I know not. Look, yonder they are; that’s Arcite looks out.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.1/p@42104/line-1",
          "start": 0,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6668362,
        "end": 6668473,
        "line": 250190,
        "column": 1,
        "path": "chap38/p@42104",
        "anchor": "sceneII_38.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.1/p@42219",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
