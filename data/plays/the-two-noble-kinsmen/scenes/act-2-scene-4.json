  "scene": {
    "id": "the-two-noble-kinsmen-2-4",
    "act": 2,
    "scene": 4,
    "label": "Act 2, Scene 4",
    "title": "SCENE IV. Athens. A room in the prison",
    "location": "Athens. A room in the prison",
    "orderInPlay": 9
  },
  "content": [
    {
      "id": "the-two-noble-kinsmen-2-4-stage-001",
      "type": "stage",
      "text": "Enter Jailer's Daughter alone."
    },
    {
      "id": "the-two-noble-kinsmen-2-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "daughter",
        "name": "DAUGHTER",
        "displayName": "Daughter"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Why should I love this gentleman? 'Tis odds",
          "plainText": "Why should I love this gentleman 'Tis odds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "He never will affect me. I am base,",
          "plainText": "He never will affect me I am base",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "My father the mean keeper of his prison,",
          "plainText": "My father the mean keeper of his prison",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And he a prince. To marry him is hopeless;",
          "plainText": "And he a prince To marry him is hopeless",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "To be his whore is witless. Out upon 't!",
          "plainText": "To be his whore is witless Out upon 't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "What pushes are we wenches driven to",
          "plainText": "What pushes are we wenches driven to",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "When fifteen once has found us! First, I saw him;",
          "plainText": "When fifteen once has found us First I saw him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "I, seeing, thought he was a goodly man;",
          "plainText": "I seeing thought he was a goodly man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "He has as much to please a woman in him,",
          "plainText": "He has as much to please a woman in him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "If he please to bestow it so, as ever",
          "plainText": "If he please to bestow it so as ever",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "These eyes yet looked on. Next, I pitied him,",
          "plainText": "These eyes yet looked on Next I pitied him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "And so would any young wench, o' my conscience,",
          "plainText": "And so would any young wench o' my conscience",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "That ever dreamed, or vowed her maidenhead",
          "plainText": "That ever dreamed or vowed her maidenhead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "To a young handsome man. Then I loved him,",
          "plainText": "To a young handsome man Then I loved him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "Extremely loved him, infinitely loved him!",
          "plainText": "Extremely loved him infinitely loved him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "And yet he had a cousin, fair as he too,",
          "plainText": "And yet he had a cousin fair as he too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "But in my heart was Palamon, and there,",
          "plainText": "But in my heart was Palamon and there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Lord, what a coil he keeps! To hear him",
          "plainText": "Lord what a coil he keeps To hear him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "Sing in an evening, what a heaven it is!",
          "plainText": "Sing in an evening what a heaven it is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "And yet his songs are sad ones. Fairer spoken",
          "plainText": "And yet his songs are sad ones Fairer spoken",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "Was never gentleman. When I come in",
          "plainText": "Was never gentleman When I come in",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "To bring him water in a morning, first",
          "plainText": "To bring him water in a morning first",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "He bows his noble body, then salutes me thus:",
          "plainText": "He bows his noble body then salutes me thus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "\"Fair, gentle maid, good morrow. May thy goodness",
          "plainText": "Fair gentle maid good morrow May thy goodness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0025",
          "number": 25,
          "speechLineNumber": 25,
          "text": "Get thee a happy husband.\" Once he kissed me;",
          "plainText": "Get thee a happy husband Once he kissed me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0026",
          "number": 26,
          "speechLineNumber": 26,
          "text": "I loved my lips the better ten days after.",
          "plainText": "I loved my lips the better ten days after",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0027",
          "number": 27,
          "speechLineNumber": 27,
          "text": "Would he would do so ev'ry day! He grieves much—",
          "plainText": "Would he would do so ev'ry day He grieves much",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0028",
          "number": 28,
          "speechLineNumber": 28,
          "text": "And me as much to see his misery.",
          "plainText": "And me as much to see his misery",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0029",
          "number": 29,
          "speechLineNumber": 29,
          "text": "What should I do to make him know I love him?",
          "plainText": "What should I do to make him know I love him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0030",
          "number": 30,
          "speechLineNumber": 30,
          "text": "For I would fain enjoy him. Say I ventured",
          "plainText": "For I would fain enjoy him Say I ventured",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0031",
          "number": 31,
          "speechLineNumber": 31,
          "text": "To set him free? What says the law then?",
          "plainText": "To set him free What says the law then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0032",
          "number": 32,
          "speechLineNumber": 32,
          "text": "Thus much for law or kindred! I will do it;",
          "plainText": "Thus much for law or kindred I will do it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-4-line-0033",
          "number": 33,
          "speechLineNumber": 33,
          "text": "And this night, or tomorrow, he shall love me.",
          "plainText": "And this night or tomorrow he shall love me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-4-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}