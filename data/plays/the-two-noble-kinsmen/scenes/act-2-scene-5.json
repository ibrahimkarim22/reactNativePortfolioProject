        "start": 6697800,
        "end": 6697933,
        "line": 251447,
        "column": 1,
        "path": "chap38/p@71542",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "EMILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@71679",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HIPPOLYTA.\nBut his body\nAnd fiery mind illustrate a brave father.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71679/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71679/line-2",
          "start": 11,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71679/line-3",
          "start": 24,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6697937,
        "end": 6698037,
        "line": 251454,
        "column": 1,
        "path": "chap38/p@71679",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "HIPPOLYTA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@71783",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PIRITHOUS.\nMark how his virtue, like a hidden sun,\nBreaks through his baser garments.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71783/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71783/line-2",
          "start": 11,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71783/line-3",
          "start": 51,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6698041,
        "end": 6698161,
        "line": 251460,
        "column": 1,
        "path": "chap38/p@71783",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "PIRITHOUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@71907",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HIPPOLYTA.\nHe’s well got, sure.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71907/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71907/line-2",
          "start": 11,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6698165,
        "end": 6698226,
        "line": 251466,
        "column": 1,
        "path": "chap38/p@71907",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "HIPPOLYTA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@71972",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THESEUS.\nWhat made you seek this place, sir?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71972/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71972/line-2",
          "start": 9,
          "end": 44,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6698230,
        "end": 6698304,
        "line": 251471,
        "column": 1,
        "path": "chap38/p@71972",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "THESEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@72050",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCITE.\nNoble Theseus,\nTo purchase name and do my ablest service\nTo such a well-found wonder as thy worth;\nFor only in thy court, of all the world,\nDwells fair-eyed Honour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72050/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72050/line-2",
          "start": 8,
          "end": 22,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72050/line-3",
          "start": 23,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72050/line-4",
          "start": 65,
          "end": 106,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72050/line-5",
          "start": 107,
          "end": 147,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72050/line-6",
          "start": 148,
          "end": 172,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6698308,
        "end": 6698530,
        "line": 251476,
        "column": 1,
        "path": "chap38/p@72050",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "ARCITE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@72276",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PIRITHOUS.\nAll his words are worthy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72276/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72276/line-2",
          "start": 11,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6698534,
        "end": 6698600,
        "line": 251485,
        "column": 1,
        "path": "chap38/p@72276",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "PIRITHOUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@72346",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THESEUS.\nSir, we are much indebted to your travel,\nNor shall you lose your wish.—Pirithous,\nDispose of this fair gentleman.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72346/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72346/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72346/line-3",
          "start": 51,
          "end": 91,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72346/line-4",
          "start": 92,
          "end": 123,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6698604,
        "end": 6698767,
        "line": 251490,
        "column": 1,
        "path": "chap38/p@72346",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "THESEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@72513",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PIRITHOUS.\nThanks, Theseus.\nWhate’er you are, you’re mine, and I shall give you\nTo a most noble service: to this lady,\nThis bright young virgin; pray, observe her goodness.\nYou have honoured her fair birthday with your virtues,\nAnd, as your due, you’re hers; kiss her fair hand, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72513/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72513/line-2",
          "start": 11,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72513/line-3",
          "start": 28,
          "end": 79,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72513/line-4",
          "start": 80,
          "end": 118,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72513/line-5",
          "start": 119,
          "end": 172,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72513/line-6",
          "start": 173,
          "end": 227,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72513/line-7",
          "start": 228,
          "end": 283,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6698771,
        "end": 6699109,
        "line": 251497,
        "column": 1,
        "path": "chap38/p@72513",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "PIRITHOUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@72855",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCITE.\nSir, you’re a noble giver.—Dearest beauty,\nThus let me seal my vowed faith.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72855/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72855/line-2",
          "start": 8,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72855/line-3",
          "start": 51,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6699113,
        "end": 6699231,
        "line": 251507,
        "column": 1,
        "path": "chap38/p@72855",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "ARCITE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@72977",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[He kisses her hand.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 20
        }
      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@72977/line-1",
          "start": 0,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6699235,
        "end": 6699284,
        "line": 251513,
        "column": 1,
        "path": "chap38/p@72977",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@73030",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "When your servant,\nYour most unworthy creature, but offends you,\nCommand him die, he shall.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73030/line-1",
          "start": 0,
          "end": 18,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73030/line-2",
          "start": 19,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73030/line-3",
          "start": 65,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6699288,
        "end": 6699414,
        "line": 251515,
        "column": 1,
        "path": "chap38/p@73030",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@73160",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nThat were too cruel.\nIf you deserve well, sir, I shall soon see ’t.\nYou’re mine, and somewhat better than your rank\nI’ll use you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73160/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73160/line-2",
          "start": 8,
          "end": 28,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73160/line-3",
          "start": 29,
          "end": 75,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73160/line-4",
          "start": 76,
          "end": 123,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73160/line-5",
          "start": 124,
          "end": 137,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6699418,
        "end": 6699600,
        "line": 251521,
        "column": 1,
        "path": "chap38/p@73160",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "EMILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@73346",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PIRITHOUS.\nI’ll see you furnished, and because you say\nYou are a horseman, I must needs entreat you\nThis afternoon to ride, but ’tis a rough one.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73346/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73346/line-2",
          "start": 11,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73346/line-3",
          "start": 55,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73346/line-4",
          "start": 100,
          "end": 145,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6699604,
        "end": 6699789,
        "line": 251529,
        "column": 1,
        "path": "chap38/p@73346",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "PIRITHOUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@73535",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCITE.\nI like him better, Prince; I shall not then\nFreeze in my saddle.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73535/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73535/line-2",
          "start": 8,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73535/line-3",
          "start": 52,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6699793,
        "end": 6699900,
        "line": 251536,
        "column": 1,
        "path": "chap38/p@73535",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "ARCITE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@73646",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THESEUS.\nSweet, you must be ready,—\nAnd you, Emilia,—and you, friend,—and all,\nTomorrow by the sun, to do observance\nTo flowery May, in Dian’s wood.—Wait well, sir,\nUpon your mistress.—Emily, I hope\nHe shall not go afoot.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73646/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73646/line-2",
          "start": 9,
          "end": 35,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73646/line-3",
          "start": 36,
          "end": 78,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73646/line-4",
          "start": 79,
          "end": 116,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73646/line-5",
          "start": 117,
          "end": 164,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73646/line-6",
          "start": 165,
          "end": 198,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@73646/line-7",
          "start": 199,
          "end": 221,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6699904,
        "end": 6700180,
        "line": 251542,
        "column": 1,
        "path": "chap38/p@73646",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "THESEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@73926",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nThat were a shame, sir,\nWhile I have horses.—Take your choice, and what\nYou want at any time, let me but know it.\nIf you serve faithfully, I dare assure you\nYou’ll find a loving mistress.",
      "separatorAfter": "\n\n",
