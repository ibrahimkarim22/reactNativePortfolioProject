    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@69797",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "A short flourish of cornets and shouts within. Enter Theseus, Hippolyta, Pirithous, Emilia; Arcite in disguise as a countryman, with a garland, Attendants, and others.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 53,
          "end": 98,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@69797/line-1",
          "start": 0,
          "end": 167,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6696055,
        "end": 6696282,
        "line": 251355,
        "column": 1,
        "path": "chap38/p@69797",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@70028",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THESEUS.\nYou have done worthily. I have not seen,\nSince Hercules, a man of tougher sinews.\nWhate’er you are, you run the best and wrestle,\nThat these times can allow.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70028/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70028/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70028/line-3",
          "start": 50,
          "end": 90,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70028/line-4",
          "start": 91,
          "end": 138,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70028/line-5",
          "start": 139,
          "end": 166,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6696286,
        "end": 6696497,
        "line": 251360,
        "column": 1,
        "path": "chap38/p@70028",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "THESEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@70243",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCITE.\nI am proud to please you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70243/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70243/line-2",
          "start": 8,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6696501,
        "end": 6696564,
        "line": 251368,
        "column": 1,
        "path": "chap38/p@70243",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "ARCITE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@70310",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THESEUS.\nWhat country bred you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70310/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70310/line-2",
          "start": 9,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6696568,
        "end": 6696629,
        "line": 251373,
        "column": 1,
        "path": "chap38/p@70310",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "THESEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@70375",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCITE.\nThis; but far off, Prince.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70375/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70375/line-2",
          "start": 8,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6696633,
        "end": 6696697,
        "line": 251378,
        "column": 1,
        "path": "chap38/p@70375",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "ARCITE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@70443",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THESEUS.\nAre you a gentleman?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70443/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70443/line-2",
          "start": 9,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6696701,
        "end": 6696760,
        "line": 251383,
        "column": 1,
        "path": "chap38/p@70443",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "THESEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@70506",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCITE.\nMy father said so;\nAnd to those gentle uses gave me life.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70506/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70506/line-2",
          "start": 8,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70506/line-3",
          "start": 27,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6696764,
        "end": 6696864,
        "line": 251388,
        "column": 1,
        "path": "chap38/p@70506",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "ARCITE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@70610",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THESEUS.\nAre you his heir?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70610/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70610/line-2",
          "start": 9,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6696868,
        "end": 6696924,
        "line": 251394,
        "column": 1,
        "path": "chap38/p@70610",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "THESEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@70670",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCITE.\nHis youngest, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70670/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70670/line-2",
          "start": 8,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6696928,
        "end": 6696984,
        "line": 251399,
        "column": 1,
        "path": "chap38/p@70670",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "ARCITE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@70730",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THESEUS.\nYour father\nSure is a happy sire then. What profess you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70730/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70730/line-2",
          "start": 9,
          "end": 20,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70730/line-3",
          "start": 21,
          "end": 65,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6696988,
        "end": 6697088,
        "line": 251404,
        "column": 1,
        "path": "chap38/p@70730",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "THESEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@70834",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ARCITE.\nA little of all noble qualities.\nI could have kept a hawk and well have hallowed\nTo a deep cry of dogs. I dare not praise\nMy feat in horsemanship, yet they that knew me\nWould say it was my best piece; last, and greatest,\nI would be thought a soldier.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70834/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70834/line-2",
          "start": 8,
          "end": 40,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70834/line-3",
          "start": 41,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70834/line-4",
          "start": 89,
          "end": 129,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70834/line-5",
          "start": 130,
          "end": 176,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70834/line-6",
          "start": 177,
          "end": 228,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@70834/line-7",
          "start": 229,
          "end": 258,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6697092,
        "end": 6697405,
        "line": 251410,
        "column": 1,
        "path": "chap38/p@70834",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "ARCITE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@71151",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THESEUS.\nYou are perfect.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71151/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71151/line-2",
          "start": 9,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6697409,
        "end": 6697464,
        "line": 251420,
        "column": 1,
        "path": "chap38/p@71151",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "THESEUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@71210",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PIRITHOUS.\nUpon my soul, a proper man.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71210/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71210/line-2",
          "start": 11,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6697468,
        "end": 6697536,
        "line": 251425,
        "column": 1,
        "path": "chap38/p@71210",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "PIRITHOUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@71282",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nHe is so.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71282/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71282/line-2",
          "start": 8,
          "end": 17,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6697540,
        "end": 6697587,
        "line": 251430,
        "column": 1,
        "path": "chap38/p@71282",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "EMILIA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@71333",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PIRITHOUS.\nHow do you like him, lady?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71333/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71333/line-2",
          "start": 11,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6697591,
        "end": 6697658,
        "line": 251435,
        "column": 1,
        "path": "chap38/p@71333",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "PIRITHOUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@71404",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HIPPOLYTA.\nI admire him.\nI have not seen so young a man so noble,\nIf he say true, of his sort.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71404/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71404/line-2",
          "start": 11,
          "end": 24,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71404/line-3",
          "start": 25,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71404/line-4",
          "start": 66,
          "end": 94,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6697662,
        "end": 6697796,
        "line": 251440,
        "column": 1,
        "path": "chap38/p@71404",
        "anchor": "sceneII_38.5"
      },
      "speakerLabel": "HIPPOLYTA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneII_38.5/p@71542",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nBelieve,\nHis mother was a wondrous handsome woman;\nHis face, methinks, goes that way.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71542/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneII_38.5/p@71542/line-2",
          "start": 8,
