  "content": [
    {
      "id": "the-two-noble-kinsmen-3-3-stage-001",
      "type": "stage",
      "text": "Enter Arcite with meat, wine and files."
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I should be near the place.—Ho! Cousin Palamon!",
          "plainText": "I should be near the placeHo Cousin Palamon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "[From the bush.] Arcite?",
          "plainText": "From the bush Arcite",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "The same. I have brought you food and files.",
          "plainText": "The same I have brought you food and files",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Come forth and fear not; here's no Theseus.",
          "plainText": "Come forth and fear not here's no Theseus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-stage-002",
      "type": "stage",
      "text": "Enter Palamon."
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Nor none so honest, Arcite.",
          "plainText": "Nor none so honest Arcite",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "That's no matter.",
          "plainText": "That's no matter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "We'll argue that hereafter. Come, take courage;",
          "plainText": "We'll argue that hereafter Come take courage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "You shall not die thus beastly. Here, sir, drink—",
          "plainText": "You shall not die thus beastly Here sir drink",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "I know you are faint—then I'll talk further with you.",
          "plainText": "I know you are faintthen I'll talk further with you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Arcite, thou mightst now poison me.",
          "plainText": "Arcite thou mightst now poison me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "I might;",
          "plainText": "I might",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "But I must fear you first. Sit down and, good now,",
          "plainText": "But I must fear you first Sit down and good now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "No more of these vain parleys; let us not,",
          "plainText": "No more of these vain parleys let us not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "Having our ancient reputation with us,",
          "plainText": "Having our ancient reputation with us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "Make talk for fools and cowards. To your health.",
          "plainText": "Make talk for fools and cowards To your health",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-stage-003",
      "type": "stage",
      "text": "[Drinks.]"
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Do.",
          "plainText": "Do",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Pray sit down, then, and let me entreat you,",
          "plainText": "Pray sit down then and let me entreat you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "By all the honesty and honour in you,",
          "plainText": "By all the honesty and honour in you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "No mention of this woman; 'twill disturb us.",
          "plainText": "No mention of this woman 'twill disturb us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "We shall have time enough.",
          "plainText": "We shall have time enough",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Well, sir, I'll pledge you.",
          "plainText": "Well sir I'll pledge you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-stage-004",
      "type": "stage",
      "text": "[Drinks.]"
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Drink a good hearty draught; it breeds good blood, man.",
          "plainText": "Drink a good hearty draught it breeds good blood man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Do not you feel it thaw you?",
          "plainText": "Do not you feel it thaw you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Stay, I'll tell you",
          "plainText": "Stay I'll tell you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "After a draught or two more.",
          "plainText": "After a draught or two more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Spare it not; the Duke has more, coz. Eat now.",
          "plainText": "Spare it not the Duke has more coz Eat now",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Yes.",
          "plainText": "Yes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-stage-005",
      "type": "stage",
      "text": "[Eats.]"
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "I am glad you have so good a stomach.",
          "plainText": "I am glad you have so good a stomach",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I am gladder I have so good meat to 't.",
          "plainText": "I am gladder I have so good meat to 't",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Is't not mad lodging,",
          "plainText": "Is't not mad lodging",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "Here in the wild woods, cousin?",
          "plainText": "Here in the wild woods cousin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Yes, for them",
          "plainText": "Yes for them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "That have wild consciences.",
          "plainText": "That have wild consciences",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "How tastes your victuals?",
          "plainText": "How tastes your victuals",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Your hunger needs no sauce, I see.",
          "plainText": "Your hunger needs no sauce I see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Not much.",
          "plainText": "Not much",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "But if it did, yours is too tart, sweet cousin.",
          "plainText": "But if it did yours is too tart sweet cousin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0038",
          "number": 38,
          "speechLineNumber": 3,
          "text": "What is this?",
          "plainText": "What is this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Venison.",
          "plainText": "Venison",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "'Tis a lusty meat.",
          "plainText": "'Tis a lusty meat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Give me more wine. Here, Arcite, to the wenches",
          "plainText": "Give me more wine Here Arcite to the wenches",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "We have known in our days! The Lord Steward's daughter,",
          "plainText": "We have known in our days The Lord Steward's daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "Do you remember her?",
          "plainText": "Do you remember her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "After you, coz.",
          "plainText": "After you coz",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "She loved a black-haired man.",
          "plainText": "She loved a blackhaired man",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "She did so; well, sir?",
          "plainText": "She did so well sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "And I have heard some call him Arcite, and—",
          "plainText": "And I have heard some call him Arcite and",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Out with't, faith.",
          "plainText": "Out with't faith",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "She met him in an arbour.",
          "plainText": "She met him in an arbour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "What did she there, coz? Play o' th' virginals?",
          "plainText": "What did she there coz Play o' th' virginals",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Something she did, sir.",
          "plainText": "Something she did sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Made her groan a month for 't,",
          "plainText": "Made her groan a month for 't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Or two, or three, or ten.",
          "plainText": "Or two or three or ten",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-031",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "The Marshal's sister",
          "plainText": "The Marshal's sister",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "Had her share too, as I remember, cousin,",
          "plainText": "Had her share too as I remember cousin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0056",
          "number": 56,
          "speechLineNumber": 3,
          "text": "Else there be tales abroad. You'll pledge her?",
          "plainText": "Else there be tales abroad You'll pledge her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-032",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Yes.",
          "plainText": "Yes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-033",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "A pretty brown wench 'tis. There was a time",
          "plainText": "A pretty brown wench 'tis There was a time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "When young men went a-hunting, and a wood,",
          "plainText": "When young men went ahunting and a wood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "And a broad beech; and thereby hangs a tale.",
          "plainText": "And a broad beech and thereby hangs a tale",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0061",
          "number": 61,
          "speechLineNumber": 4,
          "text": "Heigh ho!",
          "plainText": "Heigh ho",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-034",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "For Emily, upon my life! Fool,",
          "plainText": "For Emily upon my life Fool",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "Away with this strained mirth! I say again",
          "plainText": "Away with this strained mirth I say again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "That sigh was breathed for Emily. Base cousin,",
          "plainText": "That sigh was breathed for Emily Base cousin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "Dar'st thou break first?",
          "plainText": "Dar'st thou break first",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-035",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "You are wide.",
          "plainText": "You are wide",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-036",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "By heaven and earth,",
          "plainText": "By heaven and earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "There's nothing in thee honest.",
          "plainText": "There's nothing in thee honest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-037",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Then I'll leave you.",
          "plainText": "Then I'll leave you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "You are a beast now.",
          "plainText": "You are a beast now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-038",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "As thou mak'st me, traitor.",
          "plainText": "As thou mak'st me traitor",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-039",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "There's all things needful: files and shirts and perfumes.",
          "plainText": "There's all things needful files and shirts and perfumes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "I'll come again some two hours hence, and bring",
          "plainText": "I'll come again some two hours hence and bring",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0074",
          "number": 74,
          "speechLineNumber": 3,
          "text": "That that shall quiet all.",
          "plainText": "That that shall quiet all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-040",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "A sword and armour?",
          "plainText": "A sword and armour",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-041",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Fear me not. You are now too foul. Farewell.",
          "plainText": "Fear me not You are now too foul Farewell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-3-3-line-0077",
          "number": 77,
          "speechLineNumber": 2,
          "text": "Get off your trinkets; you shall want naught.",
          "plainText": "Get off your trinkets you shall want naught",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-042",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "Sirrah—",
          "plainText": "Sirrah",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-043",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "I'll hear no more.",
          "plainText": "I'll hear no more",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-two-noble-kinsmen-3-3-speech-044",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-3-3-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "If he keep touch, he dies for 't.",
          "plainText": "If he keep touch he dies for 't",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-3-3-stage-007",
