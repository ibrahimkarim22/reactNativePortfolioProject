    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@151195",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOCTOR.\nI think she has a perturbed mind, which I cannot minister to.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@151195/line-1",
