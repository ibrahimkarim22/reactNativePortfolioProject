      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@147810",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOCTOR.\nHer distraction is more at some time of the moon, than at other some, is it not?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@147810/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@147810/line-2",
          "start": 8,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6774068,
        "end": 6774187,
        "line": 254571,
        "column": 1,
        "path": "chap38/p@147810",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "DOCTOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@147933",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAILER.\nShe is continually in a harmless distemper, sleeps little, altogether without appetite, save often drinking, dreaming of another world, and a better; and what broken piece of matter soe’er she’s about, the name Palamon lards it, that she farces every business withal, fits it to every question.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@147933/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@147933/line-2",
          "start": 8,
          "end": 302,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6774191,
        "end": 6774526,
        "line": 254577,
        "column": 1,
        "path": "chap38/p@147933",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "JAILER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148272",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Jailer’s Daughter.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 15,
          "end": 23,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148272/line-1",
          "start": 0,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6774530,
        "end": 6774613,
        "line": 254585,
        "column": 1,
        "path": "chap38/p@148272",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148359",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Look where she comes; you shall perceive her behaviour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148359/line-1",
          "start": 0,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6774617,
        "end": 6774697,
        "line": 254589,
        "column": 1,
        "path": "chap38/p@148359",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148443",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAUGHTER.\nI have forgot it quite. The burden on ’t was “Down-a, down-a,” and penned by no worse man than Geraldo, Emilia’s schoolmaster. He’s as fantastical, too, as ever he may go upon’s legs, for in the next world will Dido see Palamon, and then will she be out of love with Æneas.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148443/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148443/line-2",
          "start": 10,
          "end": 283,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6774701,
        "end": 6775017,
        "line": 254593,
        "column": 1,
        "path": "chap38/p@148443",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "DAUGHTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148763",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOCTOR.\nWhat stuff’s here? Poor soul!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148763/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148763/line-2",
          "start": 8,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6775021,
        "end": 6775088,
        "line": 254601,
        "column": 1,
        "path": "chap38/p@148763",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "DOCTOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148834",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAILER.\nEven thus all day long.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148834/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148834/line-2",
          "start": 8,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6775092,
        "end": 6775153,
        "line": 254606,
        "column": 1,
        "path": "chap38/p@148834",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "JAILER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148899",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAUGHTER.\nNow for this charm that I told you of: you must bring a piece of silver on the tip of your tongue, or no ferry. Then if it be your chance to come where the blessed spirits are, there’s a sight now! We maids that have our livers perished, cracked to pieces with love, we shall come there, and do nothing all day long but pick flowers with Proserpine. Then will I make Palamon a nosegay; then let him mark me—then.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148899/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@148899/line-2",
          "start": 10,
          "end": 422,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6775157,
        "end": 6775614,
        "line": 254611,
        "column": 1,
        "path": "chap38/p@148899",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "DAUGHTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@149360",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOCTOR.\nHow prettily she’s amiss! Note her a little further.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@149360/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@149360/line-2",
          "start": 8,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6775618,
        "end": 6775708,
        "line": 254621,
        "column": 1,
        "path": "chap38/p@149360",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "DOCTOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@149454",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAUGHTER.\nFaith, I’ll tell you, sometime we go to barley-break, we of the blessed. Alas, ’tis a sore life they have i’ th’ other place—such burning, frying, boiling, hissing, howling, chattering, cursing—O, they have shrewd measure; take heed! If one be mad, or hang or drown themselves, thither they go; Jupiter bless us! And there shall we be put in a cauldron of lead and usurers’ grease, amongst a whole million of cutpurses, and there boil like a gammon of bacon that will never be enough.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@149454/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@149454/line-2",
          "start": 10,
          "end": 494,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6775712,
        "end": 6776242,
        "line": 254626,
        "column": 1,
        "path": "chap38/p@149454",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "DAUGHTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@149988",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOCTOR.\nHow her brain coins!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@149988/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@149988/line-2",
          "start": 8,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6776246,
        "end": 6776304,
        "line": 254637,
        "column": 1,
        "path": "chap38/p@149988",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "DOCTOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150050",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAUGHTER.\nLords and courtiers that have got maids with child, they are in this place. They shall stand in fire up to the navel and in ice up to the heart, and there th’ offending part burns and the deceiving part freezes. In troth, a very grievous punishment, as one would think, for such a trifle. Believe me, one would marry a leprous witch to be rid on ’t, I’ll assure you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150050/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150050/line-2",
          "start": 10,
          "end": 376,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6776308,
        "end": 6776718,
        "line": 254642,
        "column": 1,
        "path": "chap38/p@150050",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "DAUGHTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150464",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DOCTOR.\nHow she continues this fancy! ’Tis not an engraffed madness, but a most thick, and profound melancholy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150464/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150464/line-2",
          "start": 8,
          "end": 111,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6776722,
        "end": 6776864,
        "line": 254651,
        "column": 1,
        "path": "chap38/p@150464",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "DOCTOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150610",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DAUGHTER.\nTo hear there a proud lady and a proud city wife howl together! I were a beast an I’d call it good sport. One cries “O this smoke!” th’ other, “This fire!”; one cries, “O, that ever I did it behind the arras!” and then howls; th’ other curses a suing fellow and her garden house.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150610/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150610/line-2",
          "start": 10,
          "end": 289,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6776868,
        "end": 6777190,
        "line": 254657,
        "column": 1,
        "path": "chap38/p@150610",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": "DAUGHTER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150936",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "[Sings.]\n    I will be true, my stars, my fate, &c.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 7
        },
        {
          "tag": "i",
          "start": 13,
          "end": 51
        }
      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150936/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@150936/line-2",
          "start": 9,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6777194,
        "end": 6777293,
        "line": 254665,
        "column": 1,
        "path": "chap38/p@150936",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@151039",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit Jailer’s Daughter.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 15,
          "end": 23,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 24
        }
      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@151039/line-1",
          "start": 0,
          "end": 25,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6777297,
        "end": 6777380,
        "line": 254670,
        "column": 1,
        "path": "chap38/p@151039",
        "anchor": "sceneIV_38.3"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-two-noble-kinsmen/sceneIV_38.3/p@151126",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "JAILER.\nWhat think you of her, sir?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@151126/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@151126/line-2",
          "start": 8,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
