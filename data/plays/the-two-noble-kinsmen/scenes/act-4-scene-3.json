      ],
      "lines": [
        {
          "id": "the-two-noble-kinsmen/sceneIV_38.3/p@147685/line-1",
          "start": 0,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6773943,
        "end": 6774064,
        "line": 254566,
        "column": 1,
        "path": "chap38/p@147685",
        "anchor": "sceneIV_38.3"
