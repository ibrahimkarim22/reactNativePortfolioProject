  "scene": {
    "id": "the-two-noble-kinsmen-5-1",
    "act": 5,
    "scene": 1,
    "label": "Act 5, Scene 1",
    "title": "SCENE I. Athens. Before the Temples of Mars, Venus, and Diana",
    "location": "Athens. Before the Temples of Mars, Venus, and Diana",
    "orderInPlay": 21
  },
  "content": [
    {
      "id": "the-two-noble-kinsmen-5-1-stage-001",
      "type": "stage",
      "text": "Flourish. Enter Theseus, Pirithous, Hippolyta and Attendants."
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Now let 'em enter and before the gods",
          "plainText": "Now let 'em enter and before the gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Tender their holy prayers. Let the temples",
          "plainText": "Tender their holy prayers Let the temples",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Burn bright with sacred fires, and the altars",
          "plainText": "Burn bright with sacred fires and the altars",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "In hallowed clouds commend their swelling incense",
          "plainText": "In hallowed clouds commend their swelling incense",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "To those above us. Let no due be wanting.",
          "plainText": "To those above us Let no due be wanting",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "They have a noble work in hand, will honour",
          "plainText": "They have a noble work in hand will honour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "The very powers that love 'em.",
          "plainText": "The very powers that love 'em",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Sir, they enter.",
          "plainText": "Sir they enter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-002",
      "type": "stage",
      "text": "Enter Palamon and Arcite and their Knights."
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "You valiant and strong-hearted enemies,",
          "plainText": "You valiant and stronghearted enemies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "You royal german foes, that this day come",
          "plainText": "You royal german foes that this day come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "To blow that nearness out that flames between ye,",
          "plainText": "To blow that nearness out that flames between ye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "Lay by your anger for an hour and, dove-like,",
          "plainText": "Lay by your anger for an hour and dovelike",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "Before the holy altars of your helpers,",
          "plainText": "Before the holy altars of your helpers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 6,
          "text": "The all-feared gods, bow down your stubborn bodies.",
          "plainText": "The allfeared gods bow down your stubborn bodies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 7,
          "text": "Your ire is more than mortal; so your help be;",
          "plainText": "Your ire is more than mortal so your help be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 8,
          "text": "And, as the gods regard ye, fight with justice.",
          "plainText": "And as the gods regard ye fight with justice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 9,
          "text": "I'll leave you to your prayers, and betwixt ye",
          "plainText": "I'll leave you to your prayers and betwixt ye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 10,
          "text": "I part my wishes.",
          "plainText": "I part my wishes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Honour crown the worthiest.",
          "plainText": "Honour crown the worthiest",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-003",
      "type": "stage",
      "text": "[Exeunt Theseus and his Train.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "The glass is running now that cannot finish",
          "plainText": "The glass is running now that cannot finish",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Till one of us expire. Think you but thus,",
          "plainText": "Till one of us expire Think you but thus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "That were there aught in me which strove to show",
          "plainText": "That were there aught in me which strove to show",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Mine enemy in this business, were 't one eye",
          "plainText": "Mine enemy in this business were 't one eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "Against another, arm oppressed by arm,",
          "plainText": "Against another arm oppressed by arm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 6,
          "text": "I would destroy th' offender, coz, I would",
          "plainText": "I would destroy th' offender coz I would",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 7,
          "text": "Though parcel of myself. Then from this gather",
          "plainText": "Though parcel of myself Then from this gather",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 8,
          "text": "How I should tender you.",
          "plainText": "How I should tender you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "I am in labour",
          "plainText": "I am in labour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "To push your name, your ancient love, our kindred",
          "plainText": "To push your name your ancient love our kindred",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "Out of my memory, and i' th' selfsame place",
          "plainText": "Out of my memory and i' th' selfsame place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0031",
          "number": 31,
          "speechLineNumber": 4,
          "text": "To seat something I would confound. So hoist we",
          "plainText": "To seat something I would confound So hoist we",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0032",
          "number": 32,
          "speechLineNumber": 5,
          "text": "The sails that must these vessels port even where",
          "plainText": "The sails that must these vessels port even where",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0033",
          "number": 33,
          "speechLineNumber": 6,
          "text": "The heavenly limiter pleases.",
          "plainText": "The heavenly limiter pleases",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "You speak well.",
          "plainText": "You speak well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Before I turn, let me embrace thee, cousin.",
          "plainText": "Before I turn let me embrace thee cousin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "This I shall never do again.",
          "plainText": "This I shall never do again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "One farewell.",
          "plainText": "One farewell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Why, let it be so. Farewell, coz.",
          "plainText": "Why let it be so Farewell coz",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Farewell, sir.",
          "plainText": "Farewell sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-004",
      "type": "stage",
      "text": "[Exeunt Palamon and his Knights.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-005",
      "type": "stage",
      "text": "[They advance to the altar of Mars, fall on their faces before it, and then kneel.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-006",
      "type": "stage",
      "text": "[Here they fall on their faces as formerly, and there is heard clanging of armour, with a short thunder, as the burst of a battle, whereupon they all rise and bow to the altar.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-008",
      "type": "stage",
      "text": "Enter Palamon and his Knights, with the former observance."
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "palamon",
        "name": "PALAMON",
        "displayName": "Palamon"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Our stars must glister with new fire, or be",
          "plainText": "Our stars must glister with new fire or be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Today extinct. Our argument is love,",
          "plainText": "Today extinct Our argument is love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Which, if the goddess of it grant, she gives",
          "plainText": "Which if the goddess of it grant she gives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "Victory too. Then blend your spirits with mine,",
          "plainText": "Victory too Then blend your spirits with mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0044",
          "number": 44,
          "speechLineNumber": 5,
          "text": "You whose free nobleness do make my cause",
          "plainText": "You whose free nobleness do make my cause",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0045",
          "number": 45,
          "speechLineNumber": 6,
          "text": "Your personal hazard. To the goddess Venus",
          "plainText": "Your personal hazard To the goddess Venus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0046",
          "number": 46,
          "speechLineNumber": 7,
          "text": "Commend we our proceeding, and implore",
          "plainText": "Commend we our proceeding and implore",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0047",
          "number": 47,
          "speechLineNumber": 8,
          "text": "Her power unto our party.",
          "plainText": "Her power unto our party",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-009",
      "type": "stage",
      "text": "[Here they kneel as formerly.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-010",
      "type": "stage",
      "text": "[Here music is heard; doves are seen to flutter. They fall again upon their faces, then on their knees.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-011",
      "type": "stage",
      "text": "[They rise and bow.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-012",
      "type": "stage",
      "text": "[Exeunt.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-013",
      "type": "stage",
      "text": "Still music of recorders. Enter Emilia in white, her hair about her shoulders, wearing a wheaten wreath. One in white holding up her train, her hair stuck with flowers. One before her carrying a silver hind, in which is conveyed incense and sweet odours, which being set upon the altar of Diana, her maids standing aloof, she sets fire to it; then they curtsy and kneel."
    },
    {
      "id": "the-two-noble-kinsmen-5-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-5-1-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "O sacred, shadowy, cold, and constant queen,",
          "plainText": "O sacred shadowy cold and constant queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "Abandoner of revels, mute contemplative,",
          "plainText": "Abandoner of revels mute contemplative",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "Sweet, solitary, white as chaste, and pure",
          "plainText": "Sweet solitary white as chaste and pure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "As wind-fanned snow, who to thy female knights",
          "plainText": "As windfanned snow who to thy female knights",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0052",
          "number": 52,
          "speechLineNumber": 5,
          "text": "Allow'st no more blood than will make a blush,",
          "plainText": "Allow'st no more blood than will make a blush",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0053",
          "number": 53,
          "speechLineNumber": 6,
          "text": "Which is their order's robe, I here, thy priest,",
          "plainText": "Which is their order's robe I here thy priest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0054",
          "number": 54,
          "speechLineNumber": 7,
          "text": "Am humbled 'fore thine altar. O, vouchsafe",
          "plainText": "Am humbled 'fore thine altar O vouchsafe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0055",
          "number": 55,
          "speechLineNumber": 8,
          "text": "With that thy rare green eye, which never yet",
          "plainText": "With that thy rare green eye which never yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0056",
          "number": 56,
          "speechLineNumber": 9,
          "text": "Beheld thing maculate, look on thy virgin;",
          "plainText": "Beheld thing maculate look on thy virgin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0057",
          "number": 57,
          "speechLineNumber": 10,
          "text": "And, sacred silver mistress, lend thine ear,",
          "plainText": "And sacred silver mistress lend thine ear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0058",
          "number": 58,
          "speechLineNumber": 11,
          "text": "Which ne'er heard scurrile term, into whose port",
          "plainText": "Which ne'er heard scurrile term into whose port",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0059",
          "number": 59,
          "speechLineNumber": 12,
          "text": "Ne'er entered wanton sound, to my petition,",
          "plainText": "Ne'er entered wanton sound to my petition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0060",
          "number": 60,
          "speechLineNumber": 13,
          "text": "Seasoned with holy fear. This is my last",
          "plainText": "Seasoned with holy fear This is my last",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0061",
          "number": 61,
          "speechLineNumber": 14,
          "text": "Of vestal office. I am bride-habited",
          "plainText": "Of vestal office I am bridehabited",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0062",
          "number": 62,
          "speechLineNumber": 15,
          "text": "But maiden-hearted. A husband I have 'pointed,",
          "plainText": "But maidenhearted A husband I have 'pointed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0063",
          "number": 63,
          "speechLineNumber": 16,
          "text": "But do not know him. Out of two I should",
          "plainText": "But do not know him Out of two I should",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0064",
          "number": 64,
          "speechLineNumber": 17,
          "text": "Choose one, and pray for his success, but I",
          "plainText": "Choose one and pray for his success but I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0065",
          "number": 65,
          "speechLineNumber": 18,
          "text": "Am guiltless of election. Of mine eyes,",
          "plainText": "Am guiltless of election Of mine eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0066",
          "number": 66,
          "speechLineNumber": 19,
          "text": "Were I to lose one, they are equal precious;",
          "plainText": "Were I to lose one they are equal precious",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0067",
          "number": 67,
          "speechLineNumber": 20,
          "text": "I could doom neither; that which perished should",
          "plainText": "I could doom neither that which perished should",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0068",
          "number": 68,
          "speechLineNumber": 21,
          "text": "Go to 't unsentenced. Therefore, most modest queen,",
          "plainText": "Go to 't unsentenced Therefore most modest queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0069",
          "number": 69,
          "speechLineNumber": 22,
          "text": "He of the two pretenders that best loves me",
          "plainText": "He of the two pretenders that best loves me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0070",
          "number": 70,
          "speechLineNumber": 23,
          "text": "And has the truest title in 't, let him",
          "plainText": "And has the truest title in 't let him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0071",
          "number": 71,
          "speechLineNumber": 24,
          "text": "Take off my wheaten garland, or else grant",
          "plainText": "Take off my wheaten garland or else grant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0072",
          "number": 72,
          "speechLineNumber": 25,
          "text": "The file and quality I hold I may",
          "plainText": "The file and quality I hold I may",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-5-1-line-0073",
          "number": 73,
          "speechLineNumber": 26,
          "text": "Continue in thy band.",
          "plainText": "Continue in thy band",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-014",
      "type": "stage",
      "text": "[Here the hind vanishes under the altar, and in the place ascends a rose tree, having one rose upon it.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-015",
      "type": "stage",
      "text": "[Here is heard a sudden twang of instruments, and the rose falls from the tree.]"
    },
    {
      "id": "the-two-noble-kinsmen-5-1-stage-016",
      "type": "stage",
      "text": "[They curtsy and exeunt.]"
    }
  ]
}