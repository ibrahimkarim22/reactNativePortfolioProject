    {
      "id": "the-winters-tale/sceneII_39.2/p@48676",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Dear gentlewoman,\nHow fares our gracious lady?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@48676/line-1",
          "start": 0,
          "end": 17,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@48676/line-2",
          "start": 18,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
