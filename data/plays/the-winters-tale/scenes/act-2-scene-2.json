    {
      "id": "the-winters-tale/sceneII_39.2/p@49916",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nMost worthy madam,\nYour honour and your goodness is so evident,\nThat your free undertaking cannot miss\nA thriving issue: there is no lady living\nSo meet for this great errand. Please your ladyship\nTo visit the next room, I’ll presently\nAcquaint the queen of your most noble offer,\nWho but today hammer’d of this design,\nBut durst not tempt a minister of honour,\nLest she should be denied.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
