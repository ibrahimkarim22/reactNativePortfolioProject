      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@47094/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
