      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nNow be you blest for it!\nI’ll to the queen: please you come something nearer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@50580/line-1",
          "start": 0,
          "end": 7,
