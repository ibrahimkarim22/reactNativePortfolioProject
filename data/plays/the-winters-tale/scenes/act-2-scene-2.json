        "cueEnd": 7
      }
    },
    {
      "id": "the-winters-tale/sceneII_39.2/p@50704",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GAOLER.\nMadam, if ’t please the queen to send the babe,\nI know not what I shall incur to pass it,\nHaving no warrant.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
