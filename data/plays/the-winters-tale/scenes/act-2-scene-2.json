      }
    },
    {
      "id": "the-winters-tale/sceneII_39.2/p@48756",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nAs well as one so great and so forlorn\nMay hold together: on her frights and griefs,\n(Which never tender lady hath borne greater)\nShe is, something before her time, deliver’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
