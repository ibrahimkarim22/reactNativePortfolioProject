    {
      "id": "the-winters-tale/sceneII_39.2/p@49037",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "EMILIA.\nA daughter; and a goodly babe,\nLusty, and like to live: the queen receives\nMuch comfort in ’t; says “My poor prisoner,\nI am as innocent as you.”",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@49037/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
