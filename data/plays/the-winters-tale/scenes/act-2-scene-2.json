    {
      "id": "the-winters-tale/sceneII_39.2/p@50864",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAULINA.\nYou need not fear it, sir:\nThis child was prisoner to the womb, and is,\nBy law and process of great nature thence\nFreed and enfranchis’d: not a party to\nThe anger of the king, nor guilty of,\nIf any be, the trespass of the queen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
