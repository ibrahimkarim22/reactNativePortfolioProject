      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAULINA.\nTell her, Emilia,\nI’ll use that tongue I have: if wit flow from ’t\nAs boldness from my bosom, let’t not be doubted\nI shall do good.",
      "separatorAfter": "\n\n",
      "spans": [],
