        "end": 6868609,
        "line": 258072,
        "column": 1,
        "path": "chap39/p@47340",
        "anchor": "sceneII_39.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "the-winters-tale/sceneII_39.2/p@47413",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GAOLER.\nFor a worthy lady\nAnd one who much I honour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@47413/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47413/line-2",
          "start": 8,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47413/line-3",
          "start": 26,
          "end": 52,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6868613,
        "end": 6868700,
        "line": 258077,
        "column": 1,
        "path": "chap39/p@47413",
        "anchor": "sceneII_39.2"
      },
      "speakerLabel": "GAOLER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-winters-tale/sceneII_39.2/p@47504",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAULINA.\nPray you then,\nConduct me to the queen.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@47504/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47504/line-2",
          "start": 9,
          "end": 23,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47504/line-3",
          "start": 24,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6868704,
        "end": 6868787,
        "line": 258083,
        "column": 1,
        "path": "chap39/p@47504",
        "anchor": "sceneII_39.2"
      },
      "speakerLabel": "PAULINA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-winters-tale/sceneII_39.2/p@47591",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GAOLER.\nI may not, madam.\nTo the contrary I have express commandment.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@47591/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47591/line-2",
          "start": 8,
          "end": 25,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47591/line-3",
          "start": 26,
          "end": 69,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6868791,
        "end": 6868895,
        "line": 258089,
        "column": 1,
        "path": "chap39/p@47591",
        "anchor": "sceneII_39.2"
      },
      "speakerLabel": "GAOLER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "the-winters-tale/sceneII_39.2/p@47699",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAULINA.\nHere’s ado, to lock up honesty and honour from\nTh’ access of gentle visitors! Is’t lawful, pray you,\nTo see her women? any of them? Emilia?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@47699/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47699/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47699/line-3",
          "start": 56,
          "end": 109,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47699/line-4",
          "start": 110,
          "end": 148,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6868899,
        "end": 6869087,
        "line": 258095,
        "column": 1,
        "path": "chap39/p@47699",
        "anchor": "sceneII_39.2"
      },
      "speakerLabel": "PAULINA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-winters-tale/sceneII_39.2/p@47891",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GAOLER.\nSo please you, madam,\nTo put apart these your attendants, I\nShall bring Emilia forth.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@47891/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47891/line-2",
          "start": 8,
          "end": 29,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47891/line-3",
          "start": 30,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47891/line-4",
          "start": 68,
          "end": 93,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6869091,
        "end": 6869224,
        "line": 258102,
        "column": 1,
        "path": "chap39/p@47891",
        "anchor": "sceneII_39.2"
      },
      "speakerLabel": "GAOLER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
