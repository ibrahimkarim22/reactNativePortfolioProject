      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Here’s such ado to make no stain a stain\nAs passes colouring.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@48460/line-1",
          "start": 0,
