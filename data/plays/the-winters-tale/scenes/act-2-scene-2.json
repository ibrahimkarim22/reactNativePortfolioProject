          "start": 39,
          "end": 82,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@49037/line-4",
          "start": 83,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@49037/line-5",
          "start": 127,
          "end": 152,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6870237,
        "end": 6870434,
        "line": 258161,
        "column": 1,
