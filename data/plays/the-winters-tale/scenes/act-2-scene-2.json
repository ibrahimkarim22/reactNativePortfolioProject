      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Now, good sir,\nYou know me, do you not?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@47340/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneII_39.2/p@47340/line-2",
          "start": 15,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
