      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "GAOLER.\nAnd, madam,\nI must be present at your conference.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneII_39.2/p@48218/line-1",
