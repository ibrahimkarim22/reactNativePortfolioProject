      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PAULINA.\nDo not you fear: upon mine honour, I\nWill stand betwixt you and danger.",
      "separatorAfter": "\n\n",
      "spans": [],
