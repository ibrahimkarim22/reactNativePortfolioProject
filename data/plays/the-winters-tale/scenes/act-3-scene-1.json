    {
      "id": "the-winters-tale/sceneIII_39.1/p@64881",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOMENES\nThe climate’s delicate; the air most sweet,\nFertile the isle, the temple much surpassing\nThe common praise it bears.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIII_39.1/p@64881/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@64881/line-2",
          "start": 10,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@64881/line-3",
          "start": 54,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@64881/line-4",
          "start": 99,
          "end": 126,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6886081,
        "end": 6886247,
        "line": 258765,
        "column": 1,
        "path": "chap39/p@64881",
        "anchor": "sceneIII_39.1"
      },
      "speakerLabel": "CLEOMENES",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-winters-tale/sceneIII_39.1/p@65051",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DION.\nI shall report,\nFor most it caught me, the celestial habits\n(Methinks I so should term them) and the reverence\nOf the grave wearers. O, the sacrifice!\nHow ceremonious, solemn, and unearthly,\nIt was i’ th’ offering!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65051/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65051/line-2",
          "start": 6,
          "end": 21,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65051/line-3",
          "start": 22,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65051/line-4",
          "start": 66,
          "end": 116,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65051/line-5",
          "start": 117,
          "end": 156,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65051/line-6",
          "start": 157,
          "end": 196,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65051/line-7",
          "start": 197,
          "end": 220,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6886251,
        "end": 6886526,
        "line": 258772,
        "column": 1,
        "path": "chap39/p@65051",
