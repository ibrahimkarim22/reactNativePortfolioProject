  },
  "content": [
    {
      "id": "the-winters-tale-3-1-stage-001",
      "type": "stage",
      "text": "Enter Cleomenes and Dion."
    },
    {
      "id": "the-winters-tale-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cleomenes",
        "name": "CLEOMENES",
        "displayName": "Cleomenes"
      },
      "lines": [
        {
          "id": "the-winters-tale-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The climate's delicate; the air most sweet,",
          "plainText": "The climate's delicate the air most sweet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Fertile the isle, the temple much surpassing",
          "plainText": "Fertile the isle the temple much surpassing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "The common praise it bears.",
          "plainText": "The common praise it bears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "dion",
        "name": "DION",
        "displayName": "Dion"
      },
      "lines": [
        {
          "id": "the-winters-tale-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I shall report,",
          "plainText": "I shall report",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "For most it caught me, the celestial habits",
          "plainText": "For most it caught me the celestial habits",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "(Methinks I so should term them) and the reverence",
          "plainText": "Methinks I so should term them and the reverence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "Of the grave wearers. O, the sacrifice!",
          "plainText": "Of the grave wearers O the sacrifice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "How ceremonious, solemn, and unearthly,",
          "plainText": "How ceremonious solemn and unearthly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 6,
          "text": "It was i' th' offering!",
          "plainText": "It was i' th' offering",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cleomenes",
        "name": "CLEOMENES",
        "displayName": "Cleomenes"
      },
      "lines": [
        {
          "id": "the-winters-tale-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "But of all, the burst",
          "plainText": "But of all the burst",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "And the ear-deaf'ning voice o' th' oracle,",
          "plainText": "And the eardeaf'ning voice o' th' oracle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "Kin to Jove's thunder, so surprised my sense",
          "plainText": "Kin to Jove's thunder so surprised my sense",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "That I was nothing.",
          "plainText": "That I was nothing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "dion",
        "name": "DION",
        "displayName": "Dion"
      },
      "lines": [
        {
          "id": "the-winters-tale-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "If the event o' th' journey",
          "plainText": "If the event o' th' journey",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Prove as successful to the queen,—O, be't so!—",
          "plainText": "Prove as successful to the queenO be't so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "As it hath been to us rare, pleasant, speedy,",
          "plainText": "As it hath been to us rare pleasant speedy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "The time is worth the use on't.",
          "plainText": "The time is worth the use on't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cleomenes",
        "name": "CLEOMENES",
        "displayName": "Cleomenes"
      },
      "lines": [
        {
          "id": "the-winters-tale-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Great Apollo",
          "plainText": "Great Apollo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Turn all to th' best! These proclamations,",
          "plainText": "Turn all to th' best These proclamations",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "So forcing faults upon Hermione,",
          "plainText": "So forcing faults upon Hermione",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "I little like.",
          "plainText": "I little like",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "dion",
        "name": "DION",
        "displayName": "Dion"
      },
      "lines": [
        {
          "id": "the-winters-tale-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "The violent carriage of it",
          "plainText": "The violent carriage of it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Will clear or end the business: when the oracle,",
          "plainText": "Will clear or end the business when the oracle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "(Thus by Apollo's great divine seal'd up)",
          "plainText": "Thus by Apollo's great divine seal'd up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Shall the contents discover, something rare",
          "plainText": "Shall the contents discover something rare",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "Even then will rush to knowledge. Go. Fresh horses!",
          "plainText": "Even then will rush to knowledge Go Fresh horses",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 6,
          "text": "And gracious be the issue!",
          "plainText": "And gracious be the issue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-3-1-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}