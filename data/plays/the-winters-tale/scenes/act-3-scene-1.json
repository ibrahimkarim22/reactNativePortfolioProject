        "cueEnd": 5
      }
    },
    {
      "id": "the-winters-tale/sceneIII_39.1/p@65725",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOMENES\nGreat Apollo\nTurn all to th’ best! These proclamations,\nSo forcing faults upon Hermione,\nI little like.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65725/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65725/line-2",
          "start": 10,
          "end": 22,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65725/line-3",
          "start": 23,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65725/line-4",
          "start": 66,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65725/line-5",
          "start": 99,
          "end": 113,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6886925,
        "end": 6887083,
        "line": 258798,
        "column": 1,
        "path": "chap39/p@65725",
        "anchor": "sceneIII_39.1"
      },
      "speakerLabel": "CLEOMENES",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-winters-tale/sceneIII_39.1/p@65887",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DION.\nThe violent carriage of it\nWill clear or end the business: when the oracle,\n(Thus by Apollo’s great divine seal’d up)\nShall the contents discover, something rare\nEven then will rush to knowledge. Go. Fresh horses!\nAnd gracious be the issue!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
