        "cueEnd": 5
      }
    },
    {
      "id": "the-winters-tale/sceneIII_39.1/p@65330",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLEOMENES\nBut of all, the burst\nAnd the ear-deaf’ning voice o’ th’ oracle,\nKin to Jove’s thunder, so surprised my sense\nThat I was nothing.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65330/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65330/line-2",
          "start": 10,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65330/line-3",
          "start": 32,
          "end": 74,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65330/line-4",
          "start": 75,
          "end": 119,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65330/line-5",
          "start": 120,
          "end": 139,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6886530,
        "end": 6886714,
        "line": 258782,
        "column": 1,
        "path": "chap39/p@65330",
        "anchor": "sceneIII_39.1"
      },
      "speakerLabel": "CLEOMENES",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-winters-tale/sceneIII_39.1/p@65518",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DION.\nIf the event o’ th’ journey\nProve as successful to the queen,—O, be’t so!—\nAs it hath been to us rare, pleasant, speedy,\nThe time is worth the use on’t.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65518/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65518/line-2",
          "start": 6,
          "end": 33,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65518/line-3",
          "start": 34,
          "end": 80,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65518/line-4",
          "start": 81,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.1/p@65518/line-5",
          "start": 127,
          "end": 158,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6886718,
        "end": 6886921,
        "line": 258790,
        "column": 1,
        "path": "chap39/p@65518",
        "anchor": "sceneIII_39.1"
      },
      "speakerLabel": "DION.",
      "attribution": {
