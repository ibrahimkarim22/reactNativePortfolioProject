    {
      "id": "the-winters-tale/sceneIII_39.3/p@84104",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SHEPHERD.\nI would there were no age between ten and three-and-twenty, or that youth would sleep out the rest; for there is nothing in the between but getting wenches with child, wronging the ancientry, stealing, fighting—Hark you now! Would any but these boiled brains of nineteen and two-and-twenty hunt this weather? They have scared away two of my best sheep, which I fear the wolf will sooner find than the master: if anywhere I have them, ’tis by the sea-side, browsing of ivy. Good luck, an ’t be thy will, what have we here?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIII_39.3/p@84104/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIII_39.3/p@84104/line-2",
          "start": 10,
          "end": 531,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6905304,
        "end": 6905871,
        "line": 259406,
        "column": 1,
        "path": "chap39/p@84104",
        "anchor": "sceneIII_39.3"
      },
      "speakerLabel": "SHEPHERD.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "the-winters-tale/sceneIII_39.3/p@84675",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Taking up the child.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
