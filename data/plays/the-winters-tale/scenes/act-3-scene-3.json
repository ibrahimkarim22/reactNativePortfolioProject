    {
      "id": "the-winters-tale/sceneIII_39.3/p@84733",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Mercy on ’s, a bairn! A very pretty bairn! A boy or a child, I wonder? A pretty one; a very pretty one. Sure, some scape. Though I am not bookish, yet I can read waiting-gentlewoman in the scape. This has been some stair-work, some trunk-work, some behind-door-work. They were warmer that got this than the poor thing is here. I’ll take it up for pity: yet I’ll tarry till my son come; he halloed but even now. Whoa-ho-hoa!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIII_39.3/p@84733/line-1",
          "start": 0,
          "end": 423,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6905933,
        "end": 6906392,
        "line": 259421,
