        "scenedesc"
      ],
      "text": "Enter Polixenes and Camillo.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 15,
          "className": "charname"
        },
        {
          "tag": "span",
