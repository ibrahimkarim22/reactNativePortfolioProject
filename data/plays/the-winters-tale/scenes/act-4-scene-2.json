          "end": 27,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "the-winters-tale/sceneIV_39.2/p@90444/line-1",
          "start": 0,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6911644,
        "end": 6911761,
        "line": 259597,
        "column": 1,
        "path": "chap39/p@90444",
        "anchor": "sceneIV_39.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "the-winters-tale/sceneIV_39.2/p@90565",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "POLIXENES.\nI pray thee, good Camillo, be no more importunate: ’tis a sickness denying thee anything; a death to grant this.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIV_39.2/p@90565/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIV_39.2/p@90565/line-2",
          "start": 11,
          "end": 123,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6911765,
        "end": 6911919,
        "line": 259601,
        "column": 1,
        "path": "chap39/p@90565",
        "anchor": "sceneIV_39.2"
      },
      "speakerLabel": "POLIXENES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-winters-tale/sceneIV_39.2/p@90723",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAMILLO.\nIt is fifteen years since I saw my country. Though I have for the most part been aired abroad, I desire to lay my bones there. Besides, the penitent king, my master, hath sent for me; to whose feeling sorrows I might be some allay, or I o’erween to think so,—which is another spur to my departure.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIV_39.2/p@90723/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIV_39.2/p@90723/line-2",
          "start": 9,
          "end": 306,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6911923,
        "end": 6912262,
        "line": 259607,
        "column": 1,
        "path": "chap39/p@90723",
        "anchor": "sceneIV_39.2"
      },
      "speakerLabel": "CAMILLO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-winters-tale/sceneIV_39.2/p@91066",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "POLIXENES.\nAs thou lov’st me, Camillo, wipe not out the rest of thy services by leaving me now: the need I have of thee, thine own goodness hath made; better not to have had thee than thus to want thee. Thou, having made me businesses which none without thee can sufficiently manage, must either stay to execute them thyself, or take away with thee the very services thou hast done, which if I have not enough considered (as too much I cannot) to be more thankful to thee shall be my study; and my profit therein the heaping friendships. Of that fatal country Sicilia, prithee speak no more; whose very naming punishes me with the remembrance of that penitent, as thou call’st him, and reconciled king, my brother; whose loss of his most precious queen and children are even now to be afresh lamented. Say to me, when sawest thou the Prince Florizel, my son? Kings are no less unhappy, their issue not being gracious, than they are in losing them when they have approved their virtues.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIV_39.2/p@91066/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIV_39.2/p@91066/line-2",
          "start": 11,
          "end": 985,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6912266,
        "end": 6913293,
        "line": 259615,
        "column": 1,
        "path": "chap39/p@91066",
        "anchor": "sceneIV_39.2"
      },
      "speakerLabel": "POLIXENES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-winters-tale/sceneIV_39.2/p@92097",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAMILLO.\nSir, it is three days since I saw the prince. What his happier affairs may be, are to me unknown, but I have missingly noted he is of late much retired from court, and is less frequent to his princely exercises than formerly he hath appeared.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIV_39.2/p@92097/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIV_39.2/p@92097/line-2",
          "start": 9,
          "end": 251,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6913297,
        "end": 6913581,
        "line": 259632,
        "column": 1,
        "path": "chap39/p@92097",
        "anchor": "sceneIV_39.2"
      },
      "speakerLabel": "CAMILLO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-winters-tale/sceneIV_39.2/p@92385",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "POLIXENES.\nI have considered so much, Camillo, and with some care; so far that I have eyes under my service which look upon his removedness; from whom I have this intelligence, that he is seldom from the house of a most homely shepherd, a man, they say, that from very nothing, and beyond the imagination of his neighbours, is grown into an unspeakable estate.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIV_39.2/p@92385/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIV_39.2/p@92385/line-2",
          "start": 11,
          "end": 360,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6913585,
        "end": 6913979,
        "line": 259640,
        "column": 1,
        "path": "chap39/p@92385",
        "anchor": "sceneIV_39.2"
      },
      "speakerLabel": "POLIXENES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-winters-tale/sceneIV_39.2/p@92783",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAMILLO.\nI have heard, sir, of such a man, who hath a daughter of most rare note: the report of her is extended more than can be thought to begin from such a cottage.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIV_39.2/p@92783/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIV_39.2/p@92783/line-2",
          "start": 9,
          "end": 166,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6913983,
        "end": 6914181,
        "line": 259649,
        "column": 1,
        "path": "chap39/p@92783",
        "anchor": "sceneIV_39.2"
      },
      "speakerLabel": "CAMILLO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-winters-tale/sceneIV_39.2/p@92985",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "POLIXENES.\nThat’s likewise part of my intelligence: but, I fear, the angle that plucks our son thither. Thou shalt accompany us to the place, where we will, not appearing what we are, have some question with the shepherd; from whose simplicity I think it not uneasy to get the cause of my son’s resort thither. Prithee, be my present partner in this business, and lay aside the thoughts of Sicilia.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIV_39.2/p@92985/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIV_39.2/p@92985/line-2",
          "start": 11,
          "end": 398,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6914185,
        "end": 6914617,
        "line": 259656,
        "column": 1,
        "path": "chap39/p@92985",
        "anchor": "sceneIV_39.2"
      },
      "speakerLabel": "POLIXENES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-winters-tale/sceneIV_39.2/p@93421",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAMILLO.\nI willingly obey your command.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIV_39.2/p@93421/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIV_39.2/p@93421/line-2",
          "start": 9,
          "end": 39,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6914621,
        "end": 6914690,
        "line": 259665,
        "column": 1,
        "path": "chap39/p@93421",
        "anchor": "sceneIV_39.2"
      },
      "speakerLabel": "CAMILLO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "the-winters-tale/sceneIV_39.2/p@93494",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "POLIXENES.\nMy best Camillo! We must disguise ourselves.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "the-winters-tale/sceneIV_39.2/p@93494/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "the-winters-tale/sceneIV_39.2/p@93494/line-2",
          "start": 11,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6914694,
        "end": 6914779,
        "line": 259670,
        "column": 1,
        "path": "chap39/p@93494",
        "anchor": "sceneIV_39.2"
      },
      "speakerLabel": "POLIXENES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "the-winters-tale/sceneIV_39.2/p@93583",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt.]",
      "separatorAfter": "\n\n",
