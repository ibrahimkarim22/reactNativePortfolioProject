      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@59610/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5845267,
        "end": 5845341,
        "line": 217786,
        "column": 1,
        "path": "chap33/p@59610",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@59688",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVANT.\nHere’s my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@59688/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@59688/line-2",
          "start": 9,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5845345,
        "end": 5845399,
        "line": 217790,
        "column": 1,
        "path": "chap33/p@59688",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "SERVANT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@59746",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCULLUS.\n[Aside.] One of Lord Timon’s men? A gift, I warrant. Why, this hits right. I dreamt of a silver basin and ewer tonight.—Flaminius, honest Flaminius, you are very respectively welcome, sir. Fill me some wine.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 11,
          "end": 16
        }
      ],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@59746/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@59746/line-2",
          "start": 10,
          "end": 217,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5845403,
        "end": 5845659,
        "line": 217795,
        "column": 1,
        "path": "chap33/p@59746",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "LUCULLUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@60006",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit Servant.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 14
        }
      ],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@60006/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5845663,
        "end": 5845736,
        "line": 217802,
        "column": 1,
        "path": "chap33/p@60006",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@60083",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "And how does that honourable, complete, free-hearted gentleman of Athens, thy very bountiful good lord and master?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@60083/line-1",
          "start": 0,
          "end": 114,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5845740,
        "end": 5845878,
        "line": 217804,
        "column": 1,
        "path": "chap33/p@60083",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@60225",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLAMINIUS.\nHis health is well, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@60225/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@60225/line-2",
          "start": 11,
          "end": 35,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5845882,
        "end": 5845947,
        "line": 217808,
        "column": 1,
        "path": "chap33/p@60225",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "FLAMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@60294",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCULLUS.\nI am right glad that his health is well, sir. And what hast thou there under thy cloak, pretty Flaminius?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@60294/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@60294/line-2",
          "start": 10,
          "end": 115,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5845951,
        "end": 5846095,
        "line": 217813,
        "column": 1,
        "path": "chap33/p@60294",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "LUCULLUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@60442",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLAMINIUS.\nFaith, nothing but an empty box, sir, which in my lord’s behalf I come to entreat your honour to supply; who, having great and instant occasion to use fifty talents, hath sent to your lordship to furnish him, nothing doubting your present assistance therein.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@60442/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@60442/line-2",
          "start": 11,
          "end": 269,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5846099,
        "end": 5846399,
        "line": 217818,
        "column": 1,
        "path": "chap33/p@60442",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "FLAMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@60746",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCULLUS.\nLa, la, la, la! Nothing doubting, says he? Alas, good lord! A noble gentleman ’tis, if he would not keep so good a house. Many a time and often I ha’ dined with him, and told him on’t, and come again to supper to him of purpose to have him spend less, and yet he would embrace no counsel, take no warning by my coming. Every man has his fault, and honesty is his. I ha’ told him on’t, but I could ne’er get him from ’t.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@60746/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@60746/line-2",
          "start": 10,
          "end": 429,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5846403,
        "end": 5846867,
        "line": 217825,
        "column": 1,
        "path": "chap33/p@60746",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "LUCULLUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@61214",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Servant with wine.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@61214/line-1",
          "start": 0,
          "end": 24,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5846871,
        "end": 5846954,
        "line": 217835,
        "column": 1,
        "path": "chap33/p@61214",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@61301",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVANT.\nPlease your lordship, here is the wine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@61301/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@61301/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5846958,
        "end": 5847036,
        "line": 217839,
        "column": 1,
        "path": "chap33/p@61301",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "SERVANT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@61383",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCULLUS.\nFlaminius, I have noted thee always wise. Here’s to thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@61383/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@61383/line-2",
          "start": 10,
          "end": 67,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5847040,
        "end": 5847137,
        "line": 217844,
        "column": 1,
        "path": "chap33/p@61383",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "LUCULLUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@61484",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLAMINIUS.\nYour lordship speaks your pleasure.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@61484/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@61484/line-2",
          "start": 11,
          "end": 46,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5847141,
        "end": 5847217,
        "line": 217849,
        "column": 1,
        "path": "chap33/p@61484",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "FLAMINIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@61564",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCULLUS.\nI have observed thee always for a towardly prompt spirit, give thee thy due, and one that knows what belongs to reason, and canst use the time well, if the time use thee well. Good parts in thee. [To Servant.] Get you gone, sirrah.—",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 207,
          "end": 217
        }
      ],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@61564/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@61564/line-2",
          "start": 10,
          "end": 242,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5847221,
        "end": 5847501,
        "line": 217854,
        "column": 1,
        "path": "chap33/p@61564",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "LUCULLUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@61848",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit Servant.]",
