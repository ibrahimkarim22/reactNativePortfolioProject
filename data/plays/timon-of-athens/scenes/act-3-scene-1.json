      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@62283",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLAMINIUS.\nIs’t possible the world should so much differ,\nAnd we alive that lived? Fly, damned baseness,\nTo him that worships thee.",
      "separatorAfter": "\n\n",
      "spans": [],
