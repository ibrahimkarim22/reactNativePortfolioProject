      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVANT.\nI have told my lord of you; he is coming down to you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@59452/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@59452/line-2",
          "start": 9,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5845109,
        "end": 5845201,
        "line": 217776,
        "column": 1,
        "path": "chap33/p@59452",
        "anchor": "sceneIII_33.1"
      },
      "speakerLabel": "SERVANT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.1/p@59548",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLAMINIUS.\nI thank you, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.1/p@59548/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.1/p@59548/line-2",
          "start": 11,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
