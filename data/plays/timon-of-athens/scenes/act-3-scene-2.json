  "content": [
    {
      "id": "timon-of-athens-3-2-stage-001",
      "type": "stage",
      "text": "Enter Lucius with three Strangers."
    },
    {
      "id": "timon-of-athens-3-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Who, the Lord Timon? He is my very good friend and an honourable gentleman.",
          "plainText": "Who the Lord Timon He is my very good friend and an honourable gentleman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "first-stranger",
        "name": "FIRST STRANGER",
        "displayName": "First Stranger"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "We know him for no less, though we are but strangers to him. But I can tell you one thing, my lord, and which I hear from common rumours: now Lord Timon's happy hours are done and past, and his estate shrinks from him.",
          "plainText": "We know him for no less though we are but strangers to him But I can tell you one thing my lord and which I hear from common rumours now Lord Timon's happy hours are done and past and his estate shrinks from him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Fie, no, do not believe it; he cannot want for money.",
          "plainText": "Fie no do not believe it he cannot want for money",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-stranger",
        "name": "SECOND STRANGER",
        "displayName": "Second Stranger"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "But believe you this, my lord, that, not long ago one of his men was with the Lord Lucullus to borrow so many talents, nay, urged extremely for't, and showed what necessity belonged to't, and yet was denied.",
          "plainText": "But believe you this my lord that not long ago one of his men was with the Lord Lucullus to borrow so many talents nay urged extremely for't and showed what necessity belonged to't and yet was denied",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "How?",
          "plainText": "How",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "second-stranger",
        "name": "SECOND STRANGER",
        "displayName": "Second Stranger"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "I tell you, denied, my lord.",
          "plainText": "I tell you denied my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "What a strange case was that! Now, before the gods, I am ashamed on't. Denied that honourable man? There was very little honour showed in't. For my own part, I must needs confess, I have received some small kindnesses from him, as money, plate, jewels, and such like trifles, nothing comparing to his; yet had he mistook him, and sent to me, I should ne'er have denied his occasion so many talents.",
          "plainText": "What a strange case was that Now before the gods I am ashamed on't Denied that honourable man There was very little honour showed in't For my own part I must needs confess I have received some small kindnesses from him as money plate jewels and such like trifles nothing comparing to his yet had he mistook him and sent to me I should ne'er have denied his occasion so many talents",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-stage-002",
      "type": "stage",
      "text": "Enter Servilius."
    },
    {
      "id": "timon-of-athens-3-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "servilius",
        "name": "SERVILIUS",
        "displayName": "Servilius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "See, by good hap, yonder's my lord; I have sweat to see his honour. [To Lucius.] My honoured lord!",
          "plainText": "See by good hap yonder's my lord I have sweat to see his honour To Lucius My honoured lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Servilius? You are kindly met, sir. Fare thee well. Commend me to thy honourable virtuous lord, my very exquisite friend.",
          "plainText": "Servilius You are kindly met sir Fare thee well Commend me to thy honourable virtuous lord my very exquisite friend",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "servilius",
        "name": "SERVILIUS",
        "displayName": "Servilius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "May it please your honour, my lord hath sent—",
          "plainText": "May it please your honour my lord hath sent",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Ha! What has he sent? I am so much endeared to that lord; he's ever sending. How shall I thank him, thinkest thou? And what has he sent now?",
          "plainText": "Ha What has he sent I am so much endeared to that lord he's ever sending How shall I thank him thinkest thou And what has he sent now",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "servilius",
        "name": "SERVILIUS",
        "displayName": "Servilius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Has only sent his present occasion now, my lord, requesting your lordship to supply his instant use with so many talents.",
          "plainText": "Has only sent his present occasion now my lord requesting your lordship to supply his instant use with so many talents",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "I know his lordship is but merry with me;",
          "plainText": "I know his lordship is but merry with me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "He cannot want fifty-five hundred talents.",
          "plainText": "He cannot want fiftyfive hundred talents",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "servilius",
        "name": "SERVILIUS",
        "displayName": "Servilius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "But in the meantime he wants less, my lord.",
          "plainText": "But in the meantime he wants less my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "If his occasion were not virtuous,",
          "plainText": "If his occasion were not virtuous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "I should not urge it half so faithfully.",
          "plainText": "I should not urge it half so faithfully",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Dost thou speak seriously, Servilius?",
          "plainText": "Dost thou speak seriously Servilius",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "servilius",
        "name": "SERVILIUS",
        "displayName": "Servilius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Upon my soul, 'tis true, sir.",
          "plainText": "Upon my soul 'tis true sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "What a wicked beast was I to disfurnish myself against such a good time, when I might ha' shown myself honourable! How unluckily it happened that I should purchase the day before for a little part, and undo a great deal of honour! Servilius, now before the gods, I am not able to do—the more beast, I say—I was sending to use Lord Timon myself, these gentlemen can witness; but I would not for the wealth of Athens I had done it now. Commend me bountifully to his good lordship, and I hope his honour will conceive the fairest of me, because I have no power to be kind. And tell him this from me: I count it one of my greatest afflictions, say, that I cannot pleasure such an honourable gentleman. Good Servilius, will you befriend me so far as to use mine own words to him?",
          "plainText": "What a wicked beast was I to disfurnish myself against such a good time when I might ha' shown myself honourable How unluckily it happened that I should purchase the day before for a little part and undo a great deal of honour Servilius now before the gods I am not able to dothe more beast I sayI was sending to use Lord Timon myself these gentlemen can witness but I would not for the wealth of Athens I had done it now Commend me bountifully to his good lordship and I hope his honour will conceive the fairest of me because I have no power to be kind And tell him this from me I count it one of my greatest afflictions say that I cannot pleasure such an honourable gentleman Good Servilius will you befriend me so far as to use mine own words to him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "servilius",
        "name": "SERVILIUS",
        "displayName": "Servilius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Yes, sir, I shall.",
          "plainText": "Yes sir I shall",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I'll look you out a good turn, Servilius.",
          "plainText": "I'll look you out a good turn Servilius",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-stage-003",
      "type": "stage",
      "text": "[Exit Servilius.]"
    },
    {
      "id": "timon-of-athens-3-2-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "timon-of-athens-3-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "first-stranger",
        "name": "FIRST STRANGER",
        "displayName": "First Stranger"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Do you observe this, Hostilius?",
          "plainText": "Do you observe this Hostilius",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "second-stranger",
        "name": "SECOND STRANGER",
        "displayName": "Second Stranger"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Ay, too well.",
          "plainText": "Ay too well",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "first-stranger",
        "name": "FIRST STRANGER",
        "displayName": "First Stranger"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Why, this is the world's soul, and just of the same piece",
          "plainText": "Why this is the world's soul and just of the same piece",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Is every flatterer's spirit. Who can call him his friend",
          "plainText": "Is every flatterer's spirit Who can call him his friend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "That dips in the same dish? For, in my knowing,",
          "plainText": "That dips in the same dish For in my knowing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "Timon has been this lord's father",
          "plainText": "Timon has been this lord's father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "And kept his credit with his purse,",
          "plainText": "And kept his credit with his purse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "Supported his estate, nay, Timon's money",
          "plainText": "Supported his estate nay Timon's money",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0031",
          "number": 31,
          "speechLineNumber": 7,
          "text": "Has paid his men their wages. He ne'er drinks",
          "plainText": "Has paid his men their wages He ne'er drinks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0032",
          "number": 32,
          "speechLineNumber": 8,
          "text": "But Timon's silver treads upon his lip,",
          "plainText": "But Timon's silver treads upon his lip",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0033",
          "number": 33,
          "speechLineNumber": 9,
          "text": "And yet—O, see the monstrousness of man",
          "plainText": "And yetO see the monstrousness of man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0034",
          "number": 34,
          "speechLineNumber": 10,
          "text": "When he looks out in an ungrateful shape—",
          "plainText": "When he looks out in an ungrateful shape",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0035",
          "number": 35,
          "speechLineNumber": 11,
          "text": "He does deny him, in respect of his,",
          "plainText": "He does deny him in respect of his",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0036",
          "number": 36,
          "speechLineNumber": 12,
          "text": "What charitable men afford to beggars.",
          "plainText": "What charitable men afford to beggars",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "third-stranger",
        "name": "THIRD STRANGER",
        "displayName": "Third Stranger"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Religion groans at it.",
          "plainText": "Religion groans at it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "first-stranger",
        "name": "FIRST STRANGER",
        "displayName": "First Stranger"
      },
      "lines": [
        {
          "id": "timon-of-athens-3-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "For mine own part,",
          "plainText": "For mine own part",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "I never tasted Timon in my life,",
          "plainText": "I never tasted Timon in my life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "Nor came any of his bounties over me",
          "plainText": "Nor came any of his bounties over me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0041",
          "number": 41,
          "speechLineNumber": 4,
          "text": "To mark me for his friend. Yet I protest,",
          "plainText": "To mark me for his friend Yet I protest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0042",
          "number": 42,
          "speechLineNumber": 5,
          "text": "For his right noble mind, illustrious virtue,",
          "plainText": "For his right noble mind illustrious virtue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0043",
          "number": 43,
          "speechLineNumber": 6,
          "text": "And honourable carriage,",
          "plainText": "And honourable carriage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0044",
          "number": 44,
          "speechLineNumber": 7,
          "text": "Had his necessity made use of me,",
          "plainText": "Had his necessity made use of me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0045",
          "number": 45,
          "speechLineNumber": 8,
          "text": "I would have put my wealth into donation,",
          "plainText": "I would have put my wealth into donation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0046",
          "number": 46,
          "speechLineNumber": 9,
          "text": "And the best half should have returned to him,",
          "plainText": "And the best half should have returned to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0047",
          "number": 47,
          "speechLineNumber": 10,
          "text": "So much I love his heart. But I perceive",
          "plainText": "So much I love his heart But I perceive",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0048",
          "number": 48,
          "speechLineNumber": 11,
          "text": "Men must learn now with pity to dispense,",
          "plainText": "Men must learn now with pity to dispense",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-3-2-line-0049",
          "number": 49,
          "speechLineNumber": 12,
          "text": "For policy sits above conscience.",
          "plainText": "For policy sits above conscience",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-3-2-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}