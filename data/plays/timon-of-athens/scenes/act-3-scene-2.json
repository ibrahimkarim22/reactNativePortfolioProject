    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@63405",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Lucius with three Strangers.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 12,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 24,
          "end": 33,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@63405/line-1",
          "start": 0,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5849062,
        "end": 5849186,
        "line": 217908,
        "column": 1,
        "path": "chap33/p@63405",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@63533",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nWho, the Lord Timon? He is my very good friend and an honourable gentleman.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@63533/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@63533/line-2",
          "start": 8,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5849190,
        "end": 5849303,
        "line": 217913,
        "column": 1,
        "path": "chap33/p@63533",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@63650",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST STRANGER.\nWe know him for no less, though we are but strangers to him. But I can tell you one thing, my lord, and which I hear from common rumours: now Lord Timon’s happy hours are done and past, and his estate shrinks from him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@63650/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@63650/line-2",
          "start": 16,
          "end": 234,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5849307,
        "end": 5849573,
        "line": 217918,
        "column": 1,
        "path": "chap33/p@63650",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "FIRST STRANGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@63920",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nFie, no, do not believe it; he cannot want for money.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@63920/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@63920/line-2",
          "start": 8,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5849577,
        "end": 5849668,
        "line": 217925,
        "column": 1,
        "path": "chap33/p@63920",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@64015",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND STRANGER.\nBut believe you this, my lord, that, not long ago one of his men was with the Lord Lucullus to borrow so many talents, nay, urged extremely for’t, and showed what necessity belonged to’t, and yet was denied.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64015/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64015/line-2",
          "start": 17,
          "end": 224,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5849672,
        "end": 5849928,
        "line": 217930,
        "column": 1,
        "path": "chap33/p@64015",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "SECOND STRANGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@64275",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nHow?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64275/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64275/line-2",
          "start": 8,
          "end": 12,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5849932,
        "end": 5849974,
        "line": 217937,
        "column": 1,
        "path": "chap33/p@64275",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@64321",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND STRANGER.\nI tell you, denied, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64321/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64321/line-2",
          "start": 17,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5849978,
        "end": 5850053,
        "line": 217942,
        "column": 1,
        "path": "chap33/p@64321",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "SECOND STRANGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 16
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@64400",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nWhat a strange case was that! Now, before the gods, I am ashamed on’t. Denied that honourable man? There was very little honour showed in’t. For my own part, I must needs confess, I have received some small kindnesses from him, as money, plate, jewels, and such like trifles, nothing comparing to his; yet had he mistook him, and sent to me, I should ne’er have denied his occasion so many talents.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64400/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64400/line-2",
          "start": 8,
          "end": 406,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5850057,
        "end": 5850498,
        "line": 217947,
        "column": 1,
        "path": "chap33/p@64400",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@64845",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Servilius.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 15,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64845/line-1",
          "start": 0,
          "end": 16,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5850502,
        "end": 5850577,
        "line": 217957,
        "column": 1,
        "path": "chap33/p@64845",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@64924",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVILIUS.\nSee, by good hap, yonder’s my lord; I have sweat to see his honour. [To Lucius.] My honoured lord!",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 80,
          "end": 89
        }
      ],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64924/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@64924/line-2",
          "start": 11,
          "end": 109,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5850581,
        "end": 5850728,
        "line": 217961,
        "column": 1,
        "path": "chap33/p@64924",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "SERVILIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@65075",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nServilius? You are kindly met, sir. Fare thee well. Commend me to thy honourable virtuous lord, my very exquisite friend.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65075/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65075/line-2",
          "start": 8,
          "end": 129,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5850732,
        "end": 5850890,
        "line": 217967,
        "column": 1,
        "path": "chap33/p@65075",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@65237",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVILIUS.\nMay it please your honour, my lord hath sent—",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65237/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65237/line-2",
          "start": 11,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5850894,
        "end": 5850980,
        "line": 217972,
        "column": 1,
        "path": "chap33/p@65237",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "SERVILIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@65327",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nHa! What has he sent? I am so much endeared to that lord; he’s ever sending. How shall I thank him, thinkest thou? And what has he sent now?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65327/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65327/line-2",
          "start": 8,
          "end": 148,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5850984,
        "end": 5851163,
        "line": 217977,
        "column": 1,
        "path": "chap33/p@65327",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@65510",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVILIUS.\nHas only sent his present occasion now, my lord, requesting your lordship to supply his instant use with so many talents.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65510/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65510/line-2",
          "start": 11,
          "end": 132,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5851167,
        "end": 5851330,
        "line": 217983,
        "column": 1,
        "path": "chap33/p@65510",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "SERVILIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@65677",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nI know his lordship is but merry with me;\nHe cannot want fifty-five hundred talents.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65677/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65677/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65677/line-3",
          "start": 50,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5851334,
        "end": 5851461,
        "line": 217989,
        "column": 1,
        "path": "chap33/p@65677",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@65808",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVILIUS.\nBut in the meantime he wants less, my lord.\nIf his occasion were not virtuous,\nI should not urge it half so faithfully.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65808/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65808/line-2",
          "start": 11,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65808/line-3",
          "start": 55,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65808/line-4",
          "start": 90,
          "end": 130,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5851465,
        "end": 5851635,
        "line": 217995,
        "column": 1,
        "path": "chap33/p@65808",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "SERVILIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@65982",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "LUCIUS.\nDost thou speak seriously, Servilius?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65982/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@65982/line-2",
          "start": 8,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5851639,
        "end": 5851714,
        "line": 218002,
        "column": 1,
        "path": "chap33/p@65982",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "LUCIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.2/p@66061",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVILIUS.\nUpon my soul, ’tis true, sir.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/p@66061/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.2/p@66061/line-2",
          "start": 11,
          "end": 40,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5851718,
        "end": 5851788,
        "line": 218007,
        "column": 1,
        "path": "chap33/p@66061",
        "anchor": "sceneIII_33.2"
      },
      "speakerLabel": "SERVILIUS.",
      "attribution": {
        "status": "explicit",
