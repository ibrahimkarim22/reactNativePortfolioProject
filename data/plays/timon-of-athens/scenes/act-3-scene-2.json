      "text": "SCENE II. A public place",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "b",
          "start": 0,
          "end": 24
        }
      ],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.2/h3@63334/line-1",
