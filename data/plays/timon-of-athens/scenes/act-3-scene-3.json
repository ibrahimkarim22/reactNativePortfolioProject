          "end": 66,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.3/p@69304/line-4",
          "start": 67,
          "end": 96,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5854961,
        "end": 5855097,
        "line": 218110,
        "column": 1,
        "path": "chap33/p@69304",
