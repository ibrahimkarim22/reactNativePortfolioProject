      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SERVANT.\nMy lord,\nThey have all been touched and found base metal,\nFor they have all denied him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.3/p@69304/line-1",
