    {
      "id": "timon-of-athens/sceneIII_33.5/p@83282",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SENATOR.\nYou breathe in vain.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83282/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83282/line-2",
          "start": 16,
          "end": 36,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5868939,
        "end": 5869005,
        "line": 218716,
        "column": 1,
        "path": "chap33/p@83282",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "SECOND SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@83352",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALCIBIADES.\nIn vain? His service done\nAt Lacedaemon and Byzantium\nWere a sufficient briber for his life.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83352/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83352/line-2",
          "start": 12,
          "end": 37,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83352/line-3",
          "start": 38,
          "end": 65,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83352/line-4",
          "start": 66,
          "end": 104,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5869009,
        "end": 5869153,
        "line": 218721,
        "column": 1,
        "path": "chap33/p@83352",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "ALCIBIADES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@83500",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SENATOR.\nWhat’s that?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83500/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83500/line-2",
          "start": 15,
          "end": 27,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5869157,
        "end": 5869214,
        "line": 218728,
        "column": 1,
        "path": "chap33/p@83500",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "FIRST SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@83561",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALCIBIADES.\nWhy, I say, my lords, has done fair service\nAnd slain in fight many of your enemies.\nHow full of valour did he bear himself\nIn the last conflict, and made plenteous wounds!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83561/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83561/line-2",
          "start": 12,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83561/line-3",
          "start": 56,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83561/line-4",
          "start": 97,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83561/line-5",
          "start": 136,
          "end": 184,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5869218,
        "end": 5869447,
        "line": 218733,
        "column": 1,
        "path": "chap33/p@83561",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "ALCIBIADES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@83794",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SENATOR.\nHe has made too much plenty with ’em.\nHe’s a sworn rioter. He has a sin\nThat often drowns him and takes his valour prisoner.\nIf there were no foes, that were enough\nTo overcome him. In that beastly fury,\nHe has been known to commit outrages\nAnd cherish factions. ’Tis inferred to us\nHis days are foul and his drink dangerous.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83794/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83794/line-2",
          "start": 16,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83794/line-3",
          "start": 54,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83794/line-4",
          "start": 88,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83794/line-5",
          "start": 141,
          "end": 180,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83794/line-6",
          "start": 181,
          "end": 219,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83794/line-7",
          "start": 220,
          "end": 256,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83794/line-8",
          "start": 257,
          "end": 298,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@83794/line-9",
          "start": 299,
          "end": 341,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
