    {
      "id": "timon-of-athens/sceneIII_33.5/p@84204",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SENATOR.\nHe dies.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84204/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84204/line-2",
          "start": 15,
          "end": 23,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5869861,
        "end": 5869914,
        "line": 218753,
        "column": 1,
        "path": "chap33/p@84204",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "FIRST SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@84261",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALCIBIADES.\nHard fate! He might have died in war.\nMy lords, if not for any parts in him,\nThough his right arm might purchase his own time\nAnd be in debt to none, yet, more to move you,\nTake my deserts to his and join ’em both.\nAnd, for I know your reverend ages love\nSecurity, I’ll pawn my victories, all\nMy honour, to you upon his good returns.\nIf by this crime he owes the law his life,\nWhy, let the war receive’t in valiant gore,\nFor law is strict, and war is nothing more.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-2",
          "start": 12,
          "end": 49,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-3",
          "start": 50,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-4",
          "start": 89,
          "end": 137,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-5",
          "start": 138,
          "end": 184,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-6",
          "start": 185,
          "end": 226,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-7",
          "start": 227,
          "end": 266,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-8",
