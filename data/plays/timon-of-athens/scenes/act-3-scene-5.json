          "end": 304,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-9",
          "start": 305,
          "end": 345,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-10",
          "start": 346,
          "end": 388,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-11",
          "start": 389,
          "end": 432,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84261/line-12",
          "start": 433,
          "end": 476,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5869918,
        "end": 5870474,
        "line": 218758,
        "column": 1,
        "path": "chap33/p@84261",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "ALCIBIADES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@84821",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SENATOR.\nWe are for law. He dies. Urge it no more,\nOn height of our displeasure. Friend or brother,\nHe forfeits his own blood that spills another.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84821/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84821/line-2",
          "start": 15,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84821/line-3",
          "start": 57,
          "end": 105,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@84821/line-4",
          "start": 106,
          "end": 152,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5870478,
        "end": 5870670,
        "line": 218773,
        "column": 1,
        "path": "chap33/p@84821",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "FIRST SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@85017",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALCIBIADES.\nMust it be so? It must not be.\nMy lords, I do beseech you, know me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85017/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85017/line-2",
          "start": 12,
          "end": 42,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85017/line-3",
          "start": 43,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5870674,
        "end": 5870788,
        "line": 218780,
        "column": 1,
        "path": "chap33/p@85017",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "ALCIBIADES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@85135",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SENATOR.\nHow?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85135/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85135/line-2",
          "start": 16,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5870792,
        "end": 5870842,
        "line": 218786,
        "column": 1,
        "path": "chap33/p@85135",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "SECOND SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@85189",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALCIBIADES.\nCall me to your remembrances.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85189/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85189/line-2",
          "start": 12,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5870846,
        "end": 5870917,
        "line": 218791,
        "column": 1,
        "path": "chap33/p@85189",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "ALCIBIADES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@85264",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD SENATOR.\nWhat?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85264/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85264/line-2",
          "start": 15,
          "end": 20,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5870921,
        "end": 5870971,
        "line": 218796,
        "column": 1,
        "path": "chap33/p@85264",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "THIRD SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@85318",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALCIBIADES.\nI cannot think but your age has forgot me,\nIt could not else be I should prove so base\nTo sue and be denied such common grace.\nMy wounds ache at you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85318/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85318/line-2",
          "start": 12,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85318/line-3",
          "start": 55,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85318/line-4",
          "start": 99,
          "end": 138,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85318/line-5",
          "start": 139,
          "end": 161,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5870975,
        "end": 5871181,
        "line": 218801,
        "column": 1,
        "path": "chap33/p@85318",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "ALCIBIADES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@85528",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SENATOR.\nDo you dare our anger?\n’Tis in few words, but spacious in effect:\nWe banish thee for ever.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85528/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85528/line-2",
          "start": 15,
          "end": 37,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85528/line-3",
          "start": 38,
          "end": 80,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIII_33.5/p@85528/line-4",
          "start": 81,
          "end": 105,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5871185,
        "end": 5871330,
        "line": 218809,
        "column": 1,
        "path": "chap33/p@85528",
        "anchor": "sceneIII_33.5"
      },
      "speakerLabel": "FIRST SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "timon-of-athens/sceneIII_33.5/p@85677",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ALCIBIADES.\nBanish me?\nBanish your dotage, banish usury,\nThat makes the Senate ugly.",
      "separatorAfter": "\n\n",
      "spans": [],
