  "scene": {
    "id": "timon-of-athens-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. Athens. A room in Timon's house",
    "location": "Athens. A room in Timon's house",
    "orderInPlay": 12
  },
  "content": [
    {
      "id": "timon-of-athens-4-2-stage-001",
      "type": "stage",
      "text": "Enter Flavius with two or three Servants."
    },
    {
      "id": "timon-of-athens-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-servant",
        "name": "FIRST SERVANT",
        "displayName": "First Servant"
      },
      "lines": [
        {
          "id": "timon-of-athens-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Hear you, Master Steward, where's our master?",
          "plainText": "Hear you Master Steward where's our master",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Are we undone, cast off, nothing remaining?",
          "plainText": "Are we undone cast off nothing remaining",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "flavius",
        "name": "FLAVIUS",
        "displayName": "Flavius"
      },
      "lines": [
        {
          "id": "timon-of-athens-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Alack, my fellows, what should I say to you?",
          "plainText": "Alack my fellows what should I say to you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Let me be recorded by the righteous gods,",
          "plainText": "Let me be recorded by the righteous gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "I am as poor as you.",
          "plainText": "I am as poor as you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-servant",
        "name": "FIRST SERVANT",
        "displayName": "First Servant"
      },
      "lines": [
        {
          "id": "timon-of-athens-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Such a house broke?",
          "plainText": "Such a house broke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "So noble a master fall'n? All gone, and not",
          "plainText": "So noble a master fall'n All gone and not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "One friend to take his fortune by the arm",
          "plainText": "One friend to take his fortune by the arm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "And go along with him?",
          "plainText": "And go along with him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-servant",
        "name": "SECOND SERVANT",
        "displayName": "Second Servant"
      },
      "lines": [
        {
          "id": "timon-of-athens-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "As we do turn our backs",
          "plainText": "As we do turn our backs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "From our companion, thrown into his grave,",
          "plainText": "From our companion thrown into his grave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "So his familiars to his buried fortunes",
          "plainText": "So his familiars to his buried fortunes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "Slink all away, leave their false vows with him,",
          "plainText": "Slink all away leave their false vows with him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 5,
          "text": "Like empty purses picked; and his poor self,",
          "plainText": "Like empty purses picked and his poor self",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 6,
          "text": "A dedicated beggar to the air,",
          "plainText": "A dedicated beggar to the air",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 7,
          "text": "With his disease of all-shunned poverty,",
          "plainText": "With his disease of allshunned poverty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 8,
          "text": "Walks, like contempt, alone.—More of our fellows.",
          "plainText": "Walks like contempt aloneMore of our fellows",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-4-2-stage-002",
      "type": "stage",
      "text": "Enter other Servants."
    },
    {
      "id": "timon-of-athens-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "flavius",
        "name": "FLAVIUS",
        "displayName": "Flavius"
      },
      "lines": [
        {
          "id": "timon-of-athens-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "All broken implements of a ruined house.",
          "plainText": "All broken implements of a ruined house",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "third-servant",
        "name": "THIRD SERVANT",
        "displayName": "Third Servant"
      },
      "lines": [
        {
          "id": "timon-of-athens-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Yet do our hearts wear Timon's livery.",
          "plainText": "Yet do our hearts wear Timon's livery",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "That see I by our faces. We are fellows still,",
          "plainText": "That see I by our faces We are fellows still",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Serving alike in sorrow. Leaked is our bark,",
          "plainText": "Serving alike in sorrow Leaked is our bark",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "And we, poor mates, stand on the dying deck,",
          "plainText": "And we poor mates stand on the dying deck",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "Hearing the surges threat. We must all part",
          "plainText": "Hearing the surges threat We must all part",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "Into this sea of air.",
          "plainText": "Into this sea of air",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "flavius",
        "name": "FLAVIUS",
        "displayName": "Flavius"
      },
      "lines": [
        {
          "id": "timon-of-athens-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Good fellows all,",
          "plainText": "Good fellows all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "The latest of my wealth I'll share amongst you.",
          "plainText": "The latest of my wealth I'll share amongst you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "Wherever we shall meet, for Timon's sake",
          "plainText": "Wherever we shall meet for Timon's sake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "Let's yet be fellows. Let's shake our heads and say,",
          "plainText": "Let's yet be fellows Let's shake our heads and say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "As 'twere a knell unto our master's fortune,",
          "plainText": "As 'twere a knell unto our master's fortune",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "\"We have seen better days.\" Let each take some.",
          "plainText": "We have seen better days Let each take some",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-4-2-stage-003",
      "type": "stage",
      "text": "[Offering them money.]"
    },
    {
      "id": "timon-of-athens-4-2-stage-004",
      "type": "stage",
      "text": "[They embrace and part several ways.]"
    },
    {
      "id": "timon-of-athens-4-2-stage-005",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}