    {
      "id": "timon-of-athens/sceneIV_33.2/p@98759",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLAVIUS.\nGood fellows all,\nThe latest of my wealth I’ll share amongst you.\nWherever we shall meet, for Timon’s sake\nLet’s yet be fellows. Let’s shake our heads and say,\nAs ’twere a knell unto our master’s fortune,\n“We have seen better days.” Let each take some.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIV_33.2/p@98759/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@98759/line-2",
          "start": 9,
          "end": 26,
          "sourceLineNumber": null
        },
        {
