          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97518/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97518/line-3",
          "start": 54,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97518/line-4",
          "start": 96,
          "end": 116,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5883175,
        "end": 5883331,
        "line": 219277,
        "column": 1,
        "path": "chap33/p@97518",
        "anchor": "sceneIV_33.2"
      },
      "speakerLabel": "FLAVIUS.",
      "attribution": {
