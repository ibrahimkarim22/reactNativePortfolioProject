      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[They embrace and part several ways.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 36
        }
      ],
      "lines": [
        {
