    {
      "id": "timon-of-athens/sceneIV_33.2/p@97375",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SERVANT.\nHear you, Master Steward, where’s our master?\nAre we undone, cast off, nothing remaining?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97375/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97375/line-2",
          "start": 15,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97375/line-3",
          "start": 61,
          "end": 104,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5883032,
        "end": 5883171,
        "line": 219271,
        "column": 1,
        "path": "chap33/p@97375",
        "anchor": "sceneIV_33.2"
      },
      "speakerLabel": "FIRST SERVANT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "timon-of-athens/sceneIV_33.2/p@97518",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FLAVIUS.\nAlack, my fellows, what should I say to you?\nLet me be recorded by the righteous gods,\nI am as poor as you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97518/line-1",
