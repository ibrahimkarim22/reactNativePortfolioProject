        "cueEnd": 8
      }
    },
    {
      "id": "timon-of-athens/sceneIV_33.2/p@97678",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SERVANT.\nSuch a house broke?\nSo noble a master fall’n? All gone, and not\nOne friend to take his fortune by the arm\nAnd go along with him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97678/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97678/line-2",
          "start": 15,
          "end": 34,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97678/line-3",
          "start": 35,
          "end": 78,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97678/line-4",
          "start": 79,
          "end": 120,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@97678/line-5",
          "start": 121,
          "end": 143,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5883335,
        "end": 5883523,
        "line": 219284,
        "column": 1,
        "path": "chap33/p@97678",
        "anchor": "sceneIV_33.2"
      },
      "speakerLabel": "FIRST SERVANT.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "timon-of-athens/sceneIV_33.2/p@97870",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SERVANT.\nAs we do turn our backs\nFrom our companion, thrown into his grave,\nSo his familiars to his buried fortunes\nSlink all away, leave their false vows with him,\nLike empty purses picked; and his poor self,\nA dedicated beggar to the air,\nWith his disease of all-shunned poverty,\nWalks, like contempt, alone.—More of our fellows.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
