          "end": 234,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneIV_33.2/p@98444/line-7",
          "start": 235,
          "end": 256,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5884101,
        "end": 5884412,
        "line": 219313,
        "column": 1,
        "path": "chap33/p@98444",
        "anchor": "sceneIV_33.2"
