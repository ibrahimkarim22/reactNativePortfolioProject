    {
      "id": "timon-of-athens/sceneV_33.3/p@149067",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THIRD SENATOR.\nHere come our brothers.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneV_33.3/p@149067/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneV_33.3/p@149067/line-2",
          "start": 15,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5934724,
        "end": 5934792,
        "line": 221206,
        "column": 1,
        "path": "chap33/p@149067",
        "anchor": "sceneV_33.3"
      },
      "speakerLabel": "THIRD SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "timon-of-athens/sceneV_33.3/p@149139",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SENATOR.\nNo talk of Timon, nothing of him expect.\nThe enemy’s drum is heard, and fearful scouring\nDoth choke the air with dust. In, and prepare.\nOurs is the fall, I fear, our foe’s the snare.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
