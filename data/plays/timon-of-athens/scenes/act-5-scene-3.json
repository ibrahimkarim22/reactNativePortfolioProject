    {
      "id": "timon-of-athens/sceneV_33.3/p@148183",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SENATOR.\nThou hast painfully discovered. Are his files\nAs full as thy report?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneV_33.3/p@148183/line-1",
          "start": 0,
          "end": 14,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneV_33.3/p@148183/line-2",
          "start": 15,
          "end": 60,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneV_33.3/p@148183/line-3",
          "start": 61,
          "end": 83,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5933840,
        "end": 5933958,
        "line": 221171,
        "column": 1,
        "path": "chap33/p@148183",
        "anchor": "sceneV_33.3"
      },
      "speakerLabel": "FIRST SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 14
      }
    },
    {
      "id": "timon-of-athens/sceneV_33.3/p@148305",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nI have spoke the least.\nBesides, his expedition promises\nPresent approach.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneV_33.3/p@148305/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneV_33.3/p@148305/line-2",
          "start": 11,
          "end": 34,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneV_33.3/p@148305/line-3",
          "start": 35,
          "end": 67,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneV_33.3/p@148305/line-4",
          "start": 68,
          "end": 85,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5933962,
        "end": 5934087,
        "line": 221177,
        "column": 1,
        "path": "chap33/p@148305",
        "anchor": "sceneV_33.3"
      },
      "speakerLabel": "MESSENGER.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "timon-of-athens/sceneV_33.3/p@148434",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SENATOR.\nWe stand much hazard if they bring not Timon.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneV_33.3/p@148434/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        },
        {
          "id": "timon-of-athens/sceneV_33.3/p@148434/line-2",
          "start": 16,
          "end": 61,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5934091,
        "end": 5934182,
        "line": 221184,
        "column": 1,
        "path": "chap33/p@148434",
        "anchor": "sceneV_33.3"
      },
      "speakerLabel": "SECOND SENATOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 15
      }
    },
    {
      "id": "timon-of-athens/sceneV_33.3/p@148529",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MESSENGER.\nI met a courier, one mine ancient friend,\nWhom, though in general part we were opposed,\nYet our old love made a particular force\nAnd made us speak like friends. This man was riding\nFrom Alcibiades to Timon’s cave\nWith letters of entreaty, which imported\nHis fellowship i’ th’ cause against your city,\nIn part for his sake moved.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "timon-of-athens/sceneV_33.3/p@148529/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
