    {
      "id": "timon-of-athens/sceneV_33.5/p@154442",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLDIER.\nMy noble general, Timon is dead,\nEntombed upon the very hem o’ th’ sea,\nAnd on his gravestone this insculpture, which\nWith wax I brought away, whose soft impression\nInterprets for my poor ignorance.",
