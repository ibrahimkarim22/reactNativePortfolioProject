    {
      "id": "timon-of-athens/sceneV_33.5/p@151802",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SENATOR.\nThese walls of ours\nWere not erected by their hands from whom\nYou have received your griefs; nor are they such\nThat these great towers, trophies, and schools should fall\nFor private faults in them.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
