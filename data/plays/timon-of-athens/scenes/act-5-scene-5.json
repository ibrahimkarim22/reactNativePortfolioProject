    {
      "id": "timon-of-athens/sceneV_33.5/p@153040",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SECOND SENATOR.\nWhat thou wilt,\nThou rather shalt enforce it with thy smile\nThan hew to ’t with thy sword.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
