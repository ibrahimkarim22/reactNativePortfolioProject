    {
      "id": "timon-of-athens/sceneV_33.5/p@151291",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FIRST SENATOR.\nNoble and young,\nWhen thy first griefs were but a mere conceit,\nEre thou hadst power or we had cause of fear,\nWe sent to thee to give thy rages balm,\nTo wipe out our ingratitude with loves\nAbove their quantity.",
      "separatorAfter": "\n\n",
