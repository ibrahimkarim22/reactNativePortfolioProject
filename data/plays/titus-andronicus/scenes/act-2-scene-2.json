        "line": 222995,
        "column": 1,
        "path": "chap34/p@44616",
        "anchor": "sceneII_34.2"
      },
      "speakerLabel": "DEMETRIUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
