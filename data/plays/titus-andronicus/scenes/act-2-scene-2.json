    {
      "id": "titus-andronicus/sceneII_34.2/p@42776",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Titus Andronicus and his three sons, and Marcus, making a noise with hounds and horns.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 22,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 47,
          "end": 54,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "titus-andronicus/sceneII_34.2/p@42776/line-1",
          "start": 0,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 5984135,
        "end": 5984317,
        "line": 222928,
        "column": 1,
        "path": "chap34/p@42776",
        "anchor": "sceneII_34.2"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "titus-andronicus/sceneII_34.2/p@42962",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TITUS.\nThe hunt is up, the morn is bright and grey,\nThe fields are fragrant, and the woods are green.\nUncouple here, and let us make a bay,\nAnd wake the emperor and his lovely bride,\nAnd rouse the prince, and ring a hunter’s peal,\nThat all the court may echo with the noise.\nSons, let it be your charge, as it is ours,\nTo attend the emperor’s person carefully.\nI have been troubled in my sleep this night,\nBut dawning day new comfort hath inspired.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "titus-andronicus/sceneII_34.2/p@42962/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
