        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "titus-andronicus/sceneIII_34.2/p@88731",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TITUS.\nPeace, tender sapling; thou art made of tears,\nAnd tears will quickly melt thy life away.",
      "separatorAfter": "\n\n",
      "spans": [],
