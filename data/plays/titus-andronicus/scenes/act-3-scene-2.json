    {
      "id": "titus-andronicus/sceneIII_34.2/p@89780",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARCUS.\nPardon me, sir; ’twas a black ill-favoured fly,\nLike to the empress’ Moor; therefore I killed him.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "titus-andronicus/sceneIII_34.2/p@89780/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "titus-andronicus/sceneIII_34.2/p@89780/line-2",
          "start": 8,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "titus-andronicus/sceneIII_34.2/p@89780/line-3",
          "start": 56,
          "end": 106,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6031139,
        "end": 6031280,
        "line": 224500,
        "column": 1,
        "path": "chap34/p@89780",
        "anchor": "sceneIII_34.2"
      },
      "speakerLabel": "MARCUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "titus-andronicus/sceneIII_34.2/p@89925",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TITUS.\nO, O, O!\nThen pardon me for reprehending thee,\nFor thou hast done a charitable deed.\nGive me thy knife, I will insult on him,\nFlattering myself as if it were the Moor\nCome hither purposely to poison me.\nThere’s for thyself, and that’s for Tamora.\nAh, sirrah!\nYet, I think, we are not brought so low\nBut that between us we can kill a fly\nThat comes in likeness of a coal-black Moor.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
