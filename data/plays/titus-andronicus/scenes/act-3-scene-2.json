        "cueStart": 0,
        "cueEnd": 13
      }
    },
    {
      "id": "titus-andronicus/sceneIII_34.2/p@88601",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MARCUS.\nAlas, the tender boy, in passion moved,\nDoth weep to see his grandsire’s heaviness.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "titus-andronicus/sceneIII_34.2/p@88601/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "titus-andronicus/sceneIII_34.2/p@88601/line-2",
          "start": 8,
          "end": 47,
          "sourceLineNumber": null
        },
        {
          "id": "titus-andronicus/sceneIII_34.2/p@88601/line-3",
          "start": 48,
          "end": 91,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6029960,
        "end": 6030086,
        "line": 224452,
        "column": 1,
        "path": "chap34/p@88601",
        "anchor": "sceneIII_34.2"
      },
      "speakerLabel": "MARCUS.",
      "attribution": {
