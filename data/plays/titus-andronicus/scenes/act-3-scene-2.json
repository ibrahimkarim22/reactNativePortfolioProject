      }
    },
    {
      "id": "titus-andronicus/sceneIII_34.2/p@90532",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TITUS.\nCome, take away. Lavinia, go with me.\nI’ll to thy closet, and go read with thee\nSad stories chanced in the times of old.\nCome, boy, and go with me. Thy sight is young,\nAnd thou shalt read when mine begin to dazzle.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
