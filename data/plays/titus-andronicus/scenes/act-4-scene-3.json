  "scene": {
    "id": "titus-andronicus-4-3",
    "act": 4,
    "scene": 3,
    "label": "Act 4, Scene 3",
    "title": "SCENE III. Rome. A public Place",
    "location": "Rome. A public Place",
    "orderInPlay": 10
  },
  "content": [
    {
      "id": "titus-andronicus-4-3-stage-001",
      "type": "stage",
      "text": "Enter Titus, old Marcus, his son Publius, Young Lucius, and other gentlemen with bows, and Titus bears the arrows with letters on the ends of them."
    },
    {
      "id": "titus-andronicus-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Come, Marcus, come. Kinsmen, this is the way.",
          "plainText": "Come Marcus come Kinsmen this is the way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Sir boy, let me see your archery.",
          "plainText": "Sir boy let me see your archery",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Look ye draw home enough, and 'tis there straight.",
          "plainText": "Look ye draw home enough and 'tis there straight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Terras Astraea reliquit.",
          "plainText": "Terras Astraea reliquit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Be you remembered, Marcus, she's gone, she's fled.",
          "plainText": "Be you remembered Marcus she's gone she's fled",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Sirs, take you to your tools. You, cousins, shall",
          "plainText": "Sirs take you to your tools You cousins shall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Go sound the ocean and cast your nets;",
          "plainText": "Go sound the ocean and cast your nets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Happily you may catch her in the sea;",
          "plainText": "Happily you may catch her in the sea",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Yet there's as little justice as at land.",
          "plainText": "Yet there's as little justice as at land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "No; Publius and Sempronius, you must do it;",
          "plainText": "No Publius and Sempronius you must do it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "'Tis you must dig with mattock and with spade,",
          "plainText": "'Tis you must dig with mattock and with spade",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "And pierce the inmost centre of the earth.",
          "plainText": "And pierce the inmost centre of the earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "Then, when you come to Pluto's region,",
          "plainText": "Then when you come to Pluto's region",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "I pray you, deliver him this petition;",
          "plainText": "I pray you deliver him this petition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "Tell him it is for justice and for aid,",
          "plainText": "Tell him it is for justice and for aid",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "And that it comes from old Andronicus,",
          "plainText": "And that it comes from old Andronicus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "Shaken with sorrows in ungrateful Rome.",
          "plainText": "Shaken with sorrows in ungrateful Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Ah, Rome! Well, well, I made thee miserable",
          "plainText": "Ah Rome Well well I made thee miserable",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "What time I threw the people's suffrages",
          "plainText": "What time I threw the people's suffrages",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "On him that thus doth tyrannize o'er me.",
          "plainText": "On him that thus doth tyrannize o'er me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "Go, get you gone; and pray be careful all,",
          "plainText": "Go get you gone and pray be careful all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "And leave you not a man-of-war unsearched.",
          "plainText": "And leave you not a manofwar unsearched",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "This wicked emperor may have shipped her hence;",
          "plainText": "This wicked emperor may have shipped her hence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "And, kinsmen, then we may go pipe for justice.",
          "plainText": "And kinsmen then we may go pipe for justice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "marcus",
        "name": "MARCUS",
        "displayName": "Marcus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "O Publius, is not this a heavy case,",
          "plainText": "O Publius is not this a heavy case",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "To see thy noble uncle thus distract?",
          "plainText": "To see thy noble uncle thus distract",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "publius",
        "name": "PUBLIUS",
        "displayName": "Publius"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Therefore, my lords, it highly us concerns",
          "plainText": "Therefore my lords it highly us concerns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "By day and night to attend him carefully,",
          "plainText": "By day and night to attend him carefully",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "And feed his humour kindly as we may,",
          "plainText": "And feed his humour kindly as we may",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "Till time beget some careful remedy.",
          "plainText": "Till time beget some careful remedy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "marcus",
        "name": "MARCUS",
        "displayName": "Marcus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Kinsmen, his sorrows are past remedy,",
          "plainText": "Kinsmen his sorrows are past remedy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "But....",
          "plainText": "But",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "Join with the Goths, and with revengeful war",
          "plainText": "Join with the Goths and with revengeful war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "Take wreak on Rome for this ingratitude,",
          "plainText": "Take wreak on Rome for this ingratitude",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0035",
          "number": 35,
          "speechLineNumber": 5,
          "text": "And vengeance on the traitor Saturnine.",
          "plainText": "And vengeance on the traitor Saturnine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Publius, how now? How now, my masters?",
          "plainText": "Publius how now How now my masters",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "What, have you met with her?",
          "plainText": "What have you met with her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "publius",
        "name": "PUBLIUS",
        "displayName": "Publius"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "No, my good lord; but Pluto sends you word,",
          "plainText": "No my good lord but Pluto sends you word",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "If you will have Revenge from hell, you shall.",
          "plainText": "If you will have Revenge from hell you shall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "Marry, for Justice, she is so employed,",
          "plainText": "Marry for Justice she is so employed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0041",
          "number": 41,
          "speechLineNumber": 4,
          "text": "He thinks, with Jove in heaven, or somewhere else,",
          "plainText": "He thinks with Jove in heaven or somewhere else",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0042",
          "number": 42,
          "speechLineNumber": 5,
          "text": "So that perforce you must needs stay a time.",
          "plainText": "So that perforce you must needs stay a time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "He doth me wrong to feed me with delays.",
          "plainText": "He doth me wrong to feed me with delays",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "I'll dive into the burning lake below,",
          "plainText": "I'll dive into the burning lake below",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "And pull her out of Acheron by the heels.",
          "plainText": "And pull her out of Acheron by the heels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "Marcus, we are but shrubs, no cedars we,",
          "plainText": "Marcus we are but shrubs no cedars we",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0047",
          "number": 47,
          "speechLineNumber": 5,
          "text": "No big-boned men framed of the Cyclops' size;",
          "plainText": "No bigboned men framed of the Cyclops' size",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0048",
          "number": 48,
          "speechLineNumber": 6,
          "text": "But metal, Marcus, steel to the very back,",
          "plainText": "But metal Marcus steel to the very back",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0049",
          "number": 49,
          "speechLineNumber": 7,
          "text": "Yet wrung with wrongs more than our backs can bear;",
          "plainText": "Yet wrung with wrongs more than our backs can bear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0050",
          "number": 50,
          "speechLineNumber": 8,
          "text": "And sith there's no justice in earth nor hell,",
          "plainText": "And sith there's no justice in earth nor hell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0051",
          "number": 51,
          "speechLineNumber": 9,
          "text": "We will solicit heaven and move the gods",
          "plainText": "We will solicit heaven and move the gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0052",
          "number": 52,
          "speechLineNumber": 10,
          "text": "To send down Justice for to wreak our wrongs.",
          "plainText": "To send down Justice for to wreak our wrongs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0053",
          "number": 53,
          "speechLineNumber": 11,
          "text": "Come, to this gear. You are a good archer, Marcus.",
          "plainText": "Come to this gear You are a good archer Marcus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-stage-002",
      "type": "stage",
      "text": "[He gives them the arrows.]"
    },
    {
      "id": "titus-andronicus-4-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "marcus",
        "name": "MARCUS",
        "displayName": "Marcus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Kinsmen, shoot all your shafts into the court.",
          "plainText": "Kinsmen shoot all your shafts into the court",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "We will afflict the emperor in his pride.",
          "plainText": "We will afflict the emperor in his pride",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Now, masters, draw. [They shoot.] O, well said, Lucius!",
          "plainText": "Now masters draw They shoot O well said Lucius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0057",
          "number": 57,
          "speechLineNumber": 2,
          "text": "Good boy, in Virgo's lap! Give it Pallas.",
          "plainText": "Good boy in Virgo's lap Give it Pallas",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "marcus",
        "name": "MARCUS",
        "displayName": "Marcus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "My lord, I aim a mile beyond the moon.",
          "plainText": "My lord I aim a mile beyond the moon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "Your letter is with Jupiter by this.",
          "plainText": "Your letter is with Jupiter by this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Ha! ha! Publius, Publius, what hast thou done?",
          "plainText": "Ha ha Publius Publius what hast thou done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "See, see, thou hast shot off one of Taurus' horns.",
          "plainText": "See see thou hast shot off one of Taurus' horns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "marcus",
        "name": "MARCUS",
        "displayName": "Marcus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "This was the sport, my lord; when Publius shot,",
          "plainText": "This was the sport my lord when Publius shot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "The Bull, being galled, gave Aries such a knock",
          "plainText": "The Bull being galled gave Aries such a knock",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "That down fell both the Ram's horns in the court;",
          "plainText": "That down fell both the Ram's horns in the court",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "And who should find them but the empress' villain?",
          "plainText": "And who should find them but the empress' villain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0066",
          "number": 66,
          "speechLineNumber": 5,
          "text": "She laughed, and told the Moor he should not choose",
          "plainText": "She laughed and told the Moor he should not choose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0067",
          "number": 67,
          "speechLineNumber": 6,
          "text": "But give them to his master for a present.",
          "plainText": "But give them to his master for a present",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Why, there it goes. God give his lordship joy!",
          "plainText": "Why there it goes God give his lordship joy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-stage-003",
      "type": "stage",
      "text": "Enter the Clown with a basket and two pigeons in it."
    },
    {
      "id": "titus-andronicus-4-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Ho, the gibbet-maker? He says that he hath taken them down again, for the man must not be hanged till the next week.",
          "plainText": "Ho the gibbetmaker He says that he hath taken them down again for the man must not be hanged till the next week",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "But what says Jupiter, I ask thee?",
          "plainText": "But what says Jupiter I ask thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Alas, sir, I know not Jubiter; I never drank with him in all my life.",
          "plainText": "Alas sir I know not Jubiter I never drank with him in all my life",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Why, villain, art not thou the carrier?",
          "plainText": "Why villain art not thou the carrier",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Ay, of my pigeons, sir; nothing else.",
          "plainText": "Ay of my pigeons sir nothing else",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Why, didst thou not come from heaven?",
          "plainText": "Why didst thou not come from heaven",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "From heaven? Alas, sir, I never came there. God forbid I should be so bold to press to heaven in my young days. Why, I am going with my pigeons to the tribunal plebs, to take up a matter of brawl betwixt my uncle and one of the emperal's men.",
          "plainText": "From heaven Alas sir I never came there God forbid I should be so bold to press to heaven in my young days Why I am going with my pigeons to the tribunal plebs to take up a matter of brawl betwixt my uncle and one of the emperal's men",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "marcus",
        "name": "MARCUS",
        "displayName": "Marcus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Why, sir, that is as fit as can be to serve for your oration; and let him deliver the pigeons to the emperor from you.",
          "plainText": "Why sir that is as fit as can be to serve for your oration and let him deliver the pigeons to the emperor from you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Tell me, can you deliver an oration to the emperor with a grace?",
          "plainText": "Tell me can you deliver an oration to the emperor with a grace",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "Nay, truly, sir, I could never say grace in all my life.",
          "plainText": "Nay truly sir I could never say grace in all my life",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Sirrah, come hither. Make no more ado,",
          "plainText": "Sirrah come hither Make no more ado",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0080",
          "number": 80,
          "speechLineNumber": 2,
          "text": "But give your pigeons to the emperor.",
          "plainText": "But give your pigeons to the emperor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0081",
          "number": 81,
          "speechLineNumber": 3,
          "text": "By me thou shalt have justice at his hands.",
          "plainText": "By me thou shalt have justice at his hands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0082",
          "number": 82,
          "speechLineNumber": 4,
          "text": "Hold, hold; meanwhile here's money for thy charges.",
          "plainText": "Hold hold meanwhile here's money for thy charges",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0083",
          "number": 83,
          "speechLineNumber": 5,
          "text": "Give me pen and ink.",
          "plainText": "Give me pen and ink",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0084",
          "number": 84,
          "speechLineNumber": 6,
          "text": "Sirrah, can you with a grace deliver up a supplication?",
          "plainText": "Sirrah can you with a grace deliver up a supplication",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0085",
          "number": 85,
          "speechLineNumber": 1,
          "text": "Ay, sir.",
          "plainText": "Ay sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "Then here is a supplication for you. And when you come to him, at the first approach you must kneel; then kiss his foot; then deliver up your pigeons; and then look for your reward. I'll be at hand, sir; see you do it bravely.",
          "plainText": "Then here is a supplication for you And when you come to him at the first approach you must kneel then kiss his foot then deliver up your pigeons and then look for your reward I'll be at hand sir see you do it bravely",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0087",
          "number": 87,
          "speechLineNumber": 1,
          "text": "I warrant you, sir; let me alone.",
          "plainText": "I warrant you sir let me alone",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0088",
          "number": 88,
          "speechLineNumber": 1,
          "text": "Sirrah, hast thou a knife? Come let me see it.",
          "plainText": "Sirrah hast thou a knife Come let me see it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0089",
          "number": 89,
          "speechLineNumber": 2,
          "text": "Here, Marcus, fold it in the oration;",
          "plainText": "Here Marcus fold it in the oration",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0090",
          "number": 90,
          "speechLineNumber": 3,
          "text": "For thou hast made it like a humble suppliant.",
          "plainText": "For thou hast made it like a humble suppliant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0091",
          "number": 91,
          "speechLineNumber": 4,
          "text": "And when thou hast given it to the emperor,",
          "plainText": "And when thou hast given it to the emperor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-4-3-line-0092",
          "number": 92,
          "speechLineNumber": 5,
          "text": "Knock at my door, and tell me what he says.",
          "plainText": "Knock at my door and tell me what he says",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "God be with you, sir; I will.",
          "plainText": "God be with you sir I will",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "titus-andronicus-4-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-4-3-line-0094",
          "number": 94,
          "speechLineNumber": 1,
          "text": "Come, Marcus, let us go. Publius, follow me.",
          "plainText": "Come Marcus let us go Publius follow me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-4-3-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}