    {
      "id": "titus-andronicus/sceneIV_34.4/p@124173",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SATURNINUS.\nBut he will not entreat his son for us.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "titus-andronicus/sceneIV_34.4/p@124173/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "titus-andronicus/sceneIV_34.4/p@124173/line-2",
          "start": 12,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6065532,
        "end": 6065613,
        "line": 225734,
        "column": 1,
        "path": "chap34/p@124173",
        "anchor": "sceneIV_34.4"
      },
      "speakerLabel": "SATURNINUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "titus-andronicus/sceneIV_34.4/p@124258",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TAMORA.\nIf Tamora entreat him, then he will,\nFor I can smooth and fill his aged ears\nWith golden promises, that, were his heart\nAlmost impregnable, his old ears deaf,\nYet should both ear and heart obey my tongue.\n[to Aemilius] Go thou before, be our ambassador.\nSay that the emperor requests a parley\nOf warlike Lucius, and appoint the meeting\nEven at his father’s house, the old Andronicus.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 214,
          "end": 225
        }
      ],
      "lines": [
