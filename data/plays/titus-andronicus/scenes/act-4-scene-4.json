      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TAMORA.\nWhy should you fear? Is not your city strong?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "titus-andronicus/sceneIV_34.4/p@123309/line-1",
