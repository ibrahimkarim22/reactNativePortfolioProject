    {
      "id": "titus-andronicus/sceneIV_34.4/p@122484",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AEMILIUS.\nArm, my lord! Rome never had more cause.\nThe Goths have gathered head, and with a power\nOf high-resolved men, bent to the spoil,\nThey hither march amain, under conduct\nOf Lucius, son to old Andronicus;\nWho threats, in course of this revenge, to do\nAs much as ever Coriolanus did.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "titus-andronicus/sceneIV_34.4/p@122484/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "titus-andronicus/sceneIV_34.4/p@122484/line-2",
          "start": 10,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "titus-andronicus/sceneIV_34.4/p@122484/line-3",
          "start": 51,
          "end": 97,
          "sourceLineNumber": null
        },
        {
