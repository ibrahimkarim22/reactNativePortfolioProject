      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "What news with thee, Aemilius?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "titus-andronicus/sceneIV_34.4/p@122425/line-1",
          "start": 0,
          "end": 30,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
