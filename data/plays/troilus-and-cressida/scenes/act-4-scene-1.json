    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@133185",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nYou are too bitter to your country-woman.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133185/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133185/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6235140,
        "end": 6235218,
        "line": 232182,
        "column": 1,
        "path": "chap35/p@133185",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "PARIS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@133267",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIOMEDES.\nShe’s bitter to her country. Hear me, Paris:\nFor every false drop in her bawdy veins\nA Grecian’s life hath sunk; for every scruple\nOf her contaminated carrion weight\nA Trojan hath been slain. Since she could speak,\nShe hath not given so many good words breath\nAs for her Greeks and Trojans suff’red death.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133267/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133267/line-2",
          "start": 10,
          "end": 54,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133267/line-3",
          "start": 55,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133267/line-4",
          "start": 95,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133267/line-5",
          "start": 141,
          "end": 175,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133267/line-6",
          "start": 176,
          "end": 224,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133267/line-7",
          "start": 225,
          "end": 269,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133267/line-8",
          "start": 270,
          "end": 315,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6235222,
        "end": 6235597,
        "line": 232187,
        "column": 1,
        "path": "chap35/p@133267",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "DIOMEDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@133646",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nFair Diomed, you do as chapmen do,\nDispraise the thing that you desire to buy;\nBut we in silence hold this virtue well,\nWe’ll not commend what we intend to sell.\nHere lies our way.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133646/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@133646/line-2",
          "start": 7,
          "end": 41,
          "sourceLineNumber": null
        },
        {
