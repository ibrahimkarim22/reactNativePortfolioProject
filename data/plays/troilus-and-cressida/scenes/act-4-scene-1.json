        "status": "not-applicable"
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@129064",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter, at one side, Aeneas and servant with a torch; at another Paris, Deiphobus, Antenor, Diomedes the Grecian, and others, with torches.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 20,
          "end": 26,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 64,
          "end": 99,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129064/line-1",
          "start": 0,
          "end": 138,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6231019,
        "end": 6231248,
        "line": 232025,
        "column": 1,
        "path": "chap35/p@129064",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@129297",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nSee, ho! Who is that there?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129297/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129297/line-2",
          "start": 7,
          "end": 34,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6231252,
        "end": 6231316,
        "line": 232031,
        "column": 1,
        "path": "chap35/p@129297",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "PARIS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@129365",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DEIPHOBUS.\nIt is the Lord Aeneas.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129365/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129365/line-2",
          "start": 11,
          "end": 33,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6231320,
        "end": 6231383,
        "line": 232036,
        "column": 1,
        "path": "chap35/p@129365",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "DEIPHOBUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@129432",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AENEAS.\nIs the Prince there in person?\nHad I so good occasion to lie long\nAs you, Prince Paris, nothing but heavenly business\nShould rob my bed-mate of my company.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129432/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129432/line-2",
          "start": 8,
          "end": 38,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129432/line-3",
          "start": 39,
          "end": 73,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129432/line-4",
          "start": 74,
          "end": 125,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129432/line-5",
          "start": 126,
          "end": 163,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6231387,
        "end": 6231595,
        "line": 232041,
        "column": 1,
        "path": "chap35/p@129432",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "AENEAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@129644",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIOMEDES.\nThat’s my mind too. Good morrow, Lord Aeneas.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129644/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129644/line-2",
          "start": 10,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6231599,
        "end": 6231684,
        "line": 232049,
        "column": 1,
        "path": "chap35/p@129644",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "DIOMEDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@129733",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nA valiant Greek, Aeneas—take his hand:\nWitness the process of your speech, wherein\nYou told how Diomed, a whole week by days,\nDid haunt you in the field.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129733/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129733/line-2",
          "start": 7,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129733/line-3",
          "start": 46,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129733/line-4",
          "start": 90,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129733/line-5",
          "start": 133,
          "end": 160,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6231688,
        "end": 6231893,
        "line": 232054,
        "column": 1,
        "path": "chap35/p@129733",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "PARIS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@129942",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AENEAS.\nHealth to you, valiant sir,\nDuring all question of the gentle truce;\nBut when I meet you arm’d, as black defiance\nAs heart can think or courage execute.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129942/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129942/line-2",
          "start": 8,
          "end": 35,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129942/line-3",
          "start": 36,
          "end": 76,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129942/line-4",
          "start": 77,
          "end": 121,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@129942/line-5",
          "start": 122,
          "end": 160,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6231897,
        "end": 6232102,
        "line": 232062,
        "column": 1,
        "path": "chap35/p@129942",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "AENEAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@130151",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIOMEDES.\nThe one and other Diomed embraces.\nOur bloods are now in calm; and so long health!\nBut when contention and occasion meet,\nBy Jove, I’ll play the hunter for thy life\nWith all my force, pursuit, and policy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130151/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130151/line-2",
          "start": 10,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130151/line-3",
          "start": 45,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130151/line-4",
          "start": 93,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130151/line-5",
          "start": 132,
          "end": 174,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130151/line-6",
          "start": 175,
          "end": 214,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6232106,
        "end": 6232370,
        "line": 232070,
        "column": 1,
        "path": "chap35/p@130151",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "DIOMEDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@130419",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AENEAS.\nAnd thou shalt hunt a lion that will fly\nWith his face backward. In humane gentleness,\nWelcome to Troy! Now, by Anchises’ life,\nWelcome indeed! By Venus’ hand I swear\nNo man alive can love in such a sort\nThe thing he means to kill, more excellently.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130419/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130419/line-2",
          "start": 8,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130419/line-3",
          "start": 49,
          "end": 94,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130419/line-4",
          "start": 95,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130419/line-5",
          "start": 136,
          "end": 174,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130419/line-6",
          "start": 175,
          "end": 211,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130419/line-7",
          "start": 212,
          "end": 257,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6232374,
        "end": 6232686,
        "line": 232079,
        "column": 1,
        "path": "chap35/p@130419",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "AENEAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@130735",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIOMEDES.\nWe sympathise. Jove let Aeneas live,\nIf to my sword his fate be not the glory,\nA thousand complete courses of the sun!\nBut in mine emulous honour let him die\nWith every joint a wound, and that tomorrow!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130735/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130735/line-2",
          "start": 10,
          "end": 46,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130735/line-3",
          "start": 47,
          "end": 88,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130735/line-4",
          "start": 89,
          "end": 128,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130735/line-5",
          "start": 129,
          "end": 167,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@130735/line-6",
          "start": 168,
          "end": 212,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6232690,
        "end": 6232952,
        "line": 232089,
        "column": 1,
        "path": "chap35/p@130735",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "DIOMEDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@131001",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AENEAS.\nWe know each other well.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131001/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131001/line-2",
          "start": 8,
          "end": 32,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6232956,
        "end": 6233018,
        "line": 232098,
        "column": 1,
        "path": "chap35/p@131001",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "AENEAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@131067",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIOMEDES.\nWe do; and long to know each other worse.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131067/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131067/line-2",
          "start": 10,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6233022,
        "end": 6233103,
        "line": 232103,
        "column": 1,
        "path": "chap35/p@131067",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "DIOMEDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@131152",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nThis is the most despiteful gentle greeting,\nThe noblest hateful love, that e’er I heard of.\nWhat business, lord, so early?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131152/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131152/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131152/line-3",
          "start": 52,
          "end": 99,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131152/line-4",
          "start": 100,
          "end": 130,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6233107,
        "end": 6233277,
        "line": 232108,
        "column": 1,
        "path": "chap35/p@131152",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "PARIS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@131326",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AENEAS.\nI was sent for to the King; but why, I know not.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131326/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131326/line-2",
          "start": 8,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6233281,
        "end": 6233367,
        "line": 232115,
        "column": 1,
        "path": "chap35/p@131326",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "AENEAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@131416",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nHis purpose meets you: ’twas to bring this Greek\nTo Calchas’ house, and there to render him,\nFor the enfreed Antenor, the fair Cressid.\nLet’s have your company; or, if you please,\nHaste there before us. I constantly believe—\nOr rather call my thought a certain knowledge—\nMy brother Troilus lodges there tonight.\nRouse him and give him note of our approach,\nWith the whole quality wherefore; I fear\nWe shall be much unwelcome.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131416/line-1",
