    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@131928",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AENEAS.\nThat I assure you:\nTroilus had rather Troy were borne to Greece\nThan Cressid borne from Troy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131928/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131928/line-2",
          "start": 8,
          "end": 26,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131928/line-3",
          "start": 27,
          "end": 71,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@131928/line-4",
          "start": 72,
          "end": 101,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6233883,
        "end": 6234024,
        "line": 232134,
        "column": 1,
        "path": "chap35/p@131928",
        "anchor": "sceneIV_35.1"
      },
      "speakerLabel": "AENEAS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "troilus-and-cressida/sceneIV_35.1/p@132073",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nThere is no help;\nThe bitter disposition of the time\nWill have it so. On, lord; we’ll follow you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.1/p@132073/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
