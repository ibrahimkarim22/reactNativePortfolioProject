    {
      "id": "troilus-and-cressida/sceneIV_35.3/p@142140",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TROILUS.\nWalk into her house.\nI’ll bring her to the Grecian presently;\nAnd to his hand when I deliver her,\nThink it an altar, and thy brother Troilus\nA priest, there off’ring to it his own heart.",
      "separatorAfter": "\n\n",
      "spans": [],
