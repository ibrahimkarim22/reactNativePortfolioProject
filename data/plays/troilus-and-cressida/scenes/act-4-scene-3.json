    {
      "id": "troilus-and-cressida/sceneIV_35.3/p@141890",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "PARIS.\nIt is great morning; and the hour prefix’d\nFor her delivery to this valiant Greek\nComes fast upon. Good my brother Troilus,\nTell you the lady what she is to do\nAnd haste her to the purpose.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneIV_35.3/p@141890/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneIV_35.3/p@141890/line-2",
          "start": 7,
          "end": 49,
          "sourceLineNumber": null
        },
