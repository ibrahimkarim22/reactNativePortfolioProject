        "end": 6319218,
        "line": 235869,
        "column": 1,
        "path": "chap35/p@217200",
        "anchor": "sceneV_35.10"
      },
      "speakerLabel": "PANDARUS.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.10/p@217267",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TROILUS.\nHence, broker-lackey. Ignominy and shame\nPursue thy life, and live aye with thy name!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.10/p@217267/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
