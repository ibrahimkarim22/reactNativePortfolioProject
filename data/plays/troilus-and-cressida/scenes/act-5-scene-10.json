    },
    {
      "id": "troilus-and-cressida/sceneV_35.10/p@217400",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exeunt all but Pandarus.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 15
        },
        {
          "tag": "span",
          "start": 16,
          "end": 24,
