          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6317514,
        "end": 6317573,
        "line": 235820,
        "column": 1,
        "path": "chap35/p@215559",
        "anchor": "sceneV_35.10"
      },
      "speakerLabel": "ALL.",
      "attribution": {
