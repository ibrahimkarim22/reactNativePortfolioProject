        }
      ],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.10/p@217400/line-1",
          "start": 0,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6319355,
        "end": 6319443,
        "line": 235880,
        "column": 1,
        "path": "chap35/p@217400",
