        "cueEnd": 4
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.10/p@215622",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TROILUS.\nHe’s dead, and at the murderer’s horse’s tail,\nIn beastly sort, dragg’d through the shameful field.\nFrown on, you heavens, effect your rage with speed.\nSit, gods, upon your thrones, and smile at Troy.\nI say at once let your brief plagues be mercy,\nAnd linger not our sure destructions on.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.10/p@215622/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.10/p@215622/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        },
        {
