    {
      "id": "troilus-and-cressida/sceneV_35.4/p@202691",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TROILUS.\nFly not; for shouldst thou take the river Styx, I would swim after.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.4/p@202691/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.4/p@202691/line-2",
          "start": 9,
          "end": 76,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6304646,
        "end": 6304752,
        "line": 235252,
        "column": 1,
        "path": "chap35/p@202691",
        "anchor": "sceneV_35.4"
      },
      "speakerLabel": "TROILUS.",
      "attribution": {
