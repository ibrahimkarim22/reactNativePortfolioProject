    {
      "id": "troilus-and-cressida/sceneV_35.4/p@203666",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THERSITES.\nGod-a-mercy, that thou wilt believe me; but a plague break thy neck for frighting me! What’s become of the wenching rogues? I think they have swallowed one another. I would laugh at that miracle. Yet, in a sort, lechery eats itself. I’ll seek them.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.4/p@203666/line-1",
