        "end": 6305508,
        "line": 235285,
        "column": 1,
        "path": "chap35/p@203446",
        "anchor": "sceneV_35.4"
      },
      "speakerLabel": "THERSITES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.4/p@203557",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HECTOR.\nI do believe thee. Live.",
      "separatorAfter": "\n\n",
      "spans": [],
