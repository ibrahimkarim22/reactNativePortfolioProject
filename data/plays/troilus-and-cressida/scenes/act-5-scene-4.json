          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6303482,
        "end": 6303578,
        "line": 235225,
        "column": 1,
        "path": "chap35/p@201527",
        "anchor": "sceneV_35.4"
      },
      "speakerLabel": null,
