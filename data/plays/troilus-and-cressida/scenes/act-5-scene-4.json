    {
      "id": "troilus-and-cressida/sceneV_35.4/p@203319",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HECTOR.\nWhat art thou, Greek? Art thou for Hector’s match?\nArt thou of blood and honour?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.4/p@203319/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.4/p@203319/line-2",
          "start": 8,
          "end": 58,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.4/p@203319/line-3",
          "start": 59,
          "end": 88,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6305274,
        "end": 6305397,
        "line": 235279,
        "column": 1,
        "path": "chap35/p@203319",
        "anchor": "sceneV_35.4"
      },
      "speakerLabel": "HECTOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.4/p@203446",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THERSITES.\nNo, no I am a rascal; a scurvy railing knave; a very filthy rogue.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.4/p@203446/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.4/p@203446/line-2",
          "start": 11,
          "end": 77,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
