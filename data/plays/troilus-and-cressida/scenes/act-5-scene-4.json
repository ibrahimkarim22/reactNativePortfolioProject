      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THERSITES.\nHold thy whore, Grecian; now for thy whore,\nTrojan! now the sleeve, now the sleeve!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.4/p@202975/line-1",
