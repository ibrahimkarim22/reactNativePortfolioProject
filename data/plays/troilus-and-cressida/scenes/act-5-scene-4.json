        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.4/p@202801",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIOMEDES.\nThou dost miscall retire.\nI do not fly; but advantageous care\nWithdrew me from the odds of multitude.\nHave at thee!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
