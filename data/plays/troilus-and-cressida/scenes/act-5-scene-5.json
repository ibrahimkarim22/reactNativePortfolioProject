    {
      "id": "troilus-and-cressida/sceneV_35.5/p@204207",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIOMEDES.\nGo, go, my servant, take thou Troilus’ horse;\nPresent the fair steed to my lady Cressid.\nFellow, commend my service to her beauty;\nTell her I have chastis’d the amorous Trojan,\nAnd am her knight by proof.",
