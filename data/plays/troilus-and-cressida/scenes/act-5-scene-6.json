    {
      "id": "troilus-and-cressida/sceneV_35.6/p@209518",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "TROILUS.\nAjax hath ta’en Aeneas. Shall it be?\nNo, by the flame of yonder glorious heaven,\nHe shall not carry him; I’ll be ta’en too,\nOr bring him off. Fate, hear me what I say:\nI reck not though thou end my life today.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
