    {
      "id": "troilus-and-cressida/sceneV_35.6/p@209886",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HECTOR.\nStand, stand, thou Greek; thou art a goodly mark.\nNo? wilt thou not? I like thy armour well;\nI’ll frush it and unlock the rivets all\nBut I’ll be master of it. Wilt thou not, beast, abide?\nWhy then, fly on; I’ll hunt thee for thy hide.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
