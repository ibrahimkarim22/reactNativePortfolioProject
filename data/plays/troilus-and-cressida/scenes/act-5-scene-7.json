  "content": [
    {
      "id": "troilus-and-cressida-5-7-stage-001",
      "type": "stage",
      "text": "Enter Achilles with Myrmidons."
    },
    {
      "id": "troilus-and-cressida-5-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "achilles",
        "name": "ACHILLES",
        "displayName": "Achilles"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Come here about me, you my Myrmidons;",
          "plainText": "Come here about me you my Myrmidons",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-7-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Mark what I say. Attend me where I wheel;",
          "plainText": "Mark what I say Attend me where I wheel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-7-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Strike not a stroke, but keep yourselves in breath;",
          "plainText": "Strike not a stroke but keep yourselves in breath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-7-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And when I have the bloody Hector found,",
          "plainText": "And when I have the bloody Hector found",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-7-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Empale him with your weapons round about;",
          "plainText": "Empale him with your weapons round about",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-7-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "In fellest manner execute your arms.",
          "plainText": "In fellest manner execute your arms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-7-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Follow me, sirs, and my proceedings eye.",
          "plainText": "Follow me sirs and my proceedings eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-7-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "It is decreed Hector the great must die.",
          "plainText": "It is decreed Hector the great must die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-7-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    },
    {
      "id": "troilus-and-cressida-5-7-stage-003",
      "type": "stage",
      "text": "Enter Menelaus and Paris, fighting; then Thersites."
    },
    {
      "id": "troilus-and-cressida-5-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "thersites",
        "name": "THERSITES",
        "displayName": "Thersites"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-7-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "The cuckold and the cuckold-maker are at it. Now, bull! Now, dog! 'Loo, Paris, 'loo! now my double-hen'd Spartan! 'loo, Paris, 'loo! The bull has the game. 'Ware horns, ho!",
          "plainText": "The cuckold and the cuckoldmaker are at it Now bull Now dog 'Loo Paris 'loo now my doublehen'd Spartan 'loo Paris 'loo The bull has the game 'Ware horns ho",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-7-stage-004",
      "type": "stage",
      "text": "[Exeunt Paris and Menelaus.]"
    },
    {
      "id": "troilus-and-cressida-5-7-stage-005",
      "type": "stage",
      "text": "Enter Margarelon."
    },
    {
      "id": "troilus-and-cressida-5-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "margarelon",
        "name": "MARGARELON",
        "displayName": "Margarelon"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-7-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Turn, slave, and fight.",
          "plainText": "Turn slave and fight",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-7-speech-004",
      "type": "speech",
      "speaker": {
        "id": "thersites",
        "name": "THERSITES",
        "displayName": "Thersites"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-7-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "What art thou?",
          "plainText": "What art thou",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-7-speech-005",
      "type": "speech",
      "speaker": {
        "id": "margarelon",
        "name": "MARGARELON",
        "displayName": "Margarelon"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-7-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "A bastard son of Priam's.",
          "plainText": "A bastard son of Priam's",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-7-speech-006",
      "type": "speech",
      "speaker": {
        "id": "thersites",
        "name": "THERSITES",
        "displayName": "Thersites"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-7-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "I am a bastard too; I love bastards. I am a bastard begot, bastard instructed, bastard in mind, bastard in valour, in everything illegitimate. One bear will not bite another, and wherefore should one bastard? Take heed, the quarrel's most ominous to us: if the son of a whore fight for a whore, he tempts judgement. Farewell, bastard.",
          "plainText": "I am a bastard too I love bastards I am a bastard begot bastard instructed bastard in mind bastard in valour in everything illegitimate One bear will not bite another and wherefore should one bastard Take heed the quarrel's most ominous to us if the son of a whore fight for a whore he tempts judgement Farewell bastard",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-7-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "troilus-and-cressida-5-7-speech-007",
      "type": "speech",
      "speaker": {
        "id": "margarelon",
        "name": "MARGARELON",
        "displayName": "Margarelon"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-7-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "The devil take thee, coward!",
          "plainText": "The devil take thee coward",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-7-stage-007",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}