    {
      "id": "troilus-and-cressida/sceneV_35.7/p@210402",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ACHILLES.\nCome here about me, you my Myrmidons;\nMark what I say. Attend me where I wheel;\nStrike not a stroke, but keep yourselves in breath;\nAnd when I have the bloody Hector found,\nEmpale him with your weapons round about;\nIn fellest manner execute your arms.\nFollow me, sirs, and my proceedings eye.\nIt is decreed Hector the great must die.",
      "separatorAfter": "\n\n",
      "spans": [],
