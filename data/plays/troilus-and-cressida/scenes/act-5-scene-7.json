    {
      "id": "troilus-and-cressida/sceneV_35.7/p@211033",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "THERSITES.\nThe cuckold and the cuckold-maker are at it. Now, bull! Now, dog! ’Loo, Paris, ’loo! now my double-hen’d Spartan! ’loo, Paris, ’loo! The bull has the game. ’Ware horns, ho!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
