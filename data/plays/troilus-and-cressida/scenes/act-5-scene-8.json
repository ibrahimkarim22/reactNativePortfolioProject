      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Disarms.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 8
        }
      ],
      "lines": [
        {
