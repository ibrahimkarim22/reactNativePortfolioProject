        "status": "source-unlabelled"
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.8/p@213494",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Hark! a retire upon our Grecian part.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213494/line-1",
          "start": 0,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6315449,
        "end": 6315511,
        "line": 235724,
        "column": 1,
        "path": "chap35/p@213494",
        "anchor": "sceneV_35.8"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.8/p@213560",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MYRMIDON.\nThe Trojan trumpets sound the like, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213560/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213560/line-2",
          "start": 10,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6315515,
        "end": 6315599,
        "line": 235728,
        "column": 1,
        "path": "chap35/p@213560",
        "anchor": "sceneV_35.8"
      },
      "speakerLabel": "MYRMIDON.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.8/p@213648",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ACHILLES.\nThe dragon wing of night o’erspreads the earth\nAnd, stickler-like, the armies separates.\nMy half-supp’d sword, that frankly would have fed,\nPleas’d with this dainty bait, thus goes to bed.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213648/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213648/line-2",
          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213648/line-3",
          "start": 57,
          "end": 98,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213648/line-4",
          "start": 99,
          "end": 149,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213648/line-5",
          "start": 150,
          "end": 198,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6315603,
        "end": 6315846,
        "line": 235733,
        "column": 1,
        "path": "chap35/p@213648",
        "anchor": "sceneV_35.8"
      },
      "speakerLabel": "ACHILLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.8/p@213895",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Sheathes his sword.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 19
        }
      ],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213895/line-1",
          "start": 0,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6315850,
        "end": 6315903,
        "line": 235741,
        "column": 1,
        "path": "chap35/p@213895",
        "anchor": "sceneV_35.8"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.8/p@213952",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "Come, tie his body to my horse’s tail;\nAlong the field I will the Trojan trail.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213952/line-1",
          "start": 0,
          "end": 38,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213952/line-2",
          "start": 39,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
