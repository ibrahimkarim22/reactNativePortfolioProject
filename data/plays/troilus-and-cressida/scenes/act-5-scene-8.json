  },
  "content": [
    {
      "id": "troilus-and-cressida-5-8-stage-001",
      "type": "stage",
      "text": "Enter Hector."
    },
    {
      "id": "troilus-and-cressida-5-8-speech-001",
      "type": "speech",
      "speaker": {
        "id": "hector",
        "name": "HECTOR",
        "displayName": "Hector"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-8-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Most putrified core so fair without,",
          "plainText": "Most putrified core so fair without",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-8-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Thy goodly armour thus hath cost thy life.",
          "plainText": "Thy goodly armour thus hath cost thy life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-8-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Now is my day's work done; I'll take my breath:",
          "plainText": "Now is my day's work done I'll take my breath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-8-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Rest, sword; thou hast thy fill of blood and death!",
          "plainText": "Rest sword thou hast thy fill of blood and death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-8-stage-002",
      "type": "stage",
      "text": "[Disarms.]"
    },
    {
      "id": "troilus-and-cressida-5-8-stage-003",
      "type": "stage",
      "text": "Enter Achilles and Myrmidons."
    },
    {
      "id": "troilus-and-cressida-5-8-speech-002",
      "type": "speech",
      "speaker": {
        "id": "achilles",
        "name": "ACHILLES",
        "displayName": "Achilles"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-8-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Look, Hector, how the sun begins to set,",
          "plainText": "Look Hector how the sun begins to set",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-8-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "How ugly night comes breathing at his heels;",
          "plainText": "How ugly night comes breathing at his heels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-8-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "Even with the vail and dark'ning of the sun,",
          "plainText": "Even with the vail and dark'ning of the sun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-8-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "To close the day up, Hector's life is done.",
          "plainText": "To close the day up Hector's life is done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-8-speech-003",
      "type": "speech",
      "speaker": {
        "id": "hector",
        "name": "HECTOR",
        "displayName": "Hector"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-8-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "I am unarm'd; forego this vantage, Greek.",
          "plainText": "I am unarm'd forego this vantage Greek",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-8-speech-004",
      "type": "speech",
      "speaker": {
        "id": "achilles",
        "name": "ACHILLES",
        "displayName": "Achilles"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-8-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Strike, fellows, strike; this is the man I seek.",
          "plainText": "Strike fellows strike this is the man I seek",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-8-stage-004",
      "type": "stage",
      "text": "[Hector falls.]"
    },
    {
      "id": "troilus-and-cressida-5-8-stage-005",
      "type": "stage",
      "text": "[A retreat sounded.]"
    },
    {
      "id": "troilus-and-cressida-5-8-speech-005",
      "type": "speech",
      "speaker": {
        "id": "myrmidon",
        "name": "MYRMIDON",
        "displayName": "Myrmidon"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-8-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "The Trojan trumpets sound the like, my lord.",
          "plainText": "The Trojan trumpets sound the like my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-8-speech-006",
      "type": "speech",
      "speaker": {
        "id": "achilles",
        "name": "ACHILLES",
        "displayName": "Achilles"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-8-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "The dragon wing of night o'erspreads the earth",
          "plainText": "The dragon wing of night o'erspreads the earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-8-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "And, stickler-like, the armies separates.",
          "plainText": "And sticklerlike the armies separates",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-8-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "My half-supp'd sword, that frankly would have fed,",
          "plainText": "My halfsupp'd sword that frankly would have fed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-8-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "Pleas'd with this dainty bait, thus goes to bed.",
          "plainText": "Pleas'd with this dainty bait thus goes to bed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-8-stage-006",
      "type": "stage",
      "text": "[Sheathes his sword.]"
    },
    {
      "id": "troilus-and-cressida-5-8-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}