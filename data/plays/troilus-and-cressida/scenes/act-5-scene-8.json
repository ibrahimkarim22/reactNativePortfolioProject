    {
      "id": "troilus-and-cressida/sceneV_35.8/p@212640",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Achilles and Myrmidons.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 14,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212640/line-1",
          "start": 0,
          "end": 29,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6314595,
        "end": 6314683,
        "line": 235687,
        "column": 1,
        "path": "chap35/p@212640",
        "anchor": "sceneV_35.8"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.8/p@212732",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ACHILLES.\nLook, Hector, how the sun begins to set,\nHow ugly night comes breathing at his heels;\nEven with the vail and dark’ning of the sun,\nTo close the day up, Hector’s life is done.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212732/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212732/line-2",
          "start": 10,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212732/line-3",
          "start": 51,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212732/line-4",
          "start": 96,
          "end": 140,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212732/line-5",
          "start": 141,
          "end": 184,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6314687,
        "end": 6314916,
        "line": 235691,
        "column": 1,
        "path": "chap35/p@212732",
        "anchor": "sceneV_35.8"
      },
      "speakerLabel": "ACHILLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.8/p@212965",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HECTOR.\nI am unarm’d; forego this vantage, Greek.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212965/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212965/line-2",
          "start": 8,
          "end": 49,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6314920,
        "end": 6314999,
        "line": 235699,
        "column": 1,
        "path": "chap35/p@212965",
        "anchor": "sceneV_35.8"
      },
      "speakerLabel": "HECTOR.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.8/p@213048",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ACHILLES.\nStrike, fellows, strike; this is the man I seek.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213048/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213048/line-2",
          "start": 10,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6315003,
        "end": 6315091,
        "line": 235704,
        "column": 1,
        "path": "chap35/p@213048",
        "anchor": "sceneV_35.8"
      },
      "speakerLabel": "ACHILLES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.8/p@213140",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Hector falls.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 1,
          "end": 7,
          "className": "charname"
        },
        {
          "tag": "i",
          "start": 1,
          "end": 13
        }
      ],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213140/line-1",
          "start": 0,
          "end": 15,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6315095,
        "end": 6315172,
        "line": 235709,
        "column": 1,
        "path": "chap35/p@213140",
        "anchor": "sceneV_35.8"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.8/p@213221",
      "type": "passage",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "So, Ilion, fall thou next! Now, Troy, sink down;\nHere lies thy heart, thy sinews, and thy bone.\nOn, Myrmidons, and cry you all amain\n‘Achilles hath the mighty Hector slain.’",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213221/line-1",
          "start": 0,
          "end": 48,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213221/line-2",
          "start": 49,
          "end": 95,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213221/line-3",
          "start": 96,
          "end": 132,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213221/line-4",
          "start": 133,
          "end": 173,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6315176,
        "end": 6315389,
        "line": 235713,
        "column": 1,
        "path": "chap35/p@213221",
