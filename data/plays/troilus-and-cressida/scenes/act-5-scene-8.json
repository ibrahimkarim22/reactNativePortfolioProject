      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[A retreat sounded.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 18
        }
      ],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@213438/line-1",
