    {
      "id": "troilus-and-cressida/sceneV_35.8/p@212358",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "HECTOR.\nMost putrified core so fair without,\nThy goodly armour thus hath cost thy life.\nNow is my day’s work done; I’ll take my breath:\nRest, sword; thou hast thy fill of blood and death!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212358/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212358/line-2",
          "start": 8,
          "end": 44,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212358/line-3",
          "start": 45,
          "end": 87,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212358/line-4",
          "start": 88,
          "end": 135,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.8/p@212358/line-5",
          "start": 136,
          "end": 187,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6314313,
        "end": 6314545,
        "line": 235675,
