        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.9/p@214587",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DIOMEDES.\nThe bruit is, Hector’s slain, and by Achilles.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.9/p@214587/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
