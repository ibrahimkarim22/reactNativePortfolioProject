          "start": 10,
          "end": 56,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6316542,
        "end": 6316628,
        "line": 235776,
        "column": 1,
        "path": "chap35/p@214587",
        "anchor": "sceneV_35.9"
      },
      "speakerLabel": "DIOMEDES.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.9/p@214677",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AJAX.\nIf it be so, yet bragless let it be;\nGreat Hector was as good a man as he.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "troilus-and-cressida/sceneV_35.9/p@214677/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.9/p@214677/line-2",
          "start": 6,
          "end": 42,
          "sourceLineNumber": null
        },
        {
          "id": "troilus-and-cressida/sceneV_35.9/p@214677/line-3",
          "start": 43,
          "end": 80,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6316632,
        "end": 6316747,
        "line": 235781,
        "column": 1,
        "path": "chap35/p@214677",
        "anchor": "sceneV_35.9"
      },
      "speakerLabel": "AJAX.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "troilus-and-cressida/sceneV_35.9/p@214796",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "AGAMEMNON.\nMarch patiently along. Let one be sent\nTo pray Achilles see us at our tent.\nIf in his death the gods have us befriended;\nGreat Troy is ours, and our sharp wars are ended.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
