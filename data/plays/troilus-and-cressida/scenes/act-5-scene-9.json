      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SOLDIERS.\n[Within.] Achilles! Achilles! Hector’s slain. Achilles!",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 11,
          "end": 17
        }
      ],
      "lines": [
        {
