  "scene": {
    "id": "twelfth-night-or-what-you-will-1-1",
    "act": 1,
    "scene": 1,
    "label": "Act 1, Scene 1",
    "title": "SCENE I. An Apartment in the Duke's Palace.",
    "location": "An Apartment in the Duke's Palace.",
    "orderInPlay": 1
  },
  "content": [
    {
      "id": "twelfth-night-or-what-you-will-1-1-stage-001",
      "type": "stage",
      "text": "Enter Orsino, Duke of Illyria, Curio, and other Lords; Musicians attending."
    },
    {
      "id": "twelfth-night-or-what-you-will-1-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "If music be the food of love, play on,",
          "plainText": "If music be the food of love play on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Give me excess of it; that, surfeiting,",
          "plainText": "Give me excess of it that surfeiting",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "The appetite may sicken and so die.",
          "plainText": "The appetite may sicken and so die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "That strain again, it had a dying fall;",
          "plainText": "That strain again it had a dying fall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "O, it came o'er my ear like the sweet sound",
          "plainText": "O it came o'er my ear like the sweet sound",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "That breathes upon a bank of violets,",
          "plainText": "That breathes upon a bank of violets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Stealing and giving odour. Enough; no more;",
          "plainText": "Stealing and giving odour Enough no more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "'Tis not so sweet now as it was before.",
          "plainText": "'Tis not so sweet now as it was before",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "O spirit of love, how quick and fresh art thou,",
          "plainText": "O spirit of love how quick and fresh art thou",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "That notwithstanding thy capacity",
          "plainText": "That notwithstanding thy capacity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Receiveth as the sea, nought enters there,",
          "plainText": "Receiveth as the sea nought enters there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "Of what validity and pitch soever,",
          "plainText": "Of what validity and pitch soever",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "But falls into abatement and low price",
          "plainText": "But falls into abatement and low price",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Even in a minute! So full of shapes is fancy,",
          "plainText": "Even in a minute So full of shapes is fancy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "That it alone is high fantastical.",
          "plainText": "That it alone is high fantastical",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "curio",
        "name": "CURIO",
        "displayName": "Curio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Will you go hunt, my lord?",
          "plainText": "Will you go hunt my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "What, Curio?",
          "plainText": "What Curio",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "curio",
        "name": "CURIO",
        "displayName": "Curio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "The hart.",
          "plainText": "The hart",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Why so I do, the noblest that I have.",
          "plainText": "Why so I do the noblest that I have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "O, when mine eyes did see Olivia first,",
          "plainText": "O when mine eyes did see Olivia first",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Methought she purg'd the air of pestilence;",
          "plainText": "Methought she purg'd the air of pestilence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "That instant was I turn'd into a hart,",
          "plainText": "That instant was I turn'd into a hart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "And my desires, like fell and cruel hounds,",
          "plainText": "And my desires like fell and cruel hounds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "E'er since pursue me. How now? what news from her?",
          "plainText": "E'er since pursue me How now what news from her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-1-stage-002",
      "type": "stage",
      "text": "Enter Valentine."
    },
    {
      "id": "twelfth-night-or-what-you-will-1-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "So please my lord, I might not be admitted,",
          "plainText": "So please my lord I might not be admitted",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "But from her handmaid do return this answer:",
          "plainText": "But from her handmaid do return this answer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "The element itself, till seven years' heat,",
          "plainText": "The element itself till seven years' heat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "Shall not behold her face at ample view;",
          "plainText": "Shall not behold her face at ample view",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "But like a cloistress she will veiled walk,",
          "plainText": "But like a cloistress she will veiled walk",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "And water once a day her chamber round",
          "plainText": "And water once a day her chamber round",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0031",
          "number": 31,
          "speechLineNumber": 7,
          "text": "With eye-offending brine: all this to season",
          "plainText": "With eyeoffending brine all this to season",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0032",
          "number": 32,
          "speechLineNumber": 8,
          "text": "A brother's dead love, which she would keep fresh",
          "plainText": "A brother's dead love which she would keep fresh",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0033",
          "number": 33,
          "speechLineNumber": 9,
          "text": "And lasting in her sad remembrance.",
          "plainText": "And lasting in her sad remembrance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "O, she that hath a heart of that fine frame",
          "plainText": "O she that hath a heart of that fine frame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "To pay this debt of love but to a brother,",
          "plainText": "To pay this debt of love but to a brother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "How will she love, when the rich golden shaft",
          "plainText": "How will she love when the rich golden shaft",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "Hath kill'd the flock of all affections else",
          "plainText": "Hath kill'd the flock of all affections else",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "That live in her; when liver, brain, and heart,",
          "plainText": "That live in her when liver brain and heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0039",
          "number": 39,
          "speechLineNumber": 6,
          "text": "These sovereign thrones, are all supplied and fill'd",
          "plainText": "These sovereign thrones are all supplied and fill'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0040",
          "number": 40,
          "speechLineNumber": 7,
          "text": "Her sweet perfections with one self king!",
          "plainText": "Her sweet perfections with one self king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0041",
          "number": 41,
          "speechLineNumber": 8,
          "text": "Away before me to sweet beds of flowers,",
          "plainText": "Away before me to sweet beds of flowers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-1-line-0042",
          "number": 42,
          "speechLineNumber": 9,
          "text": "Love-thoughts lie rich when canopied with bowers.",
          "plainText": "Lovethoughts lie rich when canopied with bowers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-1-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}