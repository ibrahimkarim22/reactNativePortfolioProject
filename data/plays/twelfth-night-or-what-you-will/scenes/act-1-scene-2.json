      },
      "speakerLabel": "VIOLA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.2/p@7792",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPTAIN.\nA virtuous maid, the daughter of a count\nThat died some twelvemonth since; then leaving her\nIn the protection of his son, her brother,\nWho shortly also died; for whose dear love\nThey say, she hath abjur’d the company\nAnd sight of men.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.2/p@7792/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.2/p@7792/line-2",
          "start": 9,
          "end": 49,
          "sourceLineNumber": null
