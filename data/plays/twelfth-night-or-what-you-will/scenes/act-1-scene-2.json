      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPTAIN.\nBe you his eunuch and your mute I’ll be;\nWhen my tongue blabs, then let mine eyes not see.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
