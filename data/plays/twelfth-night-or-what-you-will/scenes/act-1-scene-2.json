      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIOLA.\nWhat’s she?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.2/p@7740/line-1",
