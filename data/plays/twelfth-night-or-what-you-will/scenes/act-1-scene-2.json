      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CAPTAIN.\nThat were hard to compass,\nBecause she will admit no kind of suit,\nNo, not the Duke’s.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.2/p@8278/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
