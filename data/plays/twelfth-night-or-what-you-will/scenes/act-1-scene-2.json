  },
  "content": [
    {
      "id": "twelfth-night-or-what-you-will-1-2-stage-001",
      "type": "stage",
      "text": "Enter Viola, a Captain and Sailors."
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "What country, friends, is this?",
          "plainText": "What country friends is this",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "This is Illyria, lady.",
          "plainText": "This is Illyria lady",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "And what should I do in Illyria?",
          "plainText": "And what should I do in Illyria",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "My brother he is in Elysium.",
          "plainText": "My brother he is in Elysium",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Perchance he is not drown'd. What think you, sailors?",
          "plainText": "Perchance he is not drown'd What think you sailors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "It is perchance that you yourself were sav'd.",
          "plainText": "It is perchance that you yourself were sav'd",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "O my poor brother! and so perchance may he be.",
          "plainText": "O my poor brother and so perchance may he be",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "True, madam; and to comfort you with chance,",
          "plainText": "True madam and to comfort you with chance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Assure yourself, after our ship did split,",
          "plainText": "Assure yourself after our ship did split",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "When you, and those poor number sav'd with you,",
          "plainText": "When you and those poor number sav'd with you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Hung on our driving boat, I saw your brother,",
          "plainText": "Hung on our driving boat I saw your brother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "Most provident in peril, bind himself,",
          "plainText": "Most provident in peril bind himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "(Courage and hope both teaching him the practice)",
          "plainText": "Courage and hope both teaching him the practice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0014",
          "number": 14,
          "speechLineNumber": 7,
          "text": "To a strong mast that liv'd upon the sea;",
          "plainText": "To a strong mast that liv'd upon the sea",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0015",
          "number": 15,
          "speechLineNumber": 8,
          "text": "Where, like Arion on the dolphin's back,",
          "plainText": "Where like Arion on the dolphin's back",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0016",
          "number": 16,
          "speechLineNumber": 9,
          "text": "I saw him hold acquaintance with the waves",
          "plainText": "I saw him hold acquaintance with the waves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0017",
          "number": 17,
          "speechLineNumber": 10,
          "text": "So long as I could see.",
          "plainText": "So long as I could see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "For saying so, there's gold!",
          "plainText": "For saying so there's gold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Mine own escape unfoldeth to my hope,",
          "plainText": "Mine own escape unfoldeth to my hope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "Whereto thy speech serves for authority,",
          "plainText": "Whereto thy speech serves for authority",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "The like of him. Know'st thou this country?",
          "plainText": "The like of him Know'st thou this country",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Ay, madam, well, for I was bred and born",
          "plainText": "Ay madam well for I was bred and born",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Not three hours' travel from this very place.",
          "plainText": "Not three hours' travel from this very place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Who governs here?",
          "plainText": "Who governs here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "A noble duke, in nature as in name.",
          "plainText": "A noble duke in nature as in name",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "What is his name?",
          "plainText": "What is his name",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Orsino.",
          "plainText": "Orsino",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Orsino! I have heard my father name him.",
          "plainText": "Orsino I have heard my father name him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "He was a bachelor then.",
          "plainText": "He was a bachelor then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "And so is now, or was so very late;",
          "plainText": "And so is now or was so very late",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "For but a month ago I went from hence,",
          "plainText": "For but a month ago I went from hence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "And then 'twas fresh in murmur, (as, you know,",
          "plainText": "And then 'twas fresh in murmur as you know",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0033",
          "number": 33,
          "speechLineNumber": 4,
          "text": "What great ones do, the less will prattle of)",
          "plainText": "What great ones do the less will prattle of",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0034",
          "number": 34,
          "speechLineNumber": 5,
          "text": "That he did seek the love of fair Olivia.",
          "plainText": "That he did seek the love of fair Olivia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "What's she?",
          "plainText": "What's she",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "A virtuous maid, the daughter of a count",
          "plainText": "A virtuous maid the daughter of a count",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "That died some twelvemonth since; then leaving her",
          "plainText": "That died some twelvemonth since then leaving her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0038",
          "number": 38,
          "speechLineNumber": 3,
          "text": "In the protection of his son, her brother,",
          "plainText": "In the protection of his son her brother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0039",
          "number": 39,
          "speechLineNumber": 4,
          "text": "Who shortly also died; for whose dear love",
          "plainText": "Who shortly also died for whose dear love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0040",
          "number": 40,
          "speechLineNumber": 5,
          "text": "They say, she hath abjur'd the company",
          "plainText": "They say she hath abjur'd the company",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0041",
          "number": 41,
          "speechLineNumber": 6,
          "text": "And sight of men.",
          "plainText": "And sight of men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "O that I served that lady,",
          "plainText": "O that I served that lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "And might not be delivered to the world,",
          "plainText": "And might not be delivered to the world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "Till I had made mine own occasion mellow,",
          "plainText": "Till I had made mine own occasion mellow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0045",
          "number": 45,
          "speechLineNumber": 4,
          "text": "What my estate is.",
          "plainText": "What my estate is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "That were hard to compass,",
          "plainText": "That were hard to compass",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Because she will admit no kind of suit,",
          "plainText": "Because she will admit no kind of suit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "No, not the Duke's.",
          "plainText": "No not the Duke's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "There is a fair behaviour in thee, Captain;",
          "plainText": "There is a fair behaviour in thee Captain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "And though that nature with a beauteous wall",
          "plainText": "And though that nature with a beauteous wall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "Doth oft close in pollution, yet of thee",
          "plainText": "Doth oft close in pollution yet of thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "I will believe thou hast a mind that suits",
          "plainText": "I will believe thou hast a mind that suits",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0053",
          "number": 53,
          "speechLineNumber": 5,
          "text": "With this thy fair and outward character.",
          "plainText": "With this thy fair and outward character",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0054",
          "number": 54,
          "speechLineNumber": 6,
          "text": "I pray thee, and I'll pay thee bounteously,",
          "plainText": "I pray thee and I'll pay thee bounteously",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0055",
          "number": 55,
          "speechLineNumber": 7,
          "text": "Conceal me what I am, and be my aid",
          "plainText": "Conceal me what I am and be my aid",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0056",
          "number": 56,
          "speechLineNumber": 8,
          "text": "For such disguise as haply shall become",
          "plainText": "For such disguise as haply shall become",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0057",
          "number": 57,
          "speechLineNumber": 9,
          "text": "The form of my intent. I'll serve this duke;",
          "plainText": "The form of my intent I'll serve this duke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0058",
          "number": 58,
          "speechLineNumber": 10,
          "text": "Thou shalt present me as an eunuch to him.",
          "plainText": "Thou shalt present me as an eunuch to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0059",
          "number": 59,
          "speechLineNumber": 11,
          "text": "It may be worth thy pains; for I can sing,",
          "plainText": "It may be worth thy pains for I can sing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0060",
          "number": 60,
          "speechLineNumber": 12,
          "text": "And speak to him in many sorts of music,",
          "plainText": "And speak to him in many sorts of music",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0061",
          "number": 61,
          "speechLineNumber": 13,
          "text": "That will allow me very worth his service.",
          "plainText": "That will allow me very worth his service",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0062",
          "number": 62,
          "speechLineNumber": 14,
          "text": "What else may hap, to time I will commit;",
          "plainText": "What else may hap to time I will commit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0063",
          "number": 63,
          "speechLineNumber": 15,
          "text": "Only shape thou thy silence to my wit.",
          "plainText": "Only shape thou thy silence to my wit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Be you his eunuch and your mute I'll be;",
          "plainText": "Be you his eunuch and your mute I'll be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "When my tongue blabs, then let mine eyes not see.",
          "plainText": "When my tongue blabs then let mine eyes not see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-2-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "I thank thee. Lead me on.",
          "plainText": "I thank thee Lead me on",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-2-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
