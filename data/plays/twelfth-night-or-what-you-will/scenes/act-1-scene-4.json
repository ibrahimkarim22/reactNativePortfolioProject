      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18660",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIOLA.\nI thank you. Here comes the Count.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18660/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18660/line-2",
          "start": 7,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6339340,
        "end": 6339411,
        "line": 236712,
        "column": 1,
        "path": "chap36/p@18660",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "VIOLA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18735",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nWho saw Cesario, ho?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18735/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18735/line-2",
          "start": 6,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6339415,
        "end": 6339471,
        "line": 236717,
        "column": 1,
        "path": "chap36/p@18735",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18795",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIOLA.\nOn your attendance, my lord, here.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18795/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18795/line-2",
          "start": 7,
          "end": 41,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6339475,
        "end": 6339546,
        "line": 236722,
        "column": 1,
        "path": "chap36/p@18795",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "VIOLA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18870",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nStand you awhile aloof.—Cesario,\nThou know’st no less but all; I have unclasp’d\nTo thee the book even of my secret soul.\nTherefore, good youth, address thy gait unto her,\nBe not denied access, stand at her doors,\nAnd tell them, there thy fixed foot shall grow\nTill thou have audience.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18870/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18870/line-2",
          "start": 6,
          "end": 38,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18870/line-3",
          "start": 39,
          "end": 85,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18870/line-4",
          "start": 86,
          "end": 126,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18870/line-5",
          "start": 127,
          "end": 176,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18870/line-6",
          "start": 177,
          "end": 218,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18870/line-7",
          "start": 219,
          "end": 265,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18870/line-8",
          "start": 266,
          "end": 290,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6339550,
        "end": 6339900,
        "line": 236727,
        "column": 1,
        "path": "chap36/p@18870",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19224",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIOLA.\nSure, my noble lord,\nIf she be so abandon’d to her sorrow\nAs it is spoke, she never will admit me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19224/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19224/line-2",
          "start": 7,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19224/line-3",
          "start": 28,
          "end": 64,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19224/line-4",
          "start": 65,
          "end": 105,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6339904,
        "end": 6340049,
        "line": 236738,
        "column": 1,
        "path": "chap36/p@19224",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "VIOLA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19373",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nBe clamorous and leap all civil bounds,\nRather than make unprofited return.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19373/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19373/line-2",
          "start": 6,
          "end": 45,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19373/line-3",
          "start": 46,
          "end": 81,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6340053,
        "end": 6340169,
        "line": 236745,
        "column": 1,
        "path": "chap36/p@19373",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19493",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIOLA.\nSay I do speak with her, my lord, what then?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19493/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19493/line-2",
          "start": 7,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6340173,
        "end": 6340254,
        "line": 236751,
        "column": 1,
        "path": "chap36/p@19493",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "VIOLA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19578",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nO then unfold the passion of my love,\nSurprise her with discourse of my dear faith;\nIt shall become thee well to act my woes;\nShe will attend it better in thy youth,\nThan in a nuncio’s of more grave aspect.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19578/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19578/line-2",
          "start": 6,
          "end": 43,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19578/line-3",
          "start": 44,
          "end": 89,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19578/line-4",
          "start": 90,
          "end": 131,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19578/line-5",
          "start": 132,
          "end": 171,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19578/line-6",
          "start": 172,
          "end": 212,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6340258,
        "end": 6340520,
        "line": 236756,
        "column": 1,
        "path": "chap36/p@19578",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "DUKE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 5
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19844",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIOLA.\nI think not so, my lord.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19844/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19844/line-2",
          "start": 7,
          "end": 31,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6340524,
        "end": 6340585,
        "line": 236765,
        "column": 1,
        "path": "chap36/p@19844",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "VIOLA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19909",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "DUKE.\nDear lad, believe it;\nFor they shall yet belie thy happy years,\nThat say thou art a man: Diana’s lip\nIs not more smooth and rubious; thy small pipe\nIs as the maiden’s organ, shrill and sound,\nAnd all is semblative a woman’s part.\nI know thy constellation is right apt\nFor this affair. Some four or five attend him:\nAll, if you will; for I myself am best\nWhen least in company. Prosper well in this,\nAnd thou shalt live as freely as thy lord,\nTo call his fortunes thine.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19909/line-1",
          "start": 0,
          "end": 5,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19909/line-2",
          "start": 6,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19909/line-3",
          "start": 28,
          "end": 69,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19909/line-4",
          "start": 70,
          "end": 106,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19909/line-5",
          "start": 107,
          "end": 153,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19909/line-6",
          "start": 154,
          "end": 197,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@19909/line-7",
          "start": 198,
