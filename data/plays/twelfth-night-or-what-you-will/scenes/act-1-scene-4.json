        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18564",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Duke, Curio and Attendants.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 17,
          "className": "charname"
        }
      ],
      "lines": [
        {
