    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18120",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VALENTINE.\nIf the duke continue these favours towards you, Cesario, you are like to be much advanced; he hath known you but three days, and already you are no stranger.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18120/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18120/line-2",
          "start": 11,
          "end": 168,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6338800,
        "end": 6339000,
        "line": 236690,
        "column": 1,
        "path": "chap36/p@18120",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "VALENTINE.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18324",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIOLA.\nYou either fear his humour or my negligence, that you call in question the continuance of his love. Is he inconstant, sir, in his favours?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18324/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18324/line-2",
          "start": 7,
          "end": 145,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6339004,
        "end": 6339180,
        "line": 236697,
        "column": 1,
        "path": "chap36/p@18324",
        "anchor": "sceneI_36.4"
      },
      "speakerLabel": "VIOLA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18504",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VALENTINE.\nNo, believe me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18504/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneI_36.4/p@18504/line-2",
          "start": 11,
          "end": 26,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
