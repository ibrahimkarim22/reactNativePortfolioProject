    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@39885",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Antonio and Sebastian.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 13,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 18,
          "end": 27,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@39885/line-1",
          "start": 0,
          "end": 28,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6360565,
        "end": 6360682,
        "line": 237607,
        "column": 1,
        "path": "chap36/p@39885",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40006",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nWill you stay no longer? Nor will you not that I go with you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40006/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40006/line-2",
          "start": 9,
          "end": 70,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6360686,
        "end": 6360786,
        "line": 237611,
        "column": 1,
        "path": "chap36/p@40006",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40110",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nBy your patience, no; my stars shine darkly over me; the malignancy of my fate might perhaps distemper yours; therefore I shall crave of you your leave that I may bear my evils alone. It were a bad recompense for your love, to lay any of them on you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40110/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40110/line-2",
          "start": 11,
          "end": 261,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6360790,
        "end": 6361084,
        "line": 237616,
        "column": 1,
        "path": "chap36/p@40110",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40408",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nLet me know of you whither you are bound.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40408/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40408/line-2",
          "start": 9,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6361088,
        "end": 6361168,
        "line": 237624,
        "column": 1,
        "path": "chap36/p@40408",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40492",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nNo, sooth, sir; my determinate voyage is mere extravagancy. But I perceive in you so excellent a touch of modesty, that you will not extort from me what I am willing to keep in. Therefore it charges me in manners the rather to express myself. You must know of me then, Antonio, my name is Sebastian, which I called Roderigo; my father was that Sebastian of Messaline whom I know you have heard of. He left behind him myself and a sister, both born in an hour. If the heavens had been pleased, would we had so ended! But you, sir, altered that, for some hour before you took me from the breach of the sea was my sister drowned.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40492/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@40492/line-2",
          "start": 11,
          "end": 637,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6361172,
        "end": 6361847,
        "line": 237629,
        "column": 1,
        "path": "chap36/p@40492",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41171",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nAlas the day!",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41171/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41171/line-2",
          "start": 9,
          "end": 22,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6361851,
        "end": 6361903,
        "line": 237642,
        "column": 1,
        "path": "chap36/p@41171",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41227",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nA lady, sir, though it was said she much resembled me, was yet of many accounted beautiful. But though I could not with such estimable wonder overfar believe that, yet thus far I will boldly publish her, she bore a mind that envy could not but call fair. She is drowned already, sir, with salt water, though I seem to drown her remembrance again with more.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41227/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41227/line-2",
          "start": 11,
          "end": 367,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6361907,
        "end": 6362308,
        "line": 237647,
        "column": 1,
        "path": "chap36/p@41227",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41632",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nPardon me, sir, your bad entertainment.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41632/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41632/line-2",
          "start": 9,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6362312,
        "end": 6362390,
        "line": 237656,
        "column": 1,
        "path": "chap36/p@41632",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41714",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nO good Antonio, forgive me your trouble.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41714/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41714/line-2",
          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6362394,
        "end": 6362475,
        "line": 237661,
        "column": 1,
        "path": "chap36/p@41714",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41799",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nIf you will not murder me for my love, let me be your servant.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41799/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41799/line-2",
          "start": 9,
          "end": 71,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6362479,
        "end": 6362580,
        "line": 237666,
        "column": 1,
        "path": "chap36/p@41799",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41904",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nIf you will not undo what you have done, that is, kill him whom you have recovered, desire it not. Fare ye well at once; my bosom is full of kindness, and I am yet so near the manners of my mother, that upon the least occasion more, mine eyes will tell tales of me. I am bound to the Count Orsino’s court: farewell.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41904/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@41904/line-2",
          "start": 11,
          "end": 326,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6362584,
        "end": 6362944,
        "line": 237671,
        "column": 1,
        "path": "chap36/p@41904",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@42268",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 6
        }
      ],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@42268/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6362948,
        "end": 6362987,
        "line": 237680,
        "column": 1,
        "path": "chap36/p@42268",
        "anchor": "sceneII_36.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@42311",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nThe gentleness of all the gods go with thee!\nI have many enemies in Orsino’s court,\nElse would I very shortly see thee there:\nBut come what may, I do adore thee so,\nThat danger shall seem sport, and I will go.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@42311/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@42311/line-2",
          "start": 9,
          "end": 53,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@42311/line-3",
          "start": 54,
          "end": 92,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.1/p@42311/line-4",
          "start": 93,
          "end": 134,
          "sourceLineNumber": null
        },
        {
