  "scene": {
    "id": "twelfth-night-or-what-you-will-2-2",
    "act": 2,
    "scene": 2,
    "label": "Act 2, Scene 2",
    "title": "SCENE II. A street.",
    "location": "A street.",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "twelfth-night-or-what-you-will-2-2-stage-001",
      "type": "stage",
      "text": "Enter Viola; Malvolio at several doors."
    },
    {
      "id": "twelfth-night-or-what-you-will-2-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "malvolio",
        "name": "MALVOLIO",
        "displayName": "Malvolio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Were you not even now with the Countess Olivia?",
          "plainText": "Were you not even now with the Countess Olivia",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-2-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Even now, sir; on a moderate pace I have since arrived but hither.",
          "plainText": "Even now sir on a moderate pace I have since arrived but hither",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-2-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "malvolio",
        "name": "MALVOLIO",
        "displayName": "Malvolio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "She returns this ring to you, sir; you might have saved me my pains, to have taken it away yourself. She adds, moreover, that you should put your lord into a desperate assurance she will none of him. And one thing more, that you be never so hardy to come again in his affairs, unless it be to report your lord's taking of this. Receive it so.",
          "plainText": "She returns this ring to you sir you might have saved me my pains to have taken it away yourself She adds moreover that you should put your lord into a desperate assurance she will none of him And one thing more that you be never so hardy to come again in his affairs unless it be to report your lord's taking of this Receive it so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-2-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "She took the ring of me: I'll none of it.",
          "plainText": "She took the ring of me I'll none of it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-2-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "malvolio",
        "name": "MALVOLIO",
        "displayName": "Malvolio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Come sir, you peevishly threw it to her; and her will is it should be so returned. If it be worth stooping for, there it lies in your eye; if not, be it his that finds it.",
          "plainText": "Come sir you peevishly threw it to her and her will is it should be so returned If it be worth stooping for there it lies in your eye if not be it his that finds it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-2-2-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "twelfth-night-or-what-you-will-2-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "I left no ring with her; what means this lady?",
          "plainText": "I left no ring with her what means this lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Fortune forbid my outside have not charm'd her!",
          "plainText": "Fortune forbid my outside have not charm'd her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "She made good view of me, indeed, so much,",
          "plainText": "She made good view of me indeed so much",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "That methought her eyes had lost her tongue,",
          "plainText": "That methought her eyes had lost her tongue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "For she did speak in starts distractedly.",
          "plainText": "For she did speak in starts distractedly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0011",
          "number": 11,
          "speechLineNumber": 6,
          "text": "She loves me, sure, the cunning of her passion",
          "plainText": "She loves me sure the cunning of her passion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0012",
          "number": 12,
          "speechLineNumber": 7,
          "text": "Invites me in this churlish messenger.",
          "plainText": "Invites me in this churlish messenger",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0013",
          "number": 13,
          "speechLineNumber": 8,
          "text": "None of my lord's ring? Why, he sent her none.",
          "plainText": "None of my lord's ring Why he sent her none",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0014",
          "number": 14,
          "speechLineNumber": 9,
          "text": "I am the man; if it be so, as 'tis,",
          "plainText": "I am the man if it be so as 'tis",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0015",
          "number": 15,
          "speechLineNumber": 10,
          "text": "Poor lady, she were better love a dream.",
          "plainText": "Poor lady she were better love a dream",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0016",
          "number": 16,
          "speechLineNumber": 11,
          "text": "Disguise, I see thou art a wickedness",
          "plainText": "Disguise I see thou art a wickedness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0017",
          "number": 17,
          "speechLineNumber": 12,
          "text": "Wherein the pregnant enemy does much.",
          "plainText": "Wherein the pregnant enemy does much",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0018",
          "number": 18,
          "speechLineNumber": 13,
          "text": "How easy is it for the proper false",
          "plainText": "How easy is it for the proper false",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0019",
          "number": 19,
          "speechLineNumber": 14,
          "text": "In women's waxen hearts to set their forms!",
          "plainText": "In women's waxen hearts to set their forms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0020",
          "number": 20,
          "speechLineNumber": 15,
          "text": "Alas, our frailty is the cause, not we,",
          "plainText": "Alas our frailty is the cause not we",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0021",
          "number": 21,
          "speechLineNumber": 16,
          "text": "For such as we are made of, such we be.",
          "plainText": "For such as we are made of such we be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0022",
          "number": 22,
          "speechLineNumber": 17,
          "text": "How will this fadge? My master loves her dearly,",
          "plainText": "How will this fadge My master loves her dearly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0023",
          "number": 23,
          "speechLineNumber": 18,
          "text": "And I, poor monster, fond as much on him,",
          "plainText": "And I poor monster fond as much on him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0024",
          "number": 24,
          "speechLineNumber": 19,
          "text": "And she, mistaken, seems to dote on me.",
          "plainText": "And she mistaken seems to dote on me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0025",
          "number": 25,
          "speechLineNumber": 20,
          "text": "What will become of this? As I am man,",
          "plainText": "What will become of this As I am man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0026",
          "number": 26,
          "speechLineNumber": 21,
          "text": "My state is desperate for my master's love;",
          "plainText": "My state is desperate for my master's love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0027",
          "number": 27,
          "speechLineNumber": 22,
          "text": "As I am woman (now alas the day!)",
          "plainText": "As I am woman now alas the day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0028",
          "number": 28,
          "speechLineNumber": 23,
          "text": "What thriftless sighs shall poor Olivia breathe!",
          "plainText": "What thriftless sighs shall poor Olivia breathe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0029",
          "number": 29,
          "speechLineNumber": 24,
          "text": "O time, thou must untangle this, not I,",
          "plainText": "O time thou must untangle this not I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-2-2-line-0030",
          "number": 30,
          "speechLineNumber": 25,
          "text": "It is too hard a knot for me t'untie!",
          "plainText": "It is too hard a knot for me t'untie",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-2-2-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}