      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@42785",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MALVOLIO.\nWere you not even now with the Countess Olivia?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@42785/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@42785/line-2",
          "start": 10,
          "end": 57,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6363465,
        "end": 6363552,
        "line": 237703,
        "column": 1,
        "path": "chap36/p@42785",
        "anchor": "sceneII_36.2"
      },
      "speakerLabel": "MALVOLIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@42876",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIOLA.\nEven now, sir; on a moderate pace I have since arrived but hither.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@42876/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@42876/line-2",
          "start": 7,
          "end": 73,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6363556,
        "end": 6363659,
        "line": 237708,
        "column": 1,
        "path": "chap36/p@42876",
        "anchor": "sceneII_36.2"
      },
      "speakerLabel": "VIOLA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@42983",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MALVOLIO.\nShe returns this ring to you, sir; you might have saved me my pains, to have taken it away yourself. She adds, moreover, that you should put your lord into a desperate assurance she will none of him. And one thing more, that you be never so hardy to come again in his affairs, unless it be to report your lord’s taking of this. Receive it so.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@42983/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@42983/line-2",
          "start": 10,
          "end": 352,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6363663,
        "end": 6364049,
        "line": 237713,
        "column": 1,
        "path": "chap36/p@42983",
        "anchor": "sceneII_36.2"
      },
      "speakerLabel": "MALVOLIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@43373",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "VIOLA.\nShe took the ring of me: I’ll none of it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@43373/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@43373/line-2",
          "start": 7,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6364053,
        "end": 6364131,
        "line": 237722,
        "column": 1,
        "path": "chap36/p@43373",
        "anchor": "sceneII_36.2"
      },
      "speakerLabel": "VIOLA.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@43455",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "MALVOLIO.\nCome sir, you peevishly threw it to her; and her will is it should be so returned. If it be worth stooping for, there it lies in your eye; if not, be it his that finds it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@43455/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@43455/line-2",
          "start": 10,
          "end": 181,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6364135,
        "end": 6364348,
        "line": 237727,
        "column": 1,
        "path": "chap36/p@43455",
        "anchor": "sceneII_36.2"
      },
      "speakerLabel": "MALVOLIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneII_36.2/p@43672",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit.]",
      "separatorAfter": "\n\n",
      "spans": [
