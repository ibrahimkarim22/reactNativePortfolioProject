      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87616",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR ANDREW.\nNo, faith, I’ll not stay a jot longer.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87616/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87616/line-2",
          "start": 12,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6408296,
        "end": 6408376,
        "line": 239597,
        "column": 1,
        "path": "chap36/p@87616",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR ANDREW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87700",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR TOBY.\nThy reason, dear venom, give thy reason.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87700/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87700/line-2",
          "start": 10,
          "end": 50,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6408380,
        "end": 6408460,
        "line": 239602,
        "column": 1,
        "path": "chap36/p@87700",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR TOBY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87784",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FABIAN.\nYou must needs yield your reason, Sir Andrew.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87784/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87784/line-2",
          "start": 8,
          "end": 53,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6408464,
        "end": 6408547,
        "line": 239607,
        "column": 1,
        "path": "chap36/p@87784",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "FABIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87871",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR ANDREW.\nMarry, I saw your niece do more favours to the Count’s servingman than ever she bestowed upon me; I saw’t i’ th’ orchard.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87871/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@87871/line-2",
          "start": 12,
          "end": 133,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6408551,
        "end": 6408715,
        "line": 239612,
        "column": 1,
        "path": "chap36/p@87871",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR ANDREW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88039",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR TOBY.\nDid she see thee the while, old boy? Tell me that.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88039/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88039/line-2",
          "start": 10,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6408719,
        "end": 6408809,
        "line": 239618,
        "column": 1,
        "path": "chap36/p@88039",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR TOBY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88133",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR ANDREW.\nAs plain as I see you now.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88133/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88133/line-2",
          "start": 12,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6408813,
        "end": 6408881,
        "line": 239623,
        "column": 1,
        "path": "chap36/p@88133",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR ANDREW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88205",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FABIAN.\nThis was a great argument of love in her toward you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88205/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88205/line-2",
          "start": 8,
          "end": 60,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6408885,
        "end": 6408975,
        "line": 239628,
        "column": 1,
        "path": "chap36/p@88205",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "FABIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88299",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR ANDREW.\n’Slight! will you make an ass o’ me?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88299/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88299/line-2",
          "start": 12,
          "end": 48,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6408979,
        "end": 6409057,
        "line": 239633,
        "column": 1,
        "path": "chap36/p@88299",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR ANDREW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88381",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FABIAN.\nI will prove it legitimate, sir, upon the oaths of judgment and reason.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88381/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88381/line-2",
          "start": 8,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6409061,
        "end": 6409170,
        "line": 239638,
        "column": 1,
        "path": "chap36/p@88381",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "FABIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88494",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR TOBY.\nAnd they have been grand-jurymen since before Noah was a sailor.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88494/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88494/line-2",
          "start": 10,
          "end": 74,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6409174,
        "end": 6409278,
        "line": 239643,
        "column": 1,
        "path": "chap36/p@88494",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR TOBY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88602",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FABIAN.\nShe did show favour to the youth in your sight only to exasperate you, to awake your dormouse valour, to put fire in your heart and brimstone in your liver. You should then have accosted her, and with some excellent jests, fire-new from the mint, you should have banged the youth into dumbness. This was looked for at your hand, and this was balked: the double gilt of this opportunity you let time wash off, and you are now sailed into the north of my lady’s opinion; where you will hang like an icicle on Dutchman’s beard, unless you do redeem it by some laudable attempt, either of valour or policy.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88602/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@88602/line-2",
          "start": 8,
          "end": 610,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6409282,
        "end": 6409929,
        "line": 239648,
        "column": 1,
        "path": "chap36/p@88602",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "FABIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89253",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR ANDREW.\nAnd’t be any way, it must be with valour, for policy I hate; I had as lief be a Brownist as a politician.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89253/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89253/line-2",
          "start": 12,
          "end": 117,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6409933,
        "end": 6410081,
        "line": 239660,
        "column": 1,
        "path": "chap36/p@89253",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR ANDREW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89405",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR TOBY.\nWhy, then, build me thy fortunes upon the basis of valour. Challenge me the Count’s youth to fight with him. Hurt him in eleven places; my niece shall take note of it, and assure thyself there is no love-broker in the world can more prevail in man’s commendation with woman than report of valour.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89405/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89405/line-2",
          "start": 10,
          "end": 306,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6410085,
        "end": 6410424,
        "line": 239666,
        "column": 1,
        "path": "chap36/p@89405",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR TOBY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89748",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "FABIAN.\nThere is no way but this, Sir Andrew.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89748/line-1",
          "start": 0,
          "end": 7,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89748/line-2",
          "start": 8,
          "end": 45,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6410428,
        "end": 6410503,
        "line": 239674,
        "column": 1,
        "path": "chap36/p@89748",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "FABIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 7
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89827",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR ANDREW.\nWill either of you bear me a challenge to him?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89827/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89827/line-2",
          "start": 12,
          "end": 58,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6410507,
        "end": 6410595,
        "line": 239679,
        "column": 1,
        "path": "chap36/p@89827",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR ANDREW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89919",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR TOBY.\nGo, write it in a martial hand, be curst and brief; it is no matter how witty, so it be eloquent and full of invention. Taunt him with the licence of ink. If thou ‘thou’st’ him some thrice, it shall not be amiss, and as many lies as will lie in thy sheet of paper, although the sheet were big enough for the bed of Ware in England, set ’em down. Go about it. Let there be gall enough in thy ink, though thou write with a goose-pen, no matter. About it.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89919/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@89919/line-2",
          "start": 10,
          "end": 462,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6410599,
        "end": 6411096,
        "line": 239684,
        "column": 1,
        "path": "chap36/p@89919",
        "anchor": "sceneIII_36.2"
      },
      "speakerLabel": "SIR TOBY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@90420",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR ANDREW.\nWhere shall I find you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@90420/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
