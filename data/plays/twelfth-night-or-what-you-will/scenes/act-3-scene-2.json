        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@90569",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Exit Sir Andrew.]",
      "separatorAfter": "\n\n",
      "spans": [
