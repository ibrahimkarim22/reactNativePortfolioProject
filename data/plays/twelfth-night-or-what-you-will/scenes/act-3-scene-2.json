    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@90489",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR TOBY.\nWe’ll call thee at the cubiculo. Go.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.2/p@90489/line-1",
