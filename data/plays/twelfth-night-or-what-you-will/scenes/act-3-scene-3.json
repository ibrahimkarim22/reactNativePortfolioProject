    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94812",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nDo not then walk too open.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94812/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94812/line-2",
          "start": 11,
          "end": 37,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6415492,
        "end": 6415559,
        "line": 239854,
        "column": 1,
        "path": "chap36/p@94812",
        "anchor": "sceneIII_36.3"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94883",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nIt doth not fit me. Hold, sir, here’s my purse.\nIn the south suburbs, at the Elephant,\nIs best to lodge. I will bespeak our diet\nWhiles you beguile the time and feed your knowledge\nWith viewing of the town. There shall you have me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94883/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
