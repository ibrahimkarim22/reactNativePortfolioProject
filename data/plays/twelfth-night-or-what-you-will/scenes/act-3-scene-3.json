        "end": 6414994,
        "line": 239828,
        "column": 1,
        "path": "chap36/p@94043",
        "anchor": "sceneIII_36.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94318",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nBelike you slew great number of his people.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94318/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94318/line-2",
          "start": 11,
          "end": 54,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6414998,
        "end": 6415082,
        "line": 239837,
        "column": 1,
        "path": "chap36/p@94318",
        "anchor": "sceneIII_36.3"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94406",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nTh’ offence is not of such a bloody nature,\nAlbeit the quality of the time and quarrel\nMight well have given us bloody argument.\nIt might have since been answered in repaying\nWhat we took from them, which for traffic’s sake,\nMost of our city did. Only myself stood out,\nFor which, if I be lapsed in this place,\nI shall pay dear.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94406/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
