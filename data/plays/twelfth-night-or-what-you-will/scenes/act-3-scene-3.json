        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93398",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nMy kind Antonio,\nI can no other answer make but thanks,\nAnd thanks, and ever thanks; and oft good turns\nAre shuffled off with such uncurrent pay.\nBut were my worth, as is my conscience, firm,\nYou should find better dealing. What’s to do?\nShall we go see the relics of this town?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93398/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93398/line-2",
          "start": 11,
          "end": 27,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93398/line-3",
          "start": 28,
          "end": 66,
          "sourceLineNumber": null
        },
        {
