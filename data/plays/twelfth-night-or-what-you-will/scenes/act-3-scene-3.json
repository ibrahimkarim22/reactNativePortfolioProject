    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93751",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nTomorrow, sir; best first go see your lodging.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93751/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93751/line-2",
          "start": 9,
          "end": 55,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6414431,
        "end": 6414516,
        "line": 239815,
        "column": 1,
        "path": "chap36/p@93751",
        "anchor": "sceneIII_36.3"
      },
      "speakerLabel": "ANTONIO.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 8
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93840",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nI am not weary, and ’tis long to night;\nI pray you, let us satisfy our eyes\nWith the memorials and the things of fame\nThat do renown this city.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93840/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93840/line-2",
          "start": 11,
          "end": 50,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93840/line-3",
          "start": 51,
          "end": 86,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93840/line-4",
          "start": 87,
          "end": 128,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@93840/line-5",
          "start": 129,
          "end": 154,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6414520,
        "end": 6414719,
        "line": 239820,
        "column": 1,
        "path": "chap36/p@93840",
        "anchor": "sceneIII_36.3"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94043",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "ANTONIO.\nWould you’d pardon me.\nI do not without danger walk these streets.\nOnce in a sea-fight, ’gainst the Count his galleys,\nI did some service, of such note indeed,\nThat were I ta’en here, it would scarce be answer’d.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94043/line-1",
          "start": 0,
          "end": 8,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94043/line-2",
          "start": 9,
          "end": 31,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94043/line-3",
          "start": 32,
          "end": 75,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94043/line-4",
          "start": 76,
          "end": 127,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94043/line-5",
          "start": 128,
          "end": 168,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@94043/line-6",
          "start": 169,
          "end": 221,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
