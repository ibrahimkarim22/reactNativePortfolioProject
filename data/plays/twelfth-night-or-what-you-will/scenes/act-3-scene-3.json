    {
      "id": "twelfth-night-or-what-you-will/sceneIII_36.3/p@95177",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nWhy I your purse?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
