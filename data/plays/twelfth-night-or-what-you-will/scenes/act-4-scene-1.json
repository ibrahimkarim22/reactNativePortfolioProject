    "title": "SCENE I. The Street before Olivia's House.",
    "location": "The Street before Olivia's House.",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "twelfth-night-or-what-you-will-4-1-stage-001",
      "type": "stage",
      "text": "Enter Sebastian and Clown."
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Will you make me believe that I am not sent for you?",
          "plainText": "Will you make me believe that I am not sent for you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Go to, go to, thou art a foolish fellow.",
          "plainText": "Go to go to thou art a foolish fellow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Let me be clear of thee.",
          "plainText": "Let me be clear of thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Well held out, i' faith! No, I do not know you, nor I am not sent to you by my lady, to bid you come speak with her; nor your name is not Master Cesario; nor this is not my nose neither. Nothing that is so, is so.",
          "plainText": "Well held out i' faith No I do not know you nor I am not sent to you by my lady to bid you come speak with her nor your name is not Master Cesario nor this is not my nose neither Nothing that is so is so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "I prithee vent thy folly somewhere else,",
          "plainText": "I prithee vent thy folly somewhere else",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Thou know'st not me.",
          "plainText": "Thou know'st not me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Vent my folly! He has heard that word of some great man, and now applies it to a fool. Vent my folly! I am afraid this great lubber, the world, will prove a cockney. I prithee now, ungird thy strangeness, and tell me what I shall vent to my lady. Shall I vent to her that thou art coming?",
          "plainText": "Vent my folly He has heard that word of some great man and now applies it to a fool Vent my folly I am afraid this great lubber the world will prove a cockney I prithee now ungird thy strangeness and tell me what I shall vent to my lady Shall I vent to her that thou art coming",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I prithee, foolish Greek, depart from me.",
          "plainText": "I prithee foolish Greek depart from me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "There's money for thee; if you tarry longer",
          "plainText": "There's money for thee if you tarry longer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "I shall give worse payment.",
          "plainText": "I shall give worse payment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "By my troth, thou hast an open hand. These wise men that give fools money get themselves a good report—after fourteen years' purchase.",
          "plainText": "By my troth thou hast an open hand These wise men that give fools money get themselves a good reportafter fourteen years' purchase",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-stage-002",
      "type": "stage",
      "text": "Enter Sir Andrew, Sir Toby and Fabian."
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Now sir, have I met you again? There's for you.",
          "plainText": "Now sir have I met you again There's for you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-stage-003",
      "type": "stage",
      "text": "[Striking Sebastian.]"
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Why, there's for thee, and there, and there.",
          "plainText": "Why there's for thee and there and there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Are all the people mad?",
          "plainText": "Are all the people mad",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-stage-004",
      "type": "stage",
      "text": "[Beating Sir Andrew.]"
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Hold, sir, or I'll throw your dagger o'er the house.",
          "plainText": "Hold sir or I'll throw your dagger o'er the house",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "This will I tell my lady straight. I would not be in some of your coats for twopence.",
          "plainText": "This will I tell my lady straight I would not be in some of your coats for twopence",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-stage-005",
      "type": "stage",
      "text": "[Exit Clown.]"
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Come on, sir, hold!",
          "plainText": "Come on sir hold",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Nay, let him alone, I'll go another way to work with him. I'll have an action of battery against him, if there be any law in Illyria. Though I struck him first, yet it's no matter for that.",
          "plainText": "Nay let him alone I'll go another way to work with him I'll have an action of battery against him if there be any law in Illyria Though I struck him first yet it's no matter for that",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Let go thy hand!",
          "plainText": "Let go thy hand",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Come, sir, I will not let you go. Come, my young soldier, put up your iron: you are well fleshed. Come on.",
          "plainText": "Come sir I will not let you go Come my young soldier put up your iron you are well fleshed Come on",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "I will be free from thee. What wouldst thou now?",
          "plainText": "I will be free from thee What wouldst thou now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "If thou dar'st tempt me further, draw thy sword.",
          "plainText": "If thou dar'st tempt me further draw thy sword",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-stage-006",
      "type": "stage",
      "text": "[Draws.]"
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "What, what? Nay, then, I must have an ounce or two of this malapert blood from you.",
          "plainText": "What what Nay then I must have an ounce or two of this malapert blood from you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-stage-007",
      "type": "stage",
      "text": "[Draws.]"
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-stage-008",
      "type": "stage",
      "text": "Enter Olivia."
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "olivia",
        "name": "OLIVIA",
        "displayName": "Olivia"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Hold, Toby! On thy life I charge thee hold!",
          "plainText": "Hold Toby On thy life I charge thee hold",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Madam.",
          "plainText": "Madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "olivia",
        "name": "OLIVIA",
        "displayName": "Olivia"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Will it be ever thus? Ungracious wretch,",
          "plainText": "Will it be ever thus Ungracious wretch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "Fit for the mountains and the barbarous caves,",
          "plainText": "Fit for the mountains and the barbarous caves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "Where manners ne'er were preach'd! Out of my sight!",
          "plainText": "Where manners ne'er were preach'd Out of my sight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "Be not offended, dear Cesario.",
          "plainText": "Be not offended dear Cesario",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0030",
          "number": 30,
          "speechLineNumber": 5,
          "text": "Rudesby, be gone!",
          "plainText": "Rudesby be gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-stage-009",
      "type": "stage",
      "text": "[Exeunt Sir Toby, Sir Andrew and Fabian.]"
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "What relish is in this? How runs the stream?",
          "plainText": "What relish is in this How runs the stream",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Or I am mad, or else this is a dream.",
          "plainText": "Or I am mad or else this is a dream",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "Let fancy still my sense in Lethe steep;",
          "plainText": "Let fancy still my sense in Lethe steep",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "twelfth-night-or-what-you-will-4-1-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "If it be thus to dream, still let me sleep!",
          "plainText": "If it be thus to dream still let me sleep",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-4-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "olivia",
        "name": "OLIVIA",
        "displayName": "Olivia"
      },
      "lines": [
        {
