    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@120923",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nWill you make me believe that I am not sent for you?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@120923/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@120923/line-2",
          "start": 7,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6441603,
        "end": 6441692,
        "line": 240949,
        "column": 1,
        "path": "chap36/p@120923",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121016",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nGo to, go to, thou art a foolish fellow.\nLet me be clear of thee.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121016/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121016/line-2",
          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121016/line-3",
          "start": 52,
          "end": 76,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6441696,
        "end": 6441807,
        "line": 240954,
        "column": 1,
        "path": "chap36/p@121016",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121131",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nWell held out, i’ faith! No, I do not know you, nor I am not sent to you by my lady, to bid you come speak with her; nor your name is not Master Cesario; nor this is not my nose neither. Nothing that is so, is so.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121131/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121131/line-2",
          "start": 7,
          "end": 220,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6441811,
        "end": 6442063,
        "line": 240960,
        "column": 1,
        "path": "chap36/p@121131",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121387",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nI prithee vent thy folly somewhere else,\nThou know’st not me.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121387/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121387/line-2",
          "start": 11,
          "end": 51,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121387/line-3",
          "start": 52,
          "end": 72,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6442067,
        "end": 6442174,
        "line": 240967,
        "column": 1,
        "path": "chap36/p@121387",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121498",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nVent my folly! He has heard that word of some great man, and now applies it to a fool. Vent my folly! I am afraid this great lubber, the world, will prove a cockney. I prithee now, ungird thy strangeness, and tell me what I shall vent to my lady. Shall I vent to her that thou art coming?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121498/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121498/line-2",
          "start": 7,
          "end": 295,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6442178,
        "end": 6442506,
        "line": 240973,
        "column": 1,
        "path": "chap36/p@121498",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121830",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nI prithee, foolish Greek, depart from me.\nThere’s money for thee; if you tarry longer\nI shall give worse payment.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121830/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121830/line-2",
          "start": 11,
          "end": 52,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121830/line-3",
          "start": 53,
          "end": 96,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121830/line-4",
          "start": 97,
          "end": 124,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6442510,
        "end": 6442674,
        "line": 240981,
        "column": 1,
        "path": "chap36/p@121830",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121998",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nBy my troth, thou hast an open hand. These wise men that give fools money get themselves a good report—after fourteen years’ purchase.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121998/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@121998/line-2",
          "start": 7,
          "end": 141,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6442678,
        "end": 6442850,
        "line": 240988,
        "column": 1,
        "path": "chap36/p@121998",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": "CLOWN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 6
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122174",
      "type": "stage",
      "tag": "p",
      "classes": [
        "scenedesc"
      ],
      "text": "Enter Sir Andrew, Sir Toby and Fabian.",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "span",
          "start": 6,
          "end": 26,
          "className": "charname"
        },
        {
          "tag": "span",
          "start": 31,
          "end": 37,
          "className": "charname"
        }
      ],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122174/line-1",
          "start": 0,
          "end": 38,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6442854,
        "end": 6442981,
        "line": 240994,
        "column": 1,
        "path": "chap36/p@122174",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "not-applicable"
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122305",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR ANDREW.\nNow sir, have I met you again? There’s for you.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122305/line-1",
          "start": 0,
          "end": 11,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122305/line-2",
          "start": 12,
          "end": 59,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6442985,
        "end": 6443074,
        "line": 240998,
        "column": 1,
        "path": "chap36/p@122305",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": "SIR ANDREW.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 11
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122398",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Striking Sebastian.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 20
        }
      ],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122398/line-1",
          "start": 0,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6443078,
        "end": 6443131,
        "line": 241003,
        "column": 1,
        "path": "chap36/p@122398",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122455",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SEBASTIAN.\nWhy, there’s for thee, and there, and there.\nAre all the people mad?",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122455/line-1",
          "start": 0,
          "end": 10,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122455/line-2",
          "start": 11,
          "end": 55,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122455/line-3",
          "start": 56,
          "end": 79,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6443135,
        "end": 6443249,
        "line": 241007,
        "column": 1,
        "path": "chap36/p@122455",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": "SEBASTIAN.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 10
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122573",
      "type": "passage",
      "tag": "p",
      "classes": [
        "right"
      ],
      "text": "[Beating Sir Andrew.]",
      "separatorAfter": "\n\n",
      "spans": [
        {
          "tag": "i",
          "start": 1,
          "end": 20
        }
      ],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122573/line-1",
          "start": 0,
          "end": 21,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6443253,
        "end": 6443306,
        "line": 241013,
        "column": 1,
        "path": "chap36/p@122573",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": null,
      "attribution": {
        "status": "source-unlabelled"
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122630",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "SIR TOBY.\nHold, sir, or I’ll throw your dagger o’er the house.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122630/line-1",
          "start": 0,
          "end": 9,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122630/line-2",
          "start": 10,
          "end": 62,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
        "start": 6443310,
        "end": 6443402,
        "line": 241017,
        "column": 1,
        "path": "chap36/p@122630",
        "anchor": "sceneIV_36.1"
      },
      "speakerLabel": "SIR TOBY.",
      "attribution": {
        "status": "explicit",
        "cueStart": 0,
        "cueEnd": 9
      }
    },
    {
      "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122726",
      "type": "speech",
      "tag": "p",
      "classes": [
        "drama"
      ],
      "text": "CLOWN.\nThis will I tell my lady straight. I would not be in some of your coats for twopence.",
      "separatorAfter": "\n\n",
      "spans": [],
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122726/line-1",
          "start": 0,
          "end": 6,
          "sourceLineNumber": null
        },
        {
          "id": "twelfth-night-or-what-you-will/sceneIV_36.1/p@122726/line-2",
          "start": 7,
          "end": 92,
          "sourceLineNumber": null
        }
      ],
      "sourceRef": {
