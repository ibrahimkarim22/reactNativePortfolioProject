        "name": "BOTTOM",
        "displayName": "Bottom"
      },
      "lines": [
        {
          "id": "a-midsummer-nights-dream-1-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "First, good Peter Quince, say what the play treats on; then read the names of the actors; and so grow to a point.",
          "plainText": "First good Peter Quince say what the play treats on then read the names of the actors and so grow to a point",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
