        {
          "id": "a-midsummer-nights-dream-1-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Here is the scroll of every man's name, which is thought fit through all Athens, to play in our interlude before the Duke and Duchess, on his wedding-day at night.",
          "plainText": "Here is the scroll of every man's name which is thought fit through all Athens to play in our interlude before the Duke and Duchess on his weddingday at night",
          "lineType": "prose",
          "lineTypeDetection": "auto",
