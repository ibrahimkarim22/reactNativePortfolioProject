      "type": "speech",
      "speaker": {
        "id": "bottom",
        "name": "BOTTOM",
        "displayName": "Bottom"
      },
      "lines": [
        {
          "id": "a-midsummer-nights-dream-1-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "A very good piece of work, I assure you, and a merry. Now, good Peter Quince, call forth your actors by the scroll. Masters, spread yourselves.",
          "plainText": "A very good piece of work I assure you and a merry Now good Peter Quince call forth your actors by the scroll Masters spread yourselves",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
