          "number": 51,
          "speechLineNumber": 1,
          "text": "At the Duke's oak we meet.",
          "plainText": "At the Duke's oak we meet",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
