      "lines": [
        {
          "id": "a-midsummer-nights-dream-1-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Ready. Name what part I am for, and proceed.",
          "plainText": "Ready Name what part I am for and proceed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
