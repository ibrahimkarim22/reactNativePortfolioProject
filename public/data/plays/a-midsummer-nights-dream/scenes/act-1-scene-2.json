      },
      "lines": [
        {
          "id": "a-midsummer-nights-dream-1-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Answer, as I call you. Nick Bottom, the weaver.",
          "plainText": "Answer as I call you Nick Bottom the weaver",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
