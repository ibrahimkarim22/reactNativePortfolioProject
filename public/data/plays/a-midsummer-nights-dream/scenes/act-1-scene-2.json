      },
      "lines": [
        {
          "id": "a-midsummer-nights-dream-1-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Marry, our play is The most lamentable comedy and most cruel death of Pyramus and Thisbe.",
          "plainText": "Marry our play is The most lamentable comedy and most cruel death of Pyramus and Thisbe",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
