        "name": "BOTTOM",
        "displayName": "Bottom"
      },
      "lines": [
        {
          "id": "a-midsummer-nights-dream-1-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "What is Pyramus—a lover, or a tyrant?",
          "plainText": "What is Pyramusa lover or a tyrant",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "a-midsummer-nights-dream-1-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "quince",
        "name": "QUINCE",
        "displayName": "Quince"
      },
      "lines": [
        {
          "id": "a-midsummer-nights-dream-1-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "A lover, that kills himself most gallantly for love.",
          "plainText": "A lover that kills himself most gallantly for love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
