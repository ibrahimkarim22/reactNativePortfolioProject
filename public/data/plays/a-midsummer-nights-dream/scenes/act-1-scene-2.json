      "speaker": {
        "id": "quince",
        "name": "QUINCE",
        "displayName": "Quince"
      },
      "lines": [
        {
          "id": "a-midsummer-nights-dream-1-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "You, Nick Bottom, are set down for Pyramus.",
          "plainText": "You Nick Bottom are set down for Pyramus",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
