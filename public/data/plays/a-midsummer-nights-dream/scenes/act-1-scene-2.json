          "plainText": "And make and mar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "a-midsummer-nights-dream-1-2-line-0020",
          "number": 20,
          "speechLineNumber": 9,
          "text": "The foolish Fates.",
          "plainText": "The foolish Fates",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "a-midsummer-nights-dream-1-2-line-0021",
          "number": 21,
          "speechLineNumber": 10,
          "text": "This was lofty. Now name the rest of the players. This is Ercles' vein, a tyrant's vein; a lover is more condoling.",
