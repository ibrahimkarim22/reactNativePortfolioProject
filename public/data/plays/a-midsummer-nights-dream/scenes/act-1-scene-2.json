          "text": "You, Pyramus' father; myself, Thisbe's father;",
          "plainText": "You Pyramus' father myself Thisbe's father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "a-midsummer-nights-dream-1-2-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Snug, the joiner, you, the lion's part. And, I hope here is a play fitted.",
          "plainText": "Snug the joiner you the lion's part And I hope here is a play fitted",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "a-midsummer-nights-dream-1-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "snug",
        "name": "SNUG",
        "displayName": "Snug"
      },
      "lines": [
        {
          "id": "a-midsummer-nights-dream-1-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Have you the lion's part written? Pray you, if it be, give it me, for I am slow of study.",
          "plainText": "Have you the lion's part written Pray you if it be give it me for I am slow of study",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
