  },
  "scene": {
    "id": "alls-well-that-ends-well-2-4",
    "act": 2,
    "scene": 4,
    "label": "Act 2, Scene 4",
    "title": "SCENE IV. Paris. The King's palace.",
    "location": "Paris. The King's palace.",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "alls-well-that-ends-well-2-4-stage-001",
      "type": "stage",
      "text": "Enter Helena and Clown."
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "My mother greets me kindly: is she well?",
          "plainText": "My mother greets me kindly is she well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "She is not well, but yet she has her health; she's very merry, but yet she is not well. But thanks be given, she's very well, and wants nothing i' the world; but yet she is not well.",
          "plainText": "She is not well but yet she has her health she's very merry but yet she is not well But thanks be given she's very well and wants nothing i' the world but yet she is not well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "If she be very well, what does she ail that she's not very well?",
          "plainText": "If she be very well what does she ail that she's not very well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Truly, she's very well indeed, but for two things.",
          "plainText": "Truly she's very well indeed but for two things",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "What two things?",
          "plainText": "What two things",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "One, that she's not in heaven, whither God send her quickly! The other, that she's in earth, from whence God send her quickly!",
          "plainText": "One that she's not in heaven whither God send her quickly The other that she's in earth from whence God send her quickly",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-stage-002",
      "type": "stage",
      "text": "Enter Parolles."
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Bless you, my fortunate lady!",
          "plainText": "Bless you my fortunate lady",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I hope, sir, I have your good will to have mine own good fortune.",
          "plainText": "I hope sir I have your good will to have mine own good fortune",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "You had my prayers to lead them on; and to keep them on, have them still. O, my knave how does my old lady?",
          "plainText": "You had my prayers to lead them on and to keep them on have them still O my knave how does my old lady",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "So that you had her wrinkles and I her money, I would she did as you say.",
          "plainText": "So that you had her wrinkles and I her money I would she did as you say",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Why, I say nothing.",
          "plainText": "Why I say nothing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Marry, you are the wiser man; for many a man's tongue shakes out his master's undoing. To say nothing, to do nothing, to know nothing, and to have nothing, is to be a great part of your title; which is within a very little of nothing.",
          "plainText": "Marry you are the wiser man for many a man's tongue shakes out his master's undoing To say nothing to do nothing to know nothing and to have nothing is to be a great part of your title which is within a very little of nothing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Away! Thou art a knave.",
          "plainText": "Away Thou art a knave",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "You should have said, sir, before a knave thou art a knave; that is before me thou art a knave. This had been truth, sir.",
          "plainText": "You should have said sir before a knave thou art a knave that is before me thou art a knave This had been truth sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Go to, thou art a witty fool; I have found thee.",
          "plainText": "Go to thou art a witty fool I have found thee",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Did you find me in yourself, sir? or were you taught to find me? The search, sir, was profitable; and much fool may you find in you, even to the world's pleasure and the increase of laughter.",
          "plainText": "Did you find me in yourself sir or were you taught to find me The search sir was profitable and much fool may you find in you even to the world's pleasure and the increase of laughter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "A good knave, i' faith, and well fed.",
          "plainText": "A good knave i' faith and well fed",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Madam, my lord will go away tonight;",
          "plainText": "Madam my lord will go away tonight",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "A very serious business calls on him.",
          "plainText": "A very serious business calls on him",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "The great prerogative and right of love,",
          "plainText": "The great prerogative and right of love",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Which, as your due, time claims, he does acknowledge;",
          "plainText": "Which as your due time claims he does acknowledge",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "But puts it off to a compell'd restraint;",
          "plainText": "But puts it off to a compell'd restraint",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0023",
          "number": 23,
          "speechLineNumber": 7,
          "text": "Whose want, and whose delay, is strew'd with sweets;",
          "plainText": "Whose want and whose delay is strew'd with sweets",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0024",
          "number": 24,
          "speechLineNumber": 8,
          "text": "Which they distil now in the curbed time,",
          "plainText": "Which they distil now in the curbed time",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0025",
          "number": 25,
          "speechLineNumber": 9,
          "text": "To make the coming hour o'erflow with joy",
          "plainText": "To make the coming hour o'erflow with joy",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0026",
          "number": 26,
          "speechLineNumber": 10,
          "text": "And pleasure drown the brim.",
          "plainText": "And pleasure drown the brim",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "What's his will else?",
          "plainText": "What's his will else",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "That you will take your instant leave o' the king,",
          "plainText": "That you will take your instant leave o' the king",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "And make this haste as your own good proceeding,",
          "plainText": "And make this haste as your own good proceeding",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "Strengthen'd with what apology you think",
          "plainText": "Strengthen'd with what apology you think",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0031",
          "number": 31,
          "speechLineNumber": 4,
          "text": "May make it probable need.",
          "plainText": "May make it probable need",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "What more commands he?",
          "plainText": "What more commands he",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "That, having this obtain'd, you presently",
          "plainText": "That having this obtain'd you presently",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-4-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Attend his further pleasure.",
          "plainText": "Attend his further pleasure",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "In everything I wait upon his will.",
          "plainText": "In everything I wait upon his will",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "I shall report it so.",
          "plainText": "I shall report it so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-4-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "I pray you. Come, sirrah.",
          "plainText": "I pray you Come sirrah",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-4-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}