  "scene": {
    "id": "alls-well-that-ends-well-2-5",
    "act": 2,
    "scene": 5,
    "label": "Act 2, Scene 5",
    "title": "SCENE V. Another room in the same.",
    "location": "Another room in the same.",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "alls-well-that-ends-well-2-5-stage-001",
      "type": "stage",
      "text": "Enter Lafew and Bertram."
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lafew",
        "name": "LAFEW",
        "displayName": "Lafew"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "But I hope your lordship thinks not him a soldier.",
          "plainText": "But I hope your lordship thinks not him a soldier",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Yes, my lord, and of very valiant approof.",
          "plainText": "Yes my lord and of very valiant approof",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lafew",
        "name": "LAFEW",
        "displayName": "Lafew"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "You have it from his own deliverance.",
          "plainText": "You have it from his own deliverance",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "And by other warranted testimony.",
          "plainText": "And by other warranted testimony",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lafew",
        "name": "LAFEW",
        "displayName": "Lafew"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Then my dial goes not true; I took this lark for a bunting.",
          "plainText": "Then my dial goes not true I took this lark for a bunting",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "I do assure you, my lord, he is very great in knowledge, and accordingly valiant.",
          "plainText": "I do assure you my lord he is very great in knowledge and accordingly valiant",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lafew",
        "name": "LAFEW",
        "displayName": "Lafew"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "I have, then, sinned against his experience and transgressed against his valour; and my state that way is dangerous, since I cannot yet find in my heart to repent. Here he comes; I pray you make us friends; I will pursue the amity.",
          "plainText": "I have then sinned against his experience and transgressed against his valour and my state that way is dangerous since I cannot yet find in my heart to repent Here he comes I pray you make us friends I will pursue the amity",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-stage-002",
      "type": "stage",
      "text": "Enter Parolles."
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "[To Bertram.] These things shall be done, sir.",
          "plainText": "To Bertram These things shall be done sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "lafew",
        "name": "LAFEW",
        "displayName": "Lafew"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Pray you, sir, who's his tailor?",
          "plainText": "Pray you sir who's his tailor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Sir!",
          "plainText": "Sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "lafew",
        "name": "LAFEW",
        "displayName": "Lafew"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "O, I know him well, I, sir; he, sir, is a good workman, a very good tailor.",
          "plainText": "O I know him well I sir he sir is a good workman a very good tailor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "[Aside to Parolles.] Is she gone to the king?",
          "plainText": "Aside to Parolles Is she gone to the king",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "She is.",
          "plainText": "She is",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Will she away tonight?",
          "plainText": "Will she away tonight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "As you'll have her.",
          "plainText": "As you'll have her",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "I have writ my letters, casketed my treasure,",
          "plainText": "I have writ my letters casketed my treasure",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Given order for our horses; and tonight,",
          "plainText": "Given order for our horses and tonight",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "When I should take possession of the bride,",
          "plainText": "When I should take possession of the bride",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "End ere I do begin.",
          "plainText": "End ere I do begin",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "lafew",
        "name": "LAFEW",
        "displayName": "Lafew"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "A good traveller is something at the latter end of a dinner; but one that lies three-thirds and uses a known truth to pass a thousand nothings with, should be once heard and thrice beaten.— God save you, Captain.",
          "plainText": "A good traveller is something at the latter end of a dinner but one that lies threethirds and uses a known truth to pass a thousand nothings with should be once heard and thrice beaten God save you Captain",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Is there any unkindness between my lord and you, monsieur?",
          "plainText": "Is there any unkindness between my lord and you monsieur",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I know not how I have deserved to run into my lord's displeasure.",
          "plainText": "I know not how I have deserved to run into my lord's displeasure",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "lafew",
        "name": "LAFEW",
        "displayName": "Lafew"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "You have made shift to run into 't, boots and spurs and all, like him that leapt into the custard; and out of it you'll run again, rather than suffer question for your residence.",
          "plainText": "You have made shift to run into 't boots and spurs and all like him that leapt into the custard and out of it you'll run again rather than suffer question for your residence",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "It may be you have mistaken him, my lord.",
          "plainText": "It may be you have mistaken him my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "lafew",
        "name": "LAFEW",
        "displayName": "Lafew"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "And shall do so ever, though I took him at his prayers. Fare you well, my lord; and believe this of me, there can be no kernal in this light nut; the soul of this man is his clothes; trust him not in matter of heavy consequence; I have kept of them tame, and know their natures. Farewell, monsieur; I have spoken better of you than you have or will to deserve at my hand; but we must do good against evil.",
          "plainText": "And shall do so ever though I took him at his prayers Fare you well my lord and believe this of me there can be no kernal in this light nut the soul of this man is his clothes trust him not in matter of heavy consequence I have kept of them tame and know their natures Farewell monsieur I have spoken better of you than you have or will to deserve at my hand but we must do good against evil",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "An idle lord, I swear.",
          "plainText": "An idle lord I swear",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "I think so.",
          "plainText": "I think so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Why, do you not know him?",
          "plainText": "Why do you not know him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Yes, I do know him well; and common speech",
          "plainText": "Yes I do know him well and common speech",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "Gives him a worthy pass. Here comes my clog.",
          "plainText": "Gives him a worthy pass Here comes my clog",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-stage-004",
      "type": "stage",
      "text": "Enter Helena."
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-027",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "I have, sir, as I was commanded from you,",
          "plainText": "I have sir as I was commanded from you",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Spoke with the king, and have procur'd his leave",
          "plainText": "Spoke with the king and have procur'd his leave",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "For present parting; only he desires",
          "plainText": "For present parting only he desires",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "Some private speech with you.",
          "plainText": "Some private speech with you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-028",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "I shall obey his will.",
          "plainText": "I shall obey his will",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "You must not marvel, Helen, at my course,",
          "plainText": "You must not marvel Helen at my course",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "Which holds not colour with the time, nor does",
          "plainText": "Which holds not colour with the time nor does",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0038",
          "number": 38,
          "speechLineNumber": 4,
          "text": "The ministration and required office",
          "plainText": "The ministration and required office",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0039",
          "number": 39,
          "speechLineNumber": 5,
          "text": "On my particular. Prepared I was not",
          "plainText": "On my particular Prepared I was not",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0040",
          "number": 40,
          "speechLineNumber": 6,
          "text": "For such a business; therefore am I found",
          "plainText": "For such a business therefore am I found",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0041",
          "number": 41,
          "speechLineNumber": 7,
          "text": "So much unsettled: this drives me to entreat you;",
          "plainText": "So much unsettled this drives me to entreat you",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0042",
          "number": 42,
          "speechLineNumber": 8,
          "text": "That presently you take your way for home,",
          "plainText": "That presently you take your way for home",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0043",
          "number": 43,
          "speechLineNumber": 9,
          "text": "And rather muse than ask why I entreat you:",
          "plainText": "And rather muse than ask why I entreat you",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0044",
          "number": 44,
          "speechLineNumber": 10,
          "text": "For my respects are better than they seem;",
          "plainText": "For my respects are better than they seem",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0045",
          "number": 45,
          "speechLineNumber": 11,
          "text": "And my appointments have in them a need",
          "plainText": "And my appointments have in them a need",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0046",
          "number": 46,
          "speechLineNumber": 12,
          "text": "Greater than shows itself at the first view",
          "plainText": "Greater than shows itself at the first view",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0047",
          "number": 47,
          "speechLineNumber": 13,
          "text": "To you that know them not. This to my mother.",
          "plainText": "To you that know them not This to my mother",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-stage-005",
      "type": "stage",
      "text": "[Giving a letter.]"
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-029",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Sir, I can nothing say",
          "plainText": "Sir I can nothing say",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "But that I am your most obedient servant.",
          "plainText": "But that I am your most obedient servant",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-030",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Come, come, no more of that.",
          "plainText": "Come come no more of that",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-031",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "And ever shall",
          "plainText": "And ever shall",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "With true observance seek to eke out that",
          "plainText": "With true observance seek to eke out that",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "Wherein toward me my homely stars have fail'd",
          "plainText": "Wherein toward me my homely stars have fail'd",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "To equal my great fortune.",
          "plainText": "To equal my great fortune",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-032",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Let that go.",
          "plainText": "Let that go",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "My haste is very great. Farewell; hie home.",
          "plainText": "My haste is very great Farewell hie home",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-033",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Pray, sir, your pardon.",
          "plainText": "Pray sir your pardon",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-034",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Well, what would you say?",
          "plainText": "Well what would you say",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-035",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "I am not worthy of the wealth I owe;",
          "plainText": "I am not worthy of the wealth I owe",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "Nor dare I say 'tis mine, and yet it is;",
          "plainText": "Nor dare I say 'tis mine and yet it is",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "But, like a timorous thief, most fain would steal",
          "plainText": "But like a timorous thief most fain would steal",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0062",
          "number": 62,
          "speechLineNumber": 4,
          "text": "What law does vouch mine own.",
          "plainText": "What law does vouch mine own",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-036",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "What would you have?",
          "plainText": "What would you have",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-037",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Something; and scarce so much; nothing indeed.",
          "plainText": "Something and scarce so much nothing indeed",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "I would not tell you what I would, my lord. Faith, yes,",
          "plainText": "I would not tell you what I would my lord Faith yes",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "Strangers and foes do sunder and not kiss.",
          "plainText": "Strangers and foes do sunder and not kiss",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-038",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "I pray you, stay not, but in haste to horse.",
          "plainText": "I pray you stay not but in haste to horse",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-039",
      "type": "speech",
      "speaker": {
        "id": "helena",
        "name": "HELENA",
        "displayName": "Helena"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "I shall not break your bidding, good my lord.",
          "plainText": "I shall not break your bidding good my lord",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "Where are my other men, monsieur?",
          "plainText": "Where are my other men monsieur",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0070",
          "number": 70,
          "speechLineNumber": 3,
          "text": "Farewell,",
          "plainText": "Farewell",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-stage-006",
      "type": "stage",
      "text": "[Exit Helena.]"
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-040",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Go thou toward home, where I will never come",
          "plainText": "Go thou toward home where I will never come",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "Whilst I can shake my sword or hear the drum.",
          "plainText": "Whilst I can shake my sword or hear the drum",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-2-5-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "Away, and for our flight.",
          "plainText": "Away and for our flight",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-speech-041",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-2-5-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Bravely, coragio!",
          "plainText": "Bravely coragio",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-2-5-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}