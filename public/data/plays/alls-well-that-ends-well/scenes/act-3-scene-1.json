  "scene": {
    "id": "alls-well-that-ends-well-3-1",
    "act": 3,
    "scene": 1,
    "label": "Act 3, Scene 1",
    "title": "SCENE I. Florence. A room in the Duke's palace.",
    "location": "Florence. A room in the Duke's palace.",
    "orderInPlay": 9
  },
  "content": [
    {
      "id": "alls-well-that-ends-well-3-1-stage-001",
      "type": "stage",
      "text": "Flourish. Enter the Duke of Florence attended; two French Lords, and Soldiers."
    },
    {
      "id": "alls-well-that-ends-well-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "So that, from point to point, now have you heard",
          "plainText": "So that from point to point now have you heard",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The fundamental reasons of this war,",
          "plainText": "The fundamental reasons of this war",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Whose great decision hath much blood let forth,",
          "plainText": "Whose great decision hath much blood let forth",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And more thirsts after.",
          "plainText": "And more thirsts after",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Holy seems the quarrel",
          "plainText": "Holy seems the quarrel",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Upon your Grace's part; black and fearful",
          "plainText": "Upon your Grace's part black and fearful",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "On the opposer.",
          "plainText": "On the opposer",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Therefore we marvel much our cousin France",
          "plainText": "Therefore we marvel much our cousin France",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Would, in so just a business, shut his bosom",
          "plainText": "Would in so just a business shut his bosom",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Against our borrowing prayers.",
          "plainText": "Against our borrowing prayers",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Good my lord,",
          "plainText": "Good my lord",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "The reasons of our state I cannot yield,",
          "plainText": "The reasons of our state I cannot yield",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "But like a common and an outward man",
          "plainText": "But like a common and an outward man",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "That the great figure of a council frames",
          "plainText": "That the great figure of a council frames",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "By self-unable motion; therefore dare not",
          "plainText": "By selfunable motion therefore dare not",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 6,
          "text": "Say what I think of it, since I have found",
          "plainText": "Say what I think of it since I have found",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 7,
          "text": "Myself in my incertain grounds to fail",
          "plainText": "Myself in my incertain grounds to fail",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 8,
          "text": "As often as I guess'd.",
          "plainText": "As often as I guess'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Be it his pleasure.",
          "plainText": "Be it his pleasure",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "But I am sure the younger of our nature,",
          "plainText": "But I am sure the younger of our nature",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "That surfeit on their ease, will day by day",
          "plainText": "That surfeit on their ease will day by day",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "Come here for physic.",
          "plainText": "Come here for physic",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Welcome shall they be;",
          "plainText": "Welcome shall they be",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "And all the honours that can fly from us",
          "plainText": "And all the honours that can fly from us",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "Shall on them settle. You know your places well;",
          "plainText": "Shall on them settle You know your places well",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "When better fall, for your avails they fell.",
          "plainText": "When better fall for your avails they fell",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "Tomorrow to the field.",
          "plainText": "Tomorrow to the field",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-1-stage-002",
      "type": "stage",
      "text": "[Flourish. Exeunt.]"
    }
  ]
}