  "scene": {
    "id": "alls-well-that-ends-well-3-3",
    "act": 3,
    "scene": 3,
    "label": "Act 3, Scene 3",
    "title": "SCENE III. Florence. Before the Duke's palace.",
    "location": "Florence. Before the Duke's palace.",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "alls-well-that-ends-well-3-3-stage-001",
      "type": "stage",
      "text": "Flourish. Enter the Duke of Florence, Bertram, drum and trumpets, Soldiers, Parolles."
    },
    {
      "id": "alls-well-that-ends-well-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The general of our horse thou art, and we,",
          "plainText": "The general of our horse thou art and we",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Great in our hope, lay our best love and credence",
          "plainText": "Great in our hope lay our best love and credence",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Upon thy promising fortune.",
          "plainText": "Upon thy promising fortune",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Sir, it is",
          "plainText": "Sir it is",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "A charge too heavy for my strength; but yet",
          "plainText": "A charge too heavy for my strength but yet",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "We'll strive to bear it for your worthy sake",
          "plainText": "We'll strive to bear it for your worthy sake",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "To th'extreme edge of hazard.",
          "plainText": "To th'extreme edge of hazard",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Then go thou forth;",
          "plainText": "Then go thou forth",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "And fortune play upon thy prosperous helm,",
          "plainText": "And fortune play upon thy prosperous helm",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "As thy auspicious mistress!",
          "plainText": "As thy auspicious mistress",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "bertram",
        "name": "BERTRAM",
        "displayName": "Bertram"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "This very day,",
          "plainText": "This very day",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Great Mars, I put myself into thy file;",
          "plainText": "Great Mars I put myself into thy file",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Make me but like my thoughts, and I shall prove",
          "plainText": "Make me but like my thoughts and I shall prove",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "A lover of thy drum, hater of love.",
          "plainText": "A lover of thy drum hater of love",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-3-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}