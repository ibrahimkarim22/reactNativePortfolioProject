  "scene": {
    "id": "alls-well-that-ends-well-4-1",
    "act": 4,
    "scene": 1,
    "label": "Act 4, Scene 1",
    "title": "SCENE I. Without the Florentine camp.",
    "location": "Without the Florentine camp.",
    "orderInPlay": 16
  },
  "content": [
    {
      "id": "alls-well-that-ends-well-4-1-stage-001",
      "type": "stage",
      "text": "Enter first Lord with five or six Soldiers in ambush."
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "He can come no other way but by this hedge-corner. When you sally upon him, speak what terrible language you will; though you understand it not yourselves, no matter; for we must not seem to understand him, unless someone among us, whom we must produce for an interpreter.",
          "plainText": "He can come no other way but by this hedgecorner When you sally upon him speak what terrible language you will though you understand it not yourselves no matter for we must not seem to understand him unless someone among us whom we must produce for an interpreter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Good captain, let me be th' interpreter.",
          "plainText": "Good captain let me be th' interpreter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Art not acquainted with him? Knows he not thy voice?",
          "plainText": "Art not acquainted with him Knows he not thy voice",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "No sir, I warrant you.",
          "plainText": "No sir I warrant you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "But what linsey-woolsey has thou to speak to us again?",
          "plainText": "But what linseywoolsey has thou to speak to us again",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "E'en such as you speak to me.",
          "plainText": "E'en such as you speak to me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "He must think us some band of strangers i' the adversary's entertainment. Now he hath a smack of all neighbouring languages, therefore we must every one be a man of his own fancy; not to know what we speak one to another, so we seem to know, is to know straight our purpose: choughs' language, gabble enough, and good enough. As for you, interpreter, you must seem very politic. But couch, ho! Here he comes; to beguile two hours in a sleep, and then to return and swear the lies he forges.",
          "plainText": "He must think us some band of strangers i' the adversary's entertainment Now he hath a smack of all neighbouring languages therefore we must every one be a man of his own fancy not to know what we speak one to another so we seem to know is to know straight our purpose choughs' language gabble enough and good enough As for you interpreter you must seem very politic But couch ho Here he comes to beguile two hours in a sleep and then to return and swear the lies he forges",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-stage-002",
      "type": "stage",
      "text": "Enter Parolles."
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Ten o'clock. Within these three hours 'twill be time enough to go home. What shall I say I have done? It must be a very plausive invention that carries it. They begin to smoke me, and disgraces have of late knock'd too often at my door. I find my tongue is too foolhardy, but my heart hath the fear of Mars before it, and of his creatures, not daring the reports of my tongue.",
          "plainText": "Ten o'clock Within these three hours 'twill be time enough to go home What shall I say I have done It must be a very plausive invention that carries it They begin to smoke me and disgraces have of late knock'd too often at my door I find my tongue is too foolhardy but my heart hath the fear of Mars before it and of his creatures not daring the reports of my tongue",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "[Aside.] This is the first truth that e'er thine own tongue was guilty of.",
          "plainText": "Aside This is the first truth that e'er thine own tongue was guilty of",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "What the devil should move me to undertake the recovery of this drum, being not ignorant of the impossibility, and knowing I had no such purpose? I must give myself some hurts, and say I got them in exploit; yet slight ones will not carry it. They will say \"Came you off with so little?\" and great ones I dare not give. Wherefore, what's the instance? Tongue, I must put you into a butter-woman's mouth, and buy myself another of Bajazet's mule, if you prattle me into these perils.",
          "plainText": "What the devil should move me to undertake the recovery of this drum being not ignorant of the impossibility and knowing I had no such purpose I must give myself some hurts and say I got them in exploit yet slight ones will not carry it They will say Came you off with so little and great ones I dare not give Wherefore what's the instance Tongue I must put you into a butterwoman's mouth and buy myself another of Bajazet's mule if you prattle me into these perils",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "[Aside.] Is it possible he should know what he is, and be that he is?",
          "plainText": "Aside Is it possible he should know what he is and be that he is",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "I would the cutting of my garments would serve the turn, or the breaking of my Spanish sword.",
          "plainText": "I would the cutting of my garments would serve the turn or the breaking of my Spanish sword",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "[Aside.] We cannot afford you so.",
          "plainText": "Aside We cannot afford you so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Or the baring of my beard, and to say it was in stratagem.",
          "plainText": "Or the baring of my beard and to say it was in stratagem",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "[Aside.] 'Twould not do.",
          "plainText": "Aside 'Twould not do",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Or to drown my clothes, and say I was stripped.",
          "plainText": "Or to drown my clothes and say I was stripped",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "[Aside.] Hardly serve.",
          "plainText": "Aside Hardly serve",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Though I swore I leap'd from the window of the citadel,—",
          "plainText": "Though I swore I leap'd from the window of the citadel",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "[Aside.] How deep?",
          "plainText": "Aside How deep",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Thirty fathom.",
          "plainText": "Thirty fathom",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "[Aside.] Three great oaths would scarce make that be believed.",
          "plainText": "Aside Three great oaths would scarce make that be believed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I would I had any drum of the enemy's; I would swear I recover'd it.",
          "plainText": "I would I had any drum of the enemy's I would swear I recover'd it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "[Aside.] You shall hear one anon.",
          "plainText": "Aside You shall hear one anon",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "A drum now of the enemy's!",
          "plainText": "A drum now of the enemy's",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-stage-003",
      "type": "stage",
      "text": "[Alarum within.]"
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Throca movousus, cargo, cargo, cargo.",
          "plainText": "Throca movousus cargo cargo cargo",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Cargo, cargo, cargo, villianda par corbo, cargo.",
          "plainText": "Cargo cargo cargo villianda par corbo cargo",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-stage-004",
      "type": "stage",
      "text": "[They seize and blindfold him.]"
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "O, ransom, ransom! Do not hide mine eyes.",
          "plainText": "O ransom ransom Do not hide mine eyes",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Boskos thromuldo boskos.",
          "plainText": "Boskos thromuldo boskos",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I know you are the Muskos' regiment,",
          "plainText": "I know you are the Muskos' regiment",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "And I shall lose my life for want of language.",
          "plainText": "And I shall lose my life for want of language",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "If there be here German, or Dane, Low Dutch,",
          "plainText": "If there be here German or Dane Low Dutch",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "Italian, or French, let him speak to me,",
          "plainText": "Italian or French let him speak to me",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0033",
          "number": 33,
          "speechLineNumber": 5,
          "text": "I'll discover that which shall undo the Florentine.",
          "plainText": "I'll discover that which shall undo the Florentine",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Boskos vauvado. I understand thee, and can speak thy tongue. Kerelybonto. Sir, Betake thee to thy faith, for seventeen poniards are at thy bosom.",
          "plainText": "Boskos vauvado I understand thee and can speak thy tongue Kerelybonto Sir Betake thee to thy faith for seventeen poniards are at thy bosom",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-031",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "O!",
          "plainText": "O",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-032",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "O, pray, pray, pray!",
          "plainText": "O pray pray pray",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "Manka revania dulche.",
          "plainText": "Manka revania dulche",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-033",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Oscorbidulchos volivorco.",
          "plainText": "Oscorbidulchos volivorco",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-034",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "The General is content to spare thee yet;",
          "plainText": "The General is content to spare thee yet",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "And, hoodwink'd as thou art, will lead thee on",
          "plainText": "And hoodwink'd as thou art will lead thee on",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "To gather from thee. Haply thou mayst inform",
          "plainText": "To gather from thee Haply thou mayst inform",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0042",
          "number": 42,
          "speechLineNumber": 4,
          "text": "Something to save thy life.",
          "plainText": "Something to save thy life",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-035",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "O, let me live,",
          "plainText": "O let me live",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "And all the secrets of our camp I'll show,",
          "plainText": "And all the secrets of our camp I'll show",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Their force, their purposes; nay, I'll speak that",
          "plainText": "Their force their purposes nay I'll speak that",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "Which you will wonder at.",
          "plainText": "Which you will wonder at",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-036",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "But wilt thou faithfully?",
          "plainText": "But wilt thou faithfully",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-037",
      "type": "speech",
      "speaker": {
        "id": "parolles",
        "name": "PAROLLES",
        "displayName": "Parolles"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "If I do not, damn me.",
          "plainText": "If I do not damn me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-038",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Acordo linta.",
          "plainText": "Acordo linta",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Come on; thou art granted space.",
          "plainText": "Come on thou art granted space",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-stage-005",
      "type": "stage",
      "text": "[Exit, with Parolles guarded.]"
    },
    {
      "id": "alls-well-that-ends-well-4-1-stage-006",
      "type": "stage",
      "text": "A short alarum within."
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-039",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Go tell the Count Rossillon and my brother",
          "plainText": "Go tell the Count Rossillon and my brother",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "We have caught the woodcock, and will keep him muffled",
          "plainText": "We have caught the woodcock and will keep him muffled",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "Till we do hear from them.",
          "plainText": "Till we do hear from them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-040",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Captain, I will.",
          "plainText": "Captain I will",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-041",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "'A will betray us all unto ourselves;",
          "plainText": "'A will betray us all unto ourselves",
          "lineType": "verse"
        },
        {
          "id": "alls-well-that-ends-well-4-1-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "Inform on that.",
          "plainText": "Inform on that",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-042",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "So I will, sir.",
          "plainText": "So I will sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-speech-043",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "alls-well-that-ends-well-4-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Till then I'll keep him dark, and safely lock'd.",
          "plainText": "Till then I'll keep him dark and safely lock'd",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "alls-well-that-ends-well-4-1-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}