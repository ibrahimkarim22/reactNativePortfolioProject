    "scene": 1,
    "label": "Act 1, Scene 1",
    "title": "SCENE I. Alexandria. A Room in Cleopatra's palace.",
    "location": "Alexandria. A Room in Cleopatra's palace.",
    "orderInPlay": 1
  },
  "content": [
    {
      "id": "antony-and-cleopatra-1-1-stage-001",
      "type": "stage",
      "text": "Enter Demetrius and Philo."
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "philo",
        "name": "PHILO",
        "displayName": "Philo"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Nay, but this dotage of our general's",
          "plainText": "Nay but this dotage of our general's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "O'erflows the measure. Those his goodly eyes,",
          "plainText": "O'erflows the measure Those his goodly eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "That o'er the files and musters of the war",
          "plainText": "That o'er the files and musters of the war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Have glowed like plated Mars, now bend, now turn",
          "plainText": "Have glowed like plated Mars now bend now turn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "The office and devotion of their view",
          "plainText": "The office and devotion of their view",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Upon a tawny front. His captain's heart,",
          "plainText": "Upon a tawny front His captain's heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Which in the scuffles of great fights hath burst",
          "plainText": "Which in the scuffles of great fights hath burst",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "The buckles on his breast, reneges all temper",
          "plainText": "The buckles on his breast reneges all temper",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "And is become the bellows and the fan",
          "plainText": "And is become the bellows and the fan",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "To cool a gipsy's lust.",
          "plainText": "To cool a gipsy's lust",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-stage-002",
      "type": "stage",
      "text": "Flourish. Enter Antony and Cleopatra, her Ladies, the Train, with Eunuchs fanning her."
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "If it be love indeed, tell me how much.",
          "plainText": "If it be love indeed tell me how much",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "There's beggary in the love that can be reckoned.",
          "plainText": "There's beggary in the love that can be reckoned",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "I'll set a bourn how far to be beloved.",
          "plainText": "I'll set a bourn how far to be beloved",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Then must thou needs find out new heaven, new earth.",
          "plainText": "Then must thou needs find out new heaven new earth",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-stage-003",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "News, my good lord, from Rome.",
          "plainText": "News my good lord from Rome",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Grates me, the sum.",
          "plainText": "Grates me the sum",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Nay, hear them, Antony.",
          "plainText": "Nay hear them Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Fulvia perchance is angry; or who knows",
          "plainText": "Fulvia perchance is angry or who knows",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "If the scarce-bearded Caesar have not sent",
          "plainText": "If the scarcebearded Caesar have not sent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "His powerful mandate to you: \"Do this or this;",
          "plainText": "His powerful mandate to you Do this or this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Take in that kingdom and enfranchise that.",
          "plainText": "Take in that kingdom and enfranchise that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "Perform't, or else we damn thee.\"",
          "plainText": "Perform't or else we damn thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "How, my love?",
          "plainText": "How my love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Perchance! Nay, and most like.",
          "plainText": "Perchance Nay and most like",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "You must not stay here longer; your dismission",
          "plainText": "You must not stay here longer your dismission",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "Is come from Caesar; therefore hear it, Antony.",
          "plainText": "Is come from Caesar therefore hear it Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "Where's Fulvia's process?—Caesar's I would say? Both?",
          "plainText": "Where's Fulvia's processCaesar's I would say Both",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0028",
          "number": 28,
          "speechLineNumber": 5,
          "text": "Call in the messengers. As I am Egypt's queen,",
          "plainText": "Call in the messengers As I am Egypt's queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0029",
          "number": 29,
          "speechLineNumber": 6,
          "text": "Thou blushest, Antony, and that blood of thine",
          "plainText": "Thou blushest Antony and that blood of thine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0030",
          "number": 30,
          "speechLineNumber": 7,
          "text": "Is Caesar's homager; else so thy cheek pays shame",
          "plainText": "Is Caesar's homager else so thy cheek pays shame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0031",
          "number": 31,
          "speechLineNumber": 8,
          "text": "When shrill-tongued Fulvia scolds. The messengers!",
          "plainText": "When shrilltongued Fulvia scolds The messengers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Let Rome in Tiber melt, and the wide arch",
          "plainText": "Let Rome in Tiber melt and the wide arch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Of the ranged empire fall! Here is my space.",
          "plainText": "Of the ranged empire fall Here is my space",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "Kingdoms are clay. Our dungy earth alike",
          "plainText": "Kingdoms are clay Our dungy earth alike",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "Feeds beast as man. The nobleness of life",
          "plainText": "Feeds beast as man The nobleness of life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "Is to do thus [Embracing]; when such a mutual pair",
          "plainText": "Is to do thus Embracing when such a mutual pair",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "And such a twain can do't, in which I bind,",
          "plainText": "And such a twain can do't in which I bind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "On pain of punishment, the world to weet",
          "plainText": "On pain of punishment the world to weet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0039",
          "number": 39,
          "speechLineNumber": 8,
          "text": "We stand up peerless.",
          "plainText": "We stand up peerless",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Excellent falsehood!",
          "plainText": "Excellent falsehood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Why did he marry Fulvia, and not love her?",
          "plainText": "Why did he marry Fulvia and not love her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "I'll seem the fool I am not. Antony",
          "plainText": "I'll seem the fool I am not Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "Will be himself.",
          "plainText": "Will be himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "But stirred by Cleopatra.",
          "plainText": "But stirred by Cleopatra",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "Now, for the love of Love and her soft hours,",
          "plainText": "Now for the love of Love and her soft hours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "Let's not confound the time with conference harsh.",
          "plainText": "Let's not confound the time with conference harsh",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "There's not a minute of our lives should stretch",
          "plainText": "There's not a minute of our lives should stretch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0048",
          "number": 48,
          "speechLineNumber": 5,
          "text": "Without some pleasure now. What sport tonight?",
          "plainText": "Without some pleasure now What sport tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-014",
