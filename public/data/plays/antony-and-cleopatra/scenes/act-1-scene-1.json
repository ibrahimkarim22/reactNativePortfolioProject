          "id": "antony-and-cleopatra-1-1-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Hear the ambassadors.",
          "plainText": "Hear the ambassadors",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Fie, wrangling queen!",
          "plainText": "Fie wrangling queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "Whom everything becomes—to chide, to laugh,",
          "plainText": "Whom everything becomesto chide to laugh",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0052",
          "number": 52,
          "speechLineNumber": 3,
          "text": "To weep; whose every passion fully strives",
          "plainText": "To weep whose every passion fully strives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0053",
          "number": 53,
          "speechLineNumber": 4,
          "text": "To make itself, in thee fair and admired!",
          "plainText": "To make itself in thee fair and admired",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0054",
          "number": 54,
          "speechLineNumber": 5,
          "text": "No messenger but thine, and all alone",
          "plainText": "No messenger but thine and all alone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0055",
          "number": 55,
          "speechLineNumber": 6,
          "text": "Tonight we'll wander through the streets and note",
          "plainText": "Tonight we'll wander through the streets and note",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0056",
          "number": 56,
          "speechLineNumber": 7,
          "text": "The qualities of people. Come, my queen,",
          "plainText": "The qualities of people Come my queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0057",
          "number": 57,
          "speechLineNumber": 8,
          "text": "Last night you did desire it. Speak not to us.",
          "plainText": "Last night you did desire it Speak not to us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-stage-004",
      "type": "stage",
      "text": "[Exeunt Antony and Cleopatra with the Train.]"
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "demetrius",
        "name": "DEMETRIUS",
        "displayName": "Demetrius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Is Caesar with Antonius prized so slight?",
          "plainText": "Is Caesar with Antonius prized so slight",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "philo",
        "name": "PHILO",
        "displayName": "Philo"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Sir, sometimes when he is not Antony,",
          "plainText": "Sir sometimes when he is not Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "He comes too short of that great property",
          "plainText": "He comes too short of that great property",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "Which still should go with Antony.",
          "plainText": "Which still should go with Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "demetrius",
        "name": "DEMETRIUS",
        "displayName": "Demetrius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-1-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "I am full sorry",
          "plainText": "I am full sorry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "That he approves the common liar who",
          "plainText": "That he approves the common liar who",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "Thus speaks of him at Rome, but I will hope",
          "plainText": "Thus speaks of him at Rome but I will hope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-1-1-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "Of better deeds tomorrow. Rest you happy!",
          "plainText": "Of better deeds tomorrow Rest you happy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-1-stage-005",
