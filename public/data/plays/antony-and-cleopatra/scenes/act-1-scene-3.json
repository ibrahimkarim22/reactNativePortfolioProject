  "scene": {
    "id": "antony-and-cleopatra-1-3",
    "act": 1,
    "scene": 3,
    "label": "Act 1, Scene 3",
    "title": "SCENE III. Alexandria. A Room in Cleopatra's palace.",
    "location": "Alexandria. A Room in Cleopatra's palace.",
    "orderInPlay": 3
  },
  "content": [
    {
      "id": "antony-and-cleopatra-1-3-stage-001",
      "type": "stage",
      "text": "Enter Cleopatra, Charmian, Alexas and Iras."
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Where is he?",
          "plainText": "Where is he",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "I did not see him since.",
          "plainText": "I did not see him since",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "See where he is, who's with him, what he does.",
          "plainText": "See where he is who's with him what he does",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "I did not send you. If you find him sad,",
          "plainText": "I did not send you If you find him sad",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Say I am dancing; if in mirth, report",
          "plainText": "Say I am dancing if in mirth report",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "That I am sudden sick. Quick, and return.",
          "plainText": "That I am sudden sick Quick and return",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-stage-002",
      "type": "stage",
      "text": "[Exit Alexas.]"
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Madam, methinks, if you did love him dearly,",
          "plainText": "Madam methinks if you did love him dearly",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "You do not hold the method to enforce",
          "plainText": "You do not hold the method to enforce",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "The like from him.",
          "plainText": "The like from him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "What should I do I do not?",
          "plainText": "What should I do I do not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "In each thing give him way; cross him in nothing.",
          "plainText": "In each thing give him way cross him in nothing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Thou teachest like a fool: the way to lose him.",
          "plainText": "Thou teachest like a fool the way to lose him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Tempt him not so too far; I wish, forbear.",
          "plainText": "Tempt him not so too far I wish forbear",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "In time we hate that which we often fear.",
          "plainText": "In time we hate that which we often fear",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "But here comes Antony.",
          "plainText": "But here comes Antony",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-stage-003",
      "type": "stage",
      "text": "Enter Antony."
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "I am sick and sullen.",
          "plainText": "I am sick and sullen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "I am sorry to give breathing to my purpose—",
          "plainText": "I am sorry to give breathing to my purpose",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Help me away, dear Charmian! I shall fall.",
          "plainText": "Help me away dear Charmian I shall fall",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "It cannot be thus long; the sides of nature",
          "plainText": "It cannot be thus long the sides of nature",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "Will not sustain it.",
          "plainText": "Will not sustain it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Now, my dearest queen—",
          "plainText": "Now my dearest queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Pray you, stand farther from me.",
          "plainText": "Pray you stand farther from me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "What's the matter?",
          "plainText": "What's the matter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "I know by that same eye there's some good news.",
          "plainText": "I know by that same eye there's some good news",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "What, says the married woman you may go?",
          "plainText": "What says the married woman you may go",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "Would she had never given you leave to come!",
          "plainText": "Would she had never given you leave to come",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "Let her not say 'tis I that keep you here.",
          "plainText": "Let her not say 'tis I that keep you here",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0028",
          "number": 28,
          "speechLineNumber": 5,
          "text": "I have no power upon you; hers you are.",
          "plainText": "I have no power upon you hers you are",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "The gods best know—",
          "plainText": "The gods best know",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "O, never was there queen",
          "plainText": "O never was there queen",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "So mightily betrayed! Yet at the first",
          "plainText": "So mightily betrayed Yet at the first",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "I saw the treasons planted.",
          "plainText": "I saw the treasons planted",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Cleopatra—",
          "plainText": "Cleopatra",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Why should I think you can be mine and true,",
          "plainText": "Why should I think you can be mine and true",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Though you in swearing shake the throned gods,",
          "plainText": "Though you in swearing shake the throned gods",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Who have been false to Fulvia? Riotous madness,",
          "plainText": "Who have been false to Fulvia Riotous madness",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "To be entangled with those mouth-made vows",
          "plainText": "To be entangled with those mouthmade vows",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "Which break themselves in swearing!",
          "plainText": "Which break themselves in swearing",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Most sweet queen—",
          "plainText": "Most sweet queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Nay, pray you seek no colour for your going,",
          "plainText": "Nay pray you seek no colour for your going",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "But bid farewell and go. When you sued staying,",
          "plainText": "But bid farewell and go When you sued staying",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Then was the time for words. No going then,",
          "plainText": "Then was the time for words No going then",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "Eternity was in our lips and eyes,",
          "plainText": "Eternity was in our lips and eyes",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0044",
          "number": 44,
          "speechLineNumber": 5,
          "text": "Bliss in our brows' bent; none our parts so poor",
          "plainText": "Bliss in our brows' bent none our parts so poor",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0045",
          "number": 45,
          "speechLineNumber": 6,
          "text": "But was a race of heaven. They are so still,",
          "plainText": "But was a race of heaven They are so still",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0046",
          "number": 46,
          "speechLineNumber": 7,
          "text": "Or thou, the greatest soldier of the world,",
          "plainText": "Or thou the greatest soldier of the world",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0047",
          "number": 47,
          "speechLineNumber": 8,
          "text": "Art turned the greatest liar.",
          "plainText": "Art turned the greatest liar",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "How now, lady!",
          "plainText": "How now lady",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "I would I had thy inches, thou shouldst know",
          "plainText": "I would I had thy inches thou shouldst know",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "There were a heart in Egypt.",
          "plainText": "There were a heart in Egypt",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Hear me, queen:",
          "plainText": "Hear me queen",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "The strong necessity of time commands",
          "plainText": "The strong necessity of time commands",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "Our services awhile, but my full heart",
          "plainText": "Our services awhile but my full heart",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "Remains in use with you. Our Italy",
          "plainText": "Remains in use with you Our Italy",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0055",
          "number": 55,
          "speechLineNumber": 5,
          "text": "Shines o'er with civil swords; Sextus Pompeius",
          "plainText": "Shines o'er with civil swords Sextus Pompeius",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0056",
          "number": 56,
          "speechLineNumber": 6,
          "text": "Makes his approaches to the port of Rome;",
          "plainText": "Makes his approaches to the port of Rome",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0057",
          "number": 57,
          "speechLineNumber": 7,
          "text": "Equality of two domestic powers",
          "plainText": "Equality of two domestic powers",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0058",
          "number": 58,
          "speechLineNumber": 8,
          "text": "Breed scrupulous faction; the hated, grown to strength,",
          "plainText": "Breed scrupulous faction the hated grown to strength",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0059",
          "number": 59,
          "speechLineNumber": 9,
          "text": "Are newly grown to love; the condemned Pompey,",
          "plainText": "Are newly grown to love the condemned Pompey",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0060",
          "number": 60,
          "speechLineNumber": 10,
          "text": "Rich in his father's honour, creeps apace",
          "plainText": "Rich in his father's honour creeps apace",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0061",
          "number": 61,
          "speechLineNumber": 11,
          "text": "Into the hearts of such as have not thrived",
          "plainText": "Into the hearts of such as have not thrived",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0062",
          "number": 62,
          "speechLineNumber": 12,
          "text": "Upon the present state, whose numbers threaten;",
          "plainText": "Upon the present state whose numbers threaten",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0063",
          "number": 63,
          "speechLineNumber": 13,
          "text": "And quietness, grown sick of rest, would purge",
          "plainText": "And quietness grown sick of rest would purge",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0064",
          "number": 64,
          "speechLineNumber": 14,
          "text": "By any desperate change. My more particular,",
          "plainText": "By any desperate change My more particular",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0065",
          "number": 65,
          "speechLineNumber": 15,
          "text": "And that which most with you should safe my going,",
          "plainText": "And that which most with you should safe my going",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0066",
          "number": 66,
          "speechLineNumber": 16,
          "text": "Is Fulvia's death.",
          "plainText": "Is Fulvia's death",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Though age from folly could not give me freedom,",
          "plainText": "Though age from folly could not give me freedom",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "It does from childishness. Can Fulvia die?",
          "plainText": "It does from childishness Can Fulvia die",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "She's dead, my queen.",
          "plainText": "She's dead my queen",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "Look here, and at thy sovereign leisure read",
          "plainText": "Look here and at thy sovereign leisure read",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0071",
          "number": 71,
          "speechLineNumber": 3,
          "text": "The garboils she awaked; at the last, best,",
          "plainText": "The garboils she awaked at the last best",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0072",
          "number": 72,
          "speechLineNumber": 4,
          "text": "See when and where she died.",
          "plainText": "See when and where she died",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "O most false love!",
          "plainText": "O most false love",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0074",
          "number": 74,
          "speechLineNumber": 2,
          "text": "Where be the sacred vials thou shouldst fill",
          "plainText": "Where be the sacred vials thou shouldst fill",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0075",
          "number": 75,
          "speechLineNumber": 3,
          "text": "With sorrowful water? Now I see, I see,",
          "plainText": "With sorrowful water Now I see I see",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0076",
          "number": 76,
          "speechLineNumber": 4,
          "text": "In Fulvia's death how mine received shall be.",
          "plainText": "In Fulvia's death how mine received shall be",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Quarrel no more, but be prepared to know",
          "plainText": "Quarrel no more but be prepared to know",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "The purposes I bear; which are, or cease,",
          "plainText": "The purposes I bear which are or cease",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0079",
          "number": 79,
          "speechLineNumber": 3,
          "text": "As you shall give th' advice. By the fire",
          "plainText": "As you shall give th' advice By the fire",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0080",
          "number": 80,
          "speechLineNumber": 4,
          "text": "That quickens Nilus' slime, I go from hence",
          "plainText": "That quickens Nilus' slime I go from hence",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0081",
          "number": 81,
          "speechLineNumber": 5,
          "text": "Thy soldier, servant, making peace or war",
          "plainText": "Thy soldier servant making peace or war",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0082",
          "number": 82,
          "speechLineNumber": 6,
          "text": "As thou affects.",
          "plainText": "As thou affects",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "Cut my lace, Charmian, come!",
          "plainText": "Cut my lace Charmian come",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0084",
          "number": 84,
          "speechLineNumber": 2,
          "text": "But let it be; I am quickly ill and well,",
          "plainText": "But let it be I am quickly ill and well",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0085",
          "number": 85,
          "speechLineNumber": 3,
          "text": "So Antony loves.",
          "plainText": "So Antony loves",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "My precious queen, forbear,",
          "plainText": "My precious queen forbear",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0087",
          "number": 87,
          "speechLineNumber": 2,
          "text": "And give true evidence to his love, which stands",
          "plainText": "And give true evidence to his love which stands",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0088",
          "number": 88,
          "speechLineNumber": 3,
          "text": "An honourable trial.",
          "plainText": "An honourable trial",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-031",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "So Fulvia told me.",
          "plainText": "So Fulvia told me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0090",
          "number": 90,
          "speechLineNumber": 2,
          "text": "I prithee, turn aside and weep for her,",
          "plainText": "I prithee turn aside and weep for her",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0091",
          "number": 91,
          "speechLineNumber": 3,
          "text": "Then bid adieu to me, and say the tears",
          "plainText": "Then bid adieu to me and say the tears",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0092",
          "number": 92,
          "speechLineNumber": 4,
          "text": "Belong to Egypt. Good now, play one scene",
          "plainText": "Belong to Egypt Good now play one scene",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0093",
          "number": 93,
          "speechLineNumber": 5,
          "text": "Of excellent dissembling, and let it look",
          "plainText": "Of excellent dissembling and let it look",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0094",
          "number": 94,
          "speechLineNumber": 6,
          "text": "Like perfect honour.",
          "plainText": "Like perfect honour",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-032",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0095",
          "number": 95,
          "speechLineNumber": 1,
          "text": "You'll heat my blood. No more.",
          "plainText": "You'll heat my blood No more",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-033",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0096",
          "number": 96,
          "speechLineNumber": 1,
          "text": "You can do better yet, but this is meetly.",
          "plainText": "You can do better yet but this is meetly",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-034",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0097",
          "number": 97,
          "speechLineNumber": 1,
          "text": "Now, by my sword—",
          "plainText": "Now by my sword",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-035",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0098",
          "number": 98,
          "speechLineNumber": 1,
          "text": "And target. Still he mends.",
          "plainText": "And target Still he mends",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0099",
          "number": 99,
          "speechLineNumber": 2,
          "text": "But this is not the best. Look, prithee, Charmian,",
          "plainText": "But this is not the best Look prithee Charmian",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0100",
          "number": 100,
          "speechLineNumber": 3,
          "text": "How this Herculean Roman does become",
          "plainText": "How this Herculean Roman does become",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0101",
          "number": 101,
          "speechLineNumber": 4,
          "text": "The carriage of his chafe.",
          "plainText": "The carriage of his chafe",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-036",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0102",
          "number": 102,
          "speechLineNumber": 1,
          "text": "I'll leave you, lady.",
          "plainText": "I'll leave you lady",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-037",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0103",
          "number": 103,
          "speechLineNumber": 1,
          "text": "Courteous lord, one word.",
          "plainText": "Courteous lord one word",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0104",
          "number": 104,
          "speechLineNumber": 2,
          "text": "Sir, you and I must part, but that's not it;",
          "plainText": "Sir you and I must part but that's not it",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0105",
          "number": 105,
          "speechLineNumber": 3,
          "text": "Sir, you and I have loved, but there's not it;",
          "plainText": "Sir you and I have loved but there's not it",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0106",
          "number": 106,
          "speechLineNumber": 4,
          "text": "That you know well. Something it is I would—",
          "plainText": "That you know well Something it is I would",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0107",
          "number": 107,
          "speechLineNumber": 5,
          "text": "O, my oblivion is a very Antony,",
          "plainText": "O my oblivion is a very Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0108",
          "number": 108,
          "speechLineNumber": 6,
          "text": "And I am all forgotten.",
          "plainText": "And I am all forgotten",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-038",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0109",
          "number": 109,
          "speechLineNumber": 1,
          "text": "But that your royalty",
          "plainText": "But that your royalty",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0110",
          "number": 110,
          "speechLineNumber": 2,
          "text": "Holds idleness your subject, I should take you",
          "plainText": "Holds idleness your subject I should take you",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0111",
          "number": 111,
          "speechLineNumber": 3,
          "text": "For idleness itself.",
          "plainText": "For idleness itself",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-039",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0112",
          "number": 112,
          "speechLineNumber": 1,
          "text": "'Tis sweating labour",
          "plainText": "'Tis sweating labour",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0113",
          "number": 113,
          "speechLineNumber": 2,
          "text": "To bear such idleness so near the heart",
          "plainText": "To bear such idleness so near the heart",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0114",
          "number": 114,
          "speechLineNumber": 3,
          "text": "As Cleopatra this. But, sir, forgive me,",
          "plainText": "As Cleopatra this But sir forgive me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0115",
          "number": 115,
          "speechLineNumber": 4,
          "text": "Since my becomings kill me when they do not",
          "plainText": "Since my becomings kill me when they do not",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0116",
          "number": 116,
          "speechLineNumber": 5,
          "text": "Eye well to you. Your honour calls you hence;",
          "plainText": "Eye well to you Your honour calls you hence",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0117",
          "number": 117,
          "speechLineNumber": 6,
          "text": "Therefore be deaf to my unpitied folly,",
          "plainText": "Therefore be deaf to my unpitied folly",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0118",
          "number": 118,
          "speechLineNumber": 7,
          "text": "And all the gods go with you! Upon your sword",
          "plainText": "And all the gods go with you Upon your sword",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0119",
          "number": 119,
          "speechLineNumber": 8,
          "text": "Sit laurel victory, and smooth success",
          "plainText": "Sit laurel victory and smooth success",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0120",
          "number": 120,
          "speechLineNumber": 9,
          "text": "Be strewed before your feet!",
          "plainText": "Be strewed before your feet",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-speech-040",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-3-line-0121",
          "number": 121,
          "speechLineNumber": 1,
          "text": "Let us go. Come.",
          "plainText": "Let us go Come",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0122",
          "number": 122,
          "speechLineNumber": 2,
          "text": "Our separation so abides and flies",
          "plainText": "Our separation so abides and flies",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0123",
          "number": 123,
          "speechLineNumber": 3,
          "text": "That thou, residing here, goes yet with me,",
          "plainText": "That thou residing here goes yet with me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0124",
          "number": 124,
          "speechLineNumber": 4,
          "text": "And I, hence fleeting, here remain with thee.",
          "plainText": "And I hence fleeting here remain with thee",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-3-line-0125",
          "number": 125,
          "speechLineNumber": 5,
          "text": "Away!",
          "plainText": "Away",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-3-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}