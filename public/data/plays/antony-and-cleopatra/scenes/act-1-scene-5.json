    "title": "SCENE V. Alexandria. A Room in the Palace.",
    "location": "Alexandria. A Room in the Palace.",
    "orderInPlay": 5
  },
  "content": [
    {
      "id": "antony-and-cleopatra-1-5-stage-001",
      "type": "stage",
      "text": "Enter Cleopatra, Charmian, Iras and Mardian."
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Charmian!",
          "plainText": "Charmian",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Madam?",
          "plainText": "Madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Ha, ha!",
          "plainText": "Ha ha",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Give me to drink mandragora.",
          "plainText": "Give me to drink mandragora",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Why, madam?",
          "plainText": "Why madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "That I might sleep out this great gap of time",
          "plainText": "That I might sleep out this great gap of time",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "My Antony is away.",
          "plainText": "My Antony is away",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "You think of him too much.",
          "plainText": "You think of him too much",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "O, 'tis treason!",
          "plainText": "O 'tis treason",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Madam, I trust not so.",
          "plainText": "Madam I trust not so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Thou, eunuch Mardian!",
          "plainText": "Thou eunuch Mardian",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "mardian",
        "name": "MARDIAN",
        "displayName": "Mardian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "What's your highness' pleasure?",
          "plainText": "What's your highness' pleasure",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Not now to hear thee sing. I take no pleasure",
          "plainText": "Not now to hear thee sing I take no pleasure",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "In aught an eunuch has. 'Tis well for thee",
          "plainText": "In aught an eunuch has 'Tis well for thee",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "That, being unseminared, thy freer thoughts",
          "plainText": "That being unseminared thy freer thoughts",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "May not fly forth of Egypt. Hast thou affections?",
          "plainText": "May not fly forth of Egypt Hast thou affections",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "mardian",
        "name": "MARDIAN",
        "displayName": "Mardian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Yes, gracious madam.",
          "plainText": "Yes gracious madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Indeed?",
          "plainText": "Indeed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "mardian",
        "name": "MARDIAN",
        "displayName": "Mardian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Not in deed, madam, for I can do nothing",
          "plainText": "Not in deed madam for I can do nothing",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "But what indeed is honest to be done.",
          "plainText": "But what indeed is honest to be done",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Yet have I fierce affections, and think",
          "plainText": "Yet have I fierce affections and think",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "What Venus did with Mars.",
          "plainText": "What Venus did with Mars",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "O, Charmian,",
          "plainText": "O Charmian",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Where think'st thou he is now? Stands he, or sits he?",
          "plainText": "Where think'st thou he is now Stands he or sits he",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "Or does he walk? Or is he on his horse?",
          "plainText": "Or does he walk Or is he on his horse",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "O happy horse, to bear the weight of Antony!",
          "plainText": "O happy horse to bear the weight of Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "Do bravely, horse, for wot'st thou whom thou mov'st?",
          "plainText": "Do bravely horse for wot'st thou whom thou mov'st",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0028",
          "number": 28,
          "speechLineNumber": 6,
          "text": "The demi-Atlas of this earth, the arm",
          "plainText": "The demiAtlas of this earth the arm",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0029",
          "number": 29,
          "speechLineNumber": 7,
          "text": "And burgonet of men. He's speaking now,",
          "plainText": "And burgonet of men He's speaking now",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0030",
          "number": 30,
          "speechLineNumber": 8,
          "text": "Or murmuring \"Where's my serpent of old Nile?\"",
          "plainText": "Or murmuring Where's my serpent of old Nile",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0031",
          "number": 31,
          "speechLineNumber": 9,
          "text": "For so he calls me. Now I feed myself",
          "plainText": "For so he calls me Now I feed myself",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0032",
          "number": 32,
          "speechLineNumber": 10,
          "text": "With most delicious poison. Think on me",
          "plainText": "With most delicious poison Think on me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0033",
          "number": 33,
          "speechLineNumber": 11,
          "text": "That am with Phœbus' amorous pinches black,",
          "plainText": "That am with Phbus' amorous pinches black",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0034",
          "number": 34,
          "speechLineNumber": 12,
          "text": "And wrinkled deep in time? Broad-fronted Caesar,",
          "plainText": "And wrinkled deep in time Broadfronted Caesar",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0035",
          "number": 35,
          "speechLineNumber": 13,
          "text": "When thou wast here above the ground, I was",
          "plainText": "When thou wast here above the ground I was",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0036",
          "number": 36,
          "speechLineNumber": 14,
          "text": "A morsel for a monarch. And great Pompey",
          "plainText": "A morsel for a monarch And great Pompey",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0037",
          "number": 37,
          "speechLineNumber": 15,
          "text": "Would stand and make his eyes grow in my brow;",
          "plainText": "Would stand and make his eyes grow in my brow",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0038",
          "number": 38,
          "speechLineNumber": 16,
          "text": "There would he anchor his aspect, and die",
          "plainText": "There would he anchor his aspect and die",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0039",
          "number": 39,
          "speechLineNumber": 17,
          "text": "With looking on his life.",
          "plainText": "With looking on his life",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-stage-002",
      "type": "stage",
      "text": "Enter Alexas."
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "alexas",
        "name": "ALEXAS",
        "displayName": "Alexas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Sovereign of Egypt, hail!",
          "plainText": "Sovereign of Egypt hail",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "How much unlike art thou Mark Antony!",
          "plainText": "How much unlike art thou Mark Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Yet, coming from him, that great medicine hath",
          "plainText": "Yet coming from him that great medicine hath",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "With his tinct gilded thee.",
          "plainText": "With his tinct gilded thee",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "How goes it with my brave Mark Antony?",
          "plainText": "How goes it with my brave Mark Antony",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "alexas",
        "name": "ALEXAS",
        "displayName": "Alexas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Last thing he did, dear queen,",
          "plainText": "Last thing he did dear queen",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "He kissed—the last of many doubled kisses—",
          "plainText": "He kissedthe last of many doubled kisses",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "This orient pearl. His speech sticks in my heart.",
          "plainText": "This orient pearl His speech sticks in my heart",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Mine ear must pluck it thence.",
          "plainText": "Mine ear must pluck it thence",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "alexas",
        "name": "ALEXAS",
        "displayName": "Alexas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "\"Good friend,\" quoth he,",
          "plainText": "Good friend quoth he",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "\"Say, the firm Roman to great Egypt sends",
          "plainText": "Say the firm Roman to great Egypt sends",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "This treasure of an oyster; at whose foot,",
          "plainText": "This treasure of an oyster at whose foot",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "To mend the petty present, I will piece",
          "plainText": "To mend the petty present I will piece",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0053",
          "number": 53,
          "speechLineNumber": 5,
          "text": "Her opulent throne with kingdoms. All the east,",
          "plainText": "Her opulent throne with kingdoms All the east",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0054",
          "number": 54,
          "speechLineNumber": 6,
          "text": "Say thou, shall call her mistress.\" So he nodded",
          "plainText": "Say thou shall call her mistress So he nodded",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0055",
          "number": 55,
          "speechLineNumber": 7,
          "text": "And soberly did mount an arm-gaunt steed,",
          "plainText": "And soberly did mount an armgaunt steed",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0056",
          "number": 56,
          "speechLineNumber": 8,
          "text": "Who neighed so high that what I would have spoke",
          "plainText": "Who neighed so high that what I would have spoke",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0057",
          "number": 57,
          "speechLineNumber": 9,
          "text": "Was beastly dumbed by him.",
          "plainText": "Was beastly dumbed by him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "What, was he sad or merry?",
          "plainText": "What was he sad or merry",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "alexas",
        "name": "ALEXAS",
        "displayName": "Alexas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Like to the time o' th' year between the extremes",
          "plainText": "Like to the time o' th' year between the extremes",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "Of hot and cold, he was nor sad nor merry.",
          "plainText": "Of hot and cold he was nor sad nor merry",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "O well-divided disposition!—Note him,",
          "plainText": "O welldivided dispositionNote him",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "Note him, good Charmian, 'tis the man; but note him:",
          "plainText": "Note him good Charmian 'tis the man but note him",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "He was not sad, for he would shine on those",
          "plainText": "He was not sad for he would shine on those",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0064",
          "number": 64,
          "speechLineNumber": 4,
          "text": "That make their looks by his; he was not merry,",
          "plainText": "That make their looks by his he was not merry",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0065",
          "number": 65,
          "speechLineNumber": 5,
          "text": "Which seemed to tell them his remembrance lay",
          "plainText": "Which seemed to tell them his remembrance lay",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0066",
          "number": 66,
          "speechLineNumber": 6,
          "text": "In Egypt with his joy; but between both.",
          "plainText": "In Egypt with his joy but between both",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0067",
          "number": 67,
          "speechLineNumber": 7,
          "text": "O heavenly mingle!—Be'st thou sad or merry,",
          "plainText": "O heavenly mingleBe'st thou sad or merry",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0068",
          "number": 68,
          "speechLineNumber": 8,
          "text": "The violence of either thee becomes,",
          "plainText": "The violence of either thee becomes",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0069",
          "number": 69,
          "speechLineNumber": 9,
          "text": "So does it no man else.—Met'st thou my posts?",
          "plainText": "So does it no man elseMet'st thou my posts",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "alexas",
        "name": "ALEXAS",
        "displayName": "Alexas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Ay, madam, twenty several messengers.",
          "plainText": "Ay madam twenty several messengers",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "Why do you send so thick?",
          "plainText": "Why do you send so thick",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Who's born that day",
          "plainText": "Who's born that day",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "When I forget to send to Antony",
          "plainText": "When I forget to send to Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0074",
          "number": 74,
          "speechLineNumber": 3,
          "text": "Shall die a beggar.—Ink and paper, Charmian.—",
          "plainText": "Shall die a beggarInk and paper Charmian",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0075",
          "number": 75,
          "speechLineNumber": 4,
          "text": "Welcome, my good Alexas.—Did I, Charmian,",
          "plainText": "Welcome my good AlexasDid I Charmian",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0076",
          "number": 76,
          "speechLineNumber": 5,
          "text": "Ever love Caesar so?",
          "plainText": "Ever love Caesar so",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "O that brave Caesar!",
          "plainText": "O that brave Caesar",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-027",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "Be choked with such another emphasis!",
          "plainText": "Be choked with such another emphasis",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0079",
          "number": 79,
          "speechLineNumber": 2,
          "text": "Say \"the brave Antony.\"",
          "plainText": "Say the brave Antony",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-028",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "The valiant Caesar!",
          "plainText": "The valiant Caesar",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-029",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "By Isis, I will give thee bloody teeth",
          "plainText": "By Isis I will give thee bloody teeth",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0082",
          "number": 82,
          "speechLineNumber": 2,
          "text": "If thou with Caesar paragon again",
          "plainText": "If thou with Caesar paragon again",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0083",
          "number": 83,
          "speechLineNumber": 3,
          "text": "My man of men.",
          "plainText": "My man of men",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-030",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "By your most gracious pardon,",
          "plainText": "By your most gracious pardon",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0085",
          "number": 85,
          "speechLineNumber": 2,
          "text": "I sing but after you.",
          "plainText": "I sing but after you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-speech-031",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-1-5-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "My salad days,",
          "plainText": "My salad days",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0087",
          "number": 87,
          "speechLineNumber": 2,
          "text": "When I was green in judgment, cold in blood,",
          "plainText": "When I was green in judgment cold in blood",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0088",
          "number": 88,
          "speechLineNumber": 3,
          "text": "To say as I said then. But come, away,",
          "plainText": "To say as I said then But come away",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0089",
          "number": 89,
          "speechLineNumber": 4,
          "text": "Get me ink and paper.",
          "plainText": "Get me ink and paper",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0090",
          "number": 90,
          "speechLineNumber": 5,
          "text": "He shall have every day a several greeting,",
          "plainText": "He shall have every day a several greeting",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-1-5-line-0091",
          "number": 91,
          "speechLineNumber": 6,
          "text": "Or I'll unpeople Egypt.",
          "plainText": "Or I'll unpeople Egypt",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-1-5-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}