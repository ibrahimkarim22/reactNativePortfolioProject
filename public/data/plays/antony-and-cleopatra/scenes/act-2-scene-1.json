          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0053",
          "number": 53,
          "speechLineNumber": 4,
          "text": "'Twere pregnant they should square between themselves,",
