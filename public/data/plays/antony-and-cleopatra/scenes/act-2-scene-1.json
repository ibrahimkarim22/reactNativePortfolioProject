          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0054",
          "number": 54,
          "speechLineNumber": 5,
          "text": "For they have entertained cause enough",
