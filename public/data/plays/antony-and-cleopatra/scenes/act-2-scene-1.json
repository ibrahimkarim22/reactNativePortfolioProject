    "orderInPlay": 6
  },
  "content": [
    {
      "id": "antony-and-cleopatra-2-1-stage-001",
      "type": "stage",
      "text": "Enter Pompey, Menecrates and Menas in warlike manner."
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "pompey",
        "name": "POMPEY",
        "displayName": "Pompey"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "If the great gods be just, they shall assist",
          "plainText": "If the great gods be just they shall assist",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The deeds of justest men.",
          "plainText": "The deeds of justest men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "menecrates",
        "name": "MENECRATES",
        "displayName": "Menecrates"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Know, worthy Pompey,",
          "plainText": "Know worthy Pompey",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "That what they do delay they not deny.",
          "plainText": "That what they do delay they not deny",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "pompey",
        "name": "POMPEY",
        "displayName": "Pompey"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Whiles we are suitors to their throne, decays",
          "plainText": "Whiles we are suitors to their throne decays",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "The thing we sue for.",
          "plainText": "The thing we sue for",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "menecrates",
        "name": "MENECRATES",
        "displayName": "Menecrates"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "We, ignorant of ourselves,",
          "plainText": "We ignorant of ourselves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Beg often our own harms, which the wise powers",
          "plainText": "Beg often our own harms which the wise powers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Deny us for our good; so find we profit",
          "plainText": "Deny us for our good so find we profit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "By losing of our prayers.",
          "plainText": "By losing of our prayers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "pompey",
        "name": "POMPEY",
        "displayName": "Pompey"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "I shall do well.",
          "plainText": "I shall do well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "The people love me, and the sea is mine;",
          "plainText": "The people love me and the sea is mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "My powers are crescent, and my auguring hope",
          "plainText": "My powers are crescent and my auguring hope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "Says it will come to th' full. Mark Antony",
          "plainText": "Says it will come to th' full Mark Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "In Egypt sits at dinner, and will make",
          "plainText": "In Egypt sits at dinner and will make",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0016",
          "number": 16,
          "speechLineNumber": 6,
          "text": "No wars without doors. Caesar gets money where",
          "plainText": "No wars without doors Caesar gets money where",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0017",
          "number": 17,
          "speechLineNumber": 7,
          "text": "He loses hearts. Lepidus flatters both,",
          "plainText": "He loses hearts Lepidus flatters both",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0018",
          "number": 18,
          "speechLineNumber": 8,
          "text": "Of both is flattered; but he neither loves",
          "plainText": "Of both is flattered but he neither loves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0019",
          "number": 19,
          "speechLineNumber": 9,
          "text": "Nor either cares for him.",
          "plainText": "Nor either cares for him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "menas",
        "name": "MENAS",
        "displayName": "Menas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Caesar and Lepidus",
          "plainText": "Caesar and Lepidus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Are in the field. A mighty strength they carry.",
          "plainText": "Are in the field A mighty strength they carry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "pompey",
        "name": "POMPEY",
        "displayName": "Pompey"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Where have you this? 'Tis false.",
          "plainText": "Where have you this 'Tis false",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "menas",
        "name": "MENAS",
        "displayName": "Menas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "From Silvius, sir.",
          "plainText": "From Silvius sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "pompey",
        "name": "POMPEY",
        "displayName": "Pompey"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "He dreams. I know they are in Rome together,",
          "plainText": "He dreams I know they are in Rome together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "Looking for Antony. But all the charms of love,",
          "plainText": "Looking for Antony But all the charms of love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "Salt Cleopatra, soften thy waned lip!",
          "plainText": "Salt Cleopatra soften thy waned lip",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "Let witchcraft join with beauty, lust with both;",
          "plainText": "Let witchcraft join with beauty lust with both",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0028",
          "number": 28,
          "speechLineNumber": 5,
          "text": "Tie up the libertine in a field of feasts;",
          "plainText": "Tie up the libertine in a field of feasts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0029",
          "number": 29,
          "speechLineNumber": 6,
          "text": "Keep his brain fuming. Epicurean cooks",
          "plainText": "Keep his brain fuming Epicurean cooks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0030",
          "number": 30,
          "speechLineNumber": 7,
          "text": "Sharpen with cloyless sauce his appetite,",
          "plainText": "Sharpen with cloyless sauce his appetite",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0031",
          "number": 31,
          "speechLineNumber": 8,
          "text": "That sleep and feeding may prorogue his honour",
          "plainText": "That sleep and feeding may prorogue his honour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0032",
          "number": 32,
          "speechLineNumber": 9,
          "text": "Even till a Lethe'd dullness—",
          "plainText": "Even till a Lethe'd dullness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-stage-002",
      "type": "stage",
      "text": "Enter Varrius."
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "varrius",
        "name": "VARRIUS",
        "displayName": "Varrius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "This is most certain that I shall deliver:",
          "plainText": "This is most certain that I shall deliver",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Mark Antony is every hour in Rome",
          "plainText": "Mark Antony is every hour in Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Expected. Since he went from Egypt 'tis",
          "plainText": "Expected Since he went from Egypt 'tis",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "A space for farther travel.",
          "plainText": "A space for farther travel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "pompey",
        "name": "POMPEY",
        "displayName": "Pompey"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "I could have given less matter",
          "plainText": "I could have given less matter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "A better ear.—Menas, I did not think",
          "plainText": "A better earMenas I did not think",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "This amorous surfeiter would have donned his helm",
          "plainText": "This amorous surfeiter would have donned his helm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "For such a petty war. His soldiership",
          "plainText": "For such a petty war His soldiership",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0041",
          "number": 41,
          "speechLineNumber": 5,
          "text": "Is twice the other twain. But let us rear",
          "plainText": "Is twice the other twain But let us rear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0042",
          "number": 42,
          "speechLineNumber": 6,
          "text": "The higher our opinion, that our stirring",
          "plainText": "The higher our opinion that our stirring",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0043",
          "number": 43,
          "speechLineNumber": 7,
          "text": "Can from the lap of Egypt's widow pluck",
          "plainText": "Can from the lap of Egypt's widow pluck",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0044",
          "number": 44,
          "speechLineNumber": 8,
          "text": "The ne'er lust-wearied Antony.",
          "plainText": "The ne'er lustwearied Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "menas",
        "name": "MENAS",
        "displayName": "Menas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "I cannot hope",
          "plainText": "I cannot hope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "Caesar and Antony shall well greet together.",
          "plainText": "Caesar and Antony shall well greet together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "His wife that's dead did trespasses to Caesar;",
          "plainText": "His wife that's dead did trespasses to Caesar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "His brother warred upon him, although I think,",
          "plainText": "His brother warred upon him although I think",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-2-1-line-0049",
          "number": 49,
          "speechLineNumber": 5,
          "text": "Not moved by Antony.",
          "plainText": "Not moved by Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "pompey",
        "name": "POMPEY",
        "displayName": "Pompey"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-1-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "I know not, Menas,",
