  "scene": {
    "id": "antony-and-cleopatra-2-3",
    "act": 2,
    "scene": 3,
    "label": "Act 2, Scene 3",
    "title": "SCENE III. Rome. A Room in Caesar's House.",
    "location": "Rome. A Room in Caesar's House.",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "antony-and-cleopatra-2-3-stage-001",
      "type": "stage",
      "text": "Enter Antony, Caesar, Octavia between them."
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The world and my great office will sometimes",
          "plainText": "The world and my great office will sometimes",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Divide me from your bosom.",
          "plainText": "Divide me from your bosom",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "octavia",
        "name": "OCTAVIA",
        "displayName": "Octavia"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "All which time",
          "plainText": "All which time",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Before the gods my knee shall bow my prayers",
          "plainText": "Before the gods my knee shall bow my prayers",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "To them for you.",
          "plainText": "To them for you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Good night, sir.—My Octavia,",
          "plainText": "Good night sirMy Octavia",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Read not my blemishes in the world's report.",
          "plainText": "Read not my blemishes in the world's report",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "I have not kept my square, but that to come",
          "plainText": "I have not kept my square but that to come",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Shall all be done by th' rule. Good night, dear lady.",
          "plainText": "Shall all be done by th' rule Good night dear lady",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "octavia",
        "name": "OCTAVIA",
        "displayName": "Octavia"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Good night, sir.",
          "plainText": "Good night sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Good night.",
          "plainText": "Good night",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-stage-002",
      "type": "stage",
      "text": "[Exeunt Caesar and Octavia.]"
    },
    {
      "id": "antony-and-cleopatra-2-3-stage-003",
      "type": "stage",
      "text": "Enter Soothsayer."
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Now, sirrah, you do wish yourself in Egypt?",
          "plainText": "Now sirrah you do wish yourself in Egypt",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "soothsayer",
        "name": "SOOTHSAYER",
        "displayName": "Soothsayer"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Would I had never come from thence, nor you thither!",
          "plainText": "Would I had never come from thence nor you thither",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "If you can, your reason.",
          "plainText": "If you can your reason",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "soothsayer",
        "name": "SOOTHSAYER",
        "displayName": "Soothsayer"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "I see it in my motion, have it not in my tongue.",
          "plainText": "I see it in my motion have it not in my tongue",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "But yet hie you to Egypt again.",
          "plainText": "But yet hie you to Egypt again",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Say to me,",
          "plainText": "Say to me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Whose fortunes shall rise higher, Caesar's or mine?",
          "plainText": "Whose fortunes shall rise higher Caesar's or mine",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "soothsayer",
        "name": "SOOTHSAYER",
        "displayName": "Soothsayer"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Caesar's.",
          "plainText": "Caesar's",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Therefore, O Antony, stay not by his side.",
          "plainText": "Therefore O Antony stay not by his side",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Thy dæmon—that thy spirit which keeps thee—is",
          "plainText": "Thy dmonthat thy spirit which keeps theeis",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "Noble, courageous, high, unmatchable,",
          "plainText": "Noble courageous high unmatchable",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "Where Caesar's is not. But near him, thy angel",
          "plainText": "Where Caesar's is not But near him thy angel",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "Becomes afeard, as being o'erpowered. Therefore",
          "plainText": "Becomes afeard as being o'erpowered Therefore",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 7,
          "text": "Make space enough between you.",
          "plainText": "Make space enough between you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Speak this no more.",
          "plainText": "Speak this no more",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "soothsayer",
        "name": "SOOTHSAYER",
        "displayName": "Soothsayer"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "To none but thee; no more but when to thee.",
          "plainText": "To none but thee no more but when to thee",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "If thou dost play with him at any game,",
          "plainText": "If thou dost play with him at any game",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "Thou art sure to lose; and of that natural luck",
          "plainText": "Thou art sure to lose and of that natural luck",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "He beats thee 'gainst the odds. Thy lustre thickens",
          "plainText": "He beats thee 'gainst the odds Thy lustre thickens",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "When he shines by. I say again, thy spirit",
          "plainText": "When he shines by I say again thy spirit",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 6,
          "text": "Is all afraid to govern thee near him;",
          "plainText": "Is all afraid to govern thee near him",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 7,
          "text": "But, he away, 'tis noble.",
          "plainText": "But he away 'tis noble",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Get thee gone.",
          "plainText": "Get thee gone",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-3-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Say to Ventidius I would speak with him.",
          "plainText": "Say to Ventidius I would speak with him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-3-stage-004",
      "type": "stage",
      "text": "[Exit Soothsayer.]"
    },
    {
      "id": "antony-and-cleopatra-2-3-stage-005",
      "type": "stage",
      "text": "Enter Ventidius."
    },
    {
      "id": "antony-and-cleopatra-2-3-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}