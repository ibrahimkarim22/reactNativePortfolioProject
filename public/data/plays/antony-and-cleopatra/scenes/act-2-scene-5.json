  "scene": {
    "id": "antony-and-cleopatra-2-5",
    "act": 2,
    "scene": 5,
    "label": "Act 2, Scene 5",
    "title": "SCENE V. Alexandria. A Room in the Palace.",
    "location": "Alexandria. A Room in the Palace.",
    "orderInPlay": 10
  },
  "content": [
    {
      "id": "antony-and-cleopatra-2-5-stage-001",
      "type": "stage",
      "text": "Enter Cleopatra, Charmian, Iras, Alexas."
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Give me some music—music, moody food",
          "plainText": "Give me some musicmusic moody food",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Of us that trade in love.",
          "plainText": "Of us that trade in love",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "The music, ho!",
          "plainText": "The music ho",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-002",
      "type": "stage",
      "text": "Enter Mardian, the eunuch."
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Let it alone. Let's to billiards. Come, Charmian.",
          "plainText": "Let it alone Let's to billiards Come Charmian",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "My arm is sore. Best play with Mardian.",
          "plainText": "My arm is sore Best play with Mardian",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "As well a woman with an eunuch played",
          "plainText": "As well a woman with an eunuch played",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "As with a woman. Come, you'll play with me, sir?",
          "plainText": "As with a woman Come you'll play with me sir",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "mardian",
        "name": "MARDIAN",
        "displayName": "Mardian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "As well as I can, madam.",
          "plainText": "As well as I can madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "And when good will is showed, though't come too short,",
          "plainText": "And when good will is showed though't come too short",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "The actor may plead pardon. I'll none now.",
          "plainText": "The actor may plead pardon I'll none now",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Give me mine angle; we'll to the river. There,",
          "plainText": "Give me mine angle we'll to the river There",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "My music playing far off, I will betray",
          "plainText": "My music playing far off I will betray",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "Tawny-finned fishes. My bended hook shall pierce",
          "plainText": "Tawnyfinned fishes My bended hook shall pierce",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0014",
          "number": 14,
          "speechLineNumber": 6,
          "text": "Their slimy jaws, and as I draw them up",
          "plainText": "Their slimy jaws and as I draw them up",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0015",
          "number": 15,
          "speechLineNumber": 7,
          "text": "I'll think them every one an Antony,",
          "plainText": "I'll think them every one an Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0016",
          "number": 16,
          "speechLineNumber": 8,
          "text": "And say \"Ah, ha! You're caught.\"",
          "plainText": "And say Ah ha You're caught",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "'Twas merry when",
          "plainText": "'Twas merry when",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "You wagered on your angling; when your diver",
          "plainText": "You wagered on your angling when your diver",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Did hang a salt fish on his hook, which he",
          "plainText": "Did hang a salt fish on his hook which he",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "With fervency drew up.",
          "plainText": "With fervency drew up",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "That time?—O times!—",
          "plainText": "That timeO times",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "I laughed him out of patience; and that night",
          "plainText": "I laughed him out of patience and that night",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "I laughed him into patience, and next morn,",
          "plainText": "I laughed him into patience and next morn",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "Ere the ninth hour, I drunk him to his bed,",
          "plainText": "Ere the ninth hour I drunk him to his bed",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "Then put my tires and mantles on him, whilst",
          "plainText": "Then put my tires and mantles on him whilst",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0026",
          "number": 26,
          "speechLineNumber": 6,
          "text": "I wore his sword Philippan.",
          "plainText": "I wore his sword Philippan",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-003",
      "type": "stage",
      "text": "Enter Messenger."
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Madam, madam—",
          "plainText": "Madam madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Antony's dead! If thou say so, villain,",
          "plainText": "Antony's dead If thou say so villain",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "Thou kill'st thy mistress. But well and free,",
          "plainText": "Thou kill'st thy mistress But well and free",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "If thou so yield him, there is gold, and here",
          "plainText": "If thou so yield him there is gold and here",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0031",
          "number": 31,
          "speechLineNumber": 4,
          "text": "My bluest veins to kiss, a hand that kings",
          "plainText": "My bluest veins to kiss a hand that kings",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0032",
          "number": 32,
          "speechLineNumber": 5,
          "text": "Have lipped, and trembled kissing.",
          "plainText": "Have lipped and trembled kissing",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "First, madam, he's well.",
          "plainText": "First madam he's well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Why, there's more gold.",
          "plainText": "Why there's more gold",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "But sirrah, mark, we use",
          "plainText": "But sirrah mark we use",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "To say the dead are well. Bring it to that,",
          "plainText": "To say the dead are well Bring it to that",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "The gold I give thee will I melt and pour",
          "plainText": "The gold I give thee will I melt and pour",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "Down thy ill-uttering throat.",
          "plainText": "Down thy illuttering throat",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Good madam, hear me.",
          "plainText": "Good madam hear me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Well, go to, I will.",
          "plainText": "Well go to I will",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "But there's no goodness in thy face if Antony",
          "plainText": "But there's no goodness in thy face if Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Be free and healthful. So tart a favour",
          "plainText": "Be free and healthful So tart a favour",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "To trumpet such good tidings! If not well,",
          "plainText": "To trumpet such good tidings If not well",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0044",
          "number": 44,
          "speechLineNumber": 5,
          "text": "Thou shouldst come like a Fury crowned with snakes,",
          "plainText": "Thou shouldst come like a Fury crowned with snakes",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0045",
          "number": 45,
          "speechLineNumber": 6,
          "text": "Not like a formal man.",
          "plainText": "Not like a formal man",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Will't please you hear me?",
          "plainText": "Will't please you hear me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "I have a mind to strike thee ere thou speak'st.",
          "plainText": "I have a mind to strike thee ere thou speak'st",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "Yet if thou say Antony lives, is well,",
          "plainText": "Yet if thou say Antony lives is well",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0049",
          "number": 49,
          "speechLineNumber": 3,
          "text": "Or friends with Caesar, or not captive to him,",
          "plainText": "Or friends with Caesar or not captive to him",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0050",
          "number": 50,
          "speechLineNumber": 4,
          "text": "I'll set thee in a shower of gold and hail",
          "plainText": "I'll set thee in a shower of gold and hail",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0051",
          "number": 51,
          "speechLineNumber": 5,
          "text": "Rich pearls upon thee.",
          "plainText": "Rich pearls upon thee",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Madam, he's well.",
          "plainText": "Madam he's well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Well said.",
          "plainText": "Well said",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "And friends with Caesar.",
          "plainText": "And friends with Caesar",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Th' art an honest man.",
          "plainText": "Th' art an honest man",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Caesar and he are greater friends than ever.",
          "plainText": "Caesar and he are greater friends than ever",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Make thee a fortune from me.",
          "plainText": "Make thee a fortune from me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "But yet, madam—",
          "plainText": "But yet madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "I do not like \"But yet\", it does allay",
          "plainText": "I do not like But yet it does allay",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "The good precedence. Fie upon \"But yet\"!",
          "plainText": "The good precedence Fie upon But yet",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "\"But yet\" is as a gaoler to bring forth",
          "plainText": "But yet is as a gaoler to bring forth",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0062",
          "number": 62,
          "speechLineNumber": 4,
          "text": "Some monstrous malefactor. Prithee, friend,",
          "plainText": "Some monstrous malefactor Prithee friend",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0063",
          "number": 63,
          "speechLineNumber": 5,
          "text": "Pour out the pack of matter to mine ear,",
          "plainText": "Pour out the pack of matter to mine ear",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0064",
          "number": 64,
          "speechLineNumber": 6,
          "text": "The good and bad together: he's friends with Caesar,",
          "plainText": "The good and bad together he's friends with Caesar",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0065",
          "number": 65,
          "speechLineNumber": 7,
          "text": "In state of health, thou say'st; and, thou say'st, free.",
          "plainText": "In state of health thou say'st and thou say'st free",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Free, madam? No. I made no such report.",
          "plainText": "Free madam No I made no such report",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "He's bound unto Octavia.",
          "plainText": "He's bound unto Octavia",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-027",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "For what good turn?",
          "plainText": "For what good turn",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-028",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "For the best turn i' th' bed.",
          "plainText": "For the best turn i' th' bed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-029",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "I am pale, Charmian.",
          "plainText": "I am pale Charmian",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-030",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Madam, he's married to Octavia.",
          "plainText": "Madam he's married to Octavia",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-031",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "The most infectious pestilence upon thee!",
          "plainText": "The most infectious pestilence upon thee",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-004",
      "type": "stage",
      "text": "[Strikes him down.]"
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-032",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Good madam, patience.",
          "plainText": "Good madam patience",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-033",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "What say you?",
          "plainText": "What say you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-005",
      "type": "stage",
      "text": "[Strikes him again.]"
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-006",
      "type": "stage",
      "text": "[She hales him up and down.]"
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-034",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Gracious madam,",
          "plainText": "Gracious madam",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "I that do bring the news made not the match.",
          "plainText": "I that do bring the news made not the match",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-035",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Say 'tis not so, a province I will give thee,",
          "plainText": "Say 'tis not so a province I will give thee",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "And make thy fortunes proud. The blow thou hadst",
          "plainText": "And make thy fortunes proud The blow thou hadst",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0079",
          "number": 79,
          "speechLineNumber": 3,
          "text": "Shall make thy peace for moving me to rage,",
          "plainText": "Shall make thy peace for moving me to rage",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0080",
          "number": 80,
          "speechLineNumber": 4,
          "text": "And I will boot thee with what gift beside",
          "plainText": "And I will boot thee with what gift beside",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0081",
          "number": 81,
          "speechLineNumber": 5,
          "text": "Thy modesty can beg.",
          "plainText": "Thy modesty can beg",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-036",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "He's married, madam.",
          "plainText": "He's married madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-037",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "Rogue, thou hast lived too long.",
          "plainText": "Rogue thou hast lived too long",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-007",
      "type": "stage",
      "text": "[Draws a knife.]"
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-038",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "Nay then I'll run.",
          "plainText": "Nay then I'll run",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0085",
          "number": 85,
          "speechLineNumber": 2,
          "text": "What mean you, madam? I have made no fault.",
          "plainText": "What mean you madam I have made no fault",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-008",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-039",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "Good madam, keep yourself within yourself.",
          "plainText": "Good madam keep yourself within yourself",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0087",
          "number": 87,
          "speechLineNumber": 2,
          "text": "The man is innocent.",
          "plainText": "The man is innocent",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-040",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0088",
          "number": 88,
          "speechLineNumber": 1,
          "text": "Some innocents 'scape not the thunderbolt.",
          "plainText": "Some innocents 'scape not the thunderbolt",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0089",
          "number": 89,
          "speechLineNumber": 2,
          "text": "Melt Egypt into Nile, and kindly creatures",
          "plainText": "Melt Egypt into Nile and kindly creatures",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0090",
          "number": 90,
          "speechLineNumber": 3,
          "text": "Turn all to serpents! Call the slave again.",
          "plainText": "Turn all to serpents Call the slave again",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0091",
          "number": 91,
          "speechLineNumber": 4,
          "text": "Though I am mad, I will not bite him. Call!",
          "plainText": "Though I am mad I will not bite him Call",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-041",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "He is afeard to come.",
          "plainText": "He is afeard to come",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-042",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "I will not hurt him.",
          "plainText": "I will not hurt him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-009",
      "type": "stage",
      "text": "[Exit Charmian.]"
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-010",
      "type": "stage",
      "text": "Enter the Messenger again with Charmian."
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-043",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0094",
          "number": 94,
          "speechLineNumber": 1,
          "text": "I have done my duty.",
          "plainText": "I have done my duty",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-044",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0095",
          "number": 95,
          "speechLineNumber": 1,
          "text": "Is he married?",
          "plainText": "Is he married",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0096",
          "number": 96,
          "speechLineNumber": 2,
          "text": "I cannot hate thee worser than I do",
          "plainText": "I cannot hate thee worser than I do",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0097",
          "number": 97,
          "speechLineNumber": 3,
          "text": "If thou again say \"Yes.\"",
          "plainText": "If thou again say Yes",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-045",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0098",
          "number": 98,
          "speechLineNumber": 1,
          "text": "He's married, madam.",
          "plainText": "He's married madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-046",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0099",
          "number": 99,
          "speechLineNumber": 1,
          "text": "The gods confound thee! Dost thou hold there still!",
          "plainText": "The gods confound thee Dost thou hold there still",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-047",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0100",
          "number": 100,
          "speechLineNumber": 1,
          "text": "Should I lie, madam?",
          "plainText": "Should I lie madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-048",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0101",
          "number": 101,
          "speechLineNumber": 1,
          "text": "O, I would thou didst,",
          "plainText": "O I would thou didst",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0102",
          "number": 102,
          "speechLineNumber": 2,
          "text": "So half my Egypt were submerged and made",
          "plainText": "So half my Egypt were submerged and made",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0103",
          "number": 103,
          "speechLineNumber": 3,
          "text": "A cistern for scaled snakes! Go, get thee hence.",
          "plainText": "A cistern for scaled snakes Go get thee hence",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0104",
          "number": 104,
          "speechLineNumber": 4,
          "text": "Hadst thou Narcissus in thy face, to me",
          "plainText": "Hadst thou Narcissus in thy face to me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0105",
          "number": 105,
          "speechLineNumber": 5,
          "text": "Thou wouldst appear most ugly. He is married?",
          "plainText": "Thou wouldst appear most ugly He is married",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-049",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0106",
          "number": 106,
          "speechLineNumber": 1,
          "text": "I crave your highness' pardon.",
          "plainText": "I crave your highness' pardon",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-050",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0107",
          "number": 107,
          "speechLineNumber": 1,
          "text": "He is married?",
          "plainText": "He is married",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-051",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0108",
          "number": 108,
          "speechLineNumber": 1,
          "text": "Take no offence that I would not offend you.",
          "plainText": "Take no offence that I would not offend you",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0109",
          "number": 109,
          "speechLineNumber": 2,
          "text": "To punish me for what you make me do",
          "plainText": "To punish me for what you make me do",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0110",
          "number": 110,
          "speechLineNumber": 3,
          "text": "Seems much unequal. He's married to Octavia.",
          "plainText": "Seems much unequal He's married to Octavia",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-052",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0111",
          "number": 111,
          "speechLineNumber": 1,
          "text": "O, that his fault should make a knave of thee",
          "plainText": "O that his fault should make a knave of thee",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0112",
          "number": 112,
          "speechLineNumber": 2,
          "text": "That art not what thou'rt sure of! Get thee hence!",
          "plainText": "That art not what thou'rt sure of Get thee hence",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0113",
          "number": 113,
          "speechLineNumber": 3,
          "text": "The merchandise which thou hast brought from Rome",
          "plainText": "The merchandise which thou hast brought from Rome",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0114",
          "number": 114,
          "speechLineNumber": 4,
          "text": "Are all too dear for me. Lie they upon thy hand,",
          "plainText": "Are all too dear for me Lie they upon thy hand",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0115",
          "number": 115,
          "speechLineNumber": 5,
          "text": "And be undone by 'em!",
          "plainText": "And be undone by 'em",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-011",
      "type": "stage",
      "text": "[Exit Messenger.]"
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-053",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0116",
          "number": 116,
          "speechLineNumber": 1,
          "text": "Good your highness, patience.",
          "plainText": "Good your highness patience",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-054",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0117",
          "number": 117,
          "speechLineNumber": 1,
          "text": "In praising Antony I have dispraised Caesar.",
          "plainText": "In praising Antony I have dispraised Caesar",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-055",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0118",
          "number": 118,
          "speechLineNumber": 1,
          "text": "Many times, madam.",
          "plainText": "Many times madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-speech-056",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-2-5-line-0119",
          "number": 119,
          "speechLineNumber": 1,
          "text": "I am paid for't now.",
          "plainText": "I am paid for't now",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0120",
          "number": 120,
          "speechLineNumber": 2,
          "text": "Lead me from hence;",
          "plainText": "Lead me from hence",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0121",
          "number": 121,
          "speechLineNumber": 3,
          "text": "I faint. O Iras, Charmian! 'Tis no matter.",
          "plainText": "I faint O Iras Charmian 'Tis no matter",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0122",
          "number": 122,
          "speechLineNumber": 4,
          "text": "Go to the fellow, good Alexas, bid him",
          "plainText": "Go to the fellow good Alexas bid him",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0123",
          "number": 123,
          "speechLineNumber": 5,
          "text": "Report the feature of Octavia, her years,",
          "plainText": "Report the feature of Octavia her years",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0124",
          "number": 124,
          "speechLineNumber": 6,
          "text": "Her inclination; let him not leave out",
          "plainText": "Her inclination let him not leave out",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-2-5-line-0125",
          "number": 125,
          "speechLineNumber": 7,
          "text": "The colour of her hair. Bring me word quickly.",
          "plainText": "The colour of her hair Bring me word quickly",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-012",
      "type": "stage",
      "text": "[Exit Alexas.]"
    },
    {
      "id": "antony-and-cleopatra-2-5-stage-013",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}