  "scene": {
    "id": "antony-and-cleopatra-3-10",
    "act": 3,
    "scene": 10,
    "label": "Act 3, Scene 10",
    "title": "SCENE X. Another part of the Plain.",
    "location": "Another part of the Plain.",
    "orderInPlay": 22
  },
  "content": [
    {
      "id": "antony-and-cleopatra-3-10-stage-001",
      "type": "stage",
      "text": "Canidius marching with his land army one way over the stage, and Taurus, the Lieutenant of Caesar, with his Army, the other way. After their going in, is heard the noise of a sea fight."
    },
    {
      "id": "antony-and-cleopatra-3-10-stage-002",
      "type": "stage",
      "text": "Alarum. Enter Enobarbus."
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-001",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Naught, naught, all naught! I can behold no longer.",
          "plainText": "Naught naught all naught I can behold no longer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Th' Antoniad, the Egyptian admiral,",
          "plainText": "Th' Antoniad the Egyptian admiral",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "With all their sixty, fly and turn the rudder.",
          "plainText": "With all their sixty fly and turn the rudder",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "To see 't mine eyes are blasted.",
          "plainText": "To see 't mine eyes are blasted",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-stage-003",
      "type": "stage",
      "text": "Enter Scarus."
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-002",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Gods and goddesses,",
          "plainText": "Gods and goddesses",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "All the whole synod of them!",
          "plainText": "All the whole synod of them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-003",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "What's thy passion?",
          "plainText": "What's thy passion",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-004",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "The greater cantle of the world is lost",
          "plainText": "The greater cantle of the world is lost",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "With very ignorance. We have kissed away",
          "plainText": "With very ignorance We have kissed away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Kingdoms and provinces.",
          "plainText": "Kingdoms and provinces",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-005",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "How appears the fight?",
          "plainText": "How appears the fight",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-006",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "On our side, like the tokened pestilence,",
          "plainText": "On our side like the tokened pestilence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Where death is sure. Yon ribaudred nag of Egypt,",
          "plainText": "Where death is sure Yon ribaudred nag of Egypt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Whom leprosy o'ertake, i' th' midst o' th' fight,",
          "plainText": "Whom leprosy o'ertake i' th' midst o' th' fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "When vantage like a pair of twins appeared,",
          "plainText": "When vantage like a pair of twins appeared",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "Both as the same—or, rather, ours the elder—",
          "plainText": "Both as the sameor rather ours the elder",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "The breeze upon her, like a cow in June,",
          "plainText": "The breeze upon her like a cow in June",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0018",
          "number": 18,
          "speechLineNumber": 7,
          "text": "Hoists sails and flies.",
          "plainText": "Hoists sails and flies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-007",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "That I beheld.",
          "plainText": "That I beheld",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Mine eyes did sicken at the sight and could not",
          "plainText": "Mine eyes did sicken at the sight and could not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Endure a further view.",
          "plainText": "Endure a further view",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-008",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "She once being loofed,",
          "plainText": "She once being loofed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "The noble ruin of her magic, Antony,",
          "plainText": "The noble ruin of her magic Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "Claps on his sea-wing and, like a doting mallard,",
          "plainText": "Claps on his seawing and like a doting mallard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Leaving the fight in height, flies after her.",
          "plainText": "Leaving the fight in height flies after her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "I never saw an action of such shame.",
          "plainText": "I never saw an action of such shame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0027",
          "number": 27,
          "speechLineNumber": 6,
          "text": "Experience, manhood, honour, ne'er before",
          "plainText": "Experience manhood honour ne'er before",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0028",
          "number": 28,
          "speechLineNumber": 7,
          "text": "Did violate so itself.",
          "plainText": "Did violate so itself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-009",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Alack, alack!",
          "plainText": "Alack alack",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-stage-004",
      "type": "stage",
      "text": "Enter Canidius."
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-010",
      "type": "speech",
      "speaker": {
        "id": "canidius",
        "name": "CANIDIUS",
        "displayName": "Canidius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Our fortune on the sea is out of breath",
          "plainText": "Our fortune on the sea is out of breath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "And sinks most lamentably. Had our general",
          "plainText": "And sinks most lamentably Had our general",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "Been what he knew himself, it had gone well.",
          "plainText": "Been what he knew himself it had gone well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0033",
          "number": 33,
          "speechLineNumber": 4,
          "text": "O, he has given example for our flight",
          "plainText": "O he has given example for our flight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0034",
          "number": 34,
          "speechLineNumber": 5,
          "text": "Most grossly by his own!",
          "plainText": "Most grossly by his own",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-011",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Ay, are you thereabouts?",
          "plainText": "Ay are you thereabouts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "Why, then, good night indeed.",
          "plainText": "Why then good night indeed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-012",
      "type": "speech",
      "speaker": {
        "id": "canidius",
        "name": "CANIDIUS",
        "displayName": "Canidius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Toward Peloponnesus are they fled.",
          "plainText": "Toward Peloponnesus are they fled",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-013",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "'Tis easy to't, and there I will attend",
          "plainText": "'Tis easy to't and there I will attend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "What further comes.",
          "plainText": "What further comes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-014",
      "type": "speech",
      "speaker": {
        "id": "canidius",
        "name": "CANIDIUS",
        "displayName": "Canidius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "To Caesar will I render",
          "plainText": "To Caesar will I render",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "My legions and my horse. Six kings already",
          "plainText": "My legions and my horse Six kings already",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Show me the way of yielding.",
          "plainText": "Show me the way of yielding",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-speech-015",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-10-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "I'll yet follow",
          "plainText": "I'll yet follow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "The wounded chance of Antony, though my reason",
          "plainText": "The wounded chance of Antony though my reason",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-3-10-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Sits in the wind against me.",
          "plainText": "Sits in the wind against me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-10-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}