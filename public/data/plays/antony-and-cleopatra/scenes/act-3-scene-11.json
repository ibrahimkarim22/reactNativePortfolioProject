  "scene": {
    "id": "antony-and-cleopatra-3-11",
    "act": 3,
    "scene": 11,
    "label": "Act 3, Scene 11",
    "title": "SCENE XI. Alexandria. A Room in the Palace.",
    "location": "Alexandria. A Room in the Palace.",
    "orderInPlay": 23
  },
  "content": [
    {
      "id": "antony-and-cleopatra-3-11-stage-001",
      "type": "stage",
      "text": "Enter Antony with attendants."
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-001",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Hark, the land bids me tread no more upon't.",
          "plainText": "Hark the land bids me tread no more upon't",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "It is ashamed to bear me. Friends, come hither.",
          "plainText": "It is ashamed to bear me Friends come hither",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "I am so lated in the world that I",
          "plainText": "I am so lated in the world that I",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Have lost my way for ever. I have a ship",
          "plainText": "Have lost my way for ever I have a ship",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Laden with gold. Take that, divide it. Fly,",
          "plainText": "Laden with gold Take that divide it Fly",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "And make your peace with Caesar.",
          "plainText": "And make your peace with Caesar",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-002",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Fly? Not we.",
          "plainText": "Fly Not we",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I have fled myself, and have instructed cowards",
          "plainText": "I have fled myself and have instructed cowards",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "To run and show their shoulders. Friends, be gone.",
          "plainText": "To run and show their shoulders Friends be gone",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "I have myself resolved upon a course",
          "plainText": "I have myself resolved upon a course",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Which has no need of you. Be gone.",
          "plainText": "Which has no need of you Be gone",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "My treasure's in the harbour. Take it. O,",
          "plainText": "My treasure's in the harbour Take it O",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "I followed that I blush to look upon.",
          "plainText": "I followed that I blush to look upon",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0014",
          "number": 14,
          "speechLineNumber": 7,
          "text": "My very hairs do mutiny, for the white",
          "plainText": "My very hairs do mutiny for the white",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0015",
          "number": 15,
          "speechLineNumber": 8,
          "text": "Reprove the brown for rashness, and they them",
          "plainText": "Reprove the brown for rashness and they them",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0016",
          "number": 16,
          "speechLineNumber": 9,
          "text": "For fear and doting. Friends, be gone. You shall",
          "plainText": "For fear and doting Friends be gone You shall",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0017",
          "number": 17,
          "speechLineNumber": 10,
          "text": "Have letters from me to some friends that will",
          "plainText": "Have letters from me to some friends that will",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0018",
          "number": 18,
          "speechLineNumber": 11,
          "text": "Sweep your way for you. Pray you, look not sad,",
          "plainText": "Sweep your way for you Pray you look not sad",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0019",
          "number": 19,
          "speechLineNumber": 12,
          "text": "Nor make replies of loathness. Take the hint",
          "plainText": "Nor make replies of loathness Take the hint",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0020",
          "number": 20,
          "speechLineNumber": 13,
          "text": "Which my despair proclaims. Let that be left",
          "plainText": "Which my despair proclaims Let that be left",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0021",
          "number": 21,
          "speechLineNumber": 14,
          "text": "Which leaves itself. To the sea-side straightway.",
          "plainText": "Which leaves itself To the seaside straightway",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0022",
          "number": 22,
          "speechLineNumber": 15,
          "text": "I will possess you of that ship and treasure.",
          "plainText": "I will possess you of that ship and treasure",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0023",
          "number": 23,
          "speechLineNumber": 16,
          "text": "Leave me, I pray, a little—pray you, now,",
          "plainText": "Leave me I pray a littlepray you now",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0024",
          "number": 24,
          "speechLineNumber": 17,
          "text": "Nay, do so; for indeed I have lost command.",
          "plainText": "Nay do so for indeed I have lost command",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0025",
          "number": 25,
          "speechLineNumber": 18,
          "text": "Therefore I pray you. I'll see you by and by.",
          "plainText": "Therefore I pray you I'll see you by and by",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-stage-002",
      "type": "stage",
      "text": "[Sits down.]"
    },
    {
      "id": "antony-and-cleopatra-3-11-stage-003",
      "type": "stage",
      "text": "Enter Cleopatra led by Charmian, Iras and Eros."
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-004",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Nay, gentle madam, to him! Comfort him.",
          "plainText": "Nay gentle madam to him Comfort him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-005",
      "type": "speech",
      "speaker": {
        "id": "iras",
        "name": "IRAS",
        "displayName": "Iras"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Do, most dear queen.",
          "plainText": "Do most dear queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-006",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Do! Why, what else?",
          "plainText": "Do Why what else",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-007",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Let me sit down. O Juno!",
          "plainText": "Let me sit down O Juno",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-008",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "No, no, no, no, no.",
          "plainText": "No no no no no",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-009",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "See you here, sir?",
          "plainText": "See you here sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-010",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "O, fie, fie, fie!",
          "plainText": "O fie fie fie",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-011",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Madam.",
          "plainText": "Madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-012",
      "type": "speech",
      "speaker": {
        "id": "iras",
        "name": "IRAS",
        "displayName": "Iras"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Madam, O good empress!",
          "plainText": "Madam O good empress",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-013",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Sir, sir!",
          "plainText": "Sir sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-014",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Yes, my lord, yes. He at Philippi kept",
          "plainText": "Yes my lord yes He at Philippi kept",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "His sword e'en like a dancer, while I struck",
          "plainText": "His sword e'en like a dancer while I struck",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0038",
          "number": 38,
          "speechLineNumber": 3,
          "text": "The lean and wrinkled Cassius, and 'twas I",
          "plainText": "The lean and wrinkled Cassius and 'twas I",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0039",
          "number": 39,
          "speechLineNumber": 4,
          "text": "That the mad Brutus ended. He alone",
          "plainText": "That the mad Brutus ended He alone",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0040",
          "number": 40,
          "speechLineNumber": 5,
          "text": "Dealt on lieutenantry, and no practice had",
          "plainText": "Dealt on lieutenantry and no practice had",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0041",
          "number": 41,
          "speechLineNumber": 6,
          "text": "In the brave squares of war. Yet now—no matter.",
          "plainText": "In the brave squares of war Yet nowno matter",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Ah, stand by.",
          "plainText": "Ah stand by",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-016",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "The Queen, my lord, the Queen!",
          "plainText": "The Queen my lord the Queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-017",
      "type": "speech",
      "speaker": {
        "id": "iras",
        "name": "IRAS",
        "displayName": "Iras"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Go to him, madam; speak to him.",
          "plainText": "Go to him madam speak to him",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "He is unqualitied with very shame.",
          "plainText": "He is unqualitied with very shame",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-018",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Well then, sustain me. O!",
          "plainText": "Well then sustain me O",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-019",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Most noble sir, arise. The Queen approaches.",
          "plainText": "Most noble sir arise The Queen approaches",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "Her head's declined, and death will seize her but",
          "plainText": "Her head's declined and death will seize her but",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0049",
          "number": 49,
          "speechLineNumber": 3,
          "text": "Your comfort makes the rescue.",
          "plainText": "Your comfort makes the rescue",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-020",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "I have offended reputation,",
          "plainText": "I have offended reputation",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "A most unnoble swerving.",
          "plainText": "A most unnoble swerving",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-021",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Sir, the Queen.",
          "plainText": "Sir the Queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-022",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "O, whither hast thou led me, Egypt? See",
          "plainText": "O whither hast thou led me Egypt See",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "How I convey my shame out of thine eyes",
          "plainText": "How I convey my shame out of thine eyes",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0055",
          "number": 55,
          "speechLineNumber": 3,
          "text": "By looking back what I have left behind",
          "plainText": "By looking back what I have left behind",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0056",
          "number": 56,
          "speechLineNumber": 4,
          "text": "'Stroyed in dishonour.",
          "plainText": "'Stroyed in dishonour",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-023",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "O my lord, my lord,",
          "plainText": "O my lord my lord",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "Forgive my fearful sails! I little thought",
          "plainText": "Forgive my fearful sails I little thought",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0059",
          "number": 59,
          "speechLineNumber": 3,
          "text": "You would have followed.",
          "plainText": "You would have followed",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-024",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Egypt, thou knew'st too well",
          "plainText": "Egypt thou knew'st too well",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "My heart was to thy rudder tied by th' strings,",
          "plainText": "My heart was to thy rudder tied by th' strings",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0062",
          "number": 62,
          "speechLineNumber": 3,
          "text": "And thou shouldst tow me after. O'er my spirit",
          "plainText": "And thou shouldst tow me after O'er my spirit",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0063",
          "number": 63,
          "speechLineNumber": 4,
          "text": "Thy full supremacy thou knew'st, and that",
          "plainText": "Thy full supremacy thou knew'st and that",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0064",
          "number": 64,
          "speechLineNumber": 5,
          "text": "Thy beck might from the bidding of the gods",
          "plainText": "Thy beck might from the bidding of the gods",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0065",
          "number": 65,
          "speechLineNumber": 6,
          "text": "Command me.",
          "plainText": "Command me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-025",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "O, my pardon!",
          "plainText": "O my pardon",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-026",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Now I must",
          "plainText": "Now I must",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "To the young man send humble treaties, dodge",
          "plainText": "To the young man send humble treaties dodge",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0069",
          "number": 69,
          "speechLineNumber": 3,
          "text": "And palter in the shifts of lowness, who",
          "plainText": "And palter in the shifts of lowness who",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0070",
          "number": 70,
          "speechLineNumber": 4,
          "text": "With half the bulk o' th' world played as I pleased,",
          "plainText": "With half the bulk o' th' world played as I pleased",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0071",
          "number": 71,
          "speechLineNumber": 5,
          "text": "Making and marring fortunes. You did know",
          "plainText": "Making and marring fortunes You did know",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0072",
          "number": 72,
          "speechLineNumber": 6,
          "text": "How much you were my conqueror, and that",
          "plainText": "How much you were my conqueror and that",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0073",
          "number": 73,
          "speechLineNumber": 7,
          "text": "My sword, made weak by my affection, would",
          "plainText": "My sword made weak by my affection would",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0074",
          "number": 74,
          "speechLineNumber": 8,
          "text": "Obey it on all cause.",
          "plainText": "Obey it on all cause",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-027",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Pardon, pardon!",
          "plainText": "Pardon pardon",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-speech-028",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-11-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Fall not a tear, I say; one of them rates",
          "plainText": "Fall not a tear I say one of them rates",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0077",
          "number": 77,
          "speechLineNumber": 2,
          "text": "All that is won and lost. Give me a kiss.",
          "plainText": "All that is won and lost Give me a kiss",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0078",
          "number": 78,
          "speechLineNumber": 3,
          "text": "Even this repays me.",
          "plainText": "Even this repays me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0079",
          "number": 79,
          "speechLineNumber": 4,
          "text": "We sent our schoolmaster. Is he come back?",
          "plainText": "We sent our schoolmaster Is he come back",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0080",
          "number": 80,
          "speechLineNumber": 5,
          "text": "Love, I am full of lead. Some wine",
          "plainText": "Love I am full of lead Some wine",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0081",
          "number": 81,
          "speechLineNumber": 6,
          "text": "Within there, and our viands! Fortune knows",
          "plainText": "Within there and our viands Fortune knows",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-11-line-0082",
          "number": 82,
          "speechLineNumber": 7,
          "text": "We scorn her most when most she offers blows.",
          "plainText": "We scorn her most when most she offers blows",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-11-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}