  "scene": {
    "id": "antony-and-cleopatra-3-2",
    "act": 3,
    "scene": 2,
    "label": "Act 3, Scene 2",
    "title": "SCENE II. Rome. An Ante-chamber in Caesar's house.",
    "location": "Rome. An Ante-chamber in Caesar's house.",
    "orderInPlay": 14
  },
  "content": [
    {
      "id": "antony-and-cleopatra-3-2-stage-001",
      "type": "stage",
      "text": "Enter Agrippa at one door, Enobarbus at another."
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "What, are the brothers parted?",
          "plainText": "What are the brothers parted",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "They have dispatched with Pompey; he is gone.",
          "plainText": "They have dispatched with Pompey he is gone",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "The other three are sealing. Octavia weeps",
          "plainText": "The other three are sealing Octavia weeps",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "To part from Rome. Caesar is sad, and Lepidus,",
          "plainText": "To part from Rome Caesar is sad and Lepidus",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "Since Pompey's feast, as Menas says, is troubled",
          "plainText": "Since Pompey's feast as Menas says is troubled",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0006",
          "number": 6,
          "speechLineNumber": 5,
          "text": "With the greensickness.",
          "plainText": "With the greensickness",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "'Tis a noble Lepidus.",
          "plainText": "'Tis a noble Lepidus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "A very fine one. O, how he loves Caesar!",
          "plainText": "A very fine one O how he loves Caesar",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Nay, but how dearly he adores Mark Antony!",
          "plainText": "Nay but how dearly he adores Mark Antony",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Caesar? Why he's the Jupiter of men.",
          "plainText": "Caesar Why he's the Jupiter of men",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "What's Antony? The god of Jupiter.",
          "plainText": "What's Antony The god of Jupiter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Spake you of Caesar? How, the nonpareil!",
          "plainText": "Spake you of Caesar How the nonpareil",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "O, Antony! O thou Arabian bird!",
          "plainText": "O Antony O thou Arabian bird",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Would you praise Caesar, say \"Caesar\". Go no further.",
          "plainText": "Would you praise Caesar say Caesar Go no further",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Indeed, he plied them both with excellent praises.",
          "plainText": "Indeed he plied them both with excellent praises",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "But he loves Caesar best, yet he loves Antony.",
          "plainText": "But he loves Caesar best yet he loves Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Hoo! Hearts, tongues, figures, scribes, bards, poets, cannot",
          "plainText": "Hoo Hearts tongues figures scribes bards poets cannot",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Think, speak, cast, write, sing, number—hoo!—",
          "plainText": "Think speak cast write sing numberhoo",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "His love to Antony. But as for Caesar,",
          "plainText": "His love to Antony But as for Caesar",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "Kneel down, kneel down, and wonder.",
          "plainText": "Kneel down kneel down and wonder",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Both he loves.",
          "plainText": "Both he loves",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "They are his shards, and he their beetle.",
          "plainText": "They are his shards and he their beetle",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-stage-002",
      "type": "stage",
      "text": "[Trumpets within.]"
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Good fortune, worthy soldier, and farewell.",
          "plainText": "Good fortune worthy soldier and farewell",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-stage-003",
      "type": "stage",
      "text": "Enter Caesar, Antony, Lepidus and Octavia."
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "No further, sir.",
          "plainText": "No further sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "You take from me a great part of myself.",
          "plainText": "You take from me a great part of myself",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Use me well in't. Sister, prove such a wife",
          "plainText": "Use me well in't Sister prove such a wife",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "As my thoughts make thee, and as my farthest bond",
          "plainText": "As my thoughts make thee and as my farthest bond",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "Shall pass on thy approof. Most noble Antony,",
          "plainText": "Shall pass on thy approof Most noble Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "Let not the piece of virtue which is set",
          "plainText": "Let not the piece of virtue which is set",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "Betwixt us, as the cement of our love",
          "plainText": "Betwixt us as the cement of our love",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0031",
          "number": 31,
          "speechLineNumber": 7,
          "text": "To keep it builded, be the ram to batter",
          "plainText": "To keep it builded be the ram to batter",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0032",
          "number": 32,
          "speechLineNumber": 8,
          "text": "The fortress of it. For better might we",
          "plainText": "The fortress of it For better might we",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0033",
          "number": 33,
          "speechLineNumber": 9,
          "text": "Have loved without this mean, if on both parts",
          "plainText": "Have loved without this mean if on both parts",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0034",
          "number": 34,
          "speechLineNumber": 10,
          "text": "This be not cherished.",
          "plainText": "This be not cherished",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Make me not offended",
          "plainText": "Make me not offended",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "In your distrust.",
          "plainText": "In your distrust",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "I have said.",
          "plainText": "I have said",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "You shall not find,",
          "plainText": "You shall not find",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "Though you be therein curious, the least cause",
          "plainText": "Though you be therein curious the least cause",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "For what you seem to fear. So the gods keep you,",
          "plainText": "For what you seem to fear So the gods keep you",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0041",
          "number": 41,
          "speechLineNumber": 4,
          "text": "And make the hearts of Romans serve your ends.",
          "plainText": "And make the hearts of Romans serve your ends",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0042",
          "number": 42,
          "speechLineNumber": 5,
          "text": "We will here part.",
          "plainText": "We will here part",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Farewell, my dearest sister, fare thee well.",
          "plainText": "Farewell my dearest sister fare thee well",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "The elements be kind to thee, and make",
          "plainText": "The elements be kind to thee and make",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Thy spirits all of comfort! Fare thee well.",
          "plainText": "Thy spirits all of comfort Fare thee well",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "octavia",
        "name": "OCTAVIA",
        "displayName": "Octavia"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "My noble brother!",
          "plainText": "My noble brother",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "The April's in her eyes. It is love's spring,",
          "plainText": "The April's in her eyes It is love's spring",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "And these the showers to bring it on.—Be cheerful.",
          "plainText": "And these the showers to bring it onBe cheerful",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "octavia",
        "name": "OCTAVIA",
        "displayName": "Octavia"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Sir, look well to my husband's house, and—",
          "plainText": "Sir look well to my husband's house and",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "What, Octavia?",
          "plainText": "What Octavia",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "octavia",
        "name": "OCTAVIA",
        "displayName": "Octavia"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "I'll tell you in your ear.",
          "plainText": "I'll tell you in your ear",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Her tongue will not obey her heart, nor can",
          "plainText": "Her tongue will not obey her heart nor can",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Her heart inform her tongue—the swan's-down feather,",
          "plainText": "Her heart inform her tonguethe swan'sdown feather",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "That stands upon the swell at the full of tide,",
          "plainText": "That stands upon the swell at the full of tide",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0055",
          "number": 55,
          "speechLineNumber": 4,
          "text": "And neither way inclines.",
          "plainText": "And neither way inclines",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "[Aside to Agrippa.] Will Caesar weep?",
          "plainText": "Aside to Agrippa Will Caesar weep",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "[Aside to Enobarbus.] He has a cloud in 's face.",
          "plainText": "Aside to Enobarbus He has a cloud in 's face",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "[Aside to Agrippa.] He were the worse for that were he a horse;",
          "plainText": "Aside to Agrippa He were the worse for that were he a horse",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "So is he, being a man.",
          "plainText": "So is he being a man",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "[Aside to Enobarbus.] Why, Enobarbus,",
          "plainText": "Aside to Enobarbus Why Enobarbus",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "When Antony found Julius Caesar dead,",
          "plainText": "When Antony found Julius Caesar dead",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0062",
          "number": 62,
          "speechLineNumber": 3,
          "text": "He cried almost to roaring, and he wept",
          "plainText": "He cried almost to roaring and he wept",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0063",
          "number": 63,
          "speechLineNumber": 4,
          "text": "When at Philippi he found Brutus slain.",
          "plainText": "When at Philippi he found Brutus slain",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "[Aside to Agrippa.] That year, indeed, he was troubled with a rheum;",
          "plainText": "Aside to Agrippa That year indeed he was troubled with a rheum",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "What willingly he did confound he wailed,",
          "plainText": "What willingly he did confound he wailed",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "Believe 't, till I weep too.",
          "plainText": "Believe 't till I weep too",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-033",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "No, sweet Octavia,",
          "plainText": "No sweet Octavia",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "You shall hear from me still. The time shall not",
          "plainText": "You shall hear from me still The time shall not",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0069",
          "number": 69,
          "speechLineNumber": 3,
          "text": "Outgo my thinking on you.",
          "plainText": "Outgo my thinking on you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-034",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Come, sir, come,",
          "plainText": "Come sir come",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "I'll wrestle with you in my strength of love.",
          "plainText": "I'll wrestle with you in my strength of love",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0072",
          "number": 72,
          "speechLineNumber": 3,
          "text": "Look, here I have you, thus I let you go,",
          "plainText": "Look here I have you thus I let you go",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0073",
          "number": 73,
          "speechLineNumber": 4,
          "text": "And give you to the gods.",
          "plainText": "And give you to the gods",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-035",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Adieu, be happy!",
          "plainText": "Adieu be happy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-036",
      "type": "speech",
      "speaker": {
        "id": "lepidus",
        "name": "LEPIDUS",
        "displayName": "Lepidus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Let all the number of the stars give light",
          "plainText": "Let all the number of the stars give light",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-2-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "To thy fair way!",
          "plainText": "To thy fair way",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-037",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Farewell, farewell!",
          "plainText": "Farewell farewell",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-stage-004",
      "type": "stage",
      "text": "[Kisses Octavia.]"
    },
    {
      "id": "antony-and-cleopatra-3-2-speech-038",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-2-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "Farewell!",
          "plainText": "Farewell",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-2-stage-005",
      "type": "stage",
      "text": "[Trumpets sound. Exeunt.]"
    }
  ]
}