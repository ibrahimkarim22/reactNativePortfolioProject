  "scene": {
    "id": "antony-and-cleopatra-3-3",
    "act": 3,
    "scene": 3,
    "label": "Act 3, Scene 3",
    "title": "SCENE III. Alexandria. A Room in the Palace.",
    "location": "Alexandria. A Room in the Palace.",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "antony-and-cleopatra-3-3-stage-001",
      "type": "stage",
      "text": "Enter Cleopatra, Charmian, Iras and Alexas."
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Where is the fellow?",
          "plainText": "Where is the fellow",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "alexas",
        "name": "ALEXAS",
        "displayName": "Alexas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Half afeared to come.",
          "plainText": "Half afeared to come",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Go to, go to.",
          "plainText": "Go to go to",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-stage-002",
      "type": "stage",
      "text": "Enter a Messenger as before."
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "alexas",
        "name": "ALEXAS",
        "displayName": "Alexas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Good majesty,",
          "plainText": "Good majesty",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Herod of Jewry dare not look upon you",
          "plainText": "Herod of Jewry dare not look upon you",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "But when you are well pleased.",
          "plainText": "But when you are well pleased",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "That Herod's head",
          "plainText": "That Herod's head",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "I'll have! But how, when Antony is gone,",
          "plainText": "I'll have But how when Antony is gone",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Through whom I might command it?—Come thou near.",
          "plainText": "Through whom I might command itCome thou near",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Most gracious majesty!",
          "plainText": "Most gracious majesty",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Didst thou behold Octavia?",
          "plainText": "Didst thou behold Octavia",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Ay, dread queen.",
          "plainText": "Ay dread queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Where?",
          "plainText": "Where",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Madam, in Rome",
          "plainText": "Madam in Rome",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "I looked her in the face, and saw her led",
          "plainText": "I looked her in the face and saw her led",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "Between her brother and Mark Antony.",
          "plainText": "Between her brother and Mark Antony",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Is she as tall as me?",
          "plainText": "Is she as tall as me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "She is not, madam.",
          "plainText": "She is not madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Didst hear her speak? Is she shrill-tongued or low?",
          "plainText": "Didst hear her speak Is she shrilltongued or low",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Madam, I heard her speak. She is low-voiced.",
          "plainText": "Madam I heard her speak She is lowvoiced",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "That's not so good. He cannot like her long.",
          "plainText": "That's not so good He cannot like her long",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Like her? O Isis! 'Tis impossible.",
          "plainText": "Like her O Isis 'Tis impossible",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "I think so, Charmian: dull of tongue and dwarfish!",
          "plainText": "I think so Charmian dull of tongue and dwarfish",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "What majesty is in her gait? Remember,",
          "plainText": "What majesty is in her gait Remember",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "If e'er thou look'dst on majesty.",
          "plainText": "If e'er thou look'dst on majesty",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "She creeps.",
          "plainText": "She creeps",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "Her motion and her station are as one.",
          "plainText": "Her motion and her station are as one",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "She shows a body rather than a life,",
          "plainText": "She shows a body rather than a life",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "A statue than a breather.",
          "plainText": "A statue than a breather",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Is this certain?",
          "plainText": "Is this certain",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Or I have no observance.",
          "plainText": "Or I have no observance",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Three in Egypt",
          "plainText": "Three in Egypt",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Cannot make better note.",
          "plainText": "Cannot make better note",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "He's very knowing;",
          "plainText": "He's very knowing",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "I do perceive't. There's nothing in her yet.",
          "plainText": "I do perceive't There's nothing in her yet",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "The fellow has good judgment.",
          "plainText": "The fellow has good judgment",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Excellent.",
          "plainText": "Excellent",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Guess at her years, I prithee.",
          "plainText": "Guess at her years I prithee",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Madam,",
          "plainText": "Madam",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "She was a widow.",
          "plainText": "She was a widow",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Widow! Charmian, hark!",
          "plainText": "Widow Charmian hark",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "And I do think she's thirty.",
          "plainText": "And I do think she's thirty",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Bear'st thou her face in mind? Is't long or round?",
          "plainText": "Bear'st thou her face in mind Is't long or round",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Round even to faultiness.",
          "plainText": "Round even to faultiness",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "For the most part, too, they are foolish that are so.",
          "plainText": "For the most part too they are foolish that are so",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "Her hair, what colour?",
          "plainText": "Her hair what colour",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-031",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Brown, madam, and her forehead",
          "plainText": "Brown madam and her forehead",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "As low as she would wish it.",
          "plainText": "As low as she would wish it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-032",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "There's gold for thee.",
          "plainText": "There's gold for thee",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Thou must not take my former sharpness ill.",
          "plainText": "Thou must not take my former sharpness ill",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "I will employ thee back again; I find thee",
          "plainText": "I will employ thee back again I find thee",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "Most fit for business. Go make thee ready;",
          "plainText": "Most fit for business Go make thee ready",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0053",
          "number": 53,
          "speechLineNumber": 5,
          "text": "Our letters are prepared.",
          "plainText": "Our letters are prepared",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-stage-003",
      "type": "stage",
      "text": "[Exit Messenger.]"
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-033",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "A proper man.",
          "plainText": "A proper man",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-034",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Indeed, he is so. I repent me much",
          "plainText": "Indeed he is so I repent me much",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "That so I harried him. Why, methinks, by him,",
          "plainText": "That so I harried him Why methinks by him",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "This creature's no such thing.",
          "plainText": "This creature's no such thing",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-035",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Nothing, madam.",
          "plainText": "Nothing madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-036",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "The man hath seen some majesty, and should know.",
          "plainText": "The man hath seen some majesty and should know",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-037",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Hath he seen majesty? Isis else defend,",
          "plainText": "Hath he seen majesty Isis else defend",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "And serving you so long!",
          "plainText": "And serving you so long",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-038",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "I have one thing more to ask him yet, good Charmian.",
          "plainText": "I have one thing more to ask him yet good Charmian",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "But 'tis no matter; thou shalt bring him to me",
          "plainText": "But 'tis no matter thou shalt bring him to me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-3-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "Where I will write. All may be well enough.",
          "plainText": "Where I will write All may be well enough",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-speech-039",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-3-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "I warrant you, madam.",
          "plainText": "I warrant you madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-3-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}