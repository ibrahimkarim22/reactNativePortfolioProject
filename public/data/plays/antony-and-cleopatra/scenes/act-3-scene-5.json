    "label": "Act 3, Scene 5",
    "title": "SCENE V. Athens. Another Room in Antony's House.",
    "location": "Athens. Another Room in Antony's House.",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "antony-and-cleopatra-3-5-stage-001",
      "type": "stage",
      "text": "Enter Enobarbus and Eros meeting."
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "How now, friend Eros?",
          "plainText": "How now friend Eros",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "There's strange news come, sir.",
          "plainText": "There's strange news come sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "What, man?",
          "plainText": "What man",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Caesar and Lepidus have made wars upon Pompey.",
          "plainText": "Caesar and Lepidus have made wars upon Pompey",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "This is old. What is the success?",
          "plainText": "This is old What is the success",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Caesar, having made use of him in the wars 'gainst Pompey, presently denied him rivality; would not let him partake in the glory of the action, and, not resting here, accuses him of letters he had formerly wrote to Pompey; upon his own appeal, seizes him. So the poor third is up, till death enlarge his confine.",
          "plainText": "Caesar having made use of him in the wars 'gainst Pompey presently denied him rivality would not let him partake in the glory of the action and not resting here accuses him of letters he had formerly wrote to Pompey upon his own appeal seizes him So the poor third is up till death enlarge his confine",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Then, world, thou hast a pair of chaps, no more,",
          "plainText": "Then world thou hast a pair of chaps no more",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-5-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "And throw between them all the food thou hast,",
          "plainText": "And throw between them all the food thou hast",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-5-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "They'll grind the one the other. Where's Antony?",
          "plainText": "They'll grind the one the other Where's Antony",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "He's walking in the garden, thus, and spurns",
          "plainText": "He's walking in the garden thus and spurns",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-5-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "The rush that lies before him; cries \"Fool Lepidus!\"",
          "plainText": "The rush that lies before him cries Fool Lepidus",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-5-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "And threats the throat of that his officer",
          "plainText": "And threats the throat of that his officer",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-5-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "That murdered Pompey.",
          "plainText": "That murdered Pompey",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Our great navy's rigged.",
          "plainText": "Our great navy's rigged",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "For Italy and Caesar. More, Domitius:",
          "plainText": "For Italy and Caesar More Domitius",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-5-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "My lord desires you presently. My news",
          "plainText": "My lord desires you presently My news",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-5-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "I might have told hereafter.",
          "plainText": "I might have told hereafter",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "'Twill be naught,",
          "plainText": "'Twill be naught",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-5-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "But let it be. Bring me to Antony.",
          "plainText": "But let it be Bring me to Antony",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-5-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Come, sir.",
          "plainText": "Come sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-5-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}