  "scene": {
    "id": "antony-and-cleopatra-3-7",
    "act": 3,
    "scene": 7,
    "label": "Act 3, Scene 7",
    "title": "SCENE VII. Antony's Camp near the Promontory of Actium.",
    "location": "Antony's Camp near the Promontory of Actium.",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "antony-and-cleopatra-3-7-stage-001",
      "type": "stage",
      "text": "Enter Cleopatra and Enobarbus."
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I will be even with thee, doubt it not.",
          "plainText": "I will be even with thee doubt it not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "But why, why, why?",
          "plainText": "But why why why",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Thou hast forspoke my being in these wars",
          "plainText": "Thou hast forspoke my being in these wars",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "And say'st it is not fit.",
          "plainText": "And say'st it is not fit",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-004",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Well, is it, is it?",
          "plainText": "Well is it is it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Is 't not denounced against us? Why should not we",
          "plainText": "Is 't not denounced against us Why should not we",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Be there in person?",
          "plainText": "Be there in person",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-006",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Well, I could reply:",
          "plainText": "Well I could reply",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "If we should serve with horse and mares together,",
          "plainText": "If we should serve with horse and mares together",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "The horse were merely lost. The mares would bear",
          "plainText": "The horse were merely lost The mares would bear",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "A soldier and his horse.",
          "plainText": "A soldier and his horse",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-007",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "What is't you say?",
          "plainText": "What is't you say",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-008",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Your presence needs must puzzle Antony,",
          "plainText": "Your presence needs must puzzle Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Take from his heart, take from his brain, from 's time,",
          "plainText": "Take from his heart take from his brain from 's time",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "What should not then be spared. He is already",
          "plainText": "What should not then be spared He is already",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "Traduced for levity, and 'tis said in Rome",
          "plainText": "Traduced for levity and 'tis said in Rome",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0017",
          "number": 17,
          "speechLineNumber": 5,
          "text": "That Photinus, an eunuch, and your maids",
          "plainText": "That Photinus an eunuch and your maids",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0018",
          "number": 18,
          "speechLineNumber": 6,
          "text": "Manage this war.",
          "plainText": "Manage this war",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Sink Rome, and their tongues rot",
          "plainText": "Sink Rome and their tongues rot",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "That speak against us! A charge we bear i' th' war,",
          "plainText": "That speak against us A charge we bear i' th' war",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "And, as the president of my kingdom, will",
          "plainText": "And as the president of my kingdom will",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "Appear there for a man. Speak not against it.",
          "plainText": "Appear there for a man Speak not against it",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "I will not stay behind.",
          "plainText": "I will not stay behind",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-stage-002",
      "type": "stage",
      "text": "Enter Antony and Canidius."
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-010",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Nay, I have done.",
          "plainText": "Nay I have done",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "Here comes the Emperor.",
          "plainText": "Here comes the Emperor",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-011",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Is it not strange, Canidius,",
          "plainText": "Is it not strange Canidius",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "That from Tarentum and Brundusium",
          "plainText": "That from Tarentum and Brundusium",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "He could so quickly cut the Ionian sea",
          "plainText": "He could so quickly cut the Ionian sea",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "And take in Toryne?—You have heard on 't, sweet?",
          "plainText": "And take in ToryneYou have heard on 't sweet",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-012",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Celerity is never more admired",
          "plainText": "Celerity is never more admired",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "Than by the negligent.",
          "plainText": "Than by the negligent",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-013",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "A good rebuke,",
          "plainText": "A good rebuke",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Which might have well becomed the best of men",
          "plainText": "Which might have well becomed the best of men",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "To taunt at slackness.—Canidius, we",
          "plainText": "To taunt at slacknessCanidius we",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "Will fight with him by sea.",
          "plainText": "Will fight with him by sea",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-014",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "By sea, what else?",
          "plainText": "By sea what else",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-015",
      "type": "speech",
      "speaker": {
        "id": "canidius",
        "name": "CANIDIUS",
        "displayName": "Canidius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Why will my lord do so?",
          "plainText": "Why will my lord do so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-016",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "For that he dares us to 't.",
          "plainText": "For that he dares us to 't",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-017",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "So hath my lord dared him to single fight.",
          "plainText": "So hath my lord dared him to single fight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-018",
      "type": "speech",
      "speaker": {
        "id": "canidius",
        "name": "CANIDIUS",
        "displayName": "Canidius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Ay, and to wage this battle at Pharsalia,",
          "plainText": "Ay and to wage this battle at Pharsalia",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Where Caesar fought with Pompey. But these offers,",
          "plainText": "Where Caesar fought with Pompey But these offers",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Which serve not for his vantage, he shakes off,",
          "plainText": "Which serve not for his vantage he shakes off",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "And so should you.",
          "plainText": "And so should you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-019",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Your ships are not well manned,",
          "plainText": "Your ships are not well manned",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "Your mariners are muleteers, reapers, people",
          "plainText": "Your mariners are muleteers reapers people",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "Engrossed by swift impress. In Caesar's fleet",
          "plainText": "Engrossed by swift impress In Caesar's fleet",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "Are those that often have 'gainst Pompey fought.",
          "plainText": "Are those that often have 'gainst Pompey fought",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0048",
          "number": 48,
          "speechLineNumber": 5,
          "text": "Their ships are yare, yours heavy. No disgrace",
          "plainText": "Their ships are yare yours heavy No disgrace",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0049",
          "number": 49,
          "speechLineNumber": 6,
          "text": "Shall fall you for refusing him at sea,",
          "plainText": "Shall fall you for refusing him at sea",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0050",
          "number": 50,
          "speechLineNumber": 7,
          "text": "Being prepared for land.",
          "plainText": "Being prepared for land",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-020",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "By sea, by sea.",
          "plainText": "By sea by sea",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-021",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Most worthy sir, you therein throw away",
          "plainText": "Most worthy sir you therein throw away",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "The absolute soldiership you have by land;",
          "plainText": "The absolute soldiership you have by land",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "Distract your army, which doth most consist",
          "plainText": "Distract your army which doth most consist",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0055",
          "number": 55,
          "speechLineNumber": 4,
          "text": "Of war-marked footmen; leave unexecuted",
          "plainText": "Of warmarked footmen leave unexecuted",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0056",
          "number": 56,
          "speechLineNumber": 5,
          "text": "Your own renowned knowledge; quite forgo",
          "plainText": "Your own renowned knowledge quite forgo",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0057",
          "number": 57,
          "speechLineNumber": 6,
          "text": "The way which promises assurance; and",
          "plainText": "The way which promises assurance and",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0058",
          "number": 58,
          "speechLineNumber": 7,
          "text": "Give up yourself merely to chance and hazard",
          "plainText": "Give up yourself merely to chance and hazard",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0059",
          "number": 59,
          "speechLineNumber": 8,
          "text": "From firm security.",
          "plainText": "From firm security",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-022",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "I'll fight at sea.",
          "plainText": "I'll fight at sea",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-023",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "I have sixty sails, Caesar none better.",
          "plainText": "I have sixty sails Caesar none better",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-024",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Our overplus of shipping will we burn,",
          "plainText": "Our overplus of shipping will we burn",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "And with the rest full-manned, from th' head of Actium",
          "plainText": "And with the rest fullmanned from th' head of Actium",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "Beat th' approaching Caesar. But if we fail,",
          "plainText": "Beat th' approaching Caesar But if we fail",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "We then can do 't at land.",
          "plainText": "We then can do 't at land",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-stage-003",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-025",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "The news is true, my lord; he is descried.",
          "plainText": "The news is true my lord he is descried",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "Caesar has taken Toryne.",
          "plainText": "Caesar has taken Toryne",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-026",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Can he be there in person? 'Tis impossible;",
          "plainText": "Can he be there in person 'Tis impossible",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "Strange that his power should be. Canidius,",
          "plainText": "Strange that his power should be Canidius",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0070",
          "number": 70,
          "speechLineNumber": 3,
          "text": "Our nineteen legions thou shalt hold by land,",
          "plainText": "Our nineteen legions thou shalt hold by land",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0071",
          "number": 71,
          "speechLineNumber": 4,
          "text": "And our twelve thousand horse. We'll to our ship.",
          "plainText": "And our twelve thousand horse We'll to our ship",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0072",
          "number": 72,
          "speechLineNumber": 5,
          "text": "Away, my Thetis!",
          "plainText": "Away my Thetis",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-stage-004",
      "type": "stage",
      "text": "Enter a Soldier."
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-027",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "O noble emperor, do not fight by sea.",
          "plainText": "O noble emperor do not fight by sea",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0074",
          "number": 74,
          "speechLineNumber": 2,
          "text": "Trust not to rotten planks. Do you misdoubt",
          "plainText": "Trust not to rotten planks Do you misdoubt",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0075",
          "number": 75,
          "speechLineNumber": 3,
          "text": "This sword and these my wounds? Let th' Egyptians",
          "plainText": "This sword and these my wounds Let th' Egyptians",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0076",
          "number": 76,
          "speechLineNumber": 4,
          "text": "And the Phoenicians go a-ducking. We",
          "plainText": "And the Phoenicians go aducking We",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0077",
          "number": 77,
          "speechLineNumber": 5,
          "text": "Have used to conquer standing on the earth",
          "plainText": "Have used to conquer standing on the earth",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0078",
          "number": 78,
          "speechLineNumber": 6,
          "text": "And fighting foot to foot.",
          "plainText": "And fighting foot to foot",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-028",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Well, well, away.",
          "plainText": "Well well away",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-stage-005",
      "type": "stage",
      "text": "[Exeunt Antony, Cleopatra and Enobarbus.]"
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-029",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "By Hercules, I think I am i' th' right.",
          "plainText": "By Hercules I think I am i' th' right",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-030",
      "type": "speech",
      "speaker": {
        "id": "canidius",
        "name": "CANIDIUS",
        "displayName": "Canidius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "Soldier, thou art. But his whole action grows",
          "plainText": "Soldier thou art But his whole action grows",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0082",
          "number": 82,
          "speechLineNumber": 2,
          "text": "Not in the power on 't. So our leader's led,",
          "plainText": "Not in the power on 't So our leader's led",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0083",
          "number": 83,
          "speechLineNumber": 3,
          "text": "And we are women's men.",
          "plainText": "And we are women's men",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-031",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "You keep by land",
          "plainText": "You keep by land",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0085",
          "number": 85,
          "speechLineNumber": 2,
          "text": "The legions and the horse whole, do you not?",
          "plainText": "The legions and the horse whole do you not",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-032",
      "type": "speech",
      "speaker": {
        "id": "canidius",
        "name": "CANIDIUS",
        "displayName": "Canidius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "Marcus Octavius, Marcus Justeius,",
          "plainText": "Marcus Octavius Marcus Justeius",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0087",
          "number": 87,
          "speechLineNumber": 2,
          "text": "Publicola, and Caelius are for sea,",
          "plainText": "Publicola and Caelius are for sea",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0088",
          "number": 88,
          "speechLineNumber": 3,
          "text": "But we keep whole by land. This speed of Caesar's",
          "plainText": "But we keep whole by land This speed of Caesar's",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0089",
          "number": 89,
          "speechLineNumber": 4,
          "text": "Carries beyond belief.",
          "plainText": "Carries beyond belief",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-033",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0090",
          "number": 90,
          "speechLineNumber": 1,
          "text": "While he was yet in Rome,",
          "plainText": "While he was yet in Rome",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0091",
          "number": 91,
          "speechLineNumber": 2,
          "text": "His power went out in such distractions as",
          "plainText": "His power went out in such distractions as",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0092",
          "number": 92,
          "speechLineNumber": 3,
          "text": "Beguiled all spies.",
          "plainText": "Beguiled all spies",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-034",
      "type": "speech",
      "speaker": {
        "id": "canidius",
        "name": "CANIDIUS",
        "displayName": "Canidius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "Who's his lieutenant, hear you?",
          "plainText": "Who's his lieutenant hear you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-035",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0094",
          "number": 94,
          "speechLineNumber": 1,
          "text": "They say one Taurus.",
          "plainText": "They say one Taurus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-036",
      "type": "speech",
      "speaker": {
        "id": "canidius",
        "name": "CANIDIUS",
        "displayName": "Canidius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0095",
          "number": 95,
          "speechLineNumber": 1,
          "text": "Well I know the man.",
          "plainText": "Well I know the man",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-stage-006",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-037",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0096",
          "number": 96,
          "speechLineNumber": 1,
          "text": "The Emperor calls Canidius.",
          "plainText": "The Emperor calls Canidius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-speech-038",
      "type": "speech",
      "speaker": {
        "id": "canidius",
        "name": "CANIDIUS",
        "displayName": "Canidius"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-3-7-line-0097",
          "number": 97,
          "speechLineNumber": 1,
          "text": "With news the time's with labour, and throes forth",
          "plainText": "With news the time's with labour and throes forth",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-3-7-line-0098",
          "number": 98,
          "speechLineNumber": 2,
          "text": "Each minute some.",
          "plainText": "Each minute some",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-3-7-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}