  "scene": {
    "id": "antony-and-cleopatra-4-1",
    "act": 4,
    "scene": 1,
    "label": "Act 4, Scene 1",
    "title": "SCENE I. Caesar's Camp at Alexandria.",
    "location": "Caesar's Camp at Alexandria.",
    "orderInPlay": 26
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-1-stage-001",
      "type": "stage",
      "text": "Enter Caesar, Agrippa, and Maecenas, with his army. Caesar reading a letter."
    },
    {
      "id": "antony-and-cleopatra-4-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "He calls me boy, and chides as he had power",
          "plainText": "He calls me boy and chides as he had power",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "To beat me out of Egypt. My messenger",
          "plainText": "To beat me out of Egypt My messenger",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "He hath whipped with rods; dares me to personal combat,",
          "plainText": "He hath whipped with rods dares me to personal combat",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Caesar to Antony. Let the old ruffian know",
          "plainText": "Caesar to Antony Let the old ruffian know",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "I have many other ways to die; meantime",
          "plainText": "I have many other ways to die meantime",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Laugh at his challenge.",
          "plainText": "Laugh at his challenge",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "maecenas",
        "name": "MAECENAS",
        "displayName": "Maecenas"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Caesar must think,",
          "plainText": "Caesar must think",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "When one so great begins to rage, he's hunted",
          "plainText": "When one so great begins to rage he's hunted",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Even to falling. Give him no breath, but now",
          "plainText": "Even to falling Give him no breath but now",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "Make boot of his distraction. Never anger",
          "plainText": "Make boot of his distraction Never anger",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "Made good guard for itself.",
          "plainText": "Made good guard for itself",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Let our best heads",
          "plainText": "Let our best heads",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Know that tomorrow the last of many battles",
          "plainText": "Know that tomorrow the last of many battles",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "We mean to fight. Within our files there are,",
          "plainText": "We mean to fight Within our files there are",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "Of those that served Mark Antony but late,",
          "plainText": "Of those that served Mark Antony but late",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "Enough to fetch him in. See it done,",
          "plainText": "Enough to fetch him in See it done",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "And feast the army; we have store to do't,",
          "plainText": "And feast the army we have store to do't",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-1-line-0018",
          "number": 18,
          "speechLineNumber": 7,
          "text": "And they have earned the waste. Poor Antony!",
          "plainText": "And they have earned the waste Poor Antony",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-1-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}