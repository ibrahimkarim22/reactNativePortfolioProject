  "content": [
    {
      "id": "antony-and-cleopatra-4-10-stage-001",
      "type": "stage",
      "text": "Enter Antony and Scarus with their army."
    },
    {
      "id": "antony-and-cleopatra-4-10-speech-001",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-10-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Their preparation is today by sea;",
          "plainText": "Their preparation is today by sea",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-10-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "We please them not by land.",
          "plainText": "We please them not by land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-10-speech-002",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-10-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "For both, my lord.",
          "plainText": "For both my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-10-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-10-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I would they'd fight i' th' fire or i' th' air;",
          "plainText": "I would they'd fight i' th' fire or i' th' air",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-10-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "We'd fight there too. But this it is: our foot",
          "plainText": "We'd fight there too But this it is our foot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-10-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Upon the hills adjoining to the city",
          "plainText": "Upon the hills adjoining to the city",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-10-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "Shall stay with us—order for sea is given;",
          "plainText": "Shall stay with usorder for sea is given",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-10-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "They have put forth the haven—",
          "plainText": "They have put forth the haven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-10-line-0009",
          "number": 9,
          "speechLineNumber": 6,
          "text": "Where their appointment we may best discover",
          "plainText": "Where their appointment we may best discover",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-10-line-0010",
          "number": 10,
          "speechLineNumber": 7,
          "text": "And look on their endeavour.",
          "plainText": "And look on their endeavour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-10-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
