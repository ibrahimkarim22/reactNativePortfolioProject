  "content": [
    {
      "id": "antony-and-cleopatra-4-11-stage-001",
      "type": "stage",
      "text": "Enter Caesar and his army."
    },
    {
      "id": "antony-and-cleopatra-4-11-speech-001",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-11-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "But being charged, we will be still by land,",
          "plainText": "But being charged we will be still by land",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-11-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Which, as I take't, we shall, for his best force",
          "plainText": "Which as I take't we shall for his best force",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-11-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Is forth to man his galleys. To the vales,",
          "plainText": "Is forth to man his galleys To the vales",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-11-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And hold our best advantage.",
          "plainText": "And hold our best advantage",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-11-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
