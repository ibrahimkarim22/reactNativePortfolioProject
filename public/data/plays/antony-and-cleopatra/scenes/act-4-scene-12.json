  "scene": {
    "id": "antony-and-cleopatra-4-12",
    "act": 4,
    "scene": 12,
    "label": "Act 4, Scene 12",
    "title": "SCENE XII. Another part of the Ground.",
    "location": "Another part of the Ground.",
    "orderInPlay": 37
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-12-stage-001",
      "type": "stage",
      "text": "Alarum afar off, as at a sea fight. Enter Antony and Scarus."
    },
    {
      "id": "antony-and-cleopatra-4-12-speech-001",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-12-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Yet they are not joined. Where yond pine does stand",
          "plainText": "Yet they are not joined Where yond pine does stand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "I shall discover all. I'll bring thee word",
          "plainText": "I shall discover all I'll bring thee word",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Straight how 'tis like to go.",
          "plainText": "Straight how 'tis like to go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-12-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "antony-and-cleopatra-4-12-speech-002",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-12-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Swallows have built",
          "plainText": "Swallows have built",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "In Cleopatra's sails their nests. The augurs",
          "plainText": "In Cleopatra's sails their nests The augurs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Say they know not, they cannot tell; look grimly,",
          "plainText": "Say they know not they cannot tell look grimly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "And dare not speak their knowledge. Antony",
          "plainText": "And dare not speak their knowledge Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "Is valiant and dejected, and by starts",
          "plainText": "Is valiant and dejected and by starts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0009",
          "number": 9,
          "speechLineNumber": 6,
          "text": "His fretted fortunes give him hope and fear",
          "plainText": "His fretted fortunes give him hope and fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0010",
          "number": 10,
          "speechLineNumber": 7,
          "text": "Of what he has and has not.",
          "plainText": "Of what he has and has not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-12-stage-003",
      "type": "stage",
      "text": "Enter Antony."
    },
    {
      "id": "antony-and-cleopatra-4-12-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-12-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "All is lost!",
          "plainText": "All is lost",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "This foul Egyptian hath betrayed me.",
          "plainText": "This foul Egyptian hath betrayed me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "My fleet hath yielded to the foe, and yonder",
          "plainText": "My fleet hath yielded to the foe and yonder",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "They cast their caps up and carouse together",
          "plainText": "They cast their caps up and carouse together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "Like friends long lost. Triple-turned whore! 'Tis thou",
          "plainText": "Like friends long lost Tripleturned whore 'Tis thou",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0016",
          "number": 16,
          "speechLineNumber": 6,
          "text": "Hast sold me to this novice, and my heart",
          "plainText": "Hast sold me to this novice and my heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0017",
          "number": 17,
          "speechLineNumber": 7,
          "text": "Makes only wars on thee. Bid them all fly;",
          "plainText": "Makes only wars on thee Bid them all fly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0018",
          "number": 18,
          "speechLineNumber": 8,
          "text": "For when I am revenged upon my charm,",
          "plainText": "For when I am revenged upon my charm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0019",
          "number": 19,
          "speechLineNumber": 9,
          "text": "I have done all. Bid them all fly! Be gone!",
          "plainText": "I have done all Bid them all fly Be gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-12-stage-004",
      "type": "stage",
      "text": "[Exit Scarus.]"
    },
    {
      "id": "antony-and-cleopatra-4-12-stage-005",
      "type": "stage",
      "text": "Enter Cleopatra."
    },
    {
      "id": "antony-and-cleopatra-4-12-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-12-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Why is my lord enraged against his love?",
          "plainText": "Why is my lord enraged against his love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-12-speech-005",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-12-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Vanish, or I shall give thee thy deserving",
          "plainText": "Vanish or I shall give thee thy deserving",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "And blemish Caesar's triumph. Let him take thee",
          "plainText": "And blemish Caesar's triumph Let him take thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "And hoist thee up to the shouting plebeians!",
          "plainText": "And hoist thee up to the shouting plebeians",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "Follow his chariot, like the greatest spot",
          "plainText": "Follow his chariot like the greatest spot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "Of all thy sex; most monster-like be shown",
          "plainText": "Of all thy sex most monsterlike be shown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0026",
          "number": 26,
          "speechLineNumber": 6,
          "text": "For poor'st diminutives, for dolts, and let",
          "plainText": "For poor'st diminutives for dolts and let",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0027",
          "number": 27,
          "speechLineNumber": 7,
          "text": "Patient Octavia plough thy visage up",
          "plainText": "Patient Octavia plough thy visage up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-12-line-0028",
          "number": 28,
          "speechLineNumber": 8,
          "text": "With her prepared nails.",
          "plainText": "With her prepared nails",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-12-stage-006",
      "type": "stage",
      "text": "[Exit Cleopatra.]"
    },
    {
      "id": "antony-and-cleopatra-4-12-stage-007",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}