    "title": "SCENE XIII. Alexandria. A Room in the Palace.",
    "location": "Alexandria. A Room in the Palace.",
    "orderInPlay": 38
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-13-stage-001",
      "type": "stage",
      "text": "Enter Cleopatra, Charmian, Iras and Mardian."
    },
    {
      "id": "antony-and-cleopatra-4-13-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-13-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Help me, my women! O, he is more mad",
          "plainText": "Help me my women O he is more mad",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-13-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Than Telamon for his shield; the boar of Thessaly",
          "plainText": "Than Telamon for his shield the boar of Thessaly",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-13-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Was never so embossed.",
          "plainText": "Was never so embossed",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-13-speech-002",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-13-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "To th' monument!",
          "plainText": "To th' monument",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-13-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "There lock yourself and send him word you are dead.",
          "plainText": "There lock yourself and send him word you are dead",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-13-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "The soul and body rive not more in parting",
          "plainText": "The soul and body rive not more in parting",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-13-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "Than greatness going off.",
          "plainText": "Than greatness going off",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-13-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-13-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "To th' monument!",
          "plainText": "To th' monument",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-13-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Mardian, go tell him I have slain myself.",
          "plainText": "Mardian go tell him I have slain myself",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-13-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Say that the last I spoke was \"Antony\",",
          "plainText": "Say that the last I spoke was Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-13-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "And word it, prithee, piteously. Hence, Mardian,",
          "plainText": "And word it prithee piteously Hence Mardian",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-13-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "And bring me how he takes my death.—To th' monument!",
          "plainText": "And bring me how he takes my deathTo th' monument",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-13-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}