  "scene": {
    "id": "antony-and-cleopatra-4-15",
    "act": 4,
    "scene": 15,
    "label": "Act 4, Scene 15",
    "title": "SCENE XV. Alexandria. A monument.",
    "location": "Alexandria. A monument.",
    "orderInPlay": 40
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-15-stage-001",
      "type": "stage",
      "text": "Enter Cleopatra and her maids aloft, with Charmian and Iras."
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "O Charmian, I will never go from hence.",
          "plainText": "O Charmian I will never go from hence",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-002",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Be comforted, dear madam.",
          "plainText": "Be comforted dear madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "No, I will not.",
          "plainText": "No I will not",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "All strange and terrible events are welcome,",
          "plainText": "All strange and terrible events are welcome",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "But comforts we despise. Our size of sorrow,",
          "plainText": "But comforts we despise Our size of sorrow",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "Proportioned to our cause, must be as great",
          "plainText": "Proportioned to our cause must be as great",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0007",
          "number": 7,
          "speechLineNumber": 5,
          "text": "As that which makes it.",
          "plainText": "As that which makes it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-stage-002",
      "type": "stage",
      "text": "Enter, below Diomedes."
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-004",
      "type": "speech",
      "speaker": {
        "id": "diomedes",
        "name": "DIOMEDES",
        "displayName": "Diomedes"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "His death's upon him, but not dead.",
          "plainText": "His death's upon him but not dead",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Look out o' th' other side your monument;",
          "plainText": "Look out o' th' other side your monument",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "His guard have brought him thither.",
          "plainText": "His guard have brought him thither",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-stage-003",
      "type": "stage",
      "text": "Enter, below Antony borne by the Guard."
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "O sun,",
          "plainText": "O sun",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Burn the great sphere thou mov'st in! Darkling stand",
          "plainText": "Burn the great sphere thou mov'st in Darkling stand",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "The varying shore o' th' world. O Antony,",
          "plainText": "The varying shore o' th' world O Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "Antony, Antony! Help, Charmian! Help, Iras, help!",
          "plainText": "Antony Antony Help Charmian Help Iras help",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "Help, friends below! Let's draw him hither.",
          "plainText": "Help friends below Let's draw him hither",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-006",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Peace!",
          "plainText": "Peace",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Not Caesar's valour hath o'erthrown Antony,",
          "plainText": "Not Caesar's valour hath o'erthrown Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "But Antony's hath triumphed on itself.",
          "plainText": "But Antony's hath triumphed on itself",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-007",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "So it should be, that none but Antony",
          "plainText": "So it should be that none but Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Should conquer Antony, but woe 'tis so!",
          "plainText": "Should conquer Antony but woe 'tis so",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-008",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "I am dying, Egypt, dying. Only",
          "plainText": "I am dying Egypt dying Only",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "I here importune death awhile until",
          "plainText": "I here importune death awhile until",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "Of many thousand kisses the poor last",
          "plainText": "Of many thousand kisses the poor last",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "I lay upon thy lips.",
          "plainText": "I lay upon thy lips",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "I dare not, dear",
          "plainText": "I dare not dear",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Dear my lord, pardon. I dare not,",
          "plainText": "Dear my lord pardon I dare not",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "Lest I be taken. Not th' imperious show",
          "plainText": "Lest I be taken Not th' imperious show",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "Of the full-fortuned Caesar ever shall",
          "plainText": "Of the fullfortuned Caesar ever shall",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "Be brooched with me; if knife, drugs, serpents, have",
          "plainText": "Be brooched with me if knife drugs serpents have",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "Edge, sting, or operation, I am safe.",
          "plainText": "Edge sting or operation I am safe",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0031",
          "number": 31,
          "speechLineNumber": 7,
          "text": "Your wife Octavia, with her modest eyes",
          "plainText": "Your wife Octavia with her modest eyes",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0032",
          "number": 32,
          "speechLineNumber": 8,
          "text": "And still conclusion, shall acquire no honour",
          "plainText": "And still conclusion shall acquire no honour",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0033",
          "number": 33,
          "speechLineNumber": 9,
          "text": "Demuring upon me. But come, come, Antony—",
          "plainText": "Demuring upon me But come come Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0034",
          "number": 34,
          "speechLineNumber": 10,
          "text": "Help me, my women—we must draw thee up.",
          "plainText": "Help me my womenwe must draw thee up",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0035",
          "number": 35,
          "speechLineNumber": 11,
          "text": "Assist, good friends.",
          "plainText": "Assist good friends",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-010",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "O, quick, or I am gone.",
          "plainText": "O quick or I am gone",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-011",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Here's sport indeed! How heavy weighs my lord!",
          "plainText": "Here's sport indeed How heavy weighs my lord",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Our strength is all gone into heaviness;",
          "plainText": "Our strength is all gone into heaviness",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "That makes the weight. Had I great Juno's power,",
          "plainText": "That makes the weight Had I great Juno's power",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "The strong-winged Mercury should fetch thee up",
          "plainText": "The strongwinged Mercury should fetch thee up",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0041",
          "number": 41,
          "speechLineNumber": 5,
          "text": "And set thee by Jove's side. Yet come a little;",
          "plainText": "And set thee by Jove's side Yet come a little",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0042",
          "number": 42,
          "speechLineNumber": 6,
          "text": "Wishers were ever fools. O come, come come,",
          "plainText": "Wishers were ever fools O come come come",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-stage-004",
      "type": "stage",
      "text": "[They heave Antony aloft to Cleopatra.]"
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-012",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "A heavy sight!",
          "plainText": "A heavy sight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-013",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "I am dying, Egypt, dying.",
          "plainText": "I am dying Egypt dying",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "Give me some wine, and let me speak a little.",
          "plainText": "Give me some wine and let me speak a little",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-014",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "No, let me speak, and let me rail so high",
          "plainText": "No let me speak and let me rail so high",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "That the false huswife Fortune break her wheel,",
          "plainText": "That the false huswife Fortune break her wheel",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "Provoked by my offence.",
          "plainText": "Provoked by my offence",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-015",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "One word, sweet queen:",
          "plainText": "One word sweet queen",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Of Caesar seek your honour, with your safety. O!",
          "plainText": "Of Caesar seek your honour with your safety O",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-016",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "They do not go together.",
          "plainText": "They do not go together",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-017",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Gentle, hear me.",
          "plainText": "Gentle hear me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "None about Caesar trust but Proculeius.",
          "plainText": "None about Caesar trust but Proculeius",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-018",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "My resolution and my hands I'll trust;",
          "plainText": "My resolution and my hands I'll trust",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "None about Caesar.",
          "plainText": "None about Caesar",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-019",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "The miserable change now at my end",
          "plainText": "The miserable change now at my end",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0057",
          "number": 57,
          "speechLineNumber": 2,
          "text": "Lament nor sorrow at, but please your thoughts",
          "plainText": "Lament nor sorrow at but please your thoughts",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0058",
          "number": 58,
          "speechLineNumber": 3,
          "text": "In feeding them with those my former fortunes",
          "plainText": "In feeding them with those my former fortunes",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0059",
          "number": 59,
          "speechLineNumber": 4,
          "text": "Wherein I lived the greatest prince o' th' world,",
          "plainText": "Wherein I lived the greatest prince o' th' world",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0060",
          "number": 60,
          "speechLineNumber": 5,
          "text": "The noblest; and do now not basely die,",
          "plainText": "The noblest and do now not basely die",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0061",
          "number": 61,
          "speechLineNumber": 6,
          "text": "Not cowardly put off my helmet to",
          "plainText": "Not cowardly put off my helmet to",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0062",
          "number": 62,
          "speechLineNumber": 7,
          "text": "My countryman; a Roman by a Roman",
          "plainText": "My countryman a Roman by a Roman",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0063",
          "number": 63,
          "speechLineNumber": 8,
          "text": "Valiantly vanquished. Now my spirit is going;",
          "plainText": "Valiantly vanquished Now my spirit is going",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0064",
          "number": 64,
          "speechLineNumber": 9,
          "text": "I can no more.",
          "plainText": "I can no more",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-020",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Noblest of men, woo't die?",
          "plainText": "Noblest of men woo't die",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "Hast thou no care of me? Shall I abide",
          "plainText": "Hast thou no care of me Shall I abide",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0067",
          "number": 67,
          "speechLineNumber": 3,
          "text": "In this dull world, which in thy absence is",
          "plainText": "In this dull world which in thy absence is",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0068",
          "number": 68,
          "speechLineNumber": 4,
          "text": "No better than a sty? O, see, my women,",
          "plainText": "No better than a sty O see my women",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-stage-005",
      "type": "stage",
      "text": "[ Antony dies.]"
    },
    {
      "id": "antony-and-cleopatra-4-15-stage-006",
      "type": "stage",
      "text": "[Faints.]"
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-021",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "O, quietness, lady!",
          "plainText": "O quietness lady",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-022",
      "type": "speech",
      "speaker": {
        "id": "iras",
        "name": "IRAS",
        "displayName": "Iras"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "She is dead too, our sovereign.",
          "plainText": "She is dead too our sovereign",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-023",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Lady!",
          "plainText": "Lady",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-024",
      "type": "speech",
      "speaker": {
        "id": "iras",
        "name": "IRAS",
        "displayName": "Iras"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Madam!",
          "plainText": "Madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-025",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "O madam, madam, madam!",
          "plainText": "O madam madam madam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-026",
      "type": "speech",
      "speaker": {
        "id": "iras",
        "name": "IRAS",
        "displayName": "Iras"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Royal Egypt, Empress!",
          "plainText": "Royal Egypt Empress",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-027",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Peace, peace, Iras!",
          "plainText": "Peace peace Iras",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-speech-028",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-15-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "No more but e'en a woman, and commanded",
          "plainText": "No more but e'en a woman and commanded",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0077",
          "number": 77,
          "speechLineNumber": 2,
          "text": "By such poor passion as the maid that milks",
          "plainText": "By such poor passion as the maid that milks",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0078",
          "number": 78,
          "speechLineNumber": 3,
          "text": "And does the meanest chares. It were for me",
          "plainText": "And does the meanest chares It were for me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0079",
          "number": 79,
          "speechLineNumber": 4,
          "text": "To throw my sceptre at the injurious gods,",
          "plainText": "To throw my sceptre at the injurious gods",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0080",
          "number": 80,
          "speechLineNumber": 5,
          "text": "To tell them that this world did equal theirs",
          "plainText": "To tell them that this world did equal theirs",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0081",
          "number": 81,
          "speechLineNumber": 6,
          "text": "Till they had stolen our jewel. All's but naught;",
          "plainText": "Till they had stolen our jewel All's but naught",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0082",
          "number": 82,
          "speechLineNumber": 7,
          "text": "Patience is sottish, and impatience does",
          "plainText": "Patience is sottish and impatience does",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0083",
          "number": 83,
          "speechLineNumber": 8,
          "text": "Become a dog that's mad. Then is it sin",
          "plainText": "Become a dog that's mad Then is it sin",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0084",
          "number": 84,
          "speechLineNumber": 9,
          "text": "To rush into the secret house of death",
          "plainText": "To rush into the secret house of death",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0085",
          "number": 85,
          "speechLineNumber": 10,
          "text": "Ere death dare come to us? How do you, women?",
          "plainText": "Ere death dare come to us How do you women",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0086",
          "number": 86,
          "speechLineNumber": 11,
          "text": "What, what! good cheer! Why, how now, Charmian?",
          "plainText": "What what good cheer Why how now Charmian",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0087",
          "number": 87,
          "speechLineNumber": 12,
          "text": "My noble girls! Ah, women, women! Look,",
          "plainText": "My noble girls Ah women women Look",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0088",
          "number": 88,
          "speechLineNumber": 13,
          "text": "Our lamp is spent, it's out! Good sirs, take heart.",
          "plainText": "Our lamp is spent it's out Good sirs take heart",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0089",
          "number": 89,
          "speechLineNumber": 14,
          "text": "We'll bury him; and then, what's brave, what's noble,",
          "plainText": "We'll bury him and then what's brave what's noble",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0090",
          "number": 90,
          "speechLineNumber": 15,
          "text": "Let's do it after the high Roman fashion",
          "plainText": "Let's do it after the high Roman fashion",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0091",
          "number": 91,
          "speechLineNumber": 16,
          "text": "And make death proud to take us. Come, away.",
          "plainText": "And make death proud to take us Come away",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0092",
          "number": 92,
          "speechLineNumber": 17,
          "text": "This case of that huge spirit now is cold.",
          "plainText": "This case of that huge spirit now is cold",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0093",
          "number": 93,
          "speechLineNumber": 18,
          "text": "Ah, women, women! Come, we have no friend",
          "plainText": "Ah women women Come we have no friend",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-15-line-0094",
          "number": 94,
          "speechLineNumber": 19,
          "text": "But resolution and the briefest end.",
          "plainText": "But resolution and the briefest end",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-15-stage-007",
      "type": "stage",
      "text": "[Exeunt, bearing off Antony's body.]"
    }
  ]
}