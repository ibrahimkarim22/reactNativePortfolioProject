  "scene": {
    "id": "antony-and-cleopatra-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. Alexandria. A Room in the Palace.",
    "location": "Alexandria. A Room in the Palace.",
    "orderInPlay": 27
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-2-stage-001",
      "type": "stage",
      "text": "Enter Antony, Cleopatra, Enobarbus, Charmian, Iras, Alexas with others."
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "He will not fight with me, Domitius?",
          "plainText": "He will not fight with me Domitius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "No.",
          "plainText": "No",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Why should he not?",
          "plainText": "Why should he not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "He thinks, being twenty times of better fortune,",
          "plainText": "He thinks being twenty times of better fortune",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "He is twenty men to one.",
          "plainText": "He is twenty men to one",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Tomorrow, soldier,",
          "plainText": "Tomorrow soldier",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "By sea and land I'll fight. Or I will live,",
          "plainText": "By sea and land I'll fight Or I will live",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "Or bathe my dying honour in the blood",
          "plainText": "Or bathe my dying honour in the blood",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Shall make it live again. Woo't thou fight well?",
          "plainText": "Shall make it live again Woo't thou fight well",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "I'll strike, and cry \"Take all.\"",
          "plainText": "I'll strike and cry Take all",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Well said. Come on.",
          "plainText": "Well said Come on",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Call forth my household servants. Let's tonight",
          "plainText": "Call forth my household servants Let's tonight",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Be bounteous at our meal.—",
          "plainText": "Be bounteous at our meal",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-stage-002",
      "type": "stage",
      "text": "Enter Servants."
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "[Aside to Enobarbus.] What means this?",
          "plainText": "Aside to Enobarbus What means this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "[Aside to Cleopatra.] 'Tis one of those odd tricks which sorrow shoots",
          "plainText": "Aside to Cleopatra 'Tis one of those odd tricks which sorrow shoots",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Out of the mind.",
          "plainText": "Out of the mind",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "And thou art honest too.",
          "plainText": "And thou art honest too",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "I wish I could be made so many men,",
          "plainText": "I wish I could be made so many men",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "And all of you clapped up together in",
          "plainText": "And all of you clapped up together in",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "An Antony, that I might do you service",
          "plainText": "An Antony that I might do you service",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "So good as you have done.",
          "plainText": "So good as you have done",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "all-the-servants",
        "name": "ALL THE SERVANTS",
        "displayName": "All The Servants"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "The gods forbid!",
          "plainText": "The gods forbid",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Well, my good fellows, wait on me tonight.",
          "plainText": "Well my good fellows wait on me tonight",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Scant not my cups, and make as much of me",
          "plainText": "Scant not my cups and make as much of me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "As when mine empire was your fellow too",
          "plainText": "As when mine empire was your fellow too",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "And suffered my command.",
          "plainText": "And suffered my command",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "[Aside to Enobarbus.] What does he mean?",
          "plainText": "Aside to Enobarbus What does he mean",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "[Aside to Cleopatra.] To make his followers weep.",
          "plainText": "Aside to Cleopatra To make his followers weep",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Tend me tonight;",
          "plainText": "Tend me tonight",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "May be it is the period of your duty.",
          "plainText": "May be it is the period of your duty",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "Haply you shall not see me more, or if,",
          "plainText": "Haply you shall not see me more or if",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "A mangled shadow. Perchance tomorrow",
          "plainText": "A mangled shadow Perchance tomorrow",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0033",
          "number": 33,
          "speechLineNumber": 5,
          "text": "You'll serve another master. I look on you",
          "plainText": "You'll serve another master I look on you",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0034",
          "number": 34,
          "speechLineNumber": 6,
          "text": "As one that takes his leave. Mine honest friends,",
          "plainText": "As one that takes his leave Mine honest friends",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0035",
          "number": 35,
          "speechLineNumber": 7,
          "text": "I turn you not away, but, like a master",
          "plainText": "I turn you not away but like a master",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0036",
          "number": 36,
          "speechLineNumber": 8,
          "text": "Married to your good service, stay till death.",
          "plainText": "Married to your good service stay till death",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0037",
          "number": 37,
          "speechLineNumber": 9,
          "text": "Tend me tonight two hours, I ask no more,",
          "plainText": "Tend me tonight two hours I ask no more",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0038",
          "number": 38,
          "speechLineNumber": 10,
          "text": "And the gods yield you for't!",
          "plainText": "And the gods yield you for't",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "What mean you, sir,",
          "plainText": "What mean you sir",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "To give them this discomfort? Look, they weep,",
          "plainText": "To give them this discomfort Look they weep",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "And I, an ass, am onion-eyed. For shame,",
          "plainText": "And I an ass am onioneyed For shame",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0042",
          "number": 42,
          "speechLineNumber": 4,
          "text": "Transform us not to women.",
          "plainText": "Transform us not to women",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Ho, ho, ho!",
          "plainText": "Ho ho ho",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "Now the witch take me if I meant it thus!",
          "plainText": "Now the witch take me if I meant it thus",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Grace grow where those drops fall! My hearty friends,",
          "plainText": "Grace grow where those drops fall My hearty friends",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "You take me in too dolorous a sense,",
          "plainText": "You take me in too dolorous a sense",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0047",
          "number": 47,
          "speechLineNumber": 5,
          "text": "For I spake to you for your comfort, did desire you",
          "plainText": "For I spake to you for your comfort did desire you",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0048",
          "number": 48,
          "speechLineNumber": 6,
          "text": "To burn this night with torches. Know, my hearts,",
          "plainText": "To burn this night with torches Know my hearts",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0049",
          "number": 49,
          "speechLineNumber": 7,
          "text": "I hope well of tomorrow, and will lead you",
          "plainText": "I hope well of tomorrow and will lead you",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0050",
          "number": 50,
          "speechLineNumber": 8,
          "text": "Where rather I'll expect victorious life",
          "plainText": "Where rather I'll expect victorious life",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0051",
          "number": 51,
          "speechLineNumber": 9,
          "text": "Than death and honour. Let's to supper, come,",
          "plainText": "Than death and honour Let's to supper come",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-2-line-0052",
          "number": 52,
          "speechLineNumber": 10,
          "text": "And drown consideration.",
          "plainText": "And drown consideration",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-2-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}