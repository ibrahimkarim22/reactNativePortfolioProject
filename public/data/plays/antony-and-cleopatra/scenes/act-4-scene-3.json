  "scene": {
    "id": "antony-and-cleopatra-4-3",
    "act": 4,
    "scene": 3,
    "label": "Act 4, Scene 3",
    "title": "SCENE III. Alexandria. Before the Palace.",
    "location": "Alexandria. Before the Palace.",
    "orderInPlay": 28
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-3-stage-001",
      "type": "stage",
      "text": "Enter a Company of Soldiers."
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Brother, good night. Tomorrow is the day.",
          "plainText": "Brother good night Tomorrow is the day",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "It will determine one way. Fare you well.",
          "plainText": "It will determine one way Fare you well",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Heard you of nothing strange about the streets?",
          "plainText": "Heard you of nothing strange about the streets",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Nothing. What news?",
          "plainText": "Nothing What news",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Belike 'tis but a rumour. Good night to you.",
          "plainText": "Belike 'tis but a rumour Good night to you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Well, sir, good night.",
          "plainText": "Well sir good night",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-stage-002",
      "type": "stage",
      "text": "Enter two other Soldiers."
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Soldiers, have careful watch.",
          "plainText": "Soldiers have careful watch",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "third-soldier",
        "name": "THIRD SOLDIER",
        "displayName": "Third Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "And you. Good night, good night.",
          "plainText": "And you Good night good night",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-stage-003",
      "type": "stage",
      "text": "[They place themselves in every corner of the stage.]"
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Here we. And if tomorrow",
          "plainText": "Here we And if tomorrow",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Our navy thrive, I have an absolute hope",
          "plainText": "Our navy thrive I have an absolute hope",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Our landmen will stand up.",
          "plainText": "Our landmen will stand up",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "'Tis a brave army, and full of purpose.",
          "plainText": "'Tis a brave army and full of purpose",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-stage-004",
      "type": "stage",
      "text": "[Music of the hautboys under the stage.]"
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Peace, what noise?",
          "plainText": "Peace what noise",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "List, list!",
          "plainText": "List list",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Hark!",
          "plainText": "Hark",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Music i' th' air.",
          "plainText": "Music i' th' air",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "third-soldier",
        "name": "THIRD SOLDIER",
        "displayName": "Third Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Under the earth.",
          "plainText": "Under the earth",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "fourth-soldier",
        "name": "FOURTH SOLDIER",
        "displayName": "Fourth Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "It signs well, does it not?",
          "plainText": "It signs well does it not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "third-soldier",
        "name": "THIRD SOLDIER",
        "displayName": "Third Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "No.",
          "plainText": "No",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Peace, I say! What should this mean?",
          "plainText": "Peace I say What should this mean",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "'Tis the god Hercules, whom Antony loved,",
          "plainText": "'Tis the god Hercules whom Antony loved",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-3-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "Now leaves him.",
          "plainText": "Now leaves him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Walk. Let's see if other watchmen",
          "plainText": "Walk Let's see if other watchmen",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Do hear what we do.",
          "plainText": "Do hear what we do",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-stage-005",
      "type": "stage",
      "text": "[They advance to another post.]"
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "How now, masters!",
          "plainText": "How now masters",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "How now! How now! Do you hear this?",
          "plainText": "How now How now Do you hear this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Ay. Is't not strange?",
          "plainText": "Ay Is't not strange",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "third-soldier",
        "name": "THIRD SOLDIER",
        "displayName": "Third Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Do you hear, masters? Do you hear?",
          "plainText": "Do you hear masters Do you hear",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Follow the noise so far as we have quarter.",
          "plainText": "Follow the noise so far as we have quarter",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-3-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "Let's see how it will give off.",
          "plainText": "Let's see how it will give off",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Content. 'Tis strange.",
          "plainText": "Content 'Tis strange",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-3-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}