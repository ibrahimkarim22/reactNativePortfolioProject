  },
  "scene": {
    "id": "antony-and-cleopatra-4-4",
    "act": 4,
    "scene": 4,
    "label": "Act 4, Scene 4",
    "title": "SCENE IV. Alexandria. A Room in the Palace.",
    "location": "Alexandria. A Room in the Palace.",
    "orderInPlay": 29
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-4-stage-001",
      "type": "stage",
      "text": "Enter Antony and Cleopatra with others."
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Eros! Mine armour, Eros!",
          "plainText": "Eros Mine armour Eros",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Sleep a little.",
          "plainText": "Sleep a little",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "No, my chuck.—Eros! Come, mine armour, Eros!",
          "plainText": "No my chuckEros Come mine armour Eros",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-stage-002",
      "type": "stage",
      "text": "Enter Eros with armour."
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Nay, I'll help too.",
          "plainText": "Nay I'll help too",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "What's this for?",
          "plainText": "What's this for",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Ah, let be, let be! Thou art",
          "plainText": "Ah let be let be Thou art",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "The armourer of my heart. False, false. This, this!",
          "plainText": "The armourer of my heart False false This this",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Sooth, la, I'll help. Thus it must be.",
          "plainText": "Sooth la I'll help Thus it must be",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Well, well,",
          "plainText": "Well well",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "We shall thrive now. Seest thou, my good fellow?",
          "plainText": "We shall thrive now Seest thou my good fellow",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Go put on thy defences.",
          "plainText": "Go put on thy defences",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Briefly, sir.",
          "plainText": "Briefly sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Is not this buckled well?",
          "plainText": "Is not this buckled well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Rarely, rarely.",
          "plainText": "Rarely rarely",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "He that unbuckles this, till we do please",
          "plainText": "He that unbuckles this till we do please",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "To daff't for our repose, shall hear a storm.",
          "plainText": "To daff't for our repose shall hear a storm",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "Thou fumblest, Eros, and my queen's a squire",
          "plainText": "Thou fumblest Eros and my queen's a squire",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "More tight at this than thou. Dispatch. O love,",
          "plainText": "More tight at this than thou Dispatch O love",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0019",
          "number": 19,
          "speechLineNumber": 6,
          "text": "That thou couldst see my wars today, and knew'st",
          "plainText": "That thou couldst see my wars today and knew'st",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0020",
          "number": 20,
          "speechLineNumber": 7,
          "text": "The royal occupation, thou shouldst see",
          "plainText": "The royal occupation thou shouldst see",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0021",
          "number": 21,
          "speechLineNumber": 8,
          "text": "A workman in't.",
          "plainText": "A workman in't",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-stage-003",
      "type": "stage",
      "text": "Enter an Officer, armed."
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "officer",
        "name": "OFFICER",
        "displayName": "Officer"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "A thousand, sir,",
          "plainText": "A thousand sir",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Early though't be, have on their riveted trim",
          "plainText": "Early though't be have on their riveted trim",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "And at the port expect you.",
          "plainText": "And at the port expect you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-stage-004",
      "type": "stage",
      "text": "[Shout. Trumpets flourish.]"
    },
    {
      "id": "antony-and-cleopatra-4-4-stage-005",
      "type": "stage",
      "text": "Enter other Captains and Soldiers."
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "The morn is fair. Good morrow, general.",
          "plainText": "The morn is fair Good morrow general",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Good morrow, general.",
          "plainText": "Good morrow general",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "'Tis well blown, lads.",
          "plainText": "'Tis well blown lads",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "This morning, like the spirit of a youth",
          "plainText": "This morning like the spirit of a youth",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "That means to be of note, begins betimes.",
          "plainText": "That means to be of note begins betimes",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "So, so. Come, give me that. This way. Well said.",
          "plainText": "So so Come give me that This way Well said",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "Fare thee well, dame.",
          "plainText": "Fare thee well dame",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0032",
          "number": 32,
          "speechLineNumber": 6,
          "text": "Whate'er becomes of me,",
          "plainText": "Whate'er becomes of me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0033",
          "number": 33,
          "speechLineNumber": 7,
          "text": "This is a soldier's kiss. [Kisses her.] Rebukeable",
          "plainText": "This is a soldier's kiss Kisses her Rebukeable",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0034",
          "number": 34,
          "speechLineNumber": 8,
          "text": "And worthy shameful check it were, to stand",
          "plainText": "And worthy shameful check it were to stand",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0035",
          "number": 35,
          "speechLineNumber": 9,
          "text": "On more mechanic compliment. I'll leave thee",
          "plainText": "On more mechanic compliment I'll leave thee",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0036",
          "number": 36,
          "speechLineNumber": 10,
          "text": "Now like a man of steel.—You that will fight,",
          "plainText": "Now like a man of steelYou that will fight",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0037",
          "number": 37,
          "speechLineNumber": 11,
          "text": "Follow me close, I'll bring you to't. Adieu.",
          "plainText": "Follow me close I'll bring you to't Adieu",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-stage-006",
      "type": "stage",
      "text": "[Exeunt Antony, Eros, Captains and Soldiers.]"
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "charmian",
        "name": "CHARMIAN",
        "displayName": "Charmian"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Please you, retire to your chamber.",
          "plainText": "Please you retire to your chamber",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-4-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Lead me.",
          "plainText": "Lead me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "He goes forth gallantly. That he and Caesar might",
          "plainText": "He goes forth gallantly That he and Caesar might",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "Determine this great war in single fight!",
          "plainText": "Determine this great war in single fight",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-4-line-0042",
          "number": 42,
          "speechLineNumber": 4,
          "text": "Then Antony—but now—. Well, on.",
          "plainText": "Then Antonybut now Well on",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-4-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}