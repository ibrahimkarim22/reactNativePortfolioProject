{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "antony-and-cleopatra",
    "title": "The Tragedy of Antony and Cleopatra",
    "author": "William Shakespeare",
    "genre": "Tragedy"
  },
  "source": {
