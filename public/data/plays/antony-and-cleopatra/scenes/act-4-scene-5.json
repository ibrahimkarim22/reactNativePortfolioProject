  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-5-stage-001",
      "type": "stage",
      "text": "Trumpets sound. Enter Antony and Eros, a Soldier meeting them."
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The gods make this a happy day to Antony!",
          "plainText": "The gods make this a happy day to Antony",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Would thou and those thy scars had once prevailed",
          "plainText": "Would thou and those thy scars had once prevailed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "To make me fight at land!",
          "plainText": "To make me fight at land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Hadst thou done so,",
          "plainText": "Hadst thou done so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "The kings that have revolted and the soldier",
          "plainText": "The kings that have revolted and the soldier",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "That has this morning left thee would have still",
          "plainText": "That has this morning left thee would have still",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "Followed thy heels.",
          "plainText": "Followed thy heels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Who's gone this morning?",
          "plainText": "Who's gone this morning",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Who?",
          "plainText": "Who",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "One ever near thee. Call for Enobarbus,",
          "plainText": "One ever near thee Call for Enobarbus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "He shall not hear thee, or from Caesar's camp",
          "plainText": "He shall not hear thee or from Caesar's camp",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "Say \"I am none of thine.\"",
          "plainText": "Say I am none of thine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "What sayest thou?",
          "plainText": "What sayest thou",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Sir,",
          "plainText": "Sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "He is with Caesar.",
          "plainText": "He is with Caesar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Sir, his chests and treasure",
          "plainText": "Sir his chests and treasure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "He has not with him.",
          "plainText": "He has not with him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Is he gone?",
          "plainText": "Is he gone",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Most certain.",
          "plainText": "Most certain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-5-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Go, Eros, send his treasure after. Do it.",
          "plainText": "Go Eros send his treasure after Do it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Detain no jot, I charge thee. Write to him—",
          "plainText": "Detain no jot I charge thee Write to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "I will subscribe—gentle adieus and greetings.",
          "plainText": "I will subscribegentle adieus and greetings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Say that I wish he never find more cause",
          "plainText": "Say that I wish he never find more cause",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "To change a master. O, my fortunes have",
          "plainText": "To change a master O my fortunes have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-5-line-0025",
          "number": 25,
          "speechLineNumber": 6,
          "text": "Corrupted honest men! Dispatch.—Enobarbus!",
          "plainText": "Corrupted honest men DispatchEnobarbus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-5-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}