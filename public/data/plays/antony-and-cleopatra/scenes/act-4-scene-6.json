  "scene": {
    "id": "antony-and-cleopatra-4-6",
    "act": 4,
    "scene": 6,
    "label": "Act 4, Scene 6",
    "title": "SCENE VI. Alexandria. Caesar's camp.",
    "location": "Alexandria. Caesar's camp.",
    "orderInPlay": 31
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-6-stage-001",
      "type": "stage",
      "text": "Flourish. Enter Agrippa, Caesar with Enobarbus and Dolabella."
    },
    {
      "id": "antony-and-cleopatra-4-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Go forth, Agrippa, and begin the fight.",
          "plainText": "Go forth Agrippa and begin the fight",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Our will is Antony be took alive;",
          "plainText": "Our will is Antony be took alive",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Make it so known.",
          "plainText": "Make it so known",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-6-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Caesar, I shall.",
          "plainText": "Caesar I shall",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-6-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "antony-and-cleopatra-4-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-6-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "The time of universal peace is near.",
          "plainText": "The time of universal peace is near",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Prove this a prosp'rous day, the three-nooked world",
          "plainText": "Prove this a prosp'rous day the threenooked world",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "Shall bear the olive freely.",
          "plainText": "Shall bear the olive freely",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-6-stage-003",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "antony-and-cleopatra-4-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-6-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Antony",
          "plainText": "Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Is come into the field.",
          "plainText": "Is come into the field",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "caesar",
        "name": "CAESAR",
        "displayName": "Caesar"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-6-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Go charge Agrippa",
          "plainText": "Go charge Agrippa",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "Plant those that have revolted in the van",
          "plainText": "Plant those that have revolted in the van",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "That Antony may seem to spend his fury",
          "plainText": "That Antony may seem to spend his fury",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "Upon himself.",
          "plainText": "Upon himself",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-6-stage-004",
      "type": "stage",
      "text": "[Exeunt Caesar and his Train.]"
    },
    {
      "id": "antony-and-cleopatra-4-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-6-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Alexas did revolt and went to Jewry on",
          "plainText": "Alexas did revolt and went to Jewry on",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Affairs of Antony; there did dissuade",
          "plainText": "Affairs of Antony there did dissuade",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "Great Herod to incline himself to Caesar",
          "plainText": "Great Herod to incline himself to Caesar",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "And leave his master Antony. For this pains",
          "plainText": "And leave his master Antony For this pains",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "Caesar hath hanged him. Canidius and the rest",
          "plainText": "Caesar hath hanged him Canidius and the rest",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0019",
          "number": 19,
          "speechLineNumber": 6,
          "text": "That fell away have entertainment but",
          "plainText": "That fell away have entertainment but",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0020",
          "number": 20,
          "speechLineNumber": 7,
          "text": "No honourable trust. I have done ill,",
          "plainText": "No honourable trust I have done ill",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0021",
          "number": 21,
          "speechLineNumber": 8,
          "text": "Of which I do accuse myself so sorely",
          "plainText": "Of which I do accuse myself so sorely",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0022",
          "number": 22,
          "speechLineNumber": 9,
          "text": "That I will joy no more.",
          "plainText": "That I will joy no more",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-6-stage-005",
      "type": "stage",
      "text": "Enter a Soldier of Caesar's."
    },
    {
      "id": "antony-and-cleopatra-4-6-speech-007",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-6-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Enobarbus, Antony",
          "plainText": "Enobarbus Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Hath after thee sent all thy treasure, with",
          "plainText": "Hath after thee sent all thy treasure with",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "His bounty overplus. The messenger",
          "plainText": "His bounty overplus The messenger",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "Came on my guard, and at thy tent is now",
          "plainText": "Came on my guard and at thy tent is now",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "Unloading of his mules.",
          "plainText": "Unloading of his mules",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-6-speech-008",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-6-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "I give it you.",
          "plainText": "I give it you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-6-speech-009",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-6-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Mock not, Enobarbus.",
          "plainText": "Mock not Enobarbus",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "I tell you true. Best you safed the bringer",
          "plainText": "I tell you true Best you safed the bringer",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "Out of the host. I must attend mine office,",
          "plainText": "Out of the host I must attend mine office",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "Or would have done't myself. Your emperor",
          "plainText": "Or would have done't myself Your emperor",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0033",
          "number": 33,
          "speechLineNumber": 5,
          "text": "Continues still a Jove.",
          "plainText": "Continues still a Jove",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-6-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "antony-and-cleopatra-4-6-speech-010",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-6-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "I am alone the villain of the earth,",
          "plainText": "I am alone the villain of the earth",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "And feel I am so most. O Antony,",
          "plainText": "And feel I am so most O Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Thou mine of bounty, how wouldst thou have paid",
          "plainText": "Thou mine of bounty how wouldst thou have paid",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "My better service, when my turpitude",
          "plainText": "My better service when my turpitude",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "Thou dost so crown with gold! This blows my heart.",
          "plainText": "Thou dost so crown with gold This blows my heart",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0039",
          "number": 39,
          "speechLineNumber": 6,
          "text": "If swift thought break it not, a swifter mean",
          "plainText": "If swift thought break it not a swifter mean",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0040",
          "number": 40,
          "speechLineNumber": 7,
          "text": "Shall outstrike thought, but thought will do't, I feel.",
          "plainText": "Shall outstrike thought but thought will do't I feel",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0041",
          "number": 41,
          "speechLineNumber": 8,
          "text": "I fight against thee! No, I will go seek",
          "plainText": "I fight against thee No I will go seek",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0042",
          "number": 42,
          "speechLineNumber": 9,
          "text": "Some ditch wherein to die; the foul'st best fits",
          "plainText": "Some ditch wherein to die the foul'st best fits",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-6-line-0043",
          "number": 43,
          "speechLineNumber": 10,
          "text": "My latter part of life.",
          "plainText": "My latter part of life",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-6-stage-007",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}