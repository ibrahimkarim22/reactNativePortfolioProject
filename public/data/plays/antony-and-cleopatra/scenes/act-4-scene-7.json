  "scene": {
    "id": "antony-and-cleopatra-4-7",
    "act": 4,
    "scene": 7,
    "label": "Act 4, Scene 7",
    "title": "SCENE VII. Field of battle between the Camps.",
    "location": "Field of battle between the Camps.",
    "orderInPlay": 32
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-7-stage-001",
      "type": "stage",
      "text": "Alarum. Drums and Trumpets. Enter Agrippa and others."
    },
    {
      "id": "antony-and-cleopatra-4-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "agrippa",
        "name": "AGRIPPA",
        "displayName": "Agrippa"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Retire! We have engaged ourselves too far.",
          "plainText": "Retire We have engaged ourselves too far",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Caesar himself has work, and our oppression",
          "plainText": "Caesar himself has work and our oppression",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Exceeds what we expected.",
          "plainText": "Exceeds what we expected",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-7-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    },
    {
      "id": "antony-and-cleopatra-4-7-stage-003",
      "type": "stage",
      "text": "Alarums. Enter Antony and Scarus wounded."
    },
    {
      "id": "antony-and-cleopatra-4-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-7-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "O my brave emperor, this is fought indeed!",
          "plainText": "O my brave emperor this is fought indeed",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Had we done so at first, we had droven them home",
          "plainText": "Had we done so at first we had droven them home",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "With clouts about their heads.",
          "plainText": "With clouts about their heads",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-7-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Thou bleed'st apace.",
          "plainText": "Thou bleed'st apace",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-7-speech-004",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-7-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I had a wound here that was like a T,",
          "plainText": "I had a wound here that was like a T",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "But now 'tis made an H.",
          "plainText": "But now 'tis made an H",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-7-stage-004",
      "type": "stage",
      "text": "Sounds retreat far off."
    },
    {
      "id": "antony-and-cleopatra-4-7-speech-005",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-7-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "They do retire.",
          "plainText": "They do retire",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-7-speech-006",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-7-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "We'll beat 'em into bench-holes. I have yet",
          "plainText": "We'll beat 'em into benchholes I have yet",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Room for six scotches more.",
          "plainText": "Room for six scotches more",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-7-stage-005",
      "type": "stage",
      "text": "Enter Eros."
    },
    {
      "id": "antony-and-cleopatra-4-7-speech-007",
      "type": "speech",
      "speaker": {
        "id": "eros",
        "name": "EROS",
        "displayName": "Eros"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-7-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "They are beaten, sir, and our advantage serves",
          "plainText": "They are beaten sir and our advantage serves",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "For a fair victory.",
          "plainText": "For a fair victory",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-7-speech-008",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-7-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Let us score their backs",
          "plainText": "Let us score their backs",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "And snatch 'em up as we take hares, behind.",
          "plainText": "And snatch 'em up as we take hares behind",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "'Tis sport to maul a runner.",
          "plainText": "'Tis sport to maul a runner",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-7-speech-009",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-7-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "I will reward thee",
          "plainText": "I will reward thee",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Once for thy sprightly comfort, and tenfold",
          "plainText": "Once for thy sprightly comfort and tenfold",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-7-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "For thy good valour. Come thee on.",
          "plainText": "For thy good valour Come thee on",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-7-speech-010",
      "type": "speech",
      "speaker": {
        "id": "scarus",
        "name": "SCARUS",
        "displayName": "Scarus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-7-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "I'll halt after.",
          "plainText": "I'll halt after",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-7-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}