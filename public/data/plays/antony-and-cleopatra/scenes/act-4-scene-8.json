  "scene": {
    "id": "antony-and-cleopatra-4-8",
    "act": 4,
    "scene": 8,
    "label": "Act 4, Scene 8",
    "title": "SCENE VIII. Under the Walls of Alexandria.",
    "location": "Under the Walls of Alexandria.",
    "orderInPlay": 33
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-8-stage-001",
      "type": "stage",
      "text": "Alarum. Enter Antony again in a march; Scarus with others."
    },
    {
      "id": "antony-and-cleopatra-4-8-speech-001",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-8-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "We have beat him to his camp. Run one before",
          "plainText": "We have beat him to his camp Run one before",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And let the Queen know of our gests.",
          "plainText": "And let the Queen know of our gests",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Tomorrow,",
          "plainText": "Tomorrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Before the sun shall see's, we'll spill the blood",
          "plainText": "Before the sun shall see's we'll spill the blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "That has today escaped. I thank you all,",
          "plainText": "That has today escaped I thank you all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "For doughty-handed are you, and have fought",
          "plainText": "For doughtyhanded are you and have fought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Not as you served the cause, but as't had been",
          "plainText": "Not as you served the cause but as't had been",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Each man's like mine. You have shown all Hectors.",
          "plainText": "Each man's like mine You have shown all Hectors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Enter the city, clip your wives, your friends,",
          "plainText": "Enter the city clip your wives your friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Tell them your feats; whilst they with joyful tears",
          "plainText": "Tell them your feats whilst they with joyful tears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Wash the congealment from your wounds and kiss",
          "plainText": "Wash the congealment from your wounds and kiss",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "The honoured gashes whole.",
          "plainText": "The honoured gashes whole",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-8-stage-002",
      "type": "stage",
      "text": "Enter Cleopatra."
    },
    {
      "id": "antony-and-cleopatra-4-8-speech-002",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-8-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Lord of lords!",
          "plainText": "Lord of lords",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "O infinite virtue, com'st thou smiling from",
          "plainText": "O infinite virtue com'st thou smiling from",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "The world's great snare uncaught?",
          "plainText": "The world's great snare uncaught",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-8-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-8-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Mine nightingale,",
          "plainText": "Mine nightingale",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "We have beat them to their beds. What, girl! Though grey",
          "plainText": "We have beat them to their beds What girl Though grey",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Do something mingle with our younger brown, yet ha' we",
          "plainText": "Do something mingle with our younger brown yet ha' we",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "A brain that nourishes our nerves and can",
          "plainText": "A brain that nourishes our nerves and can",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "Get goal for goal of youth. Behold this man.",
          "plainText": "Get goal for goal of youth Behold this man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0021",
          "number": 21,
          "speechLineNumber": 6,
          "text": "Commend unto his lips thy favouring hand.—",
          "plainText": "Commend unto his lips thy favouring hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0022",
          "number": 22,
          "speechLineNumber": 7,
          "text": "Kiss it, my warrior. He hath fought today",
          "plainText": "Kiss it my warrior He hath fought today",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0023",
          "number": 23,
          "speechLineNumber": 8,
          "text": "As if a god, in hate of mankind, had",
          "plainText": "As if a god in hate of mankind had",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0024",
          "number": 24,
          "speechLineNumber": 9,
          "text": "Destroyed in such a shape.",
          "plainText": "Destroyed in such a shape",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-8-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cleopatra",
        "name": "CLEOPATRA",
        "displayName": "Cleopatra"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-8-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "I'll give thee, friend,",
          "plainText": "I'll give thee friend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "An armour all of gold. It was a king's.",
          "plainText": "An armour all of gold It was a king's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-8-speech-005",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-8-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "He has deserved it, were it carbuncled",
          "plainText": "He has deserved it were it carbuncled",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Like holy Phœbus' car. Give me thy hand.",
          "plainText": "Like holy Phbus' car Give me thy hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "Through Alexandria make a jolly march;",
          "plainText": "Through Alexandria make a jolly march",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "Bear our hacked targets like the men that owe them.",
          "plainText": "Bear our hacked targets like the men that owe them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "Had our great palace the capacity",
          "plainText": "Had our great palace the capacity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0032",
          "number": 32,
          "speechLineNumber": 6,
          "text": "To camp this host, we all would sup together",
          "plainText": "To camp this host we all would sup together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0033",
          "number": 33,
          "speechLineNumber": 7,
          "text": "And drink carouses to the next day's fate,",
          "plainText": "And drink carouses to the next day's fate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0034",
          "number": 34,
          "speechLineNumber": 8,
          "text": "Which promises royal peril.—Trumpeters,",
          "plainText": "Which promises royal perilTrumpeters",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0035",
          "number": 35,
          "speechLineNumber": 9,
          "text": "With brazen din blast you the city's ear;",
          "plainText": "With brazen din blast you the city's ear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0036",
          "number": 36,
          "speechLineNumber": 10,
          "text": "Make mingle with our rattling tabourines,",
          "plainText": "Make mingle with our rattling tabourines",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0037",
          "number": 37,
          "speechLineNumber": 11,
          "text": "That heaven and earth may strike their sounds together,",
          "plainText": "That heaven and earth may strike their sounds together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "antony-and-cleopatra-4-8-line-0038",
          "number": 38,
          "speechLineNumber": 12,
          "text": "Applauding our approach.",
          "plainText": "Applauding our approach",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-8-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}