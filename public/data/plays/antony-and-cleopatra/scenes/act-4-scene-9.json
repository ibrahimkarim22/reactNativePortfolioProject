  "scene": {
    "id": "antony-and-cleopatra-4-9",
    "act": 4,
    "scene": 9,
    "label": "Act 4, Scene 9",
    "title": "SCENE IX. Caesar's camp.",
    "location": "Caesar's camp.",
    "orderInPlay": 34
  },
  "content": [
    {
      "id": "antony-and-cleopatra-4-9-stage-001",
      "type": "stage",
      "text": "Enter a Sentry and his company. Enobarbus follows."
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-001",
      "type": "speech",
      "speaker": {
        "id": "sentry",
        "name": "SENTRY",
        "displayName": "Sentry"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "If we be not relieved within this hour,",
          "plainText": "If we be not relieved within this hour",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "We must return to th' court of guard. The night",
          "plainText": "We must return to th' court of guard The night",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Is shiny, and they say we shall embattle",
          "plainText": "Is shiny and they say we shall embattle",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "By th' second hour i' th' morn.",
          "plainText": "By th' second hour i' th' morn",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-002",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "This last day was a shrewd one to's.",
          "plainText": "This last day was a shrewd one to's",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-003",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "O, bear me witness, night.—",
          "plainText": "O bear me witness night",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "What man is this?",
          "plainText": "What man is this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-005",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Stand close and list him.",
          "plainText": "Stand close and list him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-006",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Be witness to me, O thou blessed moon,",
          "plainText": "Be witness to me O thou blessed moon",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "When men revolted shall upon record",
          "plainText": "When men revolted shall upon record",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Bear hateful memory, poor Enobarbus did",
          "plainText": "Bear hateful memory poor Enobarbus did",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "Before thy face repent.",
          "plainText": "Before thy face repent",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-007",
      "type": "speech",
      "speaker": {
        "id": "sentry",
        "name": "SENTRY",
        "displayName": "Sentry"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Enobarbus?",
          "plainText": "Enobarbus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-008",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Peace! Hark further.",
          "plainText": "Peace Hark further",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-009",
      "type": "speech",
      "speaker": {
        "id": "enobarbus",
        "name": "ENOBARBUS",
        "displayName": "Enobarbus"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "O sovereign mistress of true melancholy,",
          "plainText": "O sovereign mistress of true melancholy",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "The poisonous damp of night disponge upon me,",
          "plainText": "The poisonous damp of night disponge upon me",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "That life, a very rebel to my will,",
          "plainText": "That life a very rebel to my will",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "May hang no longer on me. Throw my heart",
          "plainText": "May hang no longer on me Throw my heart",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0019",
          "number": 19,
          "speechLineNumber": 5,
          "text": "Against the flint and hardness of my fault,",
          "plainText": "Against the flint and hardness of my fault",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0020",
          "number": 20,
          "speechLineNumber": 6,
          "text": "Which, being dried with grief, will break to powder",
          "plainText": "Which being dried with grief will break to powder",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0021",
          "number": 21,
          "speechLineNumber": 7,
          "text": "And finish all foul thoughts. O Antony,",
          "plainText": "And finish all foul thoughts O Antony",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0022",
          "number": 22,
          "speechLineNumber": 8,
          "text": "Nobler than my revolt is infamous,",
          "plainText": "Nobler than my revolt is infamous",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0023",
          "number": 23,
          "speechLineNumber": 9,
          "text": "Forgive me in thine own particular,",
          "plainText": "Forgive me in thine own particular",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0024",
          "number": 24,
          "speechLineNumber": 10,
          "text": "But let the world rank me in register",
          "plainText": "But let the world rank me in register",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0025",
          "number": 25,
          "speechLineNumber": 11,
          "text": "A master-leaver and a fugitive.",
          "plainText": "A masterleaver and a fugitive",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0026",
          "number": 26,
          "speechLineNumber": 12,
          "text": "O Antony! O Antony!",
          "plainText": "O Antony O Antony",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-stage-002",
      "type": "stage",
      "text": "[Dies.]"
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-010",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Let's speak to him.",
          "plainText": "Let's speak to him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-011",
      "type": "speech",
      "speaker": {
        "id": "sentry",
        "name": "SENTRY",
        "displayName": "Sentry"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Let's hear him, for the things he speaks may concern Caesar.",
          "plainText": "Let's hear him for the things he speaks may concern Caesar",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-012",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Let's do so. But he sleeps.",
          "plainText": "Let's do so But he sleeps",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-013",
      "type": "speech",
      "speaker": {
        "id": "sentry",
        "name": "SENTRY",
        "displayName": "Sentry"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Swoons rather, for so bad a prayer as his",
          "plainText": "Swoons rather for so bad a prayer as his",
          "lineType": "verse"
        },
        {
          "id": "antony-and-cleopatra-4-9-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "Was never yet for sleep.",
          "plainText": "Was never yet for sleep",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-014",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Go we to him.",
          "plainText": "Go we to him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-015",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Awake, sir, awake! Speak to us.",
          "plainText": "Awake sir awake Speak to us",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-016",
      "type": "speech",
      "speaker": {
        "id": "first-watch",
        "name": "FIRST WATCH",
        "displayName": "First Watch"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Hear you, sir?",
          "plainText": "Hear you sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-017",
      "type": "speech",
      "speaker": {
        "id": "sentry",
        "name": "SENTRY",
        "displayName": "Sentry"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "The hand of death hath raught him.",
          "plainText": "The hand of death hath raught him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-stage-003",
      "type": "stage",
      "text": "[Drums afar off.]"
    },
    {
      "id": "antony-and-cleopatra-4-9-speech-018",
      "type": "speech",
      "speaker": {
        "id": "second-watch",
        "name": "SECOND WATCH",
        "displayName": "Second Watch"
      },
      "lines": [
        {
          "id": "antony-and-cleopatra-4-9-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Come on, then. He may recover yet.",
          "plainText": "Come on then He may recover yet",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "antony-and-cleopatra-4-9-stage-004",
      "type": "stage",
      "text": "[Exeunt with the body.]"
    }
  ]
}