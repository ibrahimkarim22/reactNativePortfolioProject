  "content": [
    {
      "id": "as-you-like-it-2-4-stage-001",
      "type": "stage",
      "text": "Enter Rosalind as Ganymede, Celia as Aliena, and Touchstone."
    },
    {
      "id": "as-you-like-it-2-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "O Jupiter, how weary are my spirits!",
          "plainText": "O Jupiter how weary are my spirits",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "I care not for my spirits, if my legs were not weary.",
          "plainText": "I care not for my spirits if my legs were not weary",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "I could find in my heart to disgrace my man's apparel, and to cry like a woman, but I must comfort the weaker vessel, as doublet and hose ought to show itself courageous to petticoat. Therefore, courage, good Aliena.",
          "plainText": "I could find in my heart to disgrace my man's apparel and to cry like a woman but I must comfort the weaker vessel as doublet and hose ought to show itself courageous to petticoat Therefore courage good Aliena",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I pray you bear with me, I cannot go no further.",
          "plainText": "I pray you bear with me I cannot go no further",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "For my part, I had rather bear with you than bear you. Yet I should bear no cross if I did bear you, for I think you have no money in your purse.",
          "plainText": "For my part I had rather bear with you than bear you Yet I should bear no cross if I did bear you for I think you have no money in your purse",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Well, this is the forest of Arden.",
          "plainText": "Well this is the forest of Arden",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Ay, now am I in Arden, the more fool I! When I was at home I was in a better place, but travellers must be content.",
          "plainText": "Ay now am I in Arden the more fool I When I was at home I was in a better place but travellers must be content",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-stage-002",
      "type": "stage",
      "text": "Enter Corin and Silvius."
    },
    {
      "id": "as-you-like-it-2-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Ay, be so, good Touchstone. Look you, who comes here? A young man and an old in solemn talk.",
          "plainText": "Ay be so good Touchstone Look you who comes here A young man and an old in solemn talk",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "That is the way to make her scorn you still.",
          "plainText": "That is the way to make her scorn you still",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "silvius",
        "name": "SILVIUS",
        "displayName": "Silvius"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "O Corin, that thou knew'st how I do love her!",
          "plainText": "O Corin that thou knew'st how I do love her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "I partly guess, for I have loved ere now.",
          "plainText": "I partly guess for I have loved ere now",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "silvius",
        "name": "SILVIUS",
        "displayName": "Silvius"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "No, Corin, being old, thou canst not guess,",
          "plainText": "No Corin being old thou canst not guess",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Though in thy youth thou wast as true a lover",
          "plainText": "Though in thy youth thou wast as true a lover",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "As ever sighed upon a midnight pillow.",
          "plainText": "As ever sighed upon a midnight pillow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "But if thy love were ever like to mine—",
          "plainText": "But if thy love were ever like to mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "As sure I think did never man love so—",
          "plainText": "As sure I think did never man love so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "How many actions most ridiculous",
          "plainText": "How many actions most ridiculous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0018",
          "number": 18,
          "speechLineNumber": 7,
          "text": "Hast thou been drawn to by thy fantasy?",
          "plainText": "Hast thou been drawn to by thy fantasy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Into a thousand that I have forgotten.",
          "plainText": "Into a thousand that I have forgotten",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "silvius",
        "name": "SILVIUS",
        "displayName": "Silvius"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "O, thou didst then never love so heartily!",
          "plainText": "O thou didst then never love so heartily",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "If thou rememb'rest not the slightest folly",
          "plainText": "If thou rememb'rest not the slightest folly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "That ever love did make thee run into,",
          "plainText": "That ever love did make thee run into",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Thou hast not loved.",
          "plainText": "Thou hast not loved",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "Or if thou hast not sat as I do now,",
          "plainText": "Or if thou hast not sat as I do now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0025",
          "number": 25,
          "speechLineNumber": 6,
          "text": "Wearing thy hearer in thy mistress' praise,",
          "plainText": "Wearing thy hearer in thy mistress' praise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0026",
          "number": 26,
          "speechLineNumber": 7,
          "text": "Thou hast not loved.",
          "plainText": "Thou hast not loved",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0027",
          "number": 27,
          "speechLineNumber": 8,
          "text": "Or if thou hast not broke from company",
          "plainText": "Or if thou hast not broke from company",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0028",
          "number": 28,
          "speechLineNumber": 9,
          "text": "Abruptly, as my passion now makes me,",
          "plainText": "Abruptly as my passion now makes me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0029",
          "number": 29,
          "speechLineNumber": 10,
          "text": "Thou hast not loved.",
          "plainText": "Thou hast not loved",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0030",
          "number": 30,
          "speechLineNumber": 11,
          "text": "O Phoebe, Phoebe, Phoebe!",
          "plainText": "O Phoebe Phoebe Phoebe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-stage-003",
      "type": "stage",
      "text": "[Exit Silvius.]"
    },
    {
      "id": "as-you-like-it-2-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Alas, poor shepherd, searching of thy wound,",
          "plainText": "Alas poor shepherd searching of thy wound",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "I have by hard adventure found mine own.",
          "plainText": "I have by hard adventure found mine own",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "And I mine. I remember when I was in love I broke my sword upon a stone and bid him take that for coming a-night to Jane Smile; and I remember the kissing of her batlet, and the cow's dugs that her pretty chopped hands had milked; and I remember the wooing of a peascod instead of her, from whom I took two cods, and, giving her them again, said with weeping tears, \"Wear these for my sake.\" We that are true lovers run into strange capers. But as all is mortal in nature, so is all nature in love mortal in folly.",
          "plainText": "And I mine I remember when I was in love I broke my sword upon a stone and bid him take that for coming anight to Jane Smile and I remember the kissing of her batlet and the cow's dugs that her pretty chopped hands had milked and I remember the wooing of a peascod instead of her from whom I took two cods and giving her them again said with weeping tears Wear these for my sake We that are true lovers run into strange capers But as all is mortal in nature so is all nature in love mortal in folly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Thou speak'st wiser than thou art ware of.",
          "plainText": "Thou speak'st wiser than thou art ware of",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Nay, I shall ne'er be ware of mine own wit till I break my shins against it.",
          "plainText": "Nay I shall ne'er be ware of mine own wit till I break my shins against it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Jove, Jove, this shepherd's passion",
          "plainText": "Jove Jove this shepherd's passion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "Is much upon my fashion.",
          "plainText": "Is much upon my fashion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "And mine, but it grows something stale with me.",
          "plainText": "And mine but it grows something stale with me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "I pray you, one of you question yond man",
          "plainText": "I pray you one of you question yond man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "If he for gold will give us any food.",
          "plainText": "If he for gold will give us any food",
          "lineType": "verse",
          "lineTypeDetection": "auto",
