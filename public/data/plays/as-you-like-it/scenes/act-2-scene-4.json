        },
        {
          "id": "as-you-like-it-2-4-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "I faint almost to death.",
          "plainText": "I faint almost to death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Holla, you clown!",
          "plainText": "Holla you clown",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Peace, fool, he's not thy kinsman.",
          "plainText": "Peace fool he's not thy kinsman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Who calls?",
          "plainText": "Who calls",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-025",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Your betters, sir.",
          "plainText": "Your betters sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-026",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Else are they very wretched.",
          "plainText": "Else are they very wretched",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-027",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Peace, I say.—Good even to you, friend.",
          "plainText": "Peace I sayGood even to you friend",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-028",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "And to you, gentle sir, and to you all.",
          "plainText": "And to you gentle sir and to you all",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-029",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "I prithee, shepherd, if that love or gold",
          "plainText": "I prithee shepherd if that love or gold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Can in this desert place buy entertainment,",
          "plainText": "Can in this desert place buy entertainment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "Bring us where we may rest ourselves and feed.",
          "plainText": "Bring us where we may rest ourselves and feed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "Here's a young maid with travel much oppressed,",
          "plainText": "Here's a young maid with travel much oppressed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0053",
          "number": 53,
          "speechLineNumber": 5,
          "text": "And faints for succour.",
          "plainText": "And faints for succour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-030",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Fair sir, I pity her",
          "plainText": "Fair sir I pity her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "And wish, for her sake more than for mine own,",
          "plainText": "And wish for her sake more than for mine own",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0056",
          "number": 56,
          "speechLineNumber": 3,
          "text": "My fortunes were more able to relieve her.",
          "plainText": "My fortunes were more able to relieve her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0057",
          "number": 57,
          "speechLineNumber": 4,
          "text": "But I am shepherd to another man",
          "plainText": "But I am shepherd to another man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0058",
          "number": 58,
          "speechLineNumber": 5,
          "text": "And do not shear the fleeces that I graze.",
          "plainText": "And do not shear the fleeces that I graze",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0059",
          "number": 59,
          "speechLineNumber": 6,
          "text": "My master is of churlish disposition",
          "plainText": "My master is of churlish disposition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0060",
          "number": 60,
          "speechLineNumber": 7,
          "text": "And little recks to find the way to heaven",
          "plainText": "And little recks to find the way to heaven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0061",
          "number": 61,
          "speechLineNumber": 8,
          "text": "By doing deeds of hospitality.",
          "plainText": "By doing deeds of hospitality",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0062",
          "number": 62,
          "speechLineNumber": 9,
          "text": "Besides, his cote, his flocks, and bounds of feed",
          "plainText": "Besides his cote his flocks and bounds of feed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0063",
          "number": 63,
          "speechLineNumber": 10,
          "text": "Are now on sale, and at our sheepcote now,",
          "plainText": "Are now on sale and at our sheepcote now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0064",
          "number": 64,
          "speechLineNumber": 11,
          "text": "By reason of his absence, there is nothing",
          "plainText": "By reason of his absence there is nothing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0065",
          "number": 65,
          "speechLineNumber": 12,
          "text": "That you will feed on. But what is, come see,",
          "plainText": "That you will feed on But what is come see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0066",
          "number": 66,
          "speechLineNumber": 13,
          "text": "And in my voice most welcome shall you be.",
          "plainText": "And in my voice most welcome shall you be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-031",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "What is he that shall buy his flock and pasture?",
          "plainText": "What is he that shall buy his flock and pasture",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-032",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "That young swain that you saw here but erewhile,",
          "plainText": "That young swain that you saw here but erewhile",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "That little cares for buying anything.",
          "plainText": "That little cares for buying anything",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-033",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "I pray thee, if it stand with honesty,",
          "plainText": "I pray thee if it stand with honesty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "Buy thou the cottage, pasture, and the flock,",
          "plainText": "Buy thou the cottage pasture and the flock",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0072",
          "number": 72,
          "speechLineNumber": 3,
          "text": "And thou shalt have to pay for it of us.",
          "plainText": "And thou shalt have to pay for it of us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-034",
      "type": "speech",
      "speaker": {
        "id": "celia",
        "name": "CELIA",
        "displayName": "Celia"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "And we will mend thy wages. I like this place,",
          "plainText": "And we will mend thy wages I like this place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0074",
          "number": 74,
          "speechLineNumber": 2,
          "text": "And willingly could waste my time in it.",
          "plainText": "And willingly could waste my time in it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-speech-035",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-4-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Assuredly the thing is to be sold.",
          "plainText": "Assuredly the thing is to be sold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "Go with me. If you like upon report",
          "plainText": "Go with me If you like upon report",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0077",
          "number": 77,
          "speechLineNumber": 3,
          "text": "The soil, the profit, and this kind of life,",
          "plainText": "The soil the profit and this kind of life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0078",
          "number": 78,
          "speechLineNumber": 4,
          "text": "I will your very faithful feeder be,",
          "plainText": "I will your very faithful feeder be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-2-4-line-0079",
          "number": 79,
          "speechLineNumber": 5,
          "text": "And buy it with your gold right suddenly.",
          "plainText": "And buy it with your gold right suddenly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-4-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
