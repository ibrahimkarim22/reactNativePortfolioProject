  },
  "content": [
    {
      "id": "as-you-like-it-2-5-stage-001",
      "type": "stage",
      "text": "Enter Amiens, Jaques and others."
    },
    {
      "id": "as-you-like-it-2-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "amiens",
        "name": "AMIENS",
        "displayName": "Amiens"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "[Sings.]",
          "plainText": "Sings",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "More, more, I prithee, more.",
          "plainText": "More more I prithee more",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "amiens",
        "name": "AMIENS",
        "displayName": "Amiens"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "It will make you melancholy, Monsieur Jaques.",
          "plainText": "It will make you melancholy Monsieur Jaques",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I thank it. More, I prithee, more. I can suck melancholy out of a song as a weasel sucks eggs. More, I prithee, more.",
          "plainText": "I thank it More I prithee more I can suck melancholy out of a song as a weasel sucks eggs More I prithee more",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "amiens",
        "name": "AMIENS",
        "displayName": "Amiens"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "My voice is ragged. I know I cannot please you.",
          "plainText": "My voice is ragged I know I cannot please you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "I do not desire you to please me; I do desire you to sing. Come, more, another stanzo. Call you 'em stanzos?",
          "plainText": "I do not desire you to please me I do desire you to sing Come more another stanzo Call you 'em stanzos",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "amiens",
        "name": "AMIENS",
        "displayName": "Amiens"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "What you will, Monsieur Jaques.",
          "plainText": "What you will Monsieur Jaques",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Nay, I care not for their names. They owe me nothing. Will you sing?",
          "plainText": "Nay I care not for their names They owe me nothing Will you sing",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "amiens",
        "name": "AMIENS",
        "displayName": "Amiens"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "More at your request than to please myself.",
          "plainText": "More at your request than to please myself",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Well then, if ever I thank any man, I'll thank you; but that they call compliment is like th' encounter of two dog-apes. And when a man thanks me heartily, methinks I have given him a penny and he renders me the beggarly thanks. Come, sing; and you that will not, hold your tongues.",
          "plainText": "Well then if ever I thank any man I'll thank you but that they call compliment is like th' encounter of two dogapes And when a man thanks me heartily methinks I have given him a penny and he renders me the beggarly thanks Come sing and you that will not hold your tongues",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "amiens",
        "name": "AMIENS",
        "displayName": "Amiens"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Well, I'll end the song.—Sirs, cover the while. The Duke will drink under this tree; he hath been all this day to look you.",
          "plainText": "Well I'll end the songSirs cover the while The Duke will drink under this tree he hath been all this day to look you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "And I have been all this day to avoid him. He is too disputable for my company. I think of as many matters as he, but I give heaven thanks and make no boast of them. Come, warble, come.",
          "plainText": "And I have been all this day to avoid him He is too disputable for my company I think of as many matters as he but I give heaven thanks and make no boast of them Come warble come",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "amiens",
        "name": "AMIENS",
        "displayName": "Amiens"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "[Sings.]",
          "plainText": "Sings",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "I'll give you a verse to this note that I made yesterday in despite of my invention.",
          "plainText": "I'll give you a verse to this note that I made yesterday in despite of my invention",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "amiens",
        "name": "AMIENS",
        "displayName": "Amiens"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "And I'll sing it.",
          "plainText": "And I'll sing it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Thus it goes:",
          "plainText": "Thus it goes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "amiens",
        "name": "AMIENS",
        "displayName": "Amiens"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "What's that \"ducdame?\"",
          "plainText": "What's that ducdame",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "'Tis a Greek invocation to call fools into a circle. I'll go sleep if I can; if I cannot, I'll rail against all the first-born of Egypt.",
          "plainText": "'Tis a Greek invocation to call fools into a circle I'll go sleep if I can if I cannot I'll rail against all the firstborn of Egypt",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "amiens",
        "name": "AMIENS",
        "displayName": "Amiens"
      },
      "lines": [
        {
          "id": "as-you-like-it-2-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "And I'll go seek the Duke; his banquet is prepared.",
          "plainText": "And I'll go seek the Duke his banquet is prepared",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-2-5-stage-002",
      "type": "stage",
      "text": "[Exeunt severally.]"
    }
  ]
}