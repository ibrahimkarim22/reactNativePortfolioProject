  "scene": {
    "id": "as-you-like-it-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. Another part of the Forest",
    "location": "Another part of the Forest",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "as-you-like-it-4-2-stage-001",
      "type": "stage",
      "text": "Enter Jaques and Lords, like foresters."
    },
    {
      "id": "as-you-like-it-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Which is he that killed the deer?",
          "plainText": "Which is he that killed the deer",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "as-you-like-it-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "as-you-like-it-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Sir, it was I.",
          "plainText": "Sir it was I",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "as-you-like-it-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Let's present him to the Duke, like a Roman conqueror, and it would do well to set the deer's horns upon his head for a branch of victory. Have you no song, forester, for this purpose?",
          "plainText": "Let's present him to the Duke like a Roman conqueror and it would do well to set the deer's horns upon his head for a branch of victory Have you no song forester for this purpose",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "as-you-like-it-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "as-you-like-it-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Yes, sir.",
          "plainText": "Yes sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "as-you-like-it-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "jaques",
        "name": "JAQUES",
        "displayName": "Jaques"
      },
      "lines": [
        {
          "id": "as-you-like-it-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Sing it. 'Tis no matter how it be in tune, so it make noise enough.",
          "plainText": "Sing it 'Tis no matter how it be in tune so it make noise enough",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "as-you-like-it-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "as-you-like-it-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "[Sings.]",
          "plainText": "Sings",
          "lineType": "verse"
        },
        {
          "id": "as-you-like-it-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "What shall he have that killed the deer?",
          "plainText": "What shall he have that killed the deer",
          "lineType": "verse"
        },
        {
          "id": "as-you-like-it-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "His leather skin and horns to wear.",
          "plainText": "His leather skin and horns to wear",
          "lineType": "verse"
        },
        {
          "id": "as-you-like-it-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Then sing him home:",
          "plainText": "Then sing him home",
          "lineType": "verse"
        },
        {
          "id": "as-you-like-it-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "[The rest shall bear this burden.]",
          "plainText": "The rest shall bear this burden",
          "lineType": "verse"
        },
        {
          "id": "as-you-like-it-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 6,
          "text": "Take thou no scorn to wear the horn.",
          "plainText": "Take thou no scorn to wear the horn",
          "lineType": "verse"
        },
        {
          "id": "as-you-like-it-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 7,
          "text": "It was a crest ere thou wast born.",
          "plainText": "It was a crest ere thou wast born",
          "lineType": "verse"
        },
        {
          "id": "as-you-like-it-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 8,
          "text": "Thy father's father wore it",
          "plainText": "Thy father's father wore it",
          "lineType": "verse"
        },
        {
          "id": "as-you-like-it-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 9,
          "text": "And thy father bore it.",
          "plainText": "And thy father bore it",
          "lineType": "verse"
        },
        {
          "id": "as-you-like-it-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 10,
          "text": "The horn, the horn, the lusty horn",
          "plainText": "The horn the horn the lusty horn",
          "lineType": "verse"
        },
        {
          "id": "as-you-like-it-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 11,
          "text": "Is not a thing to laugh to scorn.",
          "plainText": "Is not a thing to laugh to scorn",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "as-you-like-it-4-2-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}