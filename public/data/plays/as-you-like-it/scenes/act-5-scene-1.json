  },
  "content": [
    {
      "id": "as-you-like-it-5-1-stage-001",
      "type": "stage",
      "text": "Enter Touchstone and Audrey."
    },
    {
      "id": "as-you-like-it-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "We shall find a time, Audrey; patience, gentle Audrey.",
          "plainText": "We shall find a time Audrey patience gentle Audrey",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "audrey",
        "name": "AUDREY",
        "displayName": "Audrey"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Faith, the priest was good enough, for all the old gentleman's saying.",
          "plainText": "Faith the priest was good enough for all the old gentleman's saying",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "A most wicked Sir Oliver, Audrey, a most vile Martext. But Audrey, there is a youth here in the forest lays claim to you.",
          "plainText": "A most wicked Sir Oliver Audrey a most vile Martext But Audrey there is a youth here in the forest lays claim to you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "audrey",
        "name": "AUDREY",
        "displayName": "Audrey"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Ay, I know who 'tis. He hath no interest in me in the world.",
          "plainText": "Ay I know who 'tis He hath no interest in me in the world",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-stage-002",
      "type": "stage",
      "text": "Enter William."
    },
    {
      "id": "as-you-like-it-5-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "It is meat and drink to me to see a clown. By my troth, we that have good wits have much to answer for. We shall be flouting; we cannot hold.",
          "plainText": "It is meat and drink to me to see a clown By my troth we that have good wits have much to answer for We shall be flouting we cannot hold",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Good ev'n, Audrey.",
          "plainText": "Good ev'n Audrey",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "audrey",
        "name": "AUDREY",
        "displayName": "Audrey"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "God ye good ev'n, William.",
          "plainText": "God ye good ev'n William",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "And good ev'n to you, sir.",
          "plainText": "And good ev'n to you sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Good ev'n, gentle friend. Cover thy head, cover thy head. Nay, prithee, be covered. How old are you, friend?",
          "plainText": "Good ev'n gentle friend Cover thy head cover thy head Nay prithee be covered How old are you friend",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Five-and-twenty, sir.",
          "plainText": "Fiveandtwenty sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "A ripe age. Is thy name William?",
          "plainText": "A ripe age Is thy name William",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "William, sir.",
          "plainText": "William sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "A fair name. Wast born i' th' forest here?",
          "plainText": "A fair name Wast born i' th' forest here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Ay, sir, I thank God.",
          "plainText": "Ay sir I thank God",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "\"Thank God.\" A good answer. Art rich?",
          "plainText": "Thank God A good answer Art rich",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Faith, sir, so-so.",
          "plainText": "Faith sir soso",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "\"So-so\" is good, very good, very excellent good. And yet it is not, it is but so-so. Art thou wise?",
          "plainText": "Soso is good very good very excellent good And yet it is not it is but soso Art thou wise",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Ay, sir, I have a pretty wit.",
          "plainText": "Ay sir I have a pretty wit",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Why, thou sayst well. I do now remember a saying: \"The fool doth think he is wise, but the wise man knows himself to be a fool.\" The heathen philosopher, when he had a desire to eat a grape, would open his lips when he put it into his mouth, meaning thereby that grapes were made to eat and lips to open. You do love this maid?",
          "plainText": "Why thou sayst well I do now remember a saying The fool doth think he is wise but the wise man knows himself to be a fool The heathen philosopher when he had a desire to eat a grape would open his lips when he put it into his mouth meaning thereby that grapes were made to eat and lips to open You do love this maid",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "I do, sir.",
          "plainText": "I do sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Give me your hand. Art thou learned?",
          "plainText": "Give me your hand Art thou learned",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "No, sir.",
          "plainText": "No sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Then learn this of me: to have is to have. For it is a figure in rhetoric that drink, being poured out of cup into a glass, by filling the one doth empty the other. For all your writers do consent that ipse is \"he.\" Now, you are not ipse, for I am he.",
          "plainText": "Then learn this of me to have is to have For it is a figure in rhetoric that drink being poured out of cup into a glass by filling the one doth empty the other For all your writers do consent that ipse is he Now you are not ipse for I am he",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Which he, sir?",
          "plainText": "Which he sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "He, sir, that must marry this woman. Therefore, you clown, abandon—which is in the vulgar, \"leave\"—the society—which in the boorish is \"company\"—of this female—which in the common is \"woman\"; which together is, abandon the society of this female, or, clown, thou perishest; or, to thy better understanding, diest; or, to wit, I kill thee, make thee away, translate thy life into death, thy liberty into bondage. I will deal in poison with thee, or in bastinado, or in steel. I will bandy with thee in faction; will o'errun thee with policy. I will kill thee a hundred and fifty ways! Therefore tremble and depart.",
          "plainText": "He sir that must marry this woman Therefore you clown abandonwhich is in the vulgar leavethe societywhich in the boorish is companyof this femalewhich in the common is woman which together is abandon the society of this female or clown thou perishest or to thy better understanding diest or to wit I kill thee make thee away translate thy life into death thy liberty into bondage I will deal in poison with thee or in bastinado or in steel I will bandy with thee in faction will o'errun thee with policy I will kill thee a hundred and fifty ways Therefore tremble and depart",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "audrey",
        "name": "AUDREY",
        "displayName": "Audrey"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Do, good William.",
          "plainText": "Do good William",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "william",
        "name": "WILLIAM",
        "displayName": "William"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "God rest you merry, sir.",
          "plainText": "God rest you merry sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "as-you-like-it-5-1-stage-004",
      "type": "stage",
      "text": "Enter Corin."
    },
    {
      "id": "as-you-like-it-5-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "corin",
        "name": "CORIN",
        "displayName": "Corin"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Our master and mistress seek you. Come away, away.",
          "plainText": "Our master and mistress seek you Come away away",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "touchstone",
        "name": "TOUCHSTONE",
        "displayName": "Touchstone"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Trip, Audrey, trip, Audrey! I attend, I attend.",
          "plainText": "Trip Audrey trip Audrey I attend I attend",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-1-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}