  "content": [
    {
      "id": "as-you-like-it-5-2-stage-001",
      "type": "stage",
      "text": "Enter Orlando and Oliver."
    },
    {
      "id": "as-you-like-it-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Is't possible that on so little acquaintance you should like her? That but seeing, you should love her? And loving woo? And wooing, she should grant? And will you persever to enjoy her?",
          "plainText": "Is't possible that on so little acquaintance you should like her That but seeing you should love her And loving woo And wooing she should grant And will you persever to enjoy her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "oliver",
        "name": "OLIVER",
        "displayName": "Oliver"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Neither call the giddiness of it in question, the poverty of her, the small acquaintance, my sudden wooing, nor her sudden consenting. But say with me, I love Aliena; say with her that she loves me; consent with both that we may enjoy each other. It shall be to your good, for my father's house and all the revenue that was old Sir Rowland's will I estate upon you, and here live and die a shepherd.",
          "plainText": "Neither call the giddiness of it in question the poverty of her the small acquaintance my sudden wooing nor her sudden consenting But say with me I love Aliena say with her that she loves me consent with both that we may enjoy each other It shall be to your good for my father's house and all the revenue that was old Sir Rowland's will I estate upon you and here live and die a shepherd",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-stage-002",
      "type": "stage",
      "text": "Enter Rosalind."
    },
    {
      "id": "as-you-like-it-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "You have my consent. Let your wedding be tomorrow. Thither will I invite the Duke and all's contented followers. Go you and prepare Aliena; for, look you, here comes my Rosalind.",
          "plainText": "You have my consent Let your wedding be tomorrow Thither will I invite the Duke and all's contented followers Go you and prepare Aliena for look you here comes my Rosalind",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "God save you, brother.",
          "plainText": "God save you brother",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "oliver",
        "name": "OLIVER",
        "displayName": "Oliver"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "And you, fair sister.",
          "plainText": "And you fair sister",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "as-you-like-it-5-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "O my dear Orlando, how it grieves me to see thee wear thy heart in a scarf!",
          "plainText": "O my dear Orlando how it grieves me to see thee wear thy heart in a scarf",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "It is my arm.",
          "plainText": "It is my arm",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I thought thy heart had been wounded with the claws of a lion.",
          "plainText": "I thought thy heart had been wounded with the claws of a lion",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Wounded it is, but with the eyes of a lady.",
          "plainText": "Wounded it is but with the eyes of a lady",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Did your brother tell you how I counterfeited to swoon when he showed me your handkercher?",
          "plainText": "Did your brother tell you how I counterfeited to swoon when he showed me your handkercher",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Ay, and greater wonders than that.",
          "plainText": "Ay and greater wonders than that",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "O, I know where you are. Nay, 'tis true. There was never anything so sudden but the fight of two rams, and Caesar's thrasonical brag of \"I came, saw and overcame.\" For your brother and my sister no sooner met but they looked; no sooner looked but they loved; no sooner loved but they sighed; no sooner sighed but they asked one another the reason; no sooner knew the reason but they sought the remedy; and in these degrees have they made pair of stairs to marriage, which they will climb incontinent, or else be incontinent before marriage. They are in the very wrath of love, and they will together. Clubs cannot part them.",
          "plainText": "O I know where you are Nay 'tis true There was never anything so sudden but the fight of two rams and Caesar's thrasonical brag of I came saw and overcame For your brother and my sister no sooner met but they looked no sooner looked but they loved no sooner loved but they sighed no sooner sighed but they asked one another the reason no sooner knew the reason but they sought the remedy and in these degrees have they made pair of stairs to marriage which they will climb incontinent or else be incontinent before marriage They are in the very wrath of love and they will together Clubs cannot part them",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "They shall be married tomorrow, and I will bid the Duke to the nuptial. But O, how bitter a thing it is to look into happiness through another man's eyes! By so much the more shall I tomorrow be at the height of heart-heaviness, by how much I shall think my brother happy in having what he wishes for.",
          "plainText": "They shall be married tomorrow and I will bid the Duke to the nuptial But O how bitter a thing it is to look into happiness through another man's eyes By so much the more shall I tomorrow be at the height of heartheaviness by how much I shall think my brother happy in having what he wishes for",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Why, then, tomorrow I cannot serve your turn for Rosalind?",
          "plainText": "Why then tomorrow I cannot serve your turn for Rosalind",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "I can live no longer by thinking.",
          "plainText": "I can live no longer by thinking",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "I will weary you then no longer with idle talking. Know of me then—for now I speak to some purpose—that I know you are a gentleman of good conceit. I speak not this that you should bear a good opinion of my knowledge, insomuch I say I know you are. Neither do I labour for a greater esteem than may in some little measure draw a belief from you, to do yourself good, and not to grace me. Believe then, if you please, that I can do strange things. I have, since I was three year old, conversed with a magician, most profound in his art and yet not damnable. If you do love Rosalind so near the heart as your gesture cries it out, when your brother marries Aliena shall you marry her. I know into what straits of fortune she is driven and it is not impossible to me, if it appear not inconvenient to you, to set her before your eyes tomorrow, human as she is, and without any danger.",
          "plainText": "I will weary you then no longer with idle talking Know of me thenfor now I speak to some purposethat I know you are a gentleman of good conceit I speak not this that you should bear a good opinion of my knowledge insomuch I say I know you are Neither do I labour for a greater esteem than may in some little measure draw a belief from you to do yourself good and not to grace me Believe then if you please that I can do strange things I have since I was three year old conversed with a magician most profound in his art and yet not damnable If you do love Rosalind so near the heart as your gesture cries it out when your brother marries Aliena shall you marry her I know into what straits of fortune she is driven and it is not impossible to me if it appear not inconvenient to you to set her before your eyes tomorrow human as she is and without any danger",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Speak'st thou in sober meanings?",
          "plainText": "Speak'st thou in sober meanings",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "By my life, I do, which I tender dearly, though I say I am a magician. Therefore put you in your best array, bid your friends; for if you will be married tomorrow, you shall, and to Rosalind, if you will.",
          "plainText": "By my life I do which I tender dearly though I say I am a magician Therefore put you in your best array bid your friends for if you will be married tomorrow you shall and to Rosalind if you will",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-stage-004",
      "type": "stage",
      "text": "Enter Silvius and Phoebe."
    },
    {
      "id": "as-you-like-it-5-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "phoebe",
        "name": "PHOEBE",
        "displayName": "Phoebe"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Youth, you have done me much ungentleness",
          "plainText": "Youth you have done me much ungentleness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-5-2-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "To show the letter that I writ to you.",
          "plainText": "To show the letter that I writ to you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "I care not if I have; it is my study",
          "plainText": "I care not if I have it is my study",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-5-2-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "To seem despiteful and ungentle to you.",
          "plainText": "To seem despiteful and ungentle to you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-5-2-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "You are there followed by a faithful shepherd.",
          "plainText": "You are there followed by a faithful shepherd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-5-2-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "Look upon him, love him; he worships you.",
          "plainText": "Look upon him love him he worships you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "phoebe",
        "name": "PHOEBE",
        "displayName": "Phoebe"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Good shepherd, tell this youth what 'tis to love.",
          "plainText": "Good shepherd tell this youth what 'tis to love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "silvius",
        "name": "SILVIUS",
        "displayName": "Silvius"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "It is to be all made of sighs and tears,",
          "plainText": "It is to be all made of sighs and tears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "as-you-like-it-5-2-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "And so am I for Phoebe.",
          "plainText": "And so am I for Phoebe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "phoebe",
        "name": "PHOEBE",
        "displayName": "Phoebe"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "And I for Ganymede.",
          "plainText": "And I for Ganymede",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "orlando",
        "name": "ORLANDO",
        "displayName": "Orlando"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "And I for Rosalind.",
          "plainText": "And I for Rosalind",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "rosalind",
        "name": "ROSALIND",
        "displayName": "Rosalind"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "And I for no woman.",
          "plainText": "And I for no woman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "as-you-like-it-5-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "silvius",
        "name": "SILVIUS",
        "displayName": "Silvius"
      },
      "lines": [
        {
          "id": "as-you-like-it-5-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "It is to be all made of faith and service,",
          "plainText": "It is to be all made of faith and service",
          "lineType": "verse",
