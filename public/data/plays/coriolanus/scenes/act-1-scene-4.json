{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "coriolanus",
    "title": "The Tragedy of Coriolanus",
    "author": "William Shakespeare",
    "genre": "Tragedy"
  },
  "source": {
    "name": "Project Gutenberg",
    "ebookNumber": 100,
    "rights": "Public domain in the USA",
    "sourceFile": "pg100-images.html"
  },
  "scene": {
    "id": "coriolanus-1-4",
    "act": 1,
    "scene": 4,
    "label": "Act 1, Scene 4",
    "title": "SCENE IV. Before Corioles",
    "location": "Before Corioles",
    "orderInPlay": 4
  },
  "content": [
    {
      "id": "coriolanus-1-4-stage-001",
      "type": "stage",
      "text": "Enter Martius, Titus Lartius, with drum and colours, with Captains and Soldiers, as before the city of Corioles. To them a Messenger."
    },
    {
      "id": "coriolanus-1-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Yonder comes news. A wager they have met.",
          "plainText": "Yonder comes news A wager they have met",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "My horse to yours, no.",
          "plainText": "My horse to yours no",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "'Tis done.",
          "plainText": "'Tis done",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Agreed.",
          "plainText": "Agreed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "[To Messenger.] Say, has our general met the enemy?",
          "plainText": "To Messenger Say has our general met the enemy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "They lie in view but have not spoke as yet.",
          "plainText": "They lie in view but have not spoke as yet",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "So the good horse is mine.",
          "plainText": "So the good horse is mine",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I'll buy him of you.",
          "plainText": "I'll buy him of you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "No, I'll nor sell nor give him. Lend you him I will",
          "plainText": "No I'll nor sell nor give him Lend you him I will",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "For half a hundred years.—Summon the town.",
          "plainText": "For half a hundred yearsSummon the town",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "How far off lie these armies?",
          "plainText": "How far off lie these armies",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Within this mile and half.",
          "plainText": "Within this mile and half",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Then shall we hear their 'larum, and they ours.",
          "plainText": "Then shall we hear their 'larum and they ours",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Now, Mars, I prithee, make us quick in work,",
          "plainText": "Now Mars I prithee make us quick in work",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "That we with smoking swords may march from hence",
          "plainText": "That we with smoking swords may march from hence",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "To help our fielded friends!—Come, blow thy blast.",
          "plainText": "To help our fielded friendsCome blow thy blast",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-stage-002",
      "type": "stage",
      "text": "[They sound a parley.]"
    },
    {
      "id": "coriolanus-1-4-stage-003",
      "type": "stage",
      "text": "Enter two Senators with others on the walls of Corioles."
    },
    {
      "id": "coriolanus-1-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "first-senator",
        "name": "FIRST SENATOR",
        "displayName": "First Senator"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "No, nor a man that fears you less than he:",
          "plainText": "No nor a man that fears you less than he",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "That's lesser than a little.",
          "plainText": "That's lesser than a little",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "[Drum afar off.]",
          "plainText": "Drum afar off",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "Hark, our drums",
          "plainText": "Hark our drums",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Are bringing forth our youth. We'll break our walls",
          "plainText": "Are bringing forth our youth We'll break our walls",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "Rather than they shall pound us up. Our gates,",
          "plainText": "Rather than they shall pound us up Our gates",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0023",
          "number": 23,
          "speechLineNumber": 7,
          "text": "Which yet seem shut, we have but pinned with rushes.",
          "plainText": "Which yet seem shut we have but pinned with rushes",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0024",
          "number": 24,
          "speechLineNumber": 8,
          "text": "They'll open of themselves.",
          "plainText": "They'll open of themselves",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0025",
          "number": 25,
          "speechLineNumber": 9,
          "text": "[Alarum far off.]",
          "plainText": "Alarum far off",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0026",
          "number": 26,
          "speechLineNumber": 10,
          "text": "Hark you, far off!",
          "plainText": "Hark you far off",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0027",
          "number": 27,
          "speechLineNumber": 11,
          "text": "There is Aufidius. List what work he makes",
          "plainText": "There is Aufidius List what work he makes",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0028",
          "number": 28,
          "speechLineNumber": 12,
          "text": "Amongst your cloven army.",
          "plainText": "Amongst your cloven army",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "O, they are at it!",
          "plainText": "O they are at it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Their noise be our instruction.—Ladders, ho!",
          "plainText": "Their noise be our instructionLadders ho",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-stage-004",
      "type": "stage",
      "text": "Enter the Army of the Volsces as through the city gates."
    },
    {
      "id": "coriolanus-1-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "They fear us not but issue forth their city.—",
          "plainText": "They fear us not but issue forth their city",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Now put your shields before your hearts, and fight",
          "plainText": "Now put your shields before your hearts and fight",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "With hearts more proof than shields.—Advance, brave Titus.",
          "plainText": "With hearts more proof than shieldsAdvance brave Titus",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "They do disdain us much beyond our thoughts,",
          "plainText": "They do disdain us much beyond our thoughts",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0035",
          "number": 35,
          "speechLineNumber": 5,
          "text": "Which makes me sweat with wrath.—Come on, my fellows!",
          "plainText": "Which makes me sweat with wrathCome on my fellows",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0036",
          "number": 36,
          "speechLineNumber": 6,
          "text": "He that retires, I'll take him for a Volsce,",
          "plainText": "He that retires I'll take him for a Volsce",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0037",
          "number": 37,
          "speechLineNumber": 7,
          "text": "And he shall feel mine edge.",
          "plainText": "And he shall feel mine edge",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-stage-005",
      "type": "stage",
      "text": "[Alarums. The Romans are beat back to their trenches. They exit, with the Volsces following.]"
    },
    {
      "id": "coriolanus-1-4-stage-006",
      "type": "stage",
      "text": "Enter Martius cursing, with Roman soldiers."
    },
    {
      "id": "coriolanus-1-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "All the contagion of the south light on you,",
          "plainText": "All the contagion of the south light on you",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "You shames of Rome! You herd of—Boils and plagues",
          "plainText": "You shames of Rome You herd ofBoils and plagues",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "Plaster you o'er, that you may be abhorred",
          "plainText": "Plaster you o'er that you may be abhorred",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0041",
          "number": 41,
          "speechLineNumber": 4,
          "text": "Farther than seen, and one infect another",
          "plainText": "Farther than seen and one infect another",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0042",
          "number": 42,
          "speechLineNumber": 5,
          "text": "Against the wind a mile! You souls of geese,",
          "plainText": "Against the wind a mile You souls of geese",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0043",
          "number": 43,
          "speechLineNumber": 6,
          "text": "That bear the shapes of men, how have you run",
          "plainText": "That bear the shapes of men how have you run",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0044",
          "number": 44,
          "speechLineNumber": 7,
          "text": "From slaves that apes would beat! Pluto and hell!",
          "plainText": "From slaves that apes would beat Pluto and hell",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0045",
          "number": 45,
          "speechLineNumber": 8,
          "text": "All hurt behind. Backs red, and faces pale",
          "plainText": "All hurt behind Backs red and faces pale",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0046",
          "number": 46,
          "speechLineNumber": 9,
          "text": "With flight and agued fear! Mend, and charge home,",
          "plainText": "With flight and agued fear Mend and charge home",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0047",
          "number": 47,
          "speechLineNumber": 10,
          "text": "Or, by the fires of heaven, I'll leave the foe",
          "plainText": "Or by the fires of heaven I'll leave the foe",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0048",
          "number": 48,
          "speechLineNumber": 11,
          "text": "And make my wars on you. Look to't. Come on!",
          "plainText": "And make my wars on you Look to't Come on",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0049",
          "number": 49,
          "speechLineNumber": 12,
          "text": "If you'll stand fast we'll beat them to their wives,",
          "plainText": "If you'll stand fast we'll beat them to their wives",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0050",
          "number": 50,
          "speechLineNumber": 13,
          "text": "As they us to our trenches. Follow's!",
          "plainText": "As they us to our trenches Follow's",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-stage-007",
      "type": "stage",
      "text": "[Another alarum. The Volsces re-enter and are driven back to the gates of Corioles, which open to admit them.]"
    },
    {
      "id": "coriolanus-1-4-stage-008",
      "type": "stage",
      "text": "[Martius follows the fleeing Volsces through the gates, and is shut in.]"
    },
    {
      "id": "coriolanus-1-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Foolhardiness, not I.",
          "plainText": "Foolhardiness not I",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Nor I.",
          "plainText": "Nor I",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "See, they have shut him in.",
          "plainText": "See they have shut him in",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-stage-009",
      "type": "stage",
      "text": "[Alarum continues.]"
    },
    {
      "id": "coriolanus-1-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "To th' pot, I warrant him.",
          "plainText": "To th' pot I warrant him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-stage-010",
      "type": "stage",
      "text": "Enter Titus Lartius."
    },
    {
      "id": "coriolanus-1-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "What is become of Martius?",
          "plainText": "What is become of Martius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Slain, sir, doubtless.",
          "plainText": "Slain sir doubtless",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Following the fliers at the very heels,",
          "plainText": "Following the fliers at the very heels",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "With them he enters, who upon the sudden",
          "plainText": "With them he enters who upon the sudden",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0059",
          "number": 59,
          "speechLineNumber": 3,
          "text": "Clapped to their gates. He is himself alone,",
          "plainText": "Clapped to their gates He is himself alone",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0060",
          "number": 60,
          "speechLineNumber": 4,
          "text": "To answer all the city.",
          "plainText": "To answer all the city",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-025",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "O noble fellow,",
          "plainText": "O noble fellow",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "Who sensibly outdares his senseless sword,",
          "plainText": "Who sensibly outdares his senseless sword",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "And when it bows, stand'st up! Thou art left, Martius.",
          "plainText": "And when it bows stand'st up Thou art left Martius",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0064",
          "number": 64,
          "speechLineNumber": 4,
          "text": "A carbuncle entire, as big as thou art,",
          "plainText": "A carbuncle entire as big as thou art",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0065",
          "number": 65,
          "speechLineNumber": 5,
          "text": "Were not so rich a jewel. Thou wast a soldier",
          "plainText": "Were not so rich a jewel Thou wast a soldier",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0066",
          "number": 66,
          "speechLineNumber": 6,
          "text": "Even to Cato's wish, not fierce and terrible",
          "plainText": "Even to Cato's wish not fierce and terrible",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0067",
          "number": 67,
          "speechLineNumber": 7,
          "text": "Only in strokes, but with thy grim looks and",
          "plainText": "Only in strokes but with thy grim looks and",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0068",
          "number": 68,
          "speechLineNumber": 8,
          "text": "The thunderlike percussion of thy sounds",
          "plainText": "The thunderlike percussion of thy sounds",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0069",
          "number": 69,
          "speechLineNumber": 9,
          "text": "Thou mad'st thine enemies shake, as if the world",
          "plainText": "Thou mad'st thine enemies shake as if the world",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0070",
          "number": 70,
          "speechLineNumber": 10,
          "text": "Were feverous and did tremble.",
          "plainText": "Were feverous and did tremble",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-stage-011",
      "type": "stage",
      "text": "Enter Martius, bleeding, assaulted by the enemy."
    },
    {
      "id": "coriolanus-1-4-speech-026",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Look, sir.",
          "plainText": "Look sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-speech-027",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-4-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "O, 'tis Martius!",
          "plainText": "O 'tis Martius",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-4-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "Let's fetch him off or make remain alike.",
          "plainText": "Let's fetch him off or make remain alike",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-4-stage-012",
      "type": "stage",
      "text": "[They fight, and all enter the city.]"
    }
  ]
}