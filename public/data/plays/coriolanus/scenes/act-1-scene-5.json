  "scene": {
    "id": "coriolanus-1-5",
    "act": 1,
    "scene": 5,
    "label": "Act 1, Scene 5",
    "title": "SCENE V. Within Corioles. A street",
    "location": "Within Corioles. A street",
    "orderInPlay": 5
  },
  "content": [
    {
      "id": "coriolanus-1-5-stage-001",
      "type": "stage",
      "text": "Enter certain Romans, with spoils."
    },
    {
      "id": "coriolanus-1-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-roman",
        "name": "FIRST ROMAN",
        "displayName": "First Roman"
      },
      "lines": [
        {
          "id": "coriolanus-1-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "This will I carry to Rome.",
          "plainText": "This will I carry to Rome",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "second-roman",
        "name": "SECOND ROMAN",
        "displayName": "Second Roman"
      },
      "lines": [
        {
          "id": "coriolanus-1-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "And I this.",
          "plainText": "And I this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "third-roman",
        "name": "THIRD ROMAN",
        "displayName": "Third Roman"
      },
      "lines": [
        {
          "id": "coriolanus-1-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "A murrain on't! I took this for silver.",
          "plainText": "A murrain on't I took this for silver",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-5-stage-002",
      "type": "stage",
      "text": "Enter Martius and Titus Lartius with a Trumpet."
    },
    {
      "id": "coriolanus-1-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "See here these movers that do prize their hours",
          "plainText": "See here these movers that do prize their hours",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "At a cracked drachma. Cushions, leaden spoons,",
          "plainText": "At a cracked drachma Cushions leaden spoons",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Irons of a doit, doublets that hangmen would",
          "plainText": "Irons of a doit doublets that hangmen would",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "Bury with those that wore them, these base slaves,",
          "plainText": "Bury with those that wore them these base slaves",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "Ere yet the fight be done, pack up. Down with them!",
          "plainText": "Ere yet the fight be done pack up Down with them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-5-stage-003",
      "type": "stage",
      "text": "[Exit the Romans with spoils.]"
    },
    {
      "id": "coriolanus-1-5-stage-004",
      "type": "stage",
      "text": "[Alarum continues still afar off.]"
    },
    {
      "id": "coriolanus-1-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Worthy sir, thou bleed'st.",
          "plainText": "Worthy sir thou bleed'st",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Thy exercise hath been too violent",
          "plainText": "Thy exercise hath been too violent",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "For a second course of fight.",
          "plainText": "For a second course of fight",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Sir, praise me not.",
          "plainText": "Sir praise me not",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "My work hath yet not warmed me. Fare you well.",
          "plainText": "My work hath yet not warmed me Fare you well",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "The blood I drop is rather physical",
          "plainText": "The blood I drop is rather physical",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "Than dangerous to me. To Aufidius thus",
          "plainText": "Than dangerous to me To Aufidius thus",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "I will appear and fight.",
          "plainText": "I will appear and fight",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Now the fair goddess Fortune",
          "plainText": "Now the fair goddess Fortune",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Fall deep in love with thee, and her great charms",
          "plainText": "Fall deep in love with thee and her great charms",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Misguide thy opposers' swords! Bold gentleman,",
          "plainText": "Misguide thy opposers' swords Bold gentleman",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "Prosperity be thy page!",
          "plainText": "Prosperity be thy page",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-5-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Thy friend no less",
          "plainText": "Thy friend no less",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-1-5-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "Than those she placeth highest! So farewell.",
          "plainText": "Than those she placeth highest So farewell",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-1-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-5-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Thou worthiest Martius!",
          "plainText": "Thou worthiest Martius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-1-5-stage-005",
      "type": "stage",
      "text": "[Exit Martius.]"
    },
    {
      "id": "coriolanus-1-5-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}