  "scene": {
    "id": "coriolanus-1-8",
    "act": 1,
    "scene": 8,
    "label": "Act 1, Scene 8",
    "title": "SCENE VIII. A field of battle between the Roman and the Volscian camps",
    "location": "A field of battle between the Roman and the Volscian camps",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "coriolanus-1-8-stage-001",
      "type": "stage",
      "text": "Alarum, as in battle. Enter Martius and Aufidius at several doors."
    },
    {
      "id": "coriolanus-1-8-speech-001",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-8-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I'll fight with none but thee, for I do hate thee",
          "plainText": "I'll fight with none but thee for I do hate thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Worse than a promise-breaker.",
          "plainText": "Worse than a promisebreaker",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-8-speech-002",
      "type": "speech",
      "speaker": {
        "id": "aufidius",
        "name": "AUFIDIUS",
        "displayName": "Aufidius"
      },
      "lines": [
        {
          "id": "coriolanus-1-8-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "We hate alike.",
          "plainText": "We hate alike",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Not Afric owns a serpent I abhor",
          "plainText": "Not Afric owns a serpent I abhor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "More than thy fame and envy. Fix thy foot.",
          "plainText": "More than thy fame and envy Fix thy foot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-8-speech-003",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-8-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Let the first budger die the other's slave,",
          "plainText": "Let the first budger die the other's slave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "And the gods doom him after!",
          "plainText": "And the gods doom him after",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-8-speech-004",
      "type": "speech",
      "speaker": {
        "id": "aufidius",
        "name": "AUFIDIUS",
        "displayName": "Aufidius"
      },
      "lines": [
        {
          "id": "coriolanus-1-8-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "If I fly, Martius,",
          "plainText": "If I fly Martius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Hollo me like a hare.",
          "plainText": "Hollo me like a hare",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-8-speech-005",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-8-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Within these three hours, Tullus,",
          "plainText": "Within these three hours Tullus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "Alone I fought in your Corioles' walls,",
          "plainText": "Alone I fought in your Corioles' walls",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "And made what work I pleased. 'Tis not my blood",
          "plainText": "And made what work I pleased 'Tis not my blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "Wherein thou seest me masked. For thy revenge",
          "plainText": "Wherein thou seest me masked For thy revenge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0014",
          "number": 14,
          "speechLineNumber": 5,
          "text": "Wrench up thy power to th' highest.",
          "plainText": "Wrench up thy power to th' highest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-8-speech-006",
      "type": "speech",
      "speaker": {
        "id": "aufidius",
        "name": "AUFIDIUS",
        "displayName": "Aufidius"
      },
      "lines": [
        {
          "id": "coriolanus-1-8-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Wert thou the Hector",
          "plainText": "Wert thou the Hector",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "That was the whip of your bragged progeny,",
          "plainText": "That was the whip of your bragged progeny",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-8-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "Thou shouldst not scape me here.",
          "plainText": "Thou shouldst not scape me here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-8-stage-002",
      "type": "stage",
      "text": "[Here they fight, and certain Volsces come to the aid of Aufidius.]"
    },
    {
      "id": "coriolanus-1-8-stage-003",
      "type": "stage",
      "text": "[Martius fights till they be driven in breathless. Aufidius and Martius exit, separately.]"
    }
  ]
}