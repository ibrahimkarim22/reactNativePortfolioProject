  "scene": {
    "id": "coriolanus-1-9",
    "act": 1,
    "scene": 9,
    "label": "Act 1, Scene 9",
    "title": "SCENE IX. The Roman camp",
    "location": "The Roman camp",
    "orderInPlay": 9
  },
  "content": [
    {
      "id": "coriolanus-1-9-stage-001",
      "type": "stage",
      "text": "Alarum. A retreat is sounded. Flourish. Enter, at one door, Cominius with the Romans; at another door, Martius, with his arm in a scarf."
    },
    {
      "id": "coriolanus-1-9-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "If I should tell thee o'er this thy day's work,",
          "plainText": "If I should tell thee o'er this thy day's work",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Thou't not believe thy deeds. But I'll report it",
          "plainText": "Thou't not believe thy deeds But I'll report it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Where senators shall mingle tears with smiles;",
          "plainText": "Where senators shall mingle tears with smiles",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Where great patricians shall attend and shrug,",
          "plainText": "Where great patricians shall attend and shrug",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "I' th' end admire; where ladies shall be frighted",
          "plainText": "I' th' end admire where ladies shall be frighted",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "And, gladly quaked, hear more; where the dull tribunes,",
          "plainText": "And gladly quaked hear more where the dull tribunes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "That with the fusty plebeians hate thine honours,",
          "plainText": "That with the fusty plebeians hate thine honours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Shall say against their hearts \"We thank the gods",
          "plainText": "Shall say against their hearts We thank the gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Our Rome hath such a soldier.\"",
          "plainText": "Our Rome hath such a soldier",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Yet cam'st thou to a morsel of this feast,",
          "plainText": "Yet cam'st thou to a morsel of this feast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Having fully dined before.",
          "plainText": "Having fully dined before",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-stage-002",
      "type": "stage",
      "text": "Enter Titus Lartius with his power, from the pursuit."
    },
    {
      "id": "coriolanus-1-9-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "O general,",
          "plainText": "O general",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Here is the steed, we the caparison.",
          "plainText": "Here is the steed we the caparison",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Hadst thou beheld—",
          "plainText": "Hadst thou beheld",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-003",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Pray now, no more. My mother,",
          "plainText": "Pray now no more My mother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Who has a charter to extol her blood,",
          "plainText": "Who has a charter to extol her blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "When she does praise me grieves me. I have done",
          "plainText": "When she does praise me grieves me I have done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "As you have done—that's what I can;",
          "plainText": "As you have donethat's what I can",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0019",
          "number": 19,
          "speechLineNumber": 5,
          "text": "Induced as you have been—that's for my country.",
          "plainText": "Induced as you have beenthat's for my country",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0020",
          "number": 20,
          "speechLineNumber": 6,
          "text": "He that has but effected his good will",
          "plainText": "He that has but effected his good will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0021",
          "number": 21,
          "speechLineNumber": 7,
          "text": "Hath overta'en mine act.",
          "plainText": "Hath overta'en mine act",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "You shall not be",
          "plainText": "You shall not be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "The grave of your deserving. Rome must know",
          "plainText": "The grave of your deserving Rome must know",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "The value of her own. 'Twere a concealment",
          "plainText": "The value of her own 'Twere a concealment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Worse than a theft, no less than a traducement,",
          "plainText": "Worse than a theft no less than a traducement",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "To hide your doings and to silence that",
          "plainText": "To hide your doings and to silence that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0027",
          "number": 27,
          "speechLineNumber": 6,
          "text": "Which, to the spire and top of praises vouched,",
          "plainText": "Which to the spire and top of praises vouched",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0028",
          "number": 28,
          "speechLineNumber": 7,
          "text": "Would seem but modest. Therefore, I beseech you—",
          "plainText": "Would seem but modest Therefore I beseech you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0029",
          "number": 29,
          "speechLineNumber": 8,
          "text": "In sign of what you are, not to reward",
          "plainText": "In sign of what you are not to reward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0030",
          "number": 30,
          "speechLineNumber": 9,
          "text": "What you have done—before our army hear me.",
          "plainText": "What you have donebefore our army hear me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-005",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "I have some wounds upon me, and they smart",
          "plainText": "I have some wounds upon me and they smart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "To hear themselves remembered.",
          "plainText": "To hear themselves remembered",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Should they not,",
          "plainText": "Should they not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Well might they fester 'gainst ingratitude",
          "plainText": "Well might they fester 'gainst ingratitude",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "And tent themselves with death. Of all the horses—",
          "plainText": "And tent themselves with death Of all the horses",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "Whereof we have ta'en good and good store—of all",
          "plainText": "Whereof we have ta'en good and good storeof all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0037",
          "number": 37,
          "speechLineNumber": 5,
          "text": "The treasure in this field achieved and city,",
          "plainText": "The treasure in this field achieved and city",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0038",
          "number": 38,
          "speechLineNumber": 6,
          "text": "We render you the tenth, to be ta'en forth",
          "plainText": "We render you the tenth to be ta'en forth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0039",
          "number": 39,
          "speechLineNumber": 7,
          "text": "Before the common distribution",
          "plainText": "Before the common distribution",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0040",
          "number": 40,
          "speechLineNumber": 8,
          "text": "At your only choice.",
          "plainText": "At your only choice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-007",
      "type": "speech",
      "speaker": {
        "id": "martius",
        "name": "MARTIUS",
        "displayName": "Martius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "I thank you, general,",
          "plainText": "I thank you general",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "But cannot make my heart consent to take",
          "plainText": "But cannot make my heart consent to take",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "A bribe to pay my sword. I do refuse it;",
          "plainText": "A bribe to pay my sword I do refuse it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "And stand upon my common part with those",
          "plainText": "And stand upon my common part with those",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "That have beheld the doing.",
          "plainText": "That have beheld the doing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-stage-003",
      "type": "stage",
      "text": "[A long flourish. They all cry \"Martius, Martius!\" and cast up their caps and lances. Cominius and Lartius stand bare.]"
    },
    {
      "id": "coriolanus-1-9-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Too modest are you,",
          "plainText": "Too modest are you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "More cruel to your good report than grateful",
          "plainText": "More cruel to your good report than grateful",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "To us that give you truly. By your patience,",
          "plainText": "To us that give you truly By your patience",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "If 'gainst yourself you be incensed, we'll put you,",
          "plainText": "If 'gainst yourself you be incensed we'll put you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0050",
          "number": 50,
          "speechLineNumber": 5,
          "text": "Like one that means his proper harm, in manacles,",
          "plainText": "Like one that means his proper harm in manacles",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0051",
          "number": 51,
          "speechLineNumber": 6,
          "text": "Then reason safely with you. Therefore be it known,",
          "plainText": "Then reason safely with you Therefore be it known",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0052",
          "number": 52,
          "speechLineNumber": 7,
          "text": "As to us to all the world, that Caius Martius",
          "plainText": "As to us to all the world that Caius Martius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0053",
          "number": 53,
          "speechLineNumber": 8,
          "text": "Wears this war's garland, in token of the which",
          "plainText": "Wears this war's garland in token of the which",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0054",
          "number": 54,
          "speechLineNumber": 9,
          "text": "My noble steed, known to the camp, I give him,",
          "plainText": "My noble steed known to the camp I give him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0055",
          "number": 55,
          "speechLineNumber": 10,
          "text": "With all his trim belonging. And from this time,",
          "plainText": "With all his trim belonging And from this time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0056",
          "number": 56,
          "speechLineNumber": 11,
          "text": "For what he did before Corioles, call him,",
          "plainText": "For what he did before Corioles call him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0057",
          "number": 57,
          "speechLineNumber": 12,
          "text": "With all th' applause and clamour of the host,",
          "plainText": "With all th' applause and clamour of the host",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0058",
          "number": 58,
          "speechLineNumber": 13,
          "text": "Caius Martius Coriolanus! Bear",
          "plainText": "Caius Martius Coriolanus Bear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0059",
          "number": 59,
          "speechLineNumber": 14,
          "text": "Th' addition nobly ever!",
          "plainText": "Th' addition nobly ever",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-stage-004",
      "type": "stage",
      "text": "[Flourish. Trumpets sound, and drums.]"
    },
    {
      "id": "coriolanus-1-9-speech-009",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Caius Martius Coriolanus!",
          "plainText": "Caius Martius Coriolanus",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-010",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "I will go wash;",
          "plainText": "I will go wash",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "And when my face is fair, you shall perceive",
          "plainText": "And when my face is fair you shall perceive",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "Whether I blush or no. Howbeit, I thank you.",
          "plainText": "Whether I blush or no Howbeit I thank you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0064",
          "number": 64,
          "speechLineNumber": 4,
          "text": "I mean to stride your steed and at all times",
          "plainText": "I mean to stride your steed and at all times",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0065",
          "number": 65,
          "speechLineNumber": 5,
          "text": "To undercrest your good addition",
          "plainText": "To undercrest your good addition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0066",
          "number": 66,
          "speechLineNumber": 6,
          "text": "To th' fairness of my power.",
          "plainText": "To th' fairness of my power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-011",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "So, to our tent,",
          "plainText": "So to our tent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "Where, ere we do repose us, we will write",
          "plainText": "Where ere we do repose us we will write",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0069",
          "number": 69,
          "speechLineNumber": 3,
          "text": "To Rome of our success.—You, Titus Lartius,",
          "plainText": "To Rome of our successYou Titus Lartius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0070",
          "number": 70,
          "speechLineNumber": 4,
          "text": "Must to Corioles back. Send us to Rome",
          "plainText": "Must to Corioles back Send us to Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0071",
          "number": 71,
          "speechLineNumber": 5,
          "text": "The best, with whom we may articulate",
          "plainText": "The best with whom we may articulate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0072",
          "number": 72,
          "speechLineNumber": 6,
          "text": "For their own good and ours.",
          "plainText": "For their own good and ours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-012",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "I shall, my lord.",
          "plainText": "I shall my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-013",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "The gods begin to mock me. I, that now",
          "plainText": "The gods begin to mock me I that now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "Refused most princely gifts, am bound to beg",
          "plainText": "Refused most princely gifts am bound to beg",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "Of my lord general.",
          "plainText": "Of my lord general",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-014",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Take't, 'tis yours. What is't?",
          "plainText": "Take't 'tis yours What is't",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-015",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "I sometime lay here in Corioles",
          "plainText": "I sometime lay here in Corioles",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0079",
          "number": 79,
          "speechLineNumber": 2,
          "text": "At a poor man's house; he used me kindly.",
          "plainText": "At a poor man's house he used me kindly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0080",
          "number": 80,
          "speechLineNumber": 3,
          "text": "He cried to me; I saw him prisoner;",
          "plainText": "He cried to me I saw him prisoner",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0081",
          "number": 81,
          "speechLineNumber": 4,
          "text": "But then Aufidius was within my view,",
          "plainText": "But then Aufidius was within my view",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0082",
          "number": 82,
          "speechLineNumber": 5,
          "text": "And wrath o'erwhelmed my pity. I request you",
          "plainText": "And wrath o'erwhelmed my pity I request you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0083",
          "number": 83,
          "speechLineNumber": 6,
          "text": "To give my poor host freedom.",
          "plainText": "To give my poor host freedom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-016",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "O, well begged!",
          "plainText": "O well begged",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0085",
          "number": 85,
          "speechLineNumber": 2,
          "text": "Were he the butcher of my son, he should",
          "plainText": "Were he the butcher of my son he should",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0086",
          "number": 86,
          "speechLineNumber": 3,
          "text": "Be free as is the wind.—Deliver him, Titus.",
          "plainText": "Be free as is the windDeliver him Titus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-017",
      "type": "speech",
      "speaker": {
        "id": "lartius",
        "name": "LARTIUS",
        "displayName": "Lartius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0087",
          "number": 87,
          "speechLineNumber": 1,
          "text": "Martius, his name?",
          "plainText": "Martius his name",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-018",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0088",
          "number": 88,
          "speechLineNumber": 1,
          "text": "By Jupiter, forgot!",
          "plainText": "By Jupiter forgot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0089",
          "number": 89,
          "speechLineNumber": 2,
          "text": "I am weary; yea, my memory is tired.",
          "plainText": "I am weary yea my memory is tired",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0090",
          "number": 90,
          "speechLineNumber": 3,
          "text": "Have we no wine here?",
          "plainText": "Have we no wine here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-1-9-line-0091",
          "number": 91,
          "speechLineNumber": 1,
          "text": "Go we to our tent.",
          "plainText": "Go we to our tent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0092",
          "number": 92,
          "speechLineNumber": 2,
          "text": "The blood upon your visage dries; 'tis time",
          "plainText": "The blood upon your visage dries 'tis time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-1-9-line-0093",
          "number": 93,
          "speechLineNumber": 3,
          "text": "It should be looked to. Come.",
          "plainText": "It should be looked to Come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-1-9-stage-005",
      "type": "stage",
      "text": "[A flourish of cornets. Exeunt.]"
    }
  ]
}