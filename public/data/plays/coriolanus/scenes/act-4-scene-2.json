  "scene": {
    "id": "coriolanus-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. Rome. A street near the gate",
    "location": "Rome. A street near the gate",
    "orderInPlay": 18
  },
  "content": [
    {
      "id": "coriolanus-4-2-stage-001",
      "type": "stage",
      "text": "Enter two Tribunes, Sicinius, Brutus with the Aedile."
    },
    {
      "id": "coriolanus-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Bid them all home. He's gone, and we'll no further.",
          "plainText": "Bid them all home He's gone and we'll no further",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The nobility are vexed, whom we see have sided",
          "plainText": "The nobility are vexed whom we see have sided",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "In his behalf.",
          "plainText": "In his behalf",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Now we have shown our power,",
          "plainText": "Now we have shown our power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Let us seem humbler after it is done",
          "plainText": "Let us seem humbler after it is done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Than when it was a-doing.",
          "plainText": "Than when it was adoing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Bid them home.",
          "plainText": "Bid them home",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Say their great enemy is gone, and they",
          "plainText": "Say their great enemy is gone and they",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Stand in their ancient strength.",
          "plainText": "Stand in their ancient strength",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Dismiss them home.",
          "plainText": "Dismiss them home",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-stage-002",
      "type": "stage",
      "text": "[Exit Aedile.]"
    },
    {
      "id": "coriolanus-4-2-stage-003",
      "type": "stage",
      "text": "Enter Volumnia, Virgilia and Menenius."
    },
    {
      "id": "coriolanus-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Let's not meet her.",
          "plainText": "Let's not meet her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Why?",
          "plainText": "Why",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "They say she's mad.",
          "plainText": "They say she's mad",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "They have ta'en note of us. Keep on your way.",
          "plainText": "They have ta'en note of us Keep on your way",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "O, you're well met. The hoarded plague o' th' gods",
          "plainText": "O you're well met The hoarded plague o' th' gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Requite your love!",
          "plainText": "Requite your love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Peace, peace! Be not so loud.",
          "plainText": "Peace peace Be not so loud",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "If that I could for weeping, you should hear—",
          "plainText": "If that I could for weeping you should hear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Nay, and you shall hear some. [To Sicinius.] Will you be gone?",
          "plainText": "Nay and you shall hear some To Sicinius Will you be gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "virgilia",
        "name": "VIRGILIA",
        "displayName": "Virgilia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "[To Brutus.] You shall stay too. I would I had the power",
          "plainText": "To Brutus You shall stay too I would I had the power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "To say so to my husband.",
          "plainText": "To say so to my husband",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Are you mankind?",
          "plainText": "Are you mankind",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Ay, fool, is that a shame? Note but this, fool.",
          "plainText": "Ay fool is that a shame Note but this fool",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Was not a man my father? Hadst thou foxship",
          "plainText": "Was not a man my father Hadst thou foxship",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "To banish him that struck more blows for Rome",
          "plainText": "To banish him that struck more blows for Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "Than thou hast spoken words?",
          "plainText": "Than thou hast spoken words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "O blessed heavens!",
          "plainText": "O blessed heavens",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "More noble blows than ever thou wise words,",
          "plainText": "More noble blows than ever thou wise words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "And for Rome's good. I'll tell thee what—yet go.",
          "plainText": "And for Rome's good I'll tell thee whatyet go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "Nay, but thou shalt stay too. I would my son",
          "plainText": "Nay but thou shalt stay too I would my son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0031",
          "number": 31,
          "speechLineNumber": 4,
          "text": "Were in Arabia and thy tribe before him,",
          "plainText": "Were in Arabia and thy tribe before him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0032",
          "number": 32,
          "speechLineNumber": 5,
          "text": "His good sword in his hand.",
          "plainText": "His good sword in his hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "What then?",
          "plainText": "What then",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "virgilia",
        "name": "VIRGILIA",
        "displayName": "Virgilia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "What then?",
          "plainText": "What then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "He'd make an end of thy posterity.",
          "plainText": "He'd make an end of thy posterity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Bastards and all.",
          "plainText": "Bastards and all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "Good man, the wounds that he does bear for Rome!",
          "plainText": "Good man the wounds that he does bear for Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Come, come, peace.",
          "plainText": "Come come peace",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "I would he had continued to his country",
          "plainText": "I would he had continued to his country",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "As he began, and not unknit himself",
          "plainText": "As he began and not unknit himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "The noble knot he made.",
          "plainText": "The noble knot he made",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "I would he had.",
          "plainText": "I would he had",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "\"I would he had?\" 'Twas you incensed the rabble.",
          "plainText": "I would he had 'Twas you incensed the rabble",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "Cats, that can judge as fitly of his worth",
          "plainText": "Cats that can judge as fitly of his worth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "As I can of those mysteries which heaven",
          "plainText": "As I can of those mysteries which heaven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "Will not have Earth to know.",
          "plainText": "Will not have Earth to know",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Pray, let's go.",
          "plainText": "Pray let's go",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Now, pray, sir, get you gone.",
          "plainText": "Now pray sir get you gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "You have done a brave deed. Ere you go, hear this:",
          "plainText": "You have done a brave deed Ere you go hear this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "As far as doth the Capitol exceed",
          "plainText": "As far as doth the Capitol exceed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "The meanest house in Rome, so far my son—",
          "plainText": "The meanest house in Rome so far my son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0052",
          "number": 52,
          "speechLineNumber": 5,
          "text": "This lady's husband here, this, do you see?—",
          "plainText": "This lady's husband here this do you see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0053",
          "number": 53,
          "speechLineNumber": 6,
          "text": "Whom you have banished, does exceed you all.",
          "plainText": "Whom you have banished does exceed you all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Well, well, we'll leave you.",
          "plainText": "Well well we'll leave you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Why stay we to be baited",
          "plainText": "Why stay we to be baited",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "With one that wants her wits?",
          "plainText": "With one that wants her wits",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-stage-004",
      "type": "stage",
      "text": "[Exeunt Tribunes.]"
    },
    {
      "id": "coriolanus-4-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Take my prayers with you.",
          "plainText": "Take my prayers with you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "I would the gods had nothing else to do",
          "plainText": "I would the gods had nothing else to do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0059",
          "number": 59,
          "speechLineNumber": 3,
          "text": "But to confirm my curses. Could I meet 'em",
          "plainText": "But to confirm my curses Could I meet 'em",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0060",
          "number": 60,
          "speechLineNumber": 4,
          "text": "But once a day, it would unclog my heart",
          "plainText": "But once a day it would unclog my heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0061",
          "number": 61,
          "speechLineNumber": 5,
          "text": "Of what lies heavy to't.",
          "plainText": "Of what lies heavy to't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "You have told them home,",
          "plainText": "You have told them home",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "And, by my troth, you have cause. You'll sup with me?",
          "plainText": "And by my troth you have cause You'll sup with me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "volumnia",
        "name": "VOLUMNIA",
        "displayName": "Volumnia"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Anger's my meat. I sup upon myself",
          "plainText": "Anger's my meat I sup upon myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "And so shall starve with feeding. Come, let's go.",
          "plainText": "And so shall starve with feeding Come let's go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "Leave this faint puling, and lament as I do,",
          "plainText": "Leave this faint puling and lament as I do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-4-2-line-0067",
          "number": 67,
          "speechLineNumber": 4,
          "text": "In anger, Juno-like. Come, come, come.",
          "plainText": "In anger Junolike Come come come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    },
    {
      "id": "coriolanus-4-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-4-2-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Fie, fie, fie!",
          "plainText": "Fie fie fie",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-4-2-stage-006",
      "type": "stage",
      "text": "[Exit Menenius.]"
    }
  ]
}