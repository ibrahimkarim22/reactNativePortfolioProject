  "scene": {
    "id": "coriolanus-4-4",
    "act": 4,
    "scene": 4,
    "label": "Act 4, Scene 4",
    "title": "SCENE IV. Antium. Before Aufidius's house",
    "location": "Antium. Before Aufidius's house",
    "orderInPlay": 20
  },
  "content": [
    {
      "id": "coriolanus-4-4-stage-001",
      "type": "stage",
      "text": "Enter Coriolanus in mean apparel, disguised and muffled."
    },
    {
      "id": "coriolanus-4-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-4-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "A goodly city is this Antium. City,",
          "plainText": "A goodly city is this Antium City",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-4-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "'Tis I that made thy widows. Many an heir",
          "plainText": "'Tis I that made thy widows Many an heir",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-4-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Of these fair edifices 'fore my wars",
          "plainText": "Of these fair edifices 'fore my wars",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-4-4-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Have I heard groan and drop. Then know me not,",
          "plainText": "Have I heard groan and drop Then know me not",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-4-4-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Lest that thy wives with spits and boys with stones",
          "plainText": "Lest that thy wives with spits and boys with stones",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-4-4-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "In puny battle slay me.",
          "plainText": "In puny battle slay me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-4-4-stage-002",
      "type": "stage",
      "text": "Enter a Citizen."
    },
    {
      "id": "coriolanus-4-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "citizen",
        "name": "CITIZEN",
        "displayName": "Citizen"
      },
      "lines": [
        {
          "id": "coriolanus-4-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "And you.",
          "plainText": "And you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-4-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-4-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Direct me, if it be your will,",
          "plainText": "Direct me if it be your will",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-4-4-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Where great Aufidius lies. Is he in Antium?",
          "plainText": "Where great Aufidius lies Is he in Antium",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-4-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "citizen",
        "name": "CITIZEN",
        "displayName": "Citizen"
      },
      "lines": [
        {
          "id": "coriolanus-4-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "He is, and feasts the nobles of the state",
          "plainText": "He is and feasts the nobles of the state",
          "lineType": "verse"
        },
        {
          "id": "coriolanus-4-4-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "At his house this night.",
          "plainText": "At his house this night",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "coriolanus-4-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-4-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Which is his house, beseech you?",
          "plainText": "Which is his house beseech you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-4-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "citizen",
        "name": "CITIZEN",
        "displayName": "Citizen"
      },
      "lines": [
        {
          "id": "coriolanus-4-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "This here before you.",
          "plainText": "This here before you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-4-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "coriolanus",
        "name": "CORIOLANUS",
        "displayName": "Coriolanus"
      },
      "lines": [
        {
          "id": "coriolanus-4-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Thank you, sir. Farewell.",
          "plainText": "Thank you sir Farewell",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "coriolanus-4-4-stage-003",
      "type": "stage",
      "text": "[Exit Citizen.]"
    },
    {
      "id": "coriolanus-4-4-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}