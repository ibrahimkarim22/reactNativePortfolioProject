  "scene": {
    "id": "coriolanus-5-1",
    "act": 5,
    "scene": 1,
    "label": "Act 5, Scene 1",
    "title": "SCENE I. Rome. A public place",
    "location": "Rome. A public place",
    "orderInPlay": 24
  },
  "content": [
    {
      "id": "coriolanus-5-1-stage-001",
      "type": "stage",
      "text": "Enter Menenius, Cominius, Sicinius, Brutus (the two Tribunes), with others."
    },
    {
      "id": "coriolanus-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "No, I'll not go. You hear what he hath said",
          "plainText": "No I'll not go You hear what he hath said",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Which was sometime his general, who loved him",
          "plainText": "Which was sometime his general who loved him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "In a most dear particular. He called me father,",
          "plainText": "In a most dear particular He called me father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "But what o' that? Go you that banished him;",
          "plainText": "But what o' that Go you that banished him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "A mile before his tent, fall down, and knee",
          "plainText": "A mile before his tent fall down and knee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "The way into his mercy. Nay, if he coyed",
          "plainText": "The way into his mercy Nay if he coyed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "To hear Cominius speak, I'll keep at home.",
          "plainText": "To hear Cominius speak I'll keep at home",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "He would not seem to know me.",
          "plainText": "He would not seem to know me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Do you hear?",
          "plainText": "Do you hear",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Yet one time he did call me by my name.",
          "plainText": "Yet one time he did call me by my name",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "I urged our old acquaintance, and the drops",
          "plainText": "I urged our old acquaintance and the drops",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "That we have bled together. \"Coriolanus\"",
          "plainText": "That we have bled together Coriolanus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "He would not answer to, forbade all names.",
          "plainText": "He would not answer to forbade all names",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 5,
          "text": "He was a kind of nothing, titleless,",
          "plainText": "He was a kind of nothing titleless",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 6,
          "text": "Till he had forged himself a name i' th' fire",
          "plainText": "Till he had forged himself a name i' th' fire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 7,
          "text": "Of burning Rome.",
          "plainText": "Of burning Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Why, so; you have made good work!",
          "plainText": "Why so you have made good work",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "A pair of tribunes that have wracked Rome",
          "plainText": "A pair of tribunes that have wracked Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "To make coals cheap! A noble memory!",
          "plainText": "To make coals cheap A noble memory",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "I minded him how royal 'twas to pardon",
          "plainText": "I minded him how royal 'twas to pardon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "When it was less expected. He replied",
          "plainText": "When it was less expected He replied",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "It was a bare petition of a state",
          "plainText": "It was a bare petition of a state",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "To one whom they had punished.",
          "plainText": "To one whom they had punished",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Very well.",
          "plainText": "Very well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "Could he say less?",
          "plainText": "Could he say less",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "I offered to awaken his regard",
          "plainText": "I offered to awaken his regard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "For's private friends. His answer to me was",
          "plainText": "For's private friends His answer to me was",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "He could not stay to pick them in a pile",
          "plainText": "He could not stay to pick them in a pile",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "Of noisome musty chaff. He said 'twas folly",
          "plainText": "Of noisome musty chaff He said 'twas folly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0030",
          "number": 30,
          "speechLineNumber": 5,
          "text": "For one poor grain or two to leave unburnt",
          "plainText": "For one poor grain or two to leave unburnt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0031",
          "number": 31,
          "speechLineNumber": 6,
          "text": "And still to nose th' offence.",
          "plainText": "And still to nose th' offence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "For one poor grain or two!",
          "plainText": "For one poor grain or two",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "I am one of those! His mother, wife, his child,",
          "plainText": "I am one of those His mother wife his child",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "And this brave fellow too, we are the grains;",
          "plainText": "And this brave fellow too we are the grains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "You are the musty chaff, and you are smelt",
          "plainText": "You are the musty chaff and you are smelt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "Above the moon. We must be burnt for you.",
          "plainText": "Above the moon We must be burnt for you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Nay, pray, be patient. If you refuse your aid",
          "plainText": "Nay pray be patient If you refuse your aid",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "In this so-never-needed help, yet do not",
          "plainText": "In this soneverneeded help yet do not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "Upbraid's with our distress. But sure, if you",
          "plainText": "Upbraid's with our distress But sure if you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "Would be your country's pleader, your good tongue,",
          "plainText": "Would be your country's pleader your good tongue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0041",
          "number": 41,
          "speechLineNumber": 5,
          "text": "More than the instant army we can make,",
          "plainText": "More than the instant army we can make",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0042",
          "number": 42,
          "speechLineNumber": 6,
          "text": "Might stop our countryman.",
          "plainText": "Might stop our countryman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "No, I'll not meddle.",
          "plainText": "No I'll not meddle",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Pray you, go to him.",
          "plainText": "Pray you go to him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "What should I do?",
          "plainText": "What should I do",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Only make trial what your love can do",
          "plainText": "Only make trial what your love can do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "For Rome, towards Martius.",
          "plainText": "For Rome towards Martius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Well, and say that Martius",
          "plainText": "Well and say that Martius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "Return me, as Cominius is returned, unheard,",
          "plainText": "Return me as Cominius is returned unheard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "What then? But as a discontented friend,",
          "plainText": "What then But as a discontented friend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "Grief-shot with his unkindness? Say't be so?",
          "plainText": "Griefshot with his unkindness Say't be so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Yet your good will",
          "plainText": "Yet your good will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Must have that thanks from Rome after the measure",
          "plainText": "Must have that thanks from Rome after the measure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "As you intended well.",
          "plainText": "As you intended well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "I'll undertake't.",
          "plainText": "I'll undertake't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "I think he'll hear me. Yet to bite his lip",
          "plainText": "I think he'll hear me Yet to bite his lip",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "And hum at good Cominius much unhearts me.",
          "plainText": "And hum at good Cominius much unhearts me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0058",
          "number": 58,
          "speechLineNumber": 4,
          "text": "He was not taken well; he had not dined.",
          "plainText": "He was not taken well he had not dined",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0059",
          "number": 59,
          "speechLineNumber": 5,
          "text": "The veins unfilled, our blood is cold, and then",
          "plainText": "The veins unfilled our blood is cold and then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0060",
          "number": 60,
          "speechLineNumber": 6,
          "text": "We pout upon the morning, are unapt",
          "plainText": "We pout upon the morning are unapt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0061",
          "number": 61,
          "speechLineNumber": 7,
          "text": "To give or to forgive; but when we have stuffed",
          "plainText": "To give or to forgive but when we have stuffed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0062",
          "number": 62,
          "speechLineNumber": 8,
          "text": "These pipes and these conveyances of our blood",
          "plainText": "These pipes and these conveyances of our blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0063",
          "number": 63,
          "speechLineNumber": 9,
          "text": "With wine and feeding, we have suppler souls",
          "plainText": "With wine and feeding we have suppler souls",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0064",
          "number": 64,
          "speechLineNumber": 10,
          "text": "Than in our priestlike fasts. Therefore I'll watch him",
          "plainText": "Than in our priestlike fasts Therefore I'll watch him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0065",
          "number": 65,
          "speechLineNumber": 11,
          "text": "Till he be dieted to my request,",
          "plainText": "Till he be dieted to my request",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0066",
          "number": 66,
          "speechLineNumber": 12,
          "text": "And then I'll set upon him.",
          "plainText": "And then I'll set upon him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "You know the very road into his kindness",
          "plainText": "You know the very road into his kindness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "And cannot lose your way.",
          "plainText": "And cannot lose your way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "menenius",
        "name": "MENENIUS",
        "displayName": "Menenius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Good faith, I'll prove him,",
          "plainText": "Good faith I'll prove him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "Speed how it will. I shall ere long have knowledge",
          "plainText": "Speed how it will I shall ere long have knowledge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0071",
          "number": 71,
          "speechLineNumber": 3,
          "text": "Of my success.",
          "plainText": "Of my success",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "coriolanus-5-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "He'll never hear him.",
          "plainText": "He'll never hear him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "sicinius",
        "name": "SICINIUS",
        "displayName": "Sicinius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Not?",
          "plainText": "Not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "cominius",
        "name": "COMINIUS",
        "displayName": "Cominius"
      },
      "lines": [
        {
          "id": "coriolanus-5-1-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "I tell you, he does sit in gold, his eye",
          "plainText": "I tell you he does sit in gold his eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "Red as 'twould burn Rome; and his injury",
          "plainText": "Red as 'twould burn Rome and his injury",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "The jailer to his pity. I kneeled before him;",
          "plainText": "The jailer to his pity I kneeled before him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0077",
          "number": 77,
          "speechLineNumber": 4,
          "text": "'Twas very faintly he said \"Rise\"; dismissed me",
          "plainText": "'Twas very faintly he said Rise dismissed me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0078",
          "number": 78,
          "speechLineNumber": 5,
          "text": "Thus with his speechless hand. What he would do",
          "plainText": "Thus with his speechless hand What he would do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0079",
          "number": 79,
          "speechLineNumber": 6,
          "text": "He sent in writing after me; what he",
          "plainText": "He sent in writing after me what he",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0080",
          "number": 80,
          "speechLineNumber": 7,
          "text": "Would not, bound with an oath to yield to his",
          "plainText": "Would not bound with an oath to yield to his",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0081",
          "number": 81,
          "speechLineNumber": 8,
          "text": "Conditions. So that all hope is vain",
          "plainText": "Conditions So that all hope is vain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0082",
          "number": 82,
          "speechLineNumber": 9,
          "text": "Unless his noble mother and his wife,",
          "plainText": "Unless his noble mother and his wife",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0083",
          "number": 83,
          "speechLineNumber": 10,
          "text": "Who, as I hear, mean to solicit him",
          "plainText": "Who as I hear mean to solicit him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0084",
          "number": 84,
          "speechLineNumber": 11,
          "text": "For mercy to his country. Therefore let's hence",
          "plainText": "For mercy to his country Therefore let's hence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "coriolanus-5-1-line-0085",
          "number": 85,
          "speechLineNumber": 12,
          "text": "And with our fair entreaties haste them on.",
          "plainText": "And with our fair entreaties haste them on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "coriolanus-5-1-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}