  "scene": {
    "id": "cymbeline-1-3",
    "act": 1,
    "scene": 3,
    "label": "Act 1, Scene 3",
    "title": "SCENE III. Britain. A public place.",
    "location": "Britain. A public place.",
    "orderInPlay": 3
  },
  "content": [
    {
      "id": "cymbeline-1-3-stage-001",
      "type": "stage",
      "text": "Enter Cloten and two Lords."
    },
    {
      "id": "cymbeline-1-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Sir, I would advise you to shift a shirt; the violence of action hath made you reek as a sacrifice. Where air comes out, air comes in; there's none abroad so wholesome as that you vent.",
          "plainText": "Sir I would advise you to shift a shirt the violence of action hath made you reek as a sacrifice Where air comes out air comes in there's none abroad so wholesome as that you vent",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "If my shirt were bloody, then to shift it. Have I hurt him?",
          "plainText": "If my shirt were bloody then to shift it Have I hurt him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "[Aside.] No, faith; not so much as his patience.",
          "plainText": "Aside No faith not so much as his patience",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Hurt him! His body's a passable carcass if he be not hurt. It is a throughfare for steel if it be not hurt.",
          "plainText": "Hurt him His body's a passable carcass if he be not hurt It is a throughfare for steel if it be not hurt",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "[Aside.] His steel was in debt; it went o' th' backside the town.",
          "plainText": "Aside His steel was in debt it went o' th' backside the town",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "The villain would not stand me.",
          "plainText": "The villain would not stand me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "[Aside.] No; but he fled forward still, toward your face.",
          "plainText": "Aside No but he fled forward still toward your face",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Stand you? You have land enough of your own; but he added to your having, gave you some ground.",
          "plainText": "Stand you You have land enough of your own but he added to your having gave you some ground",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "[Aside.] As many inches as you have oceans.",
          "plainText": "Aside As many inches as you have oceans",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-1-3-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Puppies!",
          "plainText": "Puppies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "I would they had not come between us.",
          "plainText": "I would they had not come between us",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "[Aside.] So would I, till you had measur'd how long a fool you were upon the ground.",
          "plainText": "Aside So would I till you had measur'd how long a fool you were upon the ground",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "And that she should love this fellow, and refuse me!",
          "plainText": "And that she should love this fellow and refuse me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "[Aside.] If it be a sin to make a true election, she is damn'd.",
          "plainText": "Aside If it be a sin to make a true election she is damn'd",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Sir, as I told you always, her beauty and her brain go not together; she's a good sign, but I have seen small reflection of her wit.",
          "plainText": "Sir as I told you always her beauty and her brain go not together she's a good sign but I have seen small reflection of her wit",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "[Aside.] She shines not upon fools, lest the reflection should hurt her.",
          "plainText": "Aside She shines not upon fools lest the reflection should hurt her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Come, I'll to my chamber. Would there had been some hurt done!",
          "plainText": "Come I'll to my chamber Would there had been some hurt done",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "[Aside.] I wish not so; unless it had been the fall of an ass, which is no great hurt.",
          "plainText": "Aside I wish not so unless it had been the fall of an ass which is no great hurt",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "You'll go with us?",
          "plainText": "You'll go with us",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "I'll attend your lordship.",
          "plainText": "I'll attend your lordship",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Nay, come, let's go together.",
          "plainText": "Nay come let's go together",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-1-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Well, my lord.",
          "plainText": "Well my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-1-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}