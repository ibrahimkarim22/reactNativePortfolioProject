  "scene": {
    "id": "cymbeline-2-1",
    "act": 2,
    "scene": 1,
    "label": "Act 2, Scene 1",
    "title": "SCENE I. Britain. Before Cymbeline's palace.",
    "location": "Britain. Before Cymbeline's palace.",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "cymbeline-2-1-stage-001",
      "type": "stage",
      "text": "Enter Cloten and the two Lords."
    },
    {
      "id": "cymbeline-2-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Was there ever man had such luck! When I kiss'd the jack, upon an upcast to be hit away! I had a hundred pound on't; and then a whoreson jackanapes must take me up for swearing, as if I borrowed mine oaths of him, and might not spend them at my pleasure.",
          "plainText": "Was there ever man had such luck When I kiss'd the jack upon an upcast to be hit away I had a hundred pound on't and then a whoreson jackanapes must take me up for swearing as if I borrowed mine oaths of him and might not spend them at my pleasure",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "What got he by that? You have broke his pate with your bowl.",
          "plainText": "What got he by that You have broke his pate with your bowl",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "[Aside.] If his wit had been like him that broke it, it would have run all out.",
          "plainText": "Aside If his wit had been like him that broke it it would have run all out",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "When a gentleman is dispos'd to swear, it is not for any standers-by to curtail his oaths. Ha?",
          "plainText": "When a gentleman is dispos'd to swear it is not for any standersby to curtail his oaths Ha",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "No, my lord; [Aside.] nor crop the ears of them.",
          "plainText": "No my lord Aside nor crop the ears of them",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Whoreson dog! I gave him satisfaction. Would he had been one of my rank!",
          "plainText": "Whoreson dog I gave him satisfaction Would he had been one of my rank",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "[Aside.] To have smell'd like a fool.",
          "plainText": "Aside To have smell'd like a fool",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I am not vex'd more at anything in th' earth. A pox on't! I had rather not be so noble as I am; they dare not fight with me, because of the Queen my mother. Every jackslave hath his bellyful of fighting, and I must go up and down like a cock that nobody can match.",
          "plainText": "I am not vex'd more at anything in th' earth A pox on't I had rather not be so noble as I am they dare not fight with me because of the Queen my mother Every jackslave hath his bellyful of fighting and I must go up and down like a cock that nobody can match",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "[Aside.] You are cock and capon too; and you crow, cock, with your comb on.",
          "plainText": "Aside You are cock and capon too and you crow cock with your comb on",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Sayest thou?",
          "plainText": "Sayest thou",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "It is not fit your lordship should undertake every companion that you give offence to.",
          "plainText": "It is not fit your lordship should undertake every companion that you give offence to",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "No, I know that; but it is fit I should commit offence to my inferiors.",
          "plainText": "No I know that but it is fit I should commit offence to my inferiors",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Ay, it is fit for your lordship only.",
          "plainText": "Ay it is fit for your lordship only",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Why, so I say.",
          "plainText": "Why so I say",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Did you hear of a stranger that's come to court tonight?",
          "plainText": "Did you hear of a stranger that's come to court tonight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "A stranger, and I not known on't?",
          "plainText": "A stranger and I not known on't",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "[Aside.] He's a strange fellow himself, and knows it not.",
          "plainText": "Aside He's a strange fellow himself and knows it not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "There's an Italian come, and, 'tis thought, one of Leonatus' friends.",
          "plainText": "There's an Italian come and 'tis thought one of Leonatus' friends",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Leonatus? A banish'd rascal; and he's another, whatsoever he be. Who told you of this stranger?",
          "plainText": "Leonatus A banish'd rascal and he's another whatsoever he be Who told you of this stranger",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "first-lord",
        "name": "FIRST LORD",
        "displayName": "First Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "One of your lordship's pages.",
          "plainText": "One of your lordship's pages",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Is it fit I went to look upon him? Is there no derogation in't?",
          "plainText": "Is it fit I went to look upon him Is there no derogation in't",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "You cannot derogate, my lord.",
          "plainText": "You cannot derogate my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Not easily, I think.",
          "plainText": "Not easily I think",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "[Aside.] You are a fool granted; therefore your issues, being foolish, do not derogate.",
          "plainText": "Aside You are a fool granted therefore your issues being foolish do not derogate",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Come, I'll go see this Italian. What I have lost today at bowls I'll win tonight of him. Come, go.",
          "plainText": "Come I'll go see this Italian What I have lost today at bowls I'll win tonight of him Come go",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "second-lord",
        "name": "SECOND LORD",
        "displayName": "Second Lord"
      },
      "lines": [
        {
          "id": "cymbeline-2-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "I'll attend your lordship.",
          "plainText": "I'll attend your lordship",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-2-1-stage-002",
      "type": "stage",
      "text": "[Exeunt Cloten and First Lord.]"
    },
    {
      "id": "cymbeline-2-1-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}