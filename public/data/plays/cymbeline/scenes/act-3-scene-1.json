  "scene": {
    "id": "cymbeline-3-1",
    "act": 3,
    "scene": 1,
    "label": "Act 3, Scene 1",
    "title": "SCENE I. Britain. A hall in Cymbeline's palace.",
    "location": "Britain. A hall in Cymbeline's palace.",
    "orderInPlay": 13
  },
  "content": [
    {
      "id": "cymbeline-3-1-stage-001",
      "type": "stage",
      "text": "Enter in state Cymbeline, Queen, Cloten and Lords at one door, and at another Caius Lucius and Attendants."
    },
    {
      "id": "cymbeline-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cymbeline",
        "name": "CYMBELINE",
        "displayName": "Cymbeline"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Now say, what would Augustus Cæsar with us?",
          "plainText": "Now say what would Augustus Csar with us",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "When Julius Cæsar, (whose remembrance yet",
          "plainText": "When Julius Csar whose remembrance yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Lives in men's eyes, and will to ears and tongues",
          "plainText": "Lives in men's eyes and will to ears and tongues",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "Be theme and hearing ever) was in this Britain,",
          "plainText": "Be theme and hearing ever was in this Britain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "And conquer'd it, Cassibelan, thine uncle,",
          "plainText": "And conquer'd it Cassibelan thine uncle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 5,
          "text": "Famous in Cæsar's praises no whit less",
          "plainText": "Famous in Csar's praises no whit less",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 6,
          "text": "Than in his feats deserving it, for him",
          "plainText": "Than in his feats deserving it for him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 7,
          "text": "And his succession granted Rome a tribute,",
          "plainText": "And his succession granted Rome a tribute",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 8,
          "text": "Yearly three thousand pounds, which by thee lately",
          "plainText": "Yearly three thousand pounds which by thee lately",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 9,
          "text": "Is left untender'd.",
          "plainText": "Is left untender'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "queen",
        "name": "QUEEN",
        "displayName": "Queen"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "And, to kill the marvel,",
          "plainText": "And to kill the marvel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Shall be so ever.",
          "plainText": "Shall be so ever",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "There be many Cæsars ere such another Julius. Britain is a world by itself, and we will nothing pay for wearing our own noses.",
          "plainText": "There be many Csars ere such another Julius Britain is a world by itself and we will nothing pay for wearing our own noses",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "queen",
        "name": "QUEEN",
        "displayName": "Queen"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "That opportunity,",
          "plainText": "That opportunity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Which then they had to take from's, to resume",
          "plainText": "Which then they had to take from's to resume",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "We have again. Remember, sir, my liege,",
          "plainText": "We have again Remember sir my liege",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "The kings your ancestors, together with",
          "plainText": "The kings your ancestors together with",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "The natural bravery of your isle, which stands",
          "plainText": "The natural bravery of your isle which stands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 6,
          "text": "As Neptune's park, ribb'd and pal'd in",
          "plainText": "As Neptune's park ribb'd and pal'd in",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 7,
          "text": "With rocks unscaleable and roaring waters,",
          "plainText": "With rocks unscaleable and roaring waters",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 8,
          "text": "With sands that will not bear your enemies' boats",
          "plainText": "With sands that will not bear your enemies' boats",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 9,
          "text": "But suck them up to th' top-mast. A kind of conquest",
          "plainText": "But suck them up to th' topmast A kind of conquest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 10,
          "text": "Cæsar made here, but made not here his brag",
          "plainText": "Csar made here but made not here his brag",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 11,
          "text": "Of 'Came, and saw, and overcame.' With shame",
          "plainText": "Of 'Came and saw and overcame' With shame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 12,
          "text": "(The first that ever touch'd him) he was carried",
          "plainText": "The first that ever touch'd him he was carried",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 13,
          "text": "From off our coast, twice beaten; and his shipping",
          "plainText": "From off our coast twice beaten and his shipping",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 14,
          "text": "(Poor ignorant baubles!) on our terrible seas,",
          "plainText": "Poor ignorant baubles on our terrible seas",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0028",
          "number": 28,
          "speechLineNumber": 15,
          "text": "Like egg-shells mov'd upon their surges, crack'd",
          "plainText": "Like eggshells mov'd upon their surges crack'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0029",
          "number": 29,
          "speechLineNumber": 16,
          "text": "As easily 'gainst our rocks; for joy whereof",
          "plainText": "As easily 'gainst our rocks for joy whereof",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0030",
          "number": 30,
          "speechLineNumber": 17,
          "text": "The fam'd Cassibelan, who was once at point",
          "plainText": "The fam'd Cassibelan who was once at point",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0031",
          "number": 31,
          "speechLineNumber": 18,
          "text": "(O, giglot fortune!) to master Cæsar's sword,",
          "plainText": "O giglot fortune to master Csar's sword",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0032",
          "number": 32,
          "speechLineNumber": 19,
          "text": "Made Lud's Town with rejoicing fires bright",
          "plainText": "Made Lud's Town with rejoicing fires bright",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0033",
          "number": 33,
          "speechLineNumber": 20,
          "text": "And Britons strut with courage.",
          "plainText": "And Britons strut with courage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Come, there's no more tribute to be paid. Our kingdom is stronger than it was at that time; and, as I said, there is no moe such Cæsars. Other of them may have crook'd noses; but to owe such straight arms, none.",
          "plainText": "Come there's no more tribute to be paid Our kingdom is stronger than it was at that time and as I said there is no moe such Csars Other of them may have crook'd noses but to owe such straight arms none",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "cymbeline",
        "name": "CYMBELINE",
        "displayName": "Cymbeline"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Son, let your mother end.",
          "plainText": "Son let your mother end",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "We have yet many among us can gripe as hard as Cassibelan. I do not say I am one; but I have a hand. Why tribute? Why should we pay tribute? If Cæsar can hide the sun from us with a blanket, or put the moon in his pocket, we will pay him tribute for light; else, sir, no more tribute, pray you now.",
          "plainText": "We have yet many among us can gripe as hard as Cassibelan I do not say I am one but I have a hand Why tribute Why should we pay tribute If Csar can hide the sun from us with a blanket or put the moon in his pocket we will pay him tribute for light else sir no more tribute pray you now",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cymbeline",
        "name": "CYMBELINE",
        "displayName": "Cymbeline"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "You must know,",
          "plainText": "You must know",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Till the injurious Romans did extort",
          "plainText": "Till the injurious Romans did extort",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "This tribute from us, we were free. Cæsar's ambition,",
          "plainText": "This tribute from us we were free Csar's ambition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "Which swell'd so much that it did almost stretch",
          "plainText": "Which swell'd so much that it did almost stretch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0041",
          "number": 41,
          "speechLineNumber": 5,
          "text": "The sides o' th' world, against all colour here",
          "plainText": "The sides o' th' world against all colour here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0042",
          "number": 42,
          "speechLineNumber": 6,
          "text": "Did put the yoke upon's; which to shake off",
          "plainText": "Did put the yoke upon's which to shake off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0043",
          "number": 43,
          "speechLineNumber": 7,
          "text": "Becomes a warlike people, whom we reckon",
          "plainText": "Becomes a warlike people whom we reckon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0044",
          "number": 44,
          "speechLineNumber": 8,
          "text": "Ourselves to be.",
          "plainText": "Ourselves to be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "We do.",
          "plainText": "We do",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "cymbeline",
        "name": "CYMBELINE",
        "displayName": "Cymbeline"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Say then to Cæsar,",
          "plainText": "Say then to Csar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Our ancestor was that Mulmutius which",
          "plainText": "Our ancestor was that Mulmutius which",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "Ordain'd our laws, whose use the sword of Cæsar",
          "plainText": "Ordain'd our laws whose use the sword of Csar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "Hath too much mangled; whose repair and franchise",
          "plainText": "Hath too much mangled whose repair and franchise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0050",
          "number": 50,
          "speechLineNumber": 5,
          "text": "Shall, by the power we hold, be our good deed,",
          "plainText": "Shall by the power we hold be our good deed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0051",
          "number": 51,
          "speechLineNumber": 6,
          "text": "Though Rome be therefore angry. Mulmutius made our laws,",
          "plainText": "Though Rome be therefore angry Mulmutius made our laws",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0052",
          "number": 52,
          "speechLineNumber": 7,
          "text": "Who was the first of Britain which did put",
          "plainText": "Who was the first of Britain which did put",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0053",
          "number": 53,
          "speechLineNumber": 8,
          "text": "His brows within a golden crown, and call'd",
          "plainText": "His brows within a golden crown and call'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0054",
          "number": 54,
          "speechLineNumber": 9,
          "text": "Himself a king.",
          "plainText": "Himself a king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "I am sorry, Cymbeline,",
          "plainText": "I am sorry Cymbeline",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "That I am to pronounce Augustus Cæsar",
          "plainText": "That I am to pronounce Augustus Csar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "(Cæsar, that hath moe kings his servants than",
          "plainText": "Csar that hath moe kings his servants than",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0058",
          "number": 58,
          "speechLineNumber": 4,
          "text": "Thyself domestic officers) thine enemy.",
          "plainText": "Thyself domestic officers thine enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0059",
          "number": 59,
          "speechLineNumber": 5,
          "text": "Receive it from me, then: war and confusion",
          "plainText": "Receive it from me then war and confusion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0060",
          "number": 60,
          "speechLineNumber": 6,
          "text": "In Cæsar's name pronounce I 'gainst thee; look",
          "plainText": "In Csar's name pronounce I 'gainst thee look",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0061",
          "number": 61,
          "speechLineNumber": 7,
          "text": "For fury not to be resisted. Thus defied,",
          "plainText": "For fury not to be resisted Thus defied",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0062",
          "number": 62,
          "speechLineNumber": 8,
          "text": "I thank thee for myself.",
          "plainText": "I thank thee for myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cymbeline",
        "name": "CYMBELINE",
        "displayName": "Cymbeline"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Thou art welcome, Caius.",
          "plainText": "Thou art welcome Caius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "Thy Cæsar knighted me; my youth I spent",
          "plainText": "Thy Csar knighted me my youth I spent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "Much under him; of him I gather'd honour,",
          "plainText": "Much under him of him I gather'd honour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "Which he to seek of me again, perforce,",
          "plainText": "Which he to seek of me again perforce",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0067",
          "number": 67,
          "speechLineNumber": 5,
          "text": "Behoves me keep at utterance. I am perfect",
          "plainText": "Behoves me keep at utterance I am perfect",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0068",
          "number": 68,
          "speechLineNumber": 6,
          "text": "That the Pannonians and Dalmatians for",
          "plainText": "That the Pannonians and Dalmatians for",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0069",
          "number": 69,
          "speechLineNumber": 7,
          "text": "Their liberties are now in arms, a precedent",
          "plainText": "Their liberties are now in arms a precedent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0070",
          "number": 70,
          "speechLineNumber": 8,
          "text": "Which not to read would show the Britons cold;",
          "plainText": "Which not to read would show the Britons cold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0071",
          "number": 71,
          "speechLineNumber": 9,
          "text": "So Cæsar shall not find them.",
          "plainText": "So Csar shall not find them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Let proof speak.",
          "plainText": "Let proof speak",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cloten",
        "name": "CLOTEN",
        "displayName": "Cloten"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "His majesty bids you welcome. Make pastime with us a day or two, or longer. If you seek us afterwards in other terms, you shall find us in our salt-water girdle. If you beat us out of it, it is yours; if you fall in the adventure, our crows shall fare the better for you; and there's an end.",
          "plainText": "His majesty bids you welcome Make pastime with us a day or two or longer If you seek us afterwards in other terms you shall find us in our saltwater girdle If you beat us out of it it is yours if you fall in the adventure our crows shall fare the better for you and there's an end",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "So, sir.",
          "plainText": "So sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cymbeline",
        "name": "CYMBELINE",
        "displayName": "Cymbeline"
      },
      "lines": [
        {
          "id": "cymbeline-3-1-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "I know your master's pleasure, and he mine;",
          "plainText": "I know your master's pleasure and he mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-3-1-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "All the remain is, welcome.",
          "plainText": "All the remain is welcome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-3-1-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}