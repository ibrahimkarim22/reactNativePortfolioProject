  },
  "scene": {
    "id": "cymbeline-3-7",
    "act": 3,
    "scene": 7,
    "label": "Act 3, Scene 7",
    "title": "SCENE VII. The same.",
    "location": "The same.",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "cymbeline-3-7-stage-001",
      "type": "stage",
      "text": "Enter Belarius, Guiderius and Arviragus."
    },
    {
      "id": "cymbeline-3-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "belarius",
        "name": "BELARIUS",
        "displayName": "Belarius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "You, Polydore, have prov'd best woodman and",
          "plainText": "You Polydore have prov'd best woodman and",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Are master of the feast. Cadwal and I",
          "plainText": "Are master of the feast Cadwal and I",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Will play the cook and servant; 'tis our match.",
          "plainText": "Will play the cook and servant 'tis our match",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "The sweat of industry would dry and die",
          "plainText": "The sweat of industry would dry and die",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "But for the end it works to. Come, our stomachs",
          "plainText": "But for the end it works to Come our stomachs",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Will make what's homely savoury; weariness",
          "plainText": "Will make what's homely savoury weariness",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Can snore upon the flint, when resty sloth",
          "plainText": "Can snore upon the flint when resty sloth",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Finds the down pillow hard. Now, peace be here,",
          "plainText": "Finds the down pillow hard Now peace be here",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Poor house, that keep'st thyself!",
          "plainText": "Poor house that keep'st thyself",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "guiderius",
        "name": "GUIDERIUS",
        "displayName": "Guiderius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "I am thoroughly weary.",
          "plainText": "I am thoroughly weary",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "arviragus",
        "name": "ARVIRAGUS",
        "displayName": "Arviragus"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "I am weak with toil, yet strong in appetite.",
          "plainText": "I am weak with toil yet strong in appetite",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-004",
      "type": "speech",
      "speaker": {
        "id": "guiderius",
        "name": "GUIDERIUS",
        "displayName": "Guiderius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "There is cold meat i' th' cave; we'll browse on that",
          "plainText": "There is cold meat i' th' cave we'll browse on that",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Whilst what we have kill'd be cook'd.",
          "plainText": "Whilst what we have kill'd be cook'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-005",
      "type": "speech",
      "speaker": {
        "id": "belarius",
        "name": "BELARIUS",
        "displayName": "Belarius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "[Looking into the cave.] Stay, come not in.",
          "plainText": "Looking into the cave Stay come not in",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "But that it eats our victuals, I should think",
          "plainText": "But that it eats our victuals I should think",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "Here were a fairy.",
          "plainText": "Here were a fairy",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-006",
      "type": "speech",
      "speaker": {
        "id": "guiderius",
        "name": "GUIDERIUS",
        "displayName": "Guiderius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "What's the matter, sir?",
          "plainText": "What's the matter sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-007",
      "type": "speech",
      "speaker": {
        "id": "belarius",
        "name": "BELARIUS",
        "displayName": "Belarius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "By Jupiter, an angel! or, if not,",
          "plainText": "By Jupiter an angel or if not",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "An earthly paragon! Behold divineness",
          "plainText": "An earthly paragon Behold divineness",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "No elder than a boy!",
          "plainText": "No elder than a boy",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-stage-002",
      "type": "stage",
      "text": "Enter Imogen."
    },
    {
      "id": "cymbeline-3-7-speech-008",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Good masters, harm me not.",
          "plainText": "Good masters harm me not",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "Before I enter'd here I call'd, and thought",
          "plainText": "Before I enter'd here I call'd and thought",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "To have begg'd or bought what I have took. Good troth,",
          "plainText": "To have begg'd or bought what I have took Good troth",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "I have stol'n nought; nor would not though I had found",
          "plainText": "I have stol'n nought nor would not though I had found",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "Gold strew'd i' th' floor. Here's money for my meat.",
          "plainText": "Gold strew'd i' th' floor Here's money for my meat",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0026",
          "number": 26,
          "speechLineNumber": 6,
          "text": "I would have left it on the board, so soon",
          "plainText": "I would have left it on the board so soon",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0027",
          "number": 27,
          "speechLineNumber": 7,
          "text": "As I had made my meal, and parted",
          "plainText": "As I had made my meal and parted",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0028",
          "number": 28,
          "speechLineNumber": 8,
          "text": "With pray'rs for the provider.",
          "plainText": "With pray'rs for the provider",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-009",
      "type": "speech",
      "speaker": {
        "id": "guiderius",
        "name": "GUIDERIUS",
        "displayName": "Guiderius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Money, youth?",
          "plainText": "Money youth",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-010",
      "type": "speech",
      "speaker": {
        "id": "arviragus",
        "name": "ARVIRAGUS",
        "displayName": "Arviragus"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "All gold and silver rather turn to dirt,",
          "plainText": "All gold and silver rather turn to dirt",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "As 'tis no better reckon'd but of those",
          "plainText": "As 'tis no better reckon'd but of those",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "Who worship dirty gods.",
          "plainText": "Who worship dirty gods",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-011",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "I see you're angry.",
          "plainText": "I see you're angry",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Know, if you kill me for my fault, I should",
          "plainText": "Know if you kill me for my fault I should",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Have died had I not made it.",
          "plainText": "Have died had I not made it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-012",
      "type": "speech",
      "speaker": {
        "id": "belarius",
        "name": "BELARIUS",
        "displayName": "Belarius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Whither bound?",
          "plainText": "Whither bound",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-013",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "To Milford Haven.",
          "plainText": "To Milford Haven",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-014",
      "type": "speech",
      "speaker": {
        "id": "belarius",
        "name": "BELARIUS",
        "displayName": "Belarius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "What's your name?",
          "plainText": "What's your name",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-015",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Fidele, sir. I have a kinsman who",
          "plainText": "Fidele sir I have a kinsman who",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "Is bound for Italy; he embark'd at Milford;",
          "plainText": "Is bound for Italy he embark'd at Milford",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "To whom being going, almost spent with hunger,",
          "plainText": "To whom being going almost spent with hunger",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0042",
          "number": 42,
          "speechLineNumber": 4,
          "text": "I am fall'n in this offence.",
          "plainText": "I am fall'n in this offence",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-016",
      "type": "speech",
      "speaker": {
        "id": "belarius",
        "name": "BELARIUS",
        "displayName": "Belarius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Prithee, fair youth,",
          "plainText": "Prithee fair youth",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "Think us no churls, nor measure our good minds",
          "plainText": "Think us no churls nor measure our good minds",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "By this rude place we live in. Well encounter'd!",
          "plainText": "By this rude place we live in Well encounter'd",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "'Tis almost night; you shall have better cheer",
          "plainText": "'Tis almost night you shall have better cheer",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0047",
          "number": 47,
          "speechLineNumber": 5,
          "text": "Ere you depart, and thanks to stay and eat it.",
          "plainText": "Ere you depart and thanks to stay and eat it",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0048",
          "number": 48,
          "speechLineNumber": 6,
          "text": "Boys, bid him welcome.",
          "plainText": "Boys bid him welcome",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-017",
      "type": "speech",
      "speaker": {
        "id": "guiderius",
        "name": "GUIDERIUS",
        "displayName": "Guiderius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Were you a woman, youth,",
          "plainText": "Were you a woman youth",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "I should woo hard but be your groom. In honesty",
          "plainText": "I should woo hard but be your groom In honesty",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "I bid for you as I'd buy.",
          "plainText": "I bid for you as I'd buy",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-018",
      "type": "speech",
      "speaker": {
        "id": "arviragus",
        "name": "ARVIRAGUS",
        "displayName": "Arviragus"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "I'll make't my comfort",
          "plainText": "I'll make't my comfort",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "He is a man. I'll love him as my brother;",
          "plainText": "He is a man I'll love him as my brother",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "And such a welcome as I'd give to him",
          "plainText": "And such a welcome as I'd give to him",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0055",
          "number": 55,
          "speechLineNumber": 4,
          "text": "After long absence, such is yours. Most welcome!",
          "plainText": "After long absence such is yours Most welcome",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0056",
          "number": 56,
          "speechLineNumber": 5,
          "text": "Be sprightly, for you fall 'mongst friends.",
          "plainText": "Be sprightly for you fall 'mongst friends",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-019",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "'Mongst friends,",
          "plainText": "'Mongst friends",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "If brothers. [Aside.] Would it had been so that they",
          "plainText": "If brothers Aside Would it had been so that they",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0059",
          "number": 59,
          "speechLineNumber": 3,
          "text": "Had been my father's sons! Then had my prize",
          "plainText": "Had been my father's sons Then had my prize",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0060",
          "number": 60,
          "speechLineNumber": 4,
          "text": "Been less, and so more equal ballasting",
          "plainText": "Been less and so more equal ballasting",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0061",
          "number": 61,
          "speechLineNumber": 5,
          "text": "To thee, Posthumus.",
          "plainText": "To thee Posthumus",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-020",
      "type": "speech",
      "speaker": {
        "id": "belarius",
        "name": "BELARIUS",
        "displayName": "Belarius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "He wrings at some distress.",
          "plainText": "He wrings at some distress",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-021",
      "type": "speech",
      "speaker": {
        "id": "guiderius",
        "name": "GUIDERIUS",
        "displayName": "Guiderius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Would I could free't!",
          "plainText": "Would I could free't",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-022",
      "type": "speech",
      "speaker": {
        "id": "arviragus",
        "name": "ARVIRAGUS",
        "displayName": "Arviragus"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Or I, whate'er it be,",
          "plainText": "Or I whate'er it be",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "What pain it cost, what danger! Gods!",
          "plainText": "What pain it cost what danger Gods",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-023",
      "type": "speech",
      "speaker": {
        "id": "belarius",
        "name": "BELARIUS",
        "displayName": "Belarius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "[Whispering.] Hark, boys.",
          "plainText": "Whispering Hark boys",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-024",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "[Aside.] Great men,",
          "plainText": "Aside Great men",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "That had a court no bigger than this cave,",
          "plainText": "That had a court no bigger than this cave",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0069",
          "number": 69,
          "speechLineNumber": 3,
          "text": "That did attend themselves, and had the virtue",
          "plainText": "That did attend themselves and had the virtue",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0070",
          "number": 70,
          "speechLineNumber": 4,
          "text": "Which their own conscience seal'd them, laying by",
          "plainText": "Which their own conscience seal'd them laying by",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0071",
          "number": 71,
          "speechLineNumber": 5,
          "text": "That nothing-gift of differing multitudes,",
          "plainText": "That nothinggift of differing multitudes",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0072",
          "number": 72,
          "speechLineNumber": 6,
          "text": "Could not out-peer these twain. Pardon me, gods!",
          "plainText": "Could not outpeer these twain Pardon me gods",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0073",
          "number": 73,
          "speechLineNumber": 7,
          "text": "I'd change my sex to be companion with them,",
          "plainText": "I'd change my sex to be companion with them",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0074",
          "number": 74,
          "speechLineNumber": 8,
          "text": "Since Leonatus false.",
          "plainText": "Since Leonatus false",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-025",
      "type": "speech",
      "speaker": {
        "id": "belarius",
        "name": "BELARIUS",
        "displayName": "Belarius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "It shall be so.",
          "plainText": "It shall be so",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "Boys, we'll go dress our hunt. Fair youth, come in.",
          "plainText": "Boys we'll go dress our hunt Fair youth come in",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0077",
          "number": 77,
          "speechLineNumber": 3,
          "text": "Discourse is heavy, fasting; when we have supp'd,",
          "plainText": "Discourse is heavy fasting when we have supp'd",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0078",
          "number": 78,
          "speechLineNumber": 4,
          "text": "We'll mannerly demand thee of thy story,",
          "plainText": "We'll mannerly demand thee of thy story",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0079",
          "number": 79,
          "speechLineNumber": 5,
          "text": "So far as thou wilt speak it.",
          "plainText": "So far as thou wilt speak it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-026",
      "type": "speech",
      "speaker": {
        "id": "guiderius",
        "name": "GUIDERIUS",
        "displayName": "Guiderius"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "Pray draw near.",
          "plainText": "Pray draw near",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-027",
      "type": "speech",
      "speaker": {
        "id": "arviragus",
        "name": "ARVIRAGUS",
        "displayName": "Arviragus"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "The night to th' owl and morn to th' lark less",
          "plainText": "The night to th' owl and morn to th' lark less",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-7-line-0082",
          "number": 82,
          "speechLineNumber": 2,
          "text": "welcome.",
          "plainText": "welcome",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-028",
      "type": "speech",
      "speaker": {
        "id": "imogen",
        "name": "IMOGEN",
        "displayName": "Imogen"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "Thanks, sir.",
          "plainText": "Thanks sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-speech-029",
      "type": "speech",
      "speaker": {
        "id": "arviragus",
        "name": "ARVIRAGUS",
        "displayName": "Arviragus"
      },
      "lines": [
        {
          "id": "cymbeline-3-7-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "I pray draw near.",
          "plainText": "I pray draw near",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-7-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}