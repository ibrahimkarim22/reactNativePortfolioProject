  "scene": {
    "id": "cymbeline-3-8",
    "act": 3,
    "scene": 8,
    "label": "Act 3, Scene 8",
    "title": "SCENE VIII. Rome. A public place.",
    "location": "Rome. A public place.",
    "orderInPlay": 20
  },
  "content": [
    {
      "id": "cymbeline-3-8-stage-001",
      "type": "stage",
      "text": "Enter two Roman Senators and Tribunes."
    },
    {
      "id": "cymbeline-3-8-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-senator",
        "name": "FIRST SENATOR",
        "displayName": "First Senator"
      },
      "lines": [
        {
          "id": "cymbeline-3-8-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "This is the tenour of the Emperor's writ:",
          "plainText": "This is the tenour of the Emperor's writ",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "That since the common men are now in action",
          "plainText": "That since the common men are now in action",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "'Gainst the Pannonians and Dalmatians,",
          "plainText": "'Gainst the Pannonians and Dalmatians",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And that the legions now in Gallia are",
          "plainText": "And that the legions now in Gallia are",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Full weak to undertake our wars against",
          "plainText": "Full weak to undertake our wars against",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "The fall'n-off Britons, that we do incite",
          "plainText": "The fall'noff Britons that we do incite",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "The gentry to this business. He creates",
          "plainText": "The gentry to this business He creates",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Lucius proconsul; and to you, the tribunes,",
          "plainText": "Lucius proconsul and to you the tribunes",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "For this immediate levy, he commands",
          "plainText": "For this immediate levy he commands",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "His absolute commission. Long live Cæsar!",
          "plainText": "His absolute commission Long live Csar",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-8-speech-002",
      "type": "speech",
      "speaker": {
        "id": "tribune",
        "name": "TRIBUNE",
        "displayName": "Tribune"
      },
      "lines": [
        {
          "id": "cymbeline-3-8-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Is Lucius general of the forces?",
          "plainText": "Is Lucius general of the forces",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-8-speech-003",
      "type": "speech",
      "speaker": {
        "id": "second-senator",
        "name": "SECOND SENATOR",
        "displayName": "Second Senator"
      },
      "lines": [
        {
          "id": "cymbeline-3-8-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Ay.",
          "plainText": "Ay",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-8-speech-004",
      "type": "speech",
      "speaker": {
        "id": "tribune",
        "name": "TRIBUNE",
        "displayName": "Tribune"
      },
      "lines": [
        {
          "id": "cymbeline-3-8-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Remaining now in Gallia?",
          "plainText": "Remaining now in Gallia",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-8-speech-005",
      "type": "speech",
      "speaker": {
        "id": "first-senator",
        "name": "FIRST SENATOR",
        "displayName": "First Senator"
      },
      "lines": [
        {
          "id": "cymbeline-3-8-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "With those legions",
          "plainText": "With those legions",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Which I have spoke of, whereunto your levy",
          "plainText": "Which I have spoke of whereunto your levy",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "Must be supplyant. The words of your commission",
          "plainText": "Must be supplyant The words of your commission",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "Will tie you to the numbers and the time",
          "plainText": "Will tie you to the numbers and the time",
          "lineType": "verse"
        },
        {
          "id": "cymbeline-3-8-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "Of their dispatch.",
          "plainText": "Of their dispatch",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "cymbeline-3-8-speech-006",
      "type": "speech",
      "speaker": {
        "id": "tribune",
        "name": "TRIBUNE",
        "displayName": "Tribune"
      },
      "lines": [
        {
          "id": "cymbeline-3-8-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "We will discharge our duty.",
          "plainText": "We will discharge our duty",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "cymbeline-3-8-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}