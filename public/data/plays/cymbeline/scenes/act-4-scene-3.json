{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "cymbeline",
    "title": "Cymbeline",
    "author": "William Shakespeare",
    "genre": "Romance"
  },
  "source": {
    "name": "Project Gutenberg",
    "ebookNumber": 100,
