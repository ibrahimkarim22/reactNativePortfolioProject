  "scene": {
    "id": "cymbeline-4-3",
    "act": 4,
    "scene": 3,
    "label": "Act 4, Scene 3",
    "title": "SCENE III. Britain. Cymbeline's palace.",
    "location": "Britain. Cymbeline's palace.",
    "orderInPlay": 23
  },
  "content": [
    {
      "id": "cymbeline-4-3-stage-001",
      "type": "stage",
      "text": "Enter Cymbeline, Lords, Pisanio and Attendants."
    },
    {
      "id": "cymbeline-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cymbeline",
        "name": "CYMBELINE",
        "displayName": "Cymbeline"
      },
      "lines": [
        {
          "id": "cymbeline-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Again! and bring me word how 'tis with her.",
          "plainText": "Again and bring me word how 'tis with her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "cymbeline-4-3-stage-002",
      "type": "stage",
      "text": "[Exit an Attendant.]"
    },
    {
      "id": "cymbeline-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Sir, my life is yours;",
          "plainText": "Sir my life is yours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "I humbly set it at your will; but for my mistress,",
          "plainText": "I humbly set it at your will but for my mistress",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "I nothing know where she remains, why gone,",
          "plainText": "I nothing know where she remains why gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "Nor when she purposes return. Beseech your Highness,",
          "plainText": "Nor when she purposes return Beseech your Highness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 5,
          "text": "Hold me your loyal servant.",
          "plainText": "Hold me your loyal servant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lord",
        "name": "LORD",
        "displayName": "Lord"
      },
      "lines": [
        {
          "id": "cymbeline-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Good my liege,",
          "plainText": "Good my liege",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "The day that she was missing he was here.",
          "plainText": "The day that she was missing he was here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "I dare be bound he's true and shall perform",
          "plainText": "I dare be bound he's true and shall perform",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "All parts of his subjection loyally. For Cloten,",
          "plainText": "All parts of his subjection loyally For Cloten",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "There wants no diligence in seeking him,",
          "plainText": "There wants no diligence in seeking him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "And will no doubt be found.",
          "plainText": "And will no doubt be found",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cymbeline",
        "name": "CYMBELINE",
        "displayName": "Cymbeline"
      },
      "lines": [
        {
          "id": "cymbeline-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "The time is troublesome.",
          "plainText": "The time is troublesome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "[To Pisanio.] We'll slip you for a season; but our jealousy",
          "plainText": "To Pisanio We'll slip you for a season but our jealousy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "Does yet depend.",
          "plainText": "Does yet depend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lord",
        "name": "LORD",
        "displayName": "Lord"
      },
      "lines": [
        {
          "id": "cymbeline-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "So please your Majesty,",
          "plainText": "So please your Majesty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "The Roman legions, all from Gallia drawn,",
          "plainText": "The Roman legions all from Gallia drawn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Are landed on your coast, with a supply",
          "plainText": "Are landed on your coast with a supply",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "Of Roman gentlemen by the Senate sent.",
          "plainText": "Of Roman gentlemen by the Senate sent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-4-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cymbeline",
        "name": "CYMBELINE",
        "displayName": "Cymbeline"
      },
      "lines": [
        {
          "id": "cymbeline-4-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Now for the counsel of my son and queen!",
          "plainText": "Now for the counsel of my son and queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "I am amaz'd with matter.",
          "plainText": "I am amaz'd with matter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-4-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lord",
        "name": "LORD",
        "displayName": "Lord"
      },
      "lines": [
        {
          "id": "cymbeline-4-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Good my liege,",
          "plainText": "Good my liege",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Your preparation can affront no less",
          "plainText": "Your preparation can affront no less",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "Than what you hear of. Come more, for more you're ready.",
          "plainText": "Than what you hear of Come more for more you're ready",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "The want is but to put those pow'rs in motion",
          "plainText": "The want is but to put those pow'rs in motion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "That long to move.",
          "plainText": "That long to move",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-4-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cymbeline",
        "name": "CYMBELINE",
        "displayName": "Cymbeline"
      },
      "lines": [
        {
          "id": "cymbeline-4-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "I thank you. Let's withdraw,",
          "plainText": "I thank you Let's withdraw",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "And meet the time as it seeks us. We fear not",
          "plainText": "And meet the time as it seeks us We fear not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "What can from Italy annoy us; but",
          "plainText": "What can from Italy annoy us but",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "We grieve at chances here. Away!",
          "plainText": "We grieve at chances here Away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-4-3-stage-003",
      "type": "stage",
      "text": "[Exeunt all but Pisanio.]"
    },
    {
      "id": "cymbeline-4-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "pisanio",
        "name": "PISANIO",
        "displayName": "Pisanio"
      },
      "lines": [
        {
          "id": "cymbeline-4-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "I heard no letter from my master since",
          "plainText": "I heard no letter from my master since",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "I wrote him Imogen was slain. 'Tis strange.",
          "plainText": "I wrote him Imogen was slain 'Tis strange",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "Nor hear I from my mistress, who did promise",
          "plainText": "Nor hear I from my mistress who did promise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "To yield me often tidings. Neither know I",
          "plainText": "To yield me often tidings Neither know I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0035",
          "number": 35,
          "speechLineNumber": 5,
          "text": "What is betid to Cloten, but remain",
          "plainText": "What is betid to Cloten but remain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0036",
          "number": 36,
          "speechLineNumber": 6,
          "text": "Perplex'd in all. The heavens still must work.",
          "plainText": "Perplex'd in all The heavens still must work",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0037",
          "number": 37,
          "speechLineNumber": 7,
          "text": "Wherein I am false I am honest; not true, to be true.",
          "plainText": "Wherein I am false I am honest not true to be true",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0038",
          "number": 38,
          "speechLineNumber": 8,
          "text": "These present wars shall find I love my country,",
          "plainText": "These present wars shall find I love my country",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0039",
          "number": 39,
          "speechLineNumber": 9,
          "text": "Even to the note o' th' King, or I'll fall in them.",
          "plainText": "Even to the note o' th' King or I'll fall in them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0040",
          "number": 40,
          "speechLineNumber": 10,
          "text": "All other doubts, by time let them be clear'd:",
          "plainText": "All other doubts by time let them be clear'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "cymbeline-4-3-line-0041",
          "number": 41,
          "speechLineNumber": 11,
          "text": "Fortune brings in some boats that are not steer'd.",
          "plainText": "Fortune brings in some boats that are not steer'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "cymbeline-4-3-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}