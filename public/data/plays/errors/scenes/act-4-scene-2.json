      "type": "speech",
      "speaker": {
        "id": "dromio-of-syracuse",
        "name": "DROMIO OF SYRACUSE",
        "displayName": "Dromio Of Syracuse"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Here, go; the desk, the purse, sweet now, make haste.",
          "plainText": "Here go the desk the purse sweet now make haste",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
