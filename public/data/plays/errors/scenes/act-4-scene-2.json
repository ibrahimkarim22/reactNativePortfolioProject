      "type": "speech",
      "speaker": {
        "id": "luciana",
        "name": "LUCIANA",
        "displayName": "Luciana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "How hast thou lost thy breath?",
          "plainText": "How hast thou lost thy breath",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "dromio-of-syracuse",
        "name": "DROMIO OF SYRACUSE",
        "displayName": "Dromio Of Syracuse"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "By running fast.",
          "plainText": "By running fast",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "adriana",
        "name": "ADRIANA",
        "displayName": "Adriana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Where is thy master, Dromio? is he well?",
          "plainText": "Where is thy master Dromio is he well",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "dromio-of-syracuse",
        "name": "DROMIO OF SYRACUSE",
        "displayName": "Dromio Of Syracuse"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "No, he's in Tartar limbo, worse than hell.",
          "plainText": "No he's in Tartar limbo worse than hell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "A devil in an everlasting garment hath him,",
          "plainText": "A devil in an everlasting garment hath him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "One whose hard heart is button'd up with steel;",
          "plainText": "One whose hard heart is button'd up with steel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0038",
          "number": 38,
          "speechLineNumber": 4,
          "text": "A fiend, a fairy, pitiless and rough;",
          "plainText": "A fiend a fairy pitiless and rough",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0039",
          "number": 39,
          "speechLineNumber": 5,
          "text": "A wolf, nay worse, a fellow all in buff;",
          "plainText": "A wolf nay worse a fellow all in buff",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0040",
          "number": 40,
          "speechLineNumber": 6,
          "text": "A back-friend, a shoulder-clapper, one that countermands",
          "plainText": "A backfriend a shoulderclapper one that countermands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0041",
          "number": 41,
          "speechLineNumber": 7,
          "text": "The passages of alleys, creeks, and narrow lands;",
          "plainText": "The passages of alleys creeks and narrow lands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0042",
          "number": 42,
          "speechLineNumber": 8,
          "text": "A hound that runs counter, and yet draws dryfoot well,",
          "plainText": "A hound that runs counter and yet draws dryfoot well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0043",
          "number": 43,
          "speechLineNumber": 9,
          "text": "One that, before the judgement, carries poor souls to hell.",
          "plainText": "One that before the judgement carries poor souls to hell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "adriana",
        "name": "ADRIANA",
        "displayName": "Adriana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Why, man, what is the matter?",
          "plainText": "Why man what is the matter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "dromio-of-syracuse",
        "name": "DROMIO OF SYRACUSE",
        "displayName": "Dromio Of Syracuse"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "I do not know the matter. He is 'rested on the case.",
          "plainText": "I do not know the matter He is 'rested on the case",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
