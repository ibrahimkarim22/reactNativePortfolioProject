  "content": [
    {
      "id": "errors-4-2-stage-001",
      "type": "stage",
      "text": "Enter Adriana and Luciana."
    },
    {
      "id": "errors-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "adriana",
        "name": "ADRIANA",
        "displayName": "Adriana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Ah, Luciana, did he tempt thee so?",
          "plainText": "Ah Luciana did he tempt thee so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Might'st thou perceive austerely in his eye",
          "plainText": "Might'st thou perceive austerely in his eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "That he did plead in earnest, yea or no?",
          "plainText": "That he did plead in earnest yea or no",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Look'd he or red or pale, or sad or merrily?",
          "plainText": "Look'd he or red or pale or sad or merrily",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "What observation mad'st thou in this case",
          "plainText": "What observation mad'st thou in this case",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Of his heart's meteors tilting in his face?",
          "plainText": "Of his heart's meteors tilting in his face",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "luciana",
        "name": "LUCIANA",
        "displayName": "Luciana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "First he denied you had in him no right.",
          "plainText": "First he denied you had in him no right",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "adriana",
        "name": "ADRIANA",
        "displayName": "Adriana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "He meant he did me none; the more my spite.",
          "plainText": "He meant he did me none the more my spite",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "luciana",
        "name": "LUCIANA",
        "displayName": "Luciana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Then swore he that he was a stranger here.",
          "plainText": "Then swore he that he was a stranger here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "adriana",
        "name": "ADRIANA",
        "displayName": "Adriana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "And true he swore, though yet forsworn he were.",
          "plainText": "And true he swore though yet forsworn he were",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "luciana",
        "name": "LUCIANA",
        "displayName": "Luciana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Then pleaded I for you.",
          "plainText": "Then pleaded I for you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "adriana",
        "name": "ADRIANA",
        "displayName": "Adriana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "And what said he?",
          "plainText": "And what said he",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "luciana",
        "name": "LUCIANA",
        "displayName": "Luciana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "That love I begg'd for you he begg'd of me.",
          "plainText": "That love I begg'd for you he begg'd of me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "adriana",
        "name": "ADRIANA",
        "displayName": "Adriana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "With what persuasion did he tempt thy love?",
          "plainText": "With what persuasion did he tempt thy love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "luciana",
        "name": "LUCIANA",
        "displayName": "Luciana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "With words that in an honest suit might move.",
          "plainText": "With words that in an honest suit might move",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "First he did praise my beauty, then my speech.",
          "plainText": "First he did praise my beauty then my speech",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "adriana",
        "name": "ADRIANA",
        "displayName": "Adriana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Did'st speak him fair?",
          "plainText": "Did'st speak him fair",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "luciana",
        "name": "LUCIANA",
        "displayName": "Luciana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Have patience, I beseech.",
          "plainText": "Have patience I beseech",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "adriana",
        "name": "ADRIANA",
        "displayName": "Adriana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I cannot, nor I will not hold me still.",
          "plainText": "I cannot nor I will not hold me still",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "My tongue, though not my heart, shall have his will.",
          "plainText": "My tongue though not my heart shall have his will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "He is deformed, crooked, old, and sere,",
          "plainText": "He is deformed crooked old and sere",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "Ill-fac'd, worse bodied, shapeless everywhere;",
          "plainText": "Illfac'd worse bodied shapeless everywhere",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "Vicious, ungentle, foolish, blunt, unkind,",
          "plainText": "Vicious ungentle foolish blunt unkind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "Stigmatical in making, worse in mind.",
          "plainText": "Stigmatical in making worse in mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "luciana",
        "name": "LUCIANA",
        "displayName": "Luciana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Who would be jealous then of such a one?",
          "plainText": "Who would be jealous then of such a one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "No evil lost is wail'd when it is gone.",
          "plainText": "No evil lost is wail'd when it is gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "errors-4-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "adriana",
        "name": "ADRIANA",
        "displayName": "Adriana"
      },
      "lines": [
        {
          "id": "errors-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Ah, but I think him better than I say,",
          "plainText": "Ah but I think him better than I say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "And yet would herein others' eyes were worse:",
          "plainText": "And yet would herein others' eyes were worse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "Far from her nest the lapwing cries away;",
          "plainText": "Far from her nest the lapwing cries away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "errors-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "My heart prays for him, though my tongue do curse.",
          "plainText": "My heart prays for him though my tongue do curse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "errors-4-2-stage-002",
      "type": "stage",
      "text": "Enter Dromio of Syracuse."
    },
