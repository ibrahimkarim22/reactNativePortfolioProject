  "content": [
    {
      "id": "hamlet-prince-of-denmark-1-4-stage-001",
      "type": "stage",
      "text": "Enter Hamlet, Horatio and Marcellus."
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The air bites shrewdly; it is very cold.",
          "plainText": "The air bites shrewdly it is very cold",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "It is a nipping and an eager air.",
          "plainText": "It is a nipping and an eager air",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "What hour now?",
          "plainText": "What hour now",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I think it lacks of twelve.",
          "plainText": "I think it lacks of twelve",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "marcellus",
        "name": "MARCELLUS",
        "displayName": "Marcellus"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "No, it is struck.",
          "plainText": "No it is struck",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Indeed? I heard it not. It then draws near the season",
          "plainText": "Indeed I heard it not It then draws near the season",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Wherein the spirit held his wont to walk.",
          "plainText": "Wherein the spirit held his wont to walk",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-stage-002",
      "type": "stage",
      "text": "[A flourish of trumpets, and ordnance shot off within.]"
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "The King doth wake tonight and takes his rouse,",
          "plainText": "The King doth wake tonight and takes his rouse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Keeps wassail, and the swaggering upspring reels;",
          "plainText": "Keeps wassail and the swaggering upspring reels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "And as he drains his draughts of Rhenish down,",
          "plainText": "And as he drains his draughts of Rhenish down",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "The kettle-drum and trumpet thus bray out",
          "plainText": "The kettledrum and trumpet thus bray out",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "The triumph of his pledge.",
          "plainText": "The triumph of his pledge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Is it a custom?",
          "plainText": "Is it a custom",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Ay marry is't;",
          "plainText": "Ay marry is't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "And to my mind, though I am native here,",
          "plainText": "And to my mind though I am native here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "And to the manner born, it is a custom",
          "plainText": "And to the manner born it is a custom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "More honour'd in the breach than the observance.",
          "plainText": "More honour'd in the breach than the observance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "This heavy-headed revel east and west",
          "plainText": "This heavyheaded revel east and west",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0019",
          "number": 19,
          "speechLineNumber": 6,
          "text": "Makes us traduc'd and tax'd of other nations:",
          "plainText": "Makes us traduc'd and tax'd of other nations",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0020",
          "number": 20,
          "speechLineNumber": 7,
          "text": "They clepe us drunkards, and with swinish phrase",
          "plainText": "They clepe us drunkards and with swinish phrase",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0021",
          "number": 21,
          "speechLineNumber": 8,
          "text": "Soil our addition; and indeed it takes",
          "plainText": "Soil our addition and indeed it takes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0022",
          "number": 22,
          "speechLineNumber": 9,
          "text": "From our achievements, though perform'd at height,",
          "plainText": "From our achievements though perform'd at height",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0023",
          "number": 23,
          "speechLineNumber": 10,
          "text": "The pith and marrow of our attribute.",
          "plainText": "The pith and marrow of our attribute",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0024",
          "number": 24,
          "speechLineNumber": 11,
          "text": "So oft it chances in particular men",
          "plainText": "So oft it chances in particular men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0025",
          "number": 25,
          "speechLineNumber": 12,
          "text": "That for some vicious mole of nature in them,",
          "plainText": "That for some vicious mole of nature in them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0026",
          "number": 26,
          "speechLineNumber": 13,
          "text": "As in their birth, wherein they are not guilty,",
          "plainText": "As in their birth wherein they are not guilty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0027",
          "number": 27,
          "speechLineNumber": 14,
          "text": "Since nature cannot choose his origin,",
          "plainText": "Since nature cannot choose his origin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0028",
          "number": 28,
          "speechLineNumber": 15,
          "text": "By their o'ergrowth of some complexion,",
          "plainText": "By their o'ergrowth of some complexion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0029",
          "number": 29,
          "speechLineNumber": 16,
          "text": "Oft breaking down the pales and forts of reason;",
          "plainText": "Oft breaking down the pales and forts of reason",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0030",
          "number": 30,
          "speechLineNumber": 17,
          "text": "Or by some habit, that too much o'erleavens",
          "plainText": "Or by some habit that too much o'erleavens",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0031",
          "number": 31,
          "speechLineNumber": 18,
          "text": "The form of plausive manners;—that these men,",
          "plainText": "The form of plausive mannersthat these men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0032",
          "number": 32,
          "speechLineNumber": 19,
          "text": "Carrying, I say, the stamp of one defect,",
          "plainText": "Carrying I say the stamp of one defect",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0033",
          "number": 33,
          "speechLineNumber": 20,
          "text": "Being Nature's livery or Fortune's star,—",
          "plainText": "Being Nature's livery or Fortune's star",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0034",
          "number": 34,
          "speechLineNumber": 21,
          "text": "His virtues else,—be they as pure as grace,",
          "plainText": "His virtues elsebe they as pure as grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0035",
          "number": 35,
          "speechLineNumber": 22,
          "text": "As infinite as man may undergo,",
          "plainText": "As infinite as man may undergo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0036",
          "number": 36,
          "speechLineNumber": 23,
          "text": "Shall in the general censure take corruption",
          "plainText": "Shall in the general censure take corruption",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0037",
          "number": 37,
          "speechLineNumber": 24,
          "text": "From that particular fault. The dram of evil",
          "plainText": "From that particular fault The dram of evil",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0038",
          "number": 38,
          "speechLineNumber": 25,
          "text": "Doth all the noble substance of a doubt",
          "plainText": "Doth all the noble substance of a doubt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0039",
          "number": 39,
          "speechLineNumber": 26,
          "text": "To his own scandal.",
          "plainText": "To his own scandal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Look, my lord, it comes!",
          "plainText": "Look my lord it comes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-stage-003",
      "type": "stage",
      "text": "Enter Ghost."
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Angels and ministers of grace defend us!",
          "plainText": "Angels and ministers of grace defend us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Be thou a spirit of health or goblin damn'd,",
          "plainText": "Be thou a spirit of health or goblin damn'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "Bring with thee airs from heaven or blasts from hell,",
          "plainText": "Bring with thee airs from heaven or blasts from hell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "Be thy intents wicked or charitable,",
          "plainText": "Be thy intents wicked or charitable",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "Thou com'st in such a questionable shape",
          "plainText": "Thou com'st in such a questionable shape",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "That I will speak to thee. I'll call thee Hamlet,",
          "plainText": "That I will speak to thee I'll call thee Hamlet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0047",
          "number": 47,
          "speechLineNumber": 7,
          "text": "King, father, royal Dane. O, answer me!",
          "plainText": "King father royal Dane O answer me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0048",
          "number": 48,
          "speechLineNumber": 8,
          "text": "Let me not burst in ignorance; but tell",
          "plainText": "Let me not burst in ignorance but tell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0049",
          "number": 49,
          "speechLineNumber": 9,
          "text": "Why thy canoniz'd bones, hearsed in death,",
          "plainText": "Why thy canoniz'd bones hearsed in death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0050",
          "number": 50,
          "speechLineNumber": 10,
          "text": "Have burst their cerements; why the sepulchre,",
          "plainText": "Have burst their cerements why the sepulchre",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0051",
          "number": 51,
          "speechLineNumber": 11,
          "text": "Wherein we saw thee quietly inurn'd,",
          "plainText": "Wherein we saw thee quietly inurn'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0052",
          "number": 52,
          "speechLineNumber": 12,
          "text": "Hath op'd his ponderous and marble jaws",
          "plainText": "Hath op'd his ponderous and marble jaws",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0053",
          "number": 53,
          "speechLineNumber": 13,
          "text": "To cast thee up again! What may this mean,",
          "plainText": "To cast thee up again What may this mean",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0054",
          "number": 54,
          "speechLineNumber": 14,
          "text": "That thou, dead corse, again in complete steel,",
          "plainText": "That thou dead corse again in complete steel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0055",
          "number": 55,
          "speechLineNumber": 15,
          "text": "Revisit'st thus the glimpses of the moon,",
          "plainText": "Revisit'st thus the glimpses of the moon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0056",
          "number": 56,
          "speechLineNumber": 16,
          "text": "Making night hideous, and we fools of nature",
          "plainText": "Making night hideous and we fools of nature",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0057",
          "number": 57,
          "speechLineNumber": 17,
          "text": "So horridly to shake our disposition",
          "plainText": "So horridly to shake our disposition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0058",
          "number": 58,
          "speechLineNumber": 18,
          "text": "With thoughts beyond the reaches of our souls?",
          "plainText": "With thoughts beyond the reaches of our souls",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0059",
          "number": 59,
          "speechLineNumber": 19,
          "text": "Say, why is this? Wherefore? What should we do?",
          "plainText": "Say why is this Wherefore What should we do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-stage-004",
      "type": "stage",
      "text": "[Ghost beckons Hamlet.]"
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "It beckons you to go away with it,",
          "plainText": "It beckons you to go away with it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "As if it some impartment did desire",
          "plainText": "As if it some impartment did desire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0062",
          "number": 62,
          "speechLineNumber": 3,
          "text": "To you alone.",
          "plainText": "To you alone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "marcellus",
        "name": "MARCELLUS",
        "displayName": "Marcellus"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Look with what courteous action",
          "plainText": "Look with what courteous action",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "It waves you to a more removed ground.",
          "plainText": "It waves you to a more removed ground",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "But do not go with it.",
          "plainText": "But do not go with it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "No, by no means.",
          "plainText": "No by no means",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "It will not speak; then will I follow it.",
          "plainText": "It will not speak then will I follow it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Do not, my lord.",
          "plainText": "Do not my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Why, what should be the fear?",
          "plainText": "Why what should be the fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "I do not set my life at a pin's fee;",
          "plainText": "I do not set my life at a pin's fee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0071",
          "number": 71,
          "speechLineNumber": 3,
          "text": "And for my soul, what can it do to that,",
          "plainText": "And for my soul what can it do to that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0072",
          "number": 72,
          "speechLineNumber": 4,
          "text": "Being a thing immortal as itself?",
          "plainText": "Being a thing immortal as itself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0073",
          "number": 73,
          "speechLineNumber": 5,
          "text": "It waves me forth again. I'll follow it.",
          "plainText": "It waves me forth again I'll follow it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "What if it tempt you toward the flood, my lord,",
          "plainText": "What if it tempt you toward the flood my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "Or to the dreadful summit of the cliff",
          "plainText": "Or to the dreadful summit of the cliff",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "That beetles o'er his base into the sea,",
          "plainText": "That beetles o'er his base into the sea",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0077",
          "number": 77,
          "speechLineNumber": 4,
          "text": "And there assume some other horrible form",
          "plainText": "And there assume some other horrible form",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0078",
          "number": 78,
          "speechLineNumber": 5,
          "text": "Which might deprive your sovereignty of reason,",
          "plainText": "Which might deprive your sovereignty of reason",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0079",
          "number": 79,
          "speechLineNumber": 6,
          "text": "And draw you into madness? Think of it.",
          "plainText": "And draw you into madness Think of it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0080",
          "number": 80,
          "speechLineNumber": 7,
          "text": "The very place puts toys of desperation,",
          "plainText": "The very place puts toys of desperation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0081",
          "number": 81,
          "speechLineNumber": 8,
          "text": "Without more motive, into every brain",
          "plainText": "Without more motive into every brain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0082",
          "number": 82,
          "speechLineNumber": 9,
          "text": "That looks so many fathoms to the sea",
          "plainText": "That looks so many fathoms to the sea",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0083",
          "number": 83,
          "speechLineNumber": 10,
          "text": "And hears it roar beneath.",
          "plainText": "And hears it roar beneath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "It waves me still.",
          "plainText": "It waves me still",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0085",
          "number": 85,
          "speechLineNumber": 2,
          "text": "Go on, I'll follow thee.",
          "plainText": "Go on I'll follow thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "marcellus",
        "name": "MARCELLUS",
        "displayName": "Marcellus"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "You shall not go, my lord.",
          "plainText": "You shall not go my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0087",
          "number": 87,
          "speechLineNumber": 1,
          "text": "Hold off your hands.",
          "plainText": "Hold off your hands",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0088",
          "number": 88,
          "speechLineNumber": 1,
          "text": "Be rul'd; you shall not go.",
          "plainText": "Be rul'd you shall not go",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "My fate cries out,",
          "plainText": "My fate cries out",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0090",
          "number": 90,
          "speechLineNumber": 2,
          "text": "And makes each petty artery in this body",
          "plainText": "And makes each petty artery in this body",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0091",
          "number": 91,
          "speechLineNumber": 3,
          "text": "As hardy as the Nemean lion's nerve.",
          "plainText": "As hardy as the Nemean lion's nerve",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-stage-005",
      "type": "stage",
      "text": "[Ghost beckons.]"
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-stage-006",
      "type": "stage",
      "text": "[Breaking free from them.]"
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-stage-007",
      "type": "stage",
      "text": "[Exeunt Ghost and Hamlet.]"
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "He waxes desperate with imagination.",
          "plainText": "He waxes desperate with imagination",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-025",
      "type": "speech",
      "speaker": {
        "id": "marcellus",
        "name": "MARCELLUS",
        "displayName": "Marcellus"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "Let's follow; 'tis not fit thus to obey him.",
          "plainText": "Let's follow 'tis not fit thus to obey him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-026",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0094",
          "number": 94,
          "speechLineNumber": 1,
          "text": "Have after. To what issue will this come?",
          "plainText": "Have after To what issue will this come",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-027",
      "type": "speech",
      "speaker": {
        "id": "marcellus",
        "name": "MARCELLUS",
        "displayName": "Marcellus"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0095",
          "number": 95,
          "speechLineNumber": 1,
          "text": "Something is rotten in the state of Denmark.",
          "plainText": "Something is rotten in the state of Denmark",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-1-4-speech-028",
      "type": "speech",
      "speaker": {
        "id": "horatio",
        "name": "HORATIO",
        "displayName": "Horatio"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-1-4-line-0096",
          "number": 96,
          "speechLineNumber": 1,
