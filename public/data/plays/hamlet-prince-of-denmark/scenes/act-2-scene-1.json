  "scene": {
    "id": "hamlet-prince-of-denmark-2-1",
    "act": 2,
    "scene": 1,
    "label": "Act 2, Scene 1",
    "title": "SCENE I. A room in Polonius's house.",
    "location": "A room in Polonius's house.",
    "orderInPlay": 6
  },
  "content": [
    {
      "id": "hamlet-prince-of-denmark-2-1-stage-001",
      "type": "stage",
      "text": "Enter Polonius and Reynaldo."
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Give him this money and these notes, Reynaldo.",
          "plainText": "Give him this money and these notes Reynaldo",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "I will, my lord.",
          "plainText": "I will my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "You shall do marvellous wisely, good Reynaldo,",
          "plainText": "You shall do marvellous wisely good Reynaldo",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Before you visit him, to make inquiry",
          "plainText": "Before you visit him to make inquiry",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Of his behaviour.",
          "plainText": "Of his behaviour",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "My lord, I did intend it.",
          "plainText": "My lord I did intend it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Marry, well said; very well said. Look you, sir,",
          "plainText": "Marry well said very well said Look you sir",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Enquire me first what Danskers are in Paris;",
          "plainText": "Enquire me first what Danskers are in Paris",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "And how, and who, what means, and where they keep,",
          "plainText": "And how and who what means and where they keep",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "What company, at what expense; and finding",
          "plainText": "What company at what expense and finding",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "By this encompassment and drift of question,",
          "plainText": "By this encompassment and drift of question",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "That they do know my son, come you more nearer",
          "plainText": "That they do know my son come you more nearer",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0013",
          "number": 13,
          "speechLineNumber": 7,
          "text": "Than your particular demands will touch it.",
          "plainText": "Than your particular demands will touch it",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0014",
          "number": 14,
          "speechLineNumber": 8,
          "text": "Take you as 'twere some distant knowledge of him,",
          "plainText": "Take you as 'twere some distant knowledge of him",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0015",
          "number": 15,
          "speechLineNumber": 9,
          "text": "As thus, 'I know his father and his friends,",
          "plainText": "As thus 'I know his father and his friends",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0016",
          "number": 16,
          "speechLineNumber": 10,
          "text": "And in part him'—do you mark this, Reynaldo?",
          "plainText": "And in part him'do you mark this Reynaldo",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Ay, very well, my lord.",
          "plainText": "Ay very well my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "'And in part him, but,' you may say, 'not well;",
          "plainText": "'And in part him but' you may say 'not well",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "But if't be he I mean, he's very wild;",
          "plainText": "But if't be he I mean he's very wild",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "Addicted so and so;' and there put on him",
          "plainText": "Addicted so and so' and there put on him",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "What forgeries you please; marry, none so rank",
          "plainText": "What forgeries you please marry none so rank",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0022",
          "number": 22,
          "speechLineNumber": 5,
          "text": "As may dishonour him; take heed of that;",
          "plainText": "As may dishonour him take heed of that",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0023",
          "number": 23,
          "speechLineNumber": 6,
          "text": "But, sir, such wanton, wild, and usual slips",
          "plainText": "But sir such wanton wild and usual slips",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0024",
          "number": 24,
          "speechLineNumber": 7,
          "text": "As are companions noted and most known",
          "plainText": "As are companions noted and most known",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0025",
          "number": 25,
          "speechLineNumber": 8,
          "text": "To youth and liberty.",
          "plainText": "To youth and liberty",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "As gaming, my lord?",
          "plainText": "As gaming my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Ay, or drinking, fencing, swearing,",
          "plainText": "Ay or drinking fencing swearing",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Quarrelling, drabbing. You may go so far.",
          "plainText": "Quarrelling drabbing You may go so far",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "My lord, that would dishonour him.",
          "plainText": "My lord that would dishonour him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Faith no, as you may season it in the charge.",
          "plainText": "Faith no as you may season it in the charge",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "You must not put another scandal on him,",
          "plainText": "You must not put another scandal on him",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "That he is open to incontinency;",
          "plainText": "That he is open to incontinency",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0033",
          "number": 33,
          "speechLineNumber": 4,
          "text": "That's not my meaning: but breathe his faults so quaintly",
          "plainText": "That's not my meaning but breathe his faults so quaintly",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0034",
          "number": 34,
          "speechLineNumber": 5,
          "text": "That they may seem the taints of liberty;",
          "plainText": "That they may seem the taints of liberty",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0035",
          "number": 35,
          "speechLineNumber": 6,
          "text": "The flash and outbreak of a fiery mind,",
          "plainText": "The flash and outbreak of a fiery mind",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0036",
          "number": 36,
          "speechLineNumber": 7,
          "text": "A savageness in unreclaimed blood,",
          "plainText": "A savageness in unreclaimed blood",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0037",
          "number": 37,
          "speechLineNumber": 8,
          "text": "Of general assault.",
          "plainText": "Of general assault",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "But my good lord—",
          "plainText": "But my good lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Wherefore should you do this?",
          "plainText": "Wherefore should you do this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Ay, my lord, I would know that.",
          "plainText": "Ay my lord I would know that",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Marry, sir, here's my drift,",
          "plainText": "Marry sir here's my drift",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "And I believe it is a fetch of warrant.",
          "plainText": "And I believe it is a fetch of warrant",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "You laying these slight sullies on my son,",
          "plainText": "You laying these slight sullies on my son",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "As 'twere a thing a little soil'd i' th' working,",
          "plainText": "As 'twere a thing a little soil'd i' th' working",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "Mark you,",
          "plainText": "Mark you",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "Your party in converse, him you would sound,",
          "plainText": "Your party in converse him you would sound",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0047",
          "number": 47,
          "speechLineNumber": 7,
          "text": "Having ever seen in the prenominate crimes",
          "plainText": "Having ever seen in the prenominate crimes",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0048",
          "number": 48,
          "speechLineNumber": 8,
          "text": "The youth you breathe of guilty, be assur'd",
          "plainText": "The youth you breathe of guilty be assur'd",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0049",
          "number": 49,
          "speechLineNumber": 9,
          "text": "He closes with you in this consequence;",
          "plainText": "He closes with you in this consequence",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0050",
          "number": 50,
          "speechLineNumber": 10,
          "text": "'Good sir,' or so; or 'friend,' or 'gentleman'—",
          "plainText": "'Good sir' or so or 'friend' or 'gentleman'",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0051",
          "number": 51,
          "speechLineNumber": 11,
          "text": "According to the phrase or the addition",
          "plainText": "According to the phrase or the addition",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0052",
          "number": 52,
          "speechLineNumber": 12,
          "text": "Of man and country.",
          "plainText": "Of man and country",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Very good, my lord.",
          "plainText": "Very good my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "And then, sir, does he this,—",
          "plainText": "And then sir does he this",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "He does—What was I about to say?",
          "plainText": "He doesWhat was I about to say",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0056",
          "number": 56,
          "speechLineNumber": 3,
          "text": "By the mass, I was about to say something. Where did I leave?",
          "plainText": "By the mass I was about to say something Where did I leave",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "At 'closes in the consequence.'",
          "plainText": "At 'closes in the consequence'",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "At 'friend or so,' and 'gentleman.'",
          "plainText": "At 'friend or so' and 'gentleman'",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "At 'closes in the consequence' ay, marry!",
          "plainText": "At 'closes in the consequence' ay marry",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "He closes with you thus: 'I know the gentleman,",
          "plainText": "He closes with you thus 'I know the gentleman",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "I saw him yesterday, or t'other day,",
          "plainText": "I saw him yesterday or t'other day",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0062",
          "number": 62,
          "speechLineNumber": 4,
          "text": "Or then, or then, with such and such; and, as you say,",
          "plainText": "Or then or then with such and such and as you say",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0063",
          "number": 63,
          "speechLineNumber": 5,
          "text": "There was he gaming, there o'ertook in's rouse,",
          "plainText": "There was he gaming there o'ertook in's rouse",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0064",
          "number": 64,
          "speechLineNumber": 6,
          "text": "There falling out at tennis': or perchance,",
          "plainText": "There falling out at tennis' or perchance",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0065",
          "number": 65,
          "speechLineNumber": 7,
          "text": "'I saw him enter such a house of sale'—",
          "plainText": "'I saw him enter such a house of sale'",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0066",
          "number": 66,
          "speechLineNumber": 8,
          "text": "Videlicet, a brothel, or so forth. See you now;",
          "plainText": "Videlicet a brothel or so forth See you now",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0067",
          "number": 67,
          "speechLineNumber": 9,
          "text": "Your bait of falsehood takes this carp of truth;",
          "plainText": "Your bait of falsehood takes this carp of truth",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0068",
          "number": 68,
          "speechLineNumber": 10,
          "text": "And thus do we of wisdom and of reach,",
          "plainText": "And thus do we of wisdom and of reach",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0069",
          "number": 69,
          "speechLineNumber": 11,
          "text": "With windlasses, and with assays of bias,",
          "plainText": "With windlasses and with assays of bias",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0070",
          "number": 70,
          "speechLineNumber": 12,
          "text": "By indirections find directions out.",
          "plainText": "By indirections find directions out",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0071",
          "number": 71,
          "speechLineNumber": 13,
          "text": "So by my former lecture and advice",
          "plainText": "So by my former lecture and advice",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0072",
          "number": 72,
          "speechLineNumber": 14,
          "text": "Shall you my son. You have me, have you not?",
          "plainText": "Shall you my son You have me have you not",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "My lord, I have.",
          "plainText": "My lord I have",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "God b' wi' you, fare you well.",
          "plainText": "God b' wi' you fare you well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Good my lord.",
          "plainText": "Good my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Observe his inclination in yourself.",
          "plainText": "Observe his inclination in yourself",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "I shall, my lord.",
          "plainText": "I shall my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "And let him ply his music.",
          "plainText": "And let him ply his music",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "reynaldo",
        "name": "REYNALDO",
        "displayName": "Reynaldo"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Well, my lord.",
          "plainText": "Well my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "Farewell.",
          "plainText": "Farewell",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-stage-002",
      "type": "stage",
      "text": "[Exit Reynaldo.]"
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-stage-003",
      "type": "stage",
      "text": "Enter Ophelia."
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "ophelia",
        "name": "OPHELIA",
        "displayName": "Ophelia"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "Alas, my lord, I have been so affrighted.",
          "plainText": "Alas my lord I have been so affrighted",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "With what, in the name of God?",
          "plainText": "With what in the name of God",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "ophelia",
        "name": "OPHELIA",
        "displayName": "Ophelia"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "My lord, as I was sewing in my chamber,",
          "plainText": "My lord as I was sewing in my chamber",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0084",
          "number": 84,
          "speechLineNumber": 2,
          "text": "Lord Hamlet, with his doublet all unbrac'd,",
          "plainText": "Lord Hamlet with his doublet all unbrac'd",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0085",
          "number": 85,
          "speechLineNumber": 3,
          "text": "No hat upon his head, his stockings foul'd,",
          "plainText": "No hat upon his head his stockings foul'd",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0086",
          "number": 86,
          "speechLineNumber": 4,
          "text": "Ungart'red, and down-gyved to his ankle,",
          "plainText": "Ungart'red and downgyved to his ankle",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0087",
          "number": 87,
          "speechLineNumber": 5,
          "text": "Pale as his shirt, his knees knocking each other,",
          "plainText": "Pale as his shirt his knees knocking each other",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0088",
          "number": 88,
          "speechLineNumber": 6,
          "text": "And with a look so piteous in purport",
          "plainText": "And with a look so piteous in purport",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0089",
          "number": 89,
          "speechLineNumber": 7,
          "text": "As if he had been loosed out of hell",
          "plainText": "As if he had been loosed out of hell",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0090",
          "number": 90,
          "speechLineNumber": 8,
          "text": "To speak of horrors, he comes before me.",
          "plainText": "To speak of horrors he comes before me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-031",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0091",
          "number": 91,
          "speechLineNumber": 1,
          "text": "Mad for thy love?",
          "plainText": "Mad for thy love",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-032",
      "type": "speech",
      "speaker": {
        "id": "ophelia",
        "name": "OPHELIA",
        "displayName": "Ophelia"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "My lord, I do not know, but truly I do fear it.",
          "plainText": "My lord I do not know but truly I do fear it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-033",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "What said he?",
          "plainText": "What said he",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-034",
      "type": "speech",
      "speaker": {
        "id": "ophelia",
        "name": "OPHELIA",
        "displayName": "Ophelia"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0094",
          "number": 94,
          "speechLineNumber": 1,
          "text": "He took me by the wrist and held me hard;",
          "plainText": "He took me by the wrist and held me hard",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0095",
          "number": 95,
          "speechLineNumber": 2,
          "text": "Then goes he to the length of all his arm;",
          "plainText": "Then goes he to the length of all his arm",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0096",
          "number": 96,
          "speechLineNumber": 3,
          "text": "And with his other hand thus o'er his brow,",
          "plainText": "And with his other hand thus o'er his brow",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0097",
          "number": 97,
          "speechLineNumber": 4,
          "text": "He falls to such perusal of my face",
          "plainText": "He falls to such perusal of my face",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0098",
          "number": 98,
          "speechLineNumber": 5,
          "text": "As he would draw it. Long stay'd he so,",
          "plainText": "As he would draw it Long stay'd he so",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0099",
          "number": 99,
          "speechLineNumber": 6,
          "text": "At last,—a little shaking of mine arm,",
          "plainText": "At lasta little shaking of mine arm",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0100",
          "number": 100,
          "speechLineNumber": 7,
          "text": "And thrice his head thus waving up and down,",
          "plainText": "And thrice his head thus waving up and down",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0101",
          "number": 101,
          "speechLineNumber": 8,
          "text": "He rais'd a sigh so piteous and profound",
          "plainText": "He rais'd a sigh so piteous and profound",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0102",
          "number": 102,
          "speechLineNumber": 9,
          "text": "As it did seem to shatter all his bulk",
          "plainText": "As it did seem to shatter all his bulk",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0103",
          "number": 103,
          "speechLineNumber": 10,
          "text": "And end his being. That done, he lets me go,",
          "plainText": "And end his being That done he lets me go",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0104",
          "number": 104,
          "speechLineNumber": 11,
          "text": "And with his head over his shoulder turn'd",
          "plainText": "And with his head over his shoulder turn'd",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0105",
          "number": 105,
          "speechLineNumber": 12,
          "text": "He seem'd to find his way without his eyes,",
          "plainText": "He seem'd to find his way without his eyes",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0106",
          "number": 106,
          "speechLineNumber": 13,
          "text": "For out o' doors he went without their help,",
          "plainText": "For out o' doors he went without their help",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0107",
          "number": 107,
          "speechLineNumber": 14,
          "text": "And to the last bended their light on me.",
          "plainText": "And to the last bended their light on me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-035",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0108",
          "number": 108,
          "speechLineNumber": 1,
          "text": "Come, go with me. I will go seek the King.",
          "plainText": "Come go with me I will go seek the King",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0109",
          "number": 109,
          "speechLineNumber": 2,
          "text": "This is the very ecstasy of love,",
          "plainText": "This is the very ecstasy of love",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0110",
          "number": 110,
          "speechLineNumber": 3,
          "text": "Whose violent property fordoes itself,",
          "plainText": "Whose violent property fordoes itself",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0111",
          "number": 111,
          "speechLineNumber": 4,
          "text": "And leads the will to desperate undertakings,",
          "plainText": "And leads the will to desperate undertakings",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0112",
          "number": 112,
          "speechLineNumber": 5,
          "text": "As oft as any passion under heaven",
          "plainText": "As oft as any passion under heaven",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0113",
          "number": 113,
          "speechLineNumber": 6,
          "text": "That does afflict our natures. I am sorry,—",
          "plainText": "That does afflict our natures I am sorry",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0114",
          "number": 114,
          "speechLineNumber": 7,
          "text": "What, have you given him any hard words of late?",
          "plainText": "What have you given him any hard words of late",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-036",
      "type": "speech",
      "speaker": {
        "id": "ophelia",
        "name": "OPHELIA",
        "displayName": "Ophelia"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0115",
          "number": 115,
          "speechLineNumber": 1,
          "text": "No, my good lord; but as you did command,",
          "plainText": "No my good lord but as you did command",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0116",
          "number": 116,
          "speechLineNumber": 2,
          "text": "I did repel his letters and denied",
          "plainText": "I did repel his letters and denied",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0117",
          "number": 117,
          "speechLineNumber": 3,
          "text": "His access to me.",
          "plainText": "His access to me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-2-1-speech-037",
      "type": "speech",
      "speaker": {
        "id": "polonius",
        "name": "POLONIUS",
        "displayName": "Polonius"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0118",
          "number": 118,
          "speechLineNumber": 1,
          "text": "That hath made him mad.",
          "plainText": "That hath made him mad",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0119",
          "number": 119,
          "speechLineNumber": 2,
          "text": "I am sorry that with better heed and judgement",
          "plainText": "I am sorry that with better heed and judgement",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0120",
          "number": 120,
          "speechLineNumber": 3,
          "text": "I had not quoted him. I fear'd he did but trifle,",
          "plainText": "I had not quoted him I fear'd he did but trifle",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0121",
          "number": 121,
          "speechLineNumber": 4,
          "text": "And meant to wreck thee. But beshrew my jealousy!",
          "plainText": "And meant to wreck thee But beshrew my jealousy",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0122",
          "number": 122,
          "speechLineNumber": 5,
          "text": "It seems it is as proper to our age",
          "plainText": "It seems it is as proper to our age",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0123",
          "number": 123,
          "speechLineNumber": 6,
          "text": "To cast beyond ourselves in our opinions",
          "plainText": "To cast beyond ourselves in our opinions",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-2-1-line-0124",
          "number": 124,
          "speechLineNumber": 7,
          "text": "As it is common for the younger sort",
          "plainText": "As it is common for the younger sort",
