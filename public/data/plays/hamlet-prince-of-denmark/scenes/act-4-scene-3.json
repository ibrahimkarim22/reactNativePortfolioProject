{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "hamlet-prince-of-denmark",
    "title": "The Tragedy of Hamlet, Prince of Denmark",
    "author": "William Shakespeare",
    "genre": "Tragedy"
  },
  "source": {
    "name": "Project Gutenberg",
