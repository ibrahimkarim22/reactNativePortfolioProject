  "scene": {
    "id": "hamlet-prince-of-denmark-4-3",
    "act": 4,
    "scene": 3,
    "label": "Act 4, Scene 3",
    "title": "SCENE III. Another room in the Castle.",
    "location": "Another room in the Castle.",
    "orderInPlay": 14
  },
  "content": [
    {
      "id": "hamlet-prince-of-denmark-4-3-stage-001",
      "type": "stage",
      "text": "Enter King, attended."
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I have sent to seek him and to find the body.",
          "plainText": "I have sent to seek him and to find the body",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "How dangerous is it that this man goes loose!",
          "plainText": "How dangerous is it that this man goes loose",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Yet must not we put the strong law on him:",
          "plainText": "Yet must not we put the strong law on him",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "He's lov'd of the distracted multitude,",
          "plainText": "He's lov'd of the distracted multitude",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Who like not in their judgement, but their eyes;",
          "plainText": "Who like not in their judgement but their eyes",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "And where 'tis so, th'offender's scourge is weigh'd,",
          "plainText": "And where 'tis so th'offender's scourge is weigh'd",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "But never the offence. To bear all smooth and even,",
          "plainText": "But never the offence To bear all smooth and even",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "This sudden sending him away must seem",
          "plainText": "This sudden sending him away must seem",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Deliberate pause. Diseases desperate grown",
          "plainText": "Deliberate pause Diseases desperate grown",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "By desperate appliance are reliev'd,",
          "plainText": "By desperate appliance are reliev'd",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Or not at all.",
          "plainText": "Or not at all",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-stage-002",
      "type": "stage",
      "text": "Enter Rosencrantz."
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "rosencrantz",
        "name": "ROSENCRANTZ",
        "displayName": "Rosencrantz"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Where the dead body is bestow'd, my lord,",
          "plainText": "Where the dead body is bestow'd my lord",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "We cannot get from him.",
          "plainText": "We cannot get from him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "But where is he?",
          "plainText": "But where is he",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "rosencrantz",
        "name": "ROSENCRANTZ",
        "displayName": "Rosencrantz"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Without, my lord, guarded, to know your pleasure.",
          "plainText": "Without my lord guarded to know your pleasure",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Bring him before us.",
          "plainText": "Bring him before us",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "rosencrantz",
        "name": "ROSENCRANTZ",
        "displayName": "Rosencrantz"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Ho, Guildenstern! Bring in my lord.",
          "plainText": "Ho Guildenstern Bring in my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-stage-003",
      "type": "stage",
      "text": "Enter Hamlet and Guildenstern."
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Now, Hamlet, where's Polonius?",
          "plainText": "Now Hamlet where's Polonius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "At supper.",
          "plainText": "At supper",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "At supper? Where?",
          "plainText": "At supper Where",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Not where he eats, but where he is eaten. A certain convocation of politic worms are e'en at him. Your worm is your only emperor for diet. We fat all creatures else to fat us, and we fat ourselves for maggots. Your fat king and your lean beggar is but variable service,—two dishes, but to one table. That's the end.",
          "plainText": "Not where he eats but where he is eaten A certain convocation of politic worms are e'en at him Your worm is your only emperor for diet We fat all creatures else to fat us and we fat ourselves for maggots Your fat king and your lean beggar is but variable servicetwo dishes but to one table That's the end",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Alas, alas!",
          "plainText": "Alas alas",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "A man may fish with the worm that hath eat of a king, and eat of the fish that hath fed of that worm.",
          "plainText": "A man may fish with the worm that hath eat of a king and eat of the fish that hath fed of that worm",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "What dost thou mean by this?",
          "plainText": "What dost thou mean by this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Nothing but to show you how a king may go a progress through the guts of a beggar.",
          "plainText": "Nothing but to show you how a king may go a progress through the guts of a beggar",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Where is Polonius?",
          "plainText": "Where is Polonius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "In heaven. Send thither to see. If your messenger find him not there, seek him i' th'other place yourself. But indeed, if you find him not within this month, you shall nose him as you go up the stairs into the lobby.",
          "plainText": "In heaven Send thither to see If your messenger find him not there seek him i' th'other place yourself But indeed if you find him not within this month you shall nose him as you go up the stairs into the lobby",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "[To some Attendants.] Go seek him there.",
          "plainText": "To some Attendants Go seek him there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "He will stay till you come.",
          "plainText": "He will stay till you come",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-stage-004",
      "type": "stage",
      "text": "[Exeunt Attendants.]"
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Hamlet, this deed, for thine especial safety,—",
          "plainText": "Hamlet this deed for thine especial safety",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "Which we do tender, as we dearly grieve",
          "plainText": "Which we do tender as we dearly grieve",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "For that which thou hast done,—must send thee hence",
          "plainText": "For that which thou hast donemust send thee hence",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0033",
          "number": 33,
          "speechLineNumber": 4,
          "text": "With fiery quickness. Therefore prepare thyself;",
          "plainText": "With fiery quickness Therefore prepare thyself",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0034",
          "number": 34,
          "speechLineNumber": 5,
          "text": "The bark is ready, and the wind at help,",
          "plainText": "The bark is ready and the wind at help",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0035",
          "number": 35,
          "speechLineNumber": 6,
          "text": "Th'associates tend, and everything is bent",
          "plainText": "Th'associates tend and everything is bent",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0036",
          "number": 36,
          "speechLineNumber": 7,
          "text": "For England.",
          "plainText": "For England",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "For England?",
          "plainText": "For England",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Ay, Hamlet.",
          "plainText": "Ay Hamlet",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Good.",
          "plainText": "Good",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "So is it, if thou knew'st our purposes.",
          "plainText": "So is it if thou knew'st our purposes",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "I see a cherub that sees them. But, come; for England! Farewell, dear mother.",
          "plainText": "I see a cherub that sees them But come for England Farewell dear mother",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Thy loving father, Hamlet.",
          "plainText": "Thy loving father Hamlet",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "My mother. Father and mother is man and wife; man and wife is one flesh; and so, my mother. Come, for England.",
          "plainText": "My mother Father and mother is man and wife man and wife is one flesh and so my mother Come for England",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-stage-005",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Follow him at foot. Tempt him with speed aboard;",
          "plainText": "Follow him at foot Tempt him with speed aboard",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "Delay it not; I'll have him hence tonight.",
          "plainText": "Delay it not I'll have him hence tonight",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "Away, for everything is seal'd and done",
          "plainText": "Away for everything is seal'd and done",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-3-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "That else leans on th'affair. Pray you make haste.",
          "plainText": "That else leans on th'affair Pray you make haste",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-stage-006",
      "type": "stage",
      "text": "[Exeunt Rosencrantz and Guildenstern.]"
    },
    {
      "id": "hamlet-prince-of-denmark-4-3-stage-007",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}