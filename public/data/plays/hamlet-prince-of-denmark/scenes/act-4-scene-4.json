  },
  "scene": {
    "id": "hamlet-prince-of-denmark-4-4",
    "act": 4,
    "scene": 4,
    "label": "Act 4, Scene 4",
    "title": "SCENE IV. A plain in Denmark.",
    "location": "A plain in Denmark.",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "hamlet-prince-of-denmark-4-4-stage-001",
      "type": "stage",
      "text": "Enter Fortinbras and Forces marching."
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "fortinbras",
        "name": "FORTINBRAS",
        "displayName": "Fortinbras"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Go, Captain, from me greet the Danish king.",
          "plainText": "Go Captain from me greet the Danish king",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Tell him that by his license, Fortinbras",
          "plainText": "Tell him that by his license Fortinbras",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Craves the conveyance of a promis'd march",
          "plainText": "Craves the conveyance of a promis'd march",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Over his kingdom. You know the rendezvous.",
          "plainText": "Over his kingdom You know the rendezvous",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "If that his Majesty would aught with us,",
          "plainText": "If that his Majesty would aught with us",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "We shall express our duty in his eye;",
          "plainText": "We shall express our duty in his eye",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "And let him know so.",
          "plainText": "And let him know so",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I will do't, my lord.",
          "plainText": "I will do't my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "fortinbras",
        "name": "FORTINBRAS",
        "displayName": "Fortinbras"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Go softly on.",
          "plainText": "Go softly on",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-stage-002",
      "type": "stage",
      "text": "[Exeunt all but the Captain.]"
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-stage-003",
      "type": "stage",
      "text": "Enter Hamlet, Rosencrantz, Guildenstern &c."
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Good sir, whose powers are these?",
          "plainText": "Good sir whose powers are these",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "They are of Norway, sir.",
          "plainText": "They are of Norway sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "How purpos'd, sir, I pray you?",
          "plainText": "How purpos'd sir I pray you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Against some part of Poland.",
          "plainText": "Against some part of Poland",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Who commands them, sir?",
          "plainText": "Who commands them sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "The nephew to old Norway, Fortinbras.",
          "plainText": "The nephew to old Norway Fortinbras",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Goes it against the main of Poland, sir,",
          "plainText": "Goes it against the main of Poland sir",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Or for some frontier?",
          "plainText": "Or for some frontier",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Truly to speak, and with no addition,",
          "plainText": "Truly to speak and with no addition",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "We go to gain a little patch of ground",
          "plainText": "We go to gain a little patch of ground",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "That hath in it no profit but the name.",
          "plainText": "That hath in it no profit but the name",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "To pay five ducats, five, I would not farm it;",
          "plainText": "To pay five ducats five I would not farm it",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0022",
          "number": 22,
          "speechLineNumber": 5,
          "text": "Nor will it yield to Norway or the Pole",
          "plainText": "Nor will it yield to Norway or the Pole",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0023",
          "number": 23,
          "speechLineNumber": 6,
          "text": "A ranker rate, should it be sold in fee.",
          "plainText": "A ranker rate should it be sold in fee",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Why, then the Polack never will defend it.",
          "plainText": "Why then the Polack never will defend it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Yes, it is already garrison'd.",
          "plainText": "Yes it is already garrison'd",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Two thousand souls and twenty thousand ducats",
          "plainText": "Two thousand souls and twenty thousand ducats",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "Will not debate the question of this straw!",
          "plainText": "Will not debate the question of this straw",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "This is th'imposthume of much wealth and peace,",
          "plainText": "This is th'imposthume of much wealth and peace",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "That inward breaks, and shows no cause without",
          "plainText": "That inward breaks and shows no cause without",
          "lineType": "verse"
        },
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0030",
          "number": 30,
          "speechLineNumber": 5,
          "text": "Why the man dies. I humbly thank you, sir.",
          "plainText": "Why the man dies I humbly thank you sir",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "God b' wi' you, sir.",
          "plainText": "God b' wi' you sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "rosencrantz",
        "name": "ROSENCRANTZ",
        "displayName": "Rosencrantz"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Will't please you go, my lord?",
          "plainText": "Will't please you go my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "hamlet",
        "name": "HAMLET",
        "displayName": "Hamlet"
      },
      "lines": [
        {
          "id": "hamlet-prince-of-denmark-4-4-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "I'll be with you straight. Go a little before.",
          "plainText": "I'll be with you straight Go a little before",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-stage-005",
      "type": "stage",
      "text": "[Exeunt all but Hamlet.]"
    },
    {
      "id": "hamlet-prince-of-denmark-4-4-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}