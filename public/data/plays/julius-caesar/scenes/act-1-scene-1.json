    "title": "SCENE I. Rome. A street.",
    "location": "Rome. A street.",
    "orderInPlay": 1
  },
  "content": [
    {
      "id": "julius-caesar-1-1-stage-001",
      "type": "stage",
      "text": "Enter Flavius, Marullus and a throng of Citizens."
    },
    {
      "id": "julius-caesar-1-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "flavius",
        "name": "FLAVIUS",
        "displayName": "Flavius"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Hence! home, you idle creatures, get you home.",
          "plainText": "Hence home you idle creatures get you home",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Is this a holiday? What, know you not,",
          "plainText": "Is this a holiday What know you not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Being mechanical, you ought not walk",
          "plainText": "Being mechanical you ought not walk",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Upon a labouring day without the sign",
          "plainText": "Upon a labouring day without the sign",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Of your profession? Speak, what trade art thou?",
          "plainText": "Of your profession Speak what trade art thou",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "carpenter",
        "name": "CARPENTER",
        "displayName": "Carpenter"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Why, sir, a carpenter.",
          "plainText": "Why sir a carpenter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "marullus",
        "name": "MARULLUS",
        "displayName": "Marullus"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Where is thy leather apron and thy rule?",
          "plainText": "Where is thy leather apron and thy rule",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "What dost thou with thy best apparel on?",
          "plainText": "What dost thou with thy best apparel on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "You, sir, what trade are you?",
          "plainText": "You sir what trade are you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cobbler",
        "name": "COBBLER",
        "displayName": "Cobbler"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Truly, sir, in respect of a fine workman, I am but, as you would say, a cobbler.",
          "plainText": "Truly sir in respect of a fine workman I am but as you would say a cobbler",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "marullus",
        "name": "MARULLUS",
        "displayName": "Marullus"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "But what trade art thou? Answer me directly.",
          "plainText": "But what trade art thou Answer me directly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cobbler",
        "name": "COBBLER",
        "displayName": "Cobbler"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "A trade, sir, that I hope I may use with a safe conscience, which is indeed, sir, a mender of bad soles.",
          "plainText": "A trade sir that I hope I may use with a safe conscience which is indeed sir a mender of bad soles",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "marullus",
        "name": "MARULLUS",
        "displayName": "Marullus"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "What trade, thou knave? Thou naughty knave, what trade?",
          "plainText": "What trade thou knave Thou naughty knave what trade",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cobbler",
        "name": "COBBLER",
        "displayName": "Cobbler"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Nay, I beseech you, sir, be not out with me; yet, if you be out, sir, I can mend you.",
          "plainText": "Nay I beseech you sir be not out with me yet if you be out sir I can mend you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "marullus",
        "name": "MARULLUS",
        "displayName": "Marullus"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "What mean'st thou by that? Mend me, thou saucy fellow!",
          "plainText": "What mean'st thou by that Mend me thou saucy fellow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "cobbler",
        "name": "COBBLER",
        "displayName": "Cobbler"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Why, sir, cobble you.",
          "plainText": "Why sir cobble you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "flavius",
        "name": "FLAVIUS",
        "displayName": "Flavius"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Thou art a cobbler, art thou?",
          "plainText": "Thou art a cobbler art thou",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "cobbler",
        "name": "COBBLER",
        "displayName": "Cobbler"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Truly, sir, all that I live by is with the awl; I meddle with no tradesman's matters, nor women's matters, but withal I am indeed, sir, a surgeon to old shoes: when they are in great danger, I recover them. As proper men as ever trod upon neat's leather have gone upon my handiwork.",
          "plainText": "Truly sir all that I live by is with the awl I meddle with no tradesman's matters nor women's matters but withal I am indeed sir a surgeon to old shoes when they are in great danger I recover them As proper men as ever trod upon neat's leather have gone upon my handiwork",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "flavius",
        "name": "FLAVIUS",
        "displayName": "Flavius"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "But wherefore art not in thy shop today?",
          "plainText": "But wherefore art not in thy shop today",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Why dost thou lead these men about the streets?",
          "plainText": "Why dost thou lead these men about the streets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "cobbler",
        "name": "COBBLER",
        "displayName": "Cobbler"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Truly, sir, to wear out their shoes, to get myself into more work. But indeed, sir, we make holiday to see Caesar, and to rejoice in his triumph.",
          "plainText": "Truly sir to wear out their shoes to get myself into more work But indeed sir we make holiday to see Caesar and to rejoice in his triumph",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "marullus",
        "name": "MARULLUS",
        "displayName": "Marullus"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Wherefore rejoice? What conquest brings he home?",
          "plainText": "Wherefore rejoice What conquest brings he home",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "What tributaries follow him to Rome,",
          "plainText": "What tributaries follow him to Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "To grace in captive bonds his chariot wheels?",
          "plainText": "To grace in captive bonds his chariot wheels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "You blocks, you stones, you worse than senseless things!",
          "plainText": "You blocks you stones you worse than senseless things",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "O you hard hearts, you cruel men of Rome,",
          "plainText": "O you hard hearts you cruel men of Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0027",
          "number": 27,
          "speechLineNumber": 6,
          "text": "Knew you not Pompey? Many a time and oft",
          "plainText": "Knew you not Pompey Many a time and oft",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0028",
          "number": 28,
          "speechLineNumber": 7,
          "text": "Have you climb'd up to walls and battlements,",
          "plainText": "Have you climb'd up to walls and battlements",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0029",
          "number": 29,
          "speechLineNumber": 8,
          "text": "To towers and windows, yea, to chimney tops,",
          "plainText": "To towers and windows yea to chimney tops",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0030",
          "number": 30,
          "speechLineNumber": 9,
          "text": "Your infants in your arms, and there have sat",
          "plainText": "Your infants in your arms and there have sat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0031",
          "number": 31,
          "speechLineNumber": 10,
          "text": "The livelong day with patient expectation,",
          "plainText": "The livelong day with patient expectation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0032",
          "number": 32,
          "speechLineNumber": 11,
          "text": "To see great Pompey pass the streets of Rome.",
          "plainText": "To see great Pompey pass the streets of Rome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0033",
          "number": 33,
          "speechLineNumber": 12,
          "text": "And when you saw his chariot but appear,",
          "plainText": "And when you saw his chariot but appear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0034",
          "number": 34,
          "speechLineNumber": 13,
          "text": "Have you not made an universal shout,",
          "plainText": "Have you not made an universal shout",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0035",
          "number": 35,
          "speechLineNumber": 14,
          "text": "That Tiber trembled underneath her banks",
          "plainText": "That Tiber trembled underneath her banks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0036",
          "number": 36,
          "speechLineNumber": 15,
          "text": "To hear the replication of your sounds",
          "plainText": "To hear the replication of your sounds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0037",
          "number": 37,
          "speechLineNumber": 16,
          "text": "Made in her concave shores?",
          "plainText": "Made in her concave shores",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0038",
          "number": 38,
          "speechLineNumber": 17,
          "text": "And do you now put on your best attire?",
          "plainText": "And do you now put on your best attire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0039",
          "number": 39,
          "speechLineNumber": 18,
          "text": "And do you now cull out a holiday?",
          "plainText": "And do you now cull out a holiday",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0040",
          "number": 40,
          "speechLineNumber": 19,
          "text": "And do you now strew flowers in his way,",
          "plainText": "And do you now strew flowers in his way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0041",
          "number": 41,
          "speechLineNumber": 20,
          "text": "That comes in triumph over Pompey's blood?",
          "plainText": "That comes in triumph over Pompey's blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0042",
          "number": 42,
          "speechLineNumber": 21,
          "text": "Be gone!",
          "plainText": "Be gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0043",
          "number": 43,
          "speechLineNumber": 22,
          "text": "Run to your houses, fall upon your knees,",
          "plainText": "Run to your houses fall upon your knees",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0044",
          "number": 44,
          "speechLineNumber": 23,
          "text": "Pray to the gods to intermit the plague",
          "plainText": "Pray to the gods to intermit the plague",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0045",
          "number": 45,
          "speechLineNumber": 24,
          "text": "That needs must light on this ingratitude.",
          "plainText": "That needs must light on this ingratitude",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "flavius",
        "name": "FLAVIUS",
        "displayName": "Flavius"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Go, go, good countrymen, and, for this fault",
          "plainText": "Go go good countrymen and for this fault",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Assemble all the poor men of your sort,",
          "plainText": "Assemble all the poor men of your sort",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "Draw them to Tiber banks, and weep your tears",
          "plainText": "Draw them to Tiber banks and weep your tears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "Into the channel, till the lowest stream",
          "plainText": "Into the channel till the lowest stream",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0050",
          "number": 50,
          "speechLineNumber": 5,
          "text": "Do kiss the most exalted shores of all.",
          "plainText": "Do kiss the most exalted shores of all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-stage-002",
      "type": "stage",
      "text": "[Exeunt Citizens.]"
    },
    {
      "id": "julius-caesar-1-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "marullus",
        "name": "MARULLUS",
        "displayName": "Marullus"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "May we do so?",
          "plainText": "May we do so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "You know it is the feast of Lupercal.",
          "plainText": "You know it is the feast of Lupercal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-1-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "flavius",
        "name": "FLAVIUS",
        "displayName": "Flavius"
      },
      "lines": [
        {
          "id": "julius-caesar-1-1-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "It is no matter; let no images",
          "plainText": "It is no matter let no images",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "Be hung with Caesar's trophies. I'll about",
          "plainText": "Be hung with Caesar's trophies I'll about",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0055",
          "number": 55,
          "speechLineNumber": 3,
          "text": "And drive away the vulgar from the streets;",
          "plainText": "And drive away the vulgar from the streets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0056",
          "number": 56,
          "speechLineNumber": 4,
          "text": "So do you too, where you perceive them thick.",
          "plainText": "So do you too where you perceive them thick",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0057",
          "number": 57,
          "speechLineNumber": 5,
          "text": "These growing feathers pluck'd from Caesar's wing",
          "plainText": "These growing feathers pluck'd from Caesar's wing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0058",
          "number": 58,
          "speechLineNumber": 6,
          "text": "Will make him fly an ordinary pitch,",
          "plainText": "Will make him fly an ordinary pitch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0059",
          "number": 59,
          "speechLineNumber": 7,
          "text": "Who else would soar above the view of men,",
          "plainText": "Who else would soar above the view of men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-1-1-line-0060",
          "number": 60,
          "speechLineNumber": 8,
          "text": "And keep us all in servile fearfulness.",
          "plainText": "And keep us all in servile fearfulness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
