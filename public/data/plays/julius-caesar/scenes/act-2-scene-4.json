  "scene": {
    "id": "julius-caesar-2-4",
    "act": 2,
    "scene": 4,
    "label": "Act 2, Scene 4",
    "title": "SCENE IV. Another part of the same street, before the house of Brutus.",
    "location": "Another part of the same street, before the house of Brutus.",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "julius-caesar-2-4-stage-001",
      "type": "stage",
      "text": "Enter Portia and Lucius."
    },
    {
      "id": "julius-caesar-2-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I pr'ythee, boy, run to the Senate-house;",
          "plainText": "I pr'ythee boy run to the Senatehouse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Stay not to answer me, but get thee gone.",
          "plainText": "Stay not to answer me but get thee gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Why dost thou stay?",
          "plainText": "Why dost thou stay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "To know my errand, madam.",
          "plainText": "To know my errand madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "I would have had thee there and here again,",
          "plainText": "I would have had thee there and here again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Ere I can tell thee what thou shouldst do there.",
          "plainText": "Ere I can tell thee what thou shouldst do there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "[Aside.] O constancy, be strong upon my side,",
          "plainText": "Aside O constancy be strong upon my side",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "Set a huge mountain 'tween my heart and tongue!",
          "plainText": "Set a huge mountain 'tween my heart and tongue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0009",
          "number": 9,
          "speechLineNumber": 5,
          "text": "I have a man's mind, but a woman's might.",
          "plainText": "I have a man's mind but a woman's might",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0010",
          "number": 10,
          "speechLineNumber": 6,
          "text": "How hard it is for women to keep counsel!",
          "plainText": "How hard it is for women to keep counsel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0011",
          "number": 11,
          "speechLineNumber": 7,
          "text": "Art thou here yet?",
          "plainText": "Art thou here yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Madam, what should I do?",
          "plainText": "Madam what should I do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Run to the Capitol, and nothing else?",
          "plainText": "Run to the Capitol and nothing else",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "And so return to you, and nothing else?",
          "plainText": "And so return to you and nothing else",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Yes, bring me word, boy, if thy lord look well,",
          "plainText": "Yes bring me word boy if thy lord look well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "For he went sickly forth: and take good note",
          "plainText": "For he went sickly forth and take good note",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "What Caesar doth, what suitors press to him.",
          "plainText": "What Caesar doth what suitors press to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "Hark, boy, what noise is that?",
          "plainText": "Hark boy what noise is that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I hear none, madam.",
          "plainText": "I hear none madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Pr'ythee, listen well.",
          "plainText": "Pr'ythee listen well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "I heard a bustling rumour, like a fray,",
          "plainText": "I heard a bustling rumour like a fray",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "And the wind brings it from the Capitol.",
          "plainText": "And the wind brings it from the Capitol",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "lucius",
        "name": "LUCIUS",
        "displayName": "Lucius"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Sooth, madam, I hear nothing.",
          "plainText": "Sooth madam I hear nothing",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-stage-002",
      "type": "stage",
      "text": "Enter the Soothsayer."
    },
    {
      "id": "julius-caesar-2-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Come hither, fellow:",
          "plainText": "Come hither fellow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "Which way hast thou been?",
          "plainText": "Which way hast thou been",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "soothsayer",
        "name": "SOOTHSAYER",
        "displayName": "Soothsayer"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "At mine own house, good lady.",
          "plainText": "At mine own house good lady",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "What is't o'clock?",
          "plainText": "What is't o'clock",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "soothsayer",
        "name": "SOOTHSAYER",
        "displayName": "Soothsayer"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "About the ninth hour, lady.",
          "plainText": "About the ninth hour lady",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Is Caesar yet gone to the Capitol?",
          "plainText": "Is Caesar yet gone to the Capitol",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "soothsayer",
        "name": "SOOTHSAYER",
        "displayName": "Soothsayer"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Madam, not yet. I go to take my stand,",
          "plainText": "Madam not yet I go to take my stand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "To see him pass on to the Capitol.",
          "plainText": "To see him pass on to the Capitol",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Thou hast some suit to Caesar, hast thou not?",
          "plainText": "Thou hast some suit to Caesar hast thou not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "soothsayer",
        "name": "SOOTHSAYER",
        "displayName": "Soothsayer"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "That I have, lady, if it will please Caesar",
          "plainText": "That I have lady if it will please Caesar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "To be so good to Caesar as to hear me,",
          "plainText": "To be so good to Caesar as to hear me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "I shall beseech him to befriend himself.",
          "plainText": "I shall beseech him to befriend himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Why, know'st thou any harm's intended towards him?",
          "plainText": "Why know'st thou any harm's intended towards him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "soothsayer",
        "name": "SOOTHSAYER",
        "displayName": "Soothsayer"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "None that I know will be, much that I fear may chance.",
          "plainText": "None that I know will be much that I fear may chance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Good morrow to you. Here the street is narrow.",
          "plainText": "Good morrow to you Here the street is narrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "The throng that follows Caesar at the heels,",
          "plainText": "The throng that follows Caesar at the heels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "Of Senators, of Praetors, common suitors,",
          "plainText": "Of Senators of Praetors common suitors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0041",
          "number": 41,
          "speechLineNumber": 5,
          "text": "Will crowd a feeble man almost to death:",
          "plainText": "Will crowd a feeble man almost to death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0042",
          "number": 42,
          "speechLineNumber": 6,
          "text": "I'll get me to a place more void, and there",
          "plainText": "I'll get me to a place more void and there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0043",
          "number": 43,
          "speechLineNumber": 7,
          "text": "Speak to great Caesar as he comes along.",
          "plainText": "Speak to great Caesar as he comes along",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-2-4-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "julius-caesar-2-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "julius-caesar-2-4-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "I must go in.",
          "plainText": "I must go in",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "[Aside.] Ay me, how weak a thing",
          "plainText": "Aside Ay me how weak a thing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-2-4-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "The heart of woman is! O Brutus,",
