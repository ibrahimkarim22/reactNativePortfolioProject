  },
  "content": [
    {
      "id": "julius-caesar-3-3-stage-001",
      "type": "stage",
      "text": "Enter Cinna, the poet, and after him the citizens."
    },
    {
      "id": "julius-caesar-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cinna",
        "name": "CINNA",
        "displayName": "Cinna"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I dreamt tonight that I did feast with Caesar,",
          "plainText": "I dreamt tonight that I did feast with Caesar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And things unluckily charge my fantasy.",
          "plainText": "And things unluckily charge my fantasy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "I have no will to wander forth of doors,",
          "plainText": "I have no will to wander forth of doors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Yet something leads me forth.",
          "plainText": "Yet something leads me forth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "What is your name?",
          "plainText": "What is your name",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "second-citizen",
        "name": "SECOND CITIZEN",
        "displayName": "Second Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Whither are you going?",
          "plainText": "Whither are you going",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Where do you dwell?",
          "plainText": "Where do you dwell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "fourth-citizen",
        "name": "FOURTH CITIZEN",
        "displayName": "Fourth Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Are you a married man or a bachelor?",
          "plainText": "Are you a married man or a bachelor",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "second-citizen",
        "name": "SECOND CITIZEN",
        "displayName": "Second Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Answer every man directly.",
          "plainText": "Answer every man directly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Ay, and briefly.",
          "plainText": "Ay and briefly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "fourth-citizen",
        "name": "FOURTH CITIZEN",
        "displayName": "Fourth Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Ay, and wisely.",
          "plainText": "Ay and wisely",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Ay, and truly, you were best.",
          "plainText": "Ay and truly you were best",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "cinna",
        "name": "CINNA",
        "displayName": "Cinna"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "What is my name? Whither am I going? Where do I dwell? Am I a married man or a bachelor? Then, to answer every man directly and briefly, wisely and truly. Wisely I say I am a bachelor.",
          "plainText": "What is my name Whither am I going Where do I dwell Am I a married man or a bachelor Then to answer every man directly and briefly wisely and truly Wisely I say I am a bachelor",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "second-citizen",
        "name": "SECOND CITIZEN",
        "displayName": "Second Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "That's as much as to say they are fools that marry; you'll bear me a bang for that, I fear. Proceed, directly.",
          "plainText": "That's as much as to say they are fools that marry you'll bear me a bang for that I fear Proceed directly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "cinna",
        "name": "CINNA",
        "displayName": "Cinna"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Directly, I am going to Caesar's funeral.",
          "plainText": "Directly I am going to Caesar's funeral",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "As a friend, or an enemy?",
          "plainText": "As a friend or an enemy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "cinna",
        "name": "CINNA",
        "displayName": "Cinna"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "As a friend.",
          "plainText": "As a friend",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "second-citizen",
        "name": "SECOND CITIZEN",
        "displayName": "Second Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "That matter is answered directly.",
          "plainText": "That matter is answered directly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "fourth-citizen",
        "name": "FOURTH CITIZEN",
        "displayName": "Fourth Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "For your dwelling, briefly.",
          "plainText": "For your dwelling briefly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cinna",
        "name": "CINNA",
        "displayName": "Cinna"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Briefly, I dwell by the Capitol.",
          "plainText": "Briefly I dwell by the Capitol",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Your name, sir, truly.",
          "plainText": "Your name sir truly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cinna",
        "name": "CINNA",
        "displayName": "Cinna"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Truly, my name is Cinna.",
          "plainText": "Truly my name is Cinna",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Tear him to pieces! He's a conspirator.",
          "plainText": "Tear him to pieces He's a conspirator",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cinna",
        "name": "CINNA",
        "displayName": "Cinna"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "I am Cinna the poet, I am Cinna the poet.",
          "plainText": "I am Cinna the poet I am Cinna the poet",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "fourth-citizen",
        "name": "FOURTH CITIZEN",
        "displayName": "Fourth Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Tear him for his bad verses, tear him for his bad verses.",
          "plainText": "Tear him for his bad verses tear him for his bad verses",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "cinna",
        "name": "CINNA",
        "displayName": "Cinna"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "I am not Cinna the conspirator.",
          "plainText": "I am not Cinna the conspirator",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "fourth-citizen",
        "name": "FOURTH CITIZEN",
        "displayName": "Fourth Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "It is no matter, his name's Cinna; pluck but his name out of his heart, and turn him going.",
          "plainText": "It is no matter his name's Cinna pluck but his name out of his heart and turn him going",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "julius-caesar-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Tear him, tear him! Come; brands, ho! firebrands. To Brutus', to Cassius'; burn all. Some to Decius' house, and some to Casca's, some to Ligarius'. Away, go!",
          "plainText": "Tear him tear him Come brands ho firebrands To Brutus' to Cassius' burn all Some to Decius' house and some to Casca's some to Ligarius' Away go",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-3-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}