  "scene": {
    "id": "julius-caesar-4-1",
    "act": 4,
    "scene": 1,
    "label": "Act 4, Scene 1",
    "title": "SCENE I. Rome. A room in Antony's house.",
    "location": "Rome. A room in Antony's house.",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "julius-caesar-4-1-stage-001",
      "type": "stage",
      "text": "Enter Antony, Octavius and Lepidus, seated at a table."
    },
    {
      "id": "julius-caesar-4-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "These many then shall die; their names are prick'd.",
          "plainText": "These many then shall die their names are prick'd",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Your brother too must die; consent you, Lepidus?",
          "plainText": "Your brother too must die consent you Lepidus",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lepidus",
        "name": "LEPIDUS",
        "displayName": "Lepidus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "I do consent,—",
          "plainText": "I do consent",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Prick him down, Antony.",
          "plainText": "Prick him down Antony",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lepidus",
        "name": "LEPIDUS",
        "displayName": "Lepidus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Upon condition Publius shall not live,",
          "plainText": "Upon condition Publius shall not live",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Who is your sister's son, Mark Antony.",
          "plainText": "Who is your sister's son Mark Antony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "He shall not live; look, with a spot I damn him.",
          "plainText": "He shall not live look with a spot I damn him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "But, Lepidus, go you to Caesar's house;",
          "plainText": "But Lepidus go you to Caesar's house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Fetch the will hither, and we shall determine",
          "plainText": "Fetch the will hither and we shall determine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "How to cut off some charge in legacies.",
          "plainText": "How to cut off some charge in legacies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lepidus",
        "name": "LEPIDUS",
        "displayName": "Lepidus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "What, shall I find you here?",
          "plainText": "What shall I find you here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Or here, or at the Capitol.",
          "plainText": "Or here or at the Capitol",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-stage-002",
      "type": "stage",
      "text": "[Exit Lepidus.]"
    },
    {
      "id": "julius-caesar-4-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "This is a slight unmeritable man,",
          "plainText": "This is a slight unmeritable man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Meet to be sent on errands. Is it fit,",
          "plainText": "Meet to be sent on errands Is it fit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "The three-fold world divided, he should stand",
          "plainText": "The threefold world divided he should stand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "One of the three to share it?",
          "plainText": "One of the three to share it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "So you thought him,",
          "plainText": "So you thought him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "And took his voice who should be prick'd to die",
          "plainText": "And took his voice who should be prick'd to die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "In our black sentence and proscription.",
          "plainText": "In our black sentence and proscription",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Octavius, I have seen more days than you;",
          "plainText": "Octavius I have seen more days than you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "And though we lay these honours on this man,",
          "plainText": "And though we lay these honours on this man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "To ease ourselves of divers sland'rous loads,",
          "plainText": "To ease ourselves of divers sland'rous loads",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "He shall but bear them as the ass bears gold,",
          "plainText": "He shall but bear them as the ass bears gold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "To groan and sweat under the business,",
          "plainText": "To groan and sweat under the business",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0025",
          "number": 25,
          "speechLineNumber": 6,
          "text": "Either led or driven, as we point the way;",
          "plainText": "Either led or driven as we point the way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0026",
          "number": 26,
          "speechLineNumber": 7,
          "text": "And having brought our treasure where we will,",
          "plainText": "And having brought our treasure where we will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0027",
          "number": 27,
          "speechLineNumber": 8,
          "text": "Then take we down his load, and turn him off,",
          "plainText": "Then take we down his load and turn him off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0028",
          "number": 28,
          "speechLineNumber": 9,
          "text": "Like to the empty ass, to shake his ears,",
          "plainText": "Like to the empty ass to shake his ears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0029",
          "number": 29,
          "speechLineNumber": 10,
          "text": "And graze in commons.",
          "plainText": "And graze in commons",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "You may do your will;",
          "plainText": "You may do your will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "But he's a tried and valiant soldier.",
          "plainText": "But he's a tried and valiant soldier",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "julius-caesar-4-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-4-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "So is my horse, Octavius; and for that",
          "plainText": "So is my horse Octavius and for that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "I do appoint him store of provender.",
          "plainText": "I do appoint him store of provender",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "It is a creature that I teach to fight,",
          "plainText": "It is a creature that I teach to fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "To wind, to stop, to run directly on,",
          "plainText": "To wind to stop to run directly on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "His corporal motion govern'd by my spirit.",
          "plainText": "His corporal motion govern'd by my spirit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "And, in some taste, is Lepidus but so:",
          "plainText": "And in some taste is Lepidus but so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "He must be taught, and train'd, and bid go forth:",
          "plainText": "He must be taught and train'd and bid go forth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0039",
          "number": 39,
          "speechLineNumber": 8,
          "text": "A barren-spirited fellow; one that feeds",
          "plainText": "A barrenspirited fellow one that feeds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0040",
          "number": 40,
          "speechLineNumber": 9,
          "text": "On objects, arts, and imitations,",
          "plainText": "On objects arts and imitations",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0041",
          "number": 41,
          "speechLineNumber": 10,
          "text": "Which, out of use and stal'd by other men,",
          "plainText": "Which out of use and stal'd by other men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0042",
          "number": 42,
          "speechLineNumber": 11,
          "text": "Begin his fashion. Do not talk of him",
          "plainText": "Begin his fashion Do not talk of him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0043",
          "number": 43,
          "speechLineNumber": 12,
          "text": "But as a property. And now, Octavius,",
          "plainText": "But as a property And now Octavius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0044",
          "number": 44,
          "speechLineNumber": 13,
          "text": "Listen great things. Brutus and Cassius",
          "plainText": "Listen great things Brutus and Cassius",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0045",
          "number": 45,
          "speechLineNumber": 14,
          "text": "Are levying powers; we must straight make head.",
          "plainText": "Are levying powers we must straight make head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0046",
          "number": 46,
          "speechLineNumber": 15,
          "text": "Therefore let our alliance be combin'd,",
          "plainText": "Therefore let our alliance be combin'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0047",
          "number": 47,
          "speechLineNumber": 16,
          "text": "Our best friends made, our means stretch'd;",
          "plainText": "Our best friends made our means stretch'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0048",
          "number": 48,
          "speechLineNumber": 17,
          "text": "And let us presently go sit in council,",
          "plainText": "And let us presently go sit in council",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0049",
          "number": 49,
          "speechLineNumber": 18,
          "text": "How covert matters may be best disclos'd,",
          "plainText": "How covert matters may be best disclos'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "julius-caesar-4-1-line-0050",
          "number": 50,
          "speechLineNumber": 19,
          "text": "And open perils surest answered.",
          "plainText": "And open perils surest answered",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
