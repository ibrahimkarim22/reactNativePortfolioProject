  "scene": {
    "id": "julius-caesar-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. Before Brutus' tent, in the camp near Sardis.",
    "location": "Before Brutus' tent, in the camp near Sardis.",
    "orderInPlay": 12
  },
  "content": [
    {
      "id": "julius-caesar-4-2-stage-001",
      "type": "stage",
      "text": "Drum. Enter Brutus, Lucilius, Titinius and Soldiers; Pindarus meeting them; Lucius at some distance."
    },
    {
      "id": "julius-caesar-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Stand, ho!",
          "plainText": "Stand ho",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lucilius",
        "name": "LUCILIUS",
        "displayName": "Lucilius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Give the word, ho! and stand.",
          "plainText": "Give the word ho and stand",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "What now, Lucilius! is Cassius near?",
          "plainText": "What now Lucilius is Cassius near",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lucilius",
        "name": "LUCILIUS",
        "displayName": "Lucilius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "He is at hand, and Pindarus is come",
          "plainText": "He is at hand and Pindarus is come",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "To do you salutation from his master.",
          "plainText": "To do you salutation from his master",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-stage-002",
      "type": "stage",
      "text": "[Pindarus gives a letter to Brutus.]"
    },
    {
      "id": "julius-caesar-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "He greets me well. Your master, Pindarus,",
          "plainText": "He greets me well Your master Pindarus",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "In his own change, or by ill officers,",
          "plainText": "In his own change or by ill officers",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "Hath given me some worthy cause to wish",
          "plainText": "Hath given me some worthy cause to wish",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Things done, undone: but, if he be at hand,",
          "plainText": "Things done undone but if he be at hand",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "I shall be satisfied.",
          "plainText": "I shall be satisfied",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "pindarus",
        "name": "PINDARUS",
        "displayName": "Pindarus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "I do not doubt",
          "plainText": "I do not doubt",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "But that my noble master will appear",
          "plainText": "But that my noble master will appear",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Such as he is, full of regard and honour.",
          "plainText": "Such as he is full of regard and honour",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "He is not doubted. A word, Lucilius;",
          "plainText": "He is not doubted A word Lucilius",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "How he received you, let me be resolv'd.",
          "plainText": "How he received you let me be resolv'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "lucilius",
        "name": "LUCILIUS",
        "displayName": "Lucilius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "With courtesy and with respect enough,",
          "plainText": "With courtesy and with respect enough",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "But not with such familiar instances,",
          "plainText": "But not with such familiar instances",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Nor with such free and friendly conference,",
          "plainText": "Nor with such free and friendly conference",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "As he hath us'd of old.",
          "plainText": "As he hath us'd of old",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Thou hast describ'd",
          "plainText": "Thou hast describ'd",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "A hot friend cooling. Ever note, Lucilius,",
          "plainText": "A hot friend cooling Ever note Lucilius",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "When love begins to sicken and decay",
          "plainText": "When love begins to sicken and decay",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "It useth an enforced ceremony.",
          "plainText": "It useth an enforced ceremony",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "There are no tricks in plain and simple faith;",
          "plainText": "There are no tricks in plain and simple faith",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 6,
          "text": "But hollow men, like horses hot at hand,",
          "plainText": "But hollow men like horses hot at hand",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 7,
          "text": "Make gallant show and promise of their mettle;",
          "plainText": "Make gallant show and promise of their mettle",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-stage-003",
      "type": "stage",
      "text": "[Low march within.]"
    },
    {
      "id": "julius-caesar-4-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "lucilius",
        "name": "LUCILIUS",
        "displayName": "Lucilius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "They meant this night in Sardis to be quarter'd;",
          "plainText": "They meant this night in Sardis to be quarter'd",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "The greater part, the horse in general,",
          "plainText": "The greater part the horse in general",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "Are come with Cassius.",
          "plainText": "Are come with Cassius",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-stage-004",
      "type": "stage",
      "text": "Enter Cassius and Soldiers."
    },
    {
      "id": "julius-caesar-4-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Hark! he is arriv'd.",
          "plainText": "Hark he is arriv'd",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "March gently on to meet him.",
          "plainText": "March gently on to meet him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Stand, ho!",
          "plainText": "Stand ho",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Stand, ho! Speak the word along.",
          "plainText": "Stand ho Speak the word along",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Stand!",
          "plainText": "Stand",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Stand!",
          "plainText": "Stand",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "third-soldier",
        "name": "THIRD SOLDIER",
        "displayName": "Third Soldier"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Stand!",
          "plainText": "Stand",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Most noble brother, you have done me wrong.",
          "plainText": "Most noble brother you have done me wrong",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Judge me, you gods; wrong I mine enemies?",
          "plainText": "Judge me you gods wrong I mine enemies",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "And if not so, how should I wrong a brother?",
          "plainText": "And if not so how should I wrong a brother",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Brutus, this sober form of yours hides wrongs;",
          "plainText": "Brutus this sober form of yours hides wrongs",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "And when you do them—",
          "plainText": "And when you do them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Cassius, be content.",
          "plainText": "Cassius be content",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "Speak your griefs softly, I do know you well.",
          "plainText": "Speak your griefs softly I do know you well",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "Before the eyes of both our armies here,",
          "plainText": "Before the eyes of both our armies here",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0045",
          "number": 45,
          "speechLineNumber": 4,
          "text": "Which should perceive nothing but love from us,",
          "plainText": "Which should perceive nothing but love from us",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0046",
          "number": 46,
          "speechLineNumber": 5,
          "text": "Let us not wrangle. Bid them move away;",
          "plainText": "Let us not wrangle Bid them move away",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0047",
          "number": 47,
          "speechLineNumber": 6,
          "text": "Then in my tent, Cassius, enlarge your griefs,",
          "plainText": "Then in my tent Cassius enlarge your griefs",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0048",
          "number": 48,
          "speechLineNumber": 7,
          "text": "And I will give you audience.",
          "plainText": "And I will give you audience",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Pindarus,",
          "plainText": "Pindarus",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Bid our commanders lead their charges off",
          "plainText": "Bid our commanders lead their charges off",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "A little from this ground.",
          "plainText": "A little from this ground",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-4-2-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Lucilius, do you the like; and let no man",
          "plainText": "Lucilius do you the like and let no man",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Come to our tent till we have done our conference.",
          "plainText": "Come to our tent till we have done our conference",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-4-2-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "Lucius and Titinius, guard our door.",
          "plainText": "Lucius and Titinius guard our door",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-4-2-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}