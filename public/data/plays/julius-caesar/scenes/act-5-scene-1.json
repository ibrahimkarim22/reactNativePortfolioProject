  "scene": {
    "id": "julius-caesar-5-1",
    "act": 5,
    "scene": 1,
    "label": "Act 5, Scene 1",
    "title": "SCENE I. The plains of Philippi.",
    "location": "The plains of Philippi.",
    "orderInPlay": 14
  },
  "content": [
    {
      "id": "julius-caesar-5-1-stage-001",
      "type": "stage",
      "text": "Enter Octavius, Antony and their Army."
    },
    {
      "id": "julius-caesar-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Now, Antony, our hopes are answered.",
          "plainText": "Now Antony our hopes are answered",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "You said the enemy would not come down,",
          "plainText": "You said the enemy would not come down",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "But keep the hills and upper regions.",
          "plainText": "But keep the hills and upper regions",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "It proves not so; their battles are at hand,",
          "plainText": "It proves not so their battles are at hand",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "They mean to warn us at Philippi here,",
          "plainText": "They mean to warn us at Philippi here",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Answering before we do demand of them.",
          "plainText": "Answering before we do demand of them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Tut, I am in their bosoms, and I know",
          "plainText": "Tut I am in their bosoms and I know",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Wherefore they do it. They could be content",
          "plainText": "Wherefore they do it They could be content",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "To visit other places, and come down",
          "plainText": "To visit other places and come down",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "With fearful bravery, thinking by this face",
          "plainText": "With fearful bravery thinking by this face",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "To fasten in our thoughts that they have courage;",
          "plainText": "To fasten in our thoughts that they have courage",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "But 'tis not so.",
          "plainText": "But 'tis not so",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-stage-002",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "julius-caesar-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Prepare you, generals.",
          "plainText": "Prepare you generals",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "The enemy comes on in gallant show;",
          "plainText": "The enemy comes on in gallant show",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "Their bloody sign of battle is hung out,",
          "plainText": "Their bloody sign of battle is hung out",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "And something to be done immediately.",
          "plainText": "And something to be done immediately",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Octavius, lead your battle softly on",
          "plainText": "Octavius lead your battle softly on",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Upon the left hand of the even field.",
          "plainText": "Upon the left hand of the even field",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Upon the right hand I. Keep thou the left.",
          "plainText": "Upon the right hand I Keep thou the left",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Why do you cross me in this exigent?",
          "plainText": "Why do you cross me in this exigent",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "I do not cross you; but I will do so.",
          "plainText": "I do not cross you but I will do so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-stage-003",
      "type": "stage",
      "text": "[March.]"
    },
    {
      "id": "julius-caesar-5-1-stage-004",
      "type": "stage",
      "text": "Drum. Enter Brutus, Cassius and their Army; Lucilius, Titinius, Messala and others."
    },
    {
      "id": "julius-caesar-5-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "They stand, and would have parley.",
          "plainText": "They stand and would have parley",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Stand fast, Titinius; we must out and talk.",
          "plainText": "Stand fast Titinius we must out and talk",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Mark Antony, shall we give sign of battle?",
          "plainText": "Mark Antony shall we give sign of battle",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "No, Caesar, we will answer on their charge.",
          "plainText": "No Caesar we will answer on their charge",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Make forth; the generals would have some words.",
          "plainText": "Make forth the generals would have some words",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Stir not until the signal.",
          "plainText": "Stir not until the signal",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Words before blows: is it so, countrymen?",
          "plainText": "Words before blows is it so countrymen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Not that we love words better, as you do.",
          "plainText": "Not that we love words better as you do",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Good words are better than bad strokes, Octavius.",
          "plainText": "Good words are better than bad strokes Octavius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "In your bad strokes, Brutus, you give good words;",
          "plainText": "In your bad strokes Brutus you give good words",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Witness the hole you made in Caesar's heart,",
          "plainText": "Witness the hole you made in Caesar's heart",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "Crying, \"Long live! Hail, Caesar!\"",
          "plainText": "Crying Long live Hail Caesar",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Antony,",
          "plainText": "Antony",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "The posture of your blows are yet unknown;",
          "plainText": "The posture of your blows are yet unknown",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "But for your words, they rob the Hybla bees,",
          "plainText": "But for your words they rob the Hybla bees",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "And leave them honeyless.",
          "plainText": "And leave them honeyless",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Not stingless too.",
          "plainText": "Not stingless too",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "O yes, and soundless too,",
          "plainText": "O yes and soundless too",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "For you have stol'n their buzzing, Antony,",
          "plainText": "For you have stol'n their buzzing Antony",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "And very wisely threat before you sting.",
          "plainText": "And very wisely threat before you sting",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Villains, you did not so when your vile daggers",
          "plainText": "Villains you did not so when your vile daggers",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "Hack'd one another in the sides of Caesar:",
          "plainText": "Hack'd one another in the sides of Caesar",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "You show'd your teeth like apes, and fawn'd like hounds,",
          "plainText": "You show'd your teeth like apes and fawn'd like hounds",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0045",
          "number": 45,
          "speechLineNumber": 4,
          "text": "And bow'd like bondmen, kissing Caesar's feet;",
          "plainText": "And bow'd like bondmen kissing Caesar's feet",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0046",
          "number": 46,
          "speechLineNumber": 5,
          "text": "Whilst damned Casca, like a cur, behind",
          "plainText": "Whilst damned Casca like a cur behind",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0047",
          "number": 47,
          "speechLineNumber": 6,
          "text": "Struck Caesar on the neck. O you flatterers!",
          "plainText": "Struck Caesar on the neck O you flatterers",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Flatterers! Now, Brutus, thank yourself.",
          "plainText": "Flatterers Now Brutus thank yourself",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "This tongue had not offended so today,",
          "plainText": "This tongue had not offended so today",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "If Cassius might have rul'd.",
          "plainText": "If Cassius might have rul'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Come, come, the cause. If arguing makes us sweat,",
          "plainText": "Come come the cause If arguing makes us sweat",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "The proof of it will turn to redder drops.",
          "plainText": "The proof of it will turn to redder drops",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "Look, I draw a sword against conspirators.",
          "plainText": "Look I draw a sword against conspirators",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "When think you that the sword goes up again?",
          "plainText": "When think you that the sword goes up again",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0055",
          "number": 55,
          "speechLineNumber": 5,
          "text": "Never, till Caesar's three and thirty wounds",
          "plainText": "Never till Caesar's three and thirty wounds",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0056",
          "number": 56,
          "speechLineNumber": 6,
          "text": "Be well aveng'd; or till another Caesar",
          "plainText": "Be well aveng'd or till another Caesar",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0057",
          "number": 57,
          "speechLineNumber": 7,
          "text": "Have added slaughter to the sword of traitors.",
          "plainText": "Have added slaughter to the sword of traitors",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Caesar, thou canst not die by traitors' hands,",
          "plainText": "Caesar thou canst not die by traitors' hands",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "Unless thou bring'st them with thee.",
          "plainText": "Unless thou bring'st them with thee",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "So I hope.",
          "plainText": "So I hope",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "I was not born to die on Brutus' sword.",
          "plainText": "I was not born to die on Brutus' sword",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "O, if thou wert the noblest of thy strain,",
          "plainText": "O if thou wert the noblest of thy strain",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "Young man, thou couldst not die more honourable.",
          "plainText": "Young man thou couldst not die more honourable",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "A peevish school-boy, worthless of such honour,",
          "plainText": "A peevish schoolboy worthless of such honour",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "Join'd with a masker and a reveller.",
          "plainText": "Join'd with a masker and a reveller",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Old Cassius still!",
          "plainText": "Old Cassius still",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Come, Antony; away!",
          "plainText": "Come Antony away",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "Defiance, traitors, hurl we in your teeth.",
          "plainText": "Defiance traitors hurl we in your teeth",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0069",
          "number": 69,
          "speechLineNumber": 3,
          "text": "If you dare fight today, come to the field;",
          "plainText": "If you dare fight today come to the field",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0070",
          "number": 70,
          "speechLineNumber": 4,
          "text": "If not, when you have stomachs.",
          "plainText": "If not when you have stomachs",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-stage-005",
      "type": "stage",
      "text": "[Exeunt Octavius, Antony and their Army.]"
    },
    {
      "id": "julius-caesar-5-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Why now, blow wind, swell billow, and swim bark!",
          "plainText": "Why now blow wind swell billow and swim bark",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "The storm is up, and all is on the hazard.",
          "plainText": "The storm is up and all is on the hazard",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Ho, Lucilius! Hark, a word with you.",
          "plainText": "Ho Lucilius Hark a word with you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-031",
      "type": "speech",
      "speaker": {
        "id": "lucilius",
        "name": "LUCILIUS",
        "displayName": "Lucilius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "My lord?",
          "plainText": "My lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-stage-006",
      "type": "stage",
      "text": "[Brutus and Lucilius talk apart.]"
    },
    {
      "id": "julius-caesar-5-1-speech-032",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Messala.",
          "plainText": "Messala",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-033",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "What says my General?",
          "plainText": "What says my General",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-034",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Messala,",
          "plainText": "Messala",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "This is my birth-day; as this very day",
          "plainText": "This is my birthday as this very day",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0079",
          "number": 79,
          "speechLineNumber": 3,
          "text": "Was Cassius born. Give me thy hand, Messala:",
          "plainText": "Was Cassius born Give me thy hand Messala",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0080",
          "number": 80,
          "speechLineNumber": 4,
          "text": "Be thou my witness that against my will",
          "plainText": "Be thou my witness that against my will",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0081",
          "number": 81,
          "speechLineNumber": 5,
          "text": "As Pompey was, am I compell'd to set",
          "plainText": "As Pompey was am I compell'd to set",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0082",
          "number": 82,
          "speechLineNumber": 6,
          "text": "Upon one battle all our liberties.",
          "plainText": "Upon one battle all our liberties",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0083",
          "number": 83,
          "speechLineNumber": 7,
          "text": "You know that I held Epicurus strong,",
          "plainText": "You know that I held Epicurus strong",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0084",
          "number": 84,
          "speechLineNumber": 8,
          "text": "And his opinion. Now I change my mind,",
          "plainText": "And his opinion Now I change my mind",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0085",
          "number": 85,
          "speechLineNumber": 9,
          "text": "And partly credit things that do presage.",
          "plainText": "And partly credit things that do presage",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0086",
          "number": 86,
          "speechLineNumber": 10,
          "text": "Coming from Sardis, on our former ensign",
          "plainText": "Coming from Sardis on our former ensign",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0087",
          "number": 87,
          "speechLineNumber": 11,
          "text": "Two mighty eagles fell, and there they perch'd,",
          "plainText": "Two mighty eagles fell and there they perch'd",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0088",
          "number": 88,
          "speechLineNumber": 12,
          "text": "Gorging and feeding from our soldiers' hands,",
          "plainText": "Gorging and feeding from our soldiers' hands",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0089",
          "number": 89,
          "speechLineNumber": 13,
          "text": "Who to Philippi here consorted us.",
          "plainText": "Who to Philippi here consorted us",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0090",
          "number": 90,
          "speechLineNumber": 14,
          "text": "This morning are they fled away and gone,",
          "plainText": "This morning are they fled away and gone",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0091",
          "number": 91,
          "speechLineNumber": 15,
          "text": "And in their steads do ravens, crows, and kites",
          "plainText": "And in their steads do ravens crows and kites",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0092",
          "number": 92,
          "speechLineNumber": 16,
          "text": "Fly o'er our heads, and downward look on us,",
          "plainText": "Fly o'er our heads and downward look on us",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0093",
          "number": 93,
          "speechLineNumber": 17,
          "text": "As we were sickly prey: their shadows seem",
          "plainText": "As we were sickly prey their shadows seem",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0094",
          "number": 94,
          "speechLineNumber": 18,
          "text": "A canopy most fatal, under which",
          "plainText": "A canopy most fatal under which",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0095",
          "number": 95,
          "speechLineNumber": 19,
          "text": "Our army lies, ready to give up the ghost.",
          "plainText": "Our army lies ready to give up the ghost",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-035",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0096",
          "number": 96,
          "speechLineNumber": 1,
          "text": "Believe not so.",
          "plainText": "Believe not so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-036",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0097",
          "number": 97,
          "speechLineNumber": 1,
          "text": "I but believe it partly,",
          "plainText": "I but believe it partly",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0098",
          "number": 98,
          "speechLineNumber": 2,
          "text": "For I am fresh of spirit, and resolv'd",
          "plainText": "For I am fresh of spirit and resolv'd",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0099",
          "number": 99,
          "speechLineNumber": 3,
          "text": "To meet all perils very constantly.",
          "plainText": "To meet all perils very constantly",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-037",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0100",
          "number": 100,
          "speechLineNumber": 1,
          "text": "Even so, Lucilius.",
          "plainText": "Even so Lucilius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-038",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0101",
          "number": 101,
          "speechLineNumber": 1,
          "text": "Now, most noble Brutus,",
          "plainText": "Now most noble Brutus",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0102",
          "number": 102,
          "speechLineNumber": 2,
          "text": "The gods today stand friendly, that we may,",
          "plainText": "The gods today stand friendly that we may",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0103",
          "number": 103,
          "speechLineNumber": 3,
          "text": "Lovers in peace, lead on our days to age!",
          "plainText": "Lovers in peace lead on our days to age",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0104",
          "number": 104,
          "speechLineNumber": 4,
          "text": "But, since the affairs of men rest still incertain,",
          "plainText": "But since the affairs of men rest still incertain",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0105",
          "number": 105,
          "speechLineNumber": 5,
          "text": "Let's reason with the worst that may befall.",
          "plainText": "Let's reason with the worst that may befall",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0106",
          "number": 106,
          "speechLineNumber": 6,
          "text": "If we do lose this battle, then is this",
          "plainText": "If we do lose this battle then is this",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0107",
          "number": 107,
          "speechLineNumber": 7,
          "text": "The very last time we shall speak together:",
          "plainText": "The very last time we shall speak together",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0108",
          "number": 108,
          "speechLineNumber": 8,
          "text": "What are you then determined to do?",
          "plainText": "What are you then determined to do",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-039",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0109",
          "number": 109,
          "speechLineNumber": 1,
          "text": "Even by the rule of that philosophy",
          "plainText": "Even by the rule of that philosophy",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0110",
          "number": 110,
          "speechLineNumber": 2,
          "text": "By which I did blame Cato for the death",
          "plainText": "By which I did blame Cato for the death",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0111",
          "number": 111,
          "speechLineNumber": 3,
          "text": "Which he did give himself, I know not how,",
          "plainText": "Which he did give himself I know not how",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0112",
          "number": 112,
          "speechLineNumber": 4,
          "text": "But I do find it cowardly and vile,",
          "plainText": "But I do find it cowardly and vile",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0113",
          "number": 113,
          "speechLineNumber": 5,
          "text": "For fear of what might fall, so to prevent",
          "plainText": "For fear of what might fall so to prevent",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0114",
          "number": 114,
          "speechLineNumber": 6,
          "text": "The time of life, arming myself with patience",
          "plainText": "The time of life arming myself with patience",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0115",
          "number": 115,
          "speechLineNumber": 7,
          "text": "To stay the providence of some high powers",
          "plainText": "To stay the providence of some high powers",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0116",
          "number": 116,
          "speechLineNumber": 8,
          "text": "That govern us below.",
          "plainText": "That govern us below",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-040",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0117",
          "number": 117,
          "speechLineNumber": 1,
          "text": "Then, if we lose this battle,",
          "plainText": "Then if we lose this battle",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0118",
          "number": 118,
          "speechLineNumber": 2,
          "text": "You are contented to be led in triumph",
          "plainText": "You are contented to be led in triumph",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0119",
          "number": 119,
          "speechLineNumber": 3,
          "text": "Thorough the streets of Rome?",
          "plainText": "Thorough the streets of Rome",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-041",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0120",
          "number": 120,
          "speechLineNumber": 1,
          "text": "No, Cassius, no: think not, thou noble Roman,",
          "plainText": "No Cassius no think not thou noble Roman",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0121",
          "number": 121,
          "speechLineNumber": 2,
          "text": "That ever Brutus will go bound to Rome;",
          "plainText": "That ever Brutus will go bound to Rome",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0122",
          "number": 122,
          "speechLineNumber": 3,
          "text": "He bears too great a mind. But this same day",
          "plainText": "He bears too great a mind But this same day",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0123",
          "number": 123,
          "speechLineNumber": 4,
          "text": "Must end that work the Ides of March begun;",
          "plainText": "Must end that work the Ides of March begun",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0124",
          "number": 124,
          "speechLineNumber": 5,
          "text": "And whether we shall meet again I know not.",
          "plainText": "And whether we shall meet again I know not",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0125",
          "number": 125,
          "speechLineNumber": 6,
          "text": "Therefore our everlasting farewell take.",
          "plainText": "Therefore our everlasting farewell take",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0126",
          "number": 126,
          "speechLineNumber": 7,
          "text": "For ever, and for ever, farewell, Cassius.",
          "plainText": "For ever and for ever farewell Cassius",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0127",
          "number": 127,
          "speechLineNumber": 8,
          "text": "If we do meet again, why, we shall smile;",
          "plainText": "If we do meet again why we shall smile",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0128",
          "number": 128,
          "speechLineNumber": 9,
          "text": "If not, why then this parting was well made.",
          "plainText": "If not why then this parting was well made",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-042",
      "type": "speech",
      "speaker": {
        "id": "cassius",
        "name": "CASSIUS",
        "displayName": "Cassius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0129",
          "number": 129,
          "speechLineNumber": 1,
          "text": "For ever and for ever farewell, Brutus.",
          "plainText": "For ever and for ever farewell Brutus",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0130",
          "number": 130,
          "speechLineNumber": 2,
          "text": "If we do meet again, we'll smile indeed;",
          "plainText": "If we do meet again we'll smile indeed",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0131",
          "number": 131,
          "speechLineNumber": 3,
          "text": "If not, 'tis true this parting was well made.",
          "plainText": "If not 'tis true this parting was well made",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-speech-043",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-1-line-0132",
          "number": 132,
          "speechLineNumber": 1,
          "text": "Why then, lead on. O, that a man might know",
          "plainText": "Why then lead on O that a man might know",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0133",
          "number": 133,
          "speechLineNumber": 2,
          "text": "The end of this day's business ere it come!",
          "plainText": "The end of this day's business ere it come",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0134",
          "number": 134,
          "speechLineNumber": 3,
          "text": "But it sufficeth that the day will end,",
          "plainText": "But it sufficeth that the day will end",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-1-line-0135",
          "number": 135,
          "speechLineNumber": 4,
          "text": "And then the end is known. Come, ho! away!",
          "plainText": "And then the end is known Come ho away",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-1-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}