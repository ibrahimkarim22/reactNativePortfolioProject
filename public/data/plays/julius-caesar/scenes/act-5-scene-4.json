  },
  "scene": {
    "id": "julius-caesar-5-4",
    "act": 5,
    "scene": 4,
    "label": "Act 5, Scene 4",
    "title": "SCENE IV. Another part of the field.",
    "location": "Another part of the field.",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "julius-caesar-5-4-stage-001",
      "type": "stage",
      "text": "Alarum. Enter fighting soldiers of both armies; then Brutus, Messala, young Cato, Lucilius, Flavius and others."
    },
    {
      "id": "julius-caesar-5-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Yet, countrymen, O, yet hold up your heads!",
          "plainText": "Yet countrymen O yet hold up your heads",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "cato",
        "name": "CATO",
        "displayName": "Cato"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "What bastard doth not? Who will go with me?",
          "plainText": "What bastard doth not Who will go with me",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "I will proclaim my name about the field.",
          "plainText": "I will proclaim my name about the field",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "I am the son of Marcus Cato, ho!",
          "plainText": "I am the son of Marcus Cato ho",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "A foe to tyrants, and my country's friend.",
          "plainText": "A foe to tyrants and my country's friend",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0006",
          "number": 6,
          "speechLineNumber": 5,
          "text": "I am the son of Marcus Cato, ho!",
          "plainText": "I am the son of Marcus Cato ho",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-stage-002",
      "type": "stage",
      "text": "[Charges the enemy.]"
    },
    {
      "id": "julius-caesar-5-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lucilius",
        "name": "LUCILIUS",
        "displayName": "Lucilius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "And I am Brutus, Marcus Brutus, I;",
          "plainText": "And I am Brutus Marcus Brutus I",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Brutus, my country's friend; know me for Brutus!",
          "plainText": "Brutus my country's friend know me for Brutus",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-stage-003",
      "type": "stage",
      "text": "[Exit, charging the enemy. Cato is overpowered, and falls.]"
    },
    {
      "id": "julius-caesar-5-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lucilius",
        "name": "LUCILIUS",
        "displayName": "Lucilius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "O young and noble Cato, art thou down?",
          "plainText": "O young and noble Cato art thou down",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Why, now thou diest as bravely as Titinius,",
          "plainText": "Why now thou diest as bravely as Titinius",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "And mayst be honour'd, being Cato's son.",
          "plainText": "And mayst be honour'd being Cato's son",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Yield, or thou diest.",
          "plainText": "Yield or thou diest",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "lucilius",
        "name": "LUCILIUS",
        "displayName": "Lucilius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Only I yield to die:",
          "plainText": "Only I yield to die",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "There is so much that thou wilt kill me straight;",
          "plainText": "There is so much that thou wilt kill me straight",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-stage-004",
      "type": "stage",
      "text": "[Offering money]"
    },
    {
      "id": "julius-caesar-5-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "We must not. A noble prisoner!",
          "plainText": "We must not A noble prisoner",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "second-soldier",
        "name": "SECOND SOLDIER",
        "displayName": "Second Soldier"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Room, ho! Tell Antony, Brutus is ta'en.",
          "plainText": "Room ho Tell Antony Brutus is ta'en",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "first-soldier",
        "name": "FIRST SOLDIER",
        "displayName": "First Soldier"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "I'll tell the news. Here comes the General.",
          "plainText": "I'll tell the news Here comes the General",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-stage-005",
      "type": "stage",
      "text": "Enter Antony."
    },
    {
      "id": "julius-caesar-5-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Where is he?",
          "plainText": "Where is he",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "lucilius",
        "name": "LUCILIUS",
        "displayName": "Lucilius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Safe, Antony; Brutus is safe enough.",
          "plainText": "Safe Antony Brutus is safe enough",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "I dare assure thee that no enemy",
          "plainText": "I dare assure thee that no enemy",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Shall ever take alive the noble Brutus.",
          "plainText": "Shall ever take alive the noble Brutus",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "The gods defend him from so great a shame!",
          "plainText": "The gods defend him from so great a shame",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "When you do find him, or alive or dead,",
          "plainText": "When you do find him or alive or dead",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "He will be found like Brutus, like himself.",
          "plainText": "He will be found like Brutus like himself",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "This is not Brutus, friend; but, I assure you,",
          "plainText": "This is not Brutus friend but I assure you",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "A prize no less in worth. Keep this man safe,",
          "plainText": "A prize no less in worth Keep this man safe",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "Give him all kindness. I had rather have",
          "plainText": "Give him all kindness I had rather have",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "Such men my friends than enemies. Go on,",
          "plainText": "Such men my friends than enemies Go on",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "And see whether Brutus be alive or dead;",
          "plainText": "And see whether Brutus be alive or dead",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "And bring us word unto Octavius' tent",
          "plainText": "And bring us word unto Octavius' tent",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-4-line-0031",
          "number": 31,
          "speechLineNumber": 7,
          "text": "How everything is chanc'd.",
          "plainText": "How everything is chanc'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-4-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}