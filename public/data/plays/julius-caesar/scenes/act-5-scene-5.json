  "scene": {
    "id": "julius-caesar-5-5",
    "act": 5,
    "scene": 5,
    "label": "Act 5, Scene 5",
    "title": "SCENE V. Another part of the field.",
    "location": "Another part of the field.",
    "orderInPlay": 18
  },
  "content": [
    {
      "id": "julius-caesar-5-5-stage-001",
      "type": "stage",
      "text": "Enter Brutus, Dardanius, Clitus, Strato and Volumnius."
    },
    {
      "id": "julius-caesar-5-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Come, poor remains of friends, rest on this rock.",
          "plainText": "Come poor remains of friends rest on this rock",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "clitus",
        "name": "CLITUS",
        "displayName": "Clitus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Statilius show'd the torch-light; but, my lord,",
          "plainText": "Statilius show'd the torchlight but my lord",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "He came not back: he is or ta'en or slain.",
          "plainText": "He came not back he is or ta'en or slain",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Sit thee down, Clitus. Slaying is the word;",
          "plainText": "Sit thee down Clitus Slaying is the word",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "It is a deed in fashion. Hark thee, Clitus.",
          "plainText": "It is a deed in fashion Hark thee Clitus",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-stage-002",
      "type": "stage",
      "text": "[Whispering.]"
    },
    {
      "id": "julius-caesar-5-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "clitus",
        "name": "CLITUS",
        "displayName": "Clitus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "What, I, my lord? No, not for all the world.",
          "plainText": "What I my lord No not for all the world",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Peace then, no words.",
          "plainText": "Peace then no words",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "clitus",
        "name": "CLITUS",
        "displayName": "Clitus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I'll rather kill myself.",
          "plainText": "I'll rather kill myself",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Hark thee, Dardanius.",
          "plainText": "Hark thee Dardanius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-stage-003",
      "type": "stage",
      "text": "[Whispers him.]"
    },
    {
      "id": "julius-caesar-5-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "dardanius",
        "name": "DARDANIUS",
        "displayName": "Dardanius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Shall I do such a deed?",
          "plainText": "Shall I do such a deed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "clitus",
        "name": "CLITUS",
        "displayName": "Clitus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "O Dardanius!",
          "plainText": "O Dardanius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "dardanius",
        "name": "DARDANIUS",
        "displayName": "Dardanius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "O Clitus!",
          "plainText": "O Clitus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "clitus",
        "name": "CLITUS",
        "displayName": "Clitus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "What ill request did Brutus make to thee?",
          "plainText": "What ill request did Brutus make to thee",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "dardanius",
        "name": "DARDANIUS",
        "displayName": "Dardanius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "To kill him, Clitus. Look, he meditates.",
          "plainText": "To kill him Clitus Look he meditates",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "clitus",
        "name": "CLITUS",
        "displayName": "Clitus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Now is that noble vessel full of grief,",
          "plainText": "Now is that noble vessel full of grief",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "That it runs over even at his eyes.",
          "plainText": "That it runs over even at his eyes",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Come hither, good Volumnius; list a word.",
          "plainText": "Come hither good Volumnius list a word",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "volumnius",
        "name": "VOLUMNIUS",
        "displayName": "Volumnius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "What says my lord?",
          "plainText": "What says my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Why, this, Volumnius:",
          "plainText": "Why this Volumnius",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "The ghost of Caesar hath appear'd to me",
          "plainText": "The ghost of Caesar hath appear'd to me",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Two several times by night; at Sardis once,",
          "plainText": "Two several times by night at Sardis once",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "And this last night here in Philippi fields.",
          "plainText": "And this last night here in Philippi fields",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "I know my hour is come.",
          "plainText": "I know my hour is come",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "volumnius",
        "name": "VOLUMNIUS",
        "displayName": "Volumnius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Not so, my lord.",
          "plainText": "Not so my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Nay I am sure it is, Volumnius.",
          "plainText": "Nay I am sure it is Volumnius",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Thou seest the world, Volumnius, how it goes;",
          "plainText": "Thou seest the world Volumnius how it goes",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "Our enemies have beat us to the pit.",
          "plainText": "Our enemies have beat us to the pit",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-stage-004",
      "type": "stage",
      "text": "[Low alarums.]"
    },
    {
      "id": "julius-caesar-5-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "volumnius",
        "name": "VOLUMNIUS",
        "displayName": "Volumnius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "That's not an office for a friend, my lord.",
          "plainText": "That's not an office for a friend my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-stage-005",
      "type": "stage",
      "text": "[Alarums still.]"
    },
    {
      "id": "julius-caesar-5-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "clitus",
        "name": "CLITUS",
        "displayName": "Clitus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Fly, fly, my lord! there is no tarrying here.",
          "plainText": "Fly fly my lord there is no tarrying here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Farewell to you; and you; and you, Volumnius.",
          "plainText": "Farewell to you and you and you Volumnius",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "Strato, thou hast been all this while asleep;",
          "plainText": "Strato thou hast been all this while asleep",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "Farewell to thee too, Strato.—Countrymen,",
          "plainText": "Farewell to thee too StratoCountrymen",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0033",
          "number": 33,
          "speechLineNumber": 4,
          "text": "My heart doth joy, that yet in all my life",
          "plainText": "My heart doth joy that yet in all my life",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0034",
          "number": 34,
          "speechLineNumber": 5,
          "text": "I found no man but he was true to me.",
          "plainText": "I found no man but he was true to me",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0035",
          "number": 35,
          "speechLineNumber": 6,
          "text": "I shall have glory by this losing day",
          "plainText": "I shall have glory by this losing day",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0036",
          "number": 36,
          "speechLineNumber": 7,
          "text": "More than Octavius and Mark Antony",
          "plainText": "More than Octavius and Mark Antony",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0037",
          "number": 37,
          "speechLineNumber": 8,
          "text": "By this vile conquest shall attain unto.",
          "plainText": "By this vile conquest shall attain unto",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0038",
          "number": 38,
          "speechLineNumber": 9,
          "text": "So fare you well at once; for Brutus' tongue",
          "plainText": "So fare you well at once for Brutus' tongue",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0039",
          "number": 39,
          "speechLineNumber": 10,
          "text": "Hath almost ended his life's history.",
          "plainText": "Hath almost ended his life's history",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0040",
          "number": 40,
          "speechLineNumber": 11,
          "text": "Night hangs upon mine eyes; my bones would rest,",
          "plainText": "Night hangs upon mine eyes my bones would rest",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0041",
          "number": 41,
          "speechLineNumber": 12,
          "text": "That have but labour'd to attain this hour.",
          "plainText": "That have but labour'd to attain this hour",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-stage-006",
      "type": "stage",
      "text": "[Alarums. Cry within, \"Fly, fly, fly!\".]"
    },
    {
      "id": "julius-caesar-5-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "clitus",
        "name": "CLITUS",
        "displayName": "Clitus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Fly, my lord, fly!",
          "plainText": "Fly my lord fly",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Hence! I will follow.",
          "plainText": "Hence I will follow",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-stage-007",
      "type": "stage",
      "text": "[Exeunt Clitus, Dardanius and Volumnius.]"
    },
    {
      "id": "julius-caesar-5-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "strato",
        "name": "STRATO",
        "displayName": "Strato"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Give me your hand first. Fare you well, my lord.",
          "plainText": "Give me your hand first Fare you well my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "brutus",
        "name": "BRUTUS",
        "displayName": "Brutus"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Farewell, good Strato.—Caesar, now be still:",
          "plainText": "Farewell good StratoCaesar now be still",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "I kill'd not thee with half so good a will.",
          "plainText": "I kill'd not thee with half so good a will",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-stage-008",
      "type": "stage",
      "text": "[He runs on his sword, and dies.]"
    },
    {
      "id": "julius-caesar-5-5-stage-009",
      "type": "stage",
      "text": "Alarum. Retreat. Enter Antony, Octavius, Messala, Lucilius and the Army."
    },
    {
      "id": "julius-caesar-5-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "What man is that?",
          "plainText": "What man is that",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-027",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "My master's man. Strato, where is thy master?",
          "plainText": "My master's man Strato where is thy master",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-028",
      "type": "speech",
      "speaker": {
        "id": "strato",
        "name": "STRATO",
        "displayName": "Strato"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Free from the bondage you are in, Messala.",
          "plainText": "Free from the bondage you are in Messala",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "The conquerors can but make a fire of him;",
          "plainText": "The conquerors can but make a fire of him",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "For Brutus only overcame himself,",
          "plainText": "For Brutus only overcame himself",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "And no man else hath honour by his death.",
          "plainText": "And no man else hath honour by his death",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-029",
      "type": "speech",
      "speaker": {
        "id": "lucilius",
        "name": "LUCILIUS",
        "displayName": "Lucilius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "So Brutus should be found. I thank thee, Brutus,",
          "plainText": "So Brutus should be found I thank thee Brutus",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "That thou hast prov'd Lucilius' saying true.",
          "plainText": "That thou hast prov'd Lucilius' saying true",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-030",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "All that serv'd Brutus, I will entertain them.",
          "plainText": "All that serv'd Brutus I will entertain them",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "Fellow, wilt thou bestow thy time with me?",
          "plainText": "Fellow wilt thou bestow thy time with me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-031",
      "type": "speech",
      "speaker": {
        "id": "strato",
        "name": "STRATO",
        "displayName": "Strato"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Ay, if Messala will prefer me to you.",
          "plainText": "Ay if Messala will prefer me to you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-032",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Do so, good Messala.",
          "plainText": "Do so good Messala",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-033",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "How died my master, Strato?",
          "plainText": "How died my master Strato",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-034",
      "type": "speech",
      "speaker": {
        "id": "strato",
        "name": "STRATO",
        "displayName": "Strato"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "I held the sword, and he did run on it.",
          "plainText": "I held the sword and he did run on it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-035",
      "type": "speech",
      "speaker": {
        "id": "messala",
        "name": "MESSALA",
        "displayName": "Messala"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Octavius, then take him to follow thee,",
          "plainText": "Octavius then take him to follow thee",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "That did the latest service to my master.",
          "plainText": "That did the latest service to my master",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-036",
      "type": "speech",
      "speaker": {
        "id": "antony",
        "name": "ANTONY",
        "displayName": "Antony"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "This was the noblest Roman of them all.",
          "plainText": "This was the noblest Roman of them all",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "All the conspirators save only he,",
          "plainText": "All the conspirators save only he",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "Did that they did in envy of great Caesar;",
          "plainText": "Did that they did in envy of great Caesar",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "He only, in a general honest thought",
          "plainText": "He only in a general honest thought",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0067",
          "number": 67,
          "speechLineNumber": 5,
          "text": "And common good to all, made one of them.",
          "plainText": "And common good to all made one of them",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0068",
          "number": 68,
          "speechLineNumber": 6,
          "text": "His life was gentle, and the elements",
          "plainText": "His life was gentle and the elements",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0069",
          "number": 69,
          "speechLineNumber": 7,
          "text": "So mix'd in him that Nature might stand up",
          "plainText": "So mix'd in him that Nature might stand up",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0070",
          "number": 70,
          "speechLineNumber": 8,
          "text": "And say to all the world, \"This was a man!\"",
          "plainText": "And say to all the world This was a man",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-speech-037",
      "type": "speech",
      "speaker": {
        "id": "octavius",
        "name": "OCTAVIUS",
        "displayName": "Octavius"
      },
      "lines": [
        {
          "id": "julius-caesar-5-5-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "According to his virtue let us use him",
          "plainText": "According to his virtue let us use him",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "With all respect and rites of burial.",
          "plainText": "With all respect and rites of burial",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "Within my tent his bones tonight shall lie,",
          "plainText": "Within my tent his bones tonight shall lie",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0074",
          "number": 74,
          "speechLineNumber": 4,
          "text": "Most like a soldier, order'd honourably.",
          "plainText": "Most like a soldier order'd honourably",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0075",
          "number": 75,
          "speechLineNumber": 5,
          "text": "So call the field to rest, and let's away,",
          "plainText": "So call the field to rest and let's away",
          "lineType": "verse"
        },
        {
          "id": "julius-caesar-5-5-line-0076",
          "number": 76,
          "speechLineNumber": 6,
          "text": "To part the glories of this happy day.",
          "plainText": "To part the glories of this happy day",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "julius-caesar-5-5-stage-010",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}