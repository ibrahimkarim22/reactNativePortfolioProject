  },
  "content": [
    {
      "id": "king-henry-the-eighth-1-3-stage-001",
      "type": "stage",
      "text": "Enter Lord Chamberlain and Lord Sandys."
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Is't possible the spells of France should juggle",
          "plainText": "Is't possible the spells of France should juggle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Men into such strange mysteries?",
          "plainText": "Men into such strange mysteries",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "sandys",
        "name": "SANDYS",
        "displayName": "Sandys"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "New customs,",
          "plainText": "New customs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Though they be never so ridiculous—",
          "plainText": "Though they be never so ridiculous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Nay, let 'em be unmanly—yet are followed.",
          "plainText": "Nay let 'em be unmanlyyet are followed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "As far as I see, all the good our English",
          "plainText": "As far as I see all the good our English",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Have got by the late voyage is but merely",
          "plainText": "Have got by the late voyage is but merely",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "A fit or two o' th' face; but they are shrewd ones,",
          "plainText": "A fit or two o' th' face but they are shrewd ones",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "For when they hold 'em, you would swear directly",
          "plainText": "For when they hold 'em you would swear directly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "Their very noses had been counsellors",
          "plainText": "Their very noses had been counsellors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0011",
          "number": 11,
          "speechLineNumber": 6,
          "text": "To Pepin or Clotharius, they keep state so.",
          "plainText": "To Pepin or Clotharius they keep state so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "sandys",
        "name": "SANDYS",
        "displayName": "Sandys"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "They have all new legs, and lame ones. One would take it,",
          "plainText": "They have all new legs and lame ones One would take it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "That never saw 'em pace before, the spavin",
          "plainText": "That never saw 'em pace before the spavin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Or springhalt reigned among 'em.",
          "plainText": "Or springhalt reigned among 'em",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Death! My lord,",
          "plainText": "Death My lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Their clothes are after such a pagan cut to't,",
          "plainText": "Their clothes are after such a pagan cut to't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "That, sure, they've worn out Christendom.",
          "plainText": "That sure they've worn out Christendom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-stage-002",
      "type": "stage",
      "text": "Enter Sir Thomas Lovell."
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "lovell",
        "name": "LOVELL",
        "displayName": "Lovell"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Faith, my lord,",
          "plainText": "Faith my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "I hear of none but the new proclamation",
          "plainText": "I hear of none but the new proclamation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "That's clapped upon the court gate.",
          "plainText": "That's clapped upon the court gate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "What is't for?",
          "plainText": "What is't for",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "lovell",
        "name": "LOVELL",
        "displayName": "Lovell"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "The reformation of our travelled gallants",
          "plainText": "The reformation of our travelled gallants",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "That fill the court with quarrels, talk, and tailors.",
          "plainText": "That fill the court with quarrels talk and tailors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "I'm glad 'tis there. Now I would pray our monsieurs",
          "plainText": "I'm glad 'tis there Now I would pray our monsieurs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "To think an English courtier may be wise",
          "plainText": "To think an English courtier may be wise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "And never see the Louvre.",
          "plainText": "And never see the Louvre",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "lovell",
        "name": "LOVELL",
        "displayName": "Lovell"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "They must either,",
          "plainText": "They must either",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "For so run the conditions, leave those remnants",
          "plainText": "For so run the conditions leave those remnants",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "Of fool and feather that they got in France,",
          "plainText": "Of fool and feather that they got in France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "With all their honourable points of ignorance",
          "plainText": "With all their honourable points of ignorance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "Pertaining thereunto, as fights and fireworks,",
          "plainText": "Pertaining thereunto as fights and fireworks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0032",
          "number": 32,
          "speechLineNumber": 6,
          "text": "Abusing better men than they can be",
          "plainText": "Abusing better men than they can be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0033",
          "number": 33,
          "speechLineNumber": 7,
          "text": "Out of a foreign wisdom, renouncing clean",
          "plainText": "Out of a foreign wisdom renouncing clean",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0034",
          "number": 34,
          "speechLineNumber": 8,
          "text": "The faith they have in tennis and tall stockings,",
          "plainText": "The faith they have in tennis and tall stockings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0035",
          "number": 35,
          "speechLineNumber": 9,
          "text": "Short blistered breeches, and those types of travel,",
          "plainText": "Short blistered breeches and those types of travel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0036",
          "number": 36,
          "speechLineNumber": 10,
          "text": "And understand again like honest men,",
          "plainText": "And understand again like honest men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0037",
          "number": 37,
          "speechLineNumber": 11,
          "text": "Or pack to their old playfellows. There, I take it,",
          "plainText": "Or pack to their old playfellows There I take it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0038",
          "number": 38,
          "speechLineNumber": 12,
          "text": "They may, cum privilegio, oui away",
          "plainText": "They may cum privilegio oui away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0039",
          "number": 39,
          "speechLineNumber": 13,
          "text": "The lag end of their lewdness and be laughed at.",
          "plainText": "The lag end of their lewdness and be laughed at",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "sandys",
        "name": "SANDYS",
        "displayName": "Sandys"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "'Tis time to give 'em physic, their diseases",
          "plainText": "'Tis time to give 'em physic their diseases",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Are grown so catching.",
          "plainText": "Are grown so catching",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "What a loss our ladies",
          "plainText": "What a loss our ladies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "Will have of these trim vanities!",
          "plainText": "Will have of these trim vanities",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "lovell",
        "name": "LOVELL",
        "displayName": "Lovell"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Ay, marry,",
          "plainText": "Ay marry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "There will be woe indeed, lords. The sly whoresons",
          "plainText": "There will be woe indeed lords The sly whoresons",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "Have got a speeding trick to lay down ladies.",
          "plainText": "Have got a speeding trick to lay down ladies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "A French song and a fiddle has no fellow.",
          "plainText": "A French song and a fiddle has no fellow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "sandys",
        "name": "SANDYS",
        "displayName": "Sandys"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "The devil fiddle 'em! I am glad they are going,",
          "plainText": "The devil fiddle 'em I am glad they are going",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "For sure, there's no converting of 'em. Now",
          "plainText": "For sure there's no converting of 'em Now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "An honest country lord, as I am, beaten",
          "plainText": "An honest country lord as I am beaten",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "A long time out of play, may bring his plainsong",
          "plainText": "A long time out of play may bring his plainsong",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0052",
          "number": 52,
          "speechLineNumber": 5,
          "text": "And have an hour of hearing, and, by 'r Lady,",
          "plainText": "And have an hour of hearing and by 'r Lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0053",
          "number": 53,
          "speechLineNumber": 6,
          "text": "Held current music too.",
          "plainText": "Held current music too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Well said, Lord Sandys.",
          "plainText": "Well said Lord Sandys",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "Your colt's tooth is not cast yet.",
          "plainText": "Your colt's tooth is not cast yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "sandys",
        "name": "SANDYS",
        "displayName": "Sandys"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "No, my lord,",
          "plainText": "No my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0057",
          "number": 57,
          "speechLineNumber": 2,
          "text": "Nor shall not while I have a stump.",
          "plainText": "Nor shall not while I have a stump",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Sir Thomas,",
          "plainText": "Sir Thomas",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "Whither were you a-going?",
          "plainText": "Whither were you agoing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "lovell",
        "name": "LOVELL",
        "displayName": "Lovell"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "To the Cardinal's.",
          "plainText": "To the Cardinal's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "Your lordship is a guest too.",
          "plainText": "Your lordship is a guest too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "O, 'tis true.",
          "plainText": "O 'tis true",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "This night he makes a supper, and a great one,",
          "plainText": "This night he makes a supper and a great one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "To many lords and ladies. There will be",
          "plainText": "To many lords and ladies There will be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "The beauty of this kingdom, I'll assure you.",
          "plainText": "The beauty of this kingdom I'll assure you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "lovell",
        "name": "LOVELL",
        "displayName": "Lovell"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "That churchman bears a bounteous mind indeed,",
          "plainText": "That churchman bears a bounteous mind indeed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "A hand as fruitful as the land that feeds us.",
          "plainText": "A hand as fruitful as the land that feeds us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0068",
          "number": 68,
          "speechLineNumber": 3,
          "text": "His dews fall everywhere.",
          "plainText": "His dews fall everywhere",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "No doubt he's noble;",
          "plainText": "No doubt he's noble",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "He had a black mouth that said other of him.",
          "plainText": "He had a black mouth that said other of him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "sandys",
        "name": "SANDYS",
        "displayName": "Sandys"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "He may, my lord; has wherewithal. In him",
          "plainText": "He may my lord has wherewithal In him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "Sparing would show a worse sin than ill doctrine.",
          "plainText": "Sparing would show a worse sin than ill doctrine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "Men of his way should be most liberal;",
          "plainText": "Men of his way should be most liberal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0074",
          "number": 74,
          "speechLineNumber": 4,
          "text": "They are set here for examples.",
          "plainText": "They are set here for examples",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "chamberlain",
        "name": "CHAMBERLAIN",
        "displayName": "Chamberlain"
      },
      "lines": [
        {
          "id": "king-henry-the-eighth-1-3-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "True, they are so,",
          "plainText": "True they are so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "But few now give so great ones. My barge stays.",
          "plainText": "But few now give so great ones My barge stays",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0077",
          "number": 77,
          "speechLineNumber": 3,
          "text": "Your lordship shall along. Come, good Sir Thomas,",
          "plainText": "Your lordship shall along Come good Sir Thomas",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0078",
          "number": 78,
          "speechLineNumber": 4,
          "text": "We shall be late else, which I would not be,",
          "plainText": "We shall be late else which I would not be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0079",
          "number": 79,
          "speechLineNumber": 5,
          "text": "For I was spoke to, with Sir Henry Guildford,",
          "plainText": "For I was spoke to with Sir Henry Guildford",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-eighth-1-3-line-0080",
          "number": 80,
          "speechLineNumber": 6,
          "text": "This night to be comptrollers.",
          "plainText": "This night to be comptrollers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-eighth-1-3-speech-024",
