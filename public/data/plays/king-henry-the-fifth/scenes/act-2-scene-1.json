  "content": [
    {
      "id": "king-henry-the-fifth-2-1-stage-001",
      "type": "stage",
      "text": "Enter Corporal Nym and Lieutenant Bardolph."
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Well met, Corporal Nym.",
          "plainText": "Well met Corporal Nym",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Good morrow, Lieutenant Bardolph.",
          "plainText": "Good morrow Lieutenant Bardolph",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "What, are Ancient Pistol and you friends yet?",
          "plainText": "What are Ancient Pistol and you friends yet",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "For my part, I care not. I say little; but when time shall serve, there shall be smiles; but that shall be as it may. I dare not fight, but I will wink and hold out mine iron. It is a simple one, but what though? It will toast cheese, and it will endure cold as another man's sword will; and there's an end.",
          "plainText": "For my part I care not I say little but when time shall serve there shall be smiles but that shall be as it may I dare not fight but I will wink and hold out mine iron It is a simple one but what though It will toast cheese and it will endure cold as another man's sword will and there's an end",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "I will bestow a breakfast to make you friends; and we'll be all three sworn brothers to France. Let it be so, good Corporal Nym.",
          "plainText": "I will bestow a breakfast to make you friends and we'll be all three sworn brothers to France Let it be so good Corporal Nym",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Faith, I will live so long as I may, that's the certain of it; and when I cannot live any longer, I will do as I may. That is my rest, that is the rendezvous of it.",
          "plainText": "Faith I will live so long as I may that's the certain of it and when I cannot live any longer I will do as I may That is my rest that is the rendezvous of it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "It is certain, corporal, that he is married to Nell Quickly; and certainly she did you wrong, for you were troth-plight to her.",
          "plainText": "It is certain corporal that he is married to Nell Quickly and certainly she did you wrong for you were trothplight to her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I cannot tell. Things must be as they may. Men may sleep, and they may have their throats about them at that time; and some say knives have edges. It must be as it may. Though patience be a tired mare, yet she will plod. There must be conclusions. Well, I cannot tell.",
          "plainText": "I cannot tell Things must be as they may Men may sleep and they may have their throats about them at that time and some say knives have edges It must be as it may Though patience be a tired mare yet she will plod There must be conclusions Well I cannot tell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-stage-002",
      "type": "stage",
      "text": "Enter Pistol and Hostess."
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Here comes Ancient Pistol and his wife. Good Corporal, be patient here. How now, mine host Pistol!",
          "plainText": "Here comes Ancient Pistol and his wife Good Corporal be patient here How now mine host Pistol",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Base tike, call'st thou me host?",
          "plainText": "Base tike call'st thou me host",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "Now, by this hand, I swear I scorn the term;",
          "plainText": "Now by this hand I swear I scorn the term",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "Nor shall my Nell keep lodgers.",
          "plainText": "Nor shall my Nell keep lodgers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "No, by my troth, not long; for we cannot lodge and board a dozen or fourteen gentlewomen that live honestly by the prick of their needles, but it will be thought we keep a bawdy house straight. [Nym and Pistol draw.] O well a day, Lady, if he be not drawn now! We shall see wilful adultery and murder committed.",
          "plainText": "No by my troth not long for we cannot lodge and board a dozen or fourteen gentlewomen that live honestly by the prick of their needles but it will be thought we keep a bawdy house straight Nym and Pistol draw O well a day Lady if he be not drawn now We shall see wilful adultery and murder committed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Good Lieutenant! good corporal! offer nothing here.",
          "plainText": "Good Lieutenant good corporal offer nothing here",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Pish!",
          "plainText": "Pish",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Pish for thee, Iceland dog! thou prick-ear'd cur of Iceland!",
          "plainText": "Pish for thee Iceland dog thou prickear'd cur of Iceland",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Good Corporal Nym, show thy valour, and put up your sword.",
          "plainText": "Good Corporal Nym show thy valour and put up your sword",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Will you shog off? I would have you solus.",
          "plainText": "Will you shog off I would have you solus",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Solus, egregious dog! O viper vile!",
          "plainText": "Solus egregious dog O viper vile",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "The solus in thy most mervailous face;",
          "plainText": "The solus in thy most mervailous face",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "The solus in thy teeth, and in thy throat,",
          "plainText": "The solus in thy teeth and in thy throat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "And in thy hateful lungs, yea, in thy maw, perdy,",
          "plainText": "And in thy hateful lungs yea in thy maw perdy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "And, which is worse, within thy nasty mouth!",
          "plainText": "And which is worse within thy nasty mouth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "I do retort the solus in thy bowels;",
          "plainText": "I do retort the solus in thy bowels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0025",
          "number": 25,
          "speechLineNumber": 7,
          "text": "For I can take, and Pistol's cock is up,",
          "plainText": "For I can take and Pistol's cock is up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0026",
          "number": 26,
          "speechLineNumber": 8,
          "text": "And flashing fire will follow.",
          "plainText": "And flashing fire will follow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "I am not Barbason; you cannot conjure me. I have an humour to knock you indifferently well. If you grow foul with me, Pistol, I will scour you with my rapier, as I may, in fair terms. If you would walk off, I would prick your guts a little, in good terms, as I may; and that's the humour of it.",
          "plainText": "I am not Barbason you cannot conjure me I have an humour to knock you indifferently well If you grow foul with me Pistol I will scour you with my rapier as I may in fair terms If you would walk off I would prick your guts a little in good terms as I may and that's the humour of it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "O braggart vile and damned furious wight!",
          "plainText": "O braggart vile and damned furious wight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "The grave doth gape, and doting death is near,",
          "plainText": "The grave doth gape and doting death is near",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "Therefore exhale.",
          "plainText": "Therefore exhale",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Hear me, hear me what I say. He that strikes the first stroke I'll run him up to the hilts, as I am a soldier.",
          "plainText": "Hear me hear me what I say He that strikes the first stroke I'll run him up to the hilts as I am a soldier",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-stage-003",
      "type": "stage",
      "text": "[Draws.]"
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "An oath of mickle might; and fury shall abate.",
          "plainText": "An oath of mickle might and fury shall abate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Give me thy fist, thy fore-foot to me give.",
          "plainText": "Give me thy fist thy forefoot to me give",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "Thy spirits are most tall.",
          "plainText": "Thy spirits are most tall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "I will cut thy throat, one time or other, in fair terms: that is the humour of it.",
          "plainText": "I will cut thy throat one time or other in fair terms that is the humour of it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "\"Couple a gorge!\"",
          "plainText": "Couple a gorge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "That is the word. I thee defy again.",
          "plainText": "That is the word I thee defy again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0038",
          "number": 38,
          "speechLineNumber": 3,
          "text": "O hound of Crete, think'st thou my spouse to get?",
          "plainText": "O hound of Crete think'st thou my spouse to get",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0039",
          "number": 39,
          "speechLineNumber": 4,
          "text": "No! to the spital go,",
          "plainText": "No to the spital go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0040",
          "number": 40,
          "speechLineNumber": 5,
          "text": "And from the powdering tub of infamy",
          "plainText": "And from the powdering tub of infamy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0041",
          "number": 41,
          "speechLineNumber": 6,
          "text": "Fetch forth the lazar kite of Cressid's kind,",
          "plainText": "Fetch forth the lazar kite of Cressid's kind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0042",
          "number": 42,
          "speechLineNumber": 7,
          "text": "Doll Tearsheet she by name, and her espouse.",
          "plainText": "Doll Tearsheet she by name and her espouse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0043",
          "number": 43,
          "speechLineNumber": 8,
          "text": "I have, and I will hold, the quondam Quickly",
          "plainText": "I have and I will hold the quondam Quickly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0044",
          "number": 44,
          "speechLineNumber": 9,
          "text": "For the only she; and pauca, there's enough.",
          "plainText": "For the only she and pauca there's enough",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0045",
          "number": 45,
          "speechLineNumber": 10,
          "text": "Go to.",
          "plainText": "Go to",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-stage-004",
      "type": "stage",
      "text": "Enter the Boy."
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Mine host Pistol, you must come to my master, and you, hostess. He is very sick, and would to bed. Good Bardolph, put thy face between his sheets, and do the office of a warming-pan. Faith, he's very ill.",
          "plainText": "Mine host Pistol you must come to my master and you hostess He is very sick and would to bed Good Bardolph put thy face between his sheets and do the office of a warmingpan Faith he's very ill",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Away, you rogue!",
          "plainText": "Away you rogue",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "By my troth, he'll yield the crow a pudding one of these days.",
          "plainText": "By my troth he'll yield the crow a pudding one of these days",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "The King has kill'd his heart.",
          "plainText": "The King has kill'd his heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "Good husband, come home presently.",
          "plainText": "Good husband come home presently",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-stage-005",
      "type": "stage",
      "text": "[Exeunt Hostess and Boy.]"
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Come, shall I make you two friends? We must to France together; why the devil should we keep knives to cut one another's throats?",
          "plainText": "Come shall I make you two friends We must to France together why the devil should we keep knives to cut one another's throats",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Let floods o'erswell, and fiends for food howl on!",
          "plainText": "Let floods o'erswell and fiends for food howl on",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "You'll pay me the eight shillings I won of you at betting?",
          "plainText": "You'll pay me the eight shillings I won of you at betting",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Base is the slave that pays.",
          "plainText": "Base is the slave that pays",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-031",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "That now I will have: that's the humour of it.",
          "plainText": "That now I will have that's the humour of it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-032",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "As manhood shall compound. Push home.",
          "plainText": "As manhood shall compound Push home",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-stage-006",
      "type": "stage",
      "text": "[They draw.]"
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-033",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "By this sword, he that makes the first thrust, I'll kill him; by this sword, I will.",
          "plainText": "By this sword he that makes the first thrust I'll kill him by this sword I will",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-034",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Sword is an oath, and oaths must have their course.",
          "plainText": "Sword is an oath and oaths must have their course",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-035",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Corporal Nym, and thou wilt be friends, be friends; an thou wilt not, why, then, be enemies with me too. Prithee, put up.",
          "plainText": "Corporal Nym and thou wilt be friends be friends an thou wilt not why then be enemies with me too Prithee put up",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-036",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "I shall have my eight shillings I won from you at betting?",
          "plainText": "I shall have my eight shillings I won from you at betting",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-037",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "A noble shalt thou have, and present pay;",
          "plainText": "A noble shalt thou have and present pay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "And liquor likewise will I give to thee,",
          "plainText": "And liquor likewise will I give to thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "And friendship shall combine, and brotherhood.",
          "plainText": "And friendship shall combine and brotherhood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0064",
          "number": 64,
          "speechLineNumber": 4,
          "text": "I'll live by Nym, and Nym shall live by me.",
          "plainText": "I'll live by Nym and Nym shall live by me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0065",
          "number": 65,
          "speechLineNumber": 5,
          "text": "Is not this just? For I shall sutler be",
          "plainText": "Is not this just For I shall sutler be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0066",
          "number": 66,
          "speechLineNumber": 6,
          "text": "Unto the camp, and profits will accrue.",
          "plainText": "Unto the camp and profits will accrue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0067",
          "number": 67,
          "speechLineNumber": 7,
          "text": "Give me thy hand.",
          "plainText": "Give me thy hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-038",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "I shall have my noble?",
          "plainText": "I shall have my noble",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-039",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "In cash most justly paid.",
          "plainText": "In cash most justly paid",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-040",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Well, then, that's the humour of't.",
          "plainText": "Well then that's the humour of't",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-stage-007",
      "type": "stage",
      "text": "Enter Hostess."
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-041",
      "type": "speech",
      "speaker": {
        "id": "hostess",
        "name": "HOSTESS",
        "displayName": "Hostess"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "As ever you come of women, come in quickly to Sir John.",
          "plainText": "As ever you come of women come in quickly to Sir John",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "Ah, poor heart! he is so shak'd of a burning quotidian tertian,",
          "plainText": "Ah poor heart he is so shak'd of a burning quotidian tertian",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "that it is most lamentable to behold. Sweet men, come to him.",
          "plainText": "that it is most lamentable to behold Sweet men come to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-042",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "The King hath run bad humours on the knight; that's the even of it.",
          "plainText": "The King hath run bad humours on the knight that's the even of it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-043",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Nym, thou hast spoke the right.",
          "plainText": "Nym thou hast spoke the right",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-2-1-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "His heart is fracted and corroborate.",
          "plainText": "His heart is fracted and corroborate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-2-1-speech-044",
      "type": "speech",
      "speaker": {
        "id": "nym",
        "name": "NYM",
        "displayName": "Nym"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-2-1-line-0077",
          "number": 77,
