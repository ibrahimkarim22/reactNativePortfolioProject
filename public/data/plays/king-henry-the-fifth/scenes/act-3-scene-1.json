    "label": "Act 3, Scene 1",
    "title": "SCENE I. France. Before Harfleur.",
    "location": "France. Before Harfleur.",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "king-henry-the-fifth-3-1-stage-001",
      "type": "stage",
      "text": "Alarum. Enter King Henry, Exeter, Bedford, Gloucester and Soldiers, with scaling-ladders."
    },
    {
      "id": "king-henry-the-fifth-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Once more unto the breach, dear friends, once more,",
          "plainText": "Once more unto the breach dear friends once more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Or close the wall up with our English dead.",
          "plainText": "Or close the wall up with our English dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "In peace there's nothing so becomes a man",
          "plainText": "In peace there's nothing so becomes a man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "As modest stillness and humility;",
          "plainText": "As modest stillness and humility",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "But when the blast of war blows in our ears,",
          "plainText": "But when the blast of war blows in our ears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Then imitate the action of the tiger;",
          "plainText": "Then imitate the action of the tiger",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Stiffen the sinews, summon up the blood,",
          "plainText": "Stiffen the sinews summon up the blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Disguise fair nature with hard-favour'd rage;",
          "plainText": "Disguise fair nature with hardfavour'd rage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Then lend the eye a terrible aspect;",
          "plainText": "Then lend the eye a terrible aspect",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Let it pry through the portage of the head",
          "plainText": "Let it pry through the portage of the head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Like the brass cannon; let the brow o'erwhelm it",
          "plainText": "Like the brass cannon let the brow o'erwhelm it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "As fearfully as does a galled rock",
          "plainText": "As fearfully as does a galled rock",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "O'erhang and jutty his confounded base,",
          "plainText": "O'erhang and jutty his confounded base",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Swill'd with the wild and wasteful ocean.",
          "plainText": "Swill'd with the wild and wasteful ocean",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "Now set the teeth and stretch the nostril wide,",
          "plainText": "Now set the teeth and stretch the nostril wide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "Hold hard the breath, and bend up every spirit",
          "plainText": "Hold hard the breath and bend up every spirit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "To his full height. On, on, you noblest English,",
          "plainText": "To his full height On on you noblest English",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Whose blood is fet from fathers of war-proof!",
          "plainText": "Whose blood is fet from fathers of warproof",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "Fathers that, like so many Alexanders,",
          "plainText": "Fathers that like so many Alexanders",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "Have in these parts from morn till even fought,",
          "plainText": "Have in these parts from morn till even fought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "And sheath'd their swords for lack of argument.",
          "plainText": "And sheath'd their swords for lack of argument",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "Dishonour not your mothers; now attest",
          "plainText": "Dishonour not your mothers now attest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "That those whom you call'd fathers did beget you.",
          "plainText": "That those whom you call'd fathers did beget you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "Be copy now to men of grosser blood,",
          "plainText": "Be copy now to men of grosser blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 25,
          "text": "And teach them how to war. And you, good yeomen,",
          "plainText": "And teach them how to war And you good yeomen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 26,
          "text": "Whose limbs were made in England, show us here",
          "plainText": "Whose limbs were made in England show us here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 27,
          "text": "The mettle of your pasture; let us swear",
          "plainText": "The mettle of your pasture let us swear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0028",
          "number": 28,
          "speechLineNumber": 28,
          "text": "That you are worth your breeding, which I doubt not;",
          "plainText": "That you are worth your breeding which I doubt not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0029",
          "number": 29,
          "speechLineNumber": 29,
          "text": "For there is none of you so mean and base,",
          "plainText": "For there is none of you so mean and base",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0030",
          "number": 30,
          "speechLineNumber": 30,
          "text": "That hath not noble lustre in your eyes.",
          "plainText": "That hath not noble lustre in your eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0031",
          "number": 31,
          "speechLineNumber": 31,
          "text": "I see you stand like greyhounds in the slips,",
          "plainText": "I see you stand like greyhounds in the slips",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0032",
          "number": 32,
          "speechLineNumber": 32,
          "text": "Straining upon the start. The game's afoot!",
          "plainText": "Straining upon the start The game's afoot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0033",
          "number": 33,
          "speechLineNumber": 33,
          "text": "Follow your spirit, and upon this charge",
          "plainText": "Follow your spirit and upon this charge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-1-line-0034",
          "number": 34,
          "speechLineNumber": 34,
          "text": "Cry, \"God for Harry! England and Saint George!\"",
          "plainText": "Cry God for Harry England and Saint George",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-3-1-stage-002",
      "type": "stage",
      "text": "[Exeunt. Alarum, and chambers go off.]"
    }
  ]
}