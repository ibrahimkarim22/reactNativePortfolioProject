    "title": "SCENE III. Before the gates.",
    "location": "Before the gates.",
    "orderInPlay": 9
  },
  "content": [
    {
      "id": "king-henry-the-fifth-3-3-stage-001",
      "type": "stage",
      "text": "The Governor and some citizens on the walls; the English forces below. Enter King Henry and his train."
    },
    {
      "id": "king-henry-the-fifth-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "How yet resolves the governor of the town?",
          "plainText": "How yet resolves the governor of the town",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "This is the latest parle we will admit;",
          "plainText": "This is the latest parle we will admit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Therefore to our best mercy give yourselves,",
          "plainText": "Therefore to our best mercy give yourselves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Or like to men proud of destruction",
          "plainText": "Or like to men proud of destruction",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Defy us to our worst; for, as I am a soldier,",
          "plainText": "Defy us to our worst for as I am a soldier",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "A name that in my thoughts becomes me best,",
          "plainText": "A name that in my thoughts becomes me best",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "If I begin the battery once again,",
          "plainText": "If I begin the battery once again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "I will not leave the half-achieved Harfleur",
          "plainText": "I will not leave the halfachieved Harfleur",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Till in her ashes she lie buried.",
          "plainText": "Till in her ashes she lie buried",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "The gates of mercy shall be all shut up,",
          "plainText": "The gates of mercy shall be all shut up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "And the flesh'd soldier, rough and hard of heart,",
          "plainText": "And the flesh'd soldier rough and hard of heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "In liberty of bloody hand shall range",
          "plainText": "In liberty of bloody hand shall range",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "With conscience wide as hell, mowing like grass",
          "plainText": "With conscience wide as hell mowing like grass",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Your fresh fair virgins and your flow'ring infants.",
          "plainText": "Your fresh fair virgins and your flow'ring infants",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "What is it then to me, if impious War,",
          "plainText": "What is it then to me if impious War",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "Array'd in flames like to the prince of fiends,",
          "plainText": "Array'd in flames like to the prince of fiends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "Do with his smirch'd complexion all fell feats",
          "plainText": "Do with his smirch'd complexion all fell feats",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Enlink'd to waste and desolation?",
          "plainText": "Enlink'd to waste and desolation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "What is't to me, when you yourselves are cause,",
          "plainText": "What is't to me when you yourselves are cause",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "If your pure maidens fall into the hand",
          "plainText": "If your pure maidens fall into the hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "Of hot and forcing violation?",
          "plainText": "Of hot and forcing violation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "What rein can hold licentious wickedness",
          "plainText": "What rein can hold licentious wickedness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "When down the hill he holds his fierce career?",
          "plainText": "When down the hill he holds his fierce career",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "We may as bootless spend our vain command",
          "plainText": "We may as bootless spend our vain command",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 25,
          "text": "Upon the enraged soldiers in their spoil",
          "plainText": "Upon the enraged soldiers in their spoil",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 26,
          "text": "As send precepts to the leviathan",
          "plainText": "As send precepts to the leviathan",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 27,
          "text": "To come ashore. Therefore, you men of Harfleur,",
          "plainText": "To come ashore Therefore you men of Harfleur",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 28,
          "text": "Take pity of your town and of your people,",
          "plainText": "Take pity of your town and of your people",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0029",
          "number": 29,
          "speechLineNumber": 29,
          "text": "Whiles yet my soldiers are in my command,",
          "plainText": "Whiles yet my soldiers are in my command",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0030",
          "number": 30,
          "speechLineNumber": 30,
          "text": "Whiles yet the cool and temperate wind of grace",
          "plainText": "Whiles yet the cool and temperate wind of grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0031",
          "number": 31,
          "speechLineNumber": 31,
          "text": "O'erblows the filthy and contagious clouds",
          "plainText": "O'erblows the filthy and contagious clouds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0032",
          "number": 32,
          "speechLineNumber": 32,
          "text": "Of heady murder, spoil, and villainy.",
          "plainText": "Of heady murder spoil and villainy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0033",
          "number": 33,
          "speechLineNumber": 33,
          "text": "If not, why, in a moment look to see",
          "plainText": "If not why in a moment look to see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0034",
          "number": 34,
          "speechLineNumber": 34,
          "text": "The blind and bloody soldier with foul hand",
          "plainText": "The blind and bloody soldier with foul hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0035",
          "number": 35,
          "speechLineNumber": 35,
          "text": "Defile the locks of your shrill-shrieking daughters;",
          "plainText": "Defile the locks of your shrillshrieking daughters",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0036",
          "number": 36,
          "speechLineNumber": 36,
          "text": "Your fathers taken by the silver beards,",
          "plainText": "Your fathers taken by the silver beards",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0037",
          "number": 37,
          "speechLineNumber": 37,
          "text": "And their most reverend heads dash'd to the walls;",
          "plainText": "And their most reverend heads dash'd to the walls",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0038",
          "number": 38,
          "speechLineNumber": 38,
          "text": "Your naked infants spitted upon pikes,",
          "plainText": "Your naked infants spitted upon pikes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0039",
          "number": 39,
          "speechLineNumber": 39,
          "text": "Whiles the mad mothers with their howls confus'd",
          "plainText": "Whiles the mad mothers with their howls confus'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0040",
          "number": 40,
          "speechLineNumber": 40,
          "text": "Do break the clouds, as did the wives of Jewry",
          "plainText": "Do break the clouds as did the wives of Jewry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0041",
          "number": 41,
          "speechLineNumber": 41,
          "text": "At Herod's bloody-hunting slaughtermen.",
          "plainText": "At Herod's bloodyhunting slaughtermen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0042",
          "number": 42,
          "speechLineNumber": 42,
          "text": "What say you? Will you yield, and this avoid,",
          "plainText": "What say you Will you yield and this avoid",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0043",
          "number": 43,
          "speechLineNumber": 43,
          "text": "Or, guilty in defence, be thus destroy'd?",
          "plainText": "Or guilty in defence be thus destroy'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "governor",
        "name": "GOVERNOR",
        "displayName": "Governor"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-3-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Our expectation hath this day an end.",
          "plainText": "Our expectation hath this day an end",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "The Dauphin, whom of succours we entreated,",
          "plainText": "The Dauphin whom of succours we entreated",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "Returns us that his powers are yet not ready",
          "plainText": "Returns us that his powers are yet not ready",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "To raise so great a siege. Therefore, great King,",
          "plainText": "To raise so great a siege Therefore great King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0048",
          "number": 48,
          "speechLineNumber": 5,
          "text": "We yield our town and lives to thy soft mercy.",
          "plainText": "We yield our town and lives to thy soft mercy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0049",
          "number": 49,
          "speechLineNumber": 6,
          "text": "Enter our gates; dispose of us and ours;",
          "plainText": "Enter our gates dispose of us and ours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0050",
          "number": 50,
          "speechLineNumber": 7,
          "text": "For we no longer are defensible.",
          "plainText": "For we no longer are defensible",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-3-3-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Open your gates. Come, uncle Exeter,",
          "plainText": "Open your gates Come uncle Exeter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "Go you and enter Harfleur; there remain,",
          "plainText": "Go you and enter Harfleur there remain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "And fortify it strongly 'gainst the French.",
          "plainText": "And fortify it strongly 'gainst the French",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "Use mercy to them all. For us, dear uncle,",
          "plainText": "Use mercy to them all For us dear uncle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0055",
          "number": 55,
          "speechLineNumber": 5,
          "text": "The winter coming on, and sickness growing",
          "plainText": "The winter coming on and sickness growing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-3-3-line-0056",
          "number": 56,
          "speechLineNumber": 6,
          "text": "Upon our soldiers, we will retire to Calais.",
          "plainText": "Upon our soldiers we will retire to Calais",
          "lineType": "verse",
          "lineTypeDetection": "auto",
