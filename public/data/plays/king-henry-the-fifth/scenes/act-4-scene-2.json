  "scene": {
    "id": "king-henry-the-fifth-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. The French camp.",
    "location": "The French camp.",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "king-henry-the-fifth-4-2-stage-001",
      "type": "stage",
      "text": "Enter the Dauphin, Orleans, Rambures and others."
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "orleans",
        "name": "ORLEANS",
        "displayName": "Orleans"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The sun doth gild our armour; up, my lords!",
          "plainText": "The sun doth gild our armour up my lords",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "dauphin",
        "name": "DAUPHIN",
        "displayName": "Dauphin"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Monte à cheval! My horse, varlet! laquais, ha!",
          "plainText": "Monte cheval My horse varlet laquais ha",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "orleans",
        "name": "ORLEANS",
        "displayName": "Orleans"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "O brave spirit!",
          "plainText": "O brave spirit",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "dauphin",
        "name": "DAUPHIN",
        "displayName": "Dauphin"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Via, les eaux et terre!",
          "plainText": "Via les eaux et terre",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "orleans",
        "name": "ORLEANS",
        "displayName": "Orleans"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Rien puis? L'air et feu?",
          "plainText": "Rien puis L'air et feu",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "dauphin",
        "name": "DAUPHIN",
        "displayName": "Dauphin"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Cieux, cousin Orleans.",
          "plainText": "Cieux cousin Orleans",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-stage-002",
      "type": "stage",
      "text": "Enter Constable."
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "constable",
        "name": "CONSTABLE",
        "displayName": "Constable"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Hark, how our steeds for present service neigh!",
          "plainText": "Hark how our steeds for present service neigh",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "dauphin",
        "name": "DAUPHIN",
        "displayName": "Dauphin"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Mount them, and make incision in their hides,",
          "plainText": "Mount them and make incision in their hides",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "That their hot blood may spin in English eyes,",
          "plainText": "That their hot blood may spin in English eyes",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "And dout them with superfluous courage, ha!",
          "plainText": "And dout them with superfluous courage ha",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "rambures",
        "name": "RAMBURES",
        "displayName": "Rambures"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "What, will you have them weep our horses' blood?",
          "plainText": "What will you have them weep our horses' blood",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "How shall we, then, behold their natural tears?",
          "plainText": "How shall we then behold their natural tears",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-stage-003",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "The English are embattl'd, you French peers.",
          "plainText": "The English are embattl'd you French peers",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "constable",
        "name": "CONSTABLE",
        "displayName": "Constable"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "To horse, you gallant princes! straight to horse!",
          "plainText": "To horse you gallant princes straight to horse",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Do but behold yon poor and starved band,",
          "plainText": "Do but behold yon poor and starved band",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "And your fair show shall suck away their souls,",
          "plainText": "And your fair show shall suck away their souls",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "Leaving them but the shales and husks of men.",
          "plainText": "Leaving them but the shales and husks of men",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "There is not work enough for all our hands;",
          "plainText": "There is not work enough for all our hands",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 6,
          "text": "Scarce blood enough in all their sickly veins",
          "plainText": "Scarce blood enough in all their sickly veins",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 7,
          "text": "To give each naked curtle-axe a stain,",
          "plainText": "To give each naked curtleaxe a stain",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 8,
          "text": "That our French gallants shall today draw out,",
          "plainText": "That our French gallants shall today draw out",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 9,
          "text": "And sheathe for lack of sport. Let us but blow on them,",
          "plainText": "And sheathe for lack of sport Let us but blow on them",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 10,
          "text": "The vapour of our valour will o'erturn them.",
          "plainText": "The vapour of our valour will o'erturn them",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 11,
          "text": "'Tis positive 'gainst all exceptions, lords,",
          "plainText": "'Tis positive 'gainst all exceptions lords",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 12,
          "text": "That our superfluous lackeys and our peasants,",
          "plainText": "That our superfluous lackeys and our peasants",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 13,
          "text": "Who in unnecessary action swarm",
          "plainText": "Who in unnecessary action swarm",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 14,
          "text": "About our squares of battle, were enough",
          "plainText": "About our squares of battle were enough",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 15,
          "text": "To purge this field of such a hilding foe,",
          "plainText": "To purge this field of such a hilding foe",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 16,
          "text": "Though we upon this mountain's basis by",
          "plainText": "Though we upon this mountain's basis by",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 17,
          "text": "Took stand for idle speculation,",
          "plainText": "Took stand for idle speculation",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0031",
          "number": 31,
          "speechLineNumber": 18,
          "text": "But that our honours must not. What's to say?",
          "plainText": "But that our honours must not What's to say",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0032",
          "number": 32,
          "speechLineNumber": 19,
          "text": "A very little little let us do,",
          "plainText": "A very little little let us do",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0033",
          "number": 33,
          "speechLineNumber": 20,
          "text": "And all is done. Then let the trumpets sound",
          "plainText": "And all is done Then let the trumpets sound",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0034",
          "number": 34,
          "speechLineNumber": 21,
          "text": "The tucket sonance and the note to mount;",
          "plainText": "The tucket sonance and the note to mount",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0035",
          "number": 35,
          "speechLineNumber": 22,
          "text": "For our approach shall so much dare the field",
          "plainText": "For our approach shall so much dare the field",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0036",
          "number": 36,
          "speechLineNumber": 23,
          "text": "That England shall crouch down in fear and yield.",
          "plainText": "That England shall crouch down in fear and yield",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-stage-004",
      "type": "stage",
      "text": "Enter Grandpré."
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "constable",
        "name": "CONSTABLE",
        "displayName": "Constable"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "They have said their prayers, and they stay for death.",
          "plainText": "They have said their prayers and they stay for death",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "dauphin",
        "name": "DAUPHIN",
        "displayName": "Dauphin"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Shall we go send them dinners and fresh suits",
          "plainText": "Shall we go send them dinners and fresh suits",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "And give their fasting horses provender,",
          "plainText": "And give their fasting horses provender",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "And after fight with them?",
          "plainText": "And after fight with them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "constable",
        "name": "CONSTABLE",
        "displayName": "Constable"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-2-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "I stay but for my guard; on to the field!",
          "plainText": "I stay but for my guard on to the field",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "I will the banner from a trumpet take,",
          "plainText": "I will the banner from a trumpet take",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "And use it for my haste. Come, come, away!",
          "plainText": "And use it for my haste Come come away",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-2-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "The sun is high, and we outwear the day.",
          "plainText": "The sun is high and we outwear the day",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-2-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}