    "title": "SCENE IV. The field of battle.",
    "location": "The field of battle.",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "king-henry-the-fifth-4-4-stage-001",
      "type": "stage",
      "text": "Alarum. Excursions. Enter Pistol, French Soldier and Boy."
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Yield, cur!",
          "plainText": "Yield cur",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "french-soldier",
        "name": "FRENCH SOLDIER",
        "displayName": "French Soldier"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Je pense que vous êtes le gentilhomme de bonne qualité.",
          "plainText": "Je pense que vous tes le gentilhomme de bonne qualit",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Qualité? Caleno custore me!",
          "plainText": "Qualit Caleno custore me",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Art thou a gentleman?",
          "plainText": "Art thou a gentleman",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "What is thy name? Discuss.",
          "plainText": "What is thy name Discuss",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "french-soldier",
        "name": "FRENCH SOLDIER",
        "displayName": "French Soldier"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "O Seigneur Dieu!",
          "plainText": "O Seigneur Dieu",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "O, Signieur Dew should be a gentleman.",
          "plainText": "O Signieur Dew should be a gentleman",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Perpend my words, O Signieur Dew, and mark:",
          "plainText": "Perpend my words O Signieur Dew and mark",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "O Signieur Dew, thou diest on point of fox,",
          "plainText": "O Signieur Dew thou diest on point of fox",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "Except, O signieur, thou do give to me",
          "plainText": "Except O signieur thou do give to me",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "Egregious ransom.",
          "plainText": "Egregious ransom",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "french-soldier",
        "name": "FRENCH SOLDIER",
        "displayName": "French Soldier"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "O, prenez miséricorde! Ayez pitié de moi!",
          "plainText": "O prenez misricorde Ayez piti de moi",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Moy shall not serve; I will have forty moys,",
          "plainText": "Moy shall not serve I will have forty moys",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Or I will fetch thy rim out at thy throat",
          "plainText": "Or I will fetch thy rim out at thy throat",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "In drops of crimson blood.",
          "plainText": "In drops of crimson blood",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "french-soldier",
        "name": "FRENCH SOLDIER",
        "displayName": "French Soldier"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Est-il impossible d'échapper la force de ton bras?",
          "plainText": "Estil impossible d'chapper la force de ton bras",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Brass, cur!",
          "plainText": "Brass cur",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Thou damned and luxurious mountain goat,",
          "plainText": "Thou damned and luxurious mountain goat",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Offer'st me brass?",
          "plainText": "Offer'st me brass",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "french-soldier",
        "name": "FRENCH SOLDIER",
        "displayName": "French Soldier"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "O pardonnez-moi!",
          "plainText": "O pardonnezmoi",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Say'st thou me so? Is that a ton of moys?",
          "plainText": "Say'st thou me so Is that a ton of moys",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "Come hither, boy; ask me this slave in French",
          "plainText": "Come hither boy ask me this slave in French",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "What is his name.",
          "plainText": "What is his name",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Écoutez. Comment êtes-vous appelé?",
          "plainText": "coutez Comment tesvous appel",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "french-soldier",
        "name": "FRENCH SOLDIER",
        "displayName": "French Soldier"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Monsieur le Fer.",
          "plainText": "Monsieur le Fer",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "He says his name is Master Fer.",
          "plainText": "He says his name is Master Fer",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Master Fer! I'll fer him, and firk him, and ferret him.",
          "plainText": "Master Fer I'll fer him and firk him and ferret him",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Discuss the same in French unto him.",
          "plainText": "Discuss the same in French unto him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I do not know the French for fer, and ferret, and firk.",
          "plainText": "I do not know the French for fer and ferret and firk",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Bid him prepare; for I will cut his throat.",
          "plainText": "Bid him prepare for I will cut his throat",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "french-soldier",
        "name": "FRENCH SOLDIER",
        "displayName": "French Soldier"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Que dit-il, monsieur?",
          "plainText": "Que ditil monsieur",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Il me commande à vous dire que vous faites vous prêt, car ce soldat ici est disposé tout à cette heure de couper votre gorge.",
          "plainText": "Il me commande vous dire que vous faites vous prt car ce soldat ici est dispos tout cette heure de couper votre gorge",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Owy, cuppele gorge, permafoy,",
          "plainText": "Owy cuppele gorge permafoy",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Peasant, unless thou give me crowns, brave crowns;",
          "plainText": "Peasant unless thou give me crowns brave crowns",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Or mangled shalt thou be by this my sword.",
          "plainText": "Or mangled shalt thou be by this my sword",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "french-soldier",
        "name": "FRENCH SOLDIER",
        "displayName": "French Soldier"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "O, je vous supplie, pour l'amour de Dieu, me pardonner! Je suis le gentilhomme de bonne maison; gardez ma vie, et je vous donnerai deux cents écus.",
          "plainText": "O je vous supplie pour l'amour de Dieu me pardonner Je suis le gentilhomme de bonne maison gardez ma vie et je vous donnerai deux cents cus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "What are his words?",
          "plainText": "What are his words",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "He prays you to save his life. He is a gentleman of a good house; and for his ransom he will give you two hundred crowns.",
          "plainText": "He prays you to save his life He is a gentleman of a good house and for his ransom he will give you two hundred crowns",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Tell him my fury shall abate, and I",
          "plainText": "Tell him my fury shall abate and I",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "The crowns will take.",
          "plainText": "The crowns will take",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-025",
      "type": "speech",
      "speaker": {
        "id": "french-soldier",
        "name": "FRENCH SOLDIER",
        "displayName": "French Soldier"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Petit monsieur, que dit-il?",
          "plainText": "Petit monsieur que ditil",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-026",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Encore qu'il est contre son jurement de pardonner aucun prisonnier; néanmoins, pour les écus que vous lui avez promis, il est content à vous donner la liberté, le franchisement.",
          "plainText": "Encore qu'il est contre son jurement de pardonner aucun prisonnier nanmoins pour les cus que vous lui avez promis il est content vous donner la libert le franchisement",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-027",
      "type": "speech",
      "speaker": {
        "id": "french-soldier",
        "name": "FRENCH SOLDIER",
        "displayName": "French Soldier"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Sur mes genoux je vous donne mille remerciements; et je m'estime heureux que je suis tombé entre les mains d'un chevalier, je pense, le plus brave, vaillant, et très distingué seigneur d'Angleterre.",
          "plainText": "Sur mes genoux je vous donne mille remerciements et je m'estime heureux que je suis tomb entre les mains d'un chevalier je pense le plus brave vaillant et trs distingu seigneur d'Angleterre",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-028",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Expound unto me, boy.",
          "plainText": "Expound unto me boy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-029",
      "type": "speech",
      "speaker": {
        "id": "boy",
        "name": "BOY",
        "displayName": "Boy"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "He gives you upon his knees, a thousand thanks; and he esteems himself happy that he hath fallen into the hands of one, as he thinks, the most brave, valorous, and thrice-worthy seigneur of England.",
          "plainText": "He gives you upon his knees a thousand thanks and he esteems himself happy that he hath fallen into the hands of one as he thinks the most brave valorous and thriceworthy seigneur of England",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-4-speech-030",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-4-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "As I suck blood, I will some mercy show.",
          "plainText": "As I suck blood I will some mercy show",
          "lineType": "verse"
        },
        {
          "id": "king-henry-the-fifth-4-4-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Follow me!",
