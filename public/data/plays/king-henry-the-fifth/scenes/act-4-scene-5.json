  "content": [
    {
      "id": "king-henry-the-fifth-4-5-stage-001",
      "type": "stage",
      "text": "Enter Constable, Orleans, Bourbon, Dauphin and Rambures."
    },
    {
      "id": "king-henry-the-fifth-4-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "constable",
        "name": "CONSTABLE",
        "displayName": "Constable"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "O diable!",
          "plainText": "O diable",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "orleans",
        "name": "ORLEANS",
        "displayName": "Orleans"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "O Seigneur! le jour est perdu, tout est perdu!",
          "plainText": "O Seigneur le jour est perdu tout est perdu",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "dauphin",
        "name": "DAUPHIN",
        "displayName": "Dauphin"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Mort de ma vie! all is confounded, all!",
          "plainText": "Mort de ma vie all is confounded all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Reproach and everlasting shame",
          "plainText": "Reproach and everlasting shame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Sits mocking in our plumes.",
          "plainText": "Sits mocking in our plumes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-5-stage-002",
      "type": "stage",
      "text": "[A short alarum.]"
    },
    {
      "id": "king-henry-the-fifth-4-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "constable",
        "name": "CONSTABLE",
        "displayName": "Constable"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Why, all our ranks are broke.",
          "plainText": "Why all our ranks are broke",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "dauphin",
        "name": "DAUPHIN",
        "displayName": "Dauphin"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "O perdurable shame! Let's stab ourselves,",
          "plainText": "O perdurable shame Let's stab ourselves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Be these the wretches that we play'd at dice for?",
          "plainText": "Be these the wretches that we play'd at dice for",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "orleans",
        "name": "ORLEANS",
        "displayName": "Orleans"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Is this the king we sent to for his ransom?",
          "plainText": "Is this the king we sent to for his ransom",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "bourbon",
        "name": "BOURBON",
        "displayName": "Bourbon"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Shame and eternal shame, nothing but shame!",
          "plainText": "Shame and eternal shame nothing but shame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "Let's die in honour! Once more back again!",
          "plainText": "Let's die in honour Once more back again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "And he that will not follow Bourbon now,",
          "plainText": "And he that will not follow Bourbon now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "Let him go hence, and with his cap in hand,",
          "plainText": "Let him go hence and with his cap in hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0014",
          "number": 14,
          "speechLineNumber": 5,
          "text": "Like a base pandar, hold the chamber door",
          "plainText": "Like a base pandar hold the chamber door",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0015",
          "number": 15,
          "speechLineNumber": 6,
          "text": "Whilst by a slave, no gentler than my dog,",
          "plainText": "Whilst by a slave no gentler than my dog",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0016",
          "number": 16,
          "speechLineNumber": 7,
          "text": "His fairest daughter is contaminated.",
          "plainText": "His fairest daughter is contaminated",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "constable",
        "name": "CONSTABLE",
        "displayName": "Constable"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Disorder, that hath spoil'd us, friend us now!",
          "plainText": "Disorder that hath spoil'd us friend us now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Let us on heaps go offer up our lives.",
          "plainText": "Let us on heaps go offer up our lives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "orleans",
        "name": "ORLEANS",
        "displayName": "Orleans"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "We are enough yet living in the field",
          "plainText": "We are enough yet living in the field",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "To smother up the English in our throngs,",
          "plainText": "To smother up the English in our throngs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "If any order might be thought upon.",
          "plainText": "If any order might be thought upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "bourbon",
        "name": "BOURBON",
        "displayName": "Bourbon"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-5-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "The devil take order now! I'll to the throng.",
          "plainText": "The devil take order now I'll to the throng",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-5-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Let life be short, else shame will be too long.",
          "plainText": "Let life be short else shame will be too long",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-5-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}