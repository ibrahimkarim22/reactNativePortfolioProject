  },
  "content": [
    {
      "id": "king-henry-the-fifth-4-8-stage-001",
      "type": "stage",
      "text": "Enter Gower and Williams."
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-001",
      "type": "speech",
      "speaker": {
        "id": "williams",
        "name": "WILLIAMS",
        "displayName": "Williams"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I warrant it is to knight you, Captain.",
          "plainText": "I warrant it is to knight you Captain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-stage-002",
      "type": "stage",
      "text": "Enter Fluellen."
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-002",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "God's will and his pleasure, captain, I beseech you now, come apace to the King. There is more good toward you peradventure than is in your knowledge to dream of.",
          "plainText": "God's will and his pleasure captain I beseech you now come apace to the King There is more good toward you peradventure than is in your knowledge to dream of",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-003",
      "type": "speech",
      "speaker": {
        "id": "williams",
        "name": "WILLIAMS",
        "displayName": "Williams"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Sir, know you this glove?",
          "plainText": "Sir know you this glove",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-004",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Know the glove! I know the glove is a glove.",
          "plainText": "Know the glove I know the glove is a glove",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-005",
      "type": "speech",
      "speaker": {
        "id": "williams",
        "name": "WILLIAMS",
        "displayName": "Williams"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "I know this; and thus I challenge it.",
          "plainText": "I know this and thus I challenge it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-stage-003",
      "type": "stage",
      "text": "[Strikes him.]"
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-006",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "'Sblood! an arrant traitor as any is in the universal world, or in France, or in England!",
          "plainText": "'Sblood an arrant traitor as any is in the universal world or in France or in England",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-007",
      "type": "speech",
      "speaker": {
        "id": "gower",
        "name": "GOWER",
        "displayName": "Gower"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "How now, sir! you villain!",
          "plainText": "How now sir you villain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-008",
      "type": "speech",
      "speaker": {
        "id": "williams",
        "name": "WILLIAMS",
        "displayName": "Williams"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Do you think I'll be forsworn?",
          "plainText": "Do you think I'll be forsworn",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-009",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Stand away, Captain Gower. I will give treason his payment into plows, I warrant you.",
          "plainText": "Stand away Captain Gower I will give treason his payment into plows I warrant you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-010",
      "type": "speech",
      "speaker": {
        "id": "williams",
        "name": "WILLIAMS",
        "displayName": "Williams"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "I am no traitor.",
          "plainText": "I am no traitor",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-011",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "That's a lie in thy throat. I charge you in his Majesty's name, apprehend him; he's a friend of the Duke Alençon's.",
          "plainText": "That's a lie in thy throat I charge you in his Majesty's name apprehend him he's a friend of the Duke Alenon's",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-stage-004",
      "type": "stage",
      "text": "Enter Warwick and Gloucester."
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-012",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "How now, how now! what's the matter?",
          "plainText": "How now how now what's the matter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-013",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "My lord of Warwick, here is—praised be God for it!—a most contagious treason come to light, look you, as you shall desire in a summer's day. Here is his Majesty.",
          "plainText": "My lord of Warwick here ispraised be God for ita most contagious treason come to light look you as you shall desire in a summer's day Here is his Majesty",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-stage-005",
      "type": "stage",
      "text": "Enter King Henry and Exeter."
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-014",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "How now! what's the matter?",
          "plainText": "How now what's the matter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-015",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "My liege, here is a villain and a traitor, that, look your Grace, has struck the glove which your Majesty is take out of the helmet of Alençon.",
          "plainText": "My liege here is a villain and a traitor that look your Grace has struck the glove which your Majesty is take out of the helmet of Alenon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-016",
      "type": "speech",
      "speaker": {
        "id": "williams",
        "name": "WILLIAMS",
        "displayName": "Williams"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "My liege, this was my glove; here is the fellow of it; and he that I gave it to in change promis'd to wear it in his cap. I promis'd to strike him, if he did. I met this man with my glove in his cap, and I have been as good as my word.",
          "plainText": "My liege this was my glove here is the fellow of it and he that I gave it to in change promis'd to wear it in his cap I promis'd to strike him if he did I met this man with my glove in his cap and I have been as good as my word",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-017",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Your Majesty hear now, saving your Majesty's manhood, what an arrant, rascally, beggarly, lousy knave it is. I hope your Majesty is pear me testimony and witness, and will avouchment, that this is the glove of Alençon that your Majesty is give me; in your conscience, now?",
          "plainText": "Your Majesty hear now saving your Majesty's manhood what an arrant rascally beggarly lousy knave it is I hope your Majesty is pear me testimony and witness and will avouchment that this is the glove of Alenon that your Majesty is give me in your conscience now",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-018",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Give me thy glove, soldier. Look, here is the fellow of it.",
          "plainText": "Give me thy glove soldier Look here is the fellow of it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "'Twas I, indeed, thou promisedst to strike;",
          "plainText": "'Twas I indeed thou promisedst to strike",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "And thou hast given me most bitter terms.",
          "plainText": "And thou hast given me most bitter terms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-019",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "An it please your Majesty, let his neck answer for it, if there is any martial law in the world.",
          "plainText": "An it please your Majesty let his neck answer for it if there is any martial law in the world",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-020",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "How canst thou make me satisfaction?",
          "plainText": "How canst thou make me satisfaction",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-021",
      "type": "speech",
      "speaker": {
        "id": "williams",
        "name": "WILLIAMS",
        "displayName": "Williams"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "All offences, my lord, come from the heart. Never came any from mine that might offend your Majesty.",
          "plainText": "All offences my lord come from the heart Never came any from mine that might offend your Majesty",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-022",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "It was ourself thou didst abuse.",
          "plainText": "It was ourself thou didst abuse",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-023",
      "type": "speech",
      "speaker": {
        "id": "williams",
        "name": "WILLIAMS",
        "displayName": "Williams"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Your Majesty came not like yourself. You appear'd to me but as a common man; witness the night, your garments, your lowliness; and what your Highness suffer'd under that shape, I beseech you take it for your own fault and not mine; for had you been as I took you for, I made no offence; therefore, I beseech your Highness, pardon me.",
          "plainText": "Your Majesty came not like yourself You appear'd to me but as a common man witness the night your garments your lowliness and what your Highness suffer'd under that shape I beseech you take it for your own fault and not mine for had you been as I took you for I made no offence therefore I beseech your Highness pardon me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-024",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Here, uncle Exeter, fill this glove with crowns,",
          "plainText": "Here uncle Exeter fill this glove with crowns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "And give it to this fellow. Keep it, fellow;",
          "plainText": "And give it to this fellow Keep it fellow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "And wear it for an honour in thy cap",
          "plainText": "And wear it for an honour in thy cap",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "Till I do challenge it. Give him his crowns;",
          "plainText": "Till I do challenge it Give him his crowns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0030",
          "number": 30,
          "speechLineNumber": 5,
          "text": "And, captain, you must needs be friends with him.",
          "plainText": "And captain you must needs be friends with him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-025",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "By this day and this light, the fellow has mettle enough in his belly. Hold, there is twelve pence for you; and I pray you to serve God, and keep you out of prawls, and prabbles, and quarrels, and dissensions, and, I warrant you, it is the better for you.",
          "plainText": "By this day and this light the fellow has mettle enough in his belly Hold there is twelve pence for you and I pray you to serve God and keep you out of prawls and prabbles and quarrels and dissensions and I warrant you it is the better for you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-026",
      "type": "speech",
      "speaker": {
        "id": "williams",
        "name": "WILLIAMS",
        "displayName": "Williams"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "I will none of your money.",
          "plainText": "I will none of your money",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-027",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "It is with a good will; I can tell you, it will serve you to mend your shoes. Come, wherefore should you be so pashful? Your shoes is not so good. 'Tis a good silling, I warrant you, or I will change it.",
          "plainText": "It is with a good will I can tell you it will serve you to mend your shoes Come wherefore should you be so pashful Your shoes is not so good 'Tis a good silling I warrant you or I will change it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-stage-006",
      "type": "stage",
      "text": "Enter an English Herald."
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-028",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Now, herald, are the dead numb'red?",
          "plainText": "Now herald are the dead numb'red",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-029",
      "type": "speech",
      "speaker": {
        "id": "herald",
        "name": "HERALD",
        "displayName": "Herald"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Here is the number of the slaught'red French.",
          "plainText": "Here is the number of the slaught'red French",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-030",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "What prisoners of good sort are taken, uncle?",
          "plainText": "What prisoners of good sort are taken uncle",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-031",
      "type": "speech",
      "speaker": {
        "id": "exeter",
        "name": "EXETER",
        "displayName": "Exeter"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Charles Duke of Orleans, nephew to the King;",
          "plainText": "Charles Duke of Orleans nephew to the King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "John Duke of Bourbon, and Lord Boucicault:",
          "plainText": "John Duke of Bourbon and Lord Boucicault",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "Of other lords and barons, knights and squires,",
          "plainText": "Of other lords and barons knights and squires",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "Full fifteen hundred, besides common men.",
          "plainText": "Full fifteen hundred besides common men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-032",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "This note doth tell me of ten thousand French",
          "plainText": "This note doth tell me of ten thousand French",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "That in the field lie slain; of princes, in this number,",
          "plainText": "That in the field lie slain of princes in this number",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "And nobles bearing banners, there lie dead",
          "plainText": "And nobles bearing banners there lie dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "One hundred twenty-six; added to these,",
          "plainText": "One hundred twentysix added to these",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "Of knights, esquires, and gallant gentlemen,",
          "plainText": "Of knights esquires and gallant gentlemen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "Eight thousand and four hundred; of the which,",
          "plainText": "Eight thousand and four hundred of the which",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0047",
          "number": 47,
          "speechLineNumber": 7,
          "text": "Five hundred were but yesterday dubb'd knights;",
          "plainText": "Five hundred were but yesterday dubb'd knights",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0048",
          "number": 48,
          "speechLineNumber": 8,
          "text": "So that, in these ten thousand they have lost,",
          "plainText": "So that in these ten thousand they have lost",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0049",
          "number": 49,
          "speechLineNumber": 9,
          "text": "There are but sixteen hundred mercenaries;",
          "plainText": "There are but sixteen hundred mercenaries",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0050",
          "number": 50,
          "speechLineNumber": 10,
          "text": "The rest are princes, barons, lords, knights, squires,",
          "plainText": "The rest are princes barons lords knights squires",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0051",
          "number": 51,
          "speechLineNumber": 11,
          "text": "And gentlemen of blood and quality.",
          "plainText": "And gentlemen of blood and quality",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0052",
          "number": 52,
          "speechLineNumber": 12,
          "text": "The names of those their nobles that lie dead:",
          "plainText": "The names of those their nobles that lie dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0053",
          "number": 53,
          "speechLineNumber": 13,
          "text": "Charles Delabreth, High Constable of France;",
          "plainText": "Charles Delabreth High Constable of France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0054",
          "number": 54,
          "speechLineNumber": 14,
          "text": "Jacques of Chatillon, Admiral of France;",
          "plainText": "Jacques of Chatillon Admiral of France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0055",
          "number": 55,
          "speechLineNumber": 15,
          "text": "The master of the Crossbows, Lord Rambures;",
          "plainText": "The master of the Crossbows Lord Rambures",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0056",
          "number": 56,
          "speechLineNumber": 16,
          "text": "Great Master of France, the brave Sir Guichard Dauphin,",
          "plainText": "Great Master of France the brave Sir Guichard Dauphin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0057",
          "number": 57,
          "speechLineNumber": 17,
          "text": "John, Duke of Alençon, Anthony, Duke of Brabant,",
          "plainText": "John Duke of Alenon Anthony Duke of Brabant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0058",
          "number": 58,
          "speechLineNumber": 18,
          "text": "The brother to the Duke of Burgundy,",
          "plainText": "The brother to the Duke of Burgundy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0059",
          "number": 59,
          "speechLineNumber": 19,
          "text": "And Edward, Duke of Bar; of lusty earls,",
          "plainText": "And Edward Duke of Bar of lusty earls",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0060",
          "number": 60,
          "speechLineNumber": 20,
          "text": "Grandpré and Roussi, Fauconbridge and Foix,",
          "plainText": "Grandpr and Roussi Fauconbridge and Foix",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0061",
          "number": 61,
          "speechLineNumber": 21,
          "text": "Beaumont and Marle, Vaudemont and Lestrale.",
          "plainText": "Beaumont and Marle Vaudemont and Lestrale",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0062",
          "number": 62,
          "speechLineNumber": 22,
          "text": "Here was a royal fellowship of death!",
          "plainText": "Here was a royal fellowship of death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0063",
          "number": 63,
          "speechLineNumber": 23,
          "text": "Where is the number of our English dead?",
          "plainText": "Where is the number of our English dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-stage-007",
      "type": "stage",
      "text": "[Herald gives him another paper.]"
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-033",
      "type": "speech",
      "speaker": {
        "id": "exeter",
        "name": "EXETER",
        "displayName": "Exeter"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "'Tis wonderful!",
          "plainText": "'Tis wonderful",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-034",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Come, go we in procession to the village;",
          "plainText": "Come go we in procession to the village",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "And be it death proclaimed through our host",
          "plainText": "And be it death proclaimed through our host",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0067",
          "number": 67,
          "speechLineNumber": 3,
          "text": "To boast of this or take that praise from God",
          "plainText": "To boast of this or take that praise from God",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0068",
          "number": 68,
          "speechLineNumber": 4,
          "text": "Which is His only.",
          "plainText": "Which is His only",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-035",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Is it not lawful, an please your Majesty, to tell how many is kill'd?",
          "plainText": "Is it not lawful an please your Majesty to tell how many is kill'd",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-036",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Yes, Captain; but with this acknowledgment,",
          "plainText": "Yes Captain but with this acknowledgment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "That God fought for us.",
          "plainText": "That God fought for us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-037",
      "type": "speech",
      "speaker": {
        "id": "fluellen",
        "name": "FLUELLEN",
        "displayName": "Fluellen"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Yes, my conscience, He did us great good.",
          "plainText": "Yes my conscience He did us great good",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-speech-038",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-henry-the-fifth-4-8-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Do we all holy rites.",
          "plainText": "Do we all holy rites",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0074",
          "number": 74,
          "speechLineNumber": 2,
          "text": "Let there be sung Non nobis and Te Deum,",
          "plainText": "Let there be sung Non nobis and Te Deum",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0075",
          "number": 75,
          "speechLineNumber": 3,
          "text": "The dead with charity enclos'd in clay,",
          "plainText": "The dead with charity enclos'd in clay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0076",
          "number": 76,
          "speechLineNumber": 4,
          "text": "And then to Calais; and to England then,",
          "plainText": "And then to Calais and to England then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-henry-the-fifth-4-8-line-0077",
          "number": 77,
          "speechLineNumber": 5,
          "text": "Where ne'er from France arriv'd more happy men.",
          "plainText": "Where ne'er from France arriv'd more happy men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-henry-the-fifth-4-8-stage-008",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}