  "scene": {
    "id": "king-john-3-2",
    "act": 3,
    "scene": 2,
    "label": "Act 3, Scene 2",
    "title": "SCENE II. The same. Plains near Angiers",
    "location": "The same. Plains near Angiers",
    "orderInPlay": 4
  },
  "content": [
    {
      "id": "king-john-3-2-stage-001",
      "type": "stage",
      "text": "Alarums. Excursions. Enter the Bastard with Austria's head."
    },
    {
      "id": "king-john-3-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-3-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Now, by my life, this day grows wondrous hot;",
          "plainText": "Now by my life this day grows wondrous hot",
          "lineType": "verse"
        },
        {
          "id": "king-john-3-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Some airy devil hovers in the sky",
          "plainText": "Some airy devil hovers in the sky",
          "lineType": "verse"
        },
        {
          "id": "king-john-3-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And pours down mischief. Austria's head lie there,",
          "plainText": "And pours down mischief Austria's head lie there",
          "lineType": "verse"
        },
        {
          "id": "king-john-3-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "While Philip breathes.",
          "plainText": "While Philip breathes",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-3-2-stage-002",
      "type": "stage",
      "text": "Enter King John, Arthur and Hubert."
    },
    {
      "id": "king-john-3-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "king-john",
        "name": "KING JOHN",
        "displayName": "King John"
      },
      "lines": [
        {
          "id": "king-john-3-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Hubert, keep this boy.—Philip, make up.",
          "plainText": "Hubert keep this boyPhilip make up",
          "lineType": "verse"
        },
        {
          "id": "king-john-3-2-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "My mother is assailed in our tent,",
          "plainText": "My mother is assailed in our tent",
          "lineType": "verse"
        },
        {
          "id": "king-john-3-2-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "And ta'en, I fear.",
          "plainText": "And ta'en I fear",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-3-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-3-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "My lord, I rescu'd her;",
          "plainText": "My lord I rescu'd her",
          "lineType": "verse"
        },
        {
          "id": "king-john-3-2-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Her highness is in safety, fear you not.",
          "plainText": "Her highness is in safety fear you not",
          "lineType": "verse"
        },
        {
          "id": "king-john-3-2-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "But on, my liege; for very little pains",
          "plainText": "But on my liege for very little pains",
          "lineType": "verse"
        },
        {
          "id": "king-john-3-2-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Will bring this labour to an happy end.",
          "plainText": "Will bring this labour to an happy end",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-3-2-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}