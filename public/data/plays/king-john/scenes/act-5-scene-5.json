  "scene": {
    "id": "king-john-5-5",
    "act": 5,
    "scene": 5,
    "label": "Act 5, Scene 5",
    "title": "SCENE V. The same. The French camp.",
    "location": "The same. The French camp.",
    "orderInPlay": 14
  },
  "content": [
    {
      "id": "king-john-5-5-stage-001",
      "type": "stage",
      "text": "Enter Louis and his train."
    },
    {
      "id": "king-john-5-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "louis",
        "name": "LOUIS",
        "displayName": "Louis"
      },
      "lines": [
        {
          "id": "king-john-5-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The sun of heaven, methought, was loath to set,",
          "plainText": "The sun of heaven methought was loath to set",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "But stay'd, and made the western welkin blush,",
          "plainText": "But stay'd and made the western welkin blush",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "When the English measure backward their own ground",
          "plainText": "When the English measure backward their own ground",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "In faint retire. O, bravely came we off,",
          "plainText": "In faint retire O bravely came we off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "When with a volley of our needless shot,",
          "plainText": "When with a volley of our needless shot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "After such bloody toil, we bid good night,",
          "plainText": "After such bloody toil we bid good night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "And wound our tott'ring colours clearly up,",
          "plainText": "And wound our tott'ring colours clearly up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Last in the field, and almost lords of it!",
          "plainText": "Last in the field and almost lords of it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-5-stage-002",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "king-john-5-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "king-john-5-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Where is my prince, the Dauphin?",
          "plainText": "Where is my prince the Dauphin",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-5-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "louis",
        "name": "LOUIS",
        "displayName": "Louis"
      },
      "lines": [
        {
          "id": "king-john-5-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Here. What news?",
          "plainText": "Here What news",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-5-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "king-john-5-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "The Count Melun is slain; the English lords",
          "plainText": "The Count Melun is slain the English lords",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "By his persuasion are again fall'n off,",
          "plainText": "By his persuasion are again fall'n off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "And your supply, which you have wish'd so long,",
          "plainText": "And your supply which you have wish'd so long",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "Are cast away and sunk on Goodwin Sands.",
          "plainText": "Are cast away and sunk on Goodwin Sands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "louis",
        "name": "LOUIS",
        "displayName": "Louis"
      },
      "lines": [
        {
          "id": "king-john-5-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Ah, foul shrewd news! Beshrew thy very heart!",
          "plainText": "Ah foul shrewd news Beshrew thy very heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "I did not think to be so sad tonight",
          "plainText": "I did not think to be so sad tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "As this hath made me. Who was he that said",
          "plainText": "As this hath made me Who was he that said",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "King John did fly an hour or two before",
          "plainText": "King John did fly an hour or two before",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0019",
          "number": 19,
          "speechLineNumber": 5,
          "text": "The stumbling night did part our weary powers?",
          "plainText": "The stumbling night did part our weary powers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "king-john-5-5-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Whoever spoke it, it is true, my lord.",
          "plainText": "Whoever spoke it it is true my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-john-5-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "louis",
        "name": "LOUIS",
        "displayName": "Louis"
      },
      "lines": [
        {
          "id": "king-john-5-5-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Well, keep good quarter and good care tonight.",
          "plainText": "Well keep good quarter and good care tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "The day shall not be up so soon as I,",
          "plainText": "The day shall not be up so soon as I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-john-5-5-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "To try the fair adventure of tomorrow.",
          "plainText": "To try the fair adventure of tomorrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-john-5-5-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}