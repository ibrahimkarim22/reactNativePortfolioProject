{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "king-john",
    "title": "The Life and Death of King John",
    "author": "William Shakespeare",
    "genre": "History"
  },
  "source": {
    "name": "Project Gutenberg",
    "ebookNumber": 100,
    "rights": "Public domain in the USA",
    "sourceFile": "pg100-images.html"
  },
  "scene": {
    "id": "king-john-5-6",
    "act": 5,
    "scene": 6,
    "label": "Act 5, Scene 6",
    "title": "SCENE VI. An open place in the neighborhood of Swinstead Abbey.",
    "location": "An open place in the neighborhood of Swinstead Abbey.",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "king-john-5-6-stage-001",
      "type": "stage",
      "text": "Enter the Bastard and Hubert, meeting."
    },
    {
      "id": "king-john-5-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Who's there? Speak, ho! Speak quickly, or I shoot.",
          "plainText": "Who's there Speak ho Speak quickly or I shoot",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "A friend. What art thou?",
          "plainText": "A friend What art thou",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Of the part of England.",
          "plainText": "Of the part of England",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Whither dost thou go?",
          "plainText": "Whither dost thou go",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "What's that to thee? Why may I not demand",
          "plainText": "What's that to thee Why may I not demand",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Of thine affairs, as well as thou of mine?",
          "plainText": "Of thine affairs as well as thou of mine",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Hubert, I think.",
          "plainText": "Hubert I think",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-007",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Thou hast a perfect thought.",
          "plainText": "Thou hast a perfect thought",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "I will, upon all hazards, well believe",
          "plainText": "I will upon all hazards well believe",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Thou art my friend, that know'st my tongue so well.",
          "plainText": "Thou art my friend that know'st my tongue so well",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Who art thou?",
          "plainText": "Who art thou",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-008",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Who thou wilt. And if thou please,",
          "plainText": "Who thou wilt And if thou please",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Thou mayst befriend me so much as to think",
          "plainText": "Thou mayst befriend me so much as to think",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "I come one way of the Plantagenets.",
          "plainText": "I come one way of the Plantagenets",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-009",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Unkind remembrance! Thou and eyeless night",
          "plainText": "Unkind remembrance Thou and eyeless night",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Have done me shame. Brave soldier, pardon me,",
          "plainText": "Have done me shame Brave soldier pardon me",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "That any accent breaking from thy tongue",
          "plainText": "That any accent breaking from thy tongue",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "Should 'scape the true acquaintance of mine ear.",
          "plainText": "Should 'scape the true acquaintance of mine ear",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-010",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Come, come; sans compliment, what news abroad?",
          "plainText": "Come come sans compliment what news abroad",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-011",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Why, here walk I in the black brow of night,",
          "plainText": "Why here walk I in the black brow of night",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "To find you out.",
          "plainText": "To find you out",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-012",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Brief, then; and what's the news?",
          "plainText": "Brief then and what's the news",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-013",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "O, my sweet sir, news fitting to the night,",
          "plainText": "O my sweet sir news fitting to the night",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Black, fearful, comfortless, and horrible.",
          "plainText": "Black fearful comfortless and horrible",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-014",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Show me the very wound of this ill news.",
          "plainText": "Show me the very wound of this ill news",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "I am no woman, I'll not swoon at it.",
          "plainText": "I am no woman I'll not swoon at it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-015",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "The King, I fear, is poison'd by a monk.",
          "plainText": "The King I fear is poison'd by a monk",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "I left him almost speechless, and broke out",
          "plainText": "I left him almost speechless and broke out",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "To acquaint you with this evil, that you might",
          "plainText": "To acquaint you with this evil that you might",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "The better arm you to the sudden time,",
          "plainText": "The better arm you to the sudden time",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "Than if you had at leisure known of this.",
          "plainText": "Than if you had at leisure known of this",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-016",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "How did he take it? Who did taste to him?",
          "plainText": "How did he take it Who did taste to him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-017",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "A monk, I tell you, a resolved villain,",
          "plainText": "A monk I tell you a resolved villain",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Whose bowels suddenly burst out. The King",
          "plainText": "Whose bowels suddenly burst out The King",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Yet speaks, and peradventure may recover.",
          "plainText": "Yet speaks and peradventure may recover",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-018",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Who didst thou leave to tend his majesty?",
          "plainText": "Who didst thou leave to tend his majesty",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-019",
      "type": "speech",
      "speaker": {
        "id": "hubert",
        "name": "HUBERT",
        "displayName": "Hubert"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Why, know you not? The lords are all come back,",
          "plainText": "Why know you not The lords are all come back",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "And brought Prince Henry in their company;",
          "plainText": "And brought Prince Henry in their company",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "At whose request the King hath pardon'd them,",
          "plainText": "At whose request the King hath pardon'd them",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "And they are all about his majesty.",
          "plainText": "And they are all about his majesty",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-speech-020",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "king-john-5-6-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Withhold thine indignation, mighty heaven,",
          "plainText": "Withhold thine indignation mighty heaven",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "And tempt us not to bear above our power!",
          "plainText": "And tempt us not to bear above our power",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "I'll tell thee, Hubert, half my power this night,",
          "plainText": "I'll tell thee Hubert half my power this night",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "Passing these flats, are taken by the tide;",
          "plainText": "Passing these flats are taken by the tide",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "These Lincoln Washes have devoured them;",
          "plainText": "These Lincoln Washes have devoured them",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "Myself, well mounted, hardly have escap'd.",
          "plainText": "Myself well mounted hardly have escap'd",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0047",
          "number": 47,
          "speechLineNumber": 7,
          "text": "Away, before. Conduct me to the King;",
          "plainText": "Away before Conduct me to the King",
          "lineType": "verse"
        },
        {
          "id": "king-john-5-6-line-0048",
          "number": 48,
          "speechLineNumber": 8,
          "text": "I doubt he will be dead or ere I come.",
          "plainText": "I doubt he will be dead or ere I come",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-john-5-6-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}