    "title": "SCENE V. Court before the Duke of Albany's Palace",
    "location": "Court before the Duke of Albany's Palace",
    "orderInPlay": 5
  },
  "content": [
    {
      "id": "king-lear-1-5-stage-001",
      "type": "stage",
      "text": "Enter Lear, Kent and Fool."
    },
    {
      "id": "king-lear-1-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Go you before to Gloucester with these letters: acquaint my daughter no further with anything you know than comes from her demand out of the letter. If your diligence be not speedy, I shall be there afore you.",
          "plainText": "Go you before to Gloucester with these letters acquaint my daughter no further with anything you know than comes from her demand out of the letter If your diligence be not speedy I shall be there afore you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "I will not sleep, my lord, till I have delivered your letter.",
          "plainText": "I will not sleep my lord till I have delivered your letter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "king-lear-1-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "If a man's brains were in's heels, were't not in danger of kibes?",
          "plainText": "If a man's brains were in's heels were't not in danger of kibes",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Ay, boy.",
          "plainText": "Ay boy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Then I prithee be merry; thy wit shall not go slipshod.",
          "plainText": "Then I prithee be merry thy wit shall not go slipshod",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Ha, ha, ha!",
          "plainText": "Ha ha ha",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Shalt see thy other daughter will use thee kindly, for though she's as like this as a crab's like an apple, yet I can tell what I can tell.",
          "plainText": "Shalt see thy other daughter will use thee kindly for though she's as like this as a crab's like an apple yet I can tell what I can tell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "What canst tell, boy?",
          "plainText": "What canst tell boy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "She'll taste as like this as a crab does to a crab. Thou canst tell why one's nose stands i'the middle on's face?",
          "plainText": "She'll taste as like this as a crab does to a crab Thou canst tell why one's nose stands i'the middle on's face",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "No.",
          "plainText": "No",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Why, to keep one's eyes of either side's nose, that what a man cannot smell out, he may spy into.",
          "plainText": "Why to keep one's eyes of either side's nose that what a man cannot smell out he may spy into",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "I did her wrong.",
          "plainText": "I did her wrong",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Canst tell how an oyster makes his shell?",
          "plainText": "Canst tell how an oyster makes his shell",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "No.",
          "plainText": "No",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Nor I neither; but I can tell why a snail has a house.",
          "plainText": "Nor I neither but I can tell why a snail has a house",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Why?",
          "plainText": "Why",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Why, to put's head in; not to give it away to his daughters, and leave his horns without a case.",
          "plainText": "Why to put's head in not to give it away to his daughters and leave his horns without a case",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "I will forget my nature. So kind a father! Be my horses ready?",
          "plainText": "I will forget my nature So kind a father Be my horses ready",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Thy asses are gone about 'em. The reason why the seven stars are no more than seven is a pretty reason.",
          "plainText": "Thy asses are gone about 'em The reason why the seven stars are no more than seven is a pretty reason",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Because they are not eight?",
          "plainText": "Because they are not eight",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Yes indeed: thou wouldst make a good fool.",
          "plainText": "Yes indeed thou wouldst make a good fool",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "To tak't again perforce!—Monster ingratitude!",
          "plainText": "To tak't again perforceMonster ingratitude",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "If thou wert my fool, nuncle, I'd have thee beaten for being old before thy time.",
          "plainText": "If thou wert my fool nuncle I'd have thee beaten for being old before thy time",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "How's that?",
          "plainText": "How's that",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Thou shouldst not have been old till thou hadst been wise.",
          "plainText": "Thou shouldst not have been old till thou hadst been wise",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "O, let me not be mad, not mad, sweet heaven!",
          "plainText": "O let me not be mad not mad sweet heaven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-5-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "Keep me in temper; I would not be mad!",
          "plainText": "Keep me in temper I would not be mad",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-1-5-stage-003",
      "type": "stage",
      "text": "Enter Gentleman."
    },
    {
      "id": "king-lear-1-5-speech-027",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Ready, my lord.",
          "plainText": "Ready my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-028",
      "type": "speech",
      "speaker": {
        "id": "lear",
        "name": "LEAR",
        "displayName": "Lear"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Come, boy.",
          "plainText": "Come boy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-1-5-speech-029",
      "type": "speech",
      "speaker": {
        "id": "fool",
        "name": "FOOL",
        "displayName": "Fool"
      },
      "lines": [
        {
          "id": "king-lear-1-5-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "She that's a maid now, and laughs at my departure,",
          "plainText": "She that's a maid now and laughs at my departure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-1-5-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "Shall not be a maid long, unless things be cut shorter.",
          "plainText": "Shall not be a maid long unless things be cut shorter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-1-5-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}