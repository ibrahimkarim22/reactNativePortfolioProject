    "label": "Act 3, Scene 1",
    "title": "SCENE I. A Heath",
    "location": "A Heath",
    "orderInPlay": 10
  },
  "content": [
    {
      "id": "king-lear-3-1-stage-001",
      "type": "stage",
      "text": "A storm with thunder and lightning. Enter Kent and a Gentleman, severally."
    },
    {
      "id": "king-lear-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Who's there, besides foul weather?",
          "plainText": "Who's there besides foul weather",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "king-lear-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "One minded like the weather, most unquietly.",
          "plainText": "One minded like the weather most unquietly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "I know you. Where's the King?",
          "plainText": "I know you Where's the King",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "king-lear-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Contending with the fretful elements;",
          "plainText": "Contending with the fretful elements",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Bids the wind blow the earth into the sea,",
          "plainText": "Bids the wind blow the earth into the sea",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Or swell the curled waters 'bove the main,",
          "plainText": "Or swell the curled waters 'bove the main",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "That things might change or cease; tears his white hair,",
          "plainText": "That things might change or cease tears his white hair",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "Which the impetuous blasts with eyeless rage,",
          "plainText": "Which the impetuous blasts with eyeless rage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 6,
          "text": "Catch in their fury and make nothing of;",
          "plainText": "Catch in their fury and make nothing of",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 7,
          "text": "Strives in his little world of man to outscorn",
          "plainText": "Strives in his little world of man to outscorn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 8,
          "text": "The to-and-fro-conflicting wind and rain.",
          "plainText": "The toandfroconflicting wind and rain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 9,
          "text": "This night, wherein the cub-drawn bear would couch,",
          "plainText": "This night wherein the cubdrawn bear would couch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 10,
          "text": "The lion and the belly-pinched wolf",
          "plainText": "The lion and the bellypinched wolf",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 11,
          "text": "Keep their fur dry, unbonneted he runs,",
          "plainText": "Keep their fur dry unbonneted he runs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 12,
          "text": "And bids what will take all.",
          "plainText": "And bids what will take all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "But who is with him?",
          "plainText": "But who is with him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "king-lear-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "None but the fool, who labours to out-jest",
          "plainText": "None but the fool who labours to outjest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "His heart-struck injuries.",
          "plainText": "His heartstruck injuries",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Sir, I do know you;",
          "plainText": "Sir I do know you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "And dare, upon the warrant of my note",
          "plainText": "And dare upon the warrant of my note",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Commend a dear thing to you. There is division,",
          "plainText": "Commend a dear thing to you There is division",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "Although as yet the face of it be cover'd",
          "plainText": "Although as yet the face of it be cover'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "With mutual cunning, 'twixt Albany and Cornwall;",
          "plainText": "With mutual cunning 'twixt Albany and Cornwall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "Who have, as who have not, that their great stars",
          "plainText": "Who have as who have not that their great stars",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 7,
          "text": "Throne'd and set high; servants, who seem no less,",
          "plainText": "Throne'd and set high servants who seem no less",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 8,
          "text": "Which are to France the spies and speculations",
          "plainText": "Which are to France the spies and speculations",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 9,
          "text": "Intelligent of our state. What hath been seen,",
          "plainText": "Intelligent of our state What hath been seen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0028",
          "number": 28,
          "speechLineNumber": 10,
          "text": "Either in snuffs and packings of the Dukes;",
          "plainText": "Either in snuffs and packings of the Dukes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0029",
          "number": 29,
          "speechLineNumber": 11,
          "text": "Or the hard rein which both of them have borne",
          "plainText": "Or the hard rein which both of them have borne",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0030",
          "number": 30,
          "speechLineNumber": 12,
          "text": "Against the old kind King; or something deeper,",
          "plainText": "Against the old kind King or something deeper",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0031",
          "number": 31,
          "speechLineNumber": 13,
          "text": "Whereof, perchance, these are but furnishings;—",
          "plainText": "Whereof perchance these are but furnishings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0032",
          "number": 32,
          "speechLineNumber": 14,
          "text": "But, true it is, from France there comes a power",
          "plainText": "But true it is from France there comes a power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0033",
          "number": 33,
          "speechLineNumber": 15,
          "text": "Into this scatter'd kingdom; who already,",
          "plainText": "Into this scatter'd kingdom who already",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0034",
          "number": 34,
          "speechLineNumber": 16,
          "text": "Wise in our negligence, have secret feet",
          "plainText": "Wise in our negligence have secret feet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0035",
          "number": 35,
          "speechLineNumber": 17,
          "text": "In some of our best ports, and are at point",
          "plainText": "In some of our best ports and are at point",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0036",
          "number": 36,
          "speechLineNumber": 18,
          "text": "To show their open banner.—Now to you:",
          "plainText": "To show their open bannerNow to you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0037",
          "number": 37,
          "speechLineNumber": 19,
          "text": "If on my credit you dare build so far",
          "plainText": "If on my credit you dare build so far",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0038",
          "number": 38,
          "speechLineNumber": 20,
          "text": "To make your speed to Dover, you shall find",
          "plainText": "To make your speed to Dover you shall find",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0039",
          "number": 39,
          "speechLineNumber": 21,
          "text": "Some that will thank you making just report",
          "plainText": "Some that will thank you making just report",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0040",
          "number": 40,
          "speechLineNumber": 22,
          "text": "Of how unnatural and bemadding sorrow",
          "plainText": "Of how unnatural and bemadding sorrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0041",
          "number": 41,
          "speechLineNumber": 23,
          "text": "The King hath cause to plain.",
          "plainText": "The King hath cause to plain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0042",
          "number": 42,
          "speechLineNumber": 24,
          "text": "I am a gentleman of blood and breeding;",
          "plainText": "I am a gentleman of blood and breeding",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0043",
          "number": 43,
          "speechLineNumber": 25,
          "text": "And from some knowledge and assurance",
          "plainText": "And from some knowledge and assurance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0044",
          "number": 44,
          "speechLineNumber": 26,
          "text": "Offer this office to you.",
          "plainText": "Offer this office to you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "king-lear-3-1-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "I will talk further with you.",
          "plainText": "I will talk further with you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-3-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "kent",
        "name": "KENT",
        "displayName": "Kent"
      },
      "lines": [
        {
          "id": "king-lear-3-1-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "No, do not.",
          "plainText": "No do not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "For confirmation that I am much more",
          "plainText": "For confirmation that I am much more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "Than my out-wall, open this purse, and take",
          "plainText": "Than my outwall open this purse and take",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "What it contains. If you shall see Cordelia,",
          "plainText": "What it contains If you shall see Cordelia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0050",
          "number": 50,
          "speechLineNumber": 5,
          "text": "As fear not but you shall, show her this ring;",
          "plainText": "As fear not but you shall show her this ring",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0051",
          "number": 51,
          "speechLineNumber": 6,
          "text": "And she will tell you who your fellow is",
          "plainText": "And she will tell you who your fellow is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0052",
          "number": 52,
          "speechLineNumber": 7,
          "text": "That yet you do not know. Fie on this storm!",
          "plainText": "That yet you do not know Fie on this storm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-3-1-line-0053",
          "number": 53,
          "speechLineNumber": 8,
          "text": "I will go seek the King.",
          "plainText": "I will go seek the King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-3-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "king-lear-3-1-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Give me your hand: have you no more to say?",
          "plainText": "Give me your hand have you no more to say",
          "lineType": "prose",
          "lineTypeDetection": "auto",
