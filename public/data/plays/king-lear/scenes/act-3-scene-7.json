  },
  "scene": {
    "id": "king-lear-3-7",
    "act": 3,
    "scene": 7,
    "label": "Act 3, Scene 7",
    "title": "SCENE VII. A Room in Gloucester's Castle",
    "location": "A Room in Gloucester's Castle",
    "orderInPlay": 16
  },
  "content": [
    {
      "id": "king-lear-3-7-stage-001",
      "type": "stage",
      "text": "Enter Cornwall, Regan, Goneril, Edmund and Servants."
    },
    {
      "id": "king-lear-3-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Post speedily to my lord your husband, show him this letter: the army of France is landed. Seek out the traitor Gloucester.",
          "plainText": "Post speedily to my lord your husband show him this letter the army of France is landed Seek out the traitor Gloucester",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-002",
      "type": "stage",
      "text": "[Exeunt some of the Servants.]"
    },
    {
      "id": "king-lear-3-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Hang him instantly.",
          "plainText": "Hang him instantly",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "goneril",
        "name": "GONERIL",
        "displayName": "Goneril"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Pluck out his eyes.",
          "plainText": "Pluck out his eyes",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Leave him to my displeasure. Edmund, keep you our sister company: the revenges we are bound to take upon your traitorous father are not fit for your beholding. Advise the Duke where you are going, to a most festinate preparation: we are bound to the like. Our posts shall be swift and intelligent betwixt us. Farewell, dear sister, farewell, my lord of Gloucester.",
          "plainText": "Leave him to my displeasure Edmund keep you our sister company the revenges we are bound to take upon your traitorous father are not fit for your beholding Advise the Duke where you are going to a most festinate preparation we are bound to the like Our posts shall be swift and intelligent betwixt us Farewell dear sister farewell my lord of Gloucester",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-003",
      "type": "stage",
      "text": "Enter Oswald."
    },
    {
      "id": "king-lear-3-7-speech-005",
      "type": "speech",
      "speaker": {
        "id": "oswald",
        "name": "OSWALD",
        "displayName": "Oswald"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "My lord of Gloucester hath convey'd him hence:",
          "plainText": "My lord of Gloucester hath convey'd him hence",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Some five or six and thirty of his knights,",
          "plainText": "Some five or six and thirty of his knights",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "Hot questrists after him, met him at gate;",
          "plainText": "Hot questrists after him met him at gate",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "Who, with some other of the lord's dependants,",
          "plainText": "Who with some other of the lord's dependants",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0009",
          "number": 9,
          "speechLineNumber": 5,
          "text": "Are gone with him toward Dover: where they boast",
          "plainText": "Are gone with him toward Dover where they boast",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0010",
          "number": 10,
          "speechLineNumber": 6,
          "text": "To have well-armed friends.",
          "plainText": "To have wellarmed friends",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Get horses for your mistress.",
          "plainText": "Get horses for your mistress",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-007",
      "type": "speech",
      "speaker": {
        "id": "goneril",
        "name": "GONERIL",
        "displayName": "Goneril"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Farewell, sweet lord, and sister.",
          "plainText": "Farewell sweet lord and sister",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Edmund, farewell.",
          "plainText": "Edmund farewell",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-004",
      "type": "stage",
      "text": "[Exeunt Goneril, Edmund and Oswald.]"
    },
    {
      "id": "king-lear-3-7-stage-005",
      "type": "stage",
      "text": "[Exeunt other Servants.]"
    },
    {
      "id": "king-lear-3-7-stage-006",
      "type": "stage",
      "text": "Enter Gloucester and Servants."
    },
    {
      "id": "king-lear-3-7-speech-009",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Ingrateful fox! 'tis he.",
          "plainText": "Ingrateful fox 'tis he",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-010",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Bind fast his corky arms.",
          "plainText": "Bind fast his corky arms",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-011",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "What mean your graces?",
          "plainText": "What mean your graces",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Good my friends, consider you are my guests.",
          "plainText": "Good my friends consider you are my guests",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Do me no foul play, friends.",
          "plainText": "Do me no foul play friends",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-012",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Bind him, I say.",
          "plainText": "Bind him I say",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-007",
      "type": "stage",
      "text": "[Servants bind him.]"
    },
    {
      "id": "king-lear-3-7-speech-013",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Hard, hard. O filthy traitor!",
          "plainText": "Hard hard O filthy traitor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-014",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Unmerciful lady as you are, I'm none.",
          "plainText": "Unmerciful lady as you are I'm none",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "To this chair bind him. Villain, thou shalt find—",
          "plainText": "To this chair bind him Villain thou shalt find",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-008",
      "type": "stage",
      "text": "[Regan plucks his beard.]"
    },
    {
      "id": "king-lear-3-7-speech-016",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "By the kind gods, 'tis most ignobly done",
          "plainText": "By the kind gods 'tis most ignobly done",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "To pluck me by the beard.",
          "plainText": "To pluck me by the beard",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-017",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "So white, and such a traitor!",
          "plainText": "So white and such a traitor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-018",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Naughty lady,",
          "plainText": "Naughty lady",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "These hairs which thou dost ravish from my chin",
          "plainText": "These hairs which thou dost ravish from my chin",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "Will quicken, and accuse thee. I am your host:",
          "plainText": "Will quicken and accuse thee I am your host",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "With robber's hands my hospitable favours",
          "plainText": "With robber's hands my hospitable favours",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0030",
          "number": 30,
          "speechLineNumber": 5,
          "text": "You should not ruffle thus. What will you do?",
          "plainText": "You should not ruffle thus What will you do",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Come, sir, what letters had you late from France?",
          "plainText": "Come sir what letters had you late from France",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-020",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Be simple answer'd, for we know the truth.",
          "plainText": "Be simple answer'd for we know the truth",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "And what confederacy have you with the traitors,",
          "plainText": "And what confederacy have you with the traitors",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Late footed in the kingdom?",
          "plainText": "Late footed in the kingdom",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-022",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "To whose hands have you sent the lunatic King?",
          "plainText": "To whose hands have you sent the lunatic King",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "Speak.",
          "plainText": "Speak",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-023",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "I have a letter guessingly set down,",
          "plainText": "I have a letter guessingly set down",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Which came from one that's of a neutral heart,",
          "plainText": "Which came from one that's of a neutral heart",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "And not from one oppos'd.",
          "plainText": "And not from one oppos'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-024",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Cunning.",
          "plainText": "Cunning",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-025",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "And false.",
          "plainText": "And false",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-026",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Where hast thou sent the King?",
          "plainText": "Where hast thou sent the King",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-027",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "To Dover.",
          "plainText": "To Dover",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-028",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Wherefore to Dover? Wast thou not charg'd at peril,—",
          "plainText": "Wherefore to Dover Wast thou not charg'd at peril",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-029",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Wherefore to Dover? Let him first answer that.",
          "plainText": "Wherefore to Dover Let him first answer that",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-030",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "I am tied to the stake, and I must stand the course.",
          "plainText": "I am tied to the stake and I must stand the course",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-031",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Wherefore to Dover, sir?",
          "plainText": "Wherefore to Dover sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-032",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Because I would not see thy cruel nails",
          "plainText": "Because I would not see thy cruel nails",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "Pluck out his poor old eyes; nor thy fierce sister",
          "plainText": "Pluck out his poor old eyes nor thy fierce sister",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "In his anointed flesh stick boarish fangs.",
          "plainText": "In his anointed flesh stick boarish fangs",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "The sea, with such a storm as his bare head",
          "plainText": "The sea with such a storm as his bare head",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0052",
          "number": 52,
          "speechLineNumber": 5,
          "text": "In hell-black night endur'd, would have buoy'd up,",
          "plainText": "In hellblack night endur'd would have buoy'd up",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0053",
          "number": 53,
          "speechLineNumber": 6,
          "text": "And quench'd the stelled fires;",
          "plainText": "And quench'd the stelled fires",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0054",
          "number": 54,
          "speechLineNumber": 7,
          "text": "Yet, poor old heart, he holp the heavens to rain.",
          "plainText": "Yet poor old heart he holp the heavens to rain",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0055",
          "number": 55,
          "speechLineNumber": 8,
          "text": "If wolves had at thy gate howl'd that stern time,",
          "plainText": "If wolves had at thy gate howl'd that stern time",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0056",
          "number": 56,
          "speechLineNumber": 9,
          "text": "Thou shouldst have said, 'Good porter, turn the key.'",
          "plainText": "Thou shouldst have said 'Good porter turn the key'",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0057",
          "number": 57,
          "speechLineNumber": 10,
          "text": "All cruels else subscrib'd: but I shall see",
          "plainText": "All cruels else subscrib'd but I shall see",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0058",
          "number": 58,
          "speechLineNumber": 11,
          "text": "The winged vengeance overtake such children.",
          "plainText": "The winged vengeance overtake such children",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-033",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "See't shalt thou never. Fellows, hold the chair.",
          "plainText": "See't shalt thou never Fellows hold the chair",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "Upon these eyes of thine I'll set my foot.",
          "plainText": "Upon these eyes of thine I'll set my foot",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-009",
      "type": "stage",
      "text": "[Gloucester is held down in his chair, while Cornwall plucks out one of his eyes and sets his foot on it.]"
    },
    {
      "id": "king-lear-3-7-speech-034",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "He that will think to live till he be old,",
          "plainText": "He that will think to live till he be old",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "Give me some help!—O cruel! O you gods!",
          "plainText": "Give me some helpO cruel O you gods",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-035",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "One side will mock another; the other too!",
          "plainText": "One side will mock another the other too",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-036",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "If you see vengeance—",
          "plainText": "If you see vengeance",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-037",
      "type": "speech",
      "speaker": {
        "id": "first-servant",
        "name": "FIRST SERVANT",
        "displayName": "First Servant"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Hold your hand, my lord:",
          "plainText": "Hold your hand my lord",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "I have serv'd you ever since I was a child;",
          "plainText": "I have serv'd you ever since I was a child",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0067",
          "number": 67,
          "speechLineNumber": 3,
          "text": "But better service have I never done you",
          "plainText": "But better service have I never done you",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0068",
          "number": 68,
          "speechLineNumber": 4,
          "text": "Than now to bid you hold.",
          "plainText": "Than now to bid you hold",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-038",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "How now, you dog!",
          "plainText": "How now you dog",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-039",
      "type": "speech",
      "speaker": {
        "id": "first-servant",
        "name": "FIRST SERVANT",
        "displayName": "First Servant"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "If you did wear a beard upon your chin,",
          "plainText": "If you did wear a beard upon your chin",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "I'd shake it on this quarrel. What do you mean?",
          "plainText": "I'd shake it on this quarrel What do you mean",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-040",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "My villain?",
          "plainText": "My villain",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-010",
      "type": "stage",
      "text": "[Draws, and runs at him.]"
    },
    {
      "id": "king-lear-3-7-speech-041",
      "type": "speech",
      "speaker": {
        "id": "first-servant",
        "name": "FIRST SERVANT",
        "displayName": "First Servant"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Nay, then, come on, and take the chance of anger.",
          "plainText": "Nay then come on and take the chance of anger",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-011",
      "type": "stage",
      "text": "[Draws. They fight. Cornwall is wounded.]"
    },
    {
      "id": "king-lear-3-7-speech-042",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "[To another servant.] Give me thy sword. A peasant stand up thus?",
          "plainText": "To another servant Give me thy sword A peasant stand up thus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-012",
      "type": "stage",
      "text": "[Snatches a sword, comes behind, and stabs him.]"
    },
    {
      "id": "king-lear-3-7-speech-043",
      "type": "speech",
      "speaker": {
        "id": "first-servant",
        "name": "FIRST SERVANT",
        "displayName": "First Servant"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "O, I am slain! My lord, you have one eye left",
          "plainText": "O I am slain My lord you have one eye left",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "To see some mischief on him. O!",
          "plainText": "To see some mischief on him O",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-013",
      "type": "stage",
      "text": "[Dies.]"
    },
    {
      "id": "king-lear-3-7-speech-044",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Lest it see more, prevent it. Out, vile jelly!",
          "plainText": "Lest it see more prevent it Out vile jelly",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "Where is thy lustre now?",
          "plainText": "Where is thy lustre now",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-014",
      "type": "stage",
      "text": "[Tears out Gloucester's other eye and throws it on the ground.]"
    },
    {
      "id": "king-lear-3-7-speech-045",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "All dark and comfortless. Where's my son Edmund?",
          "plainText": "All dark and comfortless Where's my son Edmund",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0080",
          "number": 80,
          "speechLineNumber": 2,
          "text": "Edmund, enkindle all the sparks of nature",
          "plainText": "Edmund enkindle all the sparks of nature",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0081",
          "number": 81,
          "speechLineNumber": 3,
          "text": "To quit this horrid act.",
          "plainText": "To quit this horrid act",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-046",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "Out, treacherous villain!",
          "plainText": "Out treacherous villain",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0083",
          "number": 83,
          "speechLineNumber": 2,
          "text": "Thou call'st on him that hates thee: it was he",
          "plainText": "Thou call'st on him that hates thee it was he",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0084",
          "number": 84,
          "speechLineNumber": 3,
          "text": "That made the overture of thy treasons to us;",
          "plainText": "That made the overture of thy treasons to us",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0085",
          "number": 85,
          "speechLineNumber": 4,
          "text": "Who is too good to pity thee.",
          "plainText": "Who is too good to pity thee",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-047",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "O my follies! Then Edgar was abus'd.",
          "plainText": "O my follies Then Edgar was abus'd",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0087",
          "number": 87,
          "speechLineNumber": 2,
          "text": "Kind gods, forgive me that, and prosper him!",
          "plainText": "Kind gods forgive me that and prosper him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-048",
      "type": "speech",
      "speaker": {
        "id": "regan",
        "name": "REGAN",
        "displayName": "Regan"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0088",
          "number": 88,
          "speechLineNumber": 1,
          "text": "Go thrust him out at gates, and let him smell",
          "plainText": "Go thrust him out at gates and let him smell",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0089",
          "number": 89,
          "speechLineNumber": 2,
          "text": "His way to Dover. How is't, my lord? How look you?",
          "plainText": "His way to Dover How is't my lord How look you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-049",
      "type": "speech",
      "speaker": {
        "id": "cornwall",
        "name": "CORNWALL",
        "displayName": "Cornwall"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0090",
          "number": 90,
          "speechLineNumber": 1,
          "text": "I have receiv'd a hurt: follow me, lady.",
          "plainText": "I have receiv'd a hurt follow me lady",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0091",
          "number": 91,
          "speechLineNumber": 2,
          "text": "Turn out that eyeless villain. Throw this slave",
          "plainText": "Turn out that eyeless villain Throw this slave",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0092",
          "number": 92,
          "speechLineNumber": 3,
          "text": "Upon the dunghill. Regan, I bleed apace:",
          "plainText": "Upon the dunghill Regan I bleed apace",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0093",
          "number": 93,
          "speechLineNumber": 4,
          "text": "Untimely comes this hurt: give me your arm.",
          "plainText": "Untimely comes this hurt give me your arm",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-015",
      "type": "stage",
      "text": "[Exit Cornwall, led by Regan; Servants unbind Gloucester and lead him out.]"
    },
    {
      "id": "king-lear-3-7-speech-050",
      "type": "speech",
      "speaker": {
        "id": "second-servant",
        "name": "SECOND SERVANT",
        "displayName": "Second Servant"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0094",
          "number": 94,
          "speechLineNumber": 1,
          "text": "I'll never care what wickedness I do,",
          "plainText": "I'll never care what wickedness I do",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0095",
          "number": 95,
          "speechLineNumber": 2,
          "text": "If this man come to good.",
          "plainText": "If this man come to good",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-051",
      "type": "speech",
      "speaker": {
        "id": "third-servant",
        "name": "THIRD SERVANT",
        "displayName": "Third Servant"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0096",
          "number": 96,
          "speechLineNumber": 1,
          "text": "If she live long,",
          "plainText": "If she live long",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0097",
          "number": 97,
          "speechLineNumber": 2,
          "text": "And in the end meet the old course of death,",
          "plainText": "And in the end meet the old course of death",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0098",
          "number": 98,
          "speechLineNumber": 3,
          "text": "Women will all turn monsters.",
          "plainText": "Women will all turn monsters",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-052",
      "type": "speech",
      "speaker": {
        "id": "second-servant",
        "name": "SECOND SERVANT",
        "displayName": "Second Servant"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0099",
          "number": 99,
          "speechLineNumber": 1,
          "text": "Let's follow the old Earl, and get the bedlam",
          "plainText": "Let's follow the old Earl and get the bedlam",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0100",
          "number": 100,
          "speechLineNumber": 2,
          "text": "To lead him where he would: his roguish madness",
          "plainText": "To lead him where he would his roguish madness",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0101",
          "number": 101,
          "speechLineNumber": 3,
          "text": "Allows itself to anything.",
          "plainText": "Allows itself to anything",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-speech-053",
      "type": "speech",
      "speaker": {
        "id": "third-servant",
        "name": "THIRD SERVANT",
        "displayName": "Third Servant"
      },
      "lines": [
        {
          "id": "king-lear-3-7-line-0102",
          "number": 102,
          "speechLineNumber": 1,
          "text": "Go thou: I'll fetch some flax and whites of eggs",
          "plainText": "Go thou I'll fetch some flax and whites of eggs",
          "lineType": "verse"
        },
        {
          "id": "king-lear-3-7-line-0103",
          "number": 103,
          "speechLineNumber": 2,
          "text": "To apply to his bleeding face. Now heaven help him!",
          "plainText": "To apply to his bleeding face Now heaven help him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-3-7-stage-016",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}