  "scene": {
    "id": "king-lear-4-1",
    "act": 4,
    "scene": 1,
    "label": "Act 4, Scene 1",
    "title": "SCENE I. The heath",
    "location": "The heath",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "king-lear-4-1-stage-001",
      "type": "stage",
      "text": "Enter Edgar."
    },
    {
      "id": "king-lear-4-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Yet better thus, and known to be contemn'd,",
          "plainText": "Yet better thus and known to be contemn'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Than still contemn'd and flatter'd. To be worst,",
          "plainText": "Than still contemn'd and flatter'd To be worst",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "The lowest and most dejected thing of fortune,",
          "plainText": "The lowest and most dejected thing of fortune",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Stands still in esperance, lives not in fear:",
          "plainText": "Stands still in esperance lives not in fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "The lamentable change is from the best;",
          "plainText": "The lamentable change is from the best",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "The worst returns to laughter. Welcome then,",
          "plainText": "The worst returns to laughter Welcome then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Thou unsubstantial air that I embrace;",
          "plainText": "Thou unsubstantial air that I embrace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "The wretch that thou hast blown unto the worst",
          "plainText": "The wretch that thou hast blown unto the worst",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Owes nothing to thy blasts.",
          "plainText": "Owes nothing to thy blasts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-stage-002",
      "type": "stage",
      "text": "Enter Gloucester, led by an Old Man."
    },
    {
      "id": "king-lear-4-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "O my good lord, I have been your tenant, and your father's tenant these fourscore years.",
          "plainText": "O my good lord I have been your tenant and your father's tenant these fourscore years",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Away, get thee away; good friend, be gone.",
          "plainText": "Away get thee away good friend be gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Thy comforts can do me no good at all;",
          "plainText": "Thy comforts can do me no good at all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Thee they may hurt.",
          "plainText": "Thee they may hurt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "You cannot see your way.",
          "plainText": "You cannot see your way",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "I have no way, and therefore want no eyes;",
          "plainText": "I have no way and therefore want no eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "I stumbled when I saw. Full oft 'tis seen",
          "plainText": "I stumbled when I saw Full oft 'tis seen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "Our means secure us, and our mere defects",
          "plainText": "Our means secure us and our mere defects",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "Prove our commodities. O dear son Edgar,",
          "plainText": "Prove our commodities O dear son Edgar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0019",
          "number": 19,
          "speechLineNumber": 5,
          "text": "The food of thy abused father's wrath!",
          "plainText": "The food of thy abused father's wrath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0020",
          "number": 20,
          "speechLineNumber": 6,
          "text": "Might I but live to see thee in my touch,",
          "plainText": "Might I but live to see thee in my touch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0021",
          "number": 21,
          "speechLineNumber": 7,
          "text": "I'd say I had eyes again!",
          "plainText": "I'd say I had eyes again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "How now! Who's there?",
          "plainText": "How now Who's there",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "[Aside.] O gods! Who is't can say 'I am at the worst'?",
          "plainText": "Aside O gods Who is't can say 'I am at the worst'",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "I am worse than e'er I was.",
          "plainText": "I am worse than e'er I was",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "'Tis poor mad Tom.",
          "plainText": "'Tis poor mad Tom",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "[Aside.] And worse I may be yet. The worst is not",
          "plainText": "Aside And worse I may be yet The worst is not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "So long as we can say 'This is the worst.'",
          "plainText": "So long as we can say 'This is the worst'",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Fellow, where goest?",
          "plainText": "Fellow where goest",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Is it a beggar-man?",
          "plainText": "Is it a beggarman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Madman, and beggar too.",
          "plainText": "Madman and beggar too",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "He has some reason, else he could not beg.",
          "plainText": "He has some reason else he could not beg",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "I' the last night's storm I such a fellow saw;",
          "plainText": "I' the last night's storm I such a fellow saw",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "Which made me think a man a worm. My son",
          "plainText": "Which made me think a man a worm My son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "Came then into my mind, and yet my mind",
          "plainText": "Came then into my mind and yet my mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0035",
          "number": 35,
          "speechLineNumber": 5,
          "text": "Was then scarce friends with him.",
          "plainText": "Was then scarce friends with him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0036",
          "number": 36,
          "speechLineNumber": 6,
          "text": "I have heard more since.",
          "plainText": "I have heard more since",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0037",
          "number": 37,
          "speechLineNumber": 7,
          "text": "As flies to wanton boys are we to the gods,",
          "plainText": "As flies to wanton boys are we to the gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0038",
          "number": 38,
          "speechLineNumber": 8,
          "text": "They kill us for their sport.",
          "plainText": "They kill us for their sport",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "[Aside.] How should this be?",
          "plainText": "Aside How should this be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "Bad is the trade that must play fool to sorrow,",
          "plainText": "Bad is the trade that must play fool to sorrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "Angering itself and others. Bless thee, master!",
          "plainText": "Angering itself and others Bless thee master",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Is that the naked fellow?",
          "plainText": "Is that the naked fellow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Ay, my lord.",
          "plainText": "Ay my lord",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Then prithee get thee away. If for my sake",
          "plainText": "Then prithee get thee away If for my sake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "Thou wilt o'ertake us hence a mile or twain,",
          "plainText": "Thou wilt o'ertake us hence a mile or twain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "I' the way toward Dover, do it for ancient love,",
          "plainText": "I' the way toward Dover do it for ancient love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "And bring some covering for this naked soul,",
          "plainText": "And bring some covering for this naked soul",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0048",
          "number": 48,
          "speechLineNumber": 5,
          "text": "Which I'll entreat to lead me.",
          "plainText": "Which I'll entreat to lead me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Alack, sir, he is mad.",
          "plainText": "Alack sir he is mad",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "'Tis the time's plague when madmen lead the blind.",
          "plainText": "'Tis the time's plague when madmen lead the blind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "Do as I bid thee, or rather do thy pleasure;",
          "plainText": "Do as I bid thee or rather do thy pleasure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0052",
          "number": 52,
          "speechLineNumber": 3,
          "text": "Above the rest, be gone.",
          "plainText": "Above the rest be gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "I'll bring him the best 'parel that I have,",
          "plainText": "I'll bring him the best 'parel that I have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "Come on't what will.",
          "plainText": "Come on't what will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "king-lear-4-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Sirrah naked fellow.",
          "plainText": "Sirrah naked fellow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Poor Tom's a-cold.",
          "plainText": "Poor Tom's acold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0057",
          "number": 57,
          "speechLineNumber": 2,
          "text": "[Aside.] I cannot daub it further.",
          "plainText": "Aside I cannot daub it further",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Come hither, fellow.",
          "plainText": "Come hither fellow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "[Aside.] And yet I must. Bless thy sweet eyes, they bleed.",
          "plainText": "Aside And yet I must Bless thy sweet eyes they bleed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Know'st thou the way to Dover?",
          "plainText": "Know'st thou the way to Dover",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Both stile and gate, horseway and footpath. Poor Tom hath been scared out of his good wits. Bless thee, good man's son, from the foul fiend! Five fiends have been in poor Tom at once; of lust, as Obidicut; Hobbididence, prince of darkness; Mahu, of stealing; Modo, of murder; Flibbertigibbet, of mopping and mowing, who since possesses chambermaids and waiting women. So, bless thee, master!",
          "plainText": "Both stile and gate horseway and footpath Poor Tom hath been scared out of his good wits Bless thee good man's son from the foul fiend Five fiends have been in poor Tom at once of lust as Obidicut Hobbididence prince of darkness Mahu of stealing Modo of murder Flibbertigibbet of mopping and mowing who since possesses chambermaids and waiting women So bless thee master",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Here, take this purse, thou whom the heaven's plagues",
          "plainText": "Here take this purse thou whom the heaven's plagues",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "Have humbled to all strokes: that I am wretched",
          "plainText": "Have humbled to all strokes that I am wretched",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "Makes thee the happier. Heavens deal so still!",
          "plainText": "Makes thee the happier Heavens deal so still",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "Let the superfluous and lust-dieted man,",
          "plainText": "Let the superfluous and lustdieted man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0066",
          "number": 66,
          "speechLineNumber": 5,
          "text": "That slaves your ordinance, that will not see",
          "plainText": "That slaves your ordinance that will not see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0067",
          "number": 67,
          "speechLineNumber": 6,
          "text": "Because he does not feel, feel your power quickly;",
          "plainText": "Because he does not feel feel your power quickly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0068",
          "number": 68,
          "speechLineNumber": 7,
          "text": "So distribution should undo excess,",
          "plainText": "So distribution should undo excess",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0069",
          "number": 69,
          "speechLineNumber": 8,
          "text": "And each man have enough. Dost thou know Dover?",
          "plainText": "And each man have enough Dost thou know Dover",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Ay, master.",
          "plainText": "Ay master",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "There is a cliff, whose high and bending head",
          "plainText": "There is a cliff whose high and bending head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "Looks fearfully in the confined deep:",
          "plainText": "Looks fearfully in the confined deep",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "Bring me but to the very brim of it,",
          "plainText": "Bring me but to the very brim of it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0074",
          "number": 74,
          "speechLineNumber": 4,
          "text": "And I'll repair the misery thou dost bear",
          "plainText": "And I'll repair the misery thou dost bear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0075",
          "number": 75,
          "speechLineNumber": 5,
          "text": "With something rich about me: from that place",
          "plainText": "With something rich about me from that place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0076",
          "number": 76,
          "speechLineNumber": 6,
          "text": "I shall no leading need.",
          "plainText": "I shall no leading need",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-4-1-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Give me thy arm:",
          "plainText": "Give me thy arm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-lear-4-1-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "Poor Tom shall lead thee.",
          "plainText": "Poor Tom shall lead thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-lear-4-1-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}