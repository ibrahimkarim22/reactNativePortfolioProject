  "scene": {
    "id": "king-lear-5-2",
    "act": 5,
    "scene": 2,
    "label": "Act 5, Scene 2",
    "title": "SCENE II. A field between the two Camps",
    "location": "A field between the two Camps",
    "orderInPlay": 25
  },
  "content": [
    {
      "id": "king-lear-5-2-stage-001",
      "type": "stage",
      "text": "Alarum within. Enter with drum and colours, Lear, Cordelia and their Forces, and exeunt."
    },
    {
      "id": "king-lear-5-2-stage-002",
      "type": "stage",
      "text": "Enter Edgar and Gloucester."
    },
    {
      "id": "king-lear-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Here, father, take the shadow of this tree",
          "plainText": "Here father take the shadow of this tree",
          "lineType": "verse"
        },
        {
          "id": "king-lear-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "For your good host; pray that the right may thrive:",
          "plainText": "For your good host pray that the right may thrive",
          "lineType": "verse"
        },
        {
          "id": "king-lear-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "If ever I return to you again,",
          "plainText": "If ever I return to you again",
          "lineType": "verse"
        },
        {
          "id": "king-lear-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "I'll bring you comfort.",
          "plainText": "I'll bring you comfort",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Grace go with you, sir!",
          "plainText": "Grace go with you sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-5-2-stage-003",
      "type": "stage",
      "text": "[Exit Edgar.]"
    },
    {
      "id": "king-lear-5-2-stage-004",
      "type": "stage",
      "text": "Alarum and retreat within. Enter Edgar."
    },
    {
      "id": "king-lear-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Away, old man, give me thy hand, away!",
          "plainText": "Away old man give me thy hand away",
          "lineType": "verse"
        },
        {
          "id": "king-lear-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "King Lear hath lost, he and his daughter ta'en:",
          "plainText": "King Lear hath lost he and his daughter ta'en",
          "lineType": "verse"
        },
        {
          "id": "king-lear-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "Give me thy hand; come on!",
          "plainText": "Give me thy hand come on",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "No further, sir; a man may rot even here.",
          "plainText": "No further sir a man may rot even here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "edgar",
        "name": "EDGAR",
        "displayName": "Edgar"
      },
      "lines": [
        {
          "id": "king-lear-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "What, in ill thoughts again? Men must endure",
          "plainText": "What in ill thoughts again Men must endure",
          "lineType": "verse"
        },
        {
          "id": "king-lear-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "Their going hence, even as their coming hither;",
          "plainText": "Their going hence even as their coming hither",
          "lineType": "verse"
        },
        {
          "id": "king-lear-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "Ripeness is all. Come on.",
          "plainText": "Ripeness is all Come on",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-lear-5-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "king-lear-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "And that's true too.",
          "plainText": "And that's true too",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-lear-5-2-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}