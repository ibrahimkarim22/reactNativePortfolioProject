    "label": "Act 2, Scene 4",
    "title": "SCENE IV. A camp in Wales.",
    "location": "A camp in Wales.",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "king-richard-the-second-2-4-stage-001",
      "type": "stage",
      "text": "Enter Earl of Salisbury and a Welsh Captain."
    },
    {
      "id": "king-richard-the-second-2-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "king-richard-the-second-2-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "My Lord of Salisbury, we have stayed ten days",
          "plainText": "My Lord of Salisbury we have stayed ten days",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And hardly kept our countrymen together,",
          "plainText": "And hardly kept our countrymen together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And yet we hear no tidings from the King.",
          "plainText": "And yet we hear no tidings from the King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Therefore we will disperse ourselves. Farewell.",
          "plainText": "Therefore we will disperse ourselves Farewell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-2-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "salisbury",
        "name": "SALISBURY",
        "displayName": "Salisbury"
      },
      "lines": [
        {
          "id": "king-richard-the-second-2-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Stay yet another day, thou trusty Welshman.",
          "plainText": "Stay yet another day thou trusty Welshman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "The King reposeth all his confidence in thee.",
          "plainText": "The King reposeth all his confidence in thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-2-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "king-richard-the-second-2-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "'Tis thought the King is dead. We will not stay.",
          "plainText": "'Tis thought the King is dead We will not stay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "The bay trees in our country are all withered,",
          "plainText": "The bay trees in our country are all withered",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "And meteors fright the fixed stars of heaven;",
          "plainText": "And meteors fright the fixed stars of heaven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "The pale-faced moon looks bloody on the earth,",
          "plainText": "The palefaced moon looks bloody on the earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "And lean-looked prophets whisper fearful change;",
          "plainText": "And leanlooked prophets whisper fearful change",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "Rich men look sad, and ruffians dance and leap,",
          "plainText": "Rich men look sad and ruffians dance and leap",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0013",
          "number": 13,
          "speechLineNumber": 7,
          "text": "The one in fear to lose what they enjoy,",
          "plainText": "The one in fear to lose what they enjoy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0014",
          "number": 14,
          "speechLineNumber": 8,
          "text": "The other to enjoy by rage and war.",
          "plainText": "The other to enjoy by rage and war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0015",
          "number": 15,
          "speechLineNumber": 9,
          "text": "These signs forerun the death or fall of kings.",
          "plainText": "These signs forerun the death or fall of kings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0016",
          "number": 16,
          "speechLineNumber": 10,
          "text": "Farewell. Our countrymen are gone and fled,",
          "plainText": "Farewell Our countrymen are gone and fled",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0017",
          "number": 17,
          "speechLineNumber": 11,
          "text": "As well assured Richard their king is dead.",
          "plainText": "As well assured Richard their king is dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-2-4-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "king-richard-the-second-2-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "salisbury",
        "name": "SALISBURY",
        "displayName": "Salisbury"
      },
      "lines": [
        {
          "id": "king-richard-the-second-2-4-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Ah, Richard! With the eyes of heavy mind",
          "plainText": "Ah Richard With the eyes of heavy mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "I see thy glory like a shooting star",
          "plainText": "I see thy glory like a shooting star",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "Fall to the base earth from the firmament.",
          "plainText": "Fall to the base earth from the firmament",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "Thy sun sets weeping in the lowly west,",
          "plainText": "Thy sun sets weeping in the lowly west",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0022",
          "number": 22,
          "speechLineNumber": 5,
          "text": "Witnessing storms to come, woe, and unrest.",
          "plainText": "Witnessing storms to come woe and unrest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0023",
          "number": 23,
          "speechLineNumber": 6,
          "text": "Thy friends are fled, to wait upon thy foes,",
          "plainText": "Thy friends are fled to wait upon thy foes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-2-4-line-0024",
          "number": 24,
          "speechLineNumber": 7,
          "text": "And crossly to thy good all fortune goes.",
          "plainText": "And crossly to thy good all fortune goes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-2-4-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}