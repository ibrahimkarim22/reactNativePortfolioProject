  "scene": {
    "id": "king-richard-the-second-5-2",
    "act": 5,
    "scene": 2,
    "label": "Act 5, Scene 2",
    "title": "SCENE II. The same. A room in the Duke of York's palace.",
    "location": "The same. A room in the Duke of York's palace.",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "king-richard-the-second-5-2-stage-001",
      "type": "stage",
      "text": "Enter York and his Duchess."
    },
    {
      "id": "king-richard-the-second-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "My Lord, you told me you would tell the rest,",
          "plainText": "My Lord you told me you would tell the rest",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "When weeping made you break the story off",
          "plainText": "When weeping made you break the story off",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Of our two cousins' coming into London.",
          "plainText": "Of our two cousins' coming into London",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Where did I leave?",
          "plainText": "Where did I leave",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "At that sad stop, my lord,",
          "plainText": "At that sad stop my lord",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Where rude misgoverned hands from windows' tops",
          "plainText": "Where rude misgoverned hands from windows' tops",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "Threw dust and rubbish on King Richard's head.",
          "plainText": "Threw dust and rubbish on King Richard's head",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Then, as I said, the Duke, great Bolingbroke,",
          "plainText": "Then as I said the Duke great Bolingbroke",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Mounted upon a hot and fiery steed,",
          "plainText": "Mounted upon a hot and fiery steed",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Which his aspiring rider seemed to know,",
          "plainText": "Which his aspiring rider seemed to know",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "With slow but stately pace kept on his course,",
          "plainText": "With slow but stately pace kept on his course",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "Whilst all tongues cried \"God save thee, Bolingbroke!\"",
          "plainText": "Whilst all tongues cried God save thee Bolingbroke",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "You would have thought the very windows spake,",
          "plainText": "You would have thought the very windows spake",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 7,
          "text": "So many greedy looks of young and old",
          "plainText": "So many greedy looks of young and old",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 8,
          "text": "Through casements darted their desiring eyes",
          "plainText": "Through casements darted their desiring eyes",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 9,
          "text": "Upon his visage, and that all the walls",
          "plainText": "Upon his visage and that all the walls",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 10,
          "text": "With painted imagery had said at once",
          "plainText": "With painted imagery had said at once",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 11,
          "text": "\"Jesu preserve thee! Welcome, Bolingbroke!\"",
          "plainText": "Jesu preserve thee Welcome Bolingbroke",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 12,
          "text": "Whilst he, from the one side to the other turning,",
          "plainText": "Whilst he from the one side to the other turning",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0020",
          "number": 20,
          "speechLineNumber": 13,
          "text": "Bareheaded, lower than his proud steed's neck,",
          "plainText": "Bareheaded lower than his proud steed's neck",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0021",
          "number": 21,
          "speechLineNumber": 14,
          "text": "Bespake them thus, \"I thank you, countrymen.\"",
          "plainText": "Bespake them thus I thank you countrymen",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0022",
          "number": 22,
          "speechLineNumber": 15,
          "text": "And thus still doing, thus he passed along.",
          "plainText": "And thus still doing thus he passed along",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Alack, poor Richard! Where rode he the whilst?",
          "plainText": "Alack poor Richard Where rode he the whilst",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "As in a theatre the eyes of men",
          "plainText": "As in a theatre the eyes of men",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "After a well-graced actor leaves the stage,",
          "plainText": "After a wellgraced actor leaves the stage",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "Are idly bent on him that enters next,",
          "plainText": "Are idly bent on him that enters next",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "Thinking his prattle to be tedious,",
          "plainText": "Thinking his prattle to be tedious",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0028",
          "number": 28,
          "speechLineNumber": 5,
          "text": "Even so, or with much more contempt, men's eyes",
          "plainText": "Even so or with much more contempt men's eyes",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0029",
          "number": 29,
          "speechLineNumber": 6,
          "text": "Did scowl on gentle Richard. No man cried \"God save him!\"",
          "plainText": "Did scowl on gentle Richard No man cried God save him",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0030",
          "number": 30,
          "speechLineNumber": 7,
          "text": "No joyful tongue gave him his welcome home,",
          "plainText": "No joyful tongue gave him his welcome home",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0031",
          "number": 31,
          "speechLineNumber": 8,
          "text": "But dust was thrown upon his sacred head,",
          "plainText": "But dust was thrown upon his sacred head",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0032",
          "number": 32,
          "speechLineNumber": 9,
          "text": "Which with such gentle sorrow he shook off,",
          "plainText": "Which with such gentle sorrow he shook off",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0033",
          "number": 33,
          "speechLineNumber": 10,
          "text": "His face still combating with tears and smiles,",
          "plainText": "His face still combating with tears and smiles",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0034",
          "number": 34,
          "speechLineNumber": 11,
          "text": "The badges of his grief and patience,",
          "plainText": "The badges of his grief and patience",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0035",
          "number": 35,
          "speechLineNumber": 12,
          "text": "That had not God for some strong purpose, steeled",
          "plainText": "That had not God for some strong purpose steeled",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0036",
          "number": 36,
          "speechLineNumber": 13,
          "text": "The hearts of men, they must perforce have melted,",
          "plainText": "The hearts of men they must perforce have melted",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0037",
          "number": 37,
          "speechLineNumber": 14,
          "text": "And barbarism itself have pitied him.",
          "plainText": "And barbarism itself have pitied him",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0038",
          "number": 38,
          "speechLineNumber": 15,
          "text": "But heaven hath a hand in these events,",
          "plainText": "But heaven hath a hand in these events",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0039",
          "number": 39,
          "speechLineNumber": 16,
          "text": "To whose high will we bound our calm contents.",
          "plainText": "To whose high will we bound our calm contents",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0040",
          "number": 40,
          "speechLineNumber": 17,
          "text": "To Bolingbroke are we sworn subjects now,",
          "plainText": "To Bolingbroke are we sworn subjects now",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0041",
          "number": 41,
          "speechLineNumber": 18,
          "text": "Whose state and honour I for aye allow.",
          "plainText": "Whose state and honour I for aye allow",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-stage-002",
      "type": "stage",
      "text": "Enter Aumerle."
    },
    {
      "id": "king-richard-the-second-5-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Here comes my son Aumerle.",
          "plainText": "Here comes my son Aumerle",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Aumerle that was;",
          "plainText": "Aumerle that was",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "But that is lost for being Richard's friend,",
          "plainText": "But that is lost for being Richard's friend",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "And, madam, you must call him Rutland now.",
          "plainText": "And madam you must call him Rutland now",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "I am in Parliament pledge for his truth",
          "plainText": "I am in Parliament pledge for his truth",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0047",
          "number": 47,
          "speechLineNumber": 5,
          "text": "And lasting fealty to the new-made king.",
          "plainText": "And lasting fealty to the newmade king",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Welcome, my son. Who are the violets now",
          "plainText": "Welcome my son Who are the violets now",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "That strew the green lap of the new-come spring?",
          "plainText": "That strew the green lap of the newcome spring",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "aumerle",
        "name": "AUMERLE",
        "displayName": "Aumerle"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Madam, I know not, nor I greatly care not.",
          "plainText": "Madam I know not nor I greatly care not",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "God knows I had as lief be none as one.",
          "plainText": "God knows I had as lief be none as one",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Well, bear you well in this new spring of time,",
          "plainText": "Well bear you well in this new spring of time",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Lest you be cropped before you come to prime.",
          "plainText": "Lest you be cropped before you come to prime",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "What news from Oxford? Do these jousts and triumphs hold?",
          "plainText": "What news from Oxford Do these jousts and triumphs hold",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "aumerle",
        "name": "AUMERLE",
        "displayName": "Aumerle"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "For aught I know, my lord, they do.",
          "plainText": "For aught I know my lord they do",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "You will be there, I know.",
          "plainText": "You will be there I know",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "aumerle",
        "name": "AUMERLE",
        "displayName": "Aumerle"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "If God prevent not, I purpose so.",
          "plainText": "If God prevent not I purpose so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "What seal is that that hangs without thy bosom?",
          "plainText": "What seal is that that hangs without thy bosom",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "Yea, look'st thou pale? Let me see the writing.",
          "plainText": "Yea look'st thou pale Let me see the writing",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "aumerle",
        "name": "AUMERLE",
        "displayName": "Aumerle"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "My lord, 'tis nothing.",
          "plainText": "My lord 'tis nothing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "No matter, then, who see it.",
          "plainText": "No matter then who see it",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "I will be satisfied. Let me see the writing.",
          "plainText": "I will be satisfied Let me see the writing",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "aumerle",
        "name": "AUMERLE",
        "displayName": "Aumerle"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "I do beseech your Grace to pardon me.",
          "plainText": "I do beseech your Grace to pardon me",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "It is a matter of small consequence,",
          "plainText": "It is a matter of small consequence",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "Which for some reasons I would not have seen.",
          "plainText": "Which for some reasons I would not have seen",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Which for some reasons, sir, I mean to see.",
          "plainText": "Which for some reasons sir I mean to see",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "I fear, I fear—",
          "plainText": "I fear I fear",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "What should you fear?",
          "plainText": "What should you fear",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "'Tis nothing but some bond that he is entered into",
          "plainText": "'Tis nothing but some bond that he is entered into",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0070",
          "number": 70,
          "speechLineNumber": 3,
          "text": "For gay apparel 'gainst the triumph day.",
          "plainText": "For gay apparel 'gainst the triumph day",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Bound to himself? What doth he with a bond",
          "plainText": "Bound to himself What doth he with a bond",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "That he is bound to? Wife, thou art a fool.",
          "plainText": "That he is bound to Wife thou art a fool",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "Boy, let me see the writing.",
          "plainText": "Boy let me see the writing",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "aumerle",
        "name": "AUMERLE",
        "displayName": "Aumerle"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "I do beseech you, pardon me. I may not show it.",
          "plainText": "I do beseech you pardon me I may not show it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "I will be satisfied. Let me see it, I say.",
          "plainText": "I will be satisfied Let me see it I say",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-stage-003",
      "type": "stage",
      "text": "[Snatches it and reads it.]"
    },
    {
      "id": "king-richard-the-second-5-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "What is the matter, my lord?",
          "plainText": "What is the matter my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Ho! who is within there?",
          "plainText": "Ho who is within there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-stage-004",
      "type": "stage",
      "text": "Enter a Servant."
    },
    {
      "id": "king-richard-the-second-5-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "Why, what is it, my lord?",
          "plainText": "Why what is it my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Give me my boots, I say. Saddle my horse.",
          "plainText": "Give me my boots I say Saddle my horse",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0080",
          "number": 80,
          "speechLineNumber": 2,
          "text": "Now, by mine honour, by my life, my troth,",
          "plainText": "Now by mine honour by my life my troth",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0081",
          "number": 81,
          "speechLineNumber": 3,
          "text": "I will appeach the villain.",
          "plainText": "I will appeach the villain",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-stage-005",
      "type": "stage",
      "text": "[Exit Servant.]"
    },
    {
      "id": "king-richard-the-second-5-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "What is the matter?",
          "plainText": "What is the matter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "Peace, foolish woman.",
          "plainText": "Peace foolish woman",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "I will not peace. What is the matter, Aumerle?",
          "plainText": "I will not peace What is the matter Aumerle",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "aumerle",
        "name": "AUMERLE",
        "displayName": "Aumerle"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0085",
          "number": 85,
          "speechLineNumber": 1,
          "text": "Good mother, be content. It is no more",
          "plainText": "Good mother be content It is no more",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0086",
          "number": 86,
          "speechLineNumber": 2,
          "text": "Than my poor life must answer.",
          "plainText": "Than my poor life must answer",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0087",
          "number": 87,
          "speechLineNumber": 1,
          "text": "Thy life answer?",
          "plainText": "Thy life answer",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-033",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0088",
          "number": 88,
          "speechLineNumber": 1,
          "text": "Bring me my boots. I will unto the King.",
          "plainText": "Bring me my boots I will unto the King",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-stage-006",
      "type": "stage",
      "text": "Re-enter Servant with boots."
    },
    {
      "id": "king-richard-the-second-5-2-speech-034",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "Strike him, Aumerle! Poor boy, thou art amazed.",
          "plainText": "Strike him Aumerle Poor boy thou art amazed",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0090",
          "number": 90,
          "speechLineNumber": 2,
          "text": "[To Servant.]",
          "plainText": "To Servant",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0091",
          "number": 91,
          "speechLineNumber": 3,
          "text": "Hence, villain! Never more come in my sight.",
          "plainText": "Hence villain Never more come in my sight",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-stage-007",
      "type": "stage",
      "text": "[Exit Servant.]"
    },
    {
      "id": "king-richard-the-second-5-2-speech-035",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "Give me my boots, I say.",
          "plainText": "Give me my boots I say",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-036",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "Why, York, what wilt thou do?",
          "plainText": "Why York what wilt thou do",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0094",
          "number": 94,
          "speechLineNumber": 2,
          "text": "Wilt thou not hide the trespass of thine own?",
          "plainText": "Wilt thou not hide the trespass of thine own",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0095",
          "number": 95,
          "speechLineNumber": 3,
          "text": "Have we more sons? Or are we like to have?",
          "plainText": "Have we more sons Or are we like to have",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0096",
          "number": 96,
          "speechLineNumber": 4,
          "text": "Is not my teeming date drunk up with time?",
          "plainText": "Is not my teeming date drunk up with time",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0097",
          "number": 97,
          "speechLineNumber": 5,
          "text": "And wilt thou pluck my fair son from mine age",
          "plainText": "And wilt thou pluck my fair son from mine age",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0098",
          "number": 98,
          "speechLineNumber": 6,
          "text": "And rob me of a happy mother's name?",
          "plainText": "And rob me of a happy mother's name",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0099",
          "number": 99,
          "speechLineNumber": 7,
          "text": "Is he not like thee? Is he not thine own?",
          "plainText": "Is he not like thee Is he not thine own",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-037",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0100",
          "number": 100,
          "speechLineNumber": 1,
          "text": "Thou fond mad woman,",
          "plainText": "Thou fond mad woman",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0101",
          "number": 101,
          "speechLineNumber": 2,
          "text": "Wilt thou conceal this dark conspiracy?",
          "plainText": "Wilt thou conceal this dark conspiracy",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0102",
          "number": 102,
          "speechLineNumber": 3,
          "text": "A dozen of them here have ta'en the sacrament",
          "plainText": "A dozen of them here have ta'en the sacrament",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0103",
          "number": 103,
          "speechLineNumber": 4,
          "text": "And interchangeably set down their hands",
          "plainText": "And interchangeably set down their hands",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0104",
          "number": 104,
          "speechLineNumber": 5,
          "text": "To kill the King at Oxford.",
          "plainText": "To kill the King at Oxford",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-038",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0105",
          "number": 105,
          "speechLineNumber": 1,
          "text": "He shall be none;",
          "plainText": "He shall be none",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0106",
          "number": 106,
          "speechLineNumber": 2,
          "text": "We'll keep him here. Then what is that to him?",
          "plainText": "We'll keep him here Then what is that to him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-039",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0107",
          "number": 107,
          "speechLineNumber": 1,
          "text": "Away, fond woman! Were he twenty times my son,",
          "plainText": "Away fond woman Were he twenty times my son",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0108",
          "number": 108,
          "speechLineNumber": 2,
          "text": "I would appeach him.",
          "plainText": "I would appeach him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-040",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0109",
          "number": 109,
          "speechLineNumber": 1,
          "text": "Hadst thou groaned for him",
          "plainText": "Hadst thou groaned for him",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0110",
          "number": 110,
          "speechLineNumber": 2,
          "text": "As I have done, thou wouldst be more pitiful.",
          "plainText": "As I have done thou wouldst be more pitiful",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0111",
          "number": 111,
          "speechLineNumber": 3,
          "text": "But now I know thy mind: thou dost suspect",
          "plainText": "But now I know thy mind thou dost suspect",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0112",
          "number": 112,
          "speechLineNumber": 4,
          "text": "That I have been disloyal to thy bed",
          "plainText": "That I have been disloyal to thy bed",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0113",
          "number": 113,
          "speechLineNumber": 5,
          "text": "And that he is a bastard, not thy son.",
          "plainText": "And that he is a bastard not thy son",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0114",
          "number": 114,
          "speechLineNumber": 6,
          "text": "Sweet York, sweet husband, be not of that mind.",
          "plainText": "Sweet York sweet husband be not of that mind",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0115",
          "number": 115,
          "speechLineNumber": 7,
          "text": "He is as like thee as a man may be,",
          "plainText": "He is as like thee as a man may be",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0116",
          "number": 116,
          "speechLineNumber": 8,
          "text": "Not like to me, or any of my kin,",
          "plainText": "Not like to me or any of my kin",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0117",
          "number": 117,
          "speechLineNumber": 9,
          "text": "And yet I love him.",
          "plainText": "And yet I love him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-speech-041",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0118",
          "number": 118,
          "speechLineNumber": 1,
          "text": "Make way, unruly woman!",
          "plainText": "Make way unruly woman",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-2-stage-008",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "king-richard-the-second-5-2-speech-042",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-2-line-0119",
          "number": 119,
          "speechLineNumber": 1,
          "text": "After, Aumerle! Mount thee upon his horse!",
          "plainText": "After Aumerle Mount thee upon his horse",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0120",
          "number": 120,
          "speechLineNumber": 2,
          "text": "Spur post, and get before him to the King,",
          "plainText": "Spur post and get before him to the King",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0121",
          "number": 121,
          "speechLineNumber": 3,
          "text": "And beg thy pardon ere he do accuse thee.",
          "plainText": "And beg thy pardon ere he do accuse thee",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0122",
          "number": 122,
          "speechLineNumber": 4,
          "text": "I'll not be long behind. Though I be old,",
          "plainText": "I'll not be long behind Though I be old",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0123",
          "number": 123,
          "speechLineNumber": 5,
          "text": "I doubt not but to ride as fast as York.",
          "plainText": "I doubt not but to ride as fast as York",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0124",
          "number": 124,
          "speechLineNumber": 6,
          "text": "And never will I rise up from the ground",
          "plainText": "And never will I rise up from the ground",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-second-5-2-line-0125",
          "number": 125,
          "speechLineNumber": 7,
          "text": "Till Bolingbroke have pardoned thee. Away, be gone!",
