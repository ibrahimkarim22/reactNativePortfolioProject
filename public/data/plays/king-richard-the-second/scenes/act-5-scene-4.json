  "content": [
    {
      "id": "king-richard-the-second-5-4-stage-001",
      "type": "stage",
      "text": "Enter Exton and a Servant."
    },
    {
      "id": "king-richard-the-second-5-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "exton",
        "name": "EXTON",
        "displayName": "Exton"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Didst thou not mark the King, what words he spake:",
          "plainText": "Didst thou not mark the King what words he spake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "\"Have I no friend will rid me of this living fear?\"",
          "plainText": "Have I no friend will rid me of this living fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Was it not so?",
          "plainText": "Was it not so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "These were his very words.",
          "plainText": "These were his very words",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "exton",
        "name": "EXTON",
        "displayName": "Exton"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "\"Have I no friend?\" quoth he. He spake it twice",
          "plainText": "Have I no friend quoth he He spake it twice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-4-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "And urged it twice together, did he not?",
          "plainText": "And urged it twice together did he not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "He did.",
          "plainText": "He did",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "exton",
        "name": "EXTON",
        "displayName": "Exton"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "And speaking it, he wishtly looked on me,",
          "plainText": "And speaking it he wishtly looked on me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-4-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "As who should say \"I would thou wert the man",
          "plainText": "As who should say I would thou wert the man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-4-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "That would divorce this terror from my heart\",",
          "plainText": "That would divorce this terror from my heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-4-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Meaning the king at Pomfret. Come, let's go.",
          "plainText": "Meaning the king at Pomfret Come let's go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-4-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "I am the King's friend, and will rid his foe.",
          "plainText": "I am the King's friend and will rid his foe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-4-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
