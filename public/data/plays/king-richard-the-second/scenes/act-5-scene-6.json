    "title": "SCENE VI. Windsor. An Apartment in the Castle.",
    "location": "Windsor. An Apartment in the Castle.",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "king-richard-the-second-5-6-stage-001",
      "type": "stage",
      "text": "Flourish. Enter King Henry and York with Lords and Attendants."
    },
    {
      "id": "king-richard-the-second-5-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Kind uncle York, the latest news we hear",
          "plainText": "Kind uncle York the latest news we hear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Is that the rebels have consumed with fire",
          "plainText": "Is that the rebels have consumed with fire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Our town of Cicester in Gloucestershire,",
          "plainText": "Our town of Cicester in Gloucestershire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "But whether they be ta'en or slain we hear not.",
          "plainText": "But whether they be ta'en or slain we hear not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-6-stage-002",
      "type": "stage",
      "text": "Enter Northumberland."
    },
    {
      "id": "king-richard-the-second-5-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "northumberland",
        "name": "NORTHUMBERLAND",
        "displayName": "Northumberland"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "First, to thy sacred state wish I all happiness.",
          "plainText": "First to thy sacred state wish I all happiness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "The next news is: I have to London sent",
          "plainText": "The next news is I have to London sent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "The heads of Salisbury, Spencer, Blunt, and Kent.",
          "plainText": "The heads of Salisbury Spencer Blunt and Kent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "The manner of their taking may appear",
          "plainText": "The manner of their taking may appear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0009",
          "number": 9,
          "speechLineNumber": 5,
          "text": "At large discoursed in this paper here.",
          "plainText": "At large discoursed in this paper here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "We thank thee, gentle Percy, for thy pains,",
          "plainText": "We thank thee gentle Percy for thy pains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "And to thy worth will add right worthy gains.",
          "plainText": "And to thy worth will add right worthy gains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-6-stage-003",
      "type": "stage",
      "text": "Enter Fitzwater."
    },
    {
      "id": "king-richard-the-second-5-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "fitzwater",
        "name": "FITZWATER",
        "displayName": "Fitzwater"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "My lord, I have from Oxford sent to London",
          "plainText": "My lord I have from Oxford sent to London",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "The heads of Brocas and Sir Bennet Seely,",
          "plainText": "The heads of Brocas and Sir Bennet Seely",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Two of the dangerous consorted traitors",
          "plainText": "Two of the dangerous consorted traitors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "That sought at Oxford thy dire overthrow.",
          "plainText": "That sought at Oxford thy dire overthrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Thy pains, Fitzwater, shall not be forgot.",
          "plainText": "Thy pains Fitzwater shall not be forgot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Right noble is thy merit, well I wot.",
          "plainText": "Right noble is thy merit well I wot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-6-stage-004",
      "type": "stage",
      "text": "Enter Harry Percy with the Bishop of Carlisle."
    },
    {
      "id": "king-richard-the-second-5-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "percy",
        "name": "PERCY",
        "displayName": "Percy"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "The grand conspirator, Abbot of Westminster,",
          "plainText": "The grand conspirator Abbot of Westminster",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "With clog of conscience and sour melancholy,",
          "plainText": "With clog of conscience and sour melancholy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "Hath yielded up his body to the grave.",
          "plainText": "Hath yielded up his body to the grave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "But here is Carlisle living, to abide",
          "plainText": "But here is Carlisle living to abide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0022",
          "number": 22,
          "speechLineNumber": 5,
          "text": "Thy kingly doom and sentence of his pride.",
          "plainText": "Thy kingly doom and sentence of his pride",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-6-speech-007",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Carlisle, this is your doom:",
          "plainText": "Carlisle this is your doom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Choose out some secret place, some reverend room,",
          "plainText": "Choose out some secret place some reverend room",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "More than thou hast, and with it joy thy life.",
          "plainText": "More than thou hast and with it joy thy life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "So as thou liv'st in peace, die free from strife;",
          "plainText": "So as thou liv'st in peace die free from strife",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "For though mine enemy thou hast ever been,",
          "plainText": "For though mine enemy thou hast ever been",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0028",
          "number": 28,
          "speechLineNumber": 6,
          "text": "High sparks of honour in thee have I seen.",
          "plainText": "High sparks of honour in thee have I seen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-6-stage-005",
      "type": "stage",
      "text": "Enter Exton with attendants, bearing a coffin."
    },
    {
      "id": "king-richard-the-second-5-6-speech-008",
      "type": "speech",
      "speaker": {
        "id": "exton",
        "name": "EXTON",
        "displayName": "Exton"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Great king, within this coffin I present",
          "plainText": "Great king within this coffin I present",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "Thy buried fear. Herein all breathless lies",
          "plainText": "Thy buried fear Herein all breathless lies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "The mightiest of thy greatest enemies,",
          "plainText": "The mightiest of thy greatest enemies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "Richard of Bordeaux, by me hither brought.",
          "plainText": "Richard of Bordeaux by me hither brought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-6-speech-009",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Exton, I thank thee not, for thou hast wrought",
          "plainText": "Exton I thank thee not for thou hast wrought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "A deed of slander with thy fatal hand",
          "plainText": "A deed of slander with thy fatal hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Upon my head and all this famous land.",
          "plainText": "Upon my head and all this famous land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-6-speech-010",
      "type": "speech",
      "speaker": {
        "id": "exton",
        "name": "EXTON",
        "displayName": "Exton"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "From your own mouth, my lord, did I this deed.",
          "plainText": "From your own mouth my lord did I this deed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-second-5-6-speech-011",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "king-richard-the-second-5-6-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "They love not poison that do poison need,",
          "plainText": "They love not poison that do poison need",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Nor do I thee. Though I did wish him dead,",
          "plainText": "Nor do I thee Though I did wish him dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "I hate the murderer, love him murdered.",
          "plainText": "I hate the murderer love him murdered",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "The guilt of conscience take thou for thy labour,",
          "plainText": "The guilt of conscience take thou for thy labour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0041",
          "number": 41,
          "speechLineNumber": 5,
          "text": "But neither my good word nor princely favour.",
          "plainText": "But neither my good word nor princely favour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0042",
          "number": 42,
          "speechLineNumber": 6,
          "text": "With Cain go wander thorough shades of night,",
          "plainText": "With Cain go wander thorough shades of night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0043",
          "number": 43,
          "speechLineNumber": 7,
          "text": "And never show thy head by day nor light.",
          "plainText": "And never show thy head by day nor light",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0044",
          "number": 44,
          "speechLineNumber": 8,
          "text": "Lords, I protest my soul is full of woe",
          "plainText": "Lords I protest my soul is full of woe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0045",
          "number": 45,
          "speechLineNumber": 9,
          "text": "That blood should sprinkle me to make me grow.",
          "plainText": "That blood should sprinkle me to make me grow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0046",
          "number": 46,
          "speechLineNumber": 10,
          "text": "Come, mourn with me for what I do lament,",
          "plainText": "Come mourn with me for what I do lament",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0047",
          "number": 47,
          "speechLineNumber": 11,
          "text": "And put on sullen black incontinent.",
          "plainText": "And put on sullen black incontinent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0048",
          "number": 48,
          "speechLineNumber": 12,
          "text": "I'll make a voyage to the Holy Land",
          "plainText": "I'll make a voyage to the Holy Land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-second-5-6-line-0049",
          "number": 49,
          "speechLineNumber": 13,
          "text": "To wash this blood off from my guilty hand.",
          "plainText": "To wash this blood off from my guilty hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
