  "scene": {
    "id": "king-richard-the-third-2-3",
    "act": 2,
    "scene": 3,
    "label": "Act 2, Scene 3",
    "title": "SCENE III. London. A street",
    "location": "London. A street",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "king-richard-the-third-2-3-stage-001",
      "type": "stage",
      "text": "Enter one Citizen at one door, and Another at the other."
    },
    {
      "id": "king-richard-the-third-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Good morrow, neighbour, whither away so fast?",
          "plainText": "Good morrow neighbour whither away so fast",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "second-citizen",
        "name": "SECOND CITIZEN",
        "displayName": "Second Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "I promise you, I scarcely know myself.",
          "plainText": "I promise you I scarcely know myself",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Hear you the news abroad?",
          "plainText": "Hear you the news abroad",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Yes, that the King is dead.",
          "plainText": "Yes that the King is dead",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-citizen",
        "name": "SECOND CITIZEN",
        "displayName": "Second Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Ill news, by'r Lady; seldom comes the better.",
          "plainText": "Ill news by'r Lady seldom comes the better",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "I fear, I fear 'twill prove a giddy world.",
          "plainText": "I fear I fear 'twill prove a giddy world",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-stage-002",
      "type": "stage",
      "text": "Enter another Citizen."
    },
    {
      "id": "king-richard-the-third-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Neighbours, God speed.",
          "plainText": "Neighbours God speed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Give you good morrow, sir.",
          "plainText": "Give you good morrow sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Doth the news hold of good King Edward's death?",
          "plainText": "Doth the news hold of good King Edward's death",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "second-citizen",
        "name": "SECOND CITIZEN",
        "displayName": "Second Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Ay, sir, it is too true, God help the while.",
          "plainText": "Ay sir it is too true God help the while",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Then, masters, look to see a troublous world.",
          "plainText": "Then masters look to see a troublous world",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "No, no; by God's good grace, his son shall reign.",
          "plainText": "No no by God's good grace his son shall reign",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Woe to that land that's governed by a child.",
          "plainText": "Woe to that land that's governed by a child",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "second-citizen",
        "name": "SECOND CITIZEN",
        "displayName": "Second Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "In him there is a hope of government,",
          "plainText": "In him there is a hope of government",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Which, in his nonage, council under him,",
          "plainText": "Which in his nonage council under him",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "And, in his full and ripened years, himself,",
          "plainText": "And in his full and ripened years himself",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "No doubt shall then, and till then, govern well.",
          "plainText": "No doubt shall then and till then govern well",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "So stood the state when Henry the Sixth",
          "plainText": "So stood the state when Henry the Sixth",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Was crowned in Paris but at nine months old.",
          "plainText": "Was crowned in Paris but at nine months old",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Stood the state so? No, no, good friends, God wot.",
          "plainText": "Stood the state so No no good friends God wot",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "For then this land was famously enriched",
          "plainText": "For then this land was famously enriched",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "With politic grave counsel; then the King",
          "plainText": "With politic grave counsel then the King",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Had virtuous uncles to protect his Grace.",
          "plainText": "Had virtuous uncles to protect his Grace",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Why, so hath this, both by his father and mother.",
          "plainText": "Why so hath this both by his father and mother",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Better it were they all came by his father,",
          "plainText": "Better it were they all came by his father",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Or by his father there were none at all,",
          "plainText": "Or by his father there were none at all",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "For emulation who shall now be nearest",
          "plainText": "For emulation who shall now be nearest",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "Will touch us all too near, if God prevent not.",
          "plainText": "Will touch us all too near if God prevent not",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "O, full of danger is the Duke of Gloucester,",
          "plainText": "O full of danger is the Duke of Gloucester",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "And the Queen's sons and brothers haught and proud;",
          "plainText": "And the Queen's sons and brothers haught and proud",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 7,
          "text": "And were they to be ruled, and not to rule,",
          "plainText": "And were they to be ruled and not to rule",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 8,
          "text": "This sickly land might solace as before.",
          "plainText": "This sickly land might solace as before",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "first-citizen",
        "name": "FIRST CITIZEN",
        "displayName": "First Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Come, come, we fear the worst; all will be well.",
          "plainText": "Come come we fear the worst all will be well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "When clouds are seen, wise men put on their cloaks;",
          "plainText": "When clouds are seen wise men put on their cloaks",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "When great leaves fall, then winter is at hand;",
          "plainText": "When great leaves fall then winter is at hand",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "When the sun sets, who doth not look for night?",
          "plainText": "When the sun sets who doth not look for night",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "Untimely storms make men expect a dearth.",
          "plainText": "Untimely storms make men expect a dearth",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "All may be well; but, if God sort it so,",
          "plainText": "All may be well but if God sort it so",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0039",
          "number": 39,
          "speechLineNumber": 6,
          "text": "'Tis more than we deserve or I expect.",
          "plainText": "'Tis more than we deserve or I expect",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "second-citizen",
        "name": "SECOND CITIZEN",
        "displayName": "Second Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Truly, the hearts of men are full of fear.",
          "plainText": "Truly the hearts of men are full of fear",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "You cannot reason almost with a man",
          "plainText": "You cannot reason almost with a man",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "That looks not heavily and full of dread.",
          "plainText": "That looks not heavily and full of dread",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Before the days of change, still is it so.",
          "plainText": "Before the days of change still is it so",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "By a divine instinct men's minds mistrust",
          "plainText": "By a divine instinct men's minds mistrust",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Ensuing danger, as by proof we see",
          "plainText": "Ensuing danger as by proof we see",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "The water swell before a boist'rous storm.",
          "plainText": "The water swell before a boist'rous storm",
          "lineType": "verse"
        },
        {
          "id": "king-richard-the-third-2-3-line-0047",
          "number": 47,
          "speechLineNumber": 5,
          "text": "But leave it all to God. Whither away?",
          "plainText": "But leave it all to God Whither away",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "second-citizen",
        "name": "SECOND CITIZEN",
        "displayName": "Second Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Marry, we were sent for to the Justices.",
          "plainText": "Marry we were sent for to the Justices",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "third-citizen",
        "name": "THIRD CITIZEN",
        "displayName": "Third Citizen"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-3-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "And so was I. I'll bear you company.",
          "plainText": "And so was I I'll bear you company",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}