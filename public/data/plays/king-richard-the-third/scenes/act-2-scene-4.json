  },
  "content": [
    {
      "id": "king-richard-the-third-2-4-stage-001",
      "type": "stage",
      "text": "Enter the Archbishop of York, the young Duke of York, Queen Elizabeth and the Duchess of York."
    },
    {
      "id": "king-richard-the-third-2-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "archbishop",
        "name": "ARCHBISHOP",
        "displayName": "Archbishop"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Last night, I hear, they lay at Stony Stratford,",
          "plainText": "Last night I hear they lay at Stony Stratford",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And at Northampton they do rest tonight.",
          "plainText": "And at Northampton they do rest tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Tomorrow or next day they will be here.",
          "plainText": "Tomorrow or next day they will be here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I long with all my heart to see the Prince.",
          "plainText": "I long with all my heart to see the Prince",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "I hope he is much grown since last I saw him.",
          "plainText": "I hope he is much grown since last I saw him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "queen-elizabeth",
        "name": "QUEEN ELIZABETH",
        "displayName": "Queen Elizabeth"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "But I hear no; they say my son of York",
          "plainText": "But I hear no they say my son of York",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Has almost overta'en him in his growth.",
          "plainText": "Has almost overta'en him in his growth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Ay, mother, but I would not have it so.",
          "plainText": "Ay mother but I would not have it so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Why, my good cousin? It is good to grow.",
          "plainText": "Why my good cousin It is good to grow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Grandam, one night as we did sit at supper,",
          "plainText": "Grandam one night as we did sit at supper",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "My uncle Rivers talked how I did grow",
          "plainText": "My uncle Rivers talked how I did grow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "More than my brother. \"Ay,\" quoth my uncle Gloucester,",
          "plainText": "More than my brother Ay quoth my uncle Gloucester",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "\"Small herbs have grace; great weeds do grow apace.\"",
          "plainText": "Small herbs have grace great weeds do grow apace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0014",
          "number": 14,
          "speechLineNumber": 5,
          "text": "And since, methinks I would not grow so fast,",
          "plainText": "And since methinks I would not grow so fast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0015",
          "number": 15,
          "speechLineNumber": 6,
          "text": "Because sweet flowers are slow and weeds make haste.",
          "plainText": "Because sweet flowers are slow and weeds make haste",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Good faith, good faith, the saying did not hold",
          "plainText": "Good faith good faith the saying did not hold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "In him that did object the same to thee!",
          "plainText": "In him that did object the same to thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "He was the wretched'st thing when he was young,",
          "plainText": "He was the wretched'st thing when he was young",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "So long a-growing and so leisurely,",
          "plainText": "So long agrowing and so leisurely",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "That if his rule were true, he should be gracious.",
          "plainText": "That if his rule were true he should be gracious",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "archbishop",
        "name": "ARCHBISHOP",
        "displayName": "Archbishop"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "And so no doubt he is, my gracious madam.",
          "plainText": "And so no doubt he is my gracious madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I hope he is, but yet let mothers doubt.",
          "plainText": "I hope he is but yet let mothers doubt",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Now, by my troth, if I had been remembered,",
          "plainText": "Now by my troth if I had been remembered",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "I could have given my uncle's Grace a flout",
          "plainText": "I could have given my uncle's Grace a flout",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "To touch his growth nearer than he touched mine.",
          "plainText": "To touch his growth nearer than he touched mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "How, my young York? I prithee let me hear it.",
          "plainText": "How my young York I prithee let me hear it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Marry, they say my uncle grew so fast",
          "plainText": "Marry they say my uncle grew so fast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "That he could gnaw a crust at two hours old.",
          "plainText": "That he could gnaw a crust at two hours old",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "'Twas full two years ere I could get a tooth.",
          "plainText": "'Twas full two years ere I could get a tooth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "Grandam, this would have been a biting jest.",
          "plainText": "Grandam this would have been a biting jest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "I prithee, pretty York, who told thee this?",
          "plainText": "I prithee pretty York who told thee this",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Grandam, his nurse.",
          "plainText": "Grandam his nurse",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "His nurse? Why she was dead ere thou wast born.",
          "plainText": "His nurse Why she was dead ere thou wast born",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "If 'twere not she, I cannot tell who told me.",
          "plainText": "If 'twere not she I cannot tell who told me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "queen-elizabeth",
        "name": "QUEEN ELIZABETH",
        "displayName": "Queen Elizabeth"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "A parlous boy! Go to, you are too shrewd.",
          "plainText": "A parlous boy Go to you are too shrewd",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Good madam, be not angry with the child.",
          "plainText": "Good madam be not angry with the child",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "queen-elizabeth",
        "name": "QUEEN ELIZABETH",
        "displayName": "Queen Elizabeth"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Pitchers have ears.",
          "plainText": "Pitchers have ears",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-stage-002",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "king-richard-the-third-2-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "archbishop",
        "name": "ARCHBISHOP",
        "displayName": "Archbishop"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Here comes a messenger. What news?",
          "plainText": "Here comes a messenger What news",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Such news, my lord, as grieves me to report.",
          "plainText": "Such news my lord as grieves me to report",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "queen-elizabeth",
        "name": "QUEEN ELIZABETH",
        "displayName": "Queen Elizabeth"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "How doth the Prince?",
          "plainText": "How doth the Prince",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Well, madam, and in health.",
          "plainText": "Well madam and in health",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "What is thy news?",
          "plainText": "What is thy news",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-025",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Lord Rivers and Lord Grey are sent to Pomfret,",
          "plainText": "Lord Rivers and Lord Grey are sent to Pomfret",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "And, with them Sir Thomas Vaughan, prisoners.",
          "plainText": "And with them Sir Thomas Vaughan prisoners",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-026",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Who hath committed them?",
          "plainText": "Who hath committed them",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-027",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "The mighty Dukes, Gloucester and Buckingham.",
          "plainText": "The mighty Dukes Gloucester and Buckingham",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-028",
      "type": "speech",
      "speaker": {
        "id": "archbishop",
        "name": "ARCHBISHOP",
        "displayName": "Archbishop"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "For what offence?",
          "plainText": "For what offence",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-029",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "The sum of all I can, I have disclosed.",
          "plainText": "The sum of all I can I have disclosed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "Why or for what the nobles were committed",
          "plainText": "Why or for what the nobles were committed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "Is all unknown to me, my gracious lord.",
          "plainText": "Is all unknown to me my gracious lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-030",
      "type": "speech",
      "speaker": {
        "id": "queen-elizabeth",
        "name": "QUEEN ELIZABETH",
        "displayName": "Queen Elizabeth"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Ah me! I see the ruin of my house.",
          "plainText": "Ah me I see the ruin of my house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "The tiger now hath seized the gentle hind;",
          "plainText": "The tiger now hath seized the gentle hind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "Insulting tyranny begins to jut",
          "plainText": "Insulting tyranny begins to jut",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "Upon the innocent and aweless throne.",
          "plainText": "Upon the innocent and aweless throne",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0055",
          "number": 55,
          "speechLineNumber": 5,
          "text": "Welcome, destruction, blood, and massacre;",
          "plainText": "Welcome destruction blood and massacre",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0056",
          "number": 56,
          "speechLineNumber": 6,
          "text": "I see, as in a map, the end of all.",
          "plainText": "I see as in a map the end of all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-031",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Accursed and unquiet wrangling days,",
          "plainText": "Accursed and unquiet wrangling days",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "How many of you have mine eyes beheld?",
          "plainText": "How many of you have mine eyes beheld",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0059",
          "number": 59,
          "speechLineNumber": 3,
          "text": "My husband lost his life to get the crown,",
          "plainText": "My husband lost his life to get the crown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0060",
          "number": 60,
          "speechLineNumber": 4,
          "text": "And often up and down my sons were tossed",
          "plainText": "And often up and down my sons were tossed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0061",
          "number": 61,
          "speechLineNumber": 5,
          "text": "For me to joy and weep their gain and loss.",
          "plainText": "For me to joy and weep their gain and loss",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0062",
          "number": 62,
          "speechLineNumber": 6,
          "text": "And being seated, and domestic broils",
          "plainText": "And being seated and domestic broils",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0063",
          "number": 63,
          "speechLineNumber": 7,
          "text": "Clean over-blown, themselves, the conquerors",
          "plainText": "Clean overblown themselves the conquerors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0064",
          "number": 64,
          "speechLineNumber": 8,
          "text": "Make war upon themselves, brother to brother,",
          "plainText": "Make war upon themselves brother to brother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0065",
          "number": 65,
          "speechLineNumber": 9,
          "text": "Blood to blood, self against self. O, preposterous",
          "plainText": "Blood to blood self against self O preposterous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0066",
          "number": 66,
          "speechLineNumber": 10,
          "text": "And frantic outrage, end thy damned spleen,",
          "plainText": "And frantic outrage end thy damned spleen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0067",
          "number": 67,
          "speechLineNumber": 11,
          "text": "Or let me die, to look on earth no more.",
          "plainText": "Or let me die to look on earth no more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-032",
      "type": "speech",
      "speaker": {
        "id": "queen-elizabeth",
        "name": "QUEEN ELIZABETH",
        "displayName": "Queen Elizabeth"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Come, come, my boy. We will to sanctuary.",
          "plainText": "Come come my boy We will to sanctuary",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "Madam, farewell.",
          "plainText": "Madam farewell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-033",
      "type": "speech",
      "speaker": {
        "id": "duchess",
        "name": "DUCHESS",
        "displayName": "Duchess"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Stay, I will go with you.",
          "plainText": "Stay I will go with you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-034",
      "type": "speech",
      "speaker": {
        "id": "queen-elizabeth",
        "name": "QUEEN ELIZABETH",
        "displayName": "Queen Elizabeth"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "You have no cause.",
          "plainText": "You have no cause",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-speech-035",
      "type": "speech",
      "speaker": {
        "id": "archbishop",
        "name": "ARCHBISHOP",
        "displayName": "Archbishop"
      },
      "lines": [
        {
          "id": "king-richard-the-third-2-4-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "[To the Queen.] My gracious lady, go,",
          "plainText": "To the Queen My gracious lady go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "And thither bear your treasure and your goods.",
          "plainText": "And thither bear your treasure and your goods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0074",
          "number": 74,
          "speechLineNumber": 3,
          "text": "For my part, I'll resign unto your Grace",
          "plainText": "For my part I'll resign unto your Grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0075",
          "number": 75,
          "speechLineNumber": 4,
          "text": "The seal I keep; and so betide to me",
          "plainText": "The seal I keep and so betide to me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0076",
          "number": 76,
          "speechLineNumber": 5,
          "text": "As well I tender you and all of yours.",
          "plainText": "As well I tender you and all of yours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-2-4-line-0077",
          "number": 77,
          "speechLineNumber": 6,
          "text": "Go, I'll conduct you to the sanctuary.",
          "plainText": "Go I'll conduct you to the sanctuary",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-2-4-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
