    "title": "SCENE V. A Room in Lord Stanley's house",
    "location": "A Room in Lord Stanley's house",
    "orderInPlay": 20
  },
  "content": [
    {
      "id": "king-richard-the-third-4-5-stage-001",
      "type": "stage",
      "text": "Enter Stanley Earl of Derby and Sir Christopher Urswick."
    },
    {
      "id": "king-richard-the-third-4-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "stanley",
        "name": "STANLEY",
        "displayName": "Stanley"
      },
      "lines": [
        {
          "id": "king-richard-the-third-4-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Sir Christopher, tell Richmond this from me:",
          "plainText": "Sir Christopher tell Richmond this from me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "That in the sty of the most deadly boar",
          "plainText": "That in the sty of the most deadly boar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "My son George Stanley is franked up in hold;",
          "plainText": "My son George Stanley is franked up in hold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "If I revolt, off goes young George's head;",
          "plainText": "If I revolt off goes young George's head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "The fear of that holds off my present aid.",
          "plainText": "The fear of that holds off my present aid",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "So get thee gone. Commend me to thy lord;",
          "plainText": "So get thee gone Commend me to thy lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Withal say that the Queen hath heartily consented",
          "plainText": "Withal say that the Queen hath heartily consented",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "He should espouse Elizabeth her daughter.",
          "plainText": "He should espouse Elizabeth her daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "But tell me, where is princely Richmond now?",
          "plainText": "But tell me where is princely Richmond now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-4-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "christopher",
        "name": "CHRISTOPHER",
        "displayName": "Christopher"
      },
      "lines": [
        {
          "id": "king-richard-the-third-4-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "At Pembroke, or at Ha'rfordwest in Wales.",
          "plainText": "At Pembroke or at Ha'rfordwest in Wales",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-4-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "stanley",
        "name": "STANLEY",
        "displayName": "Stanley"
      },
      "lines": [
        {
          "id": "king-richard-the-third-4-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "What men of name resort to him?",
          "plainText": "What men of name resort to him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-4-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "christopher",
        "name": "CHRISTOPHER",
        "displayName": "Christopher"
      },
      "lines": [
        {
          "id": "king-richard-the-third-4-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Sir Walter Herbert, a renowned soldier;",
          "plainText": "Sir Walter Herbert a renowned soldier",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Sir Gilbert Talbot, Sir William Stanley,",
          "plainText": "Sir Gilbert Talbot Sir William Stanley",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Oxford, redoubted Pembroke, Sir James Blunt,",
          "plainText": "Oxford redoubted Pembroke Sir James Blunt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "And Rice ap Thomas, with a valiant crew,",
          "plainText": "And Rice ap Thomas with a valiant crew",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "And many other of great name and worth;",
          "plainText": "And many other of great name and worth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "And towards London do they bend their power,",
          "plainText": "And towards London do they bend their power",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0018",
          "number": 18,
          "speechLineNumber": 7,
          "text": "If by the way they be not fought withal.",
          "plainText": "If by the way they be not fought withal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-4-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "stanley",
        "name": "STANLEY",
        "displayName": "Stanley"
      },
      "lines": [
        {
          "id": "king-richard-the-third-4-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Well, hie thee to thy lord; I kiss his hand.",
          "plainText": "Well hie thee to thy lord I kiss his hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "My letter will resolve him of my mind.",
          "plainText": "My letter will resolve him of my mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-4-5-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Farewell.",
          "plainText": "Farewell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-4-5-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}