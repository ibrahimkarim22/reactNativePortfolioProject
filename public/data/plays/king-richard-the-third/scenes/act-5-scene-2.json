  },
  "content": [
    {
      "id": "king-richard-the-third-5-2-stage-001",
      "type": "stage",
      "text": "Enter Richmond, Oxford, Blunt, Herbert, and others, with drum and colours."
    },
    {
      "id": "king-richard-the-third-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "richmond",
        "name": "RICHMOND",
        "displayName": "Richmond"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Fellows in arms, and my most loving friends,",
          "plainText": "Fellows in arms and my most loving friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Bruised underneath the yoke of tyranny,",
          "plainText": "Bruised underneath the yoke of tyranny",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Thus far into the bowels of the land",
          "plainText": "Thus far into the bowels of the land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Have we marched on without impediment;",
          "plainText": "Have we marched on without impediment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "And here receive we from our father Stanley",
          "plainText": "And here receive we from our father Stanley",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Lines of fair comfort and encouragement.",
          "plainText": "Lines of fair comfort and encouragement",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "The wretched, bloody, and usurping boar,",
          "plainText": "The wretched bloody and usurping boar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "That spoiled your summer fields and fruitful vines,",
          "plainText": "That spoiled your summer fields and fruitful vines",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Swills your warm blood like wash, and makes his trough",
          "plainText": "Swills your warm blood like wash and makes his trough",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "In your embowelled bosoms—this foul swine",
          "plainText": "In your embowelled bosomsthis foul swine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Is now even in the centre of this isle,",
          "plainText": "Is now even in the centre of this isle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "Near to the town of Leicester, as we learn.",
          "plainText": "Near to the town of Leicester as we learn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "From Tamworth thither is but one day's march.",
          "plainText": "From Tamworth thither is but one day's march",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "In God's name, cheerly on, courageous friends,",
          "plainText": "In God's name cheerly on courageous friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "To reap the harvest of perpetual peace",
          "plainText": "To reap the harvest of perpetual peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "By this one bloody trial of sharp war.",
          "plainText": "By this one bloody trial of sharp war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "oxford",
        "name": "OXFORD",
        "displayName": "Oxford"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Every man's conscience is a thousand men,",
          "plainText": "Every man's conscience is a thousand men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "To fight against that guilty homicide.",
          "plainText": "To fight against that guilty homicide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "herbert",
        "name": "HERBERT",
        "displayName": "Herbert"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I doubt not but his friends will turn to us.",
          "plainText": "I doubt not but his friends will turn to us",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "blunt",
        "name": "BLUNT",
        "displayName": "Blunt"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "He hath no friends but what are friends for fear,",
          "plainText": "He hath no friends but what are friends for fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Which in his dearest need will fly from him.",
          "plainText": "Which in his dearest need will fly from him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "richmond",
        "name": "RICHMOND",
        "displayName": "Richmond"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "All for our vantage. Then in God's name, march.",
          "plainText": "All for our vantage Then in God's name march",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "True hope is swift, and flies with swallow's wings;",
          "plainText": "True hope is swift and flies with swallow's wings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-2-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "Kings it makes gods, and meaner creatures kings.",
          "plainText": "Kings it makes gods and meaner creatures kings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-2-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}