  "scene": {
    "id": "king-richard-the-third-5-5",
    "act": 5,
    "scene": 5,
    "label": "Act 5, Scene 5",
    "title": "SCENE V. Another part of the Field",
    "location": "Another part of the Field",
    "orderInPlay": 25
  },
  "content": [
    {
      "id": "king-richard-the-third-5-5-stage-001",
      "type": "stage",
      "text": "Alarum. Enter King Richard and Richmond. They fight. Richard is slain. Then retreat being sounded. Richmond exits, and Richard's body is carried off. Flourish. Enter Richmond, Stanley Earl of Derby, bearing the crown, with other Lords and Soldiers."
    },
    {
      "id": "king-richard-the-third-5-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "richmond",
        "name": "RICHMOND",
        "displayName": "Richmond"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "God and your arms be praised, victorious friends!",
          "plainText": "God and your arms be praised victorious friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The day is ours, the bloody dog is dead.",
          "plainText": "The day is ours the bloody dog is dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "stanley",
        "name": "STANLEY",
        "displayName": "Stanley"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Courageous Richmond, well hast thou acquit thee!",
          "plainText": "Courageous Richmond well hast thou acquit thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Lo, here, this long-usurped royalty",
          "plainText": "Lo here this longusurped royalty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "From the dead temples of this bloody wretch",
          "plainText": "From the dead temples of this bloody wretch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "Have I plucked off, to grace thy brows withal.",
          "plainText": "Have I plucked off to grace thy brows withal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0007",
          "number": 7,
          "speechLineNumber": 5,
          "text": "Wear it, enjoy it, and make much of it.",
          "plainText": "Wear it enjoy it and make much of it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "richmond",
        "name": "RICHMOND",
        "displayName": "Richmond"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Great God of heaven, say Amen to all!",
          "plainText": "Great God of heaven say Amen to all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "But tell me, is young George Stanley living?",
          "plainText": "But tell me is young George Stanley living",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "stanley",
        "name": "STANLEY",
        "displayName": "Stanley"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "He is, my lord, and safe in Leicester town,",
          "plainText": "He is my lord and safe in Leicester town",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "Whither, if it please you, we may now withdraw us.",
          "plainText": "Whither if it please you we may now withdraw us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "richmond",
        "name": "RICHMOND",
        "displayName": "Richmond"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "What men of name are slain on either side?",
          "plainText": "What men of name are slain on either side",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "stanley",
        "name": "STANLEY",
        "displayName": "Stanley"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "John, Duke of Norfolk, Walter, Lord Ferrers,",
          "plainText": "John Duke of Norfolk Walter Lord Ferrers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Sir Robert Brakenbury, and Sir William Brandon.",
          "plainText": "Sir Robert Brakenbury and Sir William Brandon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "richmond",
        "name": "RICHMOND",
        "displayName": "Richmond"
      },
      "lines": [
        {
          "id": "king-richard-the-third-5-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Inter their bodies as becomes their births.",
          "plainText": "Inter their bodies as becomes their births",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Proclaim a pardon to the soldiers fled",
          "plainText": "Proclaim a pardon to the soldiers fled",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "That in submission will return to us.",
          "plainText": "That in submission will return to us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "And then, as we have ta'en the sacrament,",
          "plainText": "And then as we have ta'en the sacrament",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0019",
          "number": 19,
          "speechLineNumber": 5,
          "text": "We will unite the white rose and the red.",
          "plainText": "We will unite the white rose and the red",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0020",
          "number": 20,
          "speechLineNumber": 6,
          "text": "Smile heaven upon this fair conjunction,",
          "plainText": "Smile heaven upon this fair conjunction",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0021",
          "number": 21,
          "speechLineNumber": 7,
          "text": "That long have frowned upon their enmity.",
          "plainText": "That long have frowned upon their enmity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0022",
          "number": 22,
          "speechLineNumber": 8,
          "text": "What traitor hears me and says not Amen?",
          "plainText": "What traitor hears me and says not Amen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0023",
          "number": 23,
          "speechLineNumber": 9,
          "text": "England hath long been mad, and scarred herself:",
          "plainText": "England hath long been mad and scarred herself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0024",
          "number": 24,
          "speechLineNumber": 10,
          "text": "The brother blindly shed the brother's blood;",
          "plainText": "The brother blindly shed the brother's blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0025",
          "number": 25,
          "speechLineNumber": 11,
          "text": "The father rashly slaughtered his own son;",
          "plainText": "The father rashly slaughtered his own son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0026",
          "number": 26,
          "speechLineNumber": 12,
          "text": "The son, compelled, been butcher to the sire.",
          "plainText": "The son compelled been butcher to the sire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0027",
          "number": 27,
          "speechLineNumber": 13,
          "text": "All this divided York and Lancaster,",
          "plainText": "All this divided York and Lancaster",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0028",
          "number": 28,
          "speechLineNumber": 14,
          "text": "Divided in their dire division.",
          "plainText": "Divided in their dire division",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0029",
          "number": 29,
          "speechLineNumber": 15,
          "text": "O, now let Richmond and Elizabeth,",
          "plainText": "O now let Richmond and Elizabeth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0030",
          "number": 30,
          "speechLineNumber": 16,
          "text": "The true succeeders of each royal house,",
          "plainText": "The true succeeders of each royal house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0031",
          "number": 31,
          "speechLineNumber": 17,
          "text": "By God's fair ordinance conjoin together,",
          "plainText": "By God's fair ordinance conjoin together",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0032",
          "number": 32,
          "speechLineNumber": 18,
          "text": "And let their heirs, God, if Thy will be so,",
          "plainText": "And let their heirs God if Thy will be so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0033",
          "number": 33,
          "speechLineNumber": 19,
          "text": "Enrich the time to come with smoothed-faced peace,",
          "plainText": "Enrich the time to come with smoothedfaced peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0034",
          "number": 34,
          "speechLineNumber": 20,
          "text": "With smiling plenty, and fair prosperous days.",
          "plainText": "With smiling plenty and fair prosperous days",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0035",
          "number": 35,
          "speechLineNumber": 21,
          "text": "Abate the edge of traitors, gracious Lord,",
          "plainText": "Abate the edge of traitors gracious Lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0036",
          "number": 36,
          "speechLineNumber": 22,
          "text": "That would reduce these bloody days again,",
          "plainText": "That would reduce these bloody days again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0037",
          "number": 37,
          "speechLineNumber": 23,
          "text": "And make poor England weep in streams of blood.",
          "plainText": "And make poor England weep in streams of blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0038",
          "number": 38,
          "speechLineNumber": 24,
          "text": "Let them not live to taste this land's increase,",
          "plainText": "Let them not live to taste this land's increase",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0039",
          "number": 39,
          "speechLineNumber": 25,
          "text": "That would with treason wound this fair land's peace.",
          "plainText": "That would with treason wound this fair land's peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0040",
          "number": 40,
          "speechLineNumber": 26,
          "text": "Now civil wounds are stopped, peace lives again.",
          "plainText": "Now civil wounds are stopped peace lives again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "king-richard-the-third-5-5-line-0041",
          "number": 41,
          "speechLineNumber": 27,
          "text": "That she may long live here, God say Amen.",
          "plainText": "That she may long live here God say Amen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "king-richard-the-third-5-5-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}