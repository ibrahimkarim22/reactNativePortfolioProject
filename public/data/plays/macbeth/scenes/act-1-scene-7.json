        },
        {
          "id": "macbeth-1-7-line-0087",
          "number": 87,
          "speechLineNumber": 3,
          "text": "Upon his death?",
          "plainText": "Upon his death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
