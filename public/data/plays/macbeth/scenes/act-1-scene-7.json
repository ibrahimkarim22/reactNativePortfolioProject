          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0090",
          "number": 90,
          "speechLineNumber": 3,
          "text": "Away, and mock the time with fairest show:",
