      },
      "lines": [
        {
          "id": "macbeth-1-7-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Bring forth men-children only;",
          "plainText": "Bring forth menchildren only",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0080",
          "number": 80,
          "speechLineNumber": 2,
          "text": "For thy undaunted mettle should compose",
          "plainText": "For thy undaunted mettle should compose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0081",
          "number": 81,
          "speechLineNumber": 3,
          "text": "Nothing but males. Will it not be receiv'd,",
          "plainText": "Nothing but males Will it not be receiv'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0082",
          "number": 82,
          "speechLineNumber": 4,
          "text": "When we have mark'd with blood those sleepy two",
          "plainText": "When we have mark'd with blood those sleepy two",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0083",
          "number": 83,
          "speechLineNumber": 5,
          "text": "Of his own chamber, and us'd their very daggers,",
          "plainText": "Of his own chamber and us'd their very daggers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0084",
          "number": 84,
          "speechLineNumber": 6,
          "text": "That they have done't?",
          "plainText": "That they have done't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
