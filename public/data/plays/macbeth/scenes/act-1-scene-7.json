          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-1-7-speech-010",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-1-7-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "We fail?",
          "plainText": "We fail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "But screw your courage to the sticking-place,",
          "plainText": "But screw your courage to the stickingplace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0067",
          "number": 67,
          "speechLineNumber": 3,
          "text": "And we'll not fail. When Duncan is asleep",
          "plainText": "And we'll not fail When Duncan is asleep",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0068",
          "number": 68,
          "speechLineNumber": 4,
          "text": "(Whereto the rather shall his day's hard journey",
          "plainText": "Whereto the rather shall his day's hard journey",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0069",
          "number": 69,
          "speechLineNumber": 5,
          "text": "Soundly invite him), his two chamberlains",
          "plainText": "Soundly invite him his two chamberlains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0070",
          "number": 70,
          "speechLineNumber": 6,
          "text": "Will I with wine and wassail so convince",
          "plainText": "Will I with wine and wassail so convince",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0071",
          "number": 71,
          "speechLineNumber": 7,
          "text": "That memory, the warder of the brain,",
          "plainText": "That memory the warder of the brain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0072",
          "number": 72,
          "speechLineNumber": 8,
          "text": "Shall be a fume, and the receipt of reason",
          "plainText": "Shall be a fume and the receipt of reason",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0073",
          "number": 73,
          "speechLineNumber": 9,
          "text": "A limbeck only: when in swinish sleep",
          "plainText": "A limbeck only when in swinish sleep",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0074",
          "number": 74,
          "speechLineNumber": 10,
          "text": "Their drenched natures lie as in a death,",
          "plainText": "Their drenched natures lie as in a death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0075",
          "number": 75,
          "speechLineNumber": 11,
          "text": "What cannot you and I perform upon",
          "plainText": "What cannot you and I perform upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0076",
          "number": 76,
          "speechLineNumber": 12,
          "text": "Th' unguarded Duncan? what not put upon",
          "plainText": "Th' unguarded Duncan what not put upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0077",
          "number": 77,
          "speechLineNumber": 13,
          "text": "His spongy officers; who shall bear the guilt",
          "plainText": "His spongy officers who shall bear the guilt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-1-7-line-0078",
          "number": 78,
          "speechLineNumber": 14,
          "text": "Of our great quell?",
          "plainText": "Of our great quell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-1-7-speech-011",
      "type": "speech",
      "speaker": {
