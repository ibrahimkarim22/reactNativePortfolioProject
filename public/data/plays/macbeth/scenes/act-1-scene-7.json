      },
      "lines": [
        {
          "id": "macbeth-1-7-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "If we should fail?",
          "plainText": "If we should fail",
          "lineType": "prose",
          "lineTypeDetection": "auto",
