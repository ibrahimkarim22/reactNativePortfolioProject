  "scene": {
    "id": "macbeth-2-1",
    "act": 2,
    "scene": 1,
    "label": "Act 2, Scene 1",
    "title": "SCENE I. Inverness. Court within the Castle.",
    "location": "Inverness. Court within the Castle.",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "macbeth-2-1-stage-001",
      "type": "stage",
      "text": "Enter Banquo and Fleance with a torch before him."
    },
    {
      "id": "macbeth-2-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "How goes the night, boy?",
          "plainText": "How goes the night boy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "fleance",
        "name": "FLEANCE",
        "displayName": "Fleance"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "The moon is down; I have not heard the clock.",
          "plainText": "The moon is down I have not heard the clock",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "And she goes down at twelve.",
          "plainText": "And she goes down at twelve",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "fleance",
        "name": "FLEANCE",
        "displayName": "Fleance"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I take't, 'tis later, sir.",
          "plainText": "I take't 'tis later sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Hold, take my sword.—There's husbandry in heaven;",
          "plainText": "Hold take my swordThere's husbandry in heaven",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Their candles are all out. Take thee that too.",
          "plainText": "Their candles are all out Take thee that too",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "A heavy summons lies like lead upon me,",
          "plainText": "A heavy summons lies like lead upon me",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "And yet I would not sleep. Merciful powers,",
          "plainText": "And yet I would not sleep Merciful powers",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0009",
          "number": 9,
          "speechLineNumber": 5,
          "text": "Restrain in me the cursed thoughts that nature",
          "plainText": "Restrain in me the cursed thoughts that nature",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0010",
          "number": 10,
          "speechLineNumber": 6,
          "text": "Gives way to in repose!",
          "plainText": "Gives way to in repose",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-1-stage-002",
      "type": "stage",
      "text": "Enter Macbeth and a Servant with a torch."
    },
    {
      "id": "macbeth-2-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "A friend.",
          "plainText": "A friend",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "What, sir, not yet at rest? The King's abed:",
          "plainText": "What sir not yet at rest The King's abed",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "He hath been in unusual pleasure and",
          "plainText": "He hath been in unusual pleasure and",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Sent forth great largess to your offices.",
          "plainText": "Sent forth great largess to your offices",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "This diamond he greets your wife withal,",
          "plainText": "This diamond he greets your wife withal",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "By the name of most kind hostess, and shut up",
          "plainText": "By the name of most kind hostess and shut up",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "In measureless content.",
          "plainText": "In measureless content",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Being unprepar'd,",
          "plainText": "Being unprepar'd",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Our will became the servant to defect,",
          "plainText": "Our will became the servant to defect",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "Which else should free have wrought.",
          "plainText": "Which else should free have wrought",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "All's well.",
          "plainText": "All's well",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "I dreamt last night of the three Weird Sisters:",
          "plainText": "I dreamt last night of the three Weird Sisters",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "To you they have show'd some truth.",
          "plainText": "To you they have show'd some truth",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "I think not of them:",
          "plainText": "I think not of them",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "Yet, when we can entreat an hour to serve,",
          "plainText": "Yet when we can entreat an hour to serve",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "We would spend it in some words upon that business,",
          "plainText": "We would spend it in some words upon that business",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "If you would grant the time.",
          "plainText": "If you would grant the time",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "At your kind'st leisure.",
          "plainText": "At your kind'st leisure",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "If you shall cleave to my consent, when 'tis,",
          "plainText": "If you shall cleave to my consent when 'tis",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "It shall make honour for you.",
          "plainText": "It shall make honour for you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "So I lose none",
          "plainText": "So I lose none",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "In seeking to augment it, but still keep",
          "plainText": "In seeking to augment it but still keep",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "My bosom franchis'd, and allegiance clear,",
          "plainText": "My bosom franchis'd and allegiance clear",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "I shall be counsell'd.",
          "plainText": "I shall be counsell'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Good repose the while!",
          "plainText": "Good repose the while",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Thanks, sir: the like to you.",
          "plainText": "Thanks sir the like to you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-1-stage-003",
      "type": "stage",
      "text": "[Exeunt Banquo and Fleance.]"
    },
    {
      "id": "macbeth-2-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Go bid thy mistress, when my drink is ready,",
          "plainText": "Go bid thy mistress when my drink is ready",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-1-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "She strike upon the bell. Get thee to bed.",
          "plainText": "She strike upon the bell Get thee to bed",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-1-stage-004",
      "type": "stage",
      "text": "[Exit Servant.]"
    },
    {
      "id": "macbeth-2-1-stage-005",
      "type": "stage",
      "text": "[A bell rings.]"
    },
    {
      "id": "macbeth-2-1-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}