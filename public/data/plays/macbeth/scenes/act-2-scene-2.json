  },
  "content": [
    {
      "id": "macbeth-2-2-stage-001",
      "type": "stage",
      "text": "Enter Lady Macbeth."
    },
    {
      "id": "macbeth-2-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "That which hath made them drunk hath made me bold:",
          "plainText": "That which hath made them drunk hath made me bold",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "What hath quench'd them hath given me fire.—Hark!—Peace!",
          "plainText": "What hath quench'd them hath given me fireHarkPeace",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "It was the owl that shriek'd, the fatal bellman,",
          "plainText": "It was the owl that shriek'd the fatal bellman",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Which gives the stern'st good night. He is about it.",
          "plainText": "Which gives the stern'st good night He is about it",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "The doors are open; and the surfeited grooms",
          "plainText": "The doors are open and the surfeited grooms",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Do mock their charge with snores: I have drugg'd their possets,",
          "plainText": "Do mock their charge with snores I have drugg'd their possets",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "That death and nature do contend about them,",
          "plainText": "That death and nature do contend about them",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Whether they live or die.",
          "plainText": "Whether they live or die",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "[Within.] Who's there?—what, ho!",
          "plainText": "Within Who's therewhat ho",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Alack! I am afraid they have awak'd,",
          "plainText": "Alack I am afraid they have awak'd",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "And 'tis not done. Th' attempt and not the deed",
          "plainText": "And 'tis not done Th' attempt and not the deed",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "Confounds us.—Hark!—I laid their daggers ready;",
          "plainText": "Confounds usHarkI laid their daggers ready",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "He could not miss 'em.—Had he not resembled",
          "plainText": "He could not miss 'emHad he not resembled",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0014",
          "number": 14,
          "speechLineNumber": 5,
          "text": "My father as he slept, I had done't.—My husband!",
          "plainText": "My father as he slept I had done'tMy husband",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-stage-002",
      "type": "stage",
      "text": "Enter Macbeth."
    },
    {
      "id": "macbeth-2-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "I have done the deed.—Didst thou not hear a noise?",
          "plainText": "I have done the deedDidst thou not hear a noise",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "I heard the owl scream and the crickets cry.",
          "plainText": "I heard the owl scream and the crickets cry",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Did not you speak?",
          "plainText": "Did not you speak",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "When?",
          "plainText": "When",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Now.",
          "plainText": "Now",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "As I descended?",
          "plainText": "As I descended",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Ay.",
          "plainText": "Ay",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Hark!—Who lies i' th' second chamber?",
          "plainText": "HarkWho lies i' th' second chamber",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Donalbain.",
          "plainText": "Donalbain",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "This is a sorry sight.",
          "plainText": "This is a sorry sight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-stage-003",
      "type": "stage",
      "text": "[Looking on his hands.]"
    },
    {
      "id": "macbeth-2-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "A foolish thought, to say a sorry sight.",
          "plainText": "A foolish thought to say a sorry sight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "There's one did laugh in's sleep, and one cried, \"Murder!\"",
          "plainText": "There's one did laugh in's sleep and one cried Murder",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "That they did wake each other: I stood and heard them.",
          "plainText": "That they did wake each other I stood and heard them",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "But they did say their prayers, and address'd them",
          "plainText": "But they did say their prayers and address'd them",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "Again to sleep.",
          "plainText": "Again to sleep",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "There are two lodg'd together.",
          "plainText": "There are two lodg'd together",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "One cried, \"God bless us!\" and, \"Amen,\" the other,",
          "plainText": "One cried God bless us and Amen the other",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "As they had seen me with these hangman's hands.",
          "plainText": "As they had seen me with these hangman's hands",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "List'ning their fear, I could not say \"Amen,\"",
          "plainText": "List'ning their fear I could not say Amen",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "When they did say, \"God bless us.\"",
          "plainText": "When they did say God bless us",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Consider it not so deeply.",
          "plainText": "Consider it not so deeply",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "But wherefore could not I pronounce \"Amen\"?",
          "plainText": "But wherefore could not I pronounce Amen",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "I had most need of blessing, and \"Amen\"",
          "plainText": "I had most need of blessing and Amen",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0038",
          "number": 38,
          "speechLineNumber": 3,
          "text": "Stuck in my throat.",
          "plainText": "Stuck in my throat",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "These deeds must not be thought",
          "plainText": "These deeds must not be thought",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "After these ways; so, it will make us mad.",
          "plainText": "After these ways so it will make us mad",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Methought I heard a voice cry, \"Sleep no more!",
          "plainText": "Methought I heard a voice cry Sleep no more",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Macbeth does murder sleep,\"—the innocent sleep;",
          "plainText": "Macbeth does murder sleepthe innocent sleep",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "Sleep that knits up the ravell'd sleave of care,",
          "plainText": "Sleep that knits up the ravell'd sleave of care",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "The death of each day's life, sore labour's bath,",
          "plainText": "The death of each day's life sore labour's bath",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "Balm of hurt minds, great nature's second course,",
          "plainText": "Balm of hurt minds great nature's second course",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "Chief nourisher in life's feast.",
          "plainText": "Chief nourisher in life's feast",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "What do you mean?",
          "plainText": "What do you mean",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Still it cried, \"Sleep no more!\" to all the house:",
          "plainText": "Still it cried Sleep no more to all the house",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "\"Glamis hath murder'd sleep, and therefore Cawdor",
          "plainText": "Glamis hath murder'd sleep and therefore Cawdor",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "Shall sleep no more. Macbeth shall sleep no more!\"",
          "plainText": "Shall sleep no more Macbeth shall sleep no more",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Who was it that thus cried? Why, worthy thane,",
          "plainText": "Who was it that thus cried Why worthy thane",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "You do unbend your noble strength to think",
          "plainText": "You do unbend your noble strength to think",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "So brainsickly of things. Go get some water,",
          "plainText": "So brainsickly of things Go get some water",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "And wash this filthy witness from your hand.—",
          "plainText": "And wash this filthy witness from your hand",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0055",
          "number": 55,
          "speechLineNumber": 5,
          "text": "Why did you bring these daggers from the place?",
          "plainText": "Why did you bring these daggers from the place",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0056",
          "number": 56,
          "speechLineNumber": 6,
          "text": "They must lie there: go carry them, and smear",
          "plainText": "They must lie there go carry them and smear",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0057",
          "number": 57,
          "speechLineNumber": 7,
          "text": "The sleepy grooms with blood.",
          "plainText": "The sleepy grooms with blood",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "I'll go no more:",
          "plainText": "I'll go no more",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "I am afraid to think what I have done;",
          "plainText": "I am afraid to think what I have done",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "Look on't again I dare not.",
          "plainText": "Look on't again I dare not",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Infirm of purpose!",
          "plainText": "Infirm of purpose",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "Give me the daggers. The sleeping and the dead",
          "plainText": "Give me the daggers The sleeping and the dead",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "Are but as pictures. 'Tis the eye of childhood",
          "plainText": "Are but as pictures 'Tis the eye of childhood",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0064",
          "number": 64,
          "speechLineNumber": 4,
          "text": "That fears a painted devil. If he do bleed,",
          "plainText": "That fears a painted devil If he do bleed",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0065",
          "number": 65,
          "speechLineNumber": 5,
          "text": "I'll gild the faces of the grooms withal,",
          "plainText": "I'll gild the faces of the grooms withal",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0066",
          "number": 66,
          "speechLineNumber": 6,
          "text": "For it must seem their guilt.",
          "plainText": "For it must seem their guilt",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-stage-004",
      "type": "stage",
      "text": "[Exit. Knocking within.]"
    },
    {
      "id": "macbeth-2-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Whence is that knocking?",
          "plainText": "Whence is that knocking",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "How is't with me, when every noise appals me?",
          "plainText": "How is't with me when every noise appals me",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0069",
          "number": 69,
          "speechLineNumber": 3,
          "text": "What hands are here? Ha, they pluck out mine eyes!",
          "plainText": "What hands are here Ha they pluck out mine eyes",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0070",
          "number": 70,
          "speechLineNumber": 4,
          "text": "Will all great Neptune's ocean wash this blood",
          "plainText": "Will all great Neptune's ocean wash this blood",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0071",
          "number": 71,
          "speechLineNumber": 5,
          "text": "Clean from my hand? No, this my hand will rather",
          "plainText": "Clean from my hand No this my hand will rather",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0072",
          "number": 72,
          "speechLineNumber": 6,
          "text": "The multitudinous seas incarnadine,",
          "plainText": "The multitudinous seas incarnadine",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0073",
          "number": 73,
          "speechLineNumber": 7,
          "text": "Making the green one red.",
          "plainText": "Making the green one red",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-stage-005",
      "type": "stage",
      "text": "Enter Lady Macbeth."
    },
    {
      "id": "macbeth-2-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "lady-macbeth",
        "name": "LADY MACBETH",
        "displayName": "Lady Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "My hands are of your color, but I shame",
          "plainText": "My hands are of your color but I shame",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "To wear a heart so white. [Knocking within.] I hear knocking",
          "plainText": "To wear a heart so white Knocking within I hear knocking",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "At the south entry:—retire we to our chamber.",
          "plainText": "At the south entryretire we to our chamber",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0077",
          "number": 77,
          "speechLineNumber": 4,
          "text": "A little water clears us of this deed:",
          "plainText": "A little water clears us of this deed",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0078",
          "number": 78,
          "speechLineNumber": 5,
          "text": "How easy is it then! Your constancy",
          "plainText": "How easy is it then Your constancy",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0079",
          "number": 79,
          "speechLineNumber": 6,
          "text": "Hath left you unattended.—[Knocking within.] Hark, more knocking.",
          "plainText": "Hath left you unattendedKnocking within Hark more knocking",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0080",
          "number": 80,
          "speechLineNumber": 7,
          "text": "Get on your nightgown, lest occasion call us",
          "plainText": "Get on your nightgown lest occasion call us",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0081",
          "number": 81,
          "speechLineNumber": 8,
          "text": "And show us to be watchers. Be not lost",
          "plainText": "And show us to be watchers Be not lost",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0082",
          "number": 82,
          "speechLineNumber": 9,
          "text": "So poorly in your thoughts.",
          "plainText": "So poorly in your thoughts",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-2-2-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "To know my deed, 'twere best not know myself. [Knocking within.]",
          "plainText": "To know my deed 'twere best not know myself Knocking within",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-2-line-0084",
          "number": 84,
          "speechLineNumber": 2,
          "text": "Wake Duncan with thy knocking! I would thou couldst!",
          "plainText": "Wake Duncan with thy knocking I would thou couldst",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-2-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}