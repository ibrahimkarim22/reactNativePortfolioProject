    "sourceFile": "pg100-images.html"
  },
  "scene": {
    "id": "macbeth-2-4",
    "act": 2,
    "scene": 4,
    "label": "Act 2, Scene 4",
    "title": "SCENE IV. The same. Without the Castle.",
    "location": "The same. Without the Castle.",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "macbeth-2-4-stage-001",
      "type": "stage",
      "text": "Enter Ross and an Old Man."
    },
    {
      "id": "macbeth-2-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Threescore and ten I can remember well,",
          "plainText": "Threescore and ten I can remember well",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Within the volume of which time I have seen",
          "plainText": "Within the volume of which time I have seen",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Hours dreadful and things strange, but this sore night",
          "plainText": "Hours dreadful and things strange but this sore night",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Hath trifled former knowings.",
          "plainText": "Hath trifled former knowings",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Ha, good father,",
          "plainText": "Ha good father",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Thou seest the heavens, as troubled with man's act,",
          "plainText": "Thou seest the heavens as troubled with man's act",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "Threatens his bloody stage: by the clock 'tis day,",
          "plainText": "Threatens his bloody stage by the clock 'tis day",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "And yet dark night strangles the travelling lamp.",
          "plainText": "And yet dark night strangles the travelling lamp",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0009",
          "number": 9,
          "speechLineNumber": 5,
          "text": "Is't night's predominance, or the day's shame,",
          "plainText": "Is't night's predominance or the day's shame",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0010",
          "number": 10,
          "speechLineNumber": 6,
          "text": "That darkness does the face of earth entomb,",
          "plainText": "That darkness does the face of earth entomb",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0011",
          "number": 11,
          "speechLineNumber": 7,
          "text": "When living light should kiss it?",
          "plainText": "When living light should kiss it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "'Tis unnatural,",
          "plainText": "'Tis unnatural",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Even like the deed that's done. On Tuesday last,",
          "plainText": "Even like the deed that's done On Tuesday last",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "A falcon, towering in her pride of place,",
          "plainText": "A falcon towering in her pride of place",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "Was by a mousing owl hawk'd at and kill'd.",
          "plainText": "Was by a mousing owl hawk'd at and kill'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "And Duncan's horses (a thing most strange and certain)",
          "plainText": "And Duncan's horses a thing most strange and certain",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Beauteous and swift, the minions of their race,",
          "plainText": "Beauteous and swift the minions of their race",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Turn'd wild in nature, broke their stalls, flung out,",
          "plainText": "Turn'd wild in nature broke their stalls flung out",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "Contending 'gainst obedience, as they would make",
          "plainText": "Contending 'gainst obedience as they would make",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "War with mankind.",
          "plainText": "War with mankind",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "'Tis said they eat each other.",
          "plainText": "'Tis said they eat each other",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "They did so; to the amazement of mine eyes,",
          "plainText": "They did so to the amazement of mine eyes",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "That look'd upon't.",
          "plainText": "That look'd upon't",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "Here comes the good Macduff.",
          "plainText": "Here comes the good Macduff",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-stage-002",
      "type": "stage",
      "text": "Enter Macduff."
    },
    {
      "id": "macbeth-2-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Why, see you not?",
          "plainText": "Why see you not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Is't known who did this more than bloody deed?",
          "plainText": "Is't known who did this more than bloody deed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Those that Macbeth hath slain.",
          "plainText": "Those that Macbeth hath slain",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Alas, the day!",
          "plainText": "Alas the day",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "What good could they pretend?",
          "plainText": "What good could they pretend",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "They were suborn'd.",
          "plainText": "They were suborn'd",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "Malcolm and Donalbain, the King's two sons,",
          "plainText": "Malcolm and Donalbain the King's two sons",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "Are stol'n away and fled; which puts upon them",
          "plainText": "Are stol'n away and fled which puts upon them",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0033",
          "number": 33,
          "speechLineNumber": 4,
          "text": "Suspicion of the deed.",
          "plainText": "Suspicion of the deed",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "'Gainst nature still:",
          "plainText": "'Gainst nature still",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Thriftless ambition, that will ravin up",
          "plainText": "Thriftless ambition that will ravin up",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Thine own life's means!—Then 'tis most like",
          "plainText": "Thine own life's meansThen 'tis most like",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "The sovereignty will fall upon Macbeth.",
          "plainText": "The sovereignty will fall upon Macbeth",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "He is already nam'd; and gone to Scone",
          "plainText": "He is already nam'd and gone to Scone",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "To be invested.",
          "plainText": "To be invested",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Where is Duncan's body?",
          "plainText": "Where is Duncan's body",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Carried to Colmekill,",
          "plainText": "Carried to Colmekill",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "The sacred storehouse of his predecessors,",
          "plainText": "The sacred storehouse of his predecessors",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "And guardian of their bones.",
          "plainText": "And guardian of their bones",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Will you to Scone?",
          "plainText": "Will you to Scone",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "No, cousin, I'll to Fife.",
          "plainText": "No cousin I'll to Fife",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Well, I will thither.",
          "plainText": "Well I will thither",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Well, may you see things well done there. Adieu!",
          "plainText": "Well may you see things well done there Adieu",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "Lest our old robes sit easier than our new!",
          "plainText": "Lest our old robes sit easier than our new",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Farewell, father.",
          "plainText": "Farewell father",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-2-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "old-man",
        "name": "OLD MAN",
        "displayName": "Old Man"
      },
      "lines": [
        {
          "id": "macbeth-2-4-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "God's benison go with you; and with those",
          "plainText": "God's benison go with you and with those",
          "lineType": "verse"
        },
        {
          "id": "macbeth-2-4-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "That would make good of bad, and friends of foes!",
          "plainText": "That would make good of bad and friends of foes",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-2-4-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}