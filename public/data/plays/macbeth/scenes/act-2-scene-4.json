{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "macbeth",
    "title": "The Tragedy of Macbeth",
    "author": "William Shakespeare",
    "genre": "Tragedy"
  },
  "source": {
    "name": "Project Gutenberg",
    "ebookNumber": 100,
