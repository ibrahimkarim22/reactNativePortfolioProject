  "scene": {
    "id": "macbeth-3-3",
    "act": 3,
    "scene": 3,
    "label": "Act 3, Scene 3",
    "title": "SCENE III. The same. A Park or Lawn, with a gate leading to the Palace.",
    "location": "The same. A Park or Lawn, with a gate leading to the Palace.",
    "orderInPlay": 14
  },
  "content": [
    {
      "id": "macbeth-3-3-stage-001",
      "type": "stage",
      "text": "Enter three Murderers."
    },
    {
      "id": "macbeth-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-murderer",
        "name": "FIRST MURDERER",
        "displayName": "First Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "But who did bid thee join with us?",
          "plainText": "But who did bid thee join with us",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "third-murderer",
        "name": "THIRD MURDERER",
        "displayName": "Third Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Macbeth.",
          "plainText": "Macbeth",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "second-murderer",
        "name": "SECOND MURDERER",
        "displayName": "Second Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "He needs not our mistrust; since he delivers",
          "plainText": "He needs not our mistrust since he delivers",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Our offices and what we have to do",
          "plainText": "Our offices and what we have to do",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "To the direction just.",
          "plainText": "To the direction just",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "first-murderer",
        "name": "FIRST MURDERER",
        "displayName": "First Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Then stand with us.",
          "plainText": "Then stand with us",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "The west yet glimmers with some streaks of day.",
          "plainText": "The west yet glimmers with some streaks of day",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "Now spurs the lated traveller apace,",
          "plainText": "Now spurs the lated traveller apace",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "To gain the timely inn; and near approaches",
          "plainText": "To gain the timely inn and near approaches",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "The subject of our watch.",
          "plainText": "The subject of our watch",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "third-murderer",
        "name": "THIRD MURDERER",
        "displayName": "Third Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Hark! I hear horses.",
          "plainText": "Hark I hear horses",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "[Within.] Give us a light there, ho!",
          "plainText": "Within Give us a light there ho",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "second-murderer",
        "name": "SECOND MURDERER",
        "displayName": "Second Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Then 'tis he; the rest",
          "plainText": "Then 'tis he the rest",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "That are within the note of expectation",
          "plainText": "That are within the note of expectation",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "Already are i' th' court.",
          "plainText": "Already are i' th' court",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "first-murderer",
        "name": "FIRST MURDERER",
        "displayName": "First Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "His horses go about.",
          "plainText": "His horses go about",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "third-murderer",
        "name": "THIRD MURDERER",
        "displayName": "Third Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Almost a mile; but he does usually,",
          "plainText": "Almost a mile but he does usually",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "So all men do, from hence to the palace gate",
          "plainText": "So all men do from hence to the palace gate",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Make it their walk.",
          "plainText": "Make it their walk",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-3-3-stage-002",
      "type": "stage",
      "text": "Enter Banquo and Fleance with a torch."
    },
    {
      "id": "macbeth-3-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "second-murderer",
        "name": "SECOND MURDERER",
        "displayName": "Second Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "A light, a light!",
          "plainText": "A light a light",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "third-murderer",
        "name": "THIRD MURDERER",
        "displayName": "Third Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "'Tis he.",
          "plainText": "'Tis he",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "first-murderer",
        "name": "FIRST MURDERER",
        "displayName": "First Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Stand to't.",
          "plainText": "Stand to't",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "It will be rain tonight.",
          "plainText": "It will be rain tonight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "first-murderer",
        "name": "FIRST MURDERER",
        "displayName": "First Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Let it come down.",
          "plainText": "Let it come down",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-stage-003",
      "type": "stage",
      "text": "[Assaults Banquo.]"
    },
    {
      "id": "macbeth-3-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "banquo",
        "name": "BANQUO",
        "displayName": "Banquo"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "O, treachery! Fly, good Fleance, fly, fly, fly!",
          "plainText": "O treachery Fly good Fleance fly fly fly",
          "lineType": "verse"
        },
        {
          "id": "macbeth-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Thou mayst revenge—O slave!",
          "plainText": "Thou mayst revengeO slave",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-3-3-stage-004",
      "type": "stage",
      "text": "[Dies. Fleance escapes.]"
    },
    {
      "id": "macbeth-3-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "third-murderer",
        "name": "THIRD MURDERER",
        "displayName": "Third Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Who did strike out the light?",
          "plainText": "Who did strike out the light",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "first-murderer",
        "name": "FIRST MURDERER",
        "displayName": "First Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Was't not the way?",
          "plainText": "Was't not the way",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "third-murderer",
        "name": "THIRD MURDERER",
        "displayName": "Third Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "There's but one down: the son is fled.",
          "plainText": "There's but one down the son is fled",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "second-murderer",
        "name": "SECOND MURDERER",
        "displayName": "Second Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "We have lost best half of our affair.",
          "plainText": "We have lost best half of our affair",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "first-murderer",
        "name": "FIRST MURDERER",
        "displayName": "First Murderer"
      },
      "lines": [
        {
          "id": "macbeth-3-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Well, let's away, and say how much is done.",
          "plainText": "Well let's away and say how much is done",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-3-3-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}