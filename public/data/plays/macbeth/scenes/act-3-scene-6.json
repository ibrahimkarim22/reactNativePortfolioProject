  "scene": {
    "id": "macbeth-3-6",
    "act": 3,
    "scene": 6,
    "label": "Act 3, Scene 6",
    "title": "SCENE VI. Forres. A Room in the Palace.",
    "location": "Forres. A Room in the Palace.",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "macbeth-3-6-stage-001",
      "type": "stage",
      "text": "Enter Lennox and another Lord."
    },
    {
      "id": "macbeth-3-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lennox",
        "name": "LENNOX",
        "displayName": "Lennox"
      },
      "lines": [
        {
          "id": "macbeth-3-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "My former speeches have but hit your thoughts,",
          "plainText": "My former speeches have but hit your thoughts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Which can interpret farther: only, I say,",
          "plainText": "Which can interpret farther only I say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Thing's have been strangely borne. The gracious Duncan",
          "plainText": "Thing's have been strangely borne The gracious Duncan",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Was pitied of Macbeth:—marry, he was dead:—",
          "plainText": "Was pitied of Macbethmarry he was dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "And the right valiant Banquo walk'd too late;",
          "plainText": "And the right valiant Banquo walk'd too late",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Whom, you may say, if't please you, Fleance kill'd,",
          "plainText": "Whom you may say if't please you Fleance kill'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "For Fleance fled. Men must not walk too late.",
          "plainText": "For Fleance fled Men must not walk too late",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Who cannot want the thought, how monstrous",
          "plainText": "Who cannot want the thought how monstrous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "It was for Malcolm and for Donalbain",
          "plainText": "It was for Malcolm and for Donalbain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "To kill their gracious father? damned fact!",
          "plainText": "To kill their gracious father damned fact",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "How it did grieve Macbeth! did he not straight,",
          "plainText": "How it did grieve Macbeth did he not straight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "In pious rage, the two delinquents tear",
          "plainText": "In pious rage the two delinquents tear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "That were the slaves of drink and thralls of sleep?",
          "plainText": "That were the slaves of drink and thralls of sleep",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Was not that nobly done? Ay, and wisely too;",
          "plainText": "Was not that nobly done Ay and wisely too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "For 'twould have anger'd any heart alive,",
          "plainText": "For 'twould have anger'd any heart alive",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "To hear the men deny't. So that, I say,",
          "plainText": "To hear the men deny't So that I say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "He has borne all things well: and I do think,",
          "plainText": "He has borne all things well and I do think",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "That had he Duncan's sons under his key",
          "plainText": "That had he Duncan's sons under his key",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "(As, and't please heaven, he shall not) they should find",
          "plainText": "As and't please heaven he shall not they should find",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "What 'twere to kill a father; so should Fleance.",
          "plainText": "What 'twere to kill a father so should Fleance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "But, peace!—for from broad words, and 'cause he fail'd",
          "plainText": "But peacefor from broad words and 'cause he fail'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "His presence at the tyrant's feast, I hear,",
          "plainText": "His presence at the tyrant's feast I hear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "Macduff lives in disgrace. Sir, can you tell",
          "plainText": "Macduff lives in disgrace Sir can you tell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "Where he bestows himself?",
          "plainText": "Where he bestows himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lord",
        "name": "LORD",
        "displayName": "Lord"
      },
      "lines": [
        {
          "id": "macbeth-3-6-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "The son of Duncan,",
          "plainText": "The son of Duncan",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "From whom this tyrant holds the due of birth,",
          "plainText": "From whom this tyrant holds the due of birth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "Lives in the English court and is receiv'd",
          "plainText": "Lives in the English court and is receiv'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "Of the most pious Edward with such grace",
          "plainText": "Of the most pious Edward with such grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "That the malevolence of fortune nothing",
          "plainText": "That the malevolence of fortune nothing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "Takes from his high respect. Thither Macduff",
          "plainText": "Takes from his high respect Thither Macduff",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0031",
          "number": 31,
          "speechLineNumber": 7,
          "text": "Is gone to pray the holy king, upon his aid",
          "plainText": "Is gone to pray the holy king upon his aid",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0032",
          "number": 32,
          "speechLineNumber": 8,
          "text": "To wake Northumberland, and warlike Siward",
          "plainText": "To wake Northumberland and warlike Siward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0033",
          "number": 33,
          "speechLineNumber": 9,
          "text": "That, by the help of these (with Him above",
          "plainText": "That by the help of these with Him above",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0034",
          "number": 34,
          "speechLineNumber": 10,
          "text": "To ratify the work), we may again",
          "plainText": "To ratify the work we may again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0035",
          "number": 35,
          "speechLineNumber": 11,
          "text": "Give to our tables meat, sleep to our nights;",
          "plainText": "Give to our tables meat sleep to our nights",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0036",
          "number": 36,
          "speechLineNumber": 12,
          "text": "Free from our feasts and banquets bloody knives,",
          "plainText": "Free from our feasts and banquets bloody knives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0037",
          "number": 37,
          "speechLineNumber": 13,
          "text": "Do faithful homage, and receive free honours,",
          "plainText": "Do faithful homage and receive free honours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0038",
          "number": 38,
          "speechLineNumber": 14,
          "text": "All which we pine for now. And this report",
          "plainText": "All which we pine for now And this report",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0039",
          "number": 39,
          "speechLineNumber": 15,
          "text": "Hath so exasperate the King that he",
          "plainText": "Hath so exasperate the King that he",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0040",
          "number": 40,
          "speechLineNumber": 16,
          "text": "Prepares for some attempt of war.",
          "plainText": "Prepares for some attempt of war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lennox",
        "name": "LENNOX",
        "displayName": "Lennox"
      },
      "lines": [
        {
          "id": "macbeth-3-6-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Sent he to Macduff?",
          "plainText": "Sent he to Macduff",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-3-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lord",
        "name": "LORD",
        "displayName": "Lord"
      },
      "lines": [
        {
          "id": "macbeth-3-6-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "He did: and with an absolute \"Sir, not I,\"",
          "plainText": "He did and with an absolute Sir not I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "The cloudy messenger turns me his back,",
          "plainText": "The cloudy messenger turns me his back",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "And hums, as who should say, \"You'll rue the time",
          "plainText": "And hums as who should say You'll rue the time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0045",
          "number": 45,
          "speechLineNumber": 4,
          "text": "That clogs me with this answer.\"",
          "plainText": "That clogs me with this answer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lennox",
        "name": "LENNOX",
        "displayName": "Lennox"
      },
      "lines": [
        {
          "id": "macbeth-3-6-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "And that well might",
          "plainText": "And that well might",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Advise him to a caution, t' hold what distance",
          "plainText": "Advise him to a caution t' hold what distance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "His wisdom can provide. Some holy angel",
          "plainText": "His wisdom can provide Some holy angel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "Fly to the court of England, and unfold",
          "plainText": "Fly to the court of England and unfold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0050",
          "number": 50,
          "speechLineNumber": 5,
          "text": "His message ere he come, that a swift blessing",
          "plainText": "His message ere he come that a swift blessing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0051",
          "number": 51,
          "speechLineNumber": 6,
          "text": "May soon return to this our suffering country",
          "plainText": "May soon return to this our suffering country",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-3-6-line-0052",
          "number": 52,
          "speechLineNumber": 7,
          "text": "Under a hand accurs'd!",
          "plainText": "Under a hand accurs'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-3-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "lord",
        "name": "LORD",
        "displayName": "Lord"
      },
      "lines": [
        {
          "id": "macbeth-3-6-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "I'll send my prayers with him.",
          "plainText": "I'll send my prayers with him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-3-6-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}