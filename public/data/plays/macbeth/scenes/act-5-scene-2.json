  "scene": {
    "id": "macbeth-5-2",
    "act": 5,
    "scene": 2,
    "label": "Act 5, Scene 2",
    "title": "SCENE II. The Country near Dunsinane.",
    "location": "The Country near Dunsinane.",
    "orderInPlay": 22
  },
  "content": [
    {
      "id": "macbeth-5-2-stage-001",
      "type": "stage",
      "text": "Enter, with drum and colours Menteith, Caithness, Angus, Lennox and Soldiers."
    },
    {
      "id": "macbeth-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "menteith",
        "name": "MENTEITH",
        "displayName": "Menteith"
      },
      "lines": [
        {
          "id": "macbeth-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The English power is near, led on by Malcolm,",
          "plainText": "The English power is near led on by Malcolm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "His uncle Siward, and the good Macduff.",
          "plainText": "His uncle Siward and the good Macduff",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Revenges burn in them; for their dear causes",
          "plainText": "Revenges burn in them for their dear causes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Would to the bleeding and the grim alarm",
          "plainText": "Would to the bleeding and the grim alarm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Excite the mortified man.",
          "plainText": "Excite the mortified man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "angus",
        "name": "ANGUS",
        "displayName": "Angus"
      },
      "lines": [
        {
          "id": "macbeth-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Near Birnam wood",
          "plainText": "Near Birnam wood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Shall we well meet them. That way are they coming.",
          "plainText": "Shall we well meet them That way are they coming",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "caithness",
        "name": "CAITHNESS",
        "displayName": "Caithness"
      },
      "lines": [
        {
          "id": "macbeth-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Who knows if Donalbain be with his brother?",
          "plainText": "Who knows if Donalbain be with his brother",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lennox",
        "name": "LENNOX",
        "displayName": "Lennox"
      },
      "lines": [
        {
          "id": "macbeth-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "For certain, sir, he is not. I have a file",
          "plainText": "For certain sir he is not I have a file",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Of all the gentry: there is Siward's son",
          "plainText": "Of all the gentry there is Siward's son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "And many unrough youths, that even now",
          "plainText": "And many unrough youths that even now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "Protest their first of manhood.",
          "plainText": "Protest their first of manhood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "menteith",
        "name": "MENTEITH",
        "displayName": "Menteith"
      },
      "lines": [
        {
          "id": "macbeth-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "What does the tyrant?",
          "plainText": "What does the tyrant",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "caithness",
        "name": "CAITHNESS",
        "displayName": "Caithness"
      },
      "lines": [
        {
          "id": "macbeth-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Great Dunsinane he strongly fortifies.",
          "plainText": "Great Dunsinane he strongly fortifies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Some say he's mad; others, that lesser hate him,",
          "plainText": "Some say he's mad others that lesser hate him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "Do call it valiant fury: but, for certain,",
          "plainText": "Do call it valiant fury but for certain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "He cannot buckle his distemper'd cause",
          "plainText": "He cannot buckle his distemper'd cause",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "Within the belt of rule.",
          "plainText": "Within the belt of rule",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "angus",
        "name": "ANGUS",
        "displayName": "Angus"
      },
      "lines": [
        {
          "id": "macbeth-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Now does he feel",
          "plainText": "Now does he feel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "His secret murders sticking on his hands;",
          "plainText": "His secret murders sticking on his hands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Now minutely revolts upbraid his faith-breach;",
          "plainText": "Now minutely revolts upbraid his faithbreach",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "Those he commands move only in command,",
          "plainText": "Those he commands move only in command",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "Nothing in love: now does he feel his title",
          "plainText": "Nothing in love now does he feel his title",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "Hang loose about him, like a giant's robe",
          "plainText": "Hang loose about him like a giant's robe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0025",
          "number": 25,
          "speechLineNumber": 7,
          "text": "Upon a dwarfish thief.",
          "plainText": "Upon a dwarfish thief",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "menteith",
        "name": "MENTEITH",
        "displayName": "Menteith"
      },
      "lines": [
        {
          "id": "macbeth-5-2-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Who, then, shall blame",
          "plainText": "Who then shall blame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "His pester'd senses to recoil and start,",
          "plainText": "His pester'd senses to recoil and start",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "When all that is within him does condemn",
          "plainText": "When all that is within him does condemn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "Itself for being there?",
          "plainText": "Itself for being there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "caithness",
        "name": "CAITHNESS",
        "displayName": "Caithness"
      },
      "lines": [
        {
          "id": "macbeth-5-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Well, march we on,",
          "plainText": "Well march we on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "To give obedience where 'tis truly ow'd:",
          "plainText": "To give obedience where 'tis truly ow'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "Meet we the med'cine of the sickly weal;",
          "plainText": "Meet we the med'cine of the sickly weal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0033",
          "number": 33,
          "speechLineNumber": 4,
          "text": "And with him pour we, in our country's purge,",
          "plainText": "And with him pour we in our country's purge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0034",
          "number": 34,
          "speechLineNumber": 5,
          "text": "Each drop of us.",
          "plainText": "Each drop of us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "lennox",
        "name": "LENNOX",
        "displayName": "Lennox"
      },
      "lines": [
        {
          "id": "macbeth-5-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Or so much as it needs",
          "plainText": "Or so much as it needs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "To dew the sovereign flower, and drown the weeds.",
          "plainText": "To dew the sovereign flower and drown the weeds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-2-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "Make we our march towards Birnam.",
          "plainText": "Make we our march towards Birnam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-2-stage-002",
      "type": "stage",
      "text": "[Exeunt, marching.]"
    }
  ]
}