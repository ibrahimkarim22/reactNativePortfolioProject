  "content": [
    {
      "id": "macbeth-5-3-stage-001",
      "type": "stage",
      "text": "Enter Macbeth, Doctor and Attendants."
    },
    {
      "id": "macbeth-5-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Bring me no more reports; let them fly all:",
          "plainText": "Bring me no more reports let them fly all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Till Birnam wood remove to Dunsinane",
          "plainText": "Till Birnam wood remove to Dunsinane",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "I cannot taint with fear. What's the boy Malcolm?",
          "plainText": "I cannot taint with fear What's the boy Malcolm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Was he not born of woman? The spirits that know",
          "plainText": "Was he not born of woman The spirits that know",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "All mortal consequences have pronounc'd me thus:",
          "plainText": "All mortal consequences have pronounc'd me thus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "\"Fear not, Macbeth; no man that's born of woman",
          "plainText": "Fear not Macbeth no man that's born of woman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Shall e'er have power upon thee.\"—Then fly, false thanes,",
          "plainText": "Shall e'er have power upon theeThen fly false thanes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "And mingle with the English epicures:",
          "plainText": "And mingle with the English epicures",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "The mind I sway by, and the heart I bear,",
          "plainText": "The mind I sway by and the heart I bear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Shall never sag with doubt nor shake with fear.",
          "plainText": "Shall never sag with doubt nor shake with fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-3-stage-002",
      "type": "stage",
      "text": "Enter a Servant."
    },
    {
      "id": "macbeth-5-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "There is ten thousand—",
          "plainText": "There is ten thousand",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Geese, villain?",
          "plainText": "Geese villain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Soldiers, sir.",
          "plainText": "Soldiers sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Go prick thy face and over-red thy fear,",
          "plainText": "Go prick thy face and overred thy fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Thou lily-liver'd boy. What soldiers, patch?",
          "plainText": "Thou lilyliver'd boy What soldiers patch",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "Death of thy soul! those linen cheeks of thine",
          "plainText": "Death of thy soul those linen cheeks of thine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "Are counsellors to fear. What soldiers, whey-face?",
          "plainText": "Are counsellors to fear What soldiers wheyface",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "The English force, so please you.",
          "plainText": "The English force so please you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Take thy face hence.",
          "plainText": "Take thy face hence",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-3-stage-003",
      "type": "stage",
      "text": "[Exit Servant.]"
    },
    {
      "id": "macbeth-5-3-stage-004",
      "type": "stage",
      "text": "Enter Seyton."
    },
    {
      "id": "macbeth-5-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "seyton",
        "name": "SEYTON",
        "displayName": "Seyton"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "What's your gracious pleasure?",
          "plainText": "What's your gracious pleasure",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "What news more?",
          "plainText": "What news more",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "seyton",
        "name": "SEYTON",
        "displayName": "Seyton"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "All is confirm'd, my lord, which was reported.",
          "plainText": "All is confirm'd my lord which was reported",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "I'll fight till from my bones my flesh be hack'd.",
          "plainText": "I'll fight till from my bones my flesh be hack'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Give me my armour.",
          "plainText": "Give me my armour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "seyton",
        "name": "SEYTON",
        "displayName": "Seyton"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "'Tis not needed yet.",
          "plainText": "'Tis not needed yet",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "I'll put it on.",
          "plainText": "I'll put it on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "Send out more horses, skirr the country round;",
          "plainText": "Send out more horses skirr the country round",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "Hang those that talk of fear. Give me mine armour.—",
          "plainText": "Hang those that talk of fear Give me mine armour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "How does your patient, doctor?",
          "plainText": "How does your patient doctor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Not so sick, my lord,",
          "plainText": "Not so sick my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "As she is troubled with thick-coming fancies,",
          "plainText": "As she is troubled with thickcoming fancies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "That keep her from her rest.",
          "plainText": "That keep her from her rest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Cure her of that:",
          "plainText": "Cure her of that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Canst thou not minister to a mind diseas'd,",
          "plainText": "Canst thou not minister to a mind diseas'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Pluck from the memory a rooted sorrow,",
          "plainText": "Pluck from the memory a rooted sorrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "Raze out the written troubles of the brain,",
          "plainText": "Raze out the written troubles of the brain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0037",
          "number": 37,
          "speechLineNumber": 5,
          "text": "And with some sweet oblivious antidote",
          "plainText": "And with some sweet oblivious antidote",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0038",
          "number": 38,
          "speechLineNumber": 6,
          "text": "Cleanse the stuff'd bosom of that perilous stuff",
          "plainText": "Cleanse the stuff'd bosom of that perilous stuff",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0039",
          "number": 39,
          "speechLineNumber": 7,
          "text": "Which weighs upon the heart?",
          "plainText": "Which weighs upon the heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "doctor",
        "name": "DOCTOR",
        "displayName": "Doctor"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Therein the patient",
          "plainText": "Therein the patient",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Must minister to himself.",
          "plainText": "Must minister to himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-3-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Throw physic to the dogs, I'll none of it.",
          "plainText": "Throw physic to the dogs I'll none of it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "Come, put mine armour on; give me my staff:",
          "plainText": "Come put mine armour on give me my staff",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "Seyton, send out.—Doctor, the Thanes fly from me.—",
          "plainText": "Seyton send outDoctor the Thanes fly from me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0045",
          "number": 45,
          "speechLineNumber": 4,
          "text": "Come, sir, despatch.—If thou couldst, doctor, cast",
          "plainText": "Come sir despatchIf thou couldst doctor cast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0046",
          "number": 46,
          "speechLineNumber": 5,
          "text": "The water of my land, find her disease,",
          "plainText": "The water of my land find her disease",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0047",
          "number": 47,
          "speechLineNumber": 6,
          "text": "And purge it to a sound and pristine health,",
          "plainText": "And purge it to a sound and pristine health",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0048",
          "number": 48,
          "speechLineNumber": 7,
          "text": "I would applaud thee to the very echo,",
          "plainText": "I would applaud thee to the very echo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0049",
          "number": 49,
          "speechLineNumber": 8,
          "text": "That should applaud again.—Pull't off, I say.—",
          "plainText": "That should applaud againPull't off I say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-3-line-0050",
          "number": 50,
