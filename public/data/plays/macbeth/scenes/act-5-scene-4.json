  "scene": {
    "id": "macbeth-5-4",
    "act": 5,
    "scene": 4,
    "label": "Act 5, Scene 4",
    "title": "SCENE IV. Country near Dunsinane: a Wood in view.",
    "location": "Country near Dunsinane: a Wood in view.",
    "orderInPlay": 24
  },
  "content": [
    {
      "id": "macbeth-5-4-stage-001",
      "type": "stage",
      "text": "Enter, with drum and colours Malcolm, old Siward and his Son, Macduff, Menteith, Caithness, Angus, Lennox, Ross and Soldiers, marching."
    },
    {
      "id": "macbeth-5-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "malcolm",
        "name": "MALCOLM",
        "displayName": "Malcolm"
      },
      "lines": [
        {
          "id": "macbeth-5-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Cousins, I hope the days are near at hand",
          "plainText": "Cousins I hope the days are near at hand",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "That chambers will be safe.",
          "plainText": "That chambers will be safe",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-5-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "menteith",
        "name": "MENTEITH",
        "displayName": "Menteith"
      },
      "lines": [
        {
          "id": "macbeth-5-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "We doubt it nothing.",
          "plainText": "We doubt it nothing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-5-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "What wood is this before us?",
          "plainText": "What wood is this before us",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-5-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "menteith",
        "name": "MENTEITH",
        "displayName": "Menteith"
      },
      "lines": [
        {
          "id": "macbeth-5-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "The wood of Birnam.",
          "plainText": "The wood of Birnam",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-5-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "malcolm",
        "name": "MALCOLM",
        "displayName": "Malcolm"
      },
      "lines": [
        {
          "id": "macbeth-5-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Let every soldier hew him down a bough,",
          "plainText": "Let every soldier hew him down a bough",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "And bear't before him. Thereby shall we shadow",
          "plainText": "And bear't before him Thereby shall we shadow",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "The numbers of our host, and make discovery",
          "plainText": "The numbers of our host and make discovery",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Err in report of us.",
          "plainText": "Err in report of us",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-5-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "soldiers",
        "name": "SOLDIERS",
        "displayName": "Soldiers"
      },
      "lines": [
        {
          "id": "macbeth-5-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "It shall be done.",
          "plainText": "It shall be done",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "macbeth-5-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-4-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "We learn no other but the confident tyrant",
          "plainText": "We learn no other but the confident tyrant",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Keeps still in Dunsinane, and will endure",
          "plainText": "Keeps still in Dunsinane and will endure",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Our setting down before't.",
          "plainText": "Our setting down before't",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-5-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "malcolm",
        "name": "MALCOLM",
        "displayName": "Malcolm"
      },
      "lines": [
        {
          "id": "macbeth-5-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "'Tis his main hope;",
          "plainText": "'Tis his main hope",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "For where there is advantage to be given,",
          "plainText": "For where there is advantage to be given",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "Both more and less have given him the revolt,",
          "plainText": "Both more and less have given him the revolt",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "And none serve with him but constrained things,",
          "plainText": "And none serve with him but constrained things",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "Whose hearts are absent too.",
          "plainText": "Whose hearts are absent too",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-5-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-5-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Let our just censures",
          "plainText": "Let our just censures",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Attend the true event, and put we on",
          "plainText": "Attend the true event and put we on",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Industrious soldiership.",
          "plainText": "Industrious soldiership",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-5-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-4-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "The time approaches,",
          "plainText": "The time approaches",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "That will with due decision make us know",
          "plainText": "That will with due decision make us know",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "What we shall say we have, and what we owe.",
          "plainText": "What we shall say we have and what we owe",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Thoughts speculative their unsure hopes relate,",
          "plainText": "Thoughts speculative their unsure hopes relate",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "But certain issue strokes must arbitrate;",
          "plainText": "But certain issue strokes must arbitrate",
          "lineType": "verse"
        },
        {
          "id": "macbeth-5-4-line-0027",
          "number": 27,
          "speechLineNumber": 6,
          "text": "Towards which advance the war.",
          "plainText": "Towards which advance the war",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "macbeth-5-4-stage-002",
      "type": "stage",
      "text": "[Exeunt, marching.]"
    }
  ]
}