    "label": "Act 5, Scene 8",
    "title": "SCENE VIII. The same. Another part of the field.",
    "location": "The same. Another part of the field.",
    "orderInPlay": 28
  },
  "content": [
    {
      "id": "macbeth-5-8-stage-001",
      "type": "stage",
      "text": "Enter Macbeth."
    },
    {
      "id": "macbeth-5-8-speech-001",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Why should I play the Roman fool, and die",
          "plainText": "Why should I play the Roman fool and die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "On mine own sword? whiles I see lives, the gashes",
          "plainText": "On mine own sword whiles I see lives the gashes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Do better upon them.",
          "plainText": "Do better upon them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-stage-002",
      "type": "stage",
      "text": "Enter Macduff."
    },
    {
      "id": "macbeth-5-8-speech-002",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Turn, hell-hound, turn!",
          "plainText": "Turn hellhound turn",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-003",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Of all men else I have avoided thee:",
          "plainText": "Of all men else I have avoided thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "But get thee back; my soul is too much charg'd",
          "plainText": "But get thee back my soul is too much charg'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "With blood of thine already.",
          "plainText": "With blood of thine already",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-004",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I have no words;",
          "plainText": "I have no words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "My voice is in my sword: thou bloodier villain",
          "plainText": "My voice is in my sword thou bloodier villain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Than terms can give thee out!",
          "plainText": "Than terms can give thee out",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-stage-003",
      "type": "stage",
      "text": "[They fight.]"
    },
    {
      "id": "macbeth-5-8-speech-005",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Thou losest labour:",
          "plainText": "Thou losest labour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "As easy mayst thou the intrenchant air",
          "plainText": "As easy mayst thou the intrenchant air",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "With thy keen sword impress, as make me bleed:",
          "plainText": "With thy keen sword impress as make me bleed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "Let fall thy blade on vulnerable crests;",
          "plainText": "Let fall thy blade on vulnerable crests",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "I bear a charmed life, which must not yield",
          "plainText": "I bear a charmed life which must not yield",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0016",
          "number": 16,
          "speechLineNumber": 6,
          "text": "To one of woman born.",
          "plainText": "To one of woman born",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-006",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Despair thy charm;",
          "plainText": "Despair thy charm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "And let the angel whom thou still hast serv'd",
          "plainText": "And let the angel whom thou still hast serv'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Tell thee, Macduff was from his mother's womb",
          "plainText": "Tell thee Macduff was from his mother's womb",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "Untimely ripp'd.",
          "plainText": "Untimely ripp'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-007",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Accursed be that tongue that tells me so,",
          "plainText": "Accursed be that tongue that tells me so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "For it hath cow'd my better part of man!",
          "plainText": "For it hath cow'd my better part of man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "And be these juggling fiends no more believ'd,",
          "plainText": "And be these juggling fiends no more believ'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "That palter with us in a double sense;",
          "plainText": "That palter with us in a double sense",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "That keep the word of promise to our ear,",
          "plainText": "That keep the word of promise to our ear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0026",
          "number": 26,
          "speechLineNumber": 6,
          "text": "And break it to our hope!—I'll not fight with thee.",
          "plainText": "And break it to our hopeI'll not fight with thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-008",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Then yield thee, coward,",
          "plainText": "Then yield thee coward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "And live to be the show and gaze o' th' time.",
          "plainText": "And live to be the show and gaze o' th' time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "We'll have thee, as our rarer monsters are,",
          "plainText": "We'll have thee as our rarer monsters are",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "Painted upon a pole, and underwrit,",
          "plainText": "Painted upon a pole and underwrit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "\"Here may you see the tyrant.\"",
          "plainText": "Here may you see the tyrant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-009",
      "type": "speech",
      "speaker": {
        "id": "macbeth",
        "name": "MACBETH",
        "displayName": "Macbeth"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "I will not yield,",
          "plainText": "I will not yield",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "To kiss the ground before young Malcolm's feet,",
          "plainText": "To kiss the ground before young Malcolm's feet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "And to be baited with the rabble's curse.",
          "plainText": "And to be baited with the rabble's curse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "Though Birnam wood be come to Dunsinane,",
          "plainText": "Though Birnam wood be come to Dunsinane",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "And thou oppos'd, being of no woman born,",
          "plainText": "And thou oppos'd being of no woman born",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "Yet I will try the last. Before my body",
          "plainText": "Yet I will try the last Before my body",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "I throw my warlike shield: lay on, Macduff;",
          "plainText": "I throw my warlike shield lay on Macduff",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0039",
          "number": 39,
          "speechLineNumber": 8,
          "text": "And damn'd be him that first cries, \"Hold, enough!\"",
          "plainText": "And damn'd be him that first cries Hold enough",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-stage-004",
      "type": "stage",
      "text": "[Exeunt fighting. Alarums.]"
    },
    {
      "id": "macbeth-5-8-stage-005",
      "type": "stage",
      "text": "Retreat. Flourish. Enter, with drum and colours, Malcolm, old Siward, Ross, Thanes and Soldiers."
    },
    {
      "id": "macbeth-5-8-speech-010",
      "type": "speech",
      "speaker": {
        "id": "malcolm",
        "name": "MALCOLM",
        "displayName": "Malcolm"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "I would the friends we miss were safe arriv'd.",
          "plainText": "I would the friends we miss were safe arriv'd",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-011",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Some must go off; and yet, by these I see,",
          "plainText": "Some must go off and yet by these I see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "So great a day as this is cheaply bought.",
          "plainText": "So great a day as this is cheaply bought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-012",
      "type": "speech",
      "speaker": {
        "id": "malcolm",
        "name": "MALCOLM",
        "displayName": "Malcolm"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Macduff is missing, and your noble son.",
          "plainText": "Macduff is missing and your noble son",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-013",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Your son, my lord, has paid a soldier's debt:",
          "plainText": "Your son my lord has paid a soldier's debt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "He only liv'd but till he was a man;",
          "plainText": "He only liv'd but till he was a man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "The which no sooner had his prowess confirm'd",
          "plainText": "The which no sooner had his prowess confirm'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "In the unshrinking station where he fought,",
          "plainText": "In the unshrinking station where he fought",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0048",
          "number": 48,
          "speechLineNumber": 5,
          "text": "But like a man he died.",
          "plainText": "But like a man he died",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-014",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Then he is dead?",
          "plainText": "Then he is dead",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-015",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Ay, and brought off the field. Your cause of sorrow",
          "plainText": "Ay and brought off the field Your cause of sorrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "Must not be measur'd by his worth, for then",
          "plainText": "Must not be measur'd by his worth for then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0052",
          "number": 52,
          "speechLineNumber": 3,
          "text": "It hath no end.",
          "plainText": "It hath no end",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-016",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Had he his hurts before?",
          "plainText": "Had he his hurts before",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-017",
      "type": "speech",
      "speaker": {
        "id": "ross",
        "name": "ROSS",
        "displayName": "Ross"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Ay, on the front.",
          "plainText": "Ay on the front",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-018",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Why then, God's soldier be he!",
          "plainText": "Why then God's soldier be he",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "Had I as many sons as I have hairs,",
          "plainText": "Had I as many sons as I have hairs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "I would not wish them to a fairer death:",
          "plainText": "I would not wish them to a fairer death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0058",
          "number": 58,
          "speechLineNumber": 4,
          "text": "And so his knell is knoll'd.",
          "plainText": "And so his knell is knoll'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-019",
      "type": "speech",
      "speaker": {
        "id": "malcolm",
        "name": "MALCOLM",
        "displayName": "Malcolm"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "He's worth more sorrow,",
          "plainText": "He's worth more sorrow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "And that I'll spend for him.",
          "plainText": "And that I'll spend for him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-020",
      "type": "speech",
      "speaker": {
        "id": "siward",
        "name": "SIWARD",
        "displayName": "Siward"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "He's worth no more.",
          "plainText": "He's worth no more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "They say he parted well and paid his score:",
          "plainText": "They say he parted well and paid his score",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "And so, God be with him!—Here comes newer comfort.",
          "plainText": "And so God be with himHere comes newer comfort",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-stage-006",
      "type": "stage",
      "text": "Enter Macduff with Macbeth's head."
    },
    {
      "id": "macbeth-5-8-speech-021",
      "type": "speech",
      "speaker": {
        "id": "macduff",
        "name": "MACDUFF",
        "displayName": "Macduff"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Hail, King, for so thou art. Behold, where stands",
          "plainText": "Hail King for so thou art Behold where stands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "Th' usurper's cursed head: the time is free.",
          "plainText": "Th' usurper's cursed head the time is free",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "I see thee compass'd with thy kingdom's pearl,",
          "plainText": "I see thee compass'd with thy kingdom's pearl",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0067",
          "number": 67,
          "speechLineNumber": 4,
          "text": "That speak my salutation in their minds;",
          "plainText": "That speak my salutation in their minds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0068",
          "number": 68,
          "speechLineNumber": 5,
          "text": "Whose voices I desire aloud with mine,—",
          "plainText": "Whose voices I desire aloud with mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0069",
          "number": 69,
          "speechLineNumber": 6,
          "text": "Hail, King of Scotland!",
          "plainText": "Hail King of Scotland",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-speech-022",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Hail, King of Scotland!",
          "plainText": "Hail King of Scotland",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "macbeth-5-8-stage-007",
      "type": "stage",
      "text": "[Flourish.]"
    },
    {
      "id": "macbeth-5-8-speech-023",
      "type": "speech",
      "speaker": {
        "id": "malcolm",
        "name": "MALCOLM",
        "displayName": "Malcolm"
      },
      "lines": [
        {
          "id": "macbeth-5-8-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "We shall not spend a large expense of time",
          "plainText": "We shall not spend a large expense of time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "Before we reckon with your several loves,",
          "plainText": "Before we reckon with your several loves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "And make us even with you. My thanes and kinsmen,",
          "plainText": "And make us even with you My thanes and kinsmen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0074",
          "number": 74,
          "speechLineNumber": 4,
          "text": "Henceforth be earls, the first that ever Scotland",
          "plainText": "Henceforth be earls the first that ever Scotland",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0075",
          "number": 75,
          "speechLineNumber": 5,
          "text": "In such an honour nam'd. What's more to do,",
          "plainText": "In such an honour nam'd What's more to do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0076",
          "number": 76,
          "speechLineNumber": 6,
          "text": "Which would be planted newly with the time,—",
          "plainText": "Which would be planted newly with the time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0077",
          "number": 77,
          "speechLineNumber": 7,
          "text": "As calling home our exil'd friends abroad,",
          "plainText": "As calling home our exil'd friends abroad",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0078",
          "number": 78,
          "speechLineNumber": 8,
          "text": "That fled the snares of watchful tyranny;",
          "plainText": "That fled the snares of watchful tyranny",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0079",
          "number": 79,
          "speechLineNumber": 9,
          "text": "Producing forth the cruel ministers",
          "plainText": "Producing forth the cruel ministers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0080",
          "number": 80,
          "speechLineNumber": 10,
          "text": "Of this dead butcher, and his fiend-like queen,",
          "plainText": "Of this dead butcher and his fiendlike queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0081",
          "number": 81,
          "speechLineNumber": 11,
          "text": "Who, as 'tis thought, by self and violent hands",
          "plainText": "Who as 'tis thought by self and violent hands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0082",
          "number": 82,
          "speechLineNumber": 12,
          "text": "Took off her life;—this, and what needful else",
          "plainText": "Took off her lifethis and what needful else",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0083",
          "number": 83,
          "speechLineNumber": 13,
          "text": "That calls upon us, by the grace of Grace,",
          "plainText": "That calls upon us by the grace of Grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0084",
          "number": 84,
          "speechLineNumber": 14,
          "text": "We will perform in measure, time, and place.",
          "plainText": "We will perform in measure time and place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0085",
          "number": 85,
          "speechLineNumber": 15,
          "text": "So thanks to all at once, and to each one,",
          "plainText": "So thanks to all at once and to each one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "macbeth-5-8-line-0086",
          "number": 86,
          "speechLineNumber": 16,
          "text": "Whom we invite to see us crown'd at Scone.",
          "plainText": "Whom we invite to see us crown'd at Scone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "macbeth-5-8-stage-008",
      "type": "stage",
      "text": "[Flourish. Exeunt.]"
    }
  ]
}