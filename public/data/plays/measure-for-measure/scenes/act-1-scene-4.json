  "scene": {
    "id": "measure-for-measure-1-4",
    "act": 1,
    "scene": 4,
    "label": "Act 1, Scene 4",
    "title": "SCENE IV. A nunnery.",
    "location": "A nunnery.",
    "orderInPlay": 4
  },
  "content": [
    {
      "id": "measure-for-measure-1-4-stage-001",
      "type": "stage",
      "text": "Enter Isabella and Francisca, a Nun."
    },
    {
      "id": "measure-for-measure-1-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "And have you nuns no farther privileges?",
          "plainText": "And have you nuns no farther privileges",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "francisca",
        "name": "FRANCISCA",
        "displayName": "Francisca"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Are not these large enough?",
          "plainText": "Are not these large enough",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Yes, truly; I speak not as desiring more,",
          "plainText": "Yes truly I speak not as desiring more",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "But rather wishing a more strict restraint",
          "plainText": "But rather wishing a more strict restraint",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Upon the sisterhood, the votarists of Saint Clare.",
          "plainText": "Upon the sisterhood the votarists of Saint Clare",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "[Within.] Ho! Peace be in this place!",
          "plainText": "Within Ho Peace be in this place",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Who's that which calls?",
          "plainText": "Who's that which calls",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "francisca",
        "name": "FRANCISCA",
        "displayName": "Francisca"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "It is a man's voice. Gentle Isabella,",
          "plainText": "It is a man's voice Gentle Isabella",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Turn you the key, and know his business of him;",
          "plainText": "Turn you the key and know his business of him",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "You may, I may not; you are yet unsworn.",
          "plainText": "You may I may not you are yet unsworn",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "When you have vowed, you must not speak with men",
          "plainText": "When you have vowed you must not speak with men",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "But in the presence of the prioress;",
          "plainText": "But in the presence of the prioress",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "Then, if you speak, you must not show your face;",
          "plainText": "Then if you speak you must not show your face",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0014",
          "number": 14,
          "speechLineNumber": 7,
          "text": "Or if you show your face, you must not speak.",
          "plainText": "Or if you show your face you must not speak",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0015",
          "number": 15,
          "speechLineNumber": 8,
          "text": "He calls again. I pray you answer him.",
          "plainText": "He calls again I pray you answer him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-stage-002",
      "type": "stage",
      "text": "[Exit Francisca.]"
    },
    {
      "id": "measure-for-measure-1-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Peace and prosperity! Who is't that calls?",
          "plainText": "Peace and prosperity Who is't that calls",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-stage-003",
      "type": "stage",
      "text": "Enter Lucio."
    },
    {
      "id": "measure-for-measure-1-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Hail, virgin, if you be, as those cheek-roses",
          "plainText": "Hail virgin if you be as those cheekroses",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Proclaim you are no less. Can you so stead me",
          "plainText": "Proclaim you are no less Can you so stead me",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "As bring me to the sight of Isabella,",
          "plainText": "As bring me to the sight of Isabella",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "A novice of this place, and the fair sister",
          "plainText": "A novice of this place and the fair sister",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "To her unhappy brother Claudio?",
          "plainText": "To her unhappy brother Claudio",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Why \"her unhappy brother\"? let me ask,",
          "plainText": "Why her unhappy brother let me ask",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "The rather for I now must make you know",
          "plainText": "The rather for I now must make you know",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "I am that Isabella, and his sister.",
          "plainText": "I am that Isabella and his sister",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Gentle and fair, your brother kindly greets you.",
          "plainText": "Gentle and fair your brother kindly greets you",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Not to be weary with you, he's in prison.",
          "plainText": "Not to be weary with you he's in prison",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Woe me! For what?",
          "plainText": "Woe me For what",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "For that which, if myself might be his judge,",
          "plainText": "For that which if myself might be his judge",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "He should receive his punishment in thanks:",
          "plainText": "He should receive his punishment in thanks",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "He hath got his friend with child.",
          "plainText": "He hath got his friend with child",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Sir, make me not your story.",
          "plainText": "Sir make me not your story",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "'Tis true.",
          "plainText": "'Tis true",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "I would not, though 'tis my familiar sin",
          "plainText": "I would not though 'tis my familiar sin",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "With maids to seem the lapwing, and to jest,",
          "plainText": "With maids to seem the lapwing and to jest",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "Tongue far from heart, play with all virgins so.",
          "plainText": "Tongue far from heart play with all virgins so",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "I hold you as a thing enskied and sainted",
          "plainText": "I hold you as a thing enskied and sainted",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "By your renouncement an immortal spirit,",
          "plainText": "By your renouncement an immortal spirit",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "And to be talked with in sincerity,",
          "plainText": "And to be talked with in sincerity",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0039",
          "number": 39,
          "speechLineNumber": 8,
          "text": "As with a saint.",
          "plainText": "As with a saint",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "You do blaspheme the good in mocking me.",
          "plainText": "You do blaspheme the good in mocking me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Do not believe it. Fewness and truth, 'tis thus:",
          "plainText": "Do not believe it Fewness and truth 'tis thus",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Your brother and his lover have embraced;",
          "plainText": "Your brother and his lover have embraced",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "As those that feed grow full, as blossoming time",
          "plainText": "As those that feed grow full as blossoming time",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "That from the seedness the bare fallow brings",
          "plainText": "That from the seedness the bare fallow brings",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "To teeming foison, even so her plenteous womb",
          "plainText": "To teeming foison even so her plenteous womb",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "Expresseth his full tilth and husbandry.",
          "plainText": "Expresseth his full tilth and husbandry",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Someone with child by him? My cousin Juliet?",
          "plainText": "Someone with child by him My cousin Juliet",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Is she your cousin?",
          "plainText": "Is she your cousin",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Adoptedly, as school-maids change their names",
          "plainText": "Adoptedly as schoolmaids change their names",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "By vain though apt affection.",
          "plainText": "By vain though apt affection",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "She it is.",
          "plainText": "She it is",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "O, let him marry her!",
          "plainText": "O let him marry her",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "This is the point.",
          "plainText": "This is the point",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "The Duke is very strangely gone from hence;",
          "plainText": "The Duke is very strangely gone from hence",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0055",
          "number": 55,
          "speechLineNumber": 3,
          "text": "Bore many gentlemen, myself being one,",
          "plainText": "Bore many gentlemen myself being one",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0056",
          "number": 56,
          "speechLineNumber": 4,
          "text": "In hand, and hope of action; but we do learn,",
          "plainText": "In hand and hope of action but we do learn",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0057",
          "number": 57,
          "speechLineNumber": 5,
          "text": "By those that know the very nerves of state,",
          "plainText": "By those that know the very nerves of state",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0058",
          "number": 58,
          "speechLineNumber": 6,
          "text": "His givings-out were of an infinite distance",
          "plainText": "His givingsout were of an infinite distance",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0059",
          "number": 59,
          "speechLineNumber": 7,
          "text": "From his true-meant design. Upon his place,",
          "plainText": "From his truemeant design Upon his place",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0060",
          "number": 60,
          "speechLineNumber": 8,
          "text": "And with full line of his authority,",
          "plainText": "And with full line of his authority",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0061",
          "number": 61,
          "speechLineNumber": 9,
          "text": "Governs Lord Angelo; a man whose blood",
          "plainText": "Governs Lord Angelo a man whose blood",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0062",
          "number": 62,
          "speechLineNumber": 10,
          "text": "Is very snow-broth; one who never feels",
          "plainText": "Is very snowbroth one who never feels",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0063",
          "number": 63,
          "speechLineNumber": 11,
          "text": "The wanton stings and motions of the sense;",
          "plainText": "The wanton stings and motions of the sense",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0064",
          "number": 64,
          "speechLineNumber": 12,
          "text": "But doth rebate and blunt his natural edge",
          "plainText": "But doth rebate and blunt his natural edge",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0065",
          "number": 65,
          "speechLineNumber": 13,
          "text": "With profits of the mind, study and fast.",
          "plainText": "With profits of the mind study and fast",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0066",
          "number": 66,
          "speechLineNumber": 14,
          "text": "He, to give fear to use and liberty,",
          "plainText": "He to give fear to use and liberty",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0067",
          "number": 67,
          "speechLineNumber": 15,
          "text": "Which have for long run by the hideous law",
          "plainText": "Which have for long run by the hideous law",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0068",
          "number": 68,
          "speechLineNumber": 16,
          "text": "As mice by lions, hath picked out an act,",
          "plainText": "As mice by lions hath picked out an act",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0069",
          "number": 69,
          "speechLineNumber": 17,
          "text": "Under whose heavy sense your brother's life",
          "plainText": "Under whose heavy sense your brother's life",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0070",
          "number": 70,
          "speechLineNumber": 18,
          "text": "Falls into forfeit. He arrests him on it,",
          "plainText": "Falls into forfeit He arrests him on it",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0071",
          "number": 71,
          "speechLineNumber": 19,
          "text": "And follows close the rigour of the statute",
          "plainText": "And follows close the rigour of the statute",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0072",
          "number": 72,
          "speechLineNumber": 20,
          "text": "To make him an example. All hope is gone,",
          "plainText": "To make him an example All hope is gone",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0073",
          "number": 73,
          "speechLineNumber": 21,
          "text": "Unless you have the grace by your fair prayer",
          "plainText": "Unless you have the grace by your fair prayer",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0074",
          "number": 74,
          "speechLineNumber": 22,
          "text": "To soften Angelo. And that's my pith of business",
          "plainText": "To soften Angelo And that's my pith of business",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0075",
          "number": 75,
          "speechLineNumber": 23,
          "text": "'Twixt you and your poor brother.",
          "plainText": "'Twixt you and your poor brother",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Doth he so",
          "plainText": "Doth he so",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0077",
          "number": 77,
          "speechLineNumber": 2,
          "text": "Seek his life?",
          "plainText": "Seek his life",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "Has censured him already;",
          "plainText": "Has censured him already",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0079",
          "number": 79,
          "speechLineNumber": 2,
          "text": "And, as I hear, the Provost hath a warrant",
          "plainText": "And as I hear the Provost hath a warrant",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0080",
          "number": 80,
          "speechLineNumber": 3,
          "text": "For's execution.",
          "plainText": "For's execution",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-025",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "Alas, what poor ability's in me",
          "plainText": "Alas what poor ability's in me",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0082",
          "number": 82,
          "speechLineNumber": 2,
          "text": "To do him good?",
          "plainText": "To do him good",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-026",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "Assay the power you have.",
          "plainText": "Assay the power you have",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-027",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "My power? Alas, I doubt.",
          "plainText": "My power Alas I doubt",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-028",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0085",
          "number": 85,
          "speechLineNumber": 1,
          "text": "Our doubts are traitors,",
          "plainText": "Our doubts are traitors",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0086",
          "number": 86,
          "speechLineNumber": 2,
          "text": "And make us lose the good we oft might win",
          "plainText": "And make us lose the good we oft might win",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0087",
          "number": 87,
          "speechLineNumber": 3,
          "text": "By fearing to attempt. Go to Lord Angelo,",
          "plainText": "By fearing to attempt Go to Lord Angelo",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0088",
          "number": 88,
          "speechLineNumber": 4,
          "text": "And let him learn to know, when maidens sue,",
          "plainText": "And let him learn to know when maidens sue",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0089",
          "number": 89,
          "speechLineNumber": 5,
          "text": "Men give like gods; but when they weep and kneel,",
          "plainText": "Men give like gods but when they weep and kneel",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0090",
          "number": 90,
          "speechLineNumber": 6,
          "text": "All their petitions are as freely theirs",
          "plainText": "All their petitions are as freely theirs",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0091",
          "number": 91,
          "speechLineNumber": 7,
          "text": "As they themselves would owe them.",
          "plainText": "As they themselves would owe them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-029",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "I'll see what I can do.",
          "plainText": "I'll see what I can do",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-030",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "But speedily.",
          "plainText": "But speedily",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-031",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0094",
          "number": 94,
          "speechLineNumber": 1,
          "text": "I will about it straight;",
          "plainText": "I will about it straight",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0095",
          "number": 95,
          "speechLineNumber": 2,
          "text": "No longer staying but to give the Mother",
          "plainText": "No longer staying but to give the Mother",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0096",
          "number": 96,
          "speechLineNumber": 3,
          "text": "Notice of my affair. I humbly thank you.",
          "plainText": "Notice of my affair I humbly thank you",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0097",
          "number": 97,
          "speechLineNumber": 4,
          "text": "Commend me to my brother. Soon at night",
          "plainText": "Commend me to my brother Soon at night",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-1-4-line-0098",
          "number": 98,
          "speechLineNumber": 5,
          "text": "I'll send him certain word of my success.",
          "plainText": "I'll send him certain word of my success",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-032",
      "type": "speech",
      "speaker": {
        "id": "lucio",
        "name": "LUCIO",
        "displayName": "Lucio"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0099",
          "number": 99,
          "speechLineNumber": 1,
          "text": "I take my leave of you.",
          "plainText": "I take my leave of you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-speech-033",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-1-4-line-0100",
          "number": 100,
          "speechLineNumber": 1,
          "text": "Good sir, adieu.",
          "plainText": "Good sir adieu",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-1-4-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}