{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "measure-for-measure",
    "title": "Measure For Measure",
    "author": "William Shakespeare",
    "genre": "Problem Play"
  },
  "source": {
    "name": "Project Gutenberg",
    "ebookNumber": 100,
    "rights": "Public domain in the USA",
    "sourceFile": "pg100-images.html"
  },
  "scene": {
    "id": "measure-for-measure-2-3",
    "act": 2,
    "scene": 3,
    "label": "Act 2, Scene 3",
    "title": "SCENE III. A room in a prison.",
    "location": "A room in a prison.",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "measure-for-measure-2-3-stage-001",
      "type": "stage",
      "text": "Enter Duke disguised as a Friar, and Provost."
    },
    {
      "id": "measure-for-measure-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Hail to you, Provost, so I think you are.",
          "plainText": "Hail to you Provost so I think you are",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "provost",
        "name": "PROVOST",
        "displayName": "Provost"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "I am the Provost. What's your will, good friar?",
          "plainText": "I am the Provost What's your will good friar",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Bound by my charity and my blessed order,",
          "plainText": "Bound by my charity and my blessed order",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "I come to visit the afflicted spirits",
          "plainText": "I come to visit the afflicted spirits",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Here in the prison. Do me the common right",
          "plainText": "Here in the prison Do me the common right",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "To let me see them, and to make me know",
          "plainText": "To let me see them and to make me know",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 5,
          "text": "The nature of their crimes, that I may minister",
          "plainText": "The nature of their crimes that I may minister",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 6,
          "text": "To them accordingly.",
          "plainText": "To them accordingly",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "provost",
        "name": "PROVOST",
        "displayName": "Provost"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "I would do more than that, if more were needful.",
          "plainText": "I would do more than that if more were needful",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-stage-002",
      "type": "stage",
      "text": "Enter Juliet."
    },
    {
      "id": "measure-for-measure-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "When must he die?",
          "plainText": "When must he die",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "provost",
        "name": "PROVOST",
        "displayName": "Provost"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "As I do think, tomorrow.",
          "plainText": "As I do think tomorrow",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "[To Juliet.] I have provided for you; stay a while",
          "plainText": "To Juliet I have provided for you stay a while",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "And you shall be conducted.",
          "plainText": "And you shall be conducted",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Repent you, fair one, of the sin you carry?",
          "plainText": "Repent you fair one of the sin you carry",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "I do; and bear the shame most patiently.",
          "plainText": "I do and bear the shame most patiently",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "I'll teach you how you shall arraign your conscience,",
          "plainText": "I'll teach you how you shall arraign your conscience",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "And try your penitence, if it be sound",
          "plainText": "And try your penitence if it be sound",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Or hollowly put on.",
          "plainText": "Or hollowly put on",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I'll gladly learn.",
          "plainText": "I'll gladly learn",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Love you the man that wronged you?",
          "plainText": "Love you the man that wronged you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Yes, as I love the woman that wronged him.",
          "plainText": "Yes as I love the woman that wronged him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "So then it seems your most offenceful act",
          "plainText": "So then it seems your most offenceful act",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Was mutually committed?",
          "plainText": "Was mutually committed",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Mutually.",
          "plainText": "Mutually",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Then was your sin of heavier kind than his.",
          "plainText": "Then was your sin of heavier kind than his",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "I do confess it, and repent it, father.",
          "plainText": "I do confess it and repent it father",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "'Tis meet so, daughter; but lest you do repent",
          "plainText": "'Tis meet so daughter but lest you do repent",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "As that the sin hath brought you to this shame,",
          "plainText": "As that the sin hath brought you to this shame",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "Which sorrow is always toward ourselves, not heaven,",
          "plainText": "Which sorrow is always toward ourselves not heaven",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "Showing we would not spare heaven as we love it,",
          "plainText": "Showing we would not spare heaven as we love it",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "But as we stand in fear—",
          "plainText": "But as we stand in fear",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "I do repent me as it is an evil,",
          "plainText": "I do repent me as it is an evil",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "And take the shame with joy.",
          "plainText": "And take the shame with joy",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "There rest.",
          "plainText": "There rest",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Your partner, as I hear, must die tomorrow,",
          "plainText": "Your partner as I hear must die tomorrow",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "And I am going with instruction to him.",
          "plainText": "And I am going with instruction to him",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "Grace go with you! Benedicite!",
          "plainText": "Grace go with you Benedicite",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "measure-for-measure-2-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Must die tomorrow? O, injurious love",
          "plainText": "Must die tomorrow O injurious love",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "That respites me a life, whose very comfort",
          "plainText": "That respites me a life whose very comfort",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-2-3-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "Is still a dying horror!",
          "plainText": "Is still a dying horror",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "provost",
        "name": "PROVOST",
        "displayName": "Provost"
      },
      "lines": [
        {
          "id": "measure-for-measure-2-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "'Tis pity of him.",
          "plainText": "'Tis pity of him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-2-3-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}