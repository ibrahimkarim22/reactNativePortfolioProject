  },
  "scene": {
    "id": "measure-for-measure-4-1",
    "act": 4,
    "scene": 1,
    "label": "Act 4, Scene 1",
    "title": "SCENE I. A room in Mariana's house.",
    "location": "A room in Mariana's house.",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "measure-for-measure-4-1-stage-001",
      "type": "stage",
      "text": "Enter Mariana and a Boy singing."
    },
    {
      "id": "measure-for-measure-4-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "song",
        "name": "SONG",
        "displayName": "Song"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Take, O take those lips away,",
          "plainText": "Take O take those lips away",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "That so sweetly were forsworn,",
          "plainText": "That so sweetly were forsworn",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And those eyes, the break of day,",
          "plainText": "And those eyes the break of day",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Lights that do mislead the morn.",
          "plainText": "Lights that do mislead the morn",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "But my kisses bring again,",
          "plainText": "But my kisses bring again",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Bring again;",
          "plainText": "Bring again",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Seals of love, but sealed in vain,",
          "plainText": "Seals of love but sealed in vain",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Sealed in vain.",
          "plainText": "Sealed in vain",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-stage-002",
      "type": "stage",
      "text": "Enter Duke as a Friar."
    },
    {
      "id": "measure-for-measure-4-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "mariana",
        "name": "MARIANA",
        "displayName": "Mariana"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Break off thy song, and haste thee quick away;",
          "plainText": "Break off thy song and haste thee quick away",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Here comes a man of comfort, whose advice",
          "plainText": "Here comes a man of comfort whose advice",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Hath often stilled my brawling discontent.",
          "plainText": "Hath often stilled my brawling discontent",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-stage-003",
      "type": "stage",
      "text": "[Exit Boy.]"
    },
    {
      "id": "measure-for-measure-4-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "'Tis good; though music oft hath such a charm",
          "plainText": "'Tis good though music oft hath such a charm",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "To make bad good and good provoke to harm.",
          "plainText": "To make bad good and good provoke to harm",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "I pray you tell me, hath anybody inquired for me here today? Much upon this time have I promised here to meet.",
          "plainText": "I pray you tell me hath anybody inquired for me here today Much upon this time have I promised here to meet",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "mariana",
        "name": "MARIANA",
        "displayName": "Mariana"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "You have not been inquired after. I have sat here all day.",
          "plainText": "You have not been inquired after I have sat here all day",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-stage-004",
      "type": "stage",
      "text": "Enter Isabella."
    },
    {
      "id": "measure-for-measure-4-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "I do constantly believe you. The time is come even now. I shall crave your forbearance a little. Maybe I will call upon you anon for some advantage to yourself.",
          "plainText": "I do constantly believe you The time is come even now I shall crave your forbearance a little Maybe I will call upon you anon for some advantage to yourself",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "mariana",
        "name": "MARIANA",
        "displayName": "Mariana"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "I am always bound to you.",
          "plainText": "I am always bound to you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-stage-005",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "measure-for-measure-4-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Very well met, and welcome.",
          "plainText": "Very well met and welcome",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "What is the news from this good deputy?",
          "plainText": "What is the news from this good deputy",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "He hath a garden circummured with brick,",
          "plainText": "He hath a garden circummured with brick",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Whose western side is with a vineyard backed;",
          "plainText": "Whose western side is with a vineyard backed",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "And to that vineyard is a planched gate",
          "plainText": "And to that vineyard is a planched gate",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "That makes his opening with this bigger key.",
          "plainText": "That makes his opening with this bigger key",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "This other doth command a little door",
          "plainText": "This other doth command a little door",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0025",
          "number": 25,
          "speechLineNumber": 6,
          "text": "Which from the vineyard to the garden leads;",
          "plainText": "Which from the vineyard to the garden leads",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0026",
          "number": 26,
          "speechLineNumber": 7,
          "text": "There have I made my promise, upon the",
          "plainText": "There have I made my promise upon the",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0027",
          "number": 27,
          "speechLineNumber": 8,
          "text": "Heavy middle of the night to call on him.",
          "plainText": "Heavy middle of the night to call on him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "But shall you on your knowledge find this way?",
          "plainText": "But shall you on your knowledge find this way",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I have ta'en a due and wary note upon't;",
          "plainText": "I have ta'en a due and wary note upon't",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "With whispering and most guilty diligence,",
          "plainText": "With whispering and most guilty diligence",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "In action all of precept, he did show me",
          "plainText": "In action all of precept he did show me",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "The way twice o'er.",
          "plainText": "The way twice o'er",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Are there no other tokens",
          "plainText": "Are there no other tokens",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Between you 'greed concerning her observance?",
          "plainText": "Between you 'greed concerning her observance",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "No, none, but only a repair i' th' dark,",
          "plainText": "No none but only a repair i' th' dark",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "And that I have possessed him my most stay",
          "plainText": "And that I have possessed him my most stay",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "Can be but brief, for I have made him know",
          "plainText": "Can be but brief for I have made him know",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0038",
          "number": 38,
          "speechLineNumber": 4,
          "text": "I have a servant comes with me along,",
          "plainText": "I have a servant comes with me along",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0039",
          "number": 39,
          "speechLineNumber": 5,
          "text": "That stays upon me; whose persuasion is",
          "plainText": "That stays upon me whose persuasion is",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0040",
          "number": 40,
          "speechLineNumber": 6,
          "text": "I come about my brother.",
          "plainText": "I come about my brother",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "'Tis well borne up.",
          "plainText": "'Tis well borne up",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "I have not yet made known to Mariana",
          "plainText": "I have not yet made known to Mariana",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "A word of this.—What ho, within! Come forth.",
          "plainText": "A word of thisWhat ho within Come forth",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-stage-006",
      "type": "stage",
      "text": "Enter Mariana."
    },
    {
      "id": "measure-for-measure-4-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "I do desire the like.",
          "plainText": "I do desire the like",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Do you persuade yourself that I respect you?",
          "plainText": "Do you persuade yourself that I respect you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "mariana",
        "name": "MARIANA",
        "displayName": "Mariana"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Good friar, I know you do, and have found it.",
          "plainText": "Good friar I know you do and have found it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Take, then, this your companion by the hand,",
          "plainText": "Take then this your companion by the hand",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "Who hath a story ready for your ear.",
          "plainText": "Who hath a story ready for your ear",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0049",
          "number": 49,
          "speechLineNumber": 3,
          "text": "I shall attend your leisure; but make haste.",
          "plainText": "I shall attend your leisure but make haste",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0050",
          "number": 50,
          "speechLineNumber": 4,
          "text": "The vaporous night approaches.",
          "plainText": "The vaporous night approaches",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "mariana",
        "name": "MARIANA",
        "displayName": "Mariana"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Will't please you walk aside?",
          "plainText": "Will't please you walk aside",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-stage-007",
      "type": "stage",
      "text": "[Exeunt Mariana and Isabella.]"
    },
    {
      "id": "measure-for-measure-4-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "O place and greatness, millions of false eyes",
          "plainText": "O place and greatness millions of false eyes",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Are stuck upon thee; volumes of report",
          "plainText": "Are stuck upon thee volumes of report",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "Run with these false, and most contrarious quest",
          "plainText": "Run with these false and most contrarious quest",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0055",
          "number": 55,
          "speechLineNumber": 4,
          "text": "Upon thy doings; thousand escapes of wit",
          "plainText": "Upon thy doings thousand escapes of wit",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0056",
          "number": 56,
          "speechLineNumber": 5,
          "text": "Make thee the father of their idle dream",
          "plainText": "Make thee the father of their idle dream",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0057",
          "number": 57,
          "speechLineNumber": 6,
          "text": "And rack thee in their fancies.",
          "plainText": "And rack thee in their fancies",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-stage-008",
      "type": "stage",
      "text": "Enter Mariana and Isabella."
    },
    {
      "id": "measure-for-measure-4-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "She'll take the enterprise upon her, father,",
          "plainText": "She'll take the enterprise upon her father",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "If you advise it.",
          "plainText": "If you advise it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "It is not my consent,",
          "plainText": "It is not my consent",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "But my entreaty too.",
          "plainText": "But my entreaty too",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Little have you to say",
          "plainText": "Little have you to say",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "When you depart from him, but, soft and low,",
          "plainText": "When you depart from him but soft and low",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "\"Remember now my brother.\"",
          "plainText": "Remember now my brother",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "mariana",
        "name": "MARIANA",
        "displayName": "Mariana"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Fear me not.",
          "plainText": "Fear me not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-1-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Nor, gentle daughter, fear you not at all.",
          "plainText": "Nor gentle daughter fear you not at all",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "He is your husband on a pre-contract.",
          "plainText": "He is your husband on a precontract",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0068",
          "number": 68,
          "speechLineNumber": 3,
          "text": "To bring you thus together 'tis no sin,",
          "plainText": "To bring you thus together 'tis no sin",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0069",
          "number": 69,
          "speechLineNumber": 4,
          "text": "Sith that the justice of your title to him",
          "plainText": "Sith that the justice of your title to him",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0070",
          "number": 70,
          "speechLineNumber": 5,
          "text": "Doth flourish the deceit. Come, let us go;",
          "plainText": "Doth flourish the deceit Come let us go",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-1-line-0071",
          "number": 71,
          "speechLineNumber": 6,
          "text": "Our corn's to reap, for yet our tithe's to sow.",
          "plainText": "Our corn's to reap for yet our tithe's to sow",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-1-stage-009",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}