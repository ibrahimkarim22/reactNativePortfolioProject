  "scene": {
    "id": "measure-for-measure-4-5",
    "act": 4,
    "scene": 5,
    "label": "Act 4, Scene 5",
    "title": "SCENE V. Fields without the town.",
    "location": "Fields without the town.",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "measure-for-measure-4-5-stage-001",
      "type": "stage",
      "text": "Enter Duke, in his own habit, and Friar Peter."
    },
    {
      "id": "measure-for-measure-4-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "These letters at fit time deliver me.",
          "plainText": "These letters at fit time deliver me",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The Provost knows our purpose and our plot.",
          "plainText": "The Provost knows our purpose and our plot",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "The matter being afoot, keep your instruction",
          "plainText": "The matter being afoot keep your instruction",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And hold you ever to our special drift,",
          "plainText": "And hold you ever to our special drift",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Though sometimes you do blench from this to that",
          "plainText": "Though sometimes you do blench from this to that",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "As cause doth minister. Go call at Flavius' house,",
          "plainText": "As cause doth minister Go call at Flavius' house",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "And tell him where I stay. Give the like notice",
          "plainText": "And tell him where I stay Give the like notice",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "To Valencius, Rowland, and to Crassus,",
          "plainText": "To Valencius Rowland and to Crassus",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "And bid them bring the trumpets to the gate.",
          "plainText": "And bid them bring the trumpets to the gate",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "But send me Flavius first.",
          "plainText": "But send me Flavius first",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "friar-peter",
        "name": "FRIAR PETER",
        "displayName": "Friar Peter"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "It shall be speeded well.",
          "plainText": "It shall be speeded well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-5-stage-002",
      "type": "stage",
      "text": "[Exit Friar Peter.]"
    },
    {
      "id": "measure-for-measure-4-5-stage-003",
      "type": "stage",
      "text": "Enter Varrius."
    },
    {
      "id": "measure-for-measure-4-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "I thank thee, Varrius, thou hast made good haste.",
          "plainText": "I thank thee Varrius thou hast made good haste",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Come, we will walk. There's other of our friends",
          "plainText": "Come we will walk There's other of our friends",
          "lineType": "verse"
        },
        {
          "id": "measure-for-measure-4-5-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Will greet us here anon. My gentle Varrius.",
          "plainText": "Will greet us here anon My gentle Varrius",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-5-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}