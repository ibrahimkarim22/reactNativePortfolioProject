    "scene": 6,
    "label": "Act 4, Scene 6",
    "title": "SCENE VI. Street near the city gate.",
    "location": "Street near the city gate.",
    "orderInPlay": 16
  },
  "content": [
    {
      "id": "measure-for-measure-4-6-stage-001",
      "type": "stage",
      "text": "Enter Isabella and Mariana."
    },
    {
      "id": "measure-for-measure-4-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "To speak so indirectly I am loath;",
          "plainText": "To speak so indirectly I am loath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "I would say the truth, but to accuse him so",
          "plainText": "I would say the truth but to accuse him so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "That is your part; yet I am advised to do it,",
          "plainText": "That is your part yet I am advised to do it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "He says, to veil full purpose.",
          "plainText": "He says to veil full purpose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "mariana",
        "name": "MARIANA",
        "displayName": "Mariana"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-6-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Be ruled by him.",
          "plainText": "Be ruled by him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-6-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Besides, he tells me that, if peradventure",
          "plainText": "Besides he tells me that if peradventure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "He speak against me on the adverse side,",
          "plainText": "He speak against me on the adverse side",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "I should not think it strange, for 'tis a physic",
          "plainText": "I should not think it strange for 'tis a physic",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "That's bitter to sweet end.",
          "plainText": "That's bitter to sweet end",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "mariana",
        "name": "MARIANA",
        "displayName": "Mariana"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-6-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "I would Friar Peter—",
          "plainText": "I would Friar Peter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-6-stage-002",
      "type": "stage",
      "text": "Enter Friar Peter."
    },
    {
      "id": "measure-for-measure-4-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "isabella",
        "name": "ISABELLA",
        "displayName": "Isabella"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-6-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "O, peace, the friar is come.",
          "plainText": "O peace the friar is come",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "friar-peter",
        "name": "FRIAR PETER",
        "displayName": "Friar Peter"
      },
      "lines": [
        {
          "id": "measure-for-measure-4-6-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Come, I have found you out a stand most fit,",
          "plainText": "Come I have found you out a stand most fit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Where you may have such vantage on the Duke",
          "plainText": "Where you may have such vantage on the Duke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "He shall not pass you. Twice have the trumpets sounded.",
          "plainText": "He shall not pass you Twice have the trumpets sounded",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "The generous and gravest citizens",
          "plainText": "The generous and gravest citizens",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "Have hent the gates, and very near upon",
          "plainText": "Have hent the gates and very near upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "measure-for-measure-4-6-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "The Duke is entering. Therefore hence, away.",
          "plainText": "The Duke is entering Therefore hence away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "measure-for-measure-4-6-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}