  "content": [
    {
      "id": "much-ado-about-nothing-3-2-stage-001",
      "type": "stage",
      "text": "Enter Don Pedro, Claudio, Benedick and Leonato."
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I do but stay till your marriage be consummate, and then go I toward Arragon.",
          "plainText": "I do but stay till your marriage be consummate and then go I toward Arragon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "I'll bring you thither, my lord, if you'll vouchsafe me.",
          "plainText": "I'll bring you thither my lord if you'll vouchsafe me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Nay, that would be as great a soil in the new gloss of your marriage, as to show a child his new coat and forbid him to wear it. I will only be bold with Benedick for his company; for, from the crown of his head to the sole of his foot, he is all mirth; he hath twice or thrice cut Cupid's bowstring, and the little hangman dare not shoot at him. He hath a heart as sound as a bell, and his tongue is the clapper; for what his heart thinks, his tongue speaks.",
          "plainText": "Nay that would be as great a soil in the new gloss of your marriage as to show a child his new coat and forbid him to wear it I will only be bold with Benedick for his company for from the crown of his head to the sole of his foot he is all mirth he hath twice or thrice cut Cupid's bowstring and the little hangman dare not shoot at him He hath a heart as sound as a bell and his tongue is the clapper for what his heart thinks his tongue speaks",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Gallants, I am not as I have been.",
          "plainText": "Gallants I am not as I have been",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "So say I: methinks you are sadder.",
          "plainText": "So say I methinks you are sadder",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "I hope he be in love.",
          "plainText": "I hope he be in love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Hang him, truant! there's no true drop of blood in him to be truly touched with love. If he be sad, he wants money.",
          "plainText": "Hang him truant there's no true drop of blood in him to be truly touched with love If he be sad he wants money",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I have the tooth-ache.",
          "plainText": "I have the toothache",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Draw it.",
          "plainText": "Draw it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Hang it.",
          "plainText": "Hang it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "You must hang it first, and draw it afterwards.",
          "plainText": "You must hang it first and draw it afterwards",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "What! sigh for the tooth-ache?",
          "plainText": "What sigh for the toothache",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Where is but a humour or a worm?",
          "plainText": "Where is but a humour or a worm",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Well, everyone can master a grief but he that has it.",
          "plainText": "Well everyone can master a grief but he that has it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Yet say I, he is in love.",
          "plainText": "Yet say I he is in love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "There is no appearance of fancy in him, unless it be a fancy that he hath to strange disguises; as to be a Dutchman today, a Frenchman tomorrow; or in the shape of two countries at once, as a German from the waist downward, all slops, and a Spaniard from the hip upward, no doublet. Unless he have a fancy to this foolery, as it appears he hath, he is no fool for fancy, as you would have it appear he is.",
          "plainText": "There is no appearance of fancy in him unless it be a fancy that he hath to strange disguises as to be a Dutchman today a Frenchman tomorrow or in the shape of two countries at once as a German from the waist downward all slops and a Spaniard from the hip upward no doublet Unless he have a fancy to this foolery as it appears he hath he is no fool for fancy as you would have it appear he is",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "If he be not in love with some woman, there is no believing old signs: a' brushes his hat a mornings; what should that bode?",
          "plainText": "If he be not in love with some woman there is no believing old signs a' brushes his hat a mornings what should that bode",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Hath any man seen him at the barber's?",
          "plainText": "Hath any man seen him at the barber's",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "No, but the barber's man hath been seen with him; and the old ornament of his cheek hath already stuffed tennis balls.",
          "plainText": "No but the barber's man hath been seen with him and the old ornament of his cheek hath already stuffed tennis balls",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Indeed he looks younger than he did, by the loss of a beard.",
          "plainText": "Indeed he looks younger than he did by the loss of a beard",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Nay, a' rubs himself with civet: can you smell him out by that?",
          "plainText": "Nay a' rubs himself with civet can you smell him out by that",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "That's as much as to say the sweet youth's in love.",
          "plainText": "That's as much as to say the sweet youth's in love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "The greatest note of it is his melancholy.",
          "plainText": "The greatest note of it is his melancholy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "And when was he wont to wash his face?",
          "plainText": "And when was he wont to wash his face",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Yea, or to paint himself? for the which, I hear what they say of him.",
          "plainText": "Yea or to paint himself for the which I hear what they say of him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Nay, but his jesting spirit; which is now crept into a lute-string, and now governed by stops.",
          "plainText": "Nay but his jesting spirit which is now crept into a lutestring and now governed by stops",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Indeed, that tells a heavy tale for him. Conclude, conclude he is in love.",
          "plainText": "Indeed that tells a heavy tale for him Conclude conclude he is in love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Nay, but I know who loves him.",
          "plainText": "Nay but I know who loves him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "That would I know too: I warrant, one that knows him not.",
          "plainText": "That would I know too I warrant one that knows him not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Yes, and his ill conditions; and in despite of all, dies for him.",
          "plainText": "Yes and his ill conditions and in despite of all dies for him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "She shall be buried with her face upwards.",
          "plainText": "She shall be buried with her face upwards",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Yet is this no charm for the tooth-ache. Old signior, walk aside with me: I have studied eight or nine wise words to speak to you, which these hobby-horses must not hear.",
          "plainText": "Yet is this no charm for the toothache Old signior walk aside with me I have studied eight or nine wise words to speak to you which these hobbyhorses must not hear",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-stage-002",
      "type": "stage",
      "text": "[Exeunt Benedick and Leonato.]"
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-033",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "For my life, to break with him about Beatrice.",
          "plainText": "For my life to break with him about Beatrice",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-034",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "'Tis even so. Hero and Margaret have by this played their parts with Beatrice, and then the two bears will not bite one another when they meet.",
          "plainText": "'Tis even so Hero and Margaret have by this played their parts with Beatrice and then the two bears will not bite one another when they meet",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-stage-003",
      "type": "stage",
      "text": "Enter Don John."
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-035",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "My lord and brother, God save you!",
          "plainText": "My lord and brother God save you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-036",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Good den, brother.",
          "plainText": "Good den brother",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-037",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "If your leisure served, I would speak with you.",
          "plainText": "If your leisure served I would speak with you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-038",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "In private?",
          "plainText": "In private",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-039",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "If it please you; yet Count Claudio may hear, for what I would speak of concerns him.",
          "plainText": "If it please you yet Count Claudio may hear for what I would speak of concerns him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-040",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "What's the matter?",
          "plainText": "What's the matter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-041",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "[To Claudio.] Means your lordship to be married tomorrow?",
          "plainText": "To Claudio Means your lordship to be married tomorrow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-042",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "You know he does.",
          "plainText": "You know he does",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-043",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "I know not that, when he knows what I know.",
          "plainText": "I know not that when he knows what I know",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-044",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "If there be any impediment, I pray you discover it.",
          "plainText": "If there be any impediment I pray you discover it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-045",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "You may think I love you not: let that appear hereafter, and aim better at me by that I now will manifest. For my brother, I think he holds you well, and in dearness of heart hath holp to effect your ensuing marriage; surely suit ill-spent and labour ill bestowed!",
          "plainText": "You may think I love you not let that appear hereafter and aim better at me by that I now will manifest For my brother I think he holds you well and in dearness of heart hath holp to effect your ensuing marriage surely suit illspent and labour ill bestowed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-046",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Why, what's the matter?",
          "plainText": "Why what's the matter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-047",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "I came hither to tell you; and circumstances shortened,—for she has been too long a talking of,—the lady is disloyal.",
          "plainText": "I came hither to tell you and circumstances shortenedfor she has been too long a talking ofthe lady is disloyal",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-048",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Who, Hero?",
          "plainText": "Who Hero",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-049",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Even she: Leonato's Hero, your Hero, every man's Hero.",
          "plainText": "Even she Leonato's Hero your Hero every man's Hero",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-050",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Disloyal?",
          "plainText": "Disloyal",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-051",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "The word's too good to paint out her wickedness; I could say, she were worse: think you of a worse title, and I will fit her to it. Wonder not till further warrant: go but with me tonight, you shall see her chamber window entered, even the night before her wedding-day: if you love her then, tomorrow wed her; but it would better fit your honour to change your mind.",
          "plainText": "The word's too good to paint out her wickedness I could say she were worse think you of a worse title and I will fit her to it Wonder not till further warrant go but with me tonight you shall see her chamber window entered even the night before her weddingday if you love her then tomorrow wed her but it would better fit your honour to change your mind",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-052",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "May this be so?",
          "plainText": "May this be so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-053",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "I will not think it.",
          "plainText": "I will not think it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-054",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "If you dare not trust that you see, confess not that you know. If you will follow me, I will show you enough; and when you have seen more and heard more, proceed accordingly.",
          "plainText": "If you dare not trust that you see confess not that you know If you will follow me I will show you enough and when you have seen more and heard more proceed accordingly",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-055",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "If I see anything tonight why I should not marry her tomorrow, in the congregation, where I should wed, there will I shame her.",
          "plainText": "If I see anything tonight why I should not marry her tomorrow in the congregation where I should wed there will I shame her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-056",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "And, as I wooed for thee to obtain her, I will join with thee to disgrace her.",
          "plainText": "And as I wooed for thee to obtain her I will join with thee to disgrace her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-057",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "I will disparage her no farther till you are my witnesses: bear it coldly but till midnight, and let the issue show itself.",
          "plainText": "I will disparage her no farther till you are my witnesses bear it coldly but till midnight and let the issue show itself",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-058",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "O day untowardly turned!",
          "plainText": "O day untowardly turned",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-059",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "O mischief strangely thwarting!",
          "plainText": "O mischief strangely thwarting",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-speech-060",
      "type": "speech",
      "speaker": {
        "id": "don-john",
        "name": "DON JOHN",
        "displayName": "Don John"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-3-2-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "O plague right well prevented! So will you say when you have seen the sequel.",
          "plainText": "O plague right well prevented So will you say when you have seen the sequel",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-3-2-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}