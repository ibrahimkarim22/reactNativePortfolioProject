    "title": "SCENE III. The Inside of a Church.",
    "location": "The Inside of a Church.",
    "orderInPlay": 16
  },
  "content": [
    {
      "id": "much-ado-about-nothing-5-3-stage-001",
      "type": "stage",
      "text": "Enter Don Pedro, Claudio and Attendants, with music and tapers."
    },
    {
      "id": "much-ado-about-nothing-5-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Is this the monument of Leonato?",
          "plainText": "Is this the monument of Leonato",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "a-lord",
        "name": "A LORD",
        "displayName": "A Lord"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "It is, my lord.",
          "plainText": "It is my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "[Reads from a scroll.]",
          "plainText": "Reads from a scroll",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-3-stage-002",
      "type": "stage",
      "text": "Epitaph."
    },
    {
      "id": "much-ado-about-nothing-5-3-stage-003",
      "type": "stage",
      "text": "Song."
    },
    {
      "id": "much-ado-about-nothing-5-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Now, unto thy bones good night!",
          "plainText": "Now unto thy bones good night",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-3-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Yearly will I do this rite.",
          "plainText": "Yearly will I do this rite",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Good morrow, masters: put your torches out.",
          "plainText": "Good morrow masters put your torches out",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-3-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "The wolves have prey'd; and look, the gentle day,",
          "plainText": "The wolves have prey'd and look the gentle day",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-3-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "Before the wheels of Phoebus, round about",
          "plainText": "Before the wheels of Phoebus round about",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-3-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Dapples the drowsy East with spots of grey.",
          "plainText": "Dapples the drowsy East with spots of grey",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-3-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "Thanks to you all, and leave us: fare you well.",
          "plainText": "Thanks to you all and leave us fare you well",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Good morrow, masters: each his several way.",
          "plainText": "Good morrow masters each his several way",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Come, let us hence, and put on other weeds;",
          "plainText": "Come let us hence and put on other weeds",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-3-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "And then to Leonato's we will go.",
          "plainText": "And then to Leonato's we will go",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "And Hymen now with luckier issue speed's,",
          "plainText": "And Hymen now with luckier issue speed's",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-3-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Than this for whom we rend'red up this woe!",
          "plainText": "Than this for whom we rend'red up this woe",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-3-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}