{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "much-ado-about-nothing",
    "title": "Much Ado About Nothing",
    "author": "William Shakespeare",
    "genre": "Comedy"
  },
  "source": {
    "name": "Project Gutenberg",
    "ebookNumber": 100,
    "rights": "Public domain in the USA",
    "sourceFile": "pg100-images.html"
  },
  "scene": {
    "id": "much-ado-about-nothing-5-4",
    "act": 5,
    "scene": 4,
    "label": "Act 5, Scene 4",
    "title": "SCENE IV. A Room in Leonato's House.",
    "location": "A Room in Leonato's House.",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "much-ado-about-nothing-5-4-stage-001",
      "type": "stage",
      "text": "Enter Leonato, Antonio, Benedick, Beatrice, Margaret, Ursula, Friar Francis and Hero."
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "friar",
        "name": "FRIAR",
        "displayName": "Friar"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Did I not tell you she was innocent?",
          "plainText": "Did I not tell you she was innocent",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "So are the Prince and Claudio, who accus'd her",
          "plainText": "So are the Prince and Claudio who accus'd her",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Upon the error that you heard debated:",
          "plainText": "Upon the error that you heard debated",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "But Margaret was in some fault for this,",
          "plainText": "But Margaret was in some fault for this",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "Although against her will, as it appears",
          "plainText": "Although against her will as it appears",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0006",
          "number": 6,
          "speechLineNumber": 5,
          "text": "In the true course of all the question.",
          "plainText": "In the true course of all the question",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Well, I am glad that all things sort so well.",
          "plainText": "Well I am glad that all things sort so well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "And so am I, being else by faith enforc'd",
          "plainText": "And so am I being else by faith enforc'd",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "To call young Claudio to a reckoning for it.",
          "plainText": "To call young Claudio to a reckoning for it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Well, daughter, and you gentlewomen all,",
          "plainText": "Well daughter and you gentlewomen all",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "Withdraw into a chamber by yourselves,",
          "plainText": "Withdraw into a chamber by yourselves",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "And when I send for you, come hither mask'd:",
          "plainText": "And when I send for you come hither mask'd",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0013",
          "number": 13,
          "speechLineNumber": 4,
          "text": "The Prince and Claudio promis'd by this hour",
          "plainText": "The Prince and Claudio promis'd by this hour",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0014",
          "number": 14,
          "speechLineNumber": 5,
          "text": "To visit me.",
          "plainText": "To visit me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-stage-002",
      "type": "stage",
      "text": "[Exeunt Ladies.]"
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Which I will do with confirm'd countenance.",
          "plainText": "Which I will do with confirm'd countenance",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Friar, I must entreat your pains, I think.",
          "plainText": "Friar I must entreat your pains I think",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "friar",
        "name": "FRIAR",
        "displayName": "Friar"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "To do what, signior?",
          "plainText": "To do what signior",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "To bind me, or undo me; one of them.",
          "plainText": "To bind me or undo me one of them",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Signior Leonato, truth it is, good signior,",
          "plainText": "Signior Leonato truth it is good signior",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "Your niece regards me with an eye of favour.",
          "plainText": "Your niece regards me with an eye of favour",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "That eye my daughter lent her. 'Tis most true.",
          "plainText": "That eye my daughter lent her 'Tis most true",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "And I do with an eye of love requite her.",
          "plainText": "And I do with an eye of love requite her",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "The sight whereof I think, you had from me,",
          "plainText": "The sight whereof I think you had from me",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "From Claudio, and the Prince. But what's your will?",
          "plainText": "From Claudio and the Prince But what's your will",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Your answer, sir, is enigmatical:",
          "plainText": "Your answer sir is enigmatical",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "But, for my will, my will is your good will",
          "plainText": "But for my will my will is your good will",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "May stand with ours, this day to be conjoin'd",
          "plainText": "May stand with ours this day to be conjoin'd",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "In the state of honourable marriage:",
          "plainText": "In the state of honourable marriage",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "In which, good friar, I shall desire your help.",
          "plainText": "In which good friar I shall desire your help",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "My heart is with your liking.",
          "plainText": "My heart is with your liking",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "friar",
        "name": "FRIAR",
        "displayName": "Friar"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "And my help. Here comes the Prince and Claudio.",
          "plainText": "And my help Here comes the Prince and Claudio",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-stage-003",
      "type": "stage",
      "text": "Enter Don Pedro and Claudio, with Attendants."
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Good morrow to this fair assembly.",
          "plainText": "Good morrow to this fair assembly",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Good morrow, Prince; good morrow, Claudio:",
          "plainText": "Good morrow Prince good morrow Claudio",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "We here attend you. Are you yet determin'd",
          "plainText": "We here attend you Are you yet determin'd",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Today to marry with my brother's daughter?",
          "plainText": "Today to marry with my brother's daughter",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "I'll hold my mind, were she an Ethiope.",
          "plainText": "I'll hold my mind were she an Ethiope",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Call her forth, brother: here's the friar ready.",
          "plainText": "Call her forth brother here's the friar ready",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-stage-004",
      "type": "stage",
      "text": "[Exit Antonio.]"
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Good morrow, Benedick. Why, what's the matter,",
          "plainText": "Good morrow Benedick Why what's the matter",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "That you have such a February face,",
          "plainText": "That you have such a February face",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "So full of frost, of storm and cloudiness?",
          "plainText": "So full of frost of storm and cloudiness",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "I think he thinks upon the savage bull.",
          "plainText": "I think he thinks upon the savage bull",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Tush! fear not, man, we'll tip thy horns with gold,",
          "plainText": "Tush fear not man we'll tip thy horns with gold",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "And all Europa shall rejoice at thee,",
          "plainText": "And all Europa shall rejoice at thee",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "As once Europa did at lusty Jove,",
          "plainText": "As once Europa did at lusty Jove",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "When he would play the noble beast in love.",
          "plainText": "When he would play the noble beast in love",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Bull Jove, sir, had an amiable low:",
          "plainText": "Bull Jove sir had an amiable low",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "And some such strange bull leap'd your father's cow,",
          "plainText": "And some such strange bull leap'd your father's cow",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "And got a calf in that same noble feat,",
          "plainText": "And got a calf in that same noble feat",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "Much like to you, for you have just his bleat.",
          "plainText": "Much like to you for you have just his bleat",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "For this I owe you: here comes other reckonings.",
          "plainText": "For this I owe you here comes other reckonings",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-stage-005",
      "type": "stage",
      "text": "Re-enter Antonio, with the ladies masked."
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "This same is she, and I do give you her.",
          "plainText": "This same is she and I do give you her",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-025",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Why then, she's mine. Sweet, let me see your face.",
          "plainText": "Why then she's mine Sweet let me see your face",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-026",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "No, that you shall not, till you take her hand",
          "plainText": "No that you shall not till you take her hand",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "Before this friar, and swear to marry her.",
          "plainText": "Before this friar and swear to marry her",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-027",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Give me your hand: before this holy friar,",
          "plainText": "Give me your hand before this holy friar",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "I am your husband, if you like of me.",
          "plainText": "I am your husband if you like of me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-028",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "And when I liv'd, I was your other wife:",
          "plainText": "And when I liv'd I was your other wife",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "[Unmasking.] And when you lov'd, you were my other husband.",
          "plainText": "Unmasking And when you lov'd you were my other husband",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-029",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Another Hero!",
          "plainText": "Another Hero",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-030",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Nothing certainer:",
          "plainText": "Nothing certainer",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "One Hero died defil'd, but I do live,",
          "plainText": "One Hero died defil'd but I do live",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0062",
          "number": 62,
          "speechLineNumber": 3,
          "text": "And surely as I live, I am a maid.",
          "plainText": "And surely as I live I am a maid",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-031",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "The former Hero! Hero that is dead!",
          "plainText": "The former Hero Hero that is dead",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-032",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "She died, my lord, but whiles her slander liv'd.",
          "plainText": "She died my lord but whiles her slander liv'd",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-033",
      "type": "speech",
      "speaker": {
        "id": "friar",
        "name": "FRIAR",
        "displayName": "Friar"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "All this amazement can I qualify:",
          "plainText": "All this amazement can I qualify",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "When after that the holy rites are ended,",
          "plainText": "When after that the holy rites are ended",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0067",
          "number": 67,
          "speechLineNumber": 3,
          "text": "I'll tell you largely of fair Hero's death:",
          "plainText": "I'll tell you largely of fair Hero's death",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0068",
          "number": 68,
          "speechLineNumber": 4,
          "text": "Meantime, let wonder seem familiar,",
          "plainText": "Meantime let wonder seem familiar",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0069",
          "number": 69,
          "speechLineNumber": 5,
          "text": "And to the chapel let us presently.",
          "plainText": "And to the chapel let us presently",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-034",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Soft and fair, friar. Which is Beatrice?",
          "plainText": "Soft and fair friar Which is Beatrice",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-035",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "[Unmasking.] I answer to that name. What is your will?",
          "plainText": "Unmasking I answer to that name What is your will",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-036",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Do not you love me?",
          "plainText": "Do not you love me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-037",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Why, no; no more than reason.",
          "plainText": "Why no no more than reason",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-038",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Why, then, your uncle and the Prince and Claudio",
          "plainText": "Why then your uncle and the Prince and Claudio",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "Have been deceived; for they swore you did.",
          "plainText": "Have been deceived for they swore you did",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-039",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Do not you love me?",
          "plainText": "Do not you love me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-040",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Troth, no; no more than reason.",
          "plainText": "Troth no no more than reason",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-041",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "Why, then my cousin, Margaret, and Ursula,",
          "plainText": "Why then my cousin Margaret and Ursula",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0079",
          "number": 79,
          "speechLineNumber": 2,
          "text": "Are much deceiv'd; for they did swear you did.",
          "plainText": "Are much deceiv'd for they did swear you did",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-042",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "They swore that you were almost sick for me.",
          "plainText": "They swore that you were almost sick for me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-043",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "They swore that you were well-nigh dead for me.",
          "plainText": "They swore that you were wellnigh dead for me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-044",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "'Tis no such matter. Then you do not love me?",
          "plainText": "'Tis no such matter Then you do not love me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-045",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "No, truly, but in friendly recompense.",
          "plainText": "No truly but in friendly recompense",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-046",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "Come, cousin, I am sure you love the gentleman.",
          "plainText": "Come cousin I am sure you love the gentleman",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-047",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0085",
          "number": 85,
          "speechLineNumber": 1,
          "text": "And I'll be sworn upon 't that he loves her;",
          "plainText": "And I'll be sworn upon 't that he loves her",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0086",
          "number": 86,
          "speechLineNumber": 2,
          "text": "For here's a paper written in his hand,",
          "plainText": "For here's a paper written in his hand",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0087",
          "number": 87,
          "speechLineNumber": 3,
          "text": "A halting sonnet of his own pure brain,",
          "plainText": "A halting sonnet of his own pure brain",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0088",
          "number": 88,
          "speechLineNumber": 4,
          "text": "Fashion'd to Beatrice.",
          "plainText": "Fashion'd to Beatrice",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-048",
      "type": "speech",
      "speaker": {
        "id": "hero",
        "name": "HERO",
        "displayName": "Hero"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "And here's another,",
          "plainText": "And here's another",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0090",
          "number": 90,
          "speechLineNumber": 2,
          "text": "Writ in my cousin's hand, stolen from her pocket,",
          "plainText": "Writ in my cousin's hand stolen from her pocket",
          "lineType": "verse"
        },
        {
          "id": "much-ado-about-nothing-5-4-line-0091",
          "number": 91,
          "speechLineNumber": 3,
          "text": "Containing her affection unto Benedick.",
          "plainText": "Containing her affection unto Benedick",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-049",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "A miracle! here's our own hands against our hearts. Come, I will have thee; but, by this light, I take thee for pity.",
          "plainText": "A miracle here's our own hands against our hearts Come I will have thee but by this light I take thee for pity",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-050",
      "type": "speech",
      "speaker": {
        "id": "beatrice",
        "name": "BEATRICE",
        "displayName": "Beatrice"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "I would not deny you; but, by this good day, I yield upon great persuasion, and partly to save your life, for I was told you were in a consumption.",
          "plainText": "I would not deny you but by this good day I yield upon great persuasion and partly to save your life for I was told you were in a consumption",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-051",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0094",
          "number": 94,
          "speechLineNumber": 1,
          "text": "Peace! I will stop your mouth. [Kisses her.]",
          "plainText": "Peace I will stop your mouth Kisses her",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-052",
      "type": "speech",
      "speaker": {
        "id": "don-pedro",
        "name": "DON PEDRO",
        "displayName": "Don Pedro"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0095",
          "number": 95,
          "speechLineNumber": 1,
          "text": "How dost thou, Benedick, the married man?",
          "plainText": "How dost thou Benedick the married man",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-053",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0096",
          "number": 96,
          "speechLineNumber": 1,
          "text": "I'll tell thee what, Prince; a college of witcrackers cannot flout me out of my humour. Dost thou think I care for a satire or an epigram? No; if man will be beaten with brains, a' shall wear nothing handsome about him. In brief, since I do purpose to marry, I will think nothing to any purpose that the world can say against it; and therefore never flout at me for what I have said against it, for man is a giddy thing, and this is my conclusion. For thy part, Claudio, I did think to have beaten thee; but, in that thou art like to be my kinsman, live unbruised, and love my cousin.",
          "plainText": "I'll tell thee what Prince a college of witcrackers cannot flout me out of my humour Dost thou think I care for a satire or an epigram No if man will be beaten with brains a' shall wear nothing handsome about him In brief since I do purpose to marry I will think nothing to any purpose that the world can say against it and therefore never flout at me for what I have said against it for man is a giddy thing and this is my conclusion For thy part Claudio I did think to have beaten thee but in that thou art like to be my kinsman live unbruised and love my cousin",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-054",
      "type": "speech",
      "speaker": {
        "id": "claudio",
        "name": "CLAUDIO",
        "displayName": "Claudio"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0097",
          "number": 97,
          "speechLineNumber": 1,
          "text": "I had well hoped thou wouldst have denied Beatrice, that I might have cudgelled thee out of thy single life, to make thee a double-dealer; which, out of question, thou wilt be, if my cousin do not look exceeding narrowly to thee.",
          "plainText": "I had well hoped thou wouldst have denied Beatrice that I might have cudgelled thee out of thy single life to make thee a doubledealer which out of question thou wilt be if my cousin do not look exceeding narrowly to thee",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-055",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0098",
          "number": 98,
          "speechLineNumber": 1,
          "text": "Come, come, we are friends. Let's have a dance ere we are married, that we may lighten our own hearts and our wives' heels.",
          "plainText": "Come come we are friends Let's have a dance ere we are married that we may lighten our own hearts and our wives' heels",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-056",
      "type": "speech",
      "speaker": {
        "id": "leonato",
        "name": "LEONATO",
        "displayName": "Leonato"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0099",
          "number": 99,
          "speechLineNumber": 1,
          "text": "We'll have dancing afterward.",
          "plainText": "We'll have dancing afterward",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-057",
      "type": "speech",
      "speaker": {
        "id": "benedick",
        "name": "BENEDICK",
        "displayName": "Benedick"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0100",
          "number": 100,
          "speechLineNumber": 1,
          "text": "First, of my word; therefore play, music! Prince, thou art sad; get thee a wife, get thee a wife: there is no staff more reverent than one tipped with horn.",
          "plainText": "First of my word therefore play music Prince thou art sad get thee a wife get thee a wife there is no staff more reverent than one tipped with horn",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "much-ado-about-nothing-5-4-stage-006",
      "type": "stage",
      "text": "Enter Messenger."
    },
    {
      "id": "much-ado-about-nothing-5-4-speech-058",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "much-ado-about-nothing-5-4-line-0101",
          "number": 101,
          "speechLineNumber": 1,
          "text": "My lord, your brother John is ta'en in flight,",
