  "scene": {
    "id": "othello-the-moor-of-venice-1-2",
    "act": 1,
    "scene": 2,
    "label": "Act 1, Scene 2",
    "title": "SCENE II. Venice. Another street.",
    "location": "Venice. Another street.",
    "orderInPlay": 2
  },
  "content": [
    {
      "id": "othello-the-moor-of-venice-1-2-stage-001",
      "type": "stage",
      "text": "Enter Othello, Iago and Attendants with torches."
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Though in the trade of war I have slain men,",
          "plainText": "Though in the trade of war I have slain men",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Yet do I hold it very stuff o' the conscience",
          "plainText": "Yet do I hold it very stuff o' the conscience",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "To do no contriv'd murder; I lack iniquity",
          "plainText": "To do no contriv'd murder I lack iniquity",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Sometimes to do me service: nine or ten times",
          "plainText": "Sometimes to do me service nine or ten times",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "I had thought to have yerk'd him here under the ribs.",
          "plainText": "I had thought to have yerk'd him here under the ribs",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "'Tis better as it is.",
          "plainText": "'Tis better as it is",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Nay, but he prated,",
          "plainText": "Nay but he prated",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "And spoke such scurvy and provoking terms",
          "plainText": "And spoke such scurvy and provoking terms",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Against your honour,",
          "plainText": "Against your honour",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "That with the little godliness I have,",
          "plainText": "That with the little godliness I have",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "I did full hard forbear him. But I pray you, sir,",
          "plainText": "I did full hard forbear him But I pray you sir",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "Are you fast married? Be assur'd of this,",
          "plainText": "Are you fast married Be assur'd of this",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0013",
          "number": 13,
          "speechLineNumber": 7,
          "text": "That the magnifico is much belov'd",
          "plainText": "That the magnifico is much belov'd",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0014",
          "number": 14,
          "speechLineNumber": 8,
          "text": "And hath in his effect a voice potential",
          "plainText": "And hath in his effect a voice potential",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0015",
          "number": 15,
          "speechLineNumber": 9,
          "text": "As double as the duke's; he will divorce you,",
          "plainText": "As double as the duke's he will divorce you",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0016",
          "number": 16,
          "speechLineNumber": 10,
          "text": "Or put upon you what restraint and grievance",
          "plainText": "Or put upon you what restraint and grievance",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0017",
          "number": 17,
          "speechLineNumber": 11,
          "text": "The law (with all his might to enforce it on)",
          "plainText": "The law with all his might to enforce it on",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0018",
          "number": 18,
          "speechLineNumber": 12,
          "text": "Will give him cable.",
          "plainText": "Will give him cable",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Let him do his spite;",
          "plainText": "Let him do his spite",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "My services, which I have done the signiory,",
          "plainText": "My services which I have done the signiory",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Shall out-tongue his complaints. 'Tis yet to know,—",
          "plainText": "Shall outtongue his complaints 'Tis yet to know",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "Which, when I know that boasting is an honour,",
          "plainText": "Which when I know that boasting is an honour",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "I shall promulgate,—I fetch my life and being",
          "plainText": "I shall promulgateI fetch my life and being",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "From men of royal siege. And my demerits",
          "plainText": "From men of royal siege And my demerits",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0025",
          "number": 25,
          "speechLineNumber": 7,
          "text": "May speak unbonneted to as proud a fortune",
          "plainText": "May speak unbonneted to as proud a fortune",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0026",
          "number": 26,
          "speechLineNumber": 8,
          "text": "As this that I have reach'd. For know, Iago,",
          "plainText": "As this that I have reach'd For know Iago",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0027",
          "number": 27,
          "speechLineNumber": 9,
          "text": "But that I love the gentle Desdemona,",
          "plainText": "But that I love the gentle Desdemona",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0028",
          "number": 28,
          "speechLineNumber": 10,
          "text": "I would not my unhoused free condition",
          "plainText": "I would not my unhoused free condition",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0029",
          "number": 29,
          "speechLineNumber": 11,
          "text": "Put into circumscription and confine",
          "plainText": "Put into circumscription and confine",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0030",
          "number": 30,
          "speechLineNumber": 12,
          "text": "For the sea's worth. But look, what lights come yond?",
          "plainText": "For the sea's worth But look what lights come yond",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Those are the raised father and his friends:",
          "plainText": "Those are the raised father and his friends",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "You were best go in.",
          "plainText": "You were best go in",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Not I; I must be found.",
          "plainText": "Not I I must be found",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "My parts, my title, and my perfect soul",
          "plainText": "My parts my title and my perfect soul",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Shall manifest me rightly. Is it they?",
          "plainText": "Shall manifest me rightly Is it they",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "By Janus, I think no.",
          "plainText": "By Janus I think no",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-stage-002",
      "type": "stage",
      "text": "Enter Cassio and Officers with torches."
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "The servants of the duke and my lieutenant.",
          "plainText": "The servants of the duke and my lieutenant",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "The goodness of the night upon you, friends!",
          "plainText": "The goodness of the night upon you friends",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "What is the news?",
          "plainText": "What is the news",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "The duke does greet you, general,",
          "plainText": "The duke does greet you general",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "And he requires your haste-post-haste appearance",
          "plainText": "And he requires your hasteposthaste appearance",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Even on the instant.",
          "plainText": "Even on the instant",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "What is the matter, think you?",
          "plainText": "What is the matter think you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Something from Cyprus, as I may divine.",
          "plainText": "Something from Cyprus as I may divine",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "It is a business of some heat. The galleys",
          "plainText": "It is a business of some heat The galleys",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "Have sent a dozen sequent messengers",
          "plainText": "Have sent a dozen sequent messengers",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "This very night at one another's heels;",
          "plainText": "This very night at one another's heels",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0048",
          "number": 48,
          "speechLineNumber": 5,
          "text": "And many of the consuls, rais'd and met,",
          "plainText": "And many of the consuls rais'd and met",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0049",
          "number": 49,
          "speechLineNumber": 6,
          "text": "Are at the duke's already. You have been hotly call'd for,",
          "plainText": "Are at the duke's already You have been hotly call'd for",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0050",
          "number": 50,
          "speechLineNumber": 7,
          "text": "When, being not at your lodging to be found,",
          "plainText": "When being not at your lodging to be found",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0051",
          "number": 51,
          "speechLineNumber": 8,
          "text": "The senate hath sent about three several quests",
          "plainText": "The senate hath sent about three several quests",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0052",
          "number": 52,
          "speechLineNumber": 9,
          "text": "To search you out.",
          "plainText": "To search you out",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "'Tis well I am found by you.",
          "plainText": "'Tis well I am found by you",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "I will but spend a word here in the house,",
          "plainText": "I will but spend a word here in the house",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0055",
          "number": 55,
          "speechLineNumber": 3,
          "text": "And go with you.",
          "plainText": "And go with you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Ancient, what makes he here?",
          "plainText": "Ancient what makes he here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Faith, he tonight hath boarded a land carrack:",
          "plainText": "Faith he tonight hath boarded a land carrack",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "If it prove lawful prize, he's made forever.",
          "plainText": "If it prove lawful prize he's made forever",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "I do not understand.",
          "plainText": "I do not understand",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "He's married.",
          "plainText": "He's married",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "To who?",
          "plainText": "To who",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-stage-004",
      "type": "stage",
      "text": "Enter Othello."
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Marry to—Come, captain, will you go?",
          "plainText": "Marry toCome captain will you go",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Have with you.",
          "plainText": "Have with you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Here comes another troop to seek for you.",
          "plainText": "Here comes another troop to seek for you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-stage-005",
      "type": "stage",
      "text": "Enter Brabantio, Roderigo and Officers with torches and weapons."
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "It is Brabantio. General, be advis'd,",
          "plainText": "It is Brabantio General be advis'd",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "He comes to bad intent.",
          "plainText": "He comes to bad intent",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Holla, stand there!",
          "plainText": "Holla stand there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "roderigo",
        "name": "RODERIGO",
        "displayName": "Roderigo"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Signior, it is the Moor.",
          "plainText": "Signior it is the Moor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "brabantio",
        "name": "BRABANTIO",
        "displayName": "Brabantio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Down with him, thief!",
          "plainText": "Down with him thief",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-stage-006",
      "type": "stage",
      "text": "[They draw on both sides.]"
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "You, Roderigo! Come, sir, I am for you.",
          "plainText": "You Roderigo Come sir I am for you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Keep up your bright swords, for the dew will rust them.",
          "plainText": "Keep up your bright swords for the dew will rust them",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "Good signior, you shall more command with years",
          "plainText": "Good signior you shall more command with years",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "Than with your weapons.",
          "plainText": "Than with your weapons",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "brabantio",
        "name": "BRABANTIO",
        "displayName": "Brabantio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "O thou foul thief, where hast thou stow'd my daughter?",
          "plainText": "O thou foul thief where hast thou stow'd my daughter",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "Damn'd as thou art, thou hast enchanted her,",
          "plainText": "Damn'd as thou art thou hast enchanted her",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "For I'll refer me to all things of sense,",
          "plainText": "For I'll refer me to all things of sense",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0077",
          "number": 77,
          "speechLineNumber": 4,
          "text": "(If she in chains of magic were not bound)",
          "plainText": "If she in chains of magic were not bound",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0078",
          "number": 78,
          "speechLineNumber": 5,
          "text": "Whether a maid so tender, fair, and happy,",
          "plainText": "Whether a maid so tender fair and happy",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0079",
          "number": 79,
          "speechLineNumber": 6,
          "text": "So opposite to marriage, that she shunn'd",
          "plainText": "So opposite to marriage that she shunn'd",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0080",
          "number": 80,
          "speechLineNumber": 7,
          "text": "The wealthy curled darlings of our nation,",
          "plainText": "The wealthy curled darlings of our nation",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0081",
          "number": 81,
          "speechLineNumber": 8,
          "text": "Would ever have, to incur a general mock,",
          "plainText": "Would ever have to incur a general mock",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0082",
          "number": 82,
          "speechLineNumber": 9,
          "text": "Run from her guardage to the sooty bosom",
          "plainText": "Run from her guardage to the sooty bosom",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0083",
          "number": 83,
          "speechLineNumber": 10,
          "text": "Of such a thing as thou—to fear, not to delight.",
          "plainText": "Of such a thing as thouto fear not to delight",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0084",
          "number": 84,
          "speechLineNumber": 11,
          "text": "Judge me the world, if 'tis not gross in sense,",
          "plainText": "Judge me the world if 'tis not gross in sense",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0085",
          "number": 85,
          "speechLineNumber": 12,
          "text": "That thou hast practis'd on her with foul charms,",
          "plainText": "That thou hast practis'd on her with foul charms",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0086",
          "number": 86,
          "speechLineNumber": 13,
          "text": "Abus'd her delicate youth with drugs or minerals",
          "plainText": "Abus'd her delicate youth with drugs or minerals",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0087",
          "number": 87,
          "speechLineNumber": 14,
          "text": "That weakens motion. I'll have't disputed on;",
          "plainText": "That weakens motion I'll have't disputed on",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0088",
          "number": 88,
          "speechLineNumber": 15,
          "text": "'Tis probable, and palpable to thinking.",
          "plainText": "'Tis probable and palpable to thinking",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0089",
          "number": 89,
          "speechLineNumber": 16,
          "text": "I therefore apprehend and do attach thee",
          "plainText": "I therefore apprehend and do attach thee",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0090",
          "number": 90,
          "speechLineNumber": 17,
          "text": "For an abuser of the world, a practiser",
          "plainText": "For an abuser of the world a practiser",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0091",
          "number": 91,
          "speechLineNumber": 18,
          "text": "Of arts inhibited and out of warrant.—",
          "plainText": "Of arts inhibited and out of warrant",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0092",
          "number": 92,
          "speechLineNumber": 19,
          "text": "Lay hold upon him, if he do resist,",
          "plainText": "Lay hold upon him if he do resist",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0093",
          "number": 93,
          "speechLineNumber": 20,
          "text": "Subdue him at his peril.",
          "plainText": "Subdue him at his peril",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0094",
          "number": 94,
          "speechLineNumber": 1,
          "text": "Hold your hands,",
          "plainText": "Hold your hands",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0095",
          "number": 95,
          "speechLineNumber": 2,
          "text": "Both you of my inclining and the rest:",
          "plainText": "Both you of my inclining and the rest",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0096",
          "number": 96,
          "speechLineNumber": 3,
          "text": "Were it my cue to fight, I should have known it",
          "plainText": "Were it my cue to fight I should have known it",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0097",
          "number": 97,
          "speechLineNumber": 4,
          "text": "Without a prompter. Where will you that I go",
          "plainText": "Without a prompter Where will you that I go",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0098",
          "number": 98,
          "speechLineNumber": 5,
          "text": "To answer this your charge?",
          "plainText": "To answer this your charge",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "brabantio",
        "name": "BRABANTIO",
        "displayName": "Brabantio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0099",
          "number": 99,
          "speechLineNumber": 1,
          "text": "To prison, till fit time",
          "plainText": "To prison till fit time",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0100",
          "number": 100,
          "speechLineNumber": 2,
          "text": "Of law and course of direct session",
          "plainText": "Of law and course of direct session",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0101",
          "number": 101,
          "speechLineNumber": 3,
          "text": "Call thee to answer.",
          "plainText": "Call thee to answer",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0102",
          "number": 102,
          "speechLineNumber": 1,
          "text": "What if I do obey?",
          "plainText": "What if I do obey",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0103",
          "number": 103,
          "speechLineNumber": 2,
          "text": "How may the duke be therewith satisfied,",
          "plainText": "How may the duke be therewith satisfied",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0104",
          "number": 104,
          "speechLineNumber": 3,
          "text": "Whose messengers are here about my side,",
          "plainText": "Whose messengers are here about my side",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0105",
          "number": 105,
          "speechLineNumber": 4,
          "text": "Upon some present business of the state,",
          "plainText": "Upon some present business of the state",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0106",
          "number": 106,
          "speechLineNumber": 5,
          "text": "To bring me to him?",
          "plainText": "To bring me to him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "officer",
        "name": "OFFICER",
        "displayName": "Officer"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0107",
          "number": 107,
          "speechLineNumber": 1,
          "text": "'Tis true, most worthy signior,",
          "plainText": "'Tis true most worthy signior",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0108",
          "number": 108,
          "speechLineNumber": 2,
          "text": "The duke's in council, and your noble self,",
          "plainText": "The duke's in council and your noble self",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0109",
          "number": 109,
          "speechLineNumber": 3,
          "text": "I am sure is sent for.",
          "plainText": "I am sure is sent for",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "brabantio",
        "name": "BRABANTIO",
        "displayName": "Brabantio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-1-2-line-0110",
          "number": 110,
          "speechLineNumber": 1,
          "text": "How? The duke in council?",
          "plainText": "How The duke in council",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0111",
          "number": 111,
          "speechLineNumber": 2,
          "text": "In this time of the night? Bring him away;",
          "plainText": "In this time of the night Bring him away",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0112",
          "number": 112,
          "speechLineNumber": 3,
          "text": "Mine's not an idle cause. The duke himself,",
          "plainText": "Mine's not an idle cause The duke himself",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0113",
          "number": 113,
          "speechLineNumber": 4,
          "text": "Or any of my brothers of the state,",
          "plainText": "Or any of my brothers of the state",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0114",
          "number": 114,
          "speechLineNumber": 5,
          "text": "Cannot but feel this wrong as 'twere their own.",
          "plainText": "Cannot but feel this wrong as 'twere their own",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0115",
          "number": 115,
          "speechLineNumber": 6,
          "text": "For if such actions may have passage free,",
          "plainText": "For if such actions may have passage free",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-1-2-line-0116",
          "number": 116,
          "speechLineNumber": 7,
          "text": "Bond-slaves and pagans shall our statesmen be.",
          "plainText": "Bondslaves and pagans shall our statesmen be",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-1-2-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}