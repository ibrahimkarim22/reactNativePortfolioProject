  "content": [
    {
      "id": "othello-the-moor-of-venice-3-1-stage-001",
      "type": "stage",
      "text": "Enter Cassio and some Musicians."
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Masters, play here, I will content your pains,",
          "plainText": "Masters play here I will content your pains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Something that's brief; and bid \"Good morrow, general.\"",
          "plainText": "Something that's brief and bid Good morrow general",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-stage-002",
      "type": "stage",
      "text": "[Music.]"
    },
    {
      "id": "othello-the-moor-of-venice-3-1-stage-003",
      "type": "stage",
      "text": "Enter Clown."
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Why, masters, have your instruments been in Naples, that they speak i' the nose thus?",
          "plainText": "Why masters have your instruments been in Naples that they speak i' the nose thus",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-musician",
        "name": "FIRST MUSICIAN",
        "displayName": "First Musician"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "How, sir, how?",
          "plainText": "How sir how",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Are these, I pray you, wind instruments?",
          "plainText": "Are these I pray you wind instruments",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "first-musician",
        "name": "FIRST MUSICIAN",
        "displayName": "First Musician"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Ay, marry, are they, sir.",
          "plainText": "Ay marry are they sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "O, thereby hangs a tail.",
          "plainText": "O thereby hangs a tail",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "first-musician",
        "name": "FIRST MUSICIAN",
        "displayName": "First Musician"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Whereby hangs a tale, sir?",
          "plainText": "Whereby hangs a tale sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Marry, sir, by many a wind instrument that I know. But, masters, here's money for you: and the general so likes your music, that he desires you, for love's sake, to make no more noise with it.",
          "plainText": "Marry sir by many a wind instrument that I know But masters here's money for you and the general so likes your music that he desires you for love's sake to make no more noise with it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "first-musician",
        "name": "FIRST MUSICIAN",
        "displayName": "First Musician"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Well, sir, we will not.",
          "plainText": "Well sir we will not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "If you have any music that may not be heard, to't again. But, as they say, to hear music the general does not greatly care.",
          "plainText": "If you have any music that may not be heard to't again But as they say to hear music the general does not greatly care",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "first-musician",
        "name": "FIRST MUSICIAN",
        "displayName": "First Musician"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "We have none such, sir.",
          "plainText": "We have none such sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Then put up your pipes in your bag, for I'll away. Go, vanish into air, away!",
          "plainText": "Then put up your pipes in your bag for I'll away Go vanish into air away",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-stage-004",
      "type": "stage",
      "text": "[Exeunt Musicians.]"
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Dost thou hear, mine honest friend?",
          "plainText": "Dost thou hear mine honest friend",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "No, I hear not your honest friend. I hear you.",
          "plainText": "No I hear not your honest friend I hear you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Prithee, keep up thy quillets. There's a poor piece of gold for thee: if the gentlewoman that attends the general's wife be stirring, tell her there's one Cassio entreats her a little favour of speech. Wilt thou do this?",
          "plainText": "Prithee keep up thy quillets There's a poor piece of gold for thee if the gentlewoman that attends the general's wife be stirring tell her there's one Cassio entreats her a little favour of speech Wilt thou do this",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "She is stirring, sir; if she will stir hither, I shall seem to notify unto her.",
          "plainText": "She is stirring sir if she will stir hither I shall seem to notify unto her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Do, good my friend.",
          "plainText": "Do good my friend",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-stage-005",
      "type": "stage",
      "text": "[Exit Clown.]"
    },
    {
      "id": "othello-the-moor-of-venice-3-1-stage-006",
      "type": "stage",
      "text": "Enter Iago."
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "You have not been a-bed, then?",
          "plainText": "You have not been abed then",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Why, no. The day had broke",
          "plainText": "Why no The day had broke",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Before we parted. I have made bold, Iago,",
          "plainText": "Before we parted I have made bold Iago",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "To send in to your wife. My suit to her",
          "plainText": "To send in to your wife My suit to her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Is, that she will to virtuous Desdemona",
          "plainText": "Is that she will to virtuous Desdemona",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "Procure me some access.",
          "plainText": "Procure me some access",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "I'll send her to you presently,",
          "plainText": "I'll send her to you presently",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "And I'll devise a mean to draw the Moor",
          "plainText": "And I'll devise a mean to draw the Moor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "Out of the way, that your converse and business",
          "plainText": "Out of the way that your converse and business",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "May be more free.",
          "plainText": "May be more free",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cassio",
        "name": "CASSIO",
        "displayName": "Cassio"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I humbly thank you for't.",
          "plainText": "I humbly thank you for't",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-1-stage-007",
      "type": "stage",
      "text": "[Exit Iago.]"
    },
    {
      "id": "othello-the-moor-of-venice-3-1-stage-008",
      "type": "stage",
      "text": "Enter Emilia."
    },
    {
      "id": "othello-the-moor-of-venice-3-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Good morrow, good lieutenant; I am sorry",
          "plainText": "Good morrow good lieutenant I am sorry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "For your displeasure, but all will sure be well.",
          "plainText": "For your displeasure but all will sure be well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "The general and his wife are talking of it,",
          "plainText": "The general and his wife are talking of it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0033",
          "number": 33,
          "speechLineNumber": 4,
          "text": "And she speaks for you stoutly: the Moor replies",
          "plainText": "And she speaks for you stoutly the Moor replies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0034",
          "number": 34,
          "speechLineNumber": 5,
          "text": "That he you hurt is of great fame in Cyprus",
          "plainText": "That he you hurt is of great fame in Cyprus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0035",
          "number": 35,
          "speechLineNumber": 6,
          "text": "And great affinity, and that in wholesome wisdom",
          "plainText": "And great affinity and that in wholesome wisdom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0036",
          "number": 36,
          "speechLineNumber": 7,
          "text": "He might not but refuse you; but he protests he loves you",
          "plainText": "He might not but refuse you but he protests he loves you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "othello-the-moor-of-venice-3-1-line-0037",
          "number": 37,
          "speechLineNumber": 8,
          "text": "And needs no other suitor but his likings",
