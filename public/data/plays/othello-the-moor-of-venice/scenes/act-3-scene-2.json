  "content": [
    {
      "id": "othello-the-moor-of-venice-3-2-stage-001",
      "type": "stage",
      "text": "Enter Othello, Iago and Gentlemen."
    },
    {
      "id": "othello-the-moor-of-venice-3-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "These letters give, Iago, to the pilot,",
          "plainText": "These letters give Iago to the pilot",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-3-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And by him do my duties to the senate.",
          "plainText": "And by him do my duties to the senate",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-3-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "That done, I will be walking on the works,",
          "plainText": "That done I will be walking on the works",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-3-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Repair there to me.",
          "plainText": "Repair there to me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "iago",
        "name": "IAGO",
        "displayName": "Iago"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Well, my good lord, I'll do't.",
          "plainText": "Well my good lord I'll do't",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "This fortification, gentlemen, shall we see't?",
          "plainText": "This fortification gentlemen shall we see't",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "gentlemen",
        "name": "GENTLEMEN",
        "displayName": "Gentlemen"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-3-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "We'll wait upon your lordship.",
          "plainText": "We'll wait upon your lordship",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-3-2-stage-002",
