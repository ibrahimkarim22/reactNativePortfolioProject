    "scene": 3,
    "label": "Act 4, Scene 3",
    "title": "SCENE III. Cyprus. Another Room in the Castle.",
    "location": "Cyprus. Another Room in the Castle.",
    "orderInPlay": 13
  },
  "content": [
    {
      "id": "othello-the-moor-of-venice-4-3-stage-001",
      "type": "stage",
      "text": "Enter Othello, Lodovico, Desdemona, Emilia and Attendants."
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lodovico",
        "name": "LODOVICO",
        "displayName": "Lodovico"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I do beseech you, sir, trouble yourself no further.",
          "plainText": "I do beseech you sir trouble yourself no further",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "O, pardon me; 'twill do me good to walk.",
          "plainText": "O pardon me 'twill do me good to walk",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lodovico",
        "name": "LODOVICO",
        "displayName": "Lodovico"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Madam, good night. I humbly thank your ladyship.",
          "plainText": "Madam good night I humbly thank your ladyship",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Your honour is most welcome.",
          "plainText": "Your honour is most welcome",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Will you walk, sir?—",
          "plainText": "Will you walk sir",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "O, Desdemona,—",
          "plainText": "O Desdemona",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "My lord?",
          "plainText": "My lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "othello",
        "name": "OTHELLO",
        "displayName": "Othello"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Get you to bed on th' instant, I will be return'd forthwith. Dismiss your attendant there. Look 't be done.",
          "plainText": "Get you to bed on th' instant I will be return'd forthwith Dismiss your attendant there Look 't be done",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "I will, my lord.",
          "plainText": "I will my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-stage-002",
      "type": "stage",
      "text": "[Exeunt Othello, Lodovico and Attendants.]"
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "How goes it now? He looks gentler than he did.",
          "plainText": "How goes it now He looks gentler than he did",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "He says he will return incontinent,",
          "plainText": "He says he will return incontinent",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "He hath commanded me to go to bed,",
          "plainText": "He hath commanded me to go to bed",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "And bade me to dismiss you.",
          "plainText": "And bade me to dismiss you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Dismiss me?",
          "plainText": "Dismiss me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "It was his bidding. Therefore, good Emilia,",
          "plainText": "It was his bidding Therefore good Emilia",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Give me my nightly wearing, and adieu.",
          "plainText": "Give me my nightly wearing and adieu",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "We must not now displease him.",
          "plainText": "We must not now displease him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "I would you had never seen him!",
          "plainText": "I would you had never seen him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "So would not I. My love doth so approve him,",
          "plainText": "So would not I My love doth so approve him",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "That even his stubbornness, his checks, his frowns,—",
          "plainText": "That even his stubbornness his checks his frowns",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Prithee, unpin me,—have grace and favour in them.",
          "plainText": "Prithee unpin mehave grace and favour in them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I have laid those sheets you bade me on the bed.",
          "plainText": "I have laid those sheets you bade me on the bed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "All's one. Good faith, how foolish are our minds!",
          "plainText": "All's one Good faith how foolish are our minds",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "If I do die before thee, prithee, shroud me",
          "plainText": "If I do die before thee prithee shroud me",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "In one of those same sheets.",
          "plainText": "In one of those same sheets",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Come, come, you talk.",
          "plainText": "Come come you talk",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "My mother had a maid call'd Barbary,",
          "plainText": "My mother had a maid call'd Barbary",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "She was in love, and he she lov'd prov'd mad",
          "plainText": "She was in love and he she lov'd prov'd mad",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "And did forsake her. She had a song of \"willow\",",
          "plainText": "And did forsake her She had a song of willow",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "An old thing 'twas, but it express'd her fortune,",
          "plainText": "An old thing 'twas but it express'd her fortune",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "And she died singing it. That song tonight",
          "plainText": "And she died singing it That song tonight",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0032",
          "number": 32,
          "speechLineNumber": 6,
          "text": "Will not go from my mind. I have much to do",
          "plainText": "Will not go from my mind I have much to do",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0033",
          "number": 33,
          "speechLineNumber": 7,
          "text": "But to go hang my head all at one side",
          "plainText": "But to go hang my head all at one side",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0034",
          "number": 34,
          "speechLineNumber": 8,
          "text": "And sing it like poor Barbary. Prithee dispatch.",
          "plainText": "And sing it like poor Barbary Prithee dispatch",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Shall I go fetch your night-gown?",
          "plainText": "Shall I go fetch your nightgown",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "No, unpin me here.",
          "plainText": "No unpin me here",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "This Lodovico is a proper man.",
          "plainText": "This Lodovico is a proper man",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "A very handsome man.",
          "plainText": "A very handsome man",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "He speaks well.",
          "plainText": "He speaks well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "I know a lady in Venice would have walked barefoot to Palestine for a touch of his nether lip.",
          "plainText": "I know a lady in Venice would have walked barefoot to Palestine for a touch of his nether lip",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "[Singing.]",
          "plainText": "Singing",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "The poor soul sat sighing by a sycamore tree,",
          "plainText": "The poor soul sat sighing by a sycamore tree",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "Sing all a green willow.",
          "plainText": "Sing all a green willow",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "Her hand on her bosom, her head on her knee,",
          "plainText": "Her hand on her bosom her head on her knee",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "Sing willow, willow, willow.",
          "plainText": "Sing willow willow willow",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "The fresh streams ran by her, and murmur'd her moans,",
          "plainText": "The fresh streams ran by her and murmur'd her moans",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0047",
          "number": 47,
          "speechLineNumber": 7,
          "text": "Sing willow, willow, willow;",
          "plainText": "Sing willow willow willow",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0048",
          "number": 48,
          "speechLineNumber": 8,
          "text": "Her salt tears fell from her, and soften'd the stones;—",
          "plainText": "Her salt tears fell from her and soften'd the stones",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "It's the wind.",
          "plainText": "It's the wind",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "[Sings.]",
          "plainText": "Sings",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "I call'd my love false love; but what said he then?",
          "plainText": "I call'd my love false love but what said he then",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0052",
          "number": 52,
          "speechLineNumber": 3,
          "text": "Sing willow, willow, willow:",
          "plainText": "Sing willow willow willow",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0053",
          "number": 53,
          "speechLineNumber": 4,
          "text": "If I court mo women, you'll couch with mo men.",
          "plainText": "If I court mo women you'll couch with mo men",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "'Tis neither here nor there.",
          "plainText": "'Tis neither here nor there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "I have heard it said so. O, these men, these men!",
          "plainText": "I have heard it said so O these men these men",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "Dost thou in conscience think,—tell me, Emilia,—",
          "plainText": "Dost thou in conscience thinktell me Emilia",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "That there be women do abuse their husbands",
          "plainText": "That there be women do abuse their husbands",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0058",
          "number": 58,
          "speechLineNumber": 4,
          "text": "In such gross kind?",
          "plainText": "In such gross kind",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "There be some such, no question.",
          "plainText": "There be some such no question",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Wouldst thou do such a deed for all the world?",
          "plainText": "Wouldst thou do such a deed for all the world",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-031",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Why, would not you?",
          "plainText": "Why would not you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-032",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "No, by this heavenly light!",
          "plainText": "No by this heavenly light",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-033",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Nor I neither by this heavenly light,",
          "plainText": "Nor I neither by this heavenly light",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "I might do't as well i' the dark.",
          "plainText": "I might do't as well i' the dark",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-034",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Wouldst thou do such a deed for all the world?",
          "plainText": "Wouldst thou do such a deed for all the world",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-035",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "The world's a huge thing. It is a great price",
          "plainText": "The world's a huge thing It is a great price",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "For a small vice.",
          "plainText": "For a small vice",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-036",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "In troth, I think thou wouldst not.",
          "plainText": "In troth I think thou wouldst not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-037",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "In troth, I think I should, and undo't when I had done. Marry, I would not do such a thing for a joint-ring, nor for measures of lawn, nor for gowns, petticoats, nor caps, nor any petty exhibition; but, for the whole world—why, who would not make her husband a cuckold to make him a monarch? I should venture purgatory for 't.",
          "plainText": "In troth I think I should and undo't when I had done Marry I would not do such a thing for a jointring nor for measures of lawn nor for gowns petticoats nor caps nor any petty exhibition but for the whole worldwhy who would not make her husband a cuckold to make him a monarch I should venture purgatory for 't",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-038",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Beshrew me, if I would do such a wrong for the whole world.",
          "plainText": "Beshrew me if I would do such a wrong for the whole world",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-039",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Why, the wrong is but a wrong i' the world; and having the world for your labour, 'tis a wrong in your own world, and you might quickly make it right.",
          "plainText": "Why the wrong is but a wrong i' the world and having the world for your labour 'tis a wrong in your own world and you might quickly make it right",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-040",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "I do not think there is any such woman.",
          "plainText": "I do not think there is any such woman",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-041",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Yes, a dozen; and as many to the vantage as would store the world they played for.",
          "plainText": "Yes a dozen and as many to the vantage as would store the world they played for",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0074",
          "number": 74,
          "speechLineNumber": 2,
          "text": "But I do think it is their husbands' faults",
          "plainText": "But I do think it is their husbands' faults",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0075",
          "number": 75,
          "speechLineNumber": 3,
          "text": "If wives do fall: say that they slack their duties,",
          "plainText": "If wives do fall say that they slack their duties",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0076",
          "number": 76,
          "speechLineNumber": 4,
          "text": "And pour our treasures into foreign laps;",
          "plainText": "And pour our treasures into foreign laps",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0077",
          "number": 77,
          "speechLineNumber": 5,
          "text": "Or else break out in peevish jealousies,",
          "plainText": "Or else break out in peevish jealousies",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0078",
          "number": 78,
          "speechLineNumber": 6,
          "text": "Throwing restraint upon us. Or say they strike us,",
          "plainText": "Throwing restraint upon us Or say they strike us",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0079",
          "number": 79,
          "speechLineNumber": 7,
          "text": "Or scant our former having in despite.",
          "plainText": "Or scant our former having in despite",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0080",
          "number": 80,
          "speechLineNumber": 8,
          "text": "Why, we have galls; and though we have some grace,",
          "plainText": "Why we have galls and though we have some grace",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0081",
          "number": 81,
          "speechLineNumber": 9,
          "text": "Yet have we some revenge. Let husbands know",
          "plainText": "Yet have we some revenge Let husbands know",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0082",
          "number": 82,
          "speechLineNumber": 10,
          "text": "Their wives have sense like them: they see, and smell",
          "plainText": "Their wives have sense like them they see and smell",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0083",
          "number": 83,
          "speechLineNumber": 11,
          "text": "And have their palates both for sweet and sour,",
          "plainText": "And have their palates both for sweet and sour",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0084",
          "number": 84,
          "speechLineNumber": 12,
          "text": "As husbands have. What is it that they do",
          "plainText": "As husbands have What is it that they do",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0085",
          "number": 85,
          "speechLineNumber": 13,
          "text": "When they change us for others? Is it sport?",
          "plainText": "When they change us for others Is it sport",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0086",
          "number": 86,
          "speechLineNumber": 14,
          "text": "I think it is. And doth affection breed it?",
          "plainText": "I think it is And doth affection breed it",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0087",
          "number": 87,
          "speechLineNumber": 15,
          "text": "I think it doth. Is't frailty that thus errs?",
          "plainText": "I think it doth Is't frailty that thus errs",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0088",
          "number": 88,
          "speechLineNumber": 16,
          "text": "It is so too. And have not we affections,",
          "plainText": "It is so too And have not we affections",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0089",
          "number": 89,
          "speechLineNumber": 17,
          "text": "Desires for sport, and frailty, as men have?",
          "plainText": "Desires for sport and frailty as men have",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0090",
          "number": 90,
          "speechLineNumber": 18,
          "text": "Then let them use us well: else let them know,",
          "plainText": "Then let them use us well else let them know",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0091",
          "number": 91,
          "speechLineNumber": 19,
          "text": "The ills we do, their ills instruct us so.",
          "plainText": "The ills we do their ills instruct us so",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-speech-042",
      "type": "speech",
      "speaker": {
        "id": "desdemona",
        "name": "DESDEMONA",
        "displayName": "Desdemona"
      },
      "lines": [
        {
          "id": "othello-the-moor-of-venice-4-3-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "Good night, good night. Heaven me such usage send,",
          "plainText": "Good night good night Heaven me such usage send",
          "lineType": "verse"
        },
        {
          "id": "othello-the-moor-of-venice-4-3-line-0093",
          "number": 93,
          "speechLineNumber": 2,
          "text": "Not to pick bad from bad, but by bad mend!",
          "plainText": "Not to pick bad from bad but by bad mend",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "othello-the-moor-of-venice-4-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}