  "scene": {
    "id": "pericles-prince-of-tyre-2-5",
    "act": 2,
    "scene": 5,
    "label": "Act 2, Scene 5",
    "title": "SCENE V. Pentapolis. A room in the palace.",
    "location": "Pentapolis. A room in the palace.",
    "orderInPlay": 9
  },
  "content": [
    {
      "id": "pericles-prince-of-tyre-2-5-stage-001",
      "type": "stage",
      "text": "Enter Simonides reading a letter at one door; the Knights meet him."
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-knight",
        "name": "FIRST KNIGHT",
        "displayName": "First Knight"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Good morrow to the good Simonides.",
          "plainText": "Good morrow to the good Simonides",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Knights, from my daughter this I let you know,",
          "plainText": "Knights from my daughter this I let you know",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "That for this twelvemonth she'll not undertake",
          "plainText": "That for this twelvemonth she'll not undertake",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "A married life.",
          "plainText": "A married life",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "Her reason to herself is only known,",
          "plainText": "Her reason to herself is only known",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0006",
          "number": 6,
          "speechLineNumber": 5,
          "text": "Which yet from her by no means can I get.",
          "plainText": "Which yet from her by no means can I get",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "second-knight",
        "name": "SECOND KNIGHT",
        "displayName": "Second Knight"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "May we not get access to her, my lord?",
          "plainText": "May we not get access to her my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Faith, by no means; she hath so strictly tied",
          "plainText": "Faith by no means she hath so strictly tied",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Her to her chamber, that 'tis impossible.",
          "plainText": "Her to her chamber that 'tis impossible",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "One twelve moons more she'll wear Diana's livery;",
          "plainText": "One twelve moons more she'll wear Diana's livery",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "This by the eye of Cynthia hath she vow'd,",
          "plainText": "This by the eye of Cynthia hath she vow'd",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "And on her virgin honour will not break it.",
          "plainText": "And on her virgin honour will not break it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "third-knight",
        "name": "THIRD KNIGHT",
        "displayName": "Third Knight"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Loath to bid farewell, we take our leaves.",
          "plainText": "Loath to bid farewell we take our leaves",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-stage-002",
      "type": "stage",
      "text": "[Exeunt Knights.]"
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "So, they are well dispatch'd; now to my daughter's letter:",
          "plainText": "So they are well dispatch'd now to my daughter's letter",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "She tells me here, she'll wed the stranger knight,",
          "plainText": "She tells me here she'll wed the stranger knight",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "Or never more to view nor day nor light.",
          "plainText": "Or never more to view nor day nor light",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "'Tis well, mistress; your choice agrees with mine;",
          "plainText": "'Tis well mistress your choice agrees with mine",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "I like that well: nay, how absolute she's in't,",
          "plainText": "I like that well nay how absolute she's in't",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0019",
          "number": 19,
          "speechLineNumber": 6,
          "text": "Not minding whether I dislike or no!",
          "plainText": "Not minding whether I dislike or no",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0020",
          "number": 20,
          "speechLineNumber": 7,
          "text": "Well, I do commend her choice;",
          "plainText": "Well I do commend her choice",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0021",
          "number": 21,
          "speechLineNumber": 8,
          "text": "And will no longer have it be delay'd.",
          "plainText": "And will no longer have it be delay'd",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0022",
          "number": 22,
          "speechLineNumber": 9,
          "text": "Soft! here he comes: I must dissemble it.",
          "plainText": "Soft here he comes I must dissemble it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-stage-003",
      "type": "stage",
      "text": "Enter Pericles."
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "All fortune to the good Simonides!",
          "plainText": "All fortune to the good Simonides",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "To you as much. Sir, I am beholding to you",
          "plainText": "To you as much Sir I am beholding to you",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "For your sweet music this last night: I do",
          "plainText": "For your sweet music this last night I do",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "Protest my ears were never better fed",
          "plainText": "Protest my ears were never better fed",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "With such delightful pleasing harmony.",
          "plainText": "With such delightful pleasing harmony",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "It is your grace's pleasure to commend;",
          "plainText": "It is your grace's pleasure to commend",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "Not my desert.",
          "plainText": "Not my desert",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Sir, you are music's master.",
          "plainText": "Sir you are music's master",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "The worst of all her scholars, my good lord.",
          "plainText": "The worst of all her scholars my good lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Let me ask you one thing:",
          "plainText": "Let me ask you one thing",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "What do you think of my daughter, sir?",
          "plainText": "What do you think of my daughter sir",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "A most virtuous princess.",
          "plainText": "A most virtuous princess",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "And she is fair too, is she not?",
          "plainText": "And she is fair too is she not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "As a fair day in summer, wondrous fair.",
          "plainText": "As a fair day in summer wondrous fair",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Sir, my daughter thinks very well of you;",
          "plainText": "Sir my daughter thinks very well of you",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Ay, so well, that you must be her master,",
          "plainText": "Ay so well that you must be her master",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "And she will be your scholar: therefore look to it.",
          "plainText": "And she will be your scholar therefore look to it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "I am unworthy for her schoolmaster.",
          "plainText": "I am unworthy for her schoolmaster",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "She thinks not so; peruse this writing else.",
          "plainText": "She thinks not so peruse this writing else",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "[Aside.] What's here? A letter, that she loves the knight of Tyre!",
          "plainText": "Aside What's here A letter that she loves the knight of Tyre",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "'Tis the king's subtlety to have my life.",
          "plainText": "'Tis the king's subtlety to have my life",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "O, seek not to entrap me, gracious lord,",
          "plainText": "O seek not to entrap me gracious lord",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0045",
          "number": 45,
          "speechLineNumber": 4,
          "text": "A stranger and distressed gentleman,",
          "plainText": "A stranger and distressed gentleman",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0046",
          "number": 46,
          "speechLineNumber": 5,
          "text": "That never aim'd so high to love your daughter,",
          "plainText": "That never aim'd so high to love your daughter",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0047",
          "number": 47,
          "speechLineNumber": 6,
          "text": "But bent all offices to honour her.",
          "plainText": "But bent all offices to honour her",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Thou hast bewitch'd my daughter,",
          "plainText": "Thou hast bewitch'd my daughter",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "And thou art a villain.",
          "plainText": "And thou art a villain",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "By the gods, I have not:",
          "plainText": "By the gods I have not",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "Never did thought of mine levy offence;",
          "plainText": "Never did thought of mine levy offence",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0052",
          "number": 52,
          "speechLineNumber": 3,
          "text": "Nor never did my actions yet commence",
          "plainText": "Nor never did my actions yet commence",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0053",
          "number": 53,
          "speechLineNumber": 4,
          "text": "A deed might gain her love or your displeasure.",
          "plainText": "A deed might gain her love or your displeasure",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Traitor, thou liest.",
          "plainText": "Traitor thou liest",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Traitor?",
          "plainText": "Traitor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Ay, traitor.",
          "plainText": "Ay traitor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Even in his throat—unless it be the king—",
          "plainText": "Even in his throatunless it be the king",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "That calls me traitor, I return the lie.",
          "plainText": "That calls me traitor I return the lie",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "[Aside.] Now, by the gods, I do applaud his courage.",
          "plainText": "Aside Now by the gods I do applaud his courage",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-027",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "My actions are as noble as my thoughts,",
          "plainText": "My actions are as noble as my thoughts",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "That never relish'd of a base descent.",
          "plainText": "That never relish'd of a base descent",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0062",
          "number": 62,
          "speechLineNumber": 3,
          "text": "I came unto your court for honour's cause,",
          "plainText": "I came unto your court for honour's cause",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0063",
          "number": 63,
          "speechLineNumber": 4,
          "text": "And not to be a rebel to her state;",
          "plainText": "And not to be a rebel to her state",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0064",
          "number": 64,
          "speechLineNumber": 5,
          "text": "And he that otherwise accounts of me,",
          "plainText": "And he that otherwise accounts of me",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0065",
          "number": 65,
          "speechLineNumber": 6,
          "text": "This sword shall prove he's honour's enemy.",
          "plainText": "This sword shall prove he's honour's enemy",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-028",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "No?",
          "plainText": "No",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "Here comes my daughter, she can witness it.",
          "plainText": "Here comes my daughter she can witness it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-stage-004",
      "type": "stage",
      "text": "Enter Thaisa."
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-029",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Then, as you are as virtuous as fair,",
          "plainText": "Then as you are as virtuous as fair",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "Resolve your angry father, if my tongue",
          "plainText": "Resolve your angry father if my tongue",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0070",
          "number": 70,
          "speechLineNumber": 3,
          "text": "Did e'er solicit, or my hand subscribe",
          "plainText": "Did e'er solicit or my hand subscribe",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0071",
          "number": 71,
          "speechLineNumber": 4,
          "text": "To any syllable that made love to you.",
          "plainText": "To any syllable that made love to you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-030",
      "type": "speech",
      "speaker": {
        "id": "thaisa",
        "name": "THAISA",
        "displayName": "Thaisa"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Why, sir, say if you had,",
          "plainText": "Why sir say if you had",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "Who takes offence at that would make me glad?",
          "plainText": "Who takes offence at that would make me glad",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-031",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Yea, mistress, are you so peremptory?",
          "plainText": "Yea mistress are you so peremptory",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "[Aside.] I am glad on't with all my heart.—",
          "plainText": "Aside I am glad on't with all my heart",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "I'll tame you; I'll bring you in subjection.",
          "plainText": "I'll tame you I'll bring you in subjection",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0077",
          "number": 77,
          "speechLineNumber": 4,
          "text": "Will you, not having my consent,",
          "plainText": "Will you not having my consent",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0078",
          "number": 78,
          "speechLineNumber": 5,
          "text": "Bestow your love and your affections",
          "plainText": "Bestow your love and your affections",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0079",
          "number": 79,
          "speechLineNumber": 6,
          "text": "Upon a stranger? [Aside.] Who, for aught I know",
          "plainText": "Upon a stranger Aside Who for aught I know",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0080",
          "number": 80,
          "speechLineNumber": 7,
          "text": "May be, nor can I think the contrary,",
          "plainText": "May be nor can I think the contrary",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0081",
          "number": 81,
          "speechLineNumber": 8,
          "text": "As great in blood as I myself.—",
          "plainText": "As great in blood as I myself",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0082",
          "number": 82,
          "speechLineNumber": 9,
          "text": "Therefore hear you, mistress; either frame",
          "plainText": "Therefore hear you mistress either frame",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0083",
          "number": 83,
          "speechLineNumber": 10,
          "text": "Your will to mine, and you, sir, hear you,",
          "plainText": "Your will to mine and you sir hear you",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0084",
          "number": 84,
          "speechLineNumber": 11,
          "text": "Either be ruled by me, or I will make you—",
          "plainText": "Either be ruled by me or I will make you",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0085",
          "number": 85,
          "speechLineNumber": 12,
          "text": "Man and wife. Nay, come, your hands,",
          "plainText": "Man and wife Nay come your hands",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0086",
          "number": 86,
          "speechLineNumber": 13,
          "text": "And lips must seal it too: and being join'd,",
          "plainText": "And lips must seal it too and being join'd",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0087",
          "number": 87,
          "speechLineNumber": 14,
          "text": "I'll thus your hopes destroy; and for further grief,",
          "plainText": "I'll thus your hopes destroy and for further grief",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0088",
          "number": 88,
          "speechLineNumber": 15,
          "text": "God give you joy! What, are you both pleased?",
          "plainText": "God give you joy What are you both pleased",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-032",
      "type": "speech",
      "speaker": {
        "id": "thaisa",
        "name": "THAISA",
        "displayName": "Thaisa"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "Yes, if you love me, sir.",
          "plainText": "Yes if you love me sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-033",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0090",
          "number": 90,
          "speechLineNumber": 1,
          "text": "Even as my life my blood that fosters it.",
          "plainText": "Even as my life my blood that fosters it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-034",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0091",
          "number": 91,
          "speechLineNumber": 1,
          "text": "What, are you both agreed?",
          "plainText": "What are you both agreed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-035",
      "type": "speech",
      "speaker": {
        "id": "both",
        "name": "BOTH",
        "displayName": "Both"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "Yes, if't please your majesty.",
          "plainText": "Yes if't please your majesty",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-speech-036",
      "type": "speech",
      "speaker": {
        "id": "simonides",
        "name": "SIMONIDES",
        "displayName": "Simonides"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-2-5-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "It pleaseth me so well, that I will see you wed;",
          "plainText": "It pleaseth me so well that I will see you wed",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-2-5-line-0094",
          "number": 94,
          "speechLineNumber": 2,
          "text": "And then with what haste you can, get you to bed.",
          "plainText": "And then with what haste you can get you to bed",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-2-5-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}