  "scene": {
    "id": "pericles-prince-of-tyre-3-1",
    "act": 3,
    "scene": 1,
    "label": "Act 3, Scene 1",
    "title": "SCENE I.",
    "location": "",
    "orderInPlay": 10
  },
  "content": [
    {
      "id": "pericles-prince-of-tyre-3-1-stage-001",
      "type": "stage",
      "text": "Enter Pericles, on shipboard."
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Thou god of this great vast, rebuke these surges,",
          "plainText": "Thou god of this great vast rebuke these surges",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Which wash both heaven and hell; and thou that hast",
          "plainText": "Which wash both heaven and hell and thou that hast",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Upon the winds command, bind them in brass,",
          "plainText": "Upon the winds command bind them in brass",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Having call'd them from the deep! O, still",
          "plainText": "Having call'd them from the deep O still",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Thy deafening, dreadful thunders; gently quench",
          "plainText": "Thy deafening dreadful thunders gently quench",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Thy nimble, sulphurous flashes! O, how, Lychorida,",
          "plainText": "Thy nimble sulphurous flashes O how Lychorida",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "How does my queen? Thou stormest venomously;",
          "plainText": "How does my queen Thou stormest venomously",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Wilt thou spit all thyself? The seaman's whistle",
          "plainText": "Wilt thou spit all thyself The seaman's whistle",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Is as a whisper in the ears of death,",
          "plainText": "Is as a whisper in the ears of death",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Unheard. Lychorida! - Lucina, O!",
          "plainText": "Unheard Lychorida Lucina O",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Divinest patroness, and midwife gentle",
          "plainText": "Divinest patroness and midwife gentle",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "To those that cry by night, convey thy deity",
          "plainText": "To those that cry by night convey thy deity",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "Aboard our dancing boat; make swift the pangs",
          "plainText": "Aboard our dancing boat make swift the pangs",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Of my queen's travails! Now, Lychorida!",
          "plainText": "Of my queen's travails Now Lychorida",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-stage-002",
      "type": "stage",
      "text": "Enter Lychorida with an infant."
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lychorida",
        "name": "LYCHORIDA",
        "displayName": "Lychorida"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Here is a thing too young for such a place,",
          "plainText": "Here is a thing too young for such a place",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Who, if it had conceit, would die, as I",
          "plainText": "Who if it had conceit would die as I",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "Am like to do: take in your arms this piece",
          "plainText": "Am like to do take in your arms this piece",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "Of your dead queen.",
          "plainText": "Of your dead queen",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "How? how, Lychorida?",
          "plainText": "How how Lychorida",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lychorida",
        "name": "LYCHORIDA",
        "displayName": "Lychorida"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Patience, good sir; do not assist the storm.",
          "plainText": "Patience good sir do not assist the storm",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Here's all that is left living of your queen,",
          "plainText": "Here's all that is left living of your queen",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "A little daughter: for the sake of it,",
          "plainText": "A little daughter for the sake of it",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Be manly, and take comfort.",
          "plainText": "Be manly and take comfort",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "O you gods!",
          "plainText": "O you gods",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "Why do you make us love your goodly gifts,",
          "plainText": "Why do you make us love your goodly gifts",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "And snatch them straight away? We here below",
          "plainText": "And snatch them straight away We here below",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "Recall not what we give, and therein may",
          "plainText": "Recall not what we give and therein may",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0028",
          "number": 28,
          "speechLineNumber": 5,
          "text": "Vie honour with you.",
          "plainText": "Vie honour with you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "lychorida",
        "name": "LYCHORIDA",
        "displayName": "Lychorida"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Patience, good sir.",
          "plainText": "Patience good sir",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "Even for this charge.",
          "plainText": "Even for this charge",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Now, mild may be thy life!",
          "plainText": "Now mild may be thy life",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "For a more blustrous birth had never babe:",
          "plainText": "For a more blustrous birth had never babe",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "Quiet and gentle thy conditions! for",
          "plainText": "Quiet and gentle thy conditions for",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "Thou art the rudeliest welcome to this world",
          "plainText": "Thou art the rudeliest welcome to this world",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0035",
          "number": 35,
          "speechLineNumber": 5,
          "text": "That ever was prince's child. Happy what follows!",
          "plainText": "That ever was prince's child Happy what follows",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0036",
          "number": 36,
          "speechLineNumber": 6,
          "text": "Thou hast as chiding a nativity",
          "plainText": "Thou hast as chiding a nativity",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0037",
          "number": 37,
          "speechLineNumber": 7,
          "text": "As fire, air, water, earth, and heaven can make,",
          "plainText": "As fire air water earth and heaven can make",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0038",
          "number": 38,
          "speechLineNumber": 8,
          "text": "To herald thee from the womb.",
          "plainText": "To herald thee from the womb",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0039",
          "number": 39,
          "speechLineNumber": 9,
          "text": "Even at the first thy loss is more than can",
          "plainText": "Even at the first thy loss is more than can",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0040",
          "number": 40,
          "speechLineNumber": 10,
          "text": "Thy portage quit, with all thou canst find here,",
          "plainText": "Thy portage quit with all thou canst find here",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0041",
          "number": 41,
          "speechLineNumber": 11,
          "text": "Now, the good gods throw their best eyes upon't!",
          "plainText": "Now the good gods throw their best eyes upon't",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-stage-003",
      "type": "stage",
      "text": "Enter two Sailors"
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "first-sailor",
        "name": "FIRST SAILOR",
        "displayName": "First Sailor"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "What courage, sir? God save you!",
          "plainText": "What courage sir God save you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Courage enough: I do not fear the flaw;",
          "plainText": "Courage enough I do not fear the flaw",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "It hath done to me the worst. Yet, for the love",
          "plainText": "It hath done to me the worst Yet for the love",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Of this poor infant, this fresh new sea-farer,",
          "plainText": "Of this poor infant this fresh new seafarer",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "I would it would be quiet.",
          "plainText": "I would it would be quiet",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "first-sailor",
        "name": "FIRST SAILOR",
        "displayName": "First Sailor"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Slack the bolins there! Thou wilt not, wilt thou? Blow, and split thyself.",
          "plainText": "Slack the bolins there Thou wilt not wilt thou Blow and split thyself",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "second-sailor",
        "name": "SECOND SAILOR",
        "displayName": "Second Sailor"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "But sea-room, and the brine and cloudy billow kiss the moon, I care not.",
          "plainText": "But searoom and the brine and cloudy billow kiss the moon I care not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "first-sailor",
        "name": "FIRST SAILOR",
        "displayName": "First Sailor"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Sir, your queen must overboard: the sea works high, the wind is loud and will not lie till the ship be cleared of the dead.",
          "plainText": "Sir your queen must overboard the sea works high the wind is loud and will not lie till the ship be cleared of the dead",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "That's your superstition.",
          "plainText": "That's your superstition",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "first-sailor",
        "name": "FIRST SAILOR",
        "displayName": "First Sailor"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Pardon us, sir; with us at sea it has been still observed; and we are strong in custom. Therefore briefly yield her; for she must overboard straight.",
          "plainText": "Pardon us sir with us at sea it has been still observed and we are strong in custom Therefore briefly yield her for she must overboard straight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "As you think meet. Most wretched queen!",
          "plainText": "As you think meet Most wretched queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "lychorida",
        "name": "LYCHORIDA",
        "displayName": "Lychorida"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Here she lies, sir.",
          "plainText": "Here she lies sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "A terrible childbed hast thou had, my dear;",
          "plainText": "A terrible childbed hast thou had my dear",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "No light, no fire: th'unfriendly elements",
          "plainText": "No light no fire th'unfriendly elements",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0056",
          "number": 56,
          "speechLineNumber": 3,
          "text": "Forgot thee utterly; nor have I time",
          "plainText": "Forgot thee utterly nor have I time",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0057",
          "number": 57,
          "speechLineNumber": 4,
          "text": "To give thee hallow'd to thy grave, but straight",
          "plainText": "To give thee hallow'd to thy grave but straight",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0058",
          "number": 58,
          "speechLineNumber": 5,
          "text": "Must cast thee, scarcely coffin'd, in the ooze;",
          "plainText": "Must cast thee scarcely coffin'd in the ooze",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0059",
          "number": 59,
          "speechLineNumber": 6,
          "text": "Where, for a monument upon thy bones,",
          "plainText": "Where for a monument upon thy bones",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0060",
          "number": 60,
          "speechLineNumber": 7,
          "text": "And e'er-remaining lamps, the belching whale",
          "plainText": "And e'erremaining lamps the belching whale",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0061",
          "number": 61,
          "speechLineNumber": 8,
          "text": "And humming water must o'erwhelm thy corpse,",
          "plainText": "And humming water must o'erwhelm thy corpse",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0062",
          "number": 62,
          "speechLineNumber": 9,
          "text": "Lying with simple shells. O Lychorida.",
          "plainText": "Lying with simple shells O Lychorida",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0063",
          "number": 63,
          "speechLineNumber": 10,
          "text": "Bid Nestor bring me spices, ink and paper,",
          "plainText": "Bid Nestor bring me spices ink and paper",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0064",
          "number": 64,
          "speechLineNumber": 11,
          "text": "My casket and my jewels; and bid Nicander",
          "plainText": "My casket and my jewels and bid Nicander",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0065",
          "number": 65,
          "speechLineNumber": 12,
          "text": "Bring me the satin coffer: lay the babe",
          "plainText": "Bring me the satin coffer lay the babe",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0066",
          "number": 66,
          "speechLineNumber": 13,
          "text": "Upon the pillow: hie thee, whiles I say",
          "plainText": "Upon the pillow hie thee whiles I say",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0067",
          "number": 67,
          "speechLineNumber": 14,
          "text": "A priestly farewell to her: suddenly, woman.",
          "plainText": "A priestly farewell to her suddenly woman",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-stage-004",
      "type": "stage",
      "text": "[Exit Lychorida.]"
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "second-sailor",
        "name": "SECOND SAILOR",
        "displayName": "Second Sailor"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Sir, we have a chest beneath the hatches, caulked and bitumed ready.",
          "plainText": "Sir we have a chest beneath the hatches caulked and bitumed ready",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "I thank thee. Mariner, say what coast is this?",
          "plainText": "I thank thee Mariner say what coast is this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "second-sailor",
        "name": "SECOND SAILOR",
        "displayName": "Second Sailor"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "We are near Tarsus.",
          "plainText": "We are near Tarsus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Thither, gentle mariner,",
          "plainText": "Thither gentle mariner",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "Alter thy course for Tyre. When canst thou reach it?",
          "plainText": "Alter thy course for Tyre When canst thou reach it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "second-sailor",
        "name": "SECOND SAILOR",
        "displayName": "Second Sailor"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "By break of day, if the wind cease.",
          "plainText": "By break of day if the wind cease",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-1-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "O, make for Tarsus!",
          "plainText": "O make for Tarsus",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "There will I visit Cleon, for the babe",
          "plainText": "There will I visit Cleon for the babe",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "Cannot hold out to Tyrus. There I'll leave it",
          "plainText": "Cannot hold out to Tyrus There I'll leave it",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0077",
          "number": 77,
          "speechLineNumber": 4,
          "text": "At careful nursing. Go thy ways, good mariner:",
          "plainText": "At careful nursing Go thy ways good mariner",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-1-line-0078",
          "number": 78,
          "speechLineNumber": 5,
          "text": "I'll bring the body presently.",
          "plainText": "I'll bring the body presently",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-1-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}