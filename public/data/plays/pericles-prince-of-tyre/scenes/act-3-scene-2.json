  "scene": {
    "id": "pericles-prince-of-tyre-3-2",
    "act": 3,
    "scene": 2,
    "label": "Act 3, Scene 2",
    "title": "SCENE II. Ephesus. A room in Cerimon's house.",
    "location": "Ephesus. A room in Cerimon's house.",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "pericles-prince-of-tyre-3-2-stage-001",
      "type": "stage",
      "text": "Enter Cerimon, with a Servant, and some Persons who have been shipwrecked."
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Philemon, ho!",
          "plainText": "Philemon ho",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-stage-002",
      "type": "stage",
      "text": "Enter Philemon."
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "philemon",
        "name": "PHILEMON",
        "displayName": "Philemon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Doth my lord call?",
          "plainText": "Doth my lord call",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Get fire and meat for these poor men:",
          "plainText": "Get fire and meat for these poor men",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "'T has been a turbulent and stormy night.",
          "plainText": "'T has been a turbulent and stormy night",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "I have been in many; but such a night as this,",
          "plainText": "I have been in many but such a night as this",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Till now, I ne'er endured.",
          "plainText": "Till now I ne'er endured",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Your master will be dead ere you return;",
          "plainText": "Your master will be dead ere you return",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "There's nothing can be minister'd to nature",
          "plainText": "There's nothing can be minister'd to nature",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "That can recover him. [To Philemon.] Give this to the 'pothecary,",
          "plainText": "That can recover him To Philemon Give this to the 'pothecary",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "And tell me how it works.",
          "plainText": "And tell me how it works",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-stage-003",
      "type": "stage",
      "text": "[Exeunt all but Cerimon.]"
    },
    {
      "id": "pericles-prince-of-tyre-3-2-stage-004",
      "type": "stage",
      "text": "Enter two Gentlemen."
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Good morrow.",
          "plainText": "Good morrow",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Good morrow to your lordship.",
          "plainText": "Good morrow to your lordship",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Gentlemen, why do you stir so early?",
          "plainText": "Gentlemen why do you stir so early",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Sir, our lodgings, standing bleak upon the sea,",
          "plainText": "Sir our lodgings standing bleak upon the sea",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Shook as the earth did quake;",
          "plainText": "Shook as the earth did quake",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "The very principals did seem to rend,",
          "plainText": "The very principals did seem to rend",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "And all to topple: pure surprise and fear",
          "plainText": "And all to topple pure surprise and fear",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "Made me to quit the house.",
          "plainText": "Made me to quit the house",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "That is the cause we trouble you so early;",
          "plainText": "That is the cause we trouble you so early",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "'Tis not our husbandry.",
          "plainText": "'Tis not our husbandry",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "O, you say well.",
          "plainText": "O you say well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "But I much marvel that your lordship, having",
          "plainText": "But I much marvel that your lordship having",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Rich tire about you, should at these early hours",
          "plainText": "Rich tire about you should at these early hours",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "Shake off the golden slumber of repose.",
          "plainText": "Shake off the golden slumber of repose",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "'Tis most strange,",
          "plainText": "'Tis most strange",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "Nature should be so conversant with pain.",
          "plainText": "Nature should be so conversant with pain",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0027",
          "number": 27,
          "speechLineNumber": 6,
          "text": "Being thereto not compell'd.",
          "plainText": "Being thereto not compell'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "I hold it ever,",
          "plainText": "I hold it ever",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "Virtue and cunning were endowments greater",
          "plainText": "Virtue and cunning were endowments greater",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "Than nobleness and riches: careless heirs",
          "plainText": "Than nobleness and riches careless heirs",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0031",
          "number": 31,
          "speechLineNumber": 4,
          "text": "May the two latter darken and expend;",
          "plainText": "May the two latter darken and expend",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0032",
          "number": 32,
          "speechLineNumber": 5,
          "text": "But immortality attends the former,",
          "plainText": "But immortality attends the former",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0033",
          "number": 33,
          "speechLineNumber": 6,
          "text": "Making a man a god. 'Tis known, I ever",
          "plainText": "Making a man a god 'Tis known I ever",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0034",
          "number": 34,
          "speechLineNumber": 7,
          "text": "Have studied physic, through which secret art,",
          "plainText": "Have studied physic through which secret art",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0035",
          "number": 35,
          "speechLineNumber": 8,
          "text": "By turning o'er authorities, I have,",
          "plainText": "By turning o'er authorities I have",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0036",
          "number": 36,
          "speechLineNumber": 9,
          "text": "Together with my practice, made familiar",
          "plainText": "Together with my practice made familiar",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0037",
          "number": 37,
          "speechLineNumber": 10,
          "text": "To me and to my aid the blest infusions",
          "plainText": "To me and to my aid the blest infusions",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0038",
          "number": 38,
          "speechLineNumber": 11,
          "text": "That dwell in vegetives, in metals, stones;",
          "plainText": "That dwell in vegetives in metals stones",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0039",
          "number": 39,
          "speechLineNumber": 12,
          "text": "And I can speak of the disturbances",
          "plainText": "And I can speak of the disturbances",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0040",
          "number": 40,
          "speechLineNumber": 13,
          "text": "That nature works, and of her cures; which doth give me",
          "plainText": "That nature works and of her cures which doth give me",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0041",
          "number": 41,
          "speechLineNumber": 14,
          "text": "A more content in course of true delight",
          "plainText": "A more content in course of true delight",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0042",
          "number": 42,
          "speechLineNumber": 15,
          "text": "Than to be thirsty after tottering honour,",
          "plainText": "Than to be thirsty after tottering honour",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0043",
          "number": 43,
          "speechLineNumber": 16,
          "text": "Or tie my pleasure up in silken bags,",
          "plainText": "Or tie my pleasure up in silken bags",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0044",
          "number": 44,
          "speechLineNumber": 17,
          "text": "To please the fool and death.",
          "plainText": "To please the fool and death",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Your honour has through Ephesus pour'd forth",
          "plainText": "Your honour has through Ephesus pour'd forth",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "Your charity, and hundreds call themselves",
          "plainText": "Your charity and hundreds call themselves",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "Your creatures, who by you have been restored:",
          "plainText": "Your creatures who by you have been restored",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "And not your knowledge, your personal pain, but even",
          "plainText": "And not your knowledge your personal pain but even",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0049",
          "number": 49,
          "speechLineNumber": 5,
          "text": "Your purse, still open, hath built Lord Cerimon",
          "plainText": "Your purse still open hath built Lord Cerimon",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0050",
          "number": 50,
          "speechLineNumber": 6,
          "text": "Such strong renown as time shall never—",
          "plainText": "Such strong renown as time shall never",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-stage-005",
      "type": "stage",
      "text": "Enter two or three Servants with a chest."
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "first-servant",
        "name": "FIRST SERVANT",
        "displayName": "First Servant"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "So, lift there.",
          "plainText": "So lift there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "What's that?",
          "plainText": "What's that",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "first-servant",
        "name": "FIRST SERVANT",
        "displayName": "First Servant"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Sir, even now",
          "plainText": "Sir even now",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "Did the sea toss upon our shore this chest:",
          "plainText": "Did the sea toss upon our shore this chest",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0055",
          "number": 55,
          "speechLineNumber": 3,
          "text": "'Tis of some wreck.",
          "plainText": "'Tis of some wreck",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Set't down, let's look upon't.",
          "plainText": "Set't down let's look upon't",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "'Tis like a coffin, sir.",
          "plainText": "'Tis like a coffin sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Whate'er it be,",
          "plainText": "Whate'er it be",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "'Tis wondrous heavy. Wrench it open straight:",
          "plainText": "'Tis wondrous heavy Wrench it open straight",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "If the sea's stomach be o'ercharged with gold,",
          "plainText": "If the sea's stomach be o'ercharged with gold",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0061",
          "number": 61,
          "speechLineNumber": 4,
          "text": "'Tis a good constraint of fortune it belches upon us.",
          "plainText": "'Tis a good constraint of fortune it belches upon us",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "'Tis so, my lord.",
          "plainText": "'Tis so my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "How close 'tis caulk'd and bitumed!",
          "plainText": "How close 'tis caulk'd and bitumed",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "Did the sea cast it up?",
          "plainText": "Did the sea cast it up",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "first-servant",
        "name": "FIRST SERVANT",
        "displayName": "First Servant"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "I never saw so huge a billow, sir,",
          "plainText": "I never saw so huge a billow sir",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "As toss'd it upon shore.",
          "plainText": "As toss'd it upon shore",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Wrench it open;",
          "plainText": "Wrench it open",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "Soft! it smells most sweetly in my sense.",
          "plainText": "Soft it smells most sweetly in my sense",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "A delicate odour.",
          "plainText": "A delicate odour",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "As ever hit my nostril. So up with it.",
          "plainText": "As ever hit my nostril So up with it",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "O you most potent gods! what's here? a corpse!",
          "plainText": "O you most potent gods what's here a corpse",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Most strange!",
          "plainText": "Most strange",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Shrouded in cloth of state; balm'd and entreasured",
          "plainText": "Shrouded in cloth of state balm'd and entreasured",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0074",
          "number": 74,
          "speechLineNumber": 2,
          "text": "With full bags of spices! A passport too!",
          "plainText": "With full bags of spices A passport too",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0075",
          "number": 75,
          "speechLineNumber": 3,
          "text": "Apollo, perfect me in the characters!",
          "plainText": "Apollo perfect me in the characters",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-stage-006",
      "type": "stage",
      "text": "[Reads from a scroll.]"
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Most likely, sir.",
          "plainText": "Most likely sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Nay, certainly tonight;",
          "plainText": "Nay certainly tonight",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "For look how fresh she looks! They were too rough",
          "plainText": "For look how fresh she looks They were too rough",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0079",
          "number": 79,
          "speechLineNumber": 3,
          "text": "That threw her in the sea. Make a fire within",
          "plainText": "That threw her in the sea Make a fire within",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0080",
          "number": 80,
          "speechLineNumber": 4,
          "text": "Fetch hither all my boxes in my closet.",
          "plainText": "Fetch hither all my boxes in my closet",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-stage-007",
      "type": "stage",
      "text": "[Exit a Servant.]"
    },
    {
      "id": "pericles-prince-of-tyre-3-2-stage-008",
      "type": "stage",
      "text": "Re-enter a Servant with napkins and fire."
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "The heavens, through you, increase our wonder",
          "plainText": "The heavens through you increase our wonder",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0082",
          "number": 82,
          "speechLineNumber": 2,
          "text": "And sets up your fame for ever.",
          "plainText": "And sets up your fame for ever",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "She is alive; behold, her eyelids,",
          "plainText": "She is alive behold her eyelids",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0084",
          "number": 84,
          "speechLineNumber": 2,
          "text": "Cases to those heavenly jewels which Pericles hath lost,",
          "plainText": "Cases to those heavenly jewels which Pericles hath lost",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0085",
          "number": 85,
          "speechLineNumber": 3,
          "text": "Begin to part their fringes of bright gold;",
          "plainText": "Begin to part their fringes of bright gold",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0086",
          "number": 86,
          "speechLineNumber": 4,
          "text": "The diamonds of a most praised water doth appear,",
          "plainText": "The diamonds of a most praised water doth appear",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0087",
          "number": 87,
          "speechLineNumber": 5,
          "text": "To make the world twice rich. Live, and make us weep",
          "plainText": "To make the world twice rich Live and make us weep",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0088",
          "number": 88,
          "speechLineNumber": 6,
          "text": "To hear your fate, fair creature, rare as you seem to be.",
          "plainText": "To hear your fate fair creature rare as you seem to be",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-stage-009",
      "type": "stage",
      "text": "[She moves.]"
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-033",
      "type": "speech",
      "speaker": {
        "id": "thaisa",
        "name": "THAISA",
        "displayName": "Thaisa"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "O dear Diana,",
          "plainText": "O dear Diana",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0090",
          "number": 90,
          "speechLineNumber": 2,
          "text": "Where am I? Where's my lord? What world is this?",
          "plainText": "Where am I Where's my lord What world is this",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-034",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0091",
          "number": 91,
          "speechLineNumber": 1,
          "text": "Is not this strange?",
          "plainText": "Is not this strange",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-035",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "Most rare.",
          "plainText": "Most rare",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-speech-036",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-2-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "Hush, my gentle neighbours!",
          "plainText": "Hush my gentle neighbours",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0094",
          "number": 94,
          "speechLineNumber": 2,
          "text": "Lend me your hands; to the next chamber bear her.",
          "plainText": "Lend me your hands to the next chamber bear her",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0095",
          "number": 95,
          "speechLineNumber": 3,
          "text": "Get linen: now this matter must be look'd to,",
          "plainText": "Get linen now this matter must be look'd to",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0096",
          "number": 96,
          "speechLineNumber": 4,
          "text": "For her relapse is mortal. Come, come;",
          "plainText": "For her relapse is mortal Come come",
          "lineType": "verse"
        },
        {
          "id": "pericles-prince-of-tyre-3-2-line-0097",
          "number": 97,
          "speechLineNumber": 5,
          "text": "And Aesculapius guide us!",
          "plainText": "And Aesculapius guide us",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-2-stage-010",
      "type": "stage",
      "text": "[Exeunt, carrying her away.]"
    }
  ]
}