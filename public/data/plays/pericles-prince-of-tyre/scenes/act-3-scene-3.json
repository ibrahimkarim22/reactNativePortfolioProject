  "scene": {
    "id": "pericles-prince-of-tyre-3-3",
    "act": 3,
    "scene": 3,
    "label": "Act 3, Scene 3",
    "title": "SCENE III. Tarsus. A room in Cleon's house.",
    "location": "Tarsus. A room in Cleon's house.",
    "orderInPlay": 12
  },
  "content": [
    {
      "id": "pericles-prince-of-tyre-3-3-stage-001",
      "type": "stage",
      "text": "Enter Pericles, Cleon, Dionyza and Lychorida with Marina in her arms."
    },
    {
      "id": "pericles-prince-of-tyre-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Most honour'd Cleon, I must needs be gone;",
          "plainText": "Most honour'd Cleon I must needs be gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "My twelve months are expired, and Tyrus stands",
          "plainText": "My twelve months are expired and Tyrus stands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "In a litigious peace. You and your lady,",
          "plainText": "In a litigious peace You and your lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Take from my heart all thankfulness! The gods",
          "plainText": "Take from my heart all thankfulness The gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Make up the rest upon you!",
          "plainText": "Make up the rest upon you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "cleon",
        "name": "CLEON",
        "displayName": "Cleon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Your shafts of fortune, though they hurt you mortally,",
          "plainText": "Your shafts of fortune though they hurt you mortally",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Yet glance full wanderingly on us.",
          "plainText": "Yet glance full wanderingly on us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "dionyza",
        "name": "DIONYZA",
        "displayName": "Dionyza"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "O, your sweet queen!",
          "plainText": "O your sweet queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "That the strict fates had pleased you had brought her hither,",
          "plainText": "That the strict fates had pleased you had brought her hither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "To have bless'd mine eyes with her!",
          "plainText": "To have bless'd mine eyes with her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "We cannot but obey",
          "plainText": "We cannot but obey",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "The powers above us. Could I rage and roar",
          "plainText": "The powers above us Could I rage and roar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "As doth the sea she lies in, yet the end",
          "plainText": "As doth the sea she lies in yet the end",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "Must be as 'tis. My gentle babe Marina,",
          "plainText": "Must be as 'tis My gentle babe Marina",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "Whom, for she was born at sea, I have named so,",
          "plainText": "Whom for she was born at sea I have named so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 6,
          "text": "Here I charge your charity withal,",
          "plainText": "Here I charge your charity withal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 7,
          "text": "Leaving her the infant of your care;",
          "plainText": "Leaving her the infant of your care",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 8,
          "text": "Beseeching you to give her princely training,",
          "plainText": "Beseeching you to give her princely training",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 9,
          "text": "That she may be manner'd as she is born.",
          "plainText": "That she may be manner'd as she is born",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cleon",
        "name": "CLEON",
        "displayName": "Cleon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Fear not, my lord, but think",
          "plainText": "Fear not my lord but think",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Your grace, that fed my country with your corn,",
          "plainText": "Your grace that fed my country with your corn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "For which the people's prayers still fall upon you,",
          "plainText": "For which the people's prayers still fall upon you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Must in your child be thought on. If neglection",
          "plainText": "Must in your child be thought on If neglection",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "Should therein make me vile, the common body,",
          "plainText": "Should therein make me vile the common body",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 6,
          "text": "By you relieved, would force me to my duty:",
          "plainText": "By you relieved would force me to my duty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 7,
          "text": "But if to that my nature need a spur,",
          "plainText": "But if to that my nature need a spur",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 8,
          "text": "The gods revenge it upon me and mine,",
          "plainText": "The gods revenge it upon me and mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 9,
          "text": "To the end of generation!",
          "plainText": "To the end of generation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I believe you;",
          "plainText": "I believe you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "Your honour and your goodness teach me to't,",
          "plainText": "Your honour and your goodness teach me to't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "Without your vows. Till she be married, madam,",
          "plainText": "Without your vows Till she be married madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "By bright Diana, whom we honour, all",
          "plainText": "By bright Diana whom we honour all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0033",
          "number": 33,
          "speechLineNumber": 5,
          "text": "Unscissored shall this hair of mine remain,",
          "plainText": "Unscissored shall this hair of mine remain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0034",
          "number": 34,
          "speechLineNumber": 6,
          "text": "Though I show ill in't. So I take my leave.",
          "plainText": "Though I show ill in't So I take my leave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0035",
          "number": 35,
          "speechLineNumber": 7,
          "text": "Good madam, make me blessed in your care",
          "plainText": "Good madam make me blessed in your care",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0036",
          "number": 36,
          "speechLineNumber": 8,
          "text": "In bringing up my child.",
          "plainText": "In bringing up my child",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "dionyza",
        "name": "DIONYZA",
        "displayName": "Dionyza"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-3-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "I have one myself,",
          "plainText": "I have one myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Who shall not be more dear to my respect",
          "plainText": "Who shall not be more dear to my respect",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "Than yours, my lord.",
          "plainText": "Than yours my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Madam, my thanks and prayers.",
          "plainText": "Madam my thanks and prayers",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cleon",
        "name": "CLEON",
        "displayName": "Cleon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "We'll bring your grace e'en to the edge o'the shore,",
          "plainText": "We'll bring your grace e'en to the edge o'the shore",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Then give you up to the mask'd Neptune and",
          "plainText": "Then give you up to the mask'd Neptune and",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "The gentlest winds of heaven.",
          "plainText": "The gentlest winds of heaven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "pericles",
        "name": "PERICLES",
        "displayName": "Pericles"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "I will embrace your offer. Come, dearest madam.",
          "plainText": "I will embrace your offer Come dearest madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "O, no tears, Lychorida, no tears.",
          "plainText": "O no tears Lychorida no tears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "Look to your little mistress, on whose grace",
          "plainText": "Look to your little mistress on whose grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-3-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "You may depend hereafter. Come, my lord.",
          "plainText": "You may depend hereafter Come my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}