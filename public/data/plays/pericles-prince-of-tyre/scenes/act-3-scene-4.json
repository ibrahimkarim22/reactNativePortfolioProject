    "label": "Act 3, Scene 4",
    "title": "SCENE IV. Ephesus. A room in Cerimon's house.",
    "location": "Ephesus. A room in Cerimon's house.",
    "orderInPlay": 13
  },
  "content": [
    {
      "id": "pericles-prince-of-tyre-3-4-stage-001",
      "type": "stage",
      "text": "Enter Cerimon and Thaisa."
    },
    {
      "id": "pericles-prince-of-tyre-3-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Madam, this letter, and some certain jewels,",
          "plainText": "Madam this letter and some certain jewels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Lay with you in your coffer, which are",
          "plainText": "Lay with you in your coffer which are",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "At your command. Know you the character?",
          "plainText": "At your command Know you the character",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "thaisa",
        "name": "THAISA",
        "displayName": "Thaisa"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "It is my lord's.",
          "plainText": "It is my lord's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "That I was shipp'd at sea, I well remember,",
          "plainText": "That I was shipp'd at sea I well remember",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Even on my groaning time; but whether there",
          "plainText": "Even on my groaning time but whether there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "Deliver'd, by the holy gods,",
          "plainText": "Deliver'd by the holy gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "I cannot rightly say. But since King Pericles,",
          "plainText": "I cannot rightly say But since King Pericles",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0009",
          "number": 9,
          "speechLineNumber": 6,
          "text": "My wedded lord, I ne'er shall see again,",
          "plainText": "My wedded lord I ne'er shall see again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0010",
          "number": 10,
          "speechLineNumber": 7,
          "text": "A vestal livery will I take me to,",
          "plainText": "A vestal livery will I take me to",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0011",
          "number": 11,
          "speechLineNumber": 8,
          "text": "And never more have joy.",
          "plainText": "And never more have joy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cerimon",
        "name": "CERIMON",
        "displayName": "Cerimon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Madam, if this you purpose as ye speak,",
          "plainText": "Madam if this you purpose as ye speak",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "Diana's temple is not distant far,",
          "plainText": "Diana's temple is not distant far",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Where you may abide till your date expire.",
          "plainText": "Where you may abide till your date expire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "Moreover, if you please, a niece of mine",
          "plainText": "Moreover if you please a niece of mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "Shall there attend you.",
          "plainText": "Shall there attend you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "thaisa",
        "name": "THAISA",
        "displayName": "Thaisa"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-3-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "My recompense is thanks, that's all;",
          "plainText": "My recompense is thanks that's all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-3-4-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Yet my good will is great, though the gift small.",
          "plainText": "Yet my good will is great though the gift small",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-3-4-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}