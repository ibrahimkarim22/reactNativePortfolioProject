    "label": "Act 4, Scene 3",
    "title": "SCENE III. Tarsus. A room in Cleon's house.",
    "location": "Tarsus. A room in Cleon's house.",
    "orderInPlay": 16
  },
  "content": [
    {
      "id": "pericles-prince-of-tyre-4-3-stage-001",
      "type": "stage",
      "text": "Enter Cleon and Dionyza."
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "dionyza",
        "name": "DIONYZA",
        "displayName": "Dionyza"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Why, are you foolish? Can it be undone?",
          "plainText": "Why are you foolish Can it be undone",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "cleon",
        "name": "CLEON",
        "displayName": "Cleon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "O, Dionyza, such a piece of slaughter",
          "plainText": "O Dionyza such a piece of slaughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "The sun and moon ne'er look'd upon!",
          "plainText": "The sun and moon ne'er look'd upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "dionyza",
        "name": "DIONYZA",
        "displayName": "Dionyza"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I think you'll turn a child again.",
          "plainText": "I think you'll turn a child again",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cleon",
        "name": "CLEON",
        "displayName": "Cleon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Were I chief lord of all this spacious world,",
          "plainText": "Were I chief lord of all this spacious world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "I'd give it to undo the deed. A lady,",
          "plainText": "I'd give it to undo the deed A lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "Much less in blood than virtue, yet a princess",
          "plainText": "Much less in blood than virtue yet a princess",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "To equal any single crown o' the earth",
          "plainText": "To equal any single crown o' the earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 5,
          "text": "I' the justice of compare! O villain Leonine!",
          "plainText": "I' the justice of compare O villain Leonine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 6,
          "text": "Whom thou hast poison'd too:",
          "plainText": "Whom thou hast poison'd too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 7,
          "text": "If thou hadst drunk to him, 't had been a kindness",
          "plainText": "If thou hadst drunk to him 't had been a kindness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 8,
          "text": "Becoming well thy face. What canst thou say",
          "plainText": "Becoming well thy face What canst thou say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 9,
          "text": "When noble Pericles shall demand his child?",
          "plainText": "When noble Pericles shall demand his child",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "dionyza",
        "name": "DIONYZA",
        "displayName": "Dionyza"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "That she is dead. Nurses are not the fates,",
          "plainText": "That she is dead Nurses are not the fates",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "To foster it, nor ever to preserve.",
          "plainText": "To foster it nor ever to preserve",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "She died at night; I'll say so. Who can cross it?",
          "plainText": "She died at night I'll say so Who can cross it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "Unless you play the pious innocent,",
          "plainText": "Unless you play the pious innocent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "And for an honest attribute cry out",
          "plainText": "And for an honest attribute cry out",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 6,
          "text": "'She died by foul play.'",
          "plainText": "'She died by foul play'",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cleon",
        "name": "CLEON",
        "displayName": "Cleon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "O, go to. Well, well,",
          "plainText": "O go to Well well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Of all the faults beneath the heavens, the gods",
          "plainText": "Of all the faults beneath the heavens the gods",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "Do like this worst.",
          "plainText": "Do like this worst",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "dionyza",
        "name": "DIONYZA",
        "displayName": "Dionyza"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Be one of those that thinks",
          "plainText": "Be one of those that thinks",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "The petty wrens of Tarsus will fly hence,",
          "plainText": "The petty wrens of Tarsus will fly hence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "And open this to Pericles. I do shame",
          "plainText": "And open this to Pericles I do shame",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "To think of what a noble strain you are,",
          "plainText": "To think of what a noble strain you are",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "And of how coward a spirit.",
          "plainText": "And of how coward a spirit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cleon",
        "name": "CLEON",
        "displayName": "Cleon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "To such proceeding",
          "plainText": "To such proceeding",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "Whoever but his approbation added,",
          "plainText": "Whoever but his approbation added",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "Though not his prime consent, he did not flow",
          "plainText": "Though not his prime consent he did not flow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0031",
          "number": 31,
          "speechLineNumber": 4,
          "text": "From honourable courses.",
          "plainText": "From honourable courses",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "dionyza",
        "name": "DIONYZA",
        "displayName": "Dionyza"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Be it so, then:",
          "plainText": "Be it so then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Yet none does know, but you, how she came dead,",
          "plainText": "Yet none does know but you how she came dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "Nor none can know, Leonine being gone.",
          "plainText": "Nor none can know Leonine being gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "She did distain my child, and stood between",
          "plainText": "She did distain my child and stood between",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "Her and her fortunes: none would look on her,",
          "plainText": "Her and her fortunes none would look on her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "But cast their gazes on Marina's face;",
          "plainText": "But cast their gazes on Marina's face",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "Whilst ours was blurted at and held a malkin",
          "plainText": "Whilst ours was blurted at and held a malkin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0039",
          "number": 39,
          "speechLineNumber": 8,
          "text": "Not worth the time of day. It pierced me through;",
          "plainText": "Not worth the time of day It pierced me through",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0040",
          "number": 40,
          "speechLineNumber": 9,
          "text": "And though you call my course unnatural,",
          "plainText": "And though you call my course unnatural",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0041",
          "number": 41,
          "speechLineNumber": 10,
          "text": "You not your child well loving, yet I find",
          "plainText": "You not your child well loving yet I find",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0042",
          "number": 42,
          "speechLineNumber": 11,
          "text": "It greets me as an enterprise of kindness",
          "plainText": "It greets me as an enterprise of kindness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0043",
          "number": 43,
          "speechLineNumber": 12,
          "text": "Perform'd to your sole daughter.",
          "plainText": "Perform'd to your sole daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "cleon",
        "name": "CLEON",
        "displayName": "Cleon"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Heavens forgive it!",
          "plainText": "Heavens forgive it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "dionyza",
        "name": "DIONYZA",
        "displayName": "Dionyza"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-3-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "And as for Pericles, what should he say?",
          "plainText": "And as for Pericles what should he say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "We wept after her hearse, and yet we mourn.",
          "plainText": "We wept after her hearse and yet we mourn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "Her monument is almost finish'd, and her epitaphs",
          "plainText": "Her monument is almost finish'd and her epitaphs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "In glittering golden characters express",
          "plainText": "In glittering golden characters express",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0049",
          "number": 49,
          "speechLineNumber": 5,
          "text": "A general praise to her, and care in us",
          "plainText": "A general praise to her and care in us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "pericles-prince-of-tyre-4-3-line-0050",
          "number": 50,
          "speechLineNumber": 6,
          "text": "At whose expense 'tis done.",
          "plainText": "At whose expense 'tis done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
