  "content": [
    {
      "id": "pericles-prince-of-tyre-4-5-stage-001",
      "type": "stage",
      "text": "Enter, from the brothel, two Gentlemen."
    },
    {
      "id": "pericles-prince-of-tyre-4-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Did you ever hear the like?",
          "plainText": "Did you ever hear the like",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "No, nor never shall do in such a place as this, she being once gone.",
          "plainText": "No nor never shall do in such a place as this she being once gone",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "But to have divinity preached there! did you ever dream of such a thing?",
          "plainText": "But to have divinity preached there did you ever dream of such a thing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-gentleman",
        "name": "SECOND GENTLEMAN",
        "displayName": "Second Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "No, no. Come, I am for no more bawdy houses: shall's go hear the vestals sing?",
          "plainText": "No no Come I am for no more bawdy houses shall's go hear the vestals sing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "first-gentleman",
        "name": "FIRST GENTLEMAN",
        "displayName": "First Gentleman"
      },
      "lines": [
        {
          "id": "pericles-prince-of-tyre-4-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "I'll do anything now that is virtuous; but I am out of the road of rutting for ever.",
          "plainText": "I'll do anything now that is virtuous but I am out of the road of rutting for ever",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "pericles-prince-of-tyre-4-5-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
