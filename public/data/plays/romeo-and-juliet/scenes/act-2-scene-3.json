    "location": "Friar Lawrence's Cell.",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "romeo-and-juliet-2-3-stage-001",
      "type": "stage",
      "text": "Enter Friar Lawrence with a basket."
    },
    {
      "id": "romeo-and-juliet-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The grey-ey'd morn smiles on the frowning night,",
          "plainText": "The greyey'd morn smiles on the frowning night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Chequering the eastern clouds with streaks of light;",
          "plainText": "Chequering the eastern clouds with streaks of light",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And fleckled darkness like a drunkard reels",
          "plainText": "And fleckled darkness like a drunkard reels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "From forth day's pathway, made by Titan's fiery wheels",
          "plainText": "From forth day's pathway made by Titan's fiery wheels",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Now, ere the sun advance his burning eye,",
          "plainText": "Now ere the sun advance his burning eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "The day to cheer, and night's dank dew to dry,",
          "plainText": "The day to cheer and night's dank dew to dry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "I must upfill this osier cage of ours",
          "plainText": "I must upfill this osier cage of ours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "With baleful weeds and precious-juiced flowers.",
          "plainText": "With baleful weeds and preciousjuiced flowers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "The earth that's nature's mother, is her tomb;",
          "plainText": "The earth that's nature's mother is her tomb",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "What is her burying grave, that is her womb:",
          "plainText": "What is her burying grave that is her womb",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "And from her womb children of divers kind",
          "plainText": "And from her womb children of divers kind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "We sucking on her natural bosom find.",
          "plainText": "We sucking on her natural bosom find",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "Many for many virtues excellent,",
          "plainText": "Many for many virtues excellent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "None but for some, and yet all different.",
          "plainText": "None but for some and yet all different",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "O, mickle is the powerful grace that lies",
          "plainText": "O mickle is the powerful grace that lies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "In plants, herbs, stones, and their true qualities.",
          "plainText": "In plants herbs stones and their true qualities",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "For naught so vile that on the earth doth live",
          "plainText": "For naught so vile that on the earth doth live",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "But to the earth some special good doth give;",
          "plainText": "But to the earth some special good doth give",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "Nor aught so good but, strain'd from that fair use,",
          "plainText": "Nor aught so good but strain'd from that fair use",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "Revolts from true birth, stumbling on abuse.",
          "plainText": "Revolts from true birth stumbling on abuse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "Virtue itself turns vice being misapplied,",
          "plainText": "Virtue itself turns vice being misapplied",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "And vice sometime's by action dignified.",
          "plainText": "And vice sometime's by action dignified",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-stage-002",
      "type": "stage",
      "text": "Enter Romeo."
    },
    {
      "id": "romeo-and-juliet-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Good morrow, father.",
          "plainText": "Good morrow father",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Benedicite!",
          "plainText": "Benedicite",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "What early tongue so sweet saluteth me?",
          "plainText": "What early tongue so sweet saluteth me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "Young son, it argues a distemper'd head",
          "plainText": "Young son it argues a distemper'd head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "So soon to bid good morrow to thy bed.",
          "plainText": "So soon to bid good morrow to thy bed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 5,
          "text": "Care keeps his watch in every old man's eye,",
          "plainText": "Care keeps his watch in every old man's eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 6,
          "text": "And where care lodges sleep will never lie;",
          "plainText": "And where care lodges sleep will never lie",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 7,
          "text": "But where unbruised youth with unstuff'd brain",
          "plainText": "But where unbruised youth with unstuff'd brain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 8,
          "text": "Doth couch his limbs, there golden sleep doth reign.",
          "plainText": "Doth couch his limbs there golden sleep doth reign",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 9,
          "text": "Therefore thy earliness doth me assure",
          "plainText": "Therefore thy earliness doth me assure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 10,
          "text": "Thou art uprous'd with some distemperature;",
          "plainText": "Thou art uprous'd with some distemperature",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 11,
          "text": "Or if not so, then here I hit it right,",
          "plainText": "Or if not so then here I hit it right",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0035",
          "number": 35,
          "speechLineNumber": 12,
          "text": "Our Romeo hath not been in bed tonight.",
          "plainText": "Our Romeo hath not been in bed tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "That last is true; the sweeter rest was mine.",
          "plainText": "That last is true the sweeter rest was mine",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "God pardon sin. Wast thou with Rosaline?",
          "plainText": "God pardon sin Wast thou with Rosaline",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "With Rosaline, my ghostly father? No.",
          "plainText": "With Rosaline my ghostly father No",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "I have forgot that name, and that name's woe.",
          "plainText": "I have forgot that name and that name's woe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "That's my good son. But where hast thou been then?",
          "plainText": "That's my good son But where hast thou been then",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "I'll tell thee ere thou ask it me again.",
          "plainText": "I'll tell thee ere thou ask it me again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "I have been feasting with mine enemy,",
          "plainText": "I have been feasting with mine enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "Where on a sudden one hath wounded me",
          "plainText": "Where on a sudden one hath wounded me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "That's by me wounded. Both our remedies",
          "plainText": "That's by me wounded Both our remedies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "Within thy help and holy physic lies.",
          "plainText": "Within thy help and holy physic lies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "I bear no hatred, blessed man; for lo,",
          "plainText": "I bear no hatred blessed man for lo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0047",
          "number": 47,
          "speechLineNumber": 7,
          "text": "My intercession likewise steads my foe.",
          "plainText": "My intercession likewise steads my foe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Be plain, good son, and homely in thy drift;",
          "plainText": "Be plain good son and homely in thy drift",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "Riddling confession finds but riddling shrift.",
          "plainText": "Riddling confession finds but riddling shrift",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Then plainly know my heart's dear love is set",
          "plainText": "Then plainly know my heart's dear love is set",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "On the fair daughter of rich Capulet.",
          "plainText": "On the fair daughter of rich Capulet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0052",
          "number": 52,
          "speechLineNumber": 3,
          "text": "As mine on hers, so hers is set on mine;",
          "plainText": "As mine on hers so hers is set on mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0053",
          "number": 53,
          "speechLineNumber": 4,
          "text": "And all combin'd, save what thou must combine",
          "plainText": "And all combin'd save what thou must combine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0054",
          "number": 54,
          "speechLineNumber": 5,
          "text": "By holy marriage. When, and where, and how",
          "plainText": "By holy marriage When and where and how",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0055",
          "number": 55,
          "speechLineNumber": 6,
          "text": "We met, we woo'd, and made exchange of vow,",
          "plainText": "We met we woo'd and made exchange of vow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0056",
          "number": 56,
          "speechLineNumber": 7,
          "text": "I'll tell thee as we pass; but this I pray,",
          "plainText": "I'll tell thee as we pass but this I pray",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0057",
          "number": 57,
          "speechLineNumber": 8,
          "text": "That thou consent to marry us today.",
          "plainText": "That thou consent to marry us today",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Holy Saint Francis! What a change is here!",
          "plainText": "Holy Saint Francis What a change is here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "Is Rosaline, that thou didst love so dear,",
          "plainText": "Is Rosaline that thou didst love so dear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "So soon forsaken? Young men's love then lies",
          "plainText": "So soon forsaken Young men's love then lies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0061",
          "number": 61,
          "speechLineNumber": 4,
          "text": "Not truly in their hearts, but in their eyes.",
          "plainText": "Not truly in their hearts but in their eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0062",
          "number": 62,
          "speechLineNumber": 5,
          "text": "Jesu Maria, what a deal of brine",
          "plainText": "Jesu Maria what a deal of brine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0063",
          "number": 63,
          "speechLineNumber": 6,
          "text": "Hath wash'd thy sallow cheeks for Rosaline!",
          "plainText": "Hath wash'd thy sallow cheeks for Rosaline",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0064",
          "number": 64,
          "speechLineNumber": 7,
          "text": "How much salt water thrown away in waste,",
          "plainText": "How much salt water thrown away in waste",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0065",
          "number": 65,
          "speechLineNumber": 8,
          "text": "To season love, that of it doth not taste.",
          "plainText": "To season love that of it doth not taste",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0066",
          "number": 66,
          "speechLineNumber": 9,
          "text": "The sun not yet thy sighs from heaven clears,",
          "plainText": "The sun not yet thy sighs from heaven clears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0067",
          "number": 67,
          "speechLineNumber": 10,
          "text": "Thy old groans yet ring in mine ancient ears.",
          "plainText": "Thy old groans yet ring in mine ancient ears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0068",
          "number": 68,
          "speechLineNumber": 11,
          "text": "Lo here upon thy cheek the stain doth sit",
          "plainText": "Lo here upon thy cheek the stain doth sit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0069",
          "number": 69,
          "speechLineNumber": 12,
          "text": "Of an old tear that is not wash'd off yet.",
          "plainText": "Of an old tear that is not wash'd off yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0070",
          "number": 70,
          "speechLineNumber": 13,
          "text": "If ere thou wast thyself, and these woes thine,",
          "plainText": "If ere thou wast thyself and these woes thine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0071",
          "number": 71,
          "speechLineNumber": 14,
          "text": "Thou and these woes were all for Rosaline,",
          "plainText": "Thou and these woes were all for Rosaline",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0072",
          "number": 72,
          "speechLineNumber": 15,
          "text": "And art thou chang'd? Pronounce this sentence then,",
          "plainText": "And art thou chang'd Pronounce this sentence then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0073",
          "number": 73,
          "speechLineNumber": 16,
          "text": "Women may fall, when there's no strength in men.",
          "plainText": "Women may fall when there's no strength in men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Thou chidd'st me oft for loving Rosaline.",
          "plainText": "Thou chidd'st me oft for loving Rosaline",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "For doting, not for loving, pupil mine.",
          "plainText": "For doting not for loving pupil mine",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "And bad'st me bury love.",
          "plainText": "And bad'st me bury love",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Not in a grave",
          "plainText": "Not in a grave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "To lay one in, another out to have.",
          "plainText": "To lay one in another out to have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "I pray thee chide me not, her I love now",
          "plainText": "I pray thee chide me not her I love now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0080",
          "number": 80,
          "speechLineNumber": 2,
          "text": "Doth grace for grace and love for love allow.",
          "plainText": "Doth grace for grace and love for love allow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0081",
          "number": 81,
          "speechLineNumber": 3,
          "text": "The other did not so.",
          "plainText": "The other did not so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "O, she knew well",
          "plainText": "O she knew well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0083",
          "number": 83,
          "speechLineNumber": 2,
          "text": "Thy love did read by rote, that could not spell.",
          "plainText": "Thy love did read by rote that could not spell",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0084",
          "number": 84,
          "speechLineNumber": 3,
          "text": "But come young waverer, come go with me,",
          "plainText": "But come young waverer come go with me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0085",
          "number": 85,
          "speechLineNumber": 4,
          "text": "In one respect I'll thy assistant be;",
          "plainText": "In one respect I'll thy assistant be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0086",
          "number": 86,
          "speechLineNumber": 5,
          "text": "For this alliance may so happy prove,",
          "plainText": "For this alliance may so happy prove",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-3-line-0087",
          "number": 87,
          "speechLineNumber": 6,
          "text": "To turn your households' rancour to pure love.",
          "plainText": "To turn your households' rancour to pure love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0088",
          "number": 88,
          "speechLineNumber": 1,
          "text": "O let us hence; I stand on sudden haste.",
          "plainText": "O let us hence I stand on sudden haste",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-3-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "Wisely and slow; they stumble that run fast.",
          "plainText": "Wisely and slow they stumble that run fast",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}