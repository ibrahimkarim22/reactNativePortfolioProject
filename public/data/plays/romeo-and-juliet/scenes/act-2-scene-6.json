  "scene": {
    "id": "romeo-and-juliet-2-6",
    "act": 2,
    "scene": 6,
    "label": "Act 2, Scene 6",
    "title": "SCENE VI. Friar Lawrence's Cell.",
    "location": "Friar Lawrence's Cell.",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "romeo-and-juliet-2-6-stage-001",
      "type": "stage",
      "text": "Enter Friar Lawrence and Romeo."
    },
    {
      "id": "romeo-and-juliet-2-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "So smile the heavens upon this holy act",
          "plainText": "So smile the heavens upon this holy act",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "That after-hours with sorrow chide us not.",
          "plainText": "That afterhours with sorrow chide us not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-6-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Amen, amen, but come what sorrow can,",
          "plainText": "Amen amen but come what sorrow can",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "It cannot countervail the exchange of joy",
          "plainText": "It cannot countervail the exchange of joy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "That one short minute gives me in her sight.",
          "plainText": "That one short minute gives me in her sight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "Do thou but close our hands with holy words,",
          "plainText": "Do thou but close our hands with holy words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0007",
          "number": 7,
          "speechLineNumber": 5,
          "text": "Then love-devouring death do what he dare,",
          "plainText": "Then lovedevouring death do what he dare",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0008",
          "number": 8,
          "speechLineNumber": 6,
          "text": "It is enough I may but call her mine.",
          "plainText": "It is enough I may but call her mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-6-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "These violent delights have violent ends,",
          "plainText": "These violent delights have violent ends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "And in their triumph die; like fire and powder,",
          "plainText": "And in their triumph die like fire and powder",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Which as they kiss consume. The sweetest honey",
          "plainText": "Which as they kiss consume The sweetest honey",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "Is loathsome in his own deliciousness,",
          "plainText": "Is loathsome in his own deliciousness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "And in the taste confounds the appetite.",
          "plainText": "And in the taste confounds the appetite",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0014",
          "number": 14,
          "speechLineNumber": 6,
          "text": "Therefore love moderately: long love doth so;",
          "plainText": "Therefore love moderately long love doth so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0015",
          "number": 15,
          "speechLineNumber": 7,
          "text": "Too swift arrives as tardy as too slow.",
          "plainText": "Too swift arrives as tardy as too slow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-6-stage-002",
      "type": "stage",
      "text": "Enter Juliet."
    },
    {
      "id": "romeo-and-juliet-2-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-6-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Good even to my ghostly confessor.",
          "plainText": "Good even to my ghostly confessor",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-6-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Romeo shall thank thee, daughter, for us both.",
          "plainText": "Romeo shall thank thee daughter for us both",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-6-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "As much to him, else is his thanks too much.",
          "plainText": "As much to him else is his thanks too much",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-6-speech-007",
      "type": "speech",
      "speaker": {
        "id": "romeo",
        "name": "ROMEO",
        "displayName": "Romeo"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-6-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Ah, Juliet, if the measure of thy joy",
          "plainText": "Ah Juliet if the measure of thy joy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Be heap'd like mine, and that thy skill be more",
          "plainText": "Be heap'd like mine and that thy skill be more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "To blazon it, then sweeten with thy breath",
          "plainText": "To blazon it then sweeten with thy breath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "This neighbour air, and let rich music's tongue",
          "plainText": "This neighbour air and let rich music's tongue",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "Unfold the imagin'd happiness that both",
          "plainText": "Unfold the imagin'd happiness that both",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "Receive in either by this dear encounter.",
          "plainText": "Receive in either by this dear encounter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-6-speech-008",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-6-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Conceit more rich in matter than in words,",
          "plainText": "Conceit more rich in matter than in words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Brags of his substance, not of ornament.",
          "plainText": "Brags of his substance not of ornament",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "They are but beggars that can count their worth;",
          "plainText": "They are but beggars that can count their worth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "But my true love is grown to such excess,",
          "plainText": "But my true love is grown to such excess",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "I cannot sum up sum of half my wealth.",
          "plainText": "I cannot sum up sum of half my wealth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-6-speech-009",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-2-6-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Come, come with me, and we will make short work,",
          "plainText": "Come come with me and we will make short work",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "For, by your leaves, you shall not stay alone",
          "plainText": "For by your leaves you shall not stay alone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "romeo-and-juliet-2-6-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "Till holy church incorporate two in one.",
          "plainText": "Till holy church incorporate two in one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-2-6-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}