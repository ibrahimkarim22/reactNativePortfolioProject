  "scene": {
    "id": "romeo-and-juliet-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. Hall in Capulet's House.",
    "location": "Hall in Capulet's House.",
    "orderInPlay": 18
  },
  "content": [
    {
      "id": "romeo-and-juliet-4-2-stage-001",
      "type": "stage",
      "text": "Enter Capulet, Lady Capulet, Nurse and Servants."
    },
    {
      "id": "romeo-and-juliet-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "So many guests invite as here are writ.",
          "plainText": "So many guests invite as here are writ",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-stage-002",
      "type": "stage",
      "text": "[Exit first Servant.]"
    },
    {
      "id": "romeo-and-juliet-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "second-servant",
        "name": "SECOND SERVANT",
        "displayName": "Second Servant"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "You shall have none ill, sir; for I'll try if they can lick their fingers.",
          "plainText": "You shall have none ill sir for I'll try if they can lick their fingers",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "How canst thou try them so?",
          "plainText": "How canst thou try them so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "second-servant",
        "name": "SECOND SERVANT",
        "displayName": "Second Servant"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Marry, sir, 'tis an ill cook that cannot lick his own fingers; therefore he that cannot lick his fingers goes not with me.",
          "plainText": "Marry sir 'tis an ill cook that cannot lick his own fingers therefore he that cannot lick his fingers goes not with me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Go, begone.",
          "plainText": "Go begone",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-stage-003",
      "type": "stage",
      "text": "[Exit second Servant.]"
    },
    {
      "id": "romeo-and-juliet-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "nurse",
        "name": "NURSE",
        "displayName": "Nurse"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Ay, forsooth.",
          "plainText": "Ay forsooth",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Well, he may chance to do some good on her.",
          "plainText": "Well he may chance to do some good on her",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "A peevish self-will'd harlotry it is.",
          "plainText": "A peevish selfwill'd harlotry it is",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-stage-004",
      "type": "stage",
      "text": "Enter Juliet."
    },
    {
      "id": "romeo-and-juliet-4-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "nurse",
        "name": "NURSE",
        "displayName": "Nurse"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "See where she comes from shrift with merry look.",
          "plainText": "See where she comes from shrift with merry look",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "How now, my headstrong. Where have you been gadding?",
          "plainText": "How now my headstrong Where have you been gadding",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Where I have learnt me to repent the sin",
          "plainText": "Where I have learnt me to repent the sin",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Of disobedient opposition",
          "plainText": "Of disobedient opposition",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "To you and your behests; and am enjoin'd",
          "plainText": "To you and your behests and am enjoin'd",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "By holy Lawrence to fall prostrate here,",
          "plainText": "By holy Lawrence to fall prostrate here",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "To beg your pardon. Pardon, I beseech you.",
          "plainText": "To beg your pardon Pardon I beseech you",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 6,
          "text": "Henceforward I am ever rul'd by you.",
          "plainText": "Henceforward I am ever rul'd by you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Send for the County, go tell him of this.",
          "plainText": "Send for the County go tell him of this",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "I'll have this knot knit up tomorrow morning.",
          "plainText": "I'll have this knot knit up tomorrow morning",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I met the youthful lord at Lawrence' cell,",
          "plainText": "I met the youthful lord at Lawrence' cell",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "And gave him what becomed love I might,",
          "plainText": "And gave him what becomed love I might",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Not stepping o'er the bounds of modesty.",
          "plainText": "Not stepping o'er the bounds of modesty",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Why, I am glad on't. This is well. Stand up.",
          "plainText": "Why I am glad on't This is well Stand up",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "This is as't should be. Let me see the County.",
          "plainText": "This is as't should be Let me see the County",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "Ay, marry. Go, I say, and fetch him hither.",
          "plainText": "Ay marry Go I say and fetch him hither",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Now afore God, this reverend holy Friar,",
          "plainText": "Now afore God this reverend holy Friar",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "All our whole city is much bound to him.",
          "plainText": "All our whole city is much bound to him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Nurse, will you go with me into my closet,",
          "plainText": "Nurse will you go with me into my closet",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "To help me sort such needful ornaments",
          "plainText": "To help me sort such needful ornaments",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "As you think fit to furnish me tomorrow?",
          "plainText": "As you think fit to furnish me tomorrow",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "lady-capulet",
        "name": "LADY CAPULET",
        "displayName": "Lady Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "No, not till Thursday. There is time enough.",
          "plainText": "No not till Thursday There is time enough",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Go, Nurse, go with her. We'll to church tomorrow.",
          "plainText": "Go Nurse go with her We'll to church tomorrow",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-stage-005",
      "type": "stage",
      "text": "[Exeunt Juliet and Nurse.]"
    },
    {
      "id": "romeo-and-juliet-4-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "lady-capulet",
        "name": "LADY CAPULET",
        "displayName": "Lady Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "We shall be short in our provision,",
          "plainText": "We shall be short in our provision",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "'Tis now near night.",
          "plainText": "'Tis now near night",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Tush, I will stir about,",
          "plainText": "Tush I will stir about",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "And all things shall be well, I warrant thee, wife.",
          "plainText": "And all things shall be well I warrant thee wife",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Go thou to Juliet, help to deck up her.",
          "plainText": "Go thou to Juliet help to deck up her",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "I'll not to bed tonight, let me alone.",
          "plainText": "I'll not to bed tonight let me alone",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "I'll play the housewife for this once.—What, ho!—",
          "plainText": "I'll play the housewife for this onceWhat ho",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0039",
          "number": 39,
          "speechLineNumber": 6,
          "text": "They are all forth: well, I will walk myself",
          "plainText": "They are all forth well I will walk myself",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0040",
          "number": 40,
          "speechLineNumber": 7,
          "text": "To County Paris, to prepare him up",
          "plainText": "To County Paris to prepare him up",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0041",
          "number": 41,
          "speechLineNumber": 8,
          "text": "Against tomorrow. My heart is wondrous light",
          "plainText": "Against tomorrow My heart is wondrous light",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-2-line-0042",
          "number": 42,
          "speechLineNumber": 9,
          "text": "Since this same wayward girl is so reclaim'd.",
          "plainText": "Since this same wayward girl is so reclaim'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-2-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}