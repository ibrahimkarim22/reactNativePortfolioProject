{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "romeo-and-juliet",
    "title": "The Tragedy of Romeo and Juliet",
    "author": "William Shakespeare",
    "genre": "Tragedy"
  },
  "source": {
    "name": "Project Gutenberg",
