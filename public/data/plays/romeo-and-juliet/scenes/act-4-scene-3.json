  "scene": {
    "id": "romeo-and-juliet-4-3",
    "act": 4,
    "scene": 3,
    "label": "Act 4, Scene 3",
    "title": "SCENE III. Juliet's Chamber.",
    "location": "Juliet's Chamber.",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "romeo-and-juliet-4-3-stage-001",
      "type": "stage",
      "text": "Enter Juliet and Nurse."
    },
    {
      "id": "romeo-and-juliet-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Ay, those attires are best. But, gentle Nurse,",
          "plainText": "Ay those attires are best But gentle Nurse",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "I pray thee leave me to myself tonight;",
          "plainText": "I pray thee leave me to myself tonight",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "For I have need of many orisons",
          "plainText": "For I have need of many orisons",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "To move the heavens to smile upon my state,",
          "plainText": "To move the heavens to smile upon my state",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Which, well thou know'st, is cross and full of sin.",
          "plainText": "Which well thou know'st is cross and full of sin",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-3-stage-002",
      "type": "stage",
      "text": "Enter Lady Capulet."
    },
    {
      "id": "romeo-and-juliet-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lady-capulet",
        "name": "LADY CAPULET",
        "displayName": "Lady Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "What, are you busy, ho? Need you my help?",
          "plainText": "What are you busy ho Need you my help",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "No, madam; we have cull'd such necessaries",
          "plainText": "No madam we have cull'd such necessaries",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "As are behoveful for our state tomorrow.",
          "plainText": "As are behoveful for our state tomorrow",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "So please you, let me now be left alone,",
          "plainText": "So please you let me now be left alone",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "And let the nurse this night sit up with you,",
          "plainText": "And let the nurse this night sit up with you",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "For I am sure you have your hands full all",
          "plainText": "For I am sure you have your hands full all",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "In this so sudden business.",
          "plainText": "In this so sudden business",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lady-capulet",
        "name": "LADY CAPULET",
        "displayName": "Lady Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Good night.",
          "plainText": "Good night",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Get thee to bed and rest, for thou hast need.",
          "plainText": "Get thee to bed and rest for thou hast need",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-3-stage-003",
      "type": "stage",
      "text": "[Exeunt Lady Capulet and Nurse.]"
    },
    {
      "id": "romeo-and-juliet-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "juliet",
        "name": "JULIET",
        "displayName": "Juliet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Farewell. God knows when we shall meet again.",
          "plainText": "Farewell God knows when we shall meet again",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "I have a faint cold fear thrills through my veins",
          "plainText": "I have a faint cold fear thrills through my veins",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "That almost freezes up the heat of life.",
          "plainText": "That almost freezes up the heat of life",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "I'll call them back again to comfort me.",
          "plainText": "I'll call them back again to comfort me",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 5,
          "text": "Nurse!—What should she do here?",
          "plainText": "NurseWhat should she do here",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0020",
          "number": 20,
          "speechLineNumber": 6,
          "text": "My dismal scene I needs must act alone.",
          "plainText": "My dismal scene I needs must act alone",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0021",
          "number": 21,
          "speechLineNumber": 7,
          "text": "Come, vial.",
          "plainText": "Come vial",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0022",
          "number": 22,
          "speechLineNumber": 8,
          "text": "What if this mixture do not work at all?",
          "plainText": "What if this mixture do not work at all",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0023",
          "number": 23,
          "speechLineNumber": 9,
          "text": "Shall I be married then tomorrow morning?",
          "plainText": "Shall I be married then tomorrow morning",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-3-line-0024",
          "number": 24,
          "speechLineNumber": 10,
          "text": "No, No! This shall forbid it. Lie thou there.",
          "plainText": "No No This shall forbid it Lie thou there",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-3-stage-004",
      "type": "stage",
      "text": "[Laying down her dagger.]"
    },
    {
      "id": "romeo-and-juliet-4-3-stage-005",
      "type": "stage",
      "text": "[Throws herself on the bed.]"
    }
  ]
}