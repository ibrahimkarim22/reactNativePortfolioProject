  "scene": {
    "id": "romeo-and-juliet-4-4",
    "act": 4,
    "scene": 4,
    "label": "Act 4, Scene 4",
    "title": "SCENE IV. Hall in Capulet's House.",
    "location": "Hall in Capulet's House.",
    "orderInPlay": 20
  },
  "content": [
    {
      "id": "romeo-and-juliet-4-4-stage-001",
      "type": "stage",
      "text": "Enter Lady Capulet and Nurse."
    },
    {
      "id": "romeo-and-juliet-4-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lady-capulet",
        "name": "LADY CAPULET",
        "displayName": "Lady Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Hold, take these keys and fetch more spices, Nurse.",
          "plainText": "Hold take these keys and fetch more spices Nurse",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "nurse",
        "name": "NURSE",
        "displayName": "Nurse"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "They call for dates and quinces in the pastry.",
          "plainText": "They call for dates and quinces in the pastry",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-stage-002",
      "type": "stage",
      "text": "Enter Capulet."
    },
    {
      "id": "romeo-and-juliet-4-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Come, stir, stir, stir! The second cock hath crow'd,",
          "plainText": "Come stir stir stir The second cock hath crow'd",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "The curfew bell hath rung, 'tis three o'clock.",
          "plainText": "The curfew bell hath rung 'tis three o'clock",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Look to the bak'd meats, good Angelica;",
          "plainText": "Look to the bak'd meats good Angelica",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "Spare not for cost.",
          "plainText": "Spare not for cost",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "nurse",
        "name": "NURSE",
        "displayName": "Nurse"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Go, you cot-quean, go,",
          "plainText": "Go you cotquean go",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Get you to bed; faith, you'll be sick tomorrow",
          "plainText": "Get you to bed faith you'll be sick tomorrow",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "For this night's watching.",
          "plainText": "For this night's watching",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "No, not a whit. What! I have watch'd ere now",
          "plainText": "No not a whit What I have watch'd ere now",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "All night for lesser cause, and ne'er been sick.",
          "plainText": "All night for lesser cause and ne'er been sick",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "lady-capulet",
        "name": "LADY CAPULET",
        "displayName": "Lady Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Ay, you have been a mouse-hunt in your time;",
          "plainText": "Ay you have been a mousehunt in your time",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "But I will watch you from such watching now.",
          "plainText": "But I will watch you from such watching now",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-stage-003",
      "type": "stage",
      "text": "[Exeunt Lady Capulet and Nurse.]"
    },
    {
      "id": "romeo-and-juliet-4-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "A jealous-hood, a jealous-hood!",
          "plainText": "A jealoushood a jealoushood",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-stage-004",
      "type": "stage",
      "text": "Enter Servants, with spits, logs and baskets."
    },
    {
      "id": "romeo-and-juliet-4-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "first-servant",
        "name": "FIRST SERVANT",
        "displayName": "First Servant"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Things for the cook, sir; but I know not what.",
          "plainText": "Things for the cook sir but I know not what",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Make haste, make haste.",
          "plainText": "Make haste make haste",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-stage-005",
      "type": "stage",
      "text": "[Exit First Servant.]"
    },
    {
      "id": "romeo-and-juliet-4-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "second-servant",
        "name": "SECOND SERVANT",
        "displayName": "Second Servant"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "I have a head, sir, that will find out logs",
          "plainText": "I have a head sir that will find out logs",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "And never trouble Peter for the matter.",
          "plainText": "And never trouble Peter for the matter",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "romeo-and-juliet-4-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "capulet",
        "name": "CAPULET",
        "displayName": "Capulet"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-4-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Mass and well said; a merry whoreson, ha.",
          "plainText": "Mass and well said a merry whoreson ha",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Thou shalt be loggerhead.—Good faith, 'tis day.",
          "plainText": "Thou shalt be loggerheadGood faith 'tis day",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "The County will be here with music straight,",
          "plainText": "The County will be here with music straight",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-4-4-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "For so he said he would. I hear him near.",
          "plainText": "For so he said he would I hear him near",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-4-4-stage-007",
      "type": "stage",
      "text": "[Play music.]"
    },
    {
      "id": "romeo-and-juliet-4-4-stage-008",
      "type": "stage",
      "text": "Re-enter Nurse."
    },
    {
      "id": "romeo-and-juliet-4-4-stage-009",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}