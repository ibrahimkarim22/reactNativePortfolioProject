  "scene": {
    "id": "romeo-and-juliet-5-2",
    "act": 5,
    "scene": 2,
    "label": "Act 5, Scene 2",
    "title": "SCENE II. Friar Lawrence's Cell.",
    "location": "Friar Lawrence's Cell.",
    "orderInPlay": 23
  },
  "content": [
    {
      "id": "romeo-and-juliet-5-2-stage-001",
      "type": "stage",
      "text": "Enter Friar John."
    },
    {
      "id": "romeo-and-juliet-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "friar-john",
        "name": "FRIAR JOHN",
        "displayName": "Friar John"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Holy Franciscan Friar! Brother, ho!",
          "plainText": "Holy Franciscan Friar Brother ho",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-5-2-stage-002",
      "type": "stage",
      "text": "Enter Friar Lawrence."
    },
    {
      "id": "romeo-and-juliet-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "This same should be the voice of Friar John.",
          "plainText": "This same should be the voice of Friar John",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Welcome from Mantua. What says Romeo?",
          "plainText": "Welcome from Mantua What says Romeo",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "Or, if his mind be writ, give me his letter.",
          "plainText": "Or if his mind be writ give me his letter",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "friar-john",
        "name": "FRIAR JOHN",
        "displayName": "Friar John"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Going to find a barefoot brother out,",
          "plainText": "Going to find a barefoot brother out",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "One of our order, to associate me,",
          "plainText": "One of our order to associate me",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "Here in this city visiting the sick,",
          "plainText": "Here in this city visiting the sick",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "And finding him, the searchers of the town,",
          "plainText": "And finding him the searchers of the town",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 5,
          "text": "Suspecting that we both were in a house",
          "plainText": "Suspecting that we both were in a house",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 6,
          "text": "Where the infectious pestilence did reign,",
          "plainText": "Where the infectious pestilence did reign",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 7,
          "text": "Seal'd up the doors, and would not let us forth,",
          "plainText": "Seal'd up the doors and would not let us forth",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 8,
          "text": "So that my speed to Mantua there was stay'd.",
          "plainText": "So that my speed to Mantua there was stay'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Who bare my letter then to Romeo?",
          "plainText": "Who bare my letter then to Romeo",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "friar-john",
        "name": "FRIAR JOHN",
        "displayName": "Friar John"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "I could not send it,—here it is again,—",
          "plainText": "I could not send ithere it is again",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Nor get a messenger to bring it thee,",
          "plainText": "Nor get a messenger to bring it thee",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "So fearful were they of infection.",
          "plainText": "So fearful were they of infection",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-5-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Unhappy fortune! By my brotherhood,",
          "plainText": "Unhappy fortune By my brotherhood",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "The letter was not nice, but full of charge,",
          "plainText": "The letter was not nice but full of charge",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Of dear import, and the neglecting it",
          "plainText": "Of dear import and the neglecting it",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "May do much danger. Friar John, go hence,",
          "plainText": "May do much danger Friar John go hence",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Get me an iron crow and bring it straight",
          "plainText": "Get me an iron crow and bring it straight",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "Unto my cell.",
          "plainText": "Unto my cell",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-5-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "friar-john",
        "name": "FRIAR JOHN",
        "displayName": "Friar John"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-5-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Brother, I'll go and bring it thee.",
          "plainText": "Brother I'll go and bring it thee",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-5-2-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "romeo-and-juliet-5-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "friar-lawrence",
        "name": "FRIAR LAWRENCE",
        "displayName": "Friar Lawrence"
      },
      "lines": [
        {
          "id": "romeo-and-juliet-5-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Now must I to the monument alone.",
          "plainText": "Now must I to the monument alone",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "Within this three hours will fair Juliet wake.",
          "plainText": "Within this three hours will fair Juliet wake",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "She will beshrew me much that Romeo",
          "plainText": "She will beshrew me much that Romeo",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "Hath had no notice of these accidents;",
          "plainText": "Hath had no notice of these accidents",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0028",
          "number": 28,
          "speechLineNumber": 5,
          "text": "But I will write again to Mantua,",
          "plainText": "But I will write again to Mantua",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0029",
          "number": 29,
          "speechLineNumber": 6,
          "text": "And keep her at my cell till Romeo come.",
          "plainText": "And keep her at my cell till Romeo come",
          "lineType": "verse"
        },
        {
          "id": "romeo-and-juliet-5-2-line-0030",
          "number": 30,
          "speechLineNumber": 7,
          "text": "Poor living corse, clos'd in a dead man's tomb.",
          "plainText": "Poor living corse clos'd in a dead man's tomb",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "romeo-and-juliet-5-2-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}