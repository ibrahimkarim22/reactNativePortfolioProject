{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "the-first-part-of-henry-the-sixth",
    "title": "The First Part of Henry the Sixth",
    "author": "William Shakespeare",
    "genre": "History"
  },
  "source": {
    "name": "Project Gutenberg",
