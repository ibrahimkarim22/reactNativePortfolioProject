  },
  "scene": {
    "id": "the-first-part-of-henry-the-sixth-2-2",
    "act": 2,
    "scene": 2,
    "label": "Act 2, Scene 2",
    "title": "SCENE II. Orleans. Within the town.",
    "location": "Orleans. Within the town.",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-stage-001",
      "type": "stage",
      "text": "Enter Talbot, Bedford, Burgundy, a Captain and others."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "bedford",
        "name": "BEDFORD",
        "displayName": "Bedford"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The day begins to break, and night is fled,",
          "plainText": "The day begins to break and night is fled",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Whose pitchy mantle over-veil'd the earth.",
          "plainText": "Whose pitchy mantle overveil'd the earth",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Here sound retreat and cease our hot pursuit.",
          "plainText": "Here sound retreat and cease our hot pursuit",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-stage-002",
      "type": "stage",
      "text": "[Retreat sounded.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Bring forth the body of old Salisbury,",
          "plainText": "Bring forth the body of old Salisbury",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "And here advance it in the market-place,",
          "plainText": "And here advance it in the marketplace",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "The middle centre of this cursed town.",
          "plainText": "The middle centre of this cursed town",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-stage-003",
      "type": "stage",
      "text": "Dead March. Enter with the body of Salisbury."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-stage-004",
      "type": "stage",
      "text": "[Exit Funeral.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "bedford",
        "name": "BEDFORD",
        "displayName": "Bedford"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "'Tis thought, Lord Talbot, when the fight began,",
          "plainText": "'Tis thought Lord Talbot when the fight began",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Rous'd on the sudden from their drowsy beds,",
          "plainText": "Rous'd on the sudden from their drowsy beds",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "They did amongst the troops of armed men",
          "plainText": "They did amongst the troops of armed men",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "Leap o'er the walls for refuge in the field.",
          "plainText": "Leap o'er the walls for refuge in the field",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Myself, as far as I could well discern",
          "plainText": "Myself as far as I could well discern",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "For smoke and dusky vapors of the night,",
          "plainText": "For smoke and dusky vapors of the night",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Am sure I scared the Dauphin and his trull,",
          "plainText": "Am sure I scared the Dauphin and his trull",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "When arm in arm they both came swiftly running,",
          "plainText": "When arm in arm they both came swiftly running",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "Like to a pair of loving turtle-doves",
          "plainText": "Like to a pair of loving turtledoves",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0016",
          "number": 16,
          "speechLineNumber": 6,
          "text": "That could not live asunder day or night.",
          "plainText": "That could not live asunder day or night",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0017",
          "number": 17,
          "speechLineNumber": 7,
          "text": "After that things are set in order here,",
          "plainText": "After that things are set in order here",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0018",
          "number": 18,
          "speechLineNumber": 8,
          "text": "We'll follow them with all the power we have.",
          "plainText": "We'll follow them with all the power we have",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-stage-005",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "All hail, my lords! Which of this princely train",
          "plainText": "All hail my lords Which of this princely train",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Call ye the warlike Talbot, for his acts",
          "plainText": "Call ye the warlike Talbot for his acts",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "So much applauded through the realm of France?",
          "plainText": "So much applauded through the realm of France",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Here is the Talbot. Who would speak with him?",
          "plainText": "Here is the Talbot Who would speak with him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "The virtuous lady, Countess of Auvergne,",
          "plainText": "The virtuous lady Countess of Auvergne",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "With modesty admiring thy renown,",
          "plainText": "With modesty admiring thy renown",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "By me entreats, great lord, thou wouldst vouchsafe",
          "plainText": "By me entreats great lord thou wouldst vouchsafe",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "To visit her poor castle where she lies,",
          "plainText": "To visit her poor castle where she lies",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0027",
          "number": 27,
          "speechLineNumber": 5,
          "text": "That she may boast she hath beheld the man",
          "plainText": "That she may boast she hath beheld the man",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0028",
          "number": 28,
          "speechLineNumber": 6,
          "text": "Whose glory fills the world with loud report.",
          "plainText": "Whose glory fills the world with loud report",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Is it even so? Nay, then I see our wars",
          "plainText": "Is it even so Nay then I see our wars",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "Will turn unto a peaceful comic sport,",
          "plainText": "Will turn unto a peaceful comic sport",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "When ladies crave to be encounter'd with.",
          "plainText": "When ladies crave to be encounter'd with",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "You may not, my lord, despise her gentle suit.",
          "plainText": "You may not my lord despise her gentle suit",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Ne'er trust me then; for when a world of men",
          "plainText": "Ne'er trust me then for when a world of men",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Could not prevail with all their oratory,",
          "plainText": "Could not prevail with all their oratory",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Yet hath a woman's kindness over-ruled.",
          "plainText": "Yet hath a woman's kindness overruled",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "And therefore tell her I return great thanks,",
          "plainText": "And therefore tell her I return great thanks",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0037",
          "number": 37,
          "speechLineNumber": 5,
          "text": "And in submission will attend on her.",
          "plainText": "And in submission will attend on her",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0038",
          "number": 38,
          "speechLineNumber": 6,
          "text": "Will not your honours bear me company?",
          "plainText": "Will not your honours bear me company",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "bedford",
        "name": "BEDFORD",
        "displayName": "Bedford"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "No, truly, it is more than manners will;",
          "plainText": "No truly it is more than manners will",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "And I have heard it said, unbidden guests",
          "plainText": "And I have heard it said unbidden guests",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "Are often welcomest when they are gone.",
          "plainText": "Are often welcomest when they are gone",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "talbot",
        "name": "TALBOT",
        "displayName": "Talbot"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Well then, alone, since there's no remedy,",
          "plainText": "Well then alone since there's no remedy",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "I mean to prove this lady's courtesy.",
          "plainText": "I mean to prove this lady's courtesy",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "Come hither, Captain. [Whispers.] You perceive my mind?",
          "plainText": "Come hither Captain Whispers You perceive my mind",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "captain",
        "name": "CAPTAIN",
        "displayName": "Captain"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-2-2-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "I do, my lord, and mean accordingly.",
          "plainText": "I do my lord and mean accordingly",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-2-2-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}