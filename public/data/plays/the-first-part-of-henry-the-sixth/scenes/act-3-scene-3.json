  "scene": {
    "id": "the-first-part-of-henry-the-sixth-3-3",
    "act": 3,
    "scene": 3,
    "label": "Act 3, Scene 3",
    "title": "SCENE III. The plains near Rouen.",
    "location": "The plains near Rouen.",
    "orderInPlay": 14
  },
  "content": [
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-stage-001",
      "type": "stage",
      "text": "Enter Charles, the Bastard of Orleans, Alençon, La Pucelle and forces."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Dismay not, princes, at this accident,",
          "plainText": "Dismay not princes at this accident",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Nor grieve that Rouen is so recovered.",
          "plainText": "Nor grieve that Rouen is so recovered",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Care is no cure, but rather corrosive,",
          "plainText": "Care is no cure but rather corrosive",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "For things that are not to be remedied.",
          "plainText": "For things that are not to be remedied",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Let frantic Talbot triumph for a while",
          "plainText": "Let frantic Talbot triumph for a while",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "And like a peacock sweep along his tail;",
          "plainText": "And like a peacock sweep along his tail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "We'll pull his plumes and take away his train,",
          "plainText": "We'll pull his plumes and take away his train",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "If Dauphin and the rest will be but ruled.",
          "plainText": "If Dauphin and the rest will be but ruled",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "We have been guided by thee hitherto,",
          "plainText": "We have been guided by thee hitherto",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "And of thy cunning had no diffidence.",
          "plainText": "And of thy cunning had no diffidence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "One sudden foil shall never breed distrust",
          "plainText": "One sudden foil shall never breed distrust",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Search out thy wit for secret policies,",
          "plainText": "Search out thy wit for secret policies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "And we will make thee famous through the world.",
          "plainText": "And we will make thee famous through the world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Then thus it must be; this doth Joan devise:",
          "plainText": "Then thus it must be this doth Joan devise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "By fair persuasions mix'd with sugar'd words",
          "plainText": "By fair persuasions mix'd with sugar'd words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "We will entice the Duke of Burgundy",
          "plainText": "We will entice the Duke of Burgundy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "To leave the Talbot and to follow us.",
          "plainText": "To leave the Talbot and to follow us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Ay, marry, sweeting, if we could do that,",
          "plainText": "Ay marry sweeting if we could do that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "France were no place for Henry's warriors;",
          "plainText": "France were no place for Henry's warriors",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "Nor should that nation boast it so with us,",
          "plainText": "Nor should that nation boast it so with us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "But be extirped from our provinces.",
          "plainText": "But be extirped from our provinces",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Your honours shall perceive how I will work",
          "plainText": "Your honours shall perceive how I will work",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "To bring this matter to the wished end.",
          "plainText": "To bring this matter to the wished end",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-stage-002",
      "type": "stage",
      "text": "[Drum sounds afar off.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-stage-003",
      "type": "stage",
      "text": "[Here sound an English march.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-stage-004",
      "type": "stage",
      "text": "[French march.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-stage-005",
      "type": "stage",
      "text": "[Trumpets sound a parley.]"
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "A parley with the Duke of Burgundy!",
          "plainText": "A parley with the Duke of Burgundy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-stage-006",
      "type": "stage",
      "text": "Enter Burgundy."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Who craves a parley with the Burgundy?",
          "plainText": "Who craves a parley with the Burgundy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "The princely Charles of France, thy countryman.",
          "plainText": "The princely Charles of France thy countryman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "What say'st thou, Charles? for I am marching hence.",
          "plainText": "What say'st thou Charles for I am marching hence",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Speak, Pucelle, and enchant him with thy words.",
          "plainText": "Speak Pucelle and enchant him with thy words",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Brave Burgundy, undoubted hope of France,",
          "plainText": "Brave Burgundy undoubted hope of France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "Stay, let thy humble handmaid speak to thee.",
          "plainText": "Stay let thy humble handmaid speak to thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Speak on, but be not over-tedious.",
          "plainText": "Speak on but be not overtedious",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Look on thy country, look on fertile France,",
          "plainText": "Look on thy country look on fertile France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "And see the cities and the towns defaced",
          "plainText": "And see the cities and the towns defaced",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "By wasting ruin of the cruel foe.",
          "plainText": "By wasting ruin of the cruel foe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "As looks the mother on her lowly babe",
          "plainText": "As looks the mother on her lowly babe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "When death doth close his tender dying eyes,",
          "plainText": "When death doth close his tender dying eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "See, see the pining malady of France;",
          "plainText": "See see the pining malady of France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "Behold the wounds, the most unnatural wounds,",
          "plainText": "Behold the wounds the most unnatural wounds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0039",
          "number": 39,
          "speechLineNumber": 8,
          "text": "Which thou thyself hast given her woeful breast.",
          "plainText": "Which thou thyself hast given her woeful breast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0040",
          "number": 40,
          "speechLineNumber": 9,
          "text": "O, turn thy edged sword another way;",
          "plainText": "O turn thy edged sword another way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0041",
          "number": 41,
          "speechLineNumber": 10,
          "text": "Strike those that hurt, and hurt not those that help.",
          "plainText": "Strike those that hurt and hurt not those that help",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0042",
          "number": 42,
          "speechLineNumber": 11,
          "text": "One drop of blood drawn from thy country's bosom",
          "plainText": "One drop of blood drawn from thy country's bosom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0043",
          "number": 43,
          "speechLineNumber": 12,
          "text": "Should grieve thee more than streams of foreign gore.",
          "plainText": "Should grieve thee more than streams of foreign gore",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0044",
          "number": 44,
          "speechLineNumber": 13,
          "text": "Return thee therefore with a flood of tears,",
          "plainText": "Return thee therefore with a flood of tears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0045",
          "number": 45,
          "speechLineNumber": 14,
          "text": "And wash away thy country's stained spots.",
          "plainText": "And wash away thy country's stained spots",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Either she hath bewitch'd me with her words,",
          "plainText": "Either she hath bewitch'd me with her words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Or nature makes me suddenly relent.",
          "plainText": "Or nature makes me suddenly relent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Besides, all French and France exclaims on thee,",
          "plainText": "Besides all French and France exclaims on thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "Doubting thy birth and lawful progeny.",
          "plainText": "Doubting thy birth and lawful progeny",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "Who join'st thou with but with a lordly nation",
          "plainText": "Who join'st thou with but with a lordly nation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "That will not trust thee but for profit's sake?",
          "plainText": "That will not trust thee but for profit's sake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0052",
          "number": 52,
          "speechLineNumber": 5,
          "text": "When Talbot hath set footing once in France,",
          "plainText": "When Talbot hath set footing once in France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0053",
          "number": 53,
          "speechLineNumber": 6,
          "text": "And fashion'd thee that instrument of ill,",
          "plainText": "And fashion'd thee that instrument of ill",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0054",
          "number": 54,
          "speechLineNumber": 7,
          "text": "Who then but English Henry will be lord,",
          "plainText": "Who then but English Henry will be lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0055",
          "number": 55,
          "speechLineNumber": 8,
          "text": "And thou be thrust out like a fugitive?",
          "plainText": "And thou be thrust out like a fugitive",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0056",
          "number": 56,
          "speechLineNumber": 9,
          "text": "Call we to mind, and mark but this for proof:",
          "plainText": "Call we to mind and mark but this for proof",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0057",
          "number": 57,
          "speechLineNumber": 10,
          "text": "Was not the Duke of Orleans thy foe?",
          "plainText": "Was not the Duke of Orleans thy foe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0058",
          "number": 58,
          "speechLineNumber": 11,
          "text": "And was he not in England prisoner?",
          "plainText": "And was he not in England prisoner",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0059",
          "number": 59,
          "speechLineNumber": 12,
          "text": "But when they heard he was thine enemy,",
          "plainText": "But when they heard he was thine enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0060",
          "number": 60,
          "speechLineNumber": 13,
          "text": "They set him free without his ransom paid,",
          "plainText": "They set him free without his ransom paid",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0061",
          "number": 61,
          "speechLineNumber": 14,
          "text": "In spite of Burgundy and all his friends.",
          "plainText": "In spite of Burgundy and all his friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0062",
          "number": 62,
          "speechLineNumber": 15,
          "text": "See then, thou fight'st against thy countrymen,",
          "plainText": "See then thou fight'st against thy countrymen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0063",
          "number": 63,
          "speechLineNumber": 16,
          "text": "And join'st with them will be thy slaughtermen.",
          "plainText": "And join'st with them will be thy slaughtermen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0064",
          "number": 64,
          "speechLineNumber": 17,
          "text": "Come, come, return; return, thou wandering lord;",
          "plainText": "Come come return return thou wandering lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0065",
          "number": 65,
          "speechLineNumber": 18,
          "text": "Charles and the rest will take thee in their arms.",
          "plainText": "Charles and the rest will take thee in their arms",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "I am vanquished; these haughty words of hers",
          "plainText": "I am vanquished these haughty words of hers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "Have batter'd me like roaring cannon-shot,",
          "plainText": "Have batter'd me like roaring cannonshot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0068",
          "number": 68,
          "speechLineNumber": 3,
          "text": "And made me almost yield upon my knees.",
          "plainText": "And made me almost yield upon my knees",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0069",
          "number": 69,
          "speechLineNumber": 4,
          "text": "Forgive me, country, and sweet countrymen!",
          "plainText": "Forgive me country and sweet countrymen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0070",
          "number": 70,
          "speechLineNumber": 5,
          "text": "And, lords, accept this hearty kind embrace.",
          "plainText": "And lords accept this hearty kind embrace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0071",
          "number": 71,
          "speechLineNumber": 6,
          "text": "My forces and my power of men are yours.",
          "plainText": "My forces and my power of men are yours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0072",
          "number": 72,
          "speechLineNumber": 7,
          "text": "So, farewell, Talbot; I'll no longer trust thee.",
          "plainText": "So farewell Talbot I'll no longer trust thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "[Aside.] Done like a Frenchman: turn and turn again.",
          "plainText": "Aside Done like a Frenchman turn and turn again",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Welcome, brave Duke! Thy friendship makes us fresh.",
          "plainText": "Welcome brave Duke Thy friendship makes us fresh",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "bastard",
        "name": "BASTARD",
        "displayName": "Bastard"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "And doth beget new courage in our breasts.",
          "plainText": "And doth beget new courage in our breasts",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Now let us on, my lords, and join our powers,",
          "plainText": "Now let us on my lords and join our powers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-3-3-line-0077",
          "number": 77,
          "speechLineNumber": 2,
          "text": "And seek how we may prejudice the foe.",
          "plainText": "And seek how we may prejudice the foe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-3-3-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}