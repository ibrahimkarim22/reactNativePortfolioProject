  "scene": {
    "id": "the-first-part-of-henry-the-sixth-5-2",
    "act": 5,
    "scene": 2,
    "label": "Act 5, Scene 2",
    "title": "SCENE II. France. Plains in Anjou.",
    "location": "France. Plains in Anjou.",
    "orderInPlay": 24
  },
  "content": [
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-stage-001",
      "type": "stage",
      "text": "Enter Charles, Burgundy, Alençon, Bastard, Reignier, La Pucelle and forces."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "These news, my lords, may cheer our drooping spirits:",
          "plainText": "These news my lords may cheer our drooping spirits",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "'Tis said the stout Parisians do revolt",
          "plainText": "'Tis said the stout Parisians do revolt",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And turn again unto the warlike French.",
          "plainText": "And turn again unto the warlike French",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Peace be amongst them, if they turn to us;",
          "plainText": "Peace be amongst them if they turn to us",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Else ruin combat with their palaces!",
          "plainText": "Else ruin combat with their palaces",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-stage-002",
      "type": "stage",
      "text": "Enter Scout."
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "scout",
        "name": "SCOUT",
        "displayName": "Scout"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Success unto our valiant general,",
          "plainText": "Success unto our valiant general",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "And happiness to his accomplices!",
          "plainText": "And happiness to his accomplices",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "What tidings send our scouts? I prithee, speak.",
          "plainText": "What tidings send our scouts I prithee speak",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "scout",
        "name": "SCOUT",
        "displayName": "Scout"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "The English army, that divided was",
          "plainText": "The English army that divided was",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Into two parties, is now conjoin'd in one,",
          "plainText": "Into two parties is now conjoin'd in one",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "And means to give you battle presently.",
          "plainText": "And means to give you battle presently",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Somewhat too sudden, sirs, the warning is;",
          "plainText": "Somewhat too sudden sirs the warning is",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "But we will presently provide for them.",
          "plainText": "But we will presently provide for them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "burgundy",
        "name": "BURGUNDY",
        "displayName": "Burgundy"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "I trust the ghost of Talbot is not there.",
          "plainText": "I trust the ghost of Talbot is not there",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Now he is gone, my lord, you need not fear.",
          "plainText": "Now he is gone my lord you need not fear",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "pucelle",
        "name": "PUCELLE",
        "displayName": "Pucelle"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Of all base passions, fear is most accursed.",
          "plainText": "Of all base passions fear is most accursed",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Command the conquest, Charles, it shall be thine;",
          "plainText": "Command the conquest Charles it shall be thine",
          "lineType": "verse"
        },
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Let Henry fret and all the world repine.",
          "plainText": "Let Henry fret and all the world repine",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "charles",
        "name": "CHARLES",
        "displayName": "Charles"
      },
      "lines": [
        {
          "id": "the-first-part-of-henry-the-sixth-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Then on, my lords; and France be fortunate!",
          "plainText": "Then on my lords and France be fortunate",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-first-part-of-henry-the-sixth-5-2-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}