  "content": [
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-001",
      "type": "stage",
      "text": "Enter Prince Henry and Poins; Bardolph and Peto at some distance."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "poins",
        "name": "POINS",
        "displayName": "Poins"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Come, shelter, shelter! I have removed Falstaff's horse, and he frets like a gummed velvet.",
          "plainText": "Come shelter shelter I have removed Falstaff's horse and he frets like a gummed velvet",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Stand close.",
          "plainText": "Stand close",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-002",
      "type": "stage",
      "text": "[They retire.]"
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-003",
      "type": "stage",
      "text": "Enter Falstaff."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Poins! Poins, and be hanged! Poins!",
          "plainText": "Poins Poins and be hanged Poins",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "[Coming forward.]",
          "plainText": "Coming forward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Peace, ye fat-kidneyed rascal! What a brawling dost thou keep!",
          "plainText": "Peace ye fatkidneyed rascal What a brawling dost thou keep",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Where's Poins, Hal?",
          "plainText": "Where's Poins Hal",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "He is walked up to the top of the hill. I'll go seek him.",
          "plainText": "He is walked up to the top of the hill I'll go seek him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-004",
      "type": "stage",
      "text": "[Retires.]"
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I am accursed to rob in that thief's company. The rascal hath removed my horse and tied him I know not where. If I travel but four foot by the square further afoot, I shall break my wind. Well, I doubt not but to die a fair death for all this, if I 'scape hanging for killing that rogue. I have forsworn his company hourly any time this two-and-twenty years, and yet I am bewitched with the rogue's company. If the rascal have not given me medicines to make me love him, I'll be hanged. It could not be else: I have drunk medicines. Poins! Hal! A plague upon you both! Bardolph! Peto! I'll starve ere I'll rob a foot further. An 'twere not as good a deed as drink, to turn true man, and to leave these rogues, I am the veriest varlet that ever chewed with a tooth. Eight yards of uneven ground is threescore and ten miles afoot with me, and the stony-hearted villains know it well enough. A plague upon it when thieves cannot be true one to another! [They whistle.] Whew! A plague upon you all! Give me my horse, you rogues, give me my horse and be hanged!",
          "plainText": "I am accursed to rob in that thief's company The rascal hath removed my horse and tied him I know not where If I travel but four foot by the square further afoot I shall break my wind Well I doubt not but to die a fair death for all this if I 'scape hanging for killing that rogue I have forsworn his company hourly any time this twoandtwenty years and yet I am bewitched with the rogue's company If the rascal have not given me medicines to make me love him I'll be hanged It could not be else I have drunk medicines Poins Hal A plague upon you both Bardolph Peto I'll starve ere I'll rob a foot further An 'twere not as good a deed as drink to turn true man and to leave these rogues I am the veriest varlet that ever chewed with a tooth Eight yards of uneven ground is threescore and ten miles afoot with me and the stonyhearted villains know it well enough A plague upon it when thieves cannot be true one to another They whistle Whew A plague upon you all Give me my horse you rogues give me my horse and be hanged",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "[Coming forward.] Peace, you fat guts, lie down, lay thine ear close to the ground, and list if thou canst hear the tread of travellers.",
          "plainText": "Coming forward Peace you fat guts lie down lay thine ear close to the ground and list if thou canst hear the tread of travellers",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Have you any levers to lift me up again, being down? 'Sblood, I'll not bear my own flesh so far afoot again for all the coin in thy father's exchequer. What a plague mean ye to colt me thus?",
          "plainText": "Have you any levers to lift me up again being down 'Sblood I'll not bear my own flesh so far afoot again for all the coin in thy father's exchequer What a plague mean ye to colt me thus",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Thou liest, thou art not colted, thou art uncolted.",
          "plainText": "Thou liest thou art not colted thou art uncolted",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "I prithee, good Prince Hal, help me to my horse, good king's son.",
          "plainText": "I prithee good Prince Hal help me to my horse good king's son",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Out, ye rogue! Shall I be your ostler?",
          "plainText": "Out ye rogue Shall I be your ostler",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Hang thyself in thine own heir-apparent garters! If I be ta'en, I'll peach for this. An I have not ballads made on you all, and sung to filthy tunes, let a cup of sack be my poison—when a jest is so forward, and afoot too! I hate it.",
          "plainText": "Hang thyself in thine own heirapparent garters If I be ta'en I'll peach for this An I have not ballads made on you all and sung to filthy tunes let a cup of sack be my poisonwhen a jest is so forward and afoot too I hate it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-005",
      "type": "stage",
      "text": "Enter Gadshill."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "gadshill",
        "name": "GADSHILL",
        "displayName": "Gadshill"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Stand!",
          "plainText": "Stand",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "So I do, against my will.",
          "plainText": "So I do against my will",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "poins",
        "name": "POINS",
        "displayName": "Poins"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "O, 'tis our setter. I know his voice.",
          "plainText": "O 'tis our setter I know his voice",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-006",
      "type": "stage",
      "text": "Comes forward with Bardolph and Peto."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "What news?",
          "plainText": "What news",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "gadshill",
        "name": "GADSHILL",
        "displayName": "Gadshill"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Case ye, case ye, on with your visards. There's money of the King's coming down the hill, 'tis going to the King's exchequer.",
          "plainText": "Case ye case ye on with your visards There's money of the King's coming down the hill 'tis going to the King's exchequer",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "You lie, ye rogue, 'tis going to the King's tavern.",
          "plainText": "You lie ye rogue 'tis going to the King's tavern",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "gadshill",
        "name": "GADSHILL",
        "displayName": "Gadshill"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "There's enough to make us all.",
          "plainText": "There's enough to make us all",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "To be hanged.",
          "plainText": "To be hanged",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Sirs, you four shall front them in the narrow lane. Ned Poins and I will walk lower; if they 'scape from your encounter, then they light on us.",
          "plainText": "Sirs you four shall front them in the narrow lane Ned Poins and I will walk lower if they 'scape from your encounter then they light on us",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "peto",
        "name": "PETO",
        "displayName": "Peto"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "How many be there of them?",
          "plainText": "How many be there of them",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "gadshill",
        "name": "GADSHILL",
        "displayName": "Gadshill"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Some eight or ten.",
          "plainText": "Some eight or ten",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Zounds, will they not rob us?",
          "plainText": "Zounds will they not rob us",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "What, a coward, Sir John Paunch?",
          "plainText": "What a coward Sir John Paunch",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Indeed, I am not John of Gaunt, your grandfather, but yet no coward, Hal.",
          "plainText": "Indeed I am not John of Gaunt your grandfather but yet no coward Hal",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Well, we leave that to the proof.",
          "plainText": "Well we leave that to the proof",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "poins",
        "name": "POINS",
        "displayName": "Poins"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Sirrah Jack, thy horse stands behind the hedge. When thou need'st him, there thou shalt find him. Farewell, and stand fast.",
          "plainText": "Sirrah Jack thy horse stands behind the hedge When thou need'st him there thou shalt find him Farewell and stand fast",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Now cannot I strike him, if I should be hanged.",
          "plainText": "Now cannot I strike him if I should be hanged",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "[aside to Poins.] Ned, where are our disguises?",
          "plainText": "aside to Poins Ned where are our disguises",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "poins",
        "name": "POINS",
        "displayName": "Poins"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "[aside to Prince Henry.] Here, hard by. Stand close.",
          "plainText": "aside to Prince Henry Here hard by Stand close",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-007",
      "type": "stage",
      "text": "[Exeunt Prince and Poins.]"
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-033",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Now, my masters, happy man be his dole, say I. Every man to his business.",
          "plainText": "Now my masters happy man be his dole say I Every man to his business",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-008",
      "type": "stage",
      "text": "Enter the Travellers."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-034",
      "type": "speech",
      "speaker": {
        "id": "first-traveller",
        "name": "FIRST TRAVELLER",
        "displayName": "First Traveller"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Come, neighbour, the boy shall lead our horses down the hill; we'll walk afoot awhile and ease our legs.",
          "plainText": "Come neighbour the boy shall lead our horses down the hill we'll walk afoot awhile and ease our legs",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-035",
      "type": "speech",
      "speaker": {
        "id": "thieves",
        "name": "THIEVES",
        "displayName": "Thieves"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Stand!",
          "plainText": "Stand",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-036",
      "type": "speech",
      "speaker": {
        "id": "second-traveller",
        "name": "SECOND TRAVELLER",
        "displayName": "Second Traveller"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Jesu bless us!",
          "plainText": "Jesu bless us",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-037",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Strike, down with them, cut the villains' throats! Ah, whoreson caterpillars, bacon-fed knaves, they hate us youth. Down with them, fleece them!",
          "plainText": "Strike down with them cut the villains' throats Ah whoreson caterpillars baconfed knaves they hate us youth Down with them fleece them",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-038",
      "type": "speech",
      "speaker": {
        "id": "first-traveller",
        "name": "FIRST TRAVELLER",
        "displayName": "First Traveller"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "O, we are undone, both we and ours for ever!",
          "plainText": "O we are undone both we and ours for ever",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-039",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Hang ye, gorbellied knaves, are ye undone? No, ye fat chuffs, I would your store were here! On, bacons, on! What, ye knaves! young men must live. You are grandjurors, are ye? We'll jure ye, faith.",
          "plainText": "Hang ye gorbellied knaves are ye undone No ye fat chuffs I would your store were here On bacons on What ye knaves young men must live You are grandjurors are ye We'll jure ye faith",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-009",
      "type": "stage",
      "text": "[Here they rob them and bind them. Exeunt]"
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-010",
      "type": "stage",
      "text": "Enter Prince Henry and Poins in buckram suits."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-040",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "The thieves have bound the true men. Now could thou and I rob the thieves, and go merrily to London, it would be argument for a week, laughter for a month, and a good jest for ever.",
          "plainText": "The thieves have bound the true men Now could thou and I rob the thieves and go merrily to London it would be argument for a week laughter for a month and a good jest for ever",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-041",
      "type": "speech",
      "speaker": {
        "id": "poins",
        "name": "POINS",
        "displayName": "Poins"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Stand close, I hear them coming.",
          "plainText": "Stand close I hear them coming",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-011",
      "type": "stage",
      "text": "[They retire.]"
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-012",
      "type": "stage",
      "text": "Enter the Thieves again."
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-042",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Come, my masters, let us share, and then to horse before day. An the Prince and Poins be not two arrant cowards, there's no equity stirring. There's no more valour in that Poins than in a wild duck.",
          "plainText": "Come my masters let us share and then to horse before day An the Prince and Poins be not two arrant cowards there's no equity stirring There's no more valour in that Poins than in a wild duck",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-013",
      "type": "stage",
      "text": "[As they are sharing, the Prince and Poins set upon them.]"
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-043",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Your money!",
          "plainText": "Your money",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-044",
      "type": "speech",
      "speaker": {
        "id": "poins",
        "name": "POINS",
        "displayName": "Poins"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Villains!",
          "plainText": "Villains",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-014",
      "type": "stage",
      "text": "[Falstaff after a blow or two, and the others run away, leaving the booty behind them.]"
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-045",
      "type": "speech",
      "speaker": {
        "id": "prince",
        "name": "PRINCE",
        "displayName": "Prince"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Got with much ease. Now merrily to horse.",
          "plainText": "Got with much ease Now merrily to horse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "The thieves are all scatter'd, and possess'd with fear",
          "plainText": "The thieves are all scatter'd and possess'd with fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "So strongly that they dare not meet each other;",
          "plainText": "So strongly that they dare not meet each other",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "Each takes his fellow for an officer.",
          "plainText": "Each takes his fellow for an officer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0050",
          "number": 50,
          "speechLineNumber": 5,
          "text": "Away, good Ned. Falstaff sweats to death,",
          "plainText": "Away good Ned Falstaff sweats to death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0051",
          "number": 51,
          "speechLineNumber": 6,
          "text": "And lards the lean earth as he walks along.",
          "plainText": "And lards the lean earth as he walks along",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0052",
          "number": 52,
          "speechLineNumber": 7,
          "text": "Were't not for laughing, I should pity him.",
          "plainText": "Were't not for laughing I should pity him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-speech-046",
      "type": "speech",
      "speaker": {
        "id": "poins",
        "name": "POINS",
        "displayName": "Poins"
      },
      "lines": [
        {
          "id": "the-first-part-of-king-henry-the-fourth-2-2-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "How the fat rogue roared!",
          "plainText": "How the fat rogue roared",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-first-part-of-king-henry-the-fourth-2-2-stage-015",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}