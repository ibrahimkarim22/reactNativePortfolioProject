  "scene": {
    "id": "the-merchant-of-venice-2-4",
    "act": 2,
    "scene": 4,
    "label": "Act 2, Scene 4",
    "title": "SCENE IV. The same. A street.",
    "location": "The same. A street.",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "the-merchant-of-venice-2-4-stage-001",
      "type": "stage",
      "text": "Enter Gratiano, Lorenzo, Salarino and Solanio."
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Nay, we will slink away in supper-time,",
          "plainText": "Nay we will slink away in suppertime",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Disguise us at my lodging, and return",
          "plainText": "Disguise us at my lodging and return",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "All in an hour.",
          "plainText": "All in an hour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "We have not made good preparation.",
          "plainText": "We have not made good preparation",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "We have not spoke us yet of torch-bearers.",
          "plainText": "We have not spoke us yet of torchbearers",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "solanio",
        "name": "SOLANIO",
        "displayName": "Solanio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "'Tis vile, unless it may be quaintly order'd,",
          "plainText": "'Tis vile unless it may be quaintly order'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "And better in my mind not undertook.",
          "plainText": "And better in my mind not undertook",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "'Tis now but four o'clock, we have two hours",
          "plainText": "'Tis now but four o'clock we have two hours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "To furnish us.",
          "plainText": "To furnish us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-stage-002",
      "type": "stage",
      "text": "Enter Launcelet with a letter."
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "launcelet",
        "name": "LAUNCELET",
        "displayName": "Launcelet"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "And it shall please you to break up this, it shall seem to signify.",
          "plainText": "And it shall please you to break up this it shall seem to signify",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "I know the hand, in faith 'tis a fair hand,",
          "plainText": "I know the hand in faith 'tis a fair hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "And whiter than the paper it writ on",
          "plainText": "And whiter than the paper it writ on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Is the fair hand that writ.",
          "plainText": "Is the fair hand that writ",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Love news, in faith.",
          "plainText": "Love news in faith",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "launcelet",
        "name": "LAUNCELET",
        "displayName": "Launcelet"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "By your leave, sir.",
          "plainText": "By your leave sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Whither goest thou?",
          "plainText": "Whither goest thou",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "launcelet",
        "name": "LAUNCELET",
        "displayName": "Launcelet"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Marry, sir, to bid my old master the Jew to sup tonight with my new master the Christian.",
          "plainText": "Marry sir to bid my old master the Jew to sup tonight with my new master the Christian",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Hold here, take this. Tell gentle Jessica",
          "plainText": "Hold here take this Tell gentle Jessica",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "I will not fail her, speak it privately.",
          "plainText": "I will not fail her speak it privately",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "Go, gentlemen,",
          "plainText": "Go gentlemen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-stage-003",
      "type": "stage",
      "text": "[Exit Launcelet.]"
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Ay, marry, I'll be gone about it straight.",
          "plainText": "Ay marry I'll be gone about it straight",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "solanio",
        "name": "SOLANIO",
        "displayName": "Solanio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "And so will I.",
          "plainText": "And so will I",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Meet me and Gratiano",
          "plainText": "Meet me and Gratiano",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "At Gratiano's lodging some hour hence.",
          "plainText": "At Gratiano's lodging some hour hence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "'Tis good we do so.",
          "plainText": "'Tis good we do so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-stage-004",
      "type": "stage",
      "text": "[Exeunt Salarino and Solanio.]"
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Was not that letter from fair Jessica?",
          "plainText": "Was not that letter from fair Jessica",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-4-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "I must needs tell thee all. She hath directed",
          "plainText": "I must needs tell thee all She hath directed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "How I shall take her from her father's house,",
          "plainText": "How I shall take her from her father's house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "What gold and jewels she is furnish'd with,",
          "plainText": "What gold and jewels she is furnish'd with",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "What page's suit she hath in readiness.",
          "plainText": "What page's suit she hath in readiness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "If e'er the Jew her father come to heaven,",
          "plainText": "If e'er the Jew her father come to heaven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0032",
          "number": 32,
          "speechLineNumber": 6,
          "text": "It will be for his gentle daughter's sake;",
          "plainText": "It will be for his gentle daughter's sake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0033",
          "number": 33,
          "speechLineNumber": 7,
          "text": "And never dare misfortune cross her foot,",
          "plainText": "And never dare misfortune cross her foot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0034",
          "number": 34,
          "speechLineNumber": 8,
          "text": "Unless she do it under this excuse,",
          "plainText": "Unless she do it under this excuse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0035",
          "number": 35,
          "speechLineNumber": 9,
          "text": "That she is issue to a faithless Jew.",
          "plainText": "That she is issue to a faithless Jew",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0036",
          "number": 36,
          "speechLineNumber": 10,
          "text": "Come, go with me, peruse this as thou goest;",
          "plainText": "Come go with me peruse this as thou goest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-4-line-0037",
          "number": 37,
          "speechLineNumber": 11,
          "text": "Fair Jessica shall be my torch-bearer.",
          "plainText": "Fair Jessica shall be my torchbearer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-4-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}