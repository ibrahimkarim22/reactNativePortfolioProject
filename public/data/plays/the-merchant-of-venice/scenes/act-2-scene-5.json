  },
  "content": [
    {
      "id": "the-merchant-of-venice-2-5-stage-001",
      "type": "stage",
      "text": "Enter Shylock the Jew and Launcelet his man that was the clown."
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "shylock",
        "name": "SHYLOCK",
        "displayName": "Shylock"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Well, thou shalt see, thy eyes shall be thy judge,",
          "plainText": "Well thou shalt see thy eyes shall be thy judge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The difference of old Shylock and Bassanio.—",
          "plainText": "The difference of old Shylock and Bassanio",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "What, Jessica!—Thou shalt not gormandize",
          "plainText": "What JessicaThou shalt not gormandize",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "As thou hast done with me;—What, Jessica!—",
          "plainText": "As thou hast done with meWhat Jessica",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "And sleep, and snore, and rend apparel out.",
          "plainText": "And sleep and snore and rend apparel out",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Why, Jessica, I say!",
          "plainText": "Why Jessica I say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "launcelet",
        "name": "LAUNCELET",
        "displayName": "Launcelet"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Why, Jessica!",
          "plainText": "Why Jessica",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "shylock",
        "name": "SHYLOCK",
        "displayName": "Shylock"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Who bids thee call? I do not bid thee call.",
          "plainText": "Who bids thee call I do not bid thee call",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "launcelet",
        "name": "LAUNCELET",
        "displayName": "Launcelet"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Your worship was wont to tell me I could do nothing without bidding.",
          "plainText": "Your worship was wont to tell me I could do nothing without bidding",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-stage-002",
      "type": "stage",
      "text": "Enter Jessica."
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "jessica",
        "name": "JESSICA",
        "displayName": "Jessica"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Call you? What is your will?",
          "plainText": "Call you What is your will",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "shylock",
        "name": "SHYLOCK",
        "displayName": "Shylock"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "I am bid forth to supper, Jessica.",
          "plainText": "I am bid forth to supper Jessica",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "There are my keys. But wherefore should I go?",
          "plainText": "There are my keys But wherefore should I go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "I am not bid for love, they flatter me.",
          "plainText": "I am not bid for love they flatter me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "But yet I'll go in hate, to feed upon",
          "plainText": "But yet I'll go in hate to feed upon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0015",
          "number": 15,
          "speechLineNumber": 5,
          "text": "The prodigal Christian. Jessica, my girl,",
          "plainText": "The prodigal Christian Jessica my girl",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0016",
          "number": 16,
          "speechLineNumber": 6,
          "text": "Look to my house. I am right loath to go;",
          "plainText": "Look to my house I am right loath to go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0017",
          "number": 17,
          "speechLineNumber": 7,
          "text": "There is some ill a-brewing towards my rest,",
          "plainText": "There is some ill abrewing towards my rest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0018",
          "number": 18,
          "speechLineNumber": 8,
          "text": "For I did dream of money-bags tonight.",
          "plainText": "For I did dream of moneybags tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "launcelet",
        "name": "LAUNCELET",
        "displayName": "Launcelet"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I beseech you, sir, go. My young master doth expect your reproach.",
          "plainText": "I beseech you sir go My young master doth expect your reproach",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "shylock",
        "name": "SHYLOCK",
        "displayName": "Shylock"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "So do I his.",
          "plainText": "So do I his",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "launcelet",
        "name": "LAUNCELET",
        "displayName": "Launcelet"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "And they have conspired together. I will not say you shall see a masque, but if you do, then it was not for nothing that my nose fell a-bleeding on Black Monday last at six o'clock i' th' morning, falling out that year on Ash-Wednesday was four year in th' afternoon.",
          "plainText": "And they have conspired together I will not say you shall see a masque but if you do then it was not for nothing that my nose fell ableeding on Black Monday last at six o'clock i' th' morning falling out that year on AshWednesday was four year in th' afternoon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "shylock",
        "name": "SHYLOCK",
        "displayName": "Shylock"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "What, are there masques? Hear you me, Jessica,",
          "plainText": "What are there masques Hear you me Jessica",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Lock up my doors, and when you hear the drum",
          "plainText": "Lock up my doors and when you hear the drum",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "And the vile squealing of the wry-neck'd fife,",
          "plainText": "And the vile squealing of the wryneck'd fife",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Clamber not you up to the casements then,",
          "plainText": "Clamber not you up to the casements then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "Nor thrust your head into the public street",
          "plainText": "Nor thrust your head into the public street",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0027",
          "number": 27,
          "speechLineNumber": 6,
          "text": "To gaze on Christian fools with varnish'd faces,",
          "plainText": "To gaze on Christian fools with varnish'd faces",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0028",
          "number": 28,
          "speechLineNumber": 7,
          "text": "But stop my house's ears, I mean my casements.",
          "plainText": "But stop my house's ears I mean my casements",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0029",
          "number": 29,
          "speechLineNumber": 8,
          "text": "Let not the sound of shallow fopp'ry enter",
          "plainText": "Let not the sound of shallow fopp'ry enter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0030",
          "number": 30,
          "speechLineNumber": 9,
          "text": "My sober house. By Jacob's staff I swear",
          "plainText": "My sober house By Jacob's staff I swear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0031",
          "number": 31,
          "speechLineNumber": 10,
          "text": "I have no mind of feasting forth tonight.",
          "plainText": "I have no mind of feasting forth tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0032",
          "number": 32,
          "speechLineNumber": 11,
          "text": "But I will go. Go you before me, sirrah.",
          "plainText": "But I will go Go you before me sirrah",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0033",
          "number": 33,
          "speechLineNumber": 12,
          "text": "Say I will come.",
          "plainText": "Say I will come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "launcelet",
        "name": "LAUNCELET",
        "displayName": "Launcelet"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "I will go before, sir.",
          "plainText": "I will go before sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Mistress, look out at window for all this.",
          "plainText": "Mistress look out at window for all this",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "There will come a Christian by",
          "plainText": "There will come a Christian by",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "Will be worth a Jewess' eye.",
          "plainText": "Will be worth a Jewess' eye",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-stage-003",
      "type": "stage",
      "text": "[Exit Launcelet.]"
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "shylock",
        "name": "SHYLOCK",
        "displayName": "Shylock"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "What says that fool of Hagar's offspring, ha?",
          "plainText": "What says that fool of Hagar's offspring ha",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "jessica",
        "name": "JESSICA",
        "displayName": "Jessica"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "His words were \"Farewell, mistress,\" nothing else.",
          "plainText": "His words were Farewell mistress nothing else",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "shylock",
        "name": "SHYLOCK",
        "displayName": "Shylock"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-5-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "The patch is kind enough, but a huge feeder,",
          "plainText": "The patch is kind enough but a huge feeder",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Snail-slow in profit, and he sleeps by day",
          "plainText": "Snailslow in profit and he sleeps by day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "More than the wild-cat. Drones hive not with me,",
          "plainText": "More than the wildcat Drones hive not with me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "Therefore I part with him, and part with him",
          "plainText": "Therefore I part with him and part with him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0044",
          "number": 44,
          "speechLineNumber": 5,
          "text": "To one that I would have him help to waste",
          "plainText": "To one that I would have him help to waste",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0045",
          "number": 45,
          "speechLineNumber": 6,
          "text": "His borrowed purse. Well, Jessica, go in.",
          "plainText": "His borrowed purse Well Jessica go in",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-2-5-line-0046",
          "number": 46,
          "speechLineNumber": 7,
          "text": "Perhaps I will return immediately:",
          "plainText": "Perhaps I will return immediately",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
