  "scene": {
    "id": "the-merchant-of-venice-2-6",
    "act": 2,
    "scene": 6,
    "label": "Act 2, Scene 6",
    "title": "SCENE VI. The same.",
    "location": "The same.",
    "orderInPlay": 9
  },
  "content": [
    {
      "id": "the-merchant-of-venice-2-6-stage-001",
      "type": "stage",
      "text": "Enter the masquers, Gratiano and Salarino."
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "This is the penthouse under which Lorenzo",
          "plainText": "This is the penthouse under which Lorenzo",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Desired us to make stand.",
          "plainText": "Desired us to make stand",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "His hour is almost past.",
          "plainText": "His hour is almost past",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "And it is marvel he out-dwells his hour,",
          "plainText": "And it is marvel he outdwells his hour",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "For lovers ever run before the clock.",
          "plainText": "For lovers ever run before the clock",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "O ten times faster Venus' pigeons fly",
          "plainText": "O ten times faster Venus' pigeons fly",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "To seal love's bonds new-made than they are wont",
          "plainText": "To seal love's bonds newmade than they are wont",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "To keep obliged faith unforfeited!",
          "plainText": "To keep obliged faith unforfeited",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "That ever holds: who riseth from a feast",
          "plainText": "That ever holds who riseth from a feast",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "With that keen appetite that he sits down?",
          "plainText": "With that keen appetite that he sits down",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Where is the horse that doth untread again",
          "plainText": "Where is the horse that doth untread again",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "His tedious measures with the unbated fire",
          "plainText": "His tedious measures with the unbated fire",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "That he did pace them first? All things that are,",
          "plainText": "That he did pace them first All things that are",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0014",
          "number": 14,
          "speechLineNumber": 6,
          "text": "Are with more spirit chased than enjoy'd.",
          "plainText": "Are with more spirit chased than enjoy'd",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0015",
          "number": 15,
          "speechLineNumber": 7,
          "text": "How like a younger or a prodigal",
          "plainText": "How like a younger or a prodigal",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0016",
          "number": 16,
          "speechLineNumber": 8,
          "text": "The scarfed bark puts from her native bay,",
          "plainText": "The scarfed bark puts from her native bay",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0017",
          "number": 17,
          "speechLineNumber": 9,
          "text": "Hugg'd and embraced by the strumpet wind!",
          "plainText": "Hugg'd and embraced by the strumpet wind",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0018",
          "number": 18,
          "speechLineNumber": 10,
          "text": "How like the prodigal doth she return",
          "plainText": "How like the prodigal doth she return",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0019",
          "number": 19,
          "speechLineNumber": 11,
          "text": "With over-weather'd ribs and ragged sails,",
          "plainText": "With overweather'd ribs and ragged sails",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0020",
          "number": 20,
          "speechLineNumber": 12,
          "text": "Lean, rent, and beggar'd by the strumpet wind!",
          "plainText": "Lean rent and beggar'd by the strumpet wind",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-stage-002",
      "type": "stage",
      "text": "Enter Lorenzo."
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Here comes Lorenzo, more of this hereafter.",
          "plainText": "Here comes Lorenzo more of this hereafter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Sweet friends, your patience for my long abode.",
          "plainText": "Sweet friends your patience for my long abode",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Not I but my affairs have made you wait.",
          "plainText": "Not I but my affairs have made you wait",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "When you shall please to play the thieves for wives,",
          "plainText": "When you shall please to play the thieves for wives",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "I'll watch as long for you then. Approach.",
          "plainText": "I'll watch as long for you then Approach",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "Here dwells my father Jew. Ho! who's within?",
          "plainText": "Here dwells my father Jew Ho who's within",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-stage-003",
      "type": "stage",
      "text": "Enter Jessica above, in boy's clothes."
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-008",
      "type": "speech",
      "speaker": {
        "id": "jessica",
        "name": "JESSICA",
        "displayName": "Jessica"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Who are you? Tell me, for more certainty,",
          "plainText": "Who are you Tell me for more certainty",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Albeit I'll swear that I do know your tongue.",
          "plainText": "Albeit I'll swear that I do know your tongue",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-009",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Lorenzo, and thy love.",
          "plainText": "Lorenzo and thy love",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-010",
      "type": "speech",
      "speaker": {
        "id": "jessica",
        "name": "JESSICA",
        "displayName": "Jessica"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Lorenzo certain, and my love indeed,",
          "plainText": "Lorenzo certain and my love indeed",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "For who love I so much? And now who knows",
          "plainText": "For who love I so much And now who knows",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "But you, Lorenzo, whether I am yours?",
          "plainText": "But you Lorenzo whether I am yours",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-011",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Heaven and thy thoughts are witness that thou art.",
          "plainText": "Heaven and thy thoughts are witness that thou art",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-012",
      "type": "speech",
      "speaker": {
        "id": "jessica",
        "name": "JESSICA",
        "displayName": "Jessica"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Here, catch this casket; it is worth the pains.",
          "plainText": "Here catch this casket it is worth the pains",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "I am glad 'tis night, you do not look on me,",
          "plainText": "I am glad 'tis night you do not look on me",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "For I am much asham'd of my exchange.",
          "plainText": "For I am much asham'd of my exchange",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "But love is blind, and lovers cannot see",
          "plainText": "But love is blind and lovers cannot see",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "The pretty follies that themselves commit,",
          "plainText": "The pretty follies that themselves commit",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0039",
          "number": 39,
          "speechLineNumber": 6,
          "text": "For if they could, Cupid himself would blush",
          "plainText": "For if they could Cupid himself would blush",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0040",
          "number": 40,
          "speechLineNumber": 7,
          "text": "To see me thus transformed to a boy.",
          "plainText": "To see me thus transformed to a boy",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-013",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Descend, for you must be my torch-bearer.",
          "plainText": "Descend for you must be my torchbearer",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-014",
      "type": "speech",
      "speaker": {
        "id": "jessica",
        "name": "JESSICA",
        "displayName": "Jessica"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "What! must I hold a candle to my shames?",
          "plainText": "What must I hold a candle to my shames",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "They in themselves, good sooth, are too too light.",
          "plainText": "They in themselves good sooth are too too light",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "Why, 'tis an office of discovery, love,",
          "plainText": "Why 'tis an office of discovery love",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0045",
          "number": 45,
          "speechLineNumber": 4,
          "text": "And I should be obscur'd.",
          "plainText": "And I should be obscur'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-015",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "So are you, sweet,",
          "plainText": "So are you sweet",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Even in the lovely garnish of a boy.",
          "plainText": "Even in the lovely garnish of a boy",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "But come at once,",
          "plainText": "But come at once",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "For the close night doth play the runaway,",
          "plainText": "For the close night doth play the runaway",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0050",
          "number": 50,
          "speechLineNumber": 5,
          "text": "And we are stay'd for at Bassanio's feast.",
          "plainText": "And we are stay'd for at Bassanio's feast",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-016",
      "type": "speech",
      "speaker": {
        "id": "jessica",
        "name": "JESSICA",
        "displayName": "Jessica"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "I will make fast the doors, and gild myself",
          "plainText": "I will make fast the doors and gild myself",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "With some moe ducats, and be with you straight.",
          "plainText": "With some moe ducats and be with you straight",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-stage-004",
      "type": "stage",
      "text": "[Exit above.]"
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-017",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Now, by my hood, a gentle, and no Jew.",
          "plainText": "Now by my hood a gentle and no Jew",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-018",
      "type": "speech",
      "speaker": {
        "id": "lorenzo",
        "name": "LORENZO",
        "displayName": "Lorenzo"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Beshrew me but I love her heartily,",
          "plainText": "Beshrew me but I love her heartily",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "For she is wise, if I can judge of her,",
          "plainText": "For she is wise if I can judge of her",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0056",
          "number": 56,
          "speechLineNumber": 3,
          "text": "And fair she is, if that mine eyes be true,",
          "plainText": "And fair she is if that mine eyes be true",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0057",
          "number": 57,
          "speechLineNumber": 4,
          "text": "And true she is, as she hath prov'd herself.",
          "plainText": "And true she is as she hath prov'd herself",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0058",
          "number": 58,
          "speechLineNumber": 5,
          "text": "And therefore, like herself, wise, fair, and true,",
          "plainText": "And therefore like herself wise fair and true",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0059",
          "number": 59,
          "speechLineNumber": 6,
          "text": "Shall she be placed in my constant soul.",
          "plainText": "Shall she be placed in my constant soul",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-stage-005",
      "type": "stage",
      "text": "Enter Jessica."
    },
    {
      "id": "the-merchant-of-venice-2-6-stage-006",
      "type": "stage",
      "text": "[Exit with Jessica and Salarino.]"
    },
    {
      "id": "the-merchant-of-venice-2-6-stage-007",
      "type": "stage",
      "text": "Enter Antonio."
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-019",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Who's there?",
          "plainText": "Who's there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-020",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Signior Antonio!",
          "plainText": "Signior Antonio",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-021",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Fie, fie, Gratiano! where are all the rest?",
          "plainText": "Fie fie Gratiano where are all the rest",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "'Tis nine o'clock, our friends all stay for you.",
          "plainText": "'Tis nine o'clock our friends all stay for you",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "No masque tonight, the wind is come about;",
          "plainText": "No masque tonight the wind is come about",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "Bassanio presently will go aboard.",
          "plainText": "Bassanio presently will go aboard",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0066",
          "number": 66,
          "speechLineNumber": 5,
          "text": "I have sent twenty out to seek for you.",
          "plainText": "I have sent twenty out to seek for you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-speech-022",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-2-6-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "I am glad on't. I desire no more delight",
          "plainText": "I am glad on't I desire no more delight",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-2-6-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "Than to be under sail and gone tonight.",
          "plainText": "Than to be under sail and gone tonight",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-2-6-stage-008",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}