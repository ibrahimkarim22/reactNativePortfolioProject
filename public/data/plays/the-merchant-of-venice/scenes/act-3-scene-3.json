  "scene": {
    "id": "the-merchant-of-venice-3-3",
    "act": 3,
    "scene": 3,
    "label": "Act 3, Scene 3",
    "title": "SCENE III. Venice. A street.",
    "location": "Venice. A street.",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "the-merchant-of-venice-3-3-stage-001",
      "type": "stage",
      "text": "Enter Shylock, Salarino, Antonio and Gaoler."
    },
    {
      "id": "the-merchant-of-venice-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "shylock",
        "name": "SHYLOCK",
        "displayName": "Shylock"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Gaoler, look to him. Tell not me of mercy.",
          "plainText": "Gaoler look to him Tell not me of mercy",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "This is the fool that lent out money gratis.",
          "plainText": "This is the fool that lent out money gratis",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Gaoler, look to him.",
          "plainText": "Gaoler look to him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Hear me yet, good Shylock.",
          "plainText": "Hear me yet good Shylock",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "shylock",
        "name": "SHYLOCK",
        "displayName": "Shylock"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "I'll have my bond, speak not against my bond.",
          "plainText": "I'll have my bond speak not against my bond",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "I have sworn an oath that I will have my bond.",
          "plainText": "I have sworn an oath that I will have my bond",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "Thou call'dst me dog before thou hadst a cause,",
          "plainText": "Thou call'dst me dog before thou hadst a cause",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "But since I am a dog, beware my fangs;",
          "plainText": "But since I am a dog beware my fangs",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 5,
          "text": "The Duke shall grant me justice. I do wonder,",
          "plainText": "The Duke shall grant me justice I do wonder",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 6,
          "text": "Thou naughty gaoler, that thou art so fond",
          "plainText": "Thou naughty gaoler that thou art so fond",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 7,
          "text": "To come abroad with him at his request.",
          "plainText": "To come abroad with him at his request",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "I pray thee hear me speak.",
          "plainText": "I pray thee hear me speak",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "shylock",
        "name": "SHYLOCK",
        "displayName": "Shylock"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "I'll have my bond. I will not hear thee speak.",
          "plainText": "I'll have my bond I will not hear thee speak",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "I'll have my bond, and therefore speak no more.",
          "plainText": "I'll have my bond and therefore speak no more",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "I'll not be made a soft and dull-eyed fool,",
          "plainText": "I'll not be made a soft and dulleyed fool",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "To shake the head, relent, and sigh, and yield",
          "plainText": "To shake the head relent and sigh and yield",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 5,
          "text": "To Christian intercessors. Follow not,",
          "plainText": "To Christian intercessors Follow not",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 6,
          "text": "I'll have no speaking, I will have my bond.",
          "plainText": "I'll have no speaking I will have my bond",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-3-3-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-merchant-of-venice-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "It is the most impenetrable cur",
          "plainText": "It is the most impenetrable cur",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "That ever kept with men.",
          "plainText": "That ever kept with men",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Let him alone.",
          "plainText": "Let him alone",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "I'll follow him no more with bootless prayers.",
          "plainText": "I'll follow him no more with bootless prayers",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "He seeks my life, his reason well I know:",
          "plainText": "He seeks my life his reason well I know",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "I oft deliver'd from his forfeitures",
          "plainText": "I oft deliver'd from his forfeitures",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "Many that have at times made moan to me.",
          "plainText": "Many that have at times made moan to me",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 6,
          "text": "Therefore he hates me.",
          "plainText": "Therefore he hates me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "salarino",
        "name": "SALARINO",
        "displayName": "Salarino"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "I am sure the Duke",
          "plainText": "I am sure the Duke",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Will never grant this forfeiture to hold.",
          "plainText": "Will never grant this forfeiture to hold",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-3-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "The Duke cannot deny the course of law,",
          "plainText": "The Duke cannot deny the course of law",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "For the commodity that strangers have",
          "plainText": "For the commodity that strangers have",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "With us in Venice, if it be denied,",
          "plainText": "With us in Venice if it be denied",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "'Twill much impeach the justice of the state,",
          "plainText": "'Twill much impeach the justice of the state",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0033",
          "number": 33,
          "speechLineNumber": 5,
          "text": "Since that the trade and profit of the city",
          "plainText": "Since that the trade and profit of the city",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0034",
          "number": 34,
          "speechLineNumber": 6,
          "text": "Consisteth of all nations. Therefore, go.",
          "plainText": "Consisteth of all nations Therefore go",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0035",
          "number": 35,
          "speechLineNumber": 7,
          "text": "These griefs and losses have so bated me",
          "plainText": "These griefs and losses have so bated me",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0036",
          "number": 36,
          "speechLineNumber": 8,
          "text": "That I shall hardly spare a pound of flesh",
          "plainText": "That I shall hardly spare a pound of flesh",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0037",
          "number": 37,
          "speechLineNumber": 9,
          "text": "Tomorrow to my bloody creditor.",
          "plainText": "Tomorrow to my bloody creditor",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0038",
          "number": 38,
          "speechLineNumber": 10,
          "text": "Well, gaoler, on, pray God Bassanio come",
          "plainText": "Well gaoler on pray God Bassanio come",
          "lineType": "verse"
        },
        {
          "id": "the-merchant-of-venice-3-3-line-0039",
          "number": 39,
          "speechLineNumber": 11,
          "text": "To see me pay his debt, and then I care not.",
          "plainText": "To see me pay his debt and then I care not",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-3-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}