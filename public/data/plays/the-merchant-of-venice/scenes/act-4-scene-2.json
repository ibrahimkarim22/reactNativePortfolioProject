  },
  "content": [
    {
      "id": "the-merchant-of-venice-4-2-stage-001",
      "type": "stage",
      "text": "Enter Portia and Nerissa."
    },
    {
      "id": "the-merchant-of-venice-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Inquire the Jew's house out, give him this deed,",
          "plainText": "Inquire the Jew's house out give him this deed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And let him sign it, we'll away tonight,",
          "plainText": "And let him sign it we'll away tonight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And be a day before our husbands home.",
          "plainText": "And be a day before our husbands home",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "This deed will be well welcome to Lorenzo.",
          "plainText": "This deed will be well welcome to Lorenzo",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-4-2-stage-002",
      "type": "stage",
      "text": "Enter Gratiano."
    },
    {
      "id": "the-merchant-of-venice-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Fair sir, you are well o'erta'en.",
          "plainText": "Fair sir you are well o'erta'en",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "My Lord Bassanio upon more advice,",
          "plainText": "My Lord Bassanio upon more advice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "Hath sent you here this ring, and doth entreat",
          "plainText": "Hath sent you here this ring and doth entreat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "Your company at dinner.",
          "plainText": "Your company at dinner",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "That cannot be;",
          "plainText": "That cannot be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "His ring I do accept most thankfully,",
          "plainText": "His ring I do accept most thankfully",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "And so I pray you tell him. Furthermore,",
          "plainText": "And so I pray you tell him Furthermore",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "I pray you show my youth old Shylock's house.",
          "plainText": "I pray you show my youth old Shylock's house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "gratiano",
        "name": "GRATIANO",
        "displayName": "Gratiano"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "That will I do.",
          "plainText": "That will I do",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "nerissa",
        "name": "NERISSA",
        "displayName": "Nerissa"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Sir, I would speak with you.",
          "plainText": "Sir I would speak with you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "[Aside to Portia.]",
          "plainText": "Aside to Portia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "I'll see if I can get my husband's ring,",
          "plainText": "I'll see if I can get my husband's ring",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "Which I did make him swear to keep for ever.",
          "plainText": "Which I did make him swear to keep for ever",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "portia",
        "name": "PORTIA",
        "displayName": "Portia"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "[To Nerissa.] Thou mayst, I warrant. We shall have old swearing",
          "plainText": "To Nerissa Thou mayst I warrant We shall have old swearing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "That they did give the rings away to men;",
          "plainText": "That they did give the rings away to men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "But we'll outface them, and outswear them too.",
          "plainText": "But we'll outface them and outswear them too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-merchant-of-venice-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "Away! make haste! Thou know'st where I will tarry.",
          "plainText": "Away make haste Thou know'st where I will tarry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "nerissa",
        "name": "NERISSA",
        "displayName": "Nerissa"
      },
      "lines": [
        {
          "id": "the-merchant-of-venice-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Come, good sir, will you show me to this house?",
          "plainText": "Come good sir will you show me to this house",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merchant-of-venice-4-2-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}