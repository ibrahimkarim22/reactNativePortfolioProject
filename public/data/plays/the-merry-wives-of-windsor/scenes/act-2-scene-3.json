    "title": "SCENE III. A field near Windsor",
    "location": "A field near Windsor",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "the-merry-wives-of-windsor-2-3-stage-001",
      "type": "stage",
      "text": "Enter Doctor Caius and Rugby."
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Jack Rugby!",
          "plainText": "Jack Rugby",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "rugby",
        "name": "RUGBY",
        "displayName": "Rugby"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Sir?",
          "plainText": "Sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Vat is de clock, Jack?",
          "plainText": "Vat is de clock Jack",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "rugby",
        "name": "RUGBY",
        "displayName": "Rugby"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "'Tis past the hour, sir, that Sir Hugh promised to meet.",
          "plainText": "'Tis past the hour sir that Sir Hugh promised to meet",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "By gar, he has save his soul, dat he is no come. He has pray his Pible well dat he is no come. By gar, Jack Rugby, he is dead already, if he be come.",
          "plainText": "By gar he has save his soul dat he is no come He has pray his Pible well dat he is no come By gar Jack Rugby he is dead already if he be come",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "rugby",
        "name": "RUGBY",
        "displayName": "Rugby"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "He is wise, sir; he knew your worship would kill him if he came.",
          "plainText": "He is wise sir he knew your worship would kill him if he came",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "By gar, de herring is no dead so as I vill kill him. Take your rapier, Jack; I vill tell you how I vill kill him.",
          "plainText": "By gar de herring is no dead so as I vill kill him Take your rapier Jack I vill tell you how I vill kill him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "rugby",
        "name": "RUGBY",
        "displayName": "Rugby"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Alas, sir, I cannot fence.",
          "plainText": "Alas sir I cannot fence",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Villainy, take your rapier.",
          "plainText": "Villainy take your rapier",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "rugby",
        "name": "RUGBY",
        "displayName": "Rugby"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Forbear; here's company.",
          "plainText": "Forbear here's company",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-stage-002",
      "type": "stage",
      "text": "Enter Page, Shallow, Slender and Host."
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "God bless thee, bully doctor!",
          "plainText": "God bless thee bully doctor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "God save you, Master Doctor Caius!",
          "plainText": "God save you Master Doctor Caius",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Now, good Master Doctor!",
          "plainText": "Now good Master Doctor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Give you good morrow, sir.",
          "plainText": "Give you good morrow sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Vat be all you, one, two, tree, four, come for?",
          "plainText": "Vat be all you one two tree four come for",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "To see thee fight, to see thee foin, to see thee traverse; to see thee here, to see thee there; to see thee pass thy punto, thy stock, thy reverse, thy distance, thy montant. Is he dead, my Ethiopian? Is he dead, my Francisco? Ha, bully? What says my Aesculapius, my Galen, my heart of elder, ha? Is he dead, bully stale? Is he dead?",
          "plainText": "To see thee fight to see thee foin to see thee traverse to see thee here to see thee there to see thee pass thy punto thy stock thy reverse thy distance thy montant Is he dead my Ethiopian Is he dead my Francisco Ha bully What says my Aesculapius my Galen my heart of elder ha Is he dead bully stale Is he dead",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "By gar, he is de coward Jack-priest of de vorld. He is not show his face.",
          "plainText": "By gar he is de coward Jackpriest of de vorld He is not show his face",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Thou art a Castalion King Urinal Hector of Greece, my boy!",
          "plainText": "Thou art a Castalion King Urinal Hector of Greece my boy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I pray you, bear witness that me have stay six or seven, two, tree hours for him, and he is no come.",
          "plainText": "I pray you bear witness that me have stay six or seven two tree hours for him and he is no come",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "He is the wiser man, Master doctor. He is a curer of souls, and you a curer of bodies. If you should fight, you go against the hair of your professions. Is it not true, Master Page?",
          "plainText": "He is the wiser man Master doctor He is a curer of souls and you a curer of bodies If you should fight you go against the hair of your professions Is it not true Master Page",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Master Shallow, you have yourself been a great fighter, though now a man of peace.",
          "plainText": "Master Shallow you have yourself been a great fighter though now a man of peace",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Bodykins, Master Page, though I now be old, and of the peace, if I see a sword out, my finger itches to make one. Though we are justices and doctors and churchmen, Master Page, we have some salt of our youth in us. We are the sons of women, Master Page.",
          "plainText": "Bodykins Master Page though I now be old and of the peace if I see a sword out my finger itches to make one Though we are justices and doctors and churchmen Master Page we have some salt of our youth in us We are the sons of women Master Page",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "'Tis true, Master Shallow.",
          "plainText": "'Tis true Master Shallow",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "It will be found so, Master Page.—Master Doctor Caius, I come to fetch you home. I am sworn of the peace. You have showed yourself a wise physician, and Sir Hugh hath shown himself a wise and patient churchman. You must go with me, Master Doctor.",
          "plainText": "It will be found so Master PageMaster Doctor Caius I come to fetch you home I am sworn of the peace You have showed yourself a wise physician and Sir Hugh hath shown himself a wise and patient churchman You must go with me Master Doctor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Pardon, guest justice.—A word, Monsieur Mockwater.",
          "plainText": "Pardon guest justiceA word Monsieur Mockwater",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Mockvater? Vat is dat?",
          "plainText": "Mockvater Vat is dat",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Mockwater, in our English tongue, is valour, bully.",
          "plainText": "Mockwater in our English tongue is valour bully",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "By gar, then I have as much mockvater as de Englishman. Scurvy jack-dog priest! By gar, me vill cut his ears.",
          "plainText": "By gar then I have as much mockvater as de Englishman Scurvy jackdog priest By gar me vill cut his ears",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "He will clapper-claw thee tightly, bully.",
          "plainText": "He will clapperclaw thee tightly bully",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Clapper-de-claw? Vat is dat?",
          "plainText": "Clapperdeclaw Vat is dat",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-031",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "That is, he will make thee amends.",
          "plainText": "That is he will make thee amends",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-032",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "By gar, me do look he shall clapper-de-claw me, for, by gar, me vill have it.",
          "plainText": "By gar me do look he shall clapperdeclaw me for by gar me vill have it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-033",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "And I will provoke him to't, or let him wag.",
          "plainText": "And I will provoke him to't or let him wag",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-034",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Me tank you for dat.",
          "plainText": "Me tank you for dat",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-035",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "And, moreover, bully—but first, Master guest, and Master Page, and eke Cavaliero Slender, go you through the town to Frogmore.",
          "plainText": "And moreover bullybut first Master guest and Master Page and eke Cavaliero Slender go you through the town to Frogmore",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-036",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "[Aside to Host.] Sir Hugh is there, is he?",
          "plainText": "Aside to Host Sir Hugh is there is he",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-037",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "[Aside to Page.] He is there. See what humour he is in; and I will bring the doctor about by the fields. Will it do well?",
          "plainText": "Aside to Page He is there See what humour he is in and I will bring the doctor about by the fields Will it do well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-038",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "[Aside to Host.] We will do it.",
          "plainText": "Aside to Host We will do it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-stage-003",
      "type": "stage",
      "text": "[Exeunt Page, Shallow and Slender.]"
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-039",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "By gar, me vill kill de priest, for he speak for a jackanape to Anne Page.",
          "plainText": "By gar me vill kill de priest for he speak for a jackanape to Anne Page",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-040",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Let him die. Sheathe thy impatience; throw cold water on thy choler. Go about the fields with me through Frogmore. I will bring thee where Mistress Anne Page is, at a farm-house a-feasting, and thou shalt woo her. Cried game! Said I well?",
          "plainText": "Let him die Sheathe thy impatience throw cold water on thy choler Go about the fields with me through Frogmore I will bring thee where Mistress Anne Page is at a farmhouse afeasting and thou shalt woo her Cried game Said I well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-041",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "By gar, me tank you for dat. By gar, I love you; and I shall procure-a you de good guest: de earl, de knight, de lords, de gentlemen, my patients.",
          "plainText": "By gar me tank you for dat By gar I love you and I shall procurea you de good guest de earl de knight de lords de gentlemen my patients",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-042",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "For the which I will be thy adversary toward Anne Page. Said I well?",
          "plainText": "For the which I will be thy adversary toward Anne Page Said I well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-043",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "By gar, 'tis good; vell said.",
          "plainText": "By gar 'tis good vell said",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-044",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Let us wag, then.",
          "plainText": "Let us wag then",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-speech-045",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-2-3-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Come at my heels, Jack Rugby.",
          "plainText": "Come at my heels Jack Rugby",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-2-3-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}