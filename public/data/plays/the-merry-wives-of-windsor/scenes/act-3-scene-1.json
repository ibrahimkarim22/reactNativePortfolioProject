    {
      "id": "the-merry-wives-of-windsor-3-1-speech-032",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "I pray you, let-a me speak a word with your ear. Verefore will you not meet-a me?",
          "plainText": "I pray you leta me speak a word with your ear Verefore will you not meeta me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
