      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "[Aside to Caius.] Pray you, use your patience. In good time.",
          "plainText": "Aside to Caius Pray you use your patience In good time",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-034",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "By gar, you are de coward, de Jack dog, John ape.",
          "plainText": "By gar you are de coward de Jack dog John ape",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-035",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "[Aside to Caius.] Pray you, let us not be laughing stocks to other men's humours. I desire you in friendship, and I will one way or other make you amends.",
          "plainText": "Aside to Caius Pray you let us not be laughing stocks to other men's humours I desire you in friendship and I will one way or other make you amends",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "long average line length"
        },
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "[Aloud.] By Jeshu, I will knog your urinal about your knave's cogscomb.",
          "plainText": "Aloud By Jeshu I will knog your urinal about your knave's cogscomb",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "long average line length"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-036",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Diable! Jack Rugby, mine Host de Jarteer, have I not stay for him to kill him? Have I not, at de place I did appoint?",
          "plainText": "Diable Jack Rugby mine Host de Jarteer have I not stay for him to kill him Have I not at de place I did appoint",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-037",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "As I am a Christians soul, now look you, this is the place appointed. I'll be judgment by mine host of the Garter.",
          "plainText": "As I am a Christians soul now look you this is the place appointed I'll be judgment by mine host of the Garter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-038",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Peace, I say, Gallia and Gaul, French and Welsh, soul-curer and body-curer!",
          "plainText": "Peace I say Gallia and Gaul French and Welsh soulcurer and bodycurer",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-039",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Ay, dat is very good; excellent.",
          "plainText": "Ay dat is very good excellent",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-040",
      "type": "speech",
      "speaker": {
        "id": "host",
        "name": "HOST",
        "displayName": "Host"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Peace, I say! Hear mine host of the Garter. Am I politic? Am I subtle? Am I a Machiavel? Shall I lose my doctor? No, he gives me the potions and the motions. Shall I lose my parson, my priest, my Sir Hugh? No, he gives me the proverbs and the no-verbs. [To Caius.] Give me thy hand, terrestrial; so. [To Evans.] Give me thy hand, celestial; so. Boys of art, I have deceived you both. I have directed you to wrong places. Your hearts are mighty, your skins are whole, and let burnt sack be the issue. Come, lay their swords to pawn. Follow me, lads of peace, follow, follow, follow.",
          "plainText": "Peace I say Hear mine host of the Garter Am I politic Am I subtle Am I a Machiavel Shall I lose my doctor No he gives me the potions and the motions Shall I lose my parson my priest my Sir Hugh No he gives me the proverbs and the noverbs To Caius Give me thy hand terrestrial so To Evans Give me thy hand celestial so Boys of art I have deceived you both I have directed you to wrong places Your hearts are mighty your skins are whole and let burnt sack be the issue Come lay their swords to pawn Follow me lads of peace follow follow follow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-stage-008",
      "type": "stage",
      "text": "[Exit Host.]"
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-041",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Afore God, a mad host! Follow, gentlemen, follow.",
          "plainText": "Afore God a mad host Follow gentlemen follow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
