  "content": [
    {
      "id": "the-merry-wives-of-windsor-3-1-stage-001",
      "type": "stage",
      "text": "Enter Sir Hugh Evans and Simple."
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I pray you now, good Master Slender's servingman, and friend Simple by your name, which way have you looked for Master Caius, that calls himself doctor of physic?",
          "plainText": "I pray you now good Master Slender's servingman and friend Simple by your name which way have you looked for Master Caius that calls himself doctor of physic",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "simple",
        "name": "SIMPLE",
        "displayName": "Simple"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Marry, sir, the Petty-ward, the Park-ward, every way; old Windsor way, and every way but the town way.",
          "plainText": "Marry sir the Pettyward the Parkward every way old Windsor way and every way but the town way",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "I most fehemently desire you, you will also look that way.",
          "plainText": "I most fehemently desire you you will also look that way",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "simple",
        "name": "SIMPLE",
        "displayName": "Simple"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I will, Sir.",
          "plainText": "I will Sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-stage-002",
      "type": "stage",
      "text": "[Exit Simple.]"
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Pless my soul, how full of cholers I am, and trempling of mind! I shall be glad if he have deceived me. How melancholies I am! I will knog his urinals about his knave's costard when I have good opportunities for the 'ork. Pless my soul!",
          "plainText": "Pless my soul how full of cholers I am and trempling of mind I shall be glad if he have deceived me How melancholies I am I will knog his urinals about his knave's costard when I have good opportunities for the 'ork Pless my soul",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-stage-003",
      "type": "stage",
      "text": "[Sings.]"
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-stage-004",
      "type": "stage",
      "text": "[Sings.]"
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-stage-005",
      "type": "stage",
      "text": "Enter Simple."
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "simple",
        "name": "SIMPLE",
        "displayName": "Simple"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Yonder he is, coming this way, Sir Hugh.",
          "plainText": "Yonder he is coming this way Sir Hugh",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "He's welcome.",
          "plainText": "He's welcome",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "simple",
        "name": "SIMPLE",
        "displayName": "Simple"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "No weapons, sir. There comes my master, Master Shallow, and another gentleman, from Frogmore, over the stile, this way.",
          "plainText": "No weapons sir There comes my master Master Shallow and another gentleman from Frogmore over the stile this way",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Pray you, give me my gown—or else keep it in your arms.",
          "plainText": "Pray you give me my gownor else keep it in your arms",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-stage-006",
      "type": "stage",
      "text": "Enter Page, Shallow and Slender."
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "How now, Master Parson? Good morrow, good Sir Hugh. Keep a gamester from the dice, and a good student from his book, and it is wonderful.",
          "plainText": "How now Master Parson Good morrow good Sir Hugh Keep a gamester from the dice and a good student from his book and it is wonderful",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "[Aside.] Ah, sweet Anne Page!",
          "plainText": "Aside Ah sweet Anne Page",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "God save you, good Sir Hugh!",
          "plainText": "God save you good Sir Hugh",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "God pless you from his mercy sake, all of you!",
          "plainText": "God pless you from his mercy sake all of you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "What, the sword and the word? Do you study them both, Master Parson?",
          "plainText": "What the sword and the word Do you study them both Master Parson",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "And youthful still—in your doublet and hose, this raw rheumatic day?",
          "plainText": "And youthful stillin your doublet and hose this raw rheumatic day",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "There is reasons and causes for it.",
          "plainText": "There is reasons and causes for it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "We are come to you to do a good office, Master Parson.",
          "plainText": "We are come to you to do a good office Master Parson",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Fery well; what is it?",
          "plainText": "Fery well what is it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Yonder is a most reverend gentleman who, belike having received wrong by some person, is at most odds with his own gravity and patience that ever you saw.",
          "plainText": "Yonder is a most reverend gentleman who belike having received wrong by some person is at most odds with his own gravity and patience that ever you saw",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "I have lived fourscore years and upward; I never heard a man of his place, gravity, and learning, so wide of his own respect.",
          "plainText": "I have lived fourscore years and upward I never heard a man of his place gravity and learning so wide of his own respect",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "What is he?",
          "plainText": "What is he",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I think you know him: Master Doctor Caius, the renowned French physician.",
          "plainText": "I think you know him Master Doctor Caius the renowned French physician",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Got's will and His passion of my heart! I had as lief you would tell me of a mess of porridge.",
          "plainText": "Got's will and His passion of my heart I had as lief you would tell me of a mess of porridge",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Why?",
          "plainText": "Why",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "He has no more knowledge in Hibbocrates and Galen, and he is a knave besides, a cowardly knave as you would desires to be acquainted withal.",
          "plainText": "He has no more knowledge in Hibbocrates and Galen and he is a knave besides a cowardly knave as you would desires to be acquainted withal",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "I warrant you, he's the man should fight with him.",
          "plainText": "I warrant you he's the man should fight with him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "slender",
        "name": "SLENDER",
        "displayName": "Slender"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "[Aside.] O, sweet Anne Page!",
          "plainText": "Aside O sweet Anne Page",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "It appears so by his weapons. Keep them asunder. Here comes Doctor Caius.",
          "plainText": "It appears so by his weapons Keep them asunder Here comes Doctor Caius",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-stage-007",
      "type": "stage",
      "text": "Enter Host, Caius and Rugby."
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "page",
        "name": "PAGE",
        "displayName": "Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Nay, good Master Parson, keep in your weapon.",
          "plainText": "Nay good Master Parson keep in your weapon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "So do you, good Master Doctor.",
          "plainText": "So do you good Master Doctor",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-031",
