    {
      "id": "the-merry-wives-of-windsor-3-1-stage-009",
      "type": "stage",
      "text": "[Exeunt Shallow, Slender and Page.]"
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-043",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Ha, do I perceive dat? Have you make-a de sot of us, ha, ha?",
          "plainText": "Ha do I perceive dat Have you makea de sot of us ha ha",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-044",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "This is well, he has made us his vlouting-stog. I desire you that we may be friends, and let us knog our prains together to be revenge on this same scall, scurvy, cogging companion, the host of the Garter.",
          "plainText": "This is well he has made us his vloutingstog I desire you that we may be friends and let us knog our prains together to be revenge on this same scall scurvy cogging companion the host of the Garter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-045",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "By gar, with all my heart. He promise to bring me where is Anne Page; by gar, he deceive me too.",
          "plainText": "By gar with all my heart He promise to bring me where is Anne Page by gar he deceive me too",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-3-1-speech-046",
      "type": "speech",
      "speaker": {
        "id": "evans",
        "name": "EVANS",
        "displayName": "Evans"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Well, I will smite his noddles. Pray you follow.",
          "plainText": "Well I will smite his noddles Pray you follow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
