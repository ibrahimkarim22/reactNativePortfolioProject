      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-3-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Disarm them, and let them question. Let them keep their limbs whole and hack our English.",
          "plainText": "Disarm them and let them question Let them keep their limbs whole and hack our English",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
