  },
  "content": [
    {
      "id": "the-merry-wives-of-windsor-5-3-stage-001",
      "type": "stage",
      "text": "Enter Mistress Page, Mistress Ford and Doctor Caius."
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Master Doctor, my daughter is in green. When you see your time, take her by the hand, away with her to the deanery, and dispatch it quickly. Go before into the park. We two must go together.",
          "plainText": "Master Doctor my daughter is in green When you see your time take her by the hand away with her to the deanery and dispatch it quickly Go before into the park We two must go together",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "caius",
        "name": "CAIUS",
        "displayName": "Caius"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "I know vat I have to do. Adieu.",
          "plainText": "I know vat I have to do Adieu",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Fare you well, sir.",
          "plainText": "Fare you well sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-stage-002",
      "type": "stage",
      "text": "[Exit Caius.]"
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "mistress-ford",
        "name": "MISTRESS FORD",
        "displayName": "Mistress Ford"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Where is Nan now, and her troop of fairies, and the Welsh devil Hugh?",
          "plainText": "Where is Nan now and her troop of fairies and the Welsh devil Hugh",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "They are all couched in a pit hard by Herne's oak, with obscured lights, which, at the very instant of Falstaff's and our meeting, they will at once display to the night.",
          "plainText": "They are all couched in a pit hard by Herne's oak with obscured lights which at the very instant of Falstaff's and our meeting they will at once display to the night",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "mistress-ford",
        "name": "MISTRESS FORD",
        "displayName": "Mistress Ford"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "That cannot choose but amaze him.",
          "plainText": "That cannot choose but amaze him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "If he be not amazed, he will be mocked; if he be amazed, he will every way be mocked.",
          "plainText": "If he be not amazed he will be mocked if he be amazed he will every way be mocked",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "mistress-ford",
        "name": "MISTRESS FORD",
        "displayName": "Mistress Ford"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "We'll betray him finely.",
          "plainText": "We'll betray him finely",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "mistress-page",
        "name": "MISTRESS PAGE",
        "displayName": "Mistress Page"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Against such lewdsters and their lechery,",
          "plainText": "Against such lewdsters and their lechery",
          "lineType": "verse"
        },
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Those that betray them do no treachery.",
          "plainText": "Those that betray them do no treachery",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "mistress-ford",
        "name": "MISTRESS FORD",
        "displayName": "Mistress Ford"
      },
      "lines": [
        {
          "id": "the-merry-wives-of-windsor-5-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "The hour draws on. To the oak, to the oak!",
          "plainText": "The hour draws on To the oak to the oak",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-merry-wives-of-windsor-5-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}