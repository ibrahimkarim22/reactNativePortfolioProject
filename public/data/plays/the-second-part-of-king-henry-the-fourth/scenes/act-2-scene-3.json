  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-fourth-2-3-stage-001",
      "type": "stage",
      "text": "Enter Northumberland, Lady Northumberland and Lady Percy."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "northumberland",
        "name": "NORTHUMBERLAND",
        "displayName": "Northumberland"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I pray thee, loving wife, and gentle daughter,",
          "plainText": "I pray thee loving wife and gentle daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Give even way unto my rough affairs;",
          "plainText": "Give even way unto my rough affairs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Put not you on the visage of the times",
          "plainText": "Put not you on the visage of the times",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And be like them to Percy troublesome.",
          "plainText": "And be like them to Percy troublesome",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lady-northumberland",
        "name": "LADY NORTHUMBERLAND",
        "displayName": "Lady Northumberland"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "I have given over, I will speak no more.",
          "plainText": "I have given over I will speak no more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Do what you will; your wisdom be your guide.",
          "plainText": "Do what you will your wisdom be your guide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "northumberland",
        "name": "NORTHUMBERLAND",
        "displayName": "Northumberland"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Alas, sweet wife, my honour is at pawn,",
          "plainText": "Alas sweet wife my honour is at pawn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "And, but my going, nothing can redeem it.",
          "plainText": "And but my going nothing can redeem it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lady-percy",
        "name": "LADY PERCY",
        "displayName": "Lady Percy"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "O yet, for God's sake, go not to these wars!",
          "plainText": "O yet for God's sake go not to these wars",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "The time was, father, that you broke your word,",
          "plainText": "The time was father that you broke your word",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "When you were more endear'd to it than now;",
          "plainText": "When you were more endear'd to it than now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "When your own Percy, when my heart's dear Harry,",
          "plainText": "When your own Percy when my heart's dear Harry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "Threw many a northward look to see his father",
          "plainText": "Threw many a northward look to see his father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 6,
          "text": "Bring up his powers; but he did long in vain.",
          "plainText": "Bring up his powers but he did long in vain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 7,
          "text": "Who then persuaded you to stay at home?",
          "plainText": "Who then persuaded you to stay at home",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 8,
          "text": "There were two honours lost, yours and your son's.",
          "plainText": "There were two honours lost yours and your son's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 9,
          "text": "For yours, the God of heaven brighten it!",
          "plainText": "For yours the God of heaven brighten it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 10,
          "text": "For his, it stuck upon him as the sun",
          "plainText": "For his it stuck upon him as the sun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 11,
          "text": "In the grey vault of heaven, and by his light",
          "plainText": "In the grey vault of heaven and by his light",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 12,
          "text": "Did all the chivalry of England move",
          "plainText": "Did all the chivalry of England move",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 13,
          "text": "To do brave acts. He was indeed the glass",
          "plainText": "To do brave acts He was indeed the glass",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 14,
          "text": "Wherein the noble youth did dress themselves.",
          "plainText": "Wherein the noble youth did dress themselves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 15,
          "text": "He had no legs that practis'd not his gait;",
          "plainText": "He had no legs that practis'd not his gait",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 16,
          "text": "And speaking thick, which nature made his blemish,",
          "plainText": "And speaking thick which nature made his blemish",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 17,
          "text": "Became the accents of the valiant;",
          "plainText": "Became the accents of the valiant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 18,
          "text": "For those who could speak low and tardily",
          "plainText": "For those who could speak low and tardily",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 19,
          "text": "Would turn their own perfection to abuse,",
          "plainText": "Would turn their own perfection to abuse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 20,
          "text": "To seem like him. So that in speech, in gait,",
          "plainText": "To seem like him So that in speech in gait",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 21,
          "text": "In diet, in affections of delight,",
          "plainText": "In diet in affections of delight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 22,
          "text": "In military rules, humours of blood,",
          "plainText": "In military rules humours of blood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 23,
          "text": "He was the mark and glass, copy and book,",
          "plainText": "He was the mark and glass copy and book",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 24,
          "text": "That fashion'd others. And him—O wondrous him!",
          "plainText": "That fashion'd others And himO wondrous him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 25,
          "text": "O miracle of men!—him did you leave,",
          "plainText": "O miracle of menhim did you leave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 26,
          "text": "Second to none, unseconded by you,",
          "plainText": "Second to none unseconded by you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0035",
          "number": 35,
          "speechLineNumber": 27,
          "text": "To look upon the hideous god of war",
          "plainText": "To look upon the hideous god of war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0036",
          "number": 36,
          "speechLineNumber": 28,
          "text": "In disadvantage, to abide a field",
          "plainText": "In disadvantage to abide a field",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0037",
          "number": 37,
          "speechLineNumber": 29,
          "text": "Where nothing but the sound of Hotspur's name",
          "plainText": "Where nothing but the sound of Hotspur's name",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0038",
          "number": 38,
          "speechLineNumber": 30,
          "text": "Did seem defensible: so you left him.",
          "plainText": "Did seem defensible so you left him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0039",
          "number": 39,
          "speechLineNumber": 31,
          "text": "Never, O never, do his ghost the wrong",
          "plainText": "Never O never do his ghost the wrong",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0040",
          "number": 40,
          "speechLineNumber": 32,
          "text": "To hold your honour more precise and nice",
          "plainText": "To hold your honour more precise and nice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0041",
          "number": 41,
          "speechLineNumber": 33,
          "text": "With others than with him! Let them alone.",
          "plainText": "With others than with him Let them alone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0042",
          "number": 42,
          "speechLineNumber": 34,
          "text": "The Marshal and the Archbishop are strong:",
          "plainText": "The Marshal and the Archbishop are strong",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0043",
          "number": 43,
          "speechLineNumber": 35,
          "text": "Had my sweet Harry had but half their numbers,",
          "plainText": "Had my sweet Harry had but half their numbers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0044",
          "number": 44,
          "speechLineNumber": 36,
          "text": "Today might I, hanging on Hotspur's neck,",
          "plainText": "Today might I hanging on Hotspur's neck",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0045",
          "number": 45,
          "speechLineNumber": 37,
          "text": "Have talk'd of Monmouth's grave.",
          "plainText": "Have talk'd of Monmouth's grave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "northumberland",
        "name": "NORTHUMBERLAND",
        "displayName": "Northumberland"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Beshrew your heart,",
          "plainText": "Beshrew your heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Fair daughter, you do draw my spirits from me",
          "plainText": "Fair daughter you do draw my spirits from me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "With new lamenting ancient oversights.",
          "plainText": "With new lamenting ancient oversights",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "But I must go and meet with danger there,",
          "plainText": "But I must go and meet with danger there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0050",
          "number": 50,
          "speechLineNumber": 5,
          "text": "Or it will seek me in another place,",
          "plainText": "Or it will seek me in another place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0051",
          "number": 51,
          "speechLineNumber": 6,
          "text": "And find me worse provided.",
          "plainText": "And find me worse provided",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "lady-northumberland",
        "name": "LADY NORTHUMBERLAND",
        "displayName": "Lady Northumberland"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "O, fly to Scotland,",
          "plainText": "O fly to Scotland",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Till that the nobles and the armed commons",
          "plainText": "Till that the nobles and the armed commons",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "Have of their puissance made a little taste.",
          "plainText": "Have of their puissance made a little taste",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lady-percy",
        "name": "LADY PERCY",
        "displayName": "Lady Percy"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "If they get ground and vantage of the King,",
          "plainText": "If they get ground and vantage of the King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "Then join you with them like a rib of steel,",
          "plainText": "Then join you with them like a rib of steel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "To make strength stronger; but, for all our loves,",
          "plainText": "To make strength stronger but for all our loves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0058",
          "number": 58,
          "speechLineNumber": 4,
          "text": "First let them try themselves. So did your son;",
          "plainText": "First let them try themselves So did your son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0059",
          "number": 59,
          "speechLineNumber": 5,
          "text": "He was so suffer'd. So came I a widow,",
          "plainText": "He was so suffer'd So came I a widow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0060",
          "number": 60,
          "speechLineNumber": 6,
          "text": "And never shall have length of life enough",
          "plainText": "And never shall have length of life enough",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0061",
          "number": 61,
          "speechLineNumber": 7,
          "text": "To rain upon remembrance with mine eyes,",
          "plainText": "To rain upon remembrance with mine eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0062",
          "number": 62,
          "speechLineNumber": 8,
          "text": "That it may grow and sprout as high as heaven",
          "plainText": "That it may grow and sprout as high as heaven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0063",
          "number": 63,
          "speechLineNumber": 9,
          "text": "For recordation to my noble husband.",
          "plainText": "For recordation to my noble husband",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "northumberland",
        "name": "NORTHUMBERLAND",
        "displayName": "Northumberland"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Come, come, go in with me. 'Tis with my mind",
          "plainText": "Come come go in with me 'Tis with my mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "As with the tide swell'd up unto his height,",
          "plainText": "As with the tide swell'd up unto his height",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "That makes a still-stand, running neither way.",
          "plainText": "That makes a stillstand running neither way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0067",
          "number": 67,
          "speechLineNumber": 4,
          "text": "Fain would I go to meet the Archbishop,",
          "plainText": "Fain would I go to meet the Archbishop",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0068",
          "number": 68,
          "speechLineNumber": 5,
          "text": "But many thousand reasons hold me back.",
          "plainText": "But many thousand reasons hold me back",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0069",
          "number": 69,
          "speechLineNumber": 6,
          "text": "I will resolve for Scotland. There am I,",
          "plainText": "I will resolve for Scotland There am I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-2-3-line-0070",
          "number": 70,
          "speechLineNumber": 7,
          "text": "Till time and vantage crave my company.",
          "plainText": "Till time and vantage crave my company",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-2-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}