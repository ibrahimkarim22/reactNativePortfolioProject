    "act": 5,
    "scene": 3,
    "label": "Act 5, Scene 3",
    "title": "SCENE III. Gloucestershire. Shallow's orchard.",
    "location": "Gloucestershire. Shallow's orchard.",
    "orderInPlay": 17
  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-stage-001",
      "type": "stage",
      "text": "Enter Falstaff, Shallow, Silence, Davy, Bardolph and the Page."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Nay, you shall see my orchard, where, in an arbour, we will eat a last year's pippin of mine own graffing, with a dish of caraways, and so forth. Come, cousin Silence. And then to bed.",
          "plainText": "Nay you shall see my orchard where in an arbour we will eat a last year's pippin of mine own graffing with a dish of caraways and so forth Come cousin Silence And then to bed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Fore God, you have here a goodly dwelling, and a rich.",
          "plainText": "Fore God you have here a goodly dwelling and a rich",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Barren, barren, barren; beggars all, beggars all, Sir John. Marry, good air. Spread, Davy, spread, Davy. Well said, Davy.",
          "plainText": "Barren barren barren beggars all beggars all Sir John Marry good air Spread Davy spread Davy Well said Davy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "This Davy serves you for good uses; he is your serving-man and your husband.",
          "plainText": "This Davy serves you for good uses he is your servingman and your husband",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "A good varlet, a good varlet, a very good varlet, Sir John. By the mass, I have drunk too much sack at supper. A good varlet. Now sit down, now sit down. Come, cousin.",
          "plainText": "A good varlet a good varlet a very good varlet Sir John By the mass I have drunk too much sack at supper A good varlet Now sit down now sit down Come cousin",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "silence",
        "name": "SILENCE",
        "displayName": "Silence"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Ah, sirrah! quoth-a, we shall [Singing.]",
          "plainText": "Ah sirrah quotha we shall Singing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "There's a merry heart! Good Master Silence, I'll give you a health for that anon.",
          "plainText": "There's a merry heart Good Master Silence I'll give you a health for that anon",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Give Master Bardolph some wine, Davy.",
          "plainText": "Give Master Bardolph some wine Davy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "davy",
        "name": "DAVY",
        "displayName": "Davy"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Sweet sir, sit. I'll be with you anon. Most sweet sir, sit. Master page, good master page, sit. Proface! What you want in meat, we'll have in drink, but you must bear; the heart's all.",
          "plainText": "Sweet sir sit I'll be with you anon Most sweet sir sit Master page good master page sit Proface What you want in meat we'll have in drink but you must bear the heart's all",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Be merry, Master Bardolph, and, my little soldier there, be merry.",
          "plainText": "Be merry Master Bardolph and my little soldier there be merry",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "silence",
        "name": "SILENCE",
        "displayName": "Silence"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "[Singing.]",
          "plainText": "Singing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "I did not think Master Silence had been a man of this mettle.",
          "plainText": "I did not think Master Silence had been a man of this mettle",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "silence",
        "name": "SILENCE",
        "displayName": "Silence"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Who, I? I have been merry twice and once ere now.",
          "plainText": "Who I I have been merry twice and once ere now",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-stage-003",
      "type": "stage",
      "text": "Enter Davy."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "davy",
        "name": "DAVY",
        "displayName": "Davy"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "[To Bardolph.] There's a dish of leather-coats for you.",
          "plainText": "To Bardolph There's a dish of leathercoats for you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Davy!",
          "plainText": "Davy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "davy",
        "name": "DAVY",
        "displayName": "Davy"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Your worship? I'll be with you straight.",
          "plainText": "Your worship I'll be with you straight",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "[To Bardolph] A cup of wine, sir?",
          "plainText": "To Bardolph A cup of wine sir",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "silence",
        "name": "SILENCE",
        "displayName": "Silence"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "[Singing.]",
          "plainText": "Singing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Well said, Master Silence.",
          "plainText": "Well said Master Silence",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "silence",
        "name": "SILENCE",
        "displayName": "Silence"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "An we shall be merry, now comes in the sweet o' th' night.",
          "plainText": "An we shall be merry now comes in the sweet o' th' night",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Health and long life to you, Master Silence.",
          "plainText": "Health and long life to you Master Silence",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "silence",
        "name": "SILENCE",
        "displayName": "Silence"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "[Singing.]",
          "plainText": "Singing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Honest Bardolph, welcome! If thou want'st anything and wilt not call, beshrew thy heart. Welcome, my little tiny thief, [to the Page] and welcome indeed too. I'll drink to Master Bardolph, and to all the cabileros about London.",
          "plainText": "Honest Bardolph welcome If thou want'st anything and wilt not call beshrew thy heart Welcome my little tiny thief to the Page and welcome indeed too I'll drink to Master Bardolph and to all the cabileros about London",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "davy",
        "name": "DAVY",
        "displayName": "Davy"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "I hope to see London once ere I die.",
          "plainText": "I hope to see London once ere I die",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "An I might see you there, Davy,—",
          "plainText": "An I might see you there Davy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "By the mass, you'll crack a quart together, ha! will you not, Master Bardolph?",
          "plainText": "By the mass you'll crack a quart together ha will you not Master Bardolph",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Yea, sir, in a pottle-pot.",
          "plainText": "Yea sir in a pottlepot",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "By God's liggens, I thank thee. The knave will stick by thee, I can assure thee that. He will not out, he. 'Tis true bred.",
          "plainText": "By God's liggens I thank thee The knave will stick by thee I can assure thee that He will not out he 'Tis true bred",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "And I'll stick by him, sir.",
          "plainText": "And I'll stick by him sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Why, there spoke a king. Lack nothing! Be merry.",
          "plainText": "Why there spoke a king Lack nothing Be merry",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-stage-004",
      "type": "stage",
      "text": "[Knocking within.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-stage-005",
      "type": "stage",
      "text": "[Exit Davy.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "[To Silence, seeing him take off a bumper.] Why, now you have done me right.",
          "plainText": "To Silence seeing him take off a bumper Why now you have done me right",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-031",
      "type": "speech",
      "speaker": {
        "id": "silence",
        "name": "SILENCE",
        "displayName": "Silence"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "[Singing.]",
          "plainText": "Singing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-032",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "'Tis so.",
          "plainText": "'Tis so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-033",
      "type": "speech",
      "speaker": {
        "id": "silence",
        "name": "SILENCE",
        "displayName": "Silence"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Is't so? Why then, say an old man can do somewhat.",
          "plainText": "Is't so Why then say an old man can do somewhat",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-stage-006",
      "type": "stage",
      "text": "Enter Davy."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-034",
      "type": "speech",
      "speaker": {
        "id": "davy",
        "name": "DAVY",
        "displayName": "Davy"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "An't please your worship, there's one Pistol come from the court with news.",
          "plainText": "An't please your worship there's one Pistol come from the court with news",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-035",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "From the court? Let him come in.",
          "plainText": "From the court Let him come in",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-stage-007",
      "type": "stage",
      "text": "Enter Pistol."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-036",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Sir John, God save you!",
          "plainText": "Sir John God save you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-037",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "What wind blew you hither, Pistol?",
          "plainText": "What wind blew you hither Pistol",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-038",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Not the ill wind which blows no man to good. Sweet knight, thou art now one of the greatest men in this realm.",
          "plainText": "Not the ill wind which blows no man to good Sweet knight thou art now one of the greatest men in this realm",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-039",
      "type": "speech",
      "speaker": {
        "id": "silence",
        "name": "SILENCE",
        "displayName": "Silence"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "By'r lady, I think he be, but goodman Puff of Barson.",
          "plainText": "By'r lady I think he be but goodman Puff of Barson",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-040",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Puff!",
          "plainText": "Puff",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "Puff in thy teeth, most recreant coward base!",
          "plainText": "Puff in thy teeth most recreant coward base",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "Sir John, I am thy Pistol and thy friend,",
          "plainText": "Sir John I am thy Pistol and thy friend",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "And helter-skelter have I rode to thee,",
          "plainText": "And helterskelter have I rode to thee",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "And tidings do I bring and lucky joys,",
          "plainText": "And tidings do I bring and lucky joys",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "And golden times, and happy news of price.",
          "plainText": "And golden times and happy news of price",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-041",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "I pray thee now, deliver them like a man of this world.",
          "plainText": "I pray thee now deliver them like a man of this world",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-042",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "A foutre for the world and worldlings base!",
          "plainText": "A foutre for the world and worldlings base",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "I speak of Africa and golden joys.",
          "plainText": "I speak of Africa and golden joys",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-043",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "O base Assyrian knight, what is thy news?",
          "plainText": "O base Assyrian knight what is thy news",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "Let King Cophetua know the truth thereof.",
          "plainText": "Let King Cophetua know the truth thereof",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-044",
      "type": "speech",
      "speaker": {
        "id": "silence",
        "name": "SILENCE",
        "displayName": "Silence"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "[Singing.] And Robin Hood, Scarlet, and John.",
          "plainText": "Singing And Robin Hood Scarlet and John",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-045",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Shall dunghill curs confront the Helicons?",
          "plainText": "Shall dunghill curs confront the Helicons",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "And shall good news be baffled?",
          "plainText": "And shall good news be baffled",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0055",
          "number": 55,
          "speechLineNumber": 3,
          "text": "Then, Pistol, lay thy head in Furies' lap.",
          "plainText": "Then Pistol lay thy head in Furies' lap",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-046",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Honest gentleman, I know not your breeding.",
          "plainText": "Honest gentleman I know not your breeding",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-047",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Why then, lament therefor.",
          "plainText": "Why then lament therefor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-048",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Give me pardon, sir. If, sir, you come with news from the court, I take it there's but two ways, either to utter them, or conceal them. I am, sir, under the King, in some authority.",
          "plainText": "Give me pardon sir If sir you come with news from the court I take it there's but two ways either to utter them or conceal them I am sir under the King in some authority",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-049",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Under which king, Besonian? Speak, or die.",
          "plainText": "Under which king Besonian Speak or die",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-050",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Under King Harry.",
          "plainText": "Under King Harry",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-051",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Harry the Fourth, or Fifth?",
          "plainText": "Harry the Fourth or Fifth",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-052",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Harry the Fourth.",
          "plainText": "Harry the Fourth",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-053",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "A foutre for thine office!",
          "plainText": "A foutre for thine office",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "Sir John, thy tender lambkin now is King;",
          "plainText": "Sir John thy tender lambkin now is King",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "Harry the Fifth's the man. I speak the truth.",
          "plainText": "Harry the Fifth's the man I speak the truth",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "When Pistol lies, do this, and fig me, like",
          "plainText": "When Pistol lies do this and fig me like",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0067",
          "number": 67,
          "speechLineNumber": 5,
          "text": "The bragging Spaniard.",
          "plainText": "The bragging Spaniard",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-054",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "What, is the old King dead?",
          "plainText": "What is the old King dead",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-055",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "As nail in door. The things I speak are just.",
          "plainText": "As nail in door The things I speak are just",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-056",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Away, Bardolph, saddle my horse. Master Robert Shallow, choose what office thou wilt in the land, 'tis thine. Pistol, I will double-charge thee with dignities.",
          "plainText": "Away Bardolph saddle my horse Master Robert Shallow choose what office thou wilt in the land 'tis thine Pistol I will doublecharge thee with dignities",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-057",
      "type": "speech",
      "speaker": {
        "id": "bardolph",
        "name": "BARDOLPH",
        "displayName": "Bardolph"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "O joyful day!",
          "plainText": "O joyful day",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "I would not take a knighthood for my fortune.",
          "plainText": "I would not take a knighthood for my fortune",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-058",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "What! I do bring good news.",
          "plainText": "What I do bring good news",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-059",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Carry Master Silence to bed. Master Shallow, my Lord Shallow, be what thou wilt; I am Fortune's steward! Get on thy boots, we'll ride all night. O sweet Pistol! Away, Bardolph!",
          "plainText": "Carry Master Silence to bed Master Shallow my Lord Shallow be what thou wilt I am Fortune's steward Get on thy boots we'll ride all night O sweet Pistol Away Bardolph",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-stage-008",
      "type": "stage",
      "text": "[Exit Bardolph.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-speech-060",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Let vultures vile seize on his lungs also!",
          "plainText": "Let vultures vile seize on his lungs also",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "\"Where is the life that late I led?\" say they:",
          "plainText": "Where is the life that late I led say they",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-3-line-0077",
          "number": 77,
          "speechLineNumber": 3,
          "text": "Why, here it is; welcome these pleasant days!",
          "plainText": "Why here it is welcome these pleasant days",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-3-stage-009",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}