    "label": "Act 5, Scene 5",
    "title": "SCENE V. A public place near Westminster Abbey.",
    "location": "A public place near Westminster Abbey.",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-stage-001",
      "type": "stage",
      "text": "Enter two Grooms, strewing rushes."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-groom",
        "name": "FIRST GROOM",
        "displayName": "First Groom"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "More rushes, more rushes.",
          "plainText": "More rushes more rushes",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "second-groom",
        "name": "SECOND GROOM",
        "displayName": "Second Groom"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "The trumpets have sounded twice.",
          "plainText": "The trumpets have sounded twice",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-groom",
        "name": "FIRST GROOM",
        "displayName": "First Groom"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "'Twill be two o'clock ere they come from the coronation. Dispatch, dispatch.",
          "plainText": "'Twill be two o'clock ere they come from the coronation Dispatch dispatch",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-stage-003",
      "type": "stage",
      "text": "Trumpets sound, and the King and his train pass over the stage. Enter Falstaff, Shallow, Pistol, Bardolph and Page."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Stand here by me, Master Robert Shallow. I will make the King do you grace. I will leer upon him as he comes by, and do but mark the countenance that he will give me.",
          "plainText": "Stand here by me Master Robert Shallow I will make the King do you grace I will leer upon him as he comes by and do but mark the countenance that he will give me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "God bless thy lungs, good knight!",
          "plainText": "God bless thy lungs good knight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Come here, Pistol, stand behind me. O, if I had had time to have made new liveries, I would have bestowed the thousand pound I borrowed of you. But 'tis no matter, this poor show doth better. This doth infer the zeal I had to see him.",
          "plainText": "Come here Pistol stand behind me O if I had had time to have made new liveries I would have bestowed the thousand pound I borrowed of you But 'tis no matter this poor show doth better This doth infer the zeal I had to see him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "It doth so.",
          "plainText": "It doth so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "It shows my earnestness of affection—",
          "plainText": "It shows my earnestness of affection",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "It doth so.",
          "plainText": "It doth so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "My devotion—",
          "plainText": "My devotion",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "It doth, it doth, it doth.",
          "plainText": "It doth it doth it doth",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "As it were, to ride day and night, and not to deliberate, not to remember, not to have patience to shift me—",
          "plainText": "As it were to ride day and night and not to deliberate not to remember not to have patience to shift me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "It is best, certain.",
          "plainText": "It is best certain",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "But to stand stained with travel, and sweating with desire to see him, thinking of nothing else, putting all affairs else in oblivion, as if there were nothing else to be done but to see him.",
          "plainText": "But to stand stained with travel and sweating with desire to see him thinking of nothing else putting all affairs else in oblivion as if there were nothing else to be done but to see him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "'Tis semper idem, for obsque hoc nihil est; 'tis all in every part.",
          "plainText": "'Tis semper idem for obsque hoc nihil est 'tis all in every part",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "'Tis so, indeed.",
          "plainText": "'Tis so indeed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "My knight, I will inflame thy noble liver,",
          "plainText": "My knight I will inflame thy noble liver",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "And make thee rage.",
          "plainText": "And make thee rage",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Thy Doll, and Helen of thy noble thoughts,",
          "plainText": "Thy Doll and Helen of thy noble thoughts",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "Is in base durance and contagious prison,",
          "plainText": "Is in base durance and contagious prison",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Haled thither",
          "plainText": "Haled thither",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "By most mechanical and dirty hand.",
          "plainText": "By most mechanical and dirty hand",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0023",
          "number": 23,
          "speechLineNumber": 7,
          "text": "Rouse up revenge from ebon den with fell Alecto's snake,",
          "plainText": "Rouse up revenge from ebon den with fell Alecto's snake",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0024",
          "number": 24,
          "speechLineNumber": 8,
          "text": "For Doll is in. Pistol speaks nought but truth.",
          "plainText": "For Doll is in Pistol speaks nought but truth",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "I will deliver her.",
          "plainText": "I will deliver her",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-stage-004",
      "type": "stage",
      "text": "[Shouts within. The trumpets sound.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "There roar'd the sea, and trumpet-clangor sounds.",
          "plainText": "There roar'd the sea and trumpetclangor sounds",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-stage-005",
      "type": "stage",
      "text": "Enter the King and his train, the Lord Chief Justice among them."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "God save thy Grace, King Hal, my royal Hal!",
          "plainText": "God save thy Grace King Hal my royal Hal",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "The heavens thee guard and keep, most royal imp of fame!",
          "plainText": "The heavens thee guard and keep most royal imp of fame",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "God save thee, my sweet boy!",
          "plainText": "God save thee my sweet boy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "My Lord Chief Justice, speak to that vain man.",
          "plainText": "My Lord Chief Justice speak to that vain man",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "chief-justice",
        "name": "CHIEF JUSTICE",
        "displayName": "Chief Justice"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Have you your wits? Know you what 'tis you speak?",
          "plainText": "Have you your wits Know you what 'tis you speak",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "My King! My Jove! I speak to thee, my heart!",
          "plainText": "My King My Jove I speak to thee my heart",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "king",
        "name": "KING",
        "displayName": "King"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "I know thee not, old man. Fall to thy prayers.",
          "plainText": "I know thee not old man Fall to thy prayers",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "How ill white hairs becomes a fool and jester!",
          "plainText": "How ill white hairs becomes a fool and jester",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "I have long dreamt of such a kind of man,",
          "plainText": "I have long dreamt of such a kind of man",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "So surfeit-swell'd, so old, and so profane;",
          "plainText": "So surfeitswell'd so old and so profane",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0037",
          "number": 37,
          "speechLineNumber": 5,
          "text": "But, being awaked, I do despise my dream.",
          "plainText": "But being awaked I do despise my dream",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0038",
          "number": 38,
          "speechLineNumber": 6,
          "text": "Make less thy body hence, and more thy grace;",
          "plainText": "Make less thy body hence and more thy grace",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0039",
          "number": 39,
          "speechLineNumber": 7,
          "text": "Leave gormandizing; know the grave doth gape",
          "plainText": "Leave gormandizing know the grave doth gape",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0040",
          "number": 40,
          "speechLineNumber": 8,
          "text": "For thee thrice wider than for other men.",
          "plainText": "For thee thrice wider than for other men",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0041",
          "number": 41,
          "speechLineNumber": 9,
          "text": "Reply not to me with a fool-born jest.",
          "plainText": "Reply not to me with a foolborn jest",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0042",
          "number": 42,
          "speechLineNumber": 10,
          "text": "Presume not that I am the thing I was;",
          "plainText": "Presume not that I am the thing I was",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0043",
          "number": 43,
          "speechLineNumber": 11,
          "text": "For God doth know, so shall the world perceive,",
          "plainText": "For God doth know so shall the world perceive",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0044",
          "number": 44,
          "speechLineNumber": 12,
          "text": "That I have turn'd away my former self;",
          "plainText": "That I have turn'd away my former self",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0045",
          "number": 45,
          "speechLineNumber": 13,
          "text": "So will I those that kept me company.",
          "plainText": "So will I those that kept me company",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0046",
          "number": 46,
          "speechLineNumber": 14,
          "text": "When thou dost hear I am as I have been,",
          "plainText": "When thou dost hear I am as I have been",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0047",
          "number": 47,
          "speechLineNumber": 15,
          "text": "Approach me, and thou shalt be as thou wast,",
          "plainText": "Approach me and thou shalt be as thou wast",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0048",
          "number": 48,
          "speechLineNumber": 16,
          "text": "The tutor and the feeder of my riots.",
          "plainText": "The tutor and the feeder of my riots",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0049",
          "number": 49,
          "speechLineNumber": 17,
          "text": "Till then I banish thee, on pain of death,",
          "plainText": "Till then I banish thee on pain of death",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0050",
          "number": 50,
          "speechLineNumber": 18,
          "text": "As I have done the rest of my misleaders,",
          "plainText": "As I have done the rest of my misleaders",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0051",
          "number": 51,
          "speechLineNumber": 19,
          "text": "Not to come near our person by ten mile.",
          "plainText": "Not to come near our person by ten mile",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0052",
          "number": 52,
          "speechLineNumber": 20,
          "text": "For competence of life I will allow you,",
          "plainText": "For competence of life I will allow you",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0053",
          "number": 53,
          "speechLineNumber": 21,
          "text": "That lack of means enforce you not to evils.",
          "plainText": "That lack of means enforce you not to evils",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0054",
          "number": 54,
          "speechLineNumber": 22,
          "text": "And, as we hear you do reform yourselves,",
          "plainText": "And as we hear you do reform yourselves",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0055",
          "number": 55,
          "speechLineNumber": 23,
          "text": "We will, according to your strengths and qualities,",
          "plainText": "We will according to your strengths and qualities",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0056",
          "number": 56,
          "speechLineNumber": 24,
          "text": "Give you advancement. Be it your charge, my lord,",
          "plainText": "Give you advancement Be it your charge my lord",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0057",
          "number": 57,
          "speechLineNumber": 25,
          "text": "To see perform'd the tenor of our word.",
          "plainText": "To see perform'd the tenor of our word",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0058",
          "number": 58,
          "speechLineNumber": 26,
          "text": "Set on.",
          "plainText": "Set on",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-stage-006",
      "type": "stage",
      "text": "[Exeunt King with his train.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-027",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Master Shallow, I owe you a thousand pounds.",
          "plainText": "Master Shallow I owe you a thousand pounds",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-028",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Yea, marry, Sir John, which I beseech you to let me have home with me.",
          "plainText": "Yea marry Sir John which I beseech you to let me have home with me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-029",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "That can hardly be, Master Shallow. Do not you grieve at this; I shall be sent for in private to him. Look you, he must seem thus to the world. Fear not your advancements; I will be the man yet that shall make you great.",
          "plainText": "That can hardly be Master Shallow Do not you grieve at this I shall be sent for in private to him Look you he must seem thus to the world Fear not your advancements I will be the man yet that shall make you great",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-030",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "I cannot perceive how, unless you give me your doublet and stuff me out with straw. I beseech you, good Sir John, let me have five hundred of my thousand.",
          "plainText": "I cannot perceive how unless you give me your doublet and stuff me out with straw I beseech you good Sir John let me have five hundred of my thousand",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-031",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Sir, I will be as good as my word. This that you heard was but a colour.",
          "plainText": "Sir I will be as good as my word This that you heard was but a colour",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-032",
      "type": "speech",
      "speaker": {
        "id": "shallow",
        "name": "SHALLOW",
        "displayName": "Shallow"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "A colour that I fear you will die in, Sir John.",
          "plainText": "A colour that I fear you will die in Sir John",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-033",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Fear no colours. Go with me to dinner. Come, Lieutenant Pistol; come, Bardolph. I shall be sent for soon at night.",
          "plainText": "Fear no colours Go with me to dinner Come Lieutenant Pistol come Bardolph I shall be sent for soon at night",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-stage-007",
      "type": "stage",
      "text": "Enter the Lord Chief Justice and Prince John, Officers with them."
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-034",
      "type": "speech",
      "speaker": {
        "id": "chief-justice",
        "name": "CHIEF JUSTICE",
        "displayName": "Chief Justice"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Go, carry Sir John Falstaff to the Fleet.",
          "plainText": "Go carry Sir John Falstaff to the Fleet",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "Take all his company along with him.",
          "plainText": "Take all his company along with him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-035",
      "type": "speech",
      "speaker": {
        "id": "falstaff",
        "name": "FALSTAFF",
        "displayName": "Falstaff"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "My lord, my lord,—",
          "plainText": "My lord my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-036",
      "type": "speech",
      "speaker": {
        "id": "chief-justice",
        "name": "CHIEF JUSTICE",
        "displayName": "Chief Justice"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "I cannot now speak. I will hear you soon.",
          "plainText": "I cannot now speak I will hear you soon",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "Take them away.",
          "plainText": "Take them away",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-037",
      "type": "speech",
      "speaker": {
        "id": "pistol",
        "name": "PISTOL",
        "displayName": "Pistol"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Si fortuna me tormenta, spero me contenta.",
          "plainText": "Si fortuna me tormenta spero me contenta",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-stage-008",
      "type": "stage",
      "text": "[Exeunt all but Prince John and the Lord Chief Justice.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-038",
      "type": "speech",
      "speaker": {
        "id": "lancaster",
        "name": "LANCASTER",
        "displayName": "Lancaster"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "I like this fair proceeding of the King's.",
          "plainText": "I like this fair proceeding of the King's",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "He hath intent his wonted followers",
          "plainText": "He hath intent his wonted followers",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0074",
          "number": 74,
          "speechLineNumber": 3,
          "text": "Shall all be very well provided for,",
          "plainText": "Shall all be very well provided for",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0075",
          "number": 75,
          "speechLineNumber": 4,
          "text": "But all are banish'd till their conversations",
          "plainText": "But all are banish'd till their conversations",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0076",
          "number": 76,
          "speechLineNumber": 5,
          "text": "Appear more wise and modest to the world.",
          "plainText": "Appear more wise and modest to the world",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-039",
      "type": "speech",
      "speaker": {
        "id": "chief-justice",
        "name": "CHIEF JUSTICE",
        "displayName": "Chief Justice"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "And so they are.",
          "plainText": "And so they are",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-040",
      "type": "speech",
      "speaker": {
        "id": "lancaster",
        "name": "LANCASTER",
        "displayName": "Lancaster"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "The King hath call'd his parliament, my lord.",
          "plainText": "The King hath call'd his parliament my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-041",
      "type": "speech",
      "speaker": {
        "id": "chief-justice",
        "name": "CHIEF JUSTICE",
        "displayName": "Chief Justice"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "He hath.",
          "plainText": "He hath",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-speech-042",
      "type": "speech",
      "speaker": {
        "id": "lancaster",
        "name": "LANCASTER",
        "displayName": "Lancaster"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "I will lay odds that, ere this year expire,",
          "plainText": "I will lay odds that ere this year expire",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0081",
          "number": 81,
          "speechLineNumber": 2,
          "text": "We bear our civil swords and native fire",
          "plainText": "We bear our civil swords and native fire",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0082",
          "number": 82,
          "speechLineNumber": 3,
          "text": "As far as France. I heard a bird so sing,",
          "plainText": "As far as France I heard a bird so sing",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0083",
          "number": 83,
          "speechLineNumber": 4,
          "text": "Whose music, to my thinking, pleased the King.",
          "plainText": "Whose music to my thinking pleased the King",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-fourth-5-5-line-0084",
          "number": 84,
          "speechLineNumber": 5,
          "text": "Come, will you hence?",
          "plainText": "Come will you hence",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-fourth-5-5-stage-009",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}