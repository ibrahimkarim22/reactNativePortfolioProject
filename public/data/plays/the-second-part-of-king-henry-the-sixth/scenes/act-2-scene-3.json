    "label": "Act 2, Scene 3",
    "title": "SCENE III. A Hall of Justice",
    "location": "A Hall of Justice",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-stage-001",
      "type": "stage",
      "text": "Sound trumpets. Enter the King, the Queen, Gloucester, York, Suffolk and Salisbury; the Duchess of Gloucester, Margery Jourdain, Southwell, Hume and Bolingbroke under guard."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Stand forth, Dame Eleanor Cobham, Gloucester's wife.",
          "plainText": "Stand forth Dame Eleanor Cobham Gloucester's wife",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "In sight of God and us, your guilt is great;",
          "plainText": "In sight of God and us your guilt is great",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Receive the sentence of the law for sins",
          "plainText": "Receive the sentence of the law for sins",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Such as by God's book are adjudged to death.",
          "plainText": "Such as by God's book are adjudged to death",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "You four, from hence to prison back again;",
          "plainText": "You four from hence to prison back again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "From thence unto the place of execution.",
          "plainText": "From thence unto the place of execution",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "The witch in Smithfield shall be burnt to ashes,",
          "plainText": "The witch in Smithfield shall be burnt to ashes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "And you three shall be strangled on the gallows.",
          "plainText": "And you three shall be strangled on the gallows",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "You, madam, for you are more nobly born,",
          "plainText": "You madam for you are more nobly born",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Despoiled of your honour in your life,",
          "plainText": "Despoiled of your honour in your life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Shall, after three days' open penance done,",
          "plainText": "Shall after three days' open penance done",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "Live in your country here in banishment,",
          "plainText": "Live in your country here in banishment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "With Sir John Stanley in the Isle of Man.",
          "plainText": "With Sir John Stanley in the Isle of Man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "eleanor",
        "name": "ELEANOR",
        "displayName": "Eleanor"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Welcome is banishment; welcome were my death.",
          "plainText": "Welcome is banishment welcome were my death",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Eleanor, the law, thou seest, hath judged thee.",
          "plainText": "Eleanor the law thou seest hath judged thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "I cannot justify whom the law condemns.",
          "plainText": "I cannot justify whom the law condemns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-stage-002",
      "type": "stage",
      "text": "[Exeunt Duchess and the other prisoners, guarded.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Stay, Humphrey Duke of Gloucester. Ere thou go,",
          "plainText": "Stay Humphrey Duke of Gloucester Ere thou go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Give up thy staff. Henry will to himself",
          "plainText": "Give up thy staff Henry will to himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Protector be; and God shall be my hope,",
          "plainText": "Protector be and God shall be my hope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "My stay, my guide, and lantern to my feet.",
          "plainText": "My stay my guide and lantern to my feet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "And go in peace, Humphrey, no less beloved",
          "plainText": "And go in peace Humphrey no less beloved",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 6,
          "text": "Than when thou wert Protector to thy king.",
          "plainText": "Than when thou wert Protector to thy king",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "I see no reason why a king of years",
          "plainText": "I see no reason why a king of years",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Should be to be protected like a child.",
          "plainText": "Should be to be protected like a child",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "God and King Henry govern England's realm!",
          "plainText": "God and King Henry govern England's realm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "Give up your staff, sir, and the King his realm.",
          "plainText": "Give up your staff sir and the King his realm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "gloucester",
        "name": "GLOUCESTER",
        "displayName": "Gloucester"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "My staff? Here, noble Henry, is my staff.",
          "plainText": "My staff Here noble Henry is my staff",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "As willingly do I the same resign",
          "plainText": "As willingly do I the same resign",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "As e'er thy father Henry made it mine;",
          "plainText": "As e'er thy father Henry made it mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 4,
          "text": "And even as willingly at thy feet I leave it",
          "plainText": "And even as willingly at thy feet I leave it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 5,
          "text": "As others would ambitiously receive it.",
          "plainText": "As others would ambitiously receive it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 6,
          "text": "Farewell, good King. When I am dead and gone,",
          "plainText": "Farewell good King When I am dead and gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 7,
          "text": "May honourable peace attend thy throne.",
          "plainText": "May honourable peace attend thy throne",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Why, now is Henry King and Margaret Queen,",
          "plainText": "Why now is Henry King and Margaret Queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "And Humphrey Duke of Gloucester scarce himself,",
          "plainText": "And Humphrey Duke of Gloucester scarce himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "That bears so shrewd a maim. Two pulls at once;",
          "plainText": "That bears so shrewd a maim Two pulls at once",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "His lady banished, and a limb lopped off.",
          "plainText": "His lady banished and a limb lopped off",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "This staff of honour raught, there let it stand",
          "plainText": "This staff of honour raught there let it stand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0039",
          "number": 39,
          "speechLineNumber": 6,
          "text": "Where it best fits to be, in Henry's hand.",
          "plainText": "Where it best fits to be in Henry's hand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "suffolk",
        "name": "SUFFOLK",
        "displayName": "Suffolk"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Thus droops this lofty pine and hangs his sprays;",
          "plainText": "Thus droops this lofty pine and hangs his sprays",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Thus Eleanor's pride dies in her youngest days.",
          "plainText": "Thus Eleanor's pride dies in her youngest days",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Lords, let him go.—Please it your majesty,",
          "plainText": "Lords let him goPlease it your majesty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "This is the day appointed for the combat,",
          "plainText": "This is the day appointed for the combat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "And ready are the appellant and defendant,",
          "plainText": "And ready are the appellant and defendant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0045",
          "number": 45,
          "speechLineNumber": 4,
          "text": "The armourer and his man, to enter the lists,",
          "plainText": "The armourer and his man to enter the lists",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0046",
          "number": 46,
          "speechLineNumber": 5,
          "text": "So please your highness to behold the fight.",
          "plainText": "So please your highness to behold the fight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Ay, good my lord; for purposely therefore",
          "plainText": "Ay good my lord for purposely therefore",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "Left I the court to see this quarrel tried.",
          "plainText": "Left I the court to see this quarrel tried",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "I' God's name, see the lists and all things fit.",
          "plainText": "I' God's name see the lists and all things fit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Here let them end it, and God defend the right!",
          "plainText": "Here let them end it and God defend the right",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "I never saw a fellow worse bested,",
          "plainText": "I never saw a fellow worse bested",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "Or more afraid to fight, than is the appellant,",
          "plainText": "Or more afraid to fight than is the appellant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "The servant of his armourer, my lords.",
          "plainText": "The servant of his armourer my lords",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-stage-004",
      "type": "stage",
      "text": "Enter at one door Horner the armourer, and his Neighbours, drinking to him so much that he is drunk; and he enters with a drum before him and his staff with a sandbag fastened to it; and at the other door Peter, his man, with a drum and sandbag, and Prentices drinking to him."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "1-neighbour",
        "name": "1 NEIGHBOUR",
        "displayName": "1 Neighbour"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Here, neighbour Horner, I drink to you in a cup of sack; and fear not, neighbour, you shall do well enough.",
          "plainText": "Here neighbour Horner I drink to you in a cup of sack and fear not neighbour you shall do well enough",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "2-neighbour",
        "name": "2 NEIGHBOUR",
        "displayName": "2 Neighbour"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "And here, neighbour, here's a cup of charneco.",
          "plainText": "And here neighbour here's a cup of charneco",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "3-neighbour",
        "name": "3 NEIGHBOUR",
        "displayName": "3 Neighbour"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "And here's a pot of good double beer, neighbour. Drink, and fear not your man.",
          "plainText": "And here's a pot of good double beer neighbour Drink and fear not your man",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "horner",
        "name": "HORNER",
        "displayName": "Horner"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Let it come, i' faith, and I'll pledge you all; and a fig for Peter!",
          "plainText": "Let it come i' faith and I'll pledge you all and a fig for Peter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "1-prentice",
        "name": "1 PRENTICE",
        "displayName": "1 Prentice"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Here, Peter, I drink to thee, and be not afraid.",
          "plainText": "Here Peter I drink to thee and be not afraid",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "2-prentice",
        "name": "2 PRENTICE",
        "displayName": "2 Prentice"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Be merry, Peter, and fear not thy master. Fight for credit of the prentices.",
          "plainText": "Be merry Peter and fear not thy master Fight for credit of the prentices",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "peter",
        "name": "PETER",
        "displayName": "Peter"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "I thank you all. Drink, and pray for me, I pray you, for I think I have taken my last draught in this world. Here, Robin, an if I die, I give thee my apron; and, Will, thou shalt have my hammer; and here, Tom, take all the money that I have. O Lord bless me! I pray God, for I am never able to deal with my master, he hath learnt so much fence already.",
          "plainText": "I thank you all Drink and pray for me I pray you for I think I have taken my last draught in this world Here Robin an if I die I give thee my apron and Will thou shalt have my hammer and here Tom take all the money that I have O Lord bless me I pray God for I am never able to deal with my master he hath learnt so much fence already",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "salisbury",
        "name": "SALISBURY",
        "displayName": "Salisbury"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Come, leave your drinking and fall to blows.",
          "plainText": "Come leave your drinking and fall to blows",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "Sirrah, what's thy name?",
          "plainText": "Sirrah what's thy name",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "peter",
        "name": "PETER",
        "displayName": "Peter"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Peter, forsooth.",
          "plainText": "Peter forsooth",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "salisbury",
        "name": "SALISBURY",
        "displayName": "Salisbury"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Peter? What more?",
          "plainText": "Peter What more",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "peter",
        "name": "PETER",
        "displayName": "Peter"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Thump.",
          "plainText": "Thump",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "salisbury",
        "name": "SALISBURY",
        "displayName": "Salisbury"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Thump! Then see thou thump thy master well.",
          "plainText": "Thump Then see thou thump thy master well",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "horner",
        "name": "HORNER",
        "displayName": "Horner"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Masters, I am come hither, as it were, upon my man's instigation, to prove him a knave and myself an honest man; and touching the Duke of York, I will take my death I never meant him any ill, nor the King, nor the Queen; and therefore, Peter, have at thee with a downright blow!",
          "plainText": "Masters I am come hither as it were upon my man's instigation to prove him a knave and myself an honest man and touching the Duke of York I will take my death I never meant him any ill nor the King nor the Queen and therefore Peter have at thee with a downright blow",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Dispatch! This knave's tongue begins to double.",
          "plainText": "Dispatch This knave's tongue begins to double",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "Sound, trumpets. Alarum to the combatants!",
          "plainText": "Sound trumpets Alarum to the combatants",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-stage-005",
      "type": "stage",
      "text": "[They fight, and Peter strikes him down.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "horner",
        "name": "HORNER",
        "displayName": "Horner"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Hold, Peter, hold! I confess, I confess treason.",
          "plainText": "Hold Peter hold I confess I confess treason",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-stage-006",
      "type": "stage",
      "text": "[Dies.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Take away his weapon.—Fellow, thank God and the good wine in thy master's way.",
          "plainText": "Take away his weaponFellow thank God and the good wine in thy master's way",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "peter",
        "name": "PETER",
        "displayName": "Peter"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "O God, have I overcome mine enemies in this presence? O Peter, thou hast prevailed in right!",
          "plainText": "O God have I overcome mine enemies in this presence O Peter thou hast prevailed in right",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Go, take hence that traitor from our sight,",
          "plainText": "Go take hence that traitor from our sight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0074",
          "number": 74,
          "speechLineNumber": 2,
          "text": "For by his death we do perceive his guilt.",
          "plainText": "For by his death we do perceive his guilt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0075",
          "number": 75,
          "speechLineNumber": 3,
          "text": "And God in justice hath revealed to us",
          "plainText": "And God in justice hath revealed to us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0076",
          "number": 76,
          "speechLineNumber": 4,
          "text": "The truth and innocence of this poor fellow,",
          "plainText": "The truth and innocence of this poor fellow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0077",
          "number": 77,
          "speechLineNumber": 5,
          "text": "Which he had thought to have murdered wrongfully.",
          "plainText": "Which he had thought to have murdered wrongfully",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-2-3-line-0078",
          "number": 78,
          "speechLineNumber": 6,
          "text": "Come, fellow, follow us for thy reward.",
          "plainText": "Come fellow follow us for thy reward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-2-3-stage-007",
      "type": "stage",
      "text": "[Sound a flourish. Exeunt.]"
    }
  ]
}