  "scene": {
    "id": "the-second-part-of-king-henry-the-sixth-3-3",
    "act": 3,
    "scene": 3,
    "label": "Act 3, Scene 3",
    "title": "SCENE III. A Bedchamber",
    "location": "A Bedchamber",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-stage-001",
      "type": "stage",
      "text": "Enter the King, Salisbury and Warwick, to the Cardinal in bed."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "How fares my lord? Speak, Beaufort, to thy sovereign.",
          "plainText": "How fares my lord Speak Beaufort to thy sovereign",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "cardinal",
        "name": "CARDINAL",
        "displayName": "Cardinal"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "If thou be'st Death, I'll give thee England's treasure,",
          "plainText": "If thou be'st Death I'll give thee England's treasure",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Enough to purchase such another island,",
          "plainText": "Enough to purchase such another island",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "So thou wilt let me live and feel no pain.",
          "plainText": "So thou wilt let me live and feel no pain",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Ah, what a sign it is of evil life",
          "plainText": "Ah what a sign it is of evil life",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Where death's approach is seen so terrible!",
          "plainText": "Where death's approach is seen so terrible",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Beaufort, it is thy sovereign speaks to thee.",
          "plainText": "Beaufort it is thy sovereign speaks to thee",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cardinal",
        "name": "CARDINAL",
        "displayName": "Cardinal"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Bring me unto my trial when you will.",
          "plainText": "Bring me unto my trial when you will",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Died he not in his bed? Where should he die?",
          "plainText": "Died he not in his bed Where should he die",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Can I make men live, whe'er they will or no?",
          "plainText": "Can I make men live whe'er they will or no",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "O, torture me no more! I will confess.",
          "plainText": "O torture me no more I will confess",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "Alive again? Then show me where he is.",
          "plainText": "Alive again Then show me where he is",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "I'll give a thousand pound to look upon him.",
          "plainText": "I'll give a thousand pound to look upon him",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 7,
          "text": "He hath no eyes, the dust hath blinded them.",
          "plainText": "He hath no eyes the dust hath blinded them",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 8,
          "text": "Comb down his hair; look, look, it stands upright,",
          "plainText": "Comb down his hair look look it stands upright",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 9,
          "text": "Like lime-twigs set to catch my winged soul.",
          "plainText": "Like limetwigs set to catch my winged soul",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 10,
          "text": "Give me some drink, and bid the apothecary",
          "plainText": "Give me some drink and bid the apothecary",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 11,
          "text": "Bring the strong poison that I bought of him.",
          "plainText": "Bring the strong poison that I bought of him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "O Thou eternal mover of the heavens,",
          "plainText": "O Thou eternal mover of the heavens",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Look with a gentle eye upon this wretch!",
          "plainText": "Look with a gentle eye upon this wretch",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "O, beat away the busy meddling fiend",
          "plainText": "O beat away the busy meddling fiend",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "That lays strong siege unto this wretch's soul,",
          "plainText": "That lays strong siege unto this wretch's soul",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "And from his bosom purge this black despair!",
          "plainText": "And from his bosom purge this black despair",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "See how the pangs of death do make him grin!",
          "plainText": "See how the pangs of death do make him grin",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "salisbury",
        "name": "SALISBURY",
        "displayName": "Salisbury"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Disturb him not; let him pass peaceably.",
          "plainText": "Disturb him not let him pass peaceably",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Peace to his soul, if God's good pleasure be!",
          "plainText": "Peace to his soul if God's good pleasure be",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "Lord Cardinal, if thou think'st on heaven's bliss,",
          "plainText": "Lord Cardinal if thou think'st on heaven's bliss",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "Hold up thy hand, make signal of thy hope.",
          "plainText": "Hold up thy hand make signal of thy hope",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "He dies and makes no sign. O God, forgive him!",
          "plainText": "He dies and makes no sign O God forgive him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "So bad a death argues a monstrous life.",
          "plainText": "So bad a death argues a monstrous life",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Forbear to judge, for we are sinners all.",
          "plainText": "Forbear to judge for we are sinners all",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Close up his eyes, and draw the curtain close,",
          "plainText": "Close up his eyes and draw the curtain close",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-3-3-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "And let us all to meditation.",
          "plainText": "And let us all to meditation",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-3-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}