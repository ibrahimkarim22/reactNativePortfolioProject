          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Farewell, my lord. Trust not the Kentish rebels.",
          "plainText": "Farewell my lord Trust not the Kentish rebels",
          "lineType": "prose"
