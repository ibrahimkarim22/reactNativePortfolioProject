  "scene": {
    "id": "the-second-part-of-king-henry-the-sixth-4-4",
    "act": 4,
    "scene": 4,
    "label": "Act 4, Scene 4",
    "title": "SCENE IV. London. The Palace",
    "location": "London. The Palace",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-stage-001",
      "type": "stage",
      "text": "Enter the King with a supplication, and the Queen with Suffolk's head, the Duke of Buckingham and the Lord Saye."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "[Aside.] Oft have I heard that grief softens the mind",
          "plainText": "Aside Oft have I heard that grief softens the mind",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And makes it fearful and degenerate;",
          "plainText": "And makes it fearful and degenerate",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Think therefore on revenge and cease to weep.",
          "plainText": "Think therefore on revenge and cease to weep",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "But who can cease to weep and look on this?",
          "plainText": "But who can cease to weep and look on this",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Here may his head lie on my throbbing breast;",
          "plainText": "Here may his head lie on my throbbing breast",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "But where's the body that I should embrace?",
          "plainText": "But where's the body that I should embrace",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "buckingham",
        "name": "BUCKINGHAM",
        "displayName": "Buckingham"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "What answer makes your grace to the rebels' supplication?",
          "plainText": "What answer makes your grace to the rebels' supplication",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I'll send some holy bishop to entreat,",
          "plainText": "I'll send some holy bishop to entreat",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "For God forbid so many simple souls",
          "plainText": "For God forbid so many simple souls",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Should perish by the sword! And I myself,",
          "plainText": "Should perish by the sword And I myself",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Rather than bloody war shall cut them short,",
          "plainText": "Rather than bloody war shall cut them short",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "Will parley with Jack Cade their general.",
          "plainText": "Will parley with Jack Cade their general",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "But stay, I'll read it over once again.",
          "plainText": "But stay I'll read it over once again",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "[Aside.] Ah, barbarous villains! Hath this lovely face",
          "plainText": "Aside Ah barbarous villains Hath this lovely face",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Ruled, like a wandering planet, over me,",
          "plainText": "Ruled like a wandering planet over me",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "And could it not enforce them to relent",
          "plainText": "And could it not enforce them to relent",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "That were unworthy to behold the same?",
          "plainText": "That were unworthy to behold the same",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Lord Saye, Jack Cade hath sworn to have thy head.",
          "plainText": "Lord Saye Jack Cade hath sworn to have thy head",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "saye",
        "name": "SAYE",
        "displayName": "Saye"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Ay, but I hope your highness shall have his.",
          "plainText": "Ay but I hope your highness shall have his",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "How now, madam?",
          "plainText": "How now madam",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Still lamenting and mourning for Suffolk's death?",
          "plainText": "Still lamenting and mourning for Suffolk's death",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "I fear me, love, if that I had been dead,",
          "plainText": "I fear me love if that I had been dead",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "Thou wouldst not have mourned so much for me.",
          "plainText": "Thou wouldst not have mourned so much for me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "No, my love, I should not mourn, but die for thee.",
          "plainText": "No my love I should not mourn but die for thee",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-stage-002",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "How now, what news? Why com'st thou in such haste?",
          "plainText": "How now what news Why com'st thou in such haste",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "The rebels are in Southwark; fly, my lord!",
          "plainText": "The rebels are in Southwark fly my lord",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "Jack Cade proclaims himself Lord Mortimer,",
          "plainText": "Jack Cade proclaims himself Lord Mortimer",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "Descended from the Duke of Clarence' house,",
          "plainText": "Descended from the Duke of Clarence' house",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "And calls your grace usurper openly,",
          "plainText": "And calls your grace usurper openly",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0030",
          "number": 30,
          "speechLineNumber": 5,
          "text": "And vows to crown himself in Westminster.",
          "plainText": "And vows to crown himself in Westminster",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0031",
          "number": 31,
          "speechLineNumber": 6,
          "text": "His army is a ragged multitude",
          "plainText": "His army is a ragged multitude",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0032",
          "number": 32,
          "speechLineNumber": 7,
          "text": "Of hinds and peasants, rude and merciless.",
          "plainText": "Of hinds and peasants rude and merciless",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0033",
          "number": 33,
          "speechLineNumber": 8,
          "text": "Sir Humphrey Stafford and his brother's death",
          "plainText": "Sir Humphrey Stafford and his brother's death",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0034",
          "number": 34,
          "speechLineNumber": 9,
          "text": "Hath given them heart and courage to proceed.",
          "plainText": "Hath given them heart and courage to proceed",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0035",
          "number": 35,
          "speechLineNumber": 10,
          "text": "All scholars, lawyers, courtiers, gentlemen,",
          "plainText": "All scholars lawyers courtiers gentlemen",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0036",
          "number": 36,
          "speechLineNumber": 11,
          "text": "They call false caterpillars, and intend their death.",
          "plainText": "They call false caterpillars and intend their death",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "O graceless men! They know not what they do.",
          "plainText": "O graceless men They know not what they do",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "buckingham",
        "name": "BUCKINGHAM",
        "displayName": "Buckingham"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "My gracious lord, retire to Killingworth",
          "plainText": "My gracious lord retire to Killingworth",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "Until a power be raised to put them down.",
          "plainText": "Until a power be raised to put them down",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Ah, were the Duke of Suffolk now alive,",
          "plainText": "Ah were the Duke of Suffolk now alive",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "These Kentish rebels would be soon appeased!",
          "plainText": "These Kentish rebels would be soon appeased",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Lord Saye, the traitors hate thee;",
          "plainText": "Lord Saye the traitors hate thee",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "Therefore away with us to Killingworth.",
          "plainText": "Therefore away with us to Killingworth",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "saye",
        "name": "SAYE",
        "displayName": "Saye"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "So might your grace's person be in danger.",
          "plainText": "So might your grace's person be in danger",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "The sight of me is odious in their eyes;",
          "plainText": "The sight of me is odious in their eyes",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "And therefore in this city will I stay",
          "plainText": "And therefore in this city will I stay",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "And live alone as secret as I may.",
          "plainText": "And live alone as secret as I may",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-stage-003",
      "type": "stage",
      "text": "Enter another Messenger."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Jack Cade hath gotten London Bridge;",
          "plainText": "Jack Cade hath gotten London Bridge",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "The citizens fly and forsake their houses.",
          "plainText": "The citizens fly and forsake their houses",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "The rascal people, thirsting after prey,",
          "plainText": "The rascal people thirsting after prey",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "Join with the traitor, and they jointly swear",
          "plainText": "Join with the traitor and they jointly swear",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0052",
          "number": 52,
          "speechLineNumber": 5,
          "text": "To spoil the city and your royal court.",
          "plainText": "To spoil the city and your royal court",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "buckingham",
        "name": "BUCKINGHAM",
        "displayName": "Buckingham"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Then linger not, my lord; away, take horse!",
          "plainText": "Then linger not my lord away take horse",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-4-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Come, Margaret. God, our hope, will succour us.",
          "plainText": "Come Margaret God our hope will succour us",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
