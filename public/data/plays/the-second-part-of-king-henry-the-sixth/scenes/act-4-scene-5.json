  "content": [
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-5-stage-001",
      "type": "stage",
      "text": "Enter Lord Scales upon the Tower, walking. Then enter two or three Citizens below."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "scales",
        "name": "SCALES",
        "displayName": "Scales"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "How now? Is Jack Cade slain?",
          "plainText": "How now Is Jack Cade slain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "1-citizen",
        "name": "1 CITIZEN",
        "displayName": "1 Citizen"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "No, my lord, nor likely to be slain; for they have won the Bridge, killing all those that withstand them. The Lord Mayor craves aid of your honour from the Tower to defend the city from the rebels.",
          "plainText": "No my lord nor likely to be slain for they have won the Bridge killing all those that withstand them The Lord Mayor craves aid of your honour from the Tower to defend the city from the rebels",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "scales",
        "name": "SCALES",
        "displayName": "Scales"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Such aid as I can spare you shall command,",
          "plainText": "Such aid as I can spare you shall command",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-5-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "But I am troubled here with them myself;",
          "plainText": "But I am troubled here with them myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-5-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "The rebels have assayed to win the Tower.",
          "plainText": "The rebels have assayed to win the Tower",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-5-line-0006",
          "number": 6,
          "speechLineNumber": 4,
          "text": "But get you to Smithfield and gather head,",
          "plainText": "But get you to Smithfield and gather head",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-5-line-0007",
          "number": 7,
          "speechLineNumber": 5,
          "text": "And thither I will send you Matthew Gough.",
          "plainText": "And thither I will send you Matthew Gough",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-5-line-0008",
          "number": 8,
          "speechLineNumber": 6,
          "text": "Fight for your king, your country, and your lives!",
          "plainText": "Fight for your king your country and your lives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-5-line-0009",
          "number": 9,
          "speechLineNumber": 7,
          "text": "And so farewell, for I must hence again.",
          "plainText": "And so farewell for I must hence again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-5-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
