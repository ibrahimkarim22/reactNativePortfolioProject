  "content": [
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-6-stage-001",
      "type": "stage",
      "text": "Enter Jack Cade and the rest, and strikes his staff on London Stone."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cade",
        "name": "CADE",
        "displayName": "Cade"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Now is Mortimer lord of this city. And here, sitting upon London Stone, I charge and command that, of the city's cost, the Pissing Conduit run nothing but claret wine this first year of our reign. And now henceforward it shall be treason for any that calls me other than Lord Mortimer.",
          "plainText": "Now is Mortimer lord of this city And here sitting upon London Stone I charge and command that of the city's cost the Pissing Conduit run nothing but claret wine this first year of our reign And now henceforward it shall be treason for any that calls me other than Lord Mortimer",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-6-stage-002",
      "type": "stage",
      "text": "Enter a Soldier, running."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-6-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Jack Cade! Jack Cade!",
          "plainText": "Jack Cade Jack Cade",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "cade",
        "name": "CADE",
        "displayName": "Cade"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-6-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Knock him down there.",
          "plainText": "Knock him down there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-6-stage-003",
      "type": "stage",
      "text": "[They kill him.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "dick",
        "name": "DICK",
        "displayName": "Dick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-6-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "If this fellow be wise, he'll never call ye Jack Cade more. I think he hath a very fair warning. My lord, there's an army gathered together in Smithfield.",
          "plainText": "If this fellow be wise he'll never call ye Jack Cade more I think he hath a very fair warning My lord there's an army gathered together in Smithfield",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cade",
        "name": "CADE",
        "displayName": "Cade"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-6-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Come then, let's go fight with them. But first, go and set London Bridge on fire; and, if you can, burn down the Tower too. Come, let's away.",
          "plainText": "Come then let's go fight with them But first go and set London Bridge on fire and if you can burn down the Tower too Come let's away",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-6-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
