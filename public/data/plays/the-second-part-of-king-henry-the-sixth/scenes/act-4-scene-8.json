    "title": "SCENE VIII. Southwark",
    "location": "Southwark",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-stage-001",
      "type": "stage",
      "text": "Alarum and retreat. Enter Cade and all his rabblement."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-speech-001",
      "type": "speech",
      "speaker": {
        "id": "cade",
        "name": "CADE",
        "displayName": "Cade"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Up Fish Street! Down Saint Magnus' Corner! Kill and knock down! Throw them into Thames! [Sound a parley.] What noise is this I hear? Dare any be so bold to sound retreat or parley when I command them kill?",
          "plainText": "Up Fish Street Down Saint Magnus' Corner Kill and knock down Throw them into Thames Sound a parley What noise is this I hear Dare any be so bold to sound retreat or parley when I command them kill",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-stage-002",
      "type": "stage",
      "text": "Enter Buckingham and old Clifford attended."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-speech-002",
      "type": "speech",
      "speaker": {
        "id": "buckingham",
        "name": "BUCKINGHAM",
        "displayName": "Buckingham"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Ay, here they be that dare and will disturb thee.",
          "plainText": "Ay here they be that dare and will disturb thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Know, Cade, we come ambassadors from the King",
          "plainText": "Know Cade we come ambassadors from the King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "Unto the commons, whom thou hast misled,",
          "plainText": "Unto the commons whom thou hast misled",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "And here pronounce free pardon to them all",
          "plainText": "And here pronounce free pardon to them all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0006",
          "number": 6,
          "speechLineNumber": 5,
          "text": "That will forsake thee and go home in peace.",
          "plainText": "That will forsake thee and go home in peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-speech-003",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "What say ye, countrymen? Will ye relent",
          "plainText": "What say ye countrymen Will ye relent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "And yield to mercy whilst 'tis offered you,",
          "plainText": "And yield to mercy whilst 'tis offered you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Or let a rebel lead you to your deaths?",
          "plainText": "Or let a rebel lead you to your deaths",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "Who loves the King and will embrace his pardon,",
          "plainText": "Who loves the King and will embrace his pardon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "Fling up his cap, and say \"God save his Majesty!\"",
          "plainText": "Fling up his cap and say God save his Majesty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "Who hateth him and honours not his father,",
          "plainText": "Who hateth him and honours not his father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0013",
          "number": 13,
          "speechLineNumber": 7,
          "text": "Henry the Fifth, that made all France to quake,",
          "plainText": "Henry the Fifth that made all France to quake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0014",
          "number": 14,
          "speechLineNumber": 8,
          "text": "Shake he his weapon at us and pass by.",
          "plainText": "Shake he his weapon at us and pass by",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-speech-004",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "God save the King! God save the King!",
          "plainText": "God save the King God save the King",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-speech-005",
      "type": "speech",
      "speaker": {
        "id": "cade",
        "name": "CADE",
        "displayName": "Cade"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "What, Buckingham and Clifford, are ye so brave? And you, base peasants, do ye believe him? Will you needs be hanged with your pardons about your necks? Hath my sword therefore broke through London gates, that you should leave me at the White Hart in Southwark? I thought ye would never have given out these arms till you had recovered your ancient freedom; but you are all recreants and dastards, and delight to live in slavery to the nobility. Let them break your backs with burdens, take your houses over your heads, ravish your wives and daughters before your faces. For me, I will make shift for one, and so God's curse light upon you all!",
          "plainText": "What Buckingham and Clifford are ye so brave And you base peasants do ye believe him Will you needs be hanged with your pardons about your necks Hath my sword therefore broke through London gates that you should leave me at the White Hart in Southwark I thought ye would never have given out these arms till you had recovered your ancient freedom but you are all recreants and dastards and delight to live in slavery to the nobility Let them break your backs with burdens take your houses over your heads ravish your wives and daughters before your faces For me I will make shift for one and so God's curse light upon you all",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-speech-006",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "We'll follow Cade! We'll follow Cade!",
          "plainText": "We'll follow Cade We'll follow Cade",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-speech-007",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Is Cade the son of Henry the Fifth,",
          "plainText": "Is Cade the son of Henry the Fifth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "That thus you do exclaim you'll go with him?",
          "plainText": "That thus you do exclaim you'll go with him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "Will he conduct you through the heart of France",
          "plainText": "Will he conduct you through the heart of France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "And make the meanest of you earls and dukes?",
          "plainText": "And make the meanest of you earls and dukes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0022",
          "number": 22,
          "speechLineNumber": 5,
          "text": "Alas, he hath no home, no place to fly to,",
          "plainText": "Alas he hath no home no place to fly to",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0023",
          "number": 23,
          "speechLineNumber": 6,
          "text": "Nor knows he how to live but by the spoil,",
          "plainText": "Nor knows he how to live but by the spoil",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0024",
          "number": 24,
          "speechLineNumber": 7,
          "text": "Unless by robbing of your friends and us.",
          "plainText": "Unless by robbing of your friends and us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0025",
          "number": 25,
          "speechLineNumber": 8,
          "text": "Were 't not a shame that whilst you live at jar",
          "plainText": "Were 't not a shame that whilst you live at jar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0026",
          "number": 26,
          "speechLineNumber": 9,
          "text": "The fearful French, whom you late vanquished,",
          "plainText": "The fearful French whom you late vanquished",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0027",
          "number": 27,
          "speechLineNumber": 10,
          "text": "Should make a start o'er seas and vanquish you?",
          "plainText": "Should make a start o'er seas and vanquish you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0028",
          "number": 28,
          "speechLineNumber": 11,
          "text": "Methinks already in this civil broil",
          "plainText": "Methinks already in this civil broil",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0029",
          "number": 29,
          "speechLineNumber": 12,
          "text": "I see them lording it in London streets,",
          "plainText": "I see them lording it in London streets",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0030",
          "number": 30,
          "speechLineNumber": 13,
          "text": "Crying \"Villiago!\" unto all they meet.",
          "plainText": "Crying Villiago unto all they meet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0031",
          "number": 31,
          "speechLineNumber": 14,
          "text": "Better ten thousand base-born Cades miscarry",
          "plainText": "Better ten thousand baseborn Cades miscarry",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0032",
          "number": 32,
          "speechLineNumber": 15,
          "text": "Than you should stoop unto a Frenchman's mercy.",
          "plainText": "Than you should stoop unto a Frenchman's mercy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0033",
          "number": 33,
          "speechLineNumber": 16,
          "text": "To France, to France, and get what you have lost!",
          "plainText": "To France to France and get what you have lost",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0034",
          "number": 34,
          "speechLineNumber": 17,
          "text": "Spare England, for it is your native coast.",
          "plainText": "Spare England for it is your native coast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0035",
          "number": 35,
          "speechLineNumber": 18,
          "text": "Henry hath money, you are strong and manly;",
          "plainText": "Henry hath money you are strong and manly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0036",
          "number": 36,
          "speechLineNumber": 19,
          "text": "God on our side, doubt not of victory.",
          "plainText": "God on our side doubt not of victory",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-speech-008",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "A Clifford! A Clifford! We'll follow the King and Clifford.",
          "plainText": "A Clifford A Clifford We'll follow the King and Clifford",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-speech-009",
      "type": "speech",
      "speaker": {
        "id": "cade",
        "name": "CADE",
        "displayName": "Cade"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Was ever feather so lightly blown to and fro as this multitude? The name of Henry the Fifth hales them to an hundred mischiefs and makes them leave me desolate. I see them lay their heads together to surprise me. My sword make way for me, for here is no staying.—In despite of the devils and hell, have through the very middest of you! And heavens and honour be witness that no want of resolution in me, but only my followers' base and ignominious treasons, makes me betake me to my heels.",
          "plainText": "Was ever feather so lightly blown to and fro as this multitude The name of Henry the Fifth hales them to an hundred mischiefs and makes them leave me desolate I see them lay their heads together to surprise me My sword make way for me for here is no stayingIn despite of the devils and hell have through the very middest of you And heavens and honour be witness that no want of resolution in me but only my followers' base and ignominious treasons makes me betake me to my heels",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-speech-010",
      "type": "speech",
      "speaker": {
        "id": "buckingham",
        "name": "BUCKINGHAM",
        "displayName": "Buckingham"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "What, is he fled? Go some, and follow him;",
          "plainText": "What is he fled Go some and follow him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "And he that brings his head unto the King",
          "plainText": "And he that brings his head unto the King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-4-8-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "Shall have a thousand crowns for his reward.",
          "plainText": "Shall have a thousand crowns for his reward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-stage-004",
      "type": "stage",
      "text": "[Exeunt some of them.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-4-8-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}