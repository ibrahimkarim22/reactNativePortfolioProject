  "scene": {
    "id": "the-second-part-of-king-henry-the-sixth-5-2",
    "act": 5,
    "scene": 2,
    "label": "Act 5, Scene 2",
    "title": "SCENE II. Saint Albans",
    "location": "Saint Albans",
    "orderInPlay": 23
  },
  "content": [
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-001",
      "type": "stage",
      "text": "The sign of the Castle Inn is displayed. Alarums to the battle. Enter Warwick."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Clifford of Cumberland, 'tis Warwick calls;",
          "plainText": "Clifford of Cumberland 'tis Warwick calls",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "An if thou dost not hide thee from the bear,",
          "plainText": "An if thou dost not hide thee from the bear",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Now, when the angry trumpet sounds alarum",
          "plainText": "Now when the angry trumpet sounds alarum",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And dead men's cries do fill the empty air,",
          "plainText": "And dead men's cries do fill the empty air",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Clifford, I say, come forth and fight with me!",
          "plainText": "Clifford I say come forth and fight with me",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Proud northern lord, Clifford of Cumberland,",
          "plainText": "Proud northern lord Clifford of Cumberland",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Warwick is hoarse with calling thee to arms.",
          "plainText": "Warwick is hoarse with calling thee to arms",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-002",
      "type": "stage",
      "text": "Enter York."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "The deadly-handed Clifford slew my steed,",
          "plainText": "The deadlyhanded Clifford slew my steed",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "But match to match I have encountered him",
          "plainText": "But match to match I have encountered him",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "And made a prey for carrion kites and crows",
          "plainText": "And made a prey for carrion kites and crows",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "Even of the bonny beast he loved so well.",
          "plainText": "Even of the bonny beast he loved so well",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-003",
      "type": "stage",
      "text": "Enter old Clifford."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Of one or both of us the time is come.",
          "plainText": "Of one or both of us the time is come",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Hold, Warwick, seek thee out some other chase,",
          "plainText": "Hold Warwick seek thee out some other chase",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "For I myself must hunt this deer to death.",
          "plainText": "For I myself must hunt this deer to death",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Then, nobly, York; 'tis for a crown thou fight'st.",
          "plainText": "Then nobly York 'tis for a crown thou fight'st",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "As I intend, Clifford, to thrive today,",
          "plainText": "As I intend Clifford to thrive today",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "It grieves my soul to leave thee unassailed.",
          "plainText": "It grieves my soul to leave thee unassailed",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "What seest thou in me, York? Why dost thou pause?",
          "plainText": "What seest thou in me York Why dost thou pause",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "With thy brave bearing should I be in love,",
          "plainText": "With thy brave bearing should I be in love",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "But that thou art so fast mine enemy.",
          "plainText": "But that thou art so fast mine enemy",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Nor should thy prowess want praise and esteem,",
          "plainText": "Nor should thy prowess want praise and esteem",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "But that 'tis shown ignobly and in treason.",
          "plainText": "But that 'tis shown ignobly and in treason",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "So let it help me now against thy sword",
          "plainText": "So let it help me now against thy sword",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "As I in justice and true right express it!",
          "plainText": "As I in justice and true right express it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "My soul and body on the action both!",
          "plainText": "My soul and body on the action both",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "A dreadful lay! Address thee instantly.",
          "plainText": "A dreadful lay Address thee instantly",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-005",
      "type": "stage",
      "text": "[They fight and Clifford falls.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "La fin couronne les oeuvres.",
          "plainText": "La fin couronne les oeuvres",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-006",
      "type": "stage",
      "text": "[Dies.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Thus war hath given thee peace, for thou art still.",
          "plainText": "Thus war hath given thee peace for thou art still",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "Peace with his soul, heaven, if it be thy will!",
          "plainText": "Peace with his soul heaven if it be thy will",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-007",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-008",
      "type": "stage",
      "text": "Enter young Clifford."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "young-clifford",
        "name": "YOUNG CLIFFORD",
        "displayName": "Young Clifford"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Shame and confusion! All is on the rout,",
          "plainText": "Shame and confusion All is on the rout",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "Fear frames disorder, and disorder wounds",
          "plainText": "Fear frames disorder and disorder wounds",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "Where it should guard. O war, thou son of hell,",
          "plainText": "Where it should guard O war thou son of hell",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0033",
          "number": 33,
          "speechLineNumber": 4,
          "text": "Whom angry heavens do make their minister,",
          "plainText": "Whom angry heavens do make their minister",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0034",
          "number": 34,
          "speechLineNumber": 5,
          "text": "Throw in the frozen bosoms of our part",
          "plainText": "Throw in the frozen bosoms of our part",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0035",
          "number": 35,
          "speechLineNumber": 6,
          "text": "Hot coals of vengeance! Let no soldier fly.",
          "plainText": "Hot coals of vengeance Let no soldier fly",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0036",
          "number": 36,
          "speechLineNumber": 7,
          "text": "He that is truly dedicate to war",
          "plainText": "He that is truly dedicate to war",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0037",
          "number": 37,
          "speechLineNumber": 8,
          "text": "Hath no self-love; nor he that loves himself",
          "plainText": "Hath no selflove nor he that loves himself",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0038",
          "number": 38,
          "speechLineNumber": 9,
          "text": "Hath not essentially but by circumstance,",
          "plainText": "Hath not essentially but by circumstance",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0039",
          "number": 39,
          "speechLineNumber": 10,
          "text": "The name of valour. [Sees his dead father.] O, let the vile world end",
          "plainText": "The name of valour Sees his dead father O let the vile world end",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0040",
          "number": 40,
          "speechLineNumber": 11,
          "text": "And the premised flames of the last day",
          "plainText": "And the premised flames of the last day",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0041",
          "number": 41,
          "speechLineNumber": 12,
          "text": "Knit earth and heaven together!",
          "plainText": "Knit earth and heaven together",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0042",
          "number": 42,
          "speechLineNumber": 13,
          "text": "Now let the general trumpet blow his blast,",
          "plainText": "Now let the general trumpet blow his blast",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0043",
          "number": 43,
          "speechLineNumber": 14,
          "text": "Particularities and petty sounds",
          "plainText": "Particularities and petty sounds",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0044",
          "number": 44,
          "speechLineNumber": 15,
          "text": "To cease! Wast thou ordained, dear father,",
          "plainText": "To cease Wast thou ordained dear father",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0045",
          "number": 45,
          "speechLineNumber": 16,
          "text": "To lose thy youth in peace, and to achieve",
          "plainText": "To lose thy youth in peace and to achieve",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0046",
          "number": 46,
          "speechLineNumber": 17,
          "text": "The silver livery of advised age,",
          "plainText": "The silver livery of advised age",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0047",
          "number": 47,
          "speechLineNumber": 18,
          "text": "And, in thy reverence and thy chair-days, thus",
          "plainText": "And in thy reverence and thy chairdays thus",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0048",
          "number": 48,
          "speechLineNumber": 19,
          "text": "To die in ruffian battle? Even at this sight",
          "plainText": "To die in ruffian battle Even at this sight",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0049",
          "number": 49,
          "speechLineNumber": 20,
          "text": "My heart is turned to stone, and while 'tis mine",
          "plainText": "My heart is turned to stone and while 'tis mine",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0050",
          "number": 50,
          "speechLineNumber": 21,
          "text": "It shall be stony. York not our old men spares;",
          "plainText": "It shall be stony York not our old men spares",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0051",
          "number": 51,
          "speechLineNumber": 22,
          "text": "No more will I their babes; tears virginal",
          "plainText": "No more will I their babes tears virginal",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0052",
          "number": 52,
          "speechLineNumber": 23,
          "text": "Shall be to me even as the dew to fire,",
          "plainText": "Shall be to me even as the dew to fire",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0053",
          "number": 53,
          "speechLineNumber": 24,
          "text": "And beauty, that the tyrant oft reclaims,",
          "plainText": "And beauty that the tyrant oft reclaims",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0054",
          "number": 54,
          "speechLineNumber": 25,
          "text": "Shall to my flaming wrath be oil and flax.",
          "plainText": "Shall to my flaming wrath be oil and flax",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0055",
          "number": 55,
          "speechLineNumber": 26,
          "text": "Henceforth I will not have to do with pity.",
          "plainText": "Henceforth I will not have to do with pity",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0056",
          "number": 56,
          "speechLineNumber": 27,
          "text": "Meet I an infant of the house of York,",
          "plainText": "Meet I an infant of the house of York",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0057",
          "number": 57,
          "speechLineNumber": 28,
          "text": "Into as many gobbets will I cut it",
          "plainText": "Into as many gobbets will I cut it",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0058",
          "number": 58,
          "speechLineNumber": 29,
          "text": "As wild Medea young Absyrtus did.",
          "plainText": "As wild Medea young Absyrtus did",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0059",
          "number": 59,
          "speechLineNumber": 30,
          "text": "In cruelty will I seek out my fame.",
          "plainText": "In cruelty will I seek out my fame",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-009",
      "type": "stage",
      "text": "[He takes him up on his back.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-010",
      "type": "stage",
      "text": "[Exit, bearing off his father.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-011",
      "type": "stage",
      "text": "Enter Richard and Somerset to fight. Somerset is killed."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "So, lie thou there;",
          "plainText": "So lie thou there",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "For underneath an alehouse' paltry sign,",
          "plainText": "For underneath an alehouse' paltry sign",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0062",
          "number": 62,
          "speechLineNumber": 3,
          "text": "The Castle in Saint Albans, Somerset",
          "plainText": "The Castle in Saint Albans Somerset",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0063",
          "number": 63,
          "speechLineNumber": 4,
          "text": "Hath made the wizard famous in his death.",
          "plainText": "Hath made the wizard famous in his death",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0064",
          "number": 64,
          "speechLineNumber": 5,
          "text": "Sword, hold thy temper; heart, be wrathful still!",
          "plainText": "Sword hold thy temper heart be wrathful still",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0065",
          "number": 65,
          "speechLineNumber": 6,
          "text": "Priests pray for enemies, but princes kill.",
          "plainText": "Priests pray for enemies but princes kill",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-012",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-013",
      "type": "stage",
      "text": "Fight. Excursions. Enter King, Queen and others."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Away, my lord! You are slow, for shame, away!",
          "plainText": "Away my lord You are slow for shame away",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Can we outrun the heavens? Good Margaret, stay.",
          "plainText": "Can we outrun the heavens Good Margaret stay",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "What are you made of? You'll nor fight nor fly.",
          "plainText": "What are you made of You'll nor fight nor fly",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "Now is it manhood, wisdom, and defence",
          "plainText": "Now is it manhood wisdom and defence",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0070",
          "number": 70,
          "speechLineNumber": 3,
          "text": "To give the enemy way, and to secure us",
          "plainText": "To give the enemy way and to secure us",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0071",
          "number": 71,
          "speechLineNumber": 4,
          "text": "By what we can, which can no more but fly.",
          "plainText": "By what we can which can no more but fly",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-014",
      "type": "stage",
      "text": "[Alarum afar off.]"
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-015",
      "type": "stage",
      "text": "Enter young Clifford."
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "young-clifford",
        "name": "YOUNG CLIFFORD",
        "displayName": "Young Clifford"
      },
      "lines": [
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "But that my heart's on future mischief set,",
          "plainText": "But that my heart's on future mischief set",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "I would speak blasphemy ere bid you fly;",
          "plainText": "I would speak blasphemy ere bid you fly",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0074",
          "number": 74,
          "speechLineNumber": 3,
          "text": "But fly you must; uncurable discomfit",
          "plainText": "But fly you must uncurable discomfit",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0075",
          "number": 75,
          "speechLineNumber": 4,
          "text": "Reigns in the hearts of all our present parts.",
          "plainText": "Reigns in the hearts of all our present parts",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0076",
          "number": 76,
          "speechLineNumber": 5,
          "text": "Away, for your relief! And we will live",
          "plainText": "Away for your relief And we will live",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0077",
          "number": 77,
          "speechLineNumber": 6,
          "text": "To see their day and them our fortune give.",
          "plainText": "To see their day and them our fortune give",
          "lineType": "verse"
        },
        {
          "id": "the-second-part-of-king-henry-the-sixth-5-2-line-0078",
          "number": 78,
          "speechLineNumber": 7,
          "text": "Away, my lord, away!",
          "plainText": "Away my lord away",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-second-part-of-king-henry-the-sixth-5-2-stage-016",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}