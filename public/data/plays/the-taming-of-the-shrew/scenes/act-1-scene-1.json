    {
      "id": "the-taming-of-the-shrew-1-1-stage-001",
      "type": "stage",
      "text": "Flourish. Enter Lucentio and Tranio."
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-002",
      "type": "stage",
      "text": "[Lucentio and Tranio stand aside.]"
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-003",
      "type": "stage",
      "text": "Enter Baptista, Katherina, Bianca, Gremio and Hortensio."
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-004",
      "type": "stage",
      "text": "[Exit Bianca.]"
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-005",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-007",
      "type": "stage",
      "text": "[Exeunt Gremio and Hortensio.]"
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-008",
      "type": "stage",
      "text": "[They exchange habits]"
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-009",
      "type": "stage",
      "text": "Enter Biondello."
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-010",
      "type": "stage",
      "text": "[Exeunt.]"
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-011",
      "type": "stage",
      "text": "[The Presenters above speak.]"
    },
    {
      "id": "the-taming-of-the-shrew-1-1-stage-012",
      "type": "stage",
      "text": "[They sit and mark.]"
    }
