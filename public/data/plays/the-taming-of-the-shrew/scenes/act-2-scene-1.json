  "content": [
    {
      "id": "the-taming-of-the-shrew-2-1-stage-001",
      "type": "stage",
      "text": "Enter Katherina and Bianca."
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-002",
      "type": "stage",
      "text": "[Strikes her.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-003",
      "type": "stage",
      "text": "Enter Baptista."
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-004",
      "type": "stage",
      "text": "[Flies after Bianca.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-005",
      "type": "stage",
      "text": "[Exit Bianca.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-007",
      "type": "stage",
      "text": "Enter Gremio, with Lucentio in the habit of a mean man; Petruchio, with Hortensio as a musician; and Tranio, with Biondello bearing a lute and books."
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-008",
      "type": "stage",
      "text": "[Presenting Hortensio.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-009",
      "type": "stage",
      "text": "[Presenting Lucentio.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-010",
      "type": "stage",
      "text": "Enter a Servant."
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-011",
      "type": "stage",
      "text": "[Exeunt Servant with Hortensio, Lucentio and Biondello.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-012",
      "type": "stage",
      "text": "Re-enter Hortensio, with his head broke."
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-013",
      "type": "stage",
      "text": "[Exeunt Baptista, Gremio, Tranio and Hortensio.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-014",
      "type": "stage",
      "text": "Enter Katherina."
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-015",
      "type": "stage",
      "text": "[Striking him.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-016",
      "type": "stage",
      "text": "Re-enter Baptista, Gremio and Tranio."
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-017",
      "type": "stage",
      "text": "[Exeunt Petruchio and Katherina, severally.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-018",
      "type": "stage",
      "text": "[Exit Baptista.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-019",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-2-1-stage-020",
      "type": "stage",
      "text": "[Exit.]"
