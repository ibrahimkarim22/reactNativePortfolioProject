  "scene": {
    "id": "the-taming-of-the-shrew-3-1",
    "act": 3,
    "scene": 1,
    "label": "Act 3, Scene 1",
    "title": "SCENE I. Padua. A room in Baptista's house.",
    "location": "Padua. A room in Baptista's house.",
    "orderInPlay": 4
  },
  "content": [
    {
      "id": "the-taming-of-the-shrew-3-1-stage-001",
      "type": "stage",
      "text": "Enter Lucentio, Hortensio and Bianca."
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Fiddler, forbear; you grow too forward, sir.",
          "plainText": "Fiddler forbear you grow too forward sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Have you so soon forgot the entertainment",
          "plainText": "Have you so soon forgot the entertainment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Her sister Katherine welcome'd you withal?",
          "plainText": "Her sister Katherine welcome'd you withal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "But, wrangling pedant, this is",
          "plainText": "But wrangling pedant this is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "The patroness of heavenly harmony:",
          "plainText": "The patroness of heavenly harmony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Then give me leave to have prerogative;",
          "plainText": "Then give me leave to have prerogative",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "And when in music we have spent an hour,",
          "plainText": "And when in music we have spent an hour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "Your lecture shall have leisure for as much.",
          "plainText": "Your lecture shall have leisure for as much",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Preposterous ass, that never read so far",
          "plainText": "Preposterous ass that never read so far",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "To know the cause why music was ordain'd!",
          "plainText": "To know the cause why music was ordain'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Was it not to refresh the mind of man",
          "plainText": "Was it not to refresh the mind of man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "After his studies or his usual pain?",
          "plainText": "After his studies or his usual pain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "Then give me leave to read philosophy,",
          "plainText": "Then give me leave to read philosophy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 6,
          "text": "And while I pause serve in your harmony.",
          "plainText": "And while I pause serve in your harmony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Sirrah, I will not bear these braves of thine.",
          "plainText": "Sirrah I will not bear these braves of thine",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "bianca",
        "name": "BIANCA",
        "displayName": "Bianca"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Why, gentlemen, you do me double wrong,",
          "plainText": "Why gentlemen you do me double wrong",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "To strive for that which resteth in my choice.",
          "plainText": "To strive for that which resteth in my choice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "I am no breeching scholar in the schools,",
          "plainText": "I am no breeching scholar in the schools",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "I'll not be tied to hours nor 'pointed times,",
          "plainText": "I'll not be tied to hours nor 'pointed times",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "But learn my lessons as I please myself.",
          "plainText": "But learn my lessons as I please myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 6,
          "text": "And, to cut off all strife, here sit we down;",
          "plainText": "And to cut off all strife here sit we down",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 7,
          "text": "Take you your instrument, play you the whiles;",
          "plainText": "Take you your instrument play you the whiles",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 8,
          "text": "His lecture will be done ere you have tun'd.",
          "plainText": "His lecture will be done ere you have tun'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "You'll leave his lecture when I am in tune?",
          "plainText": "You'll leave his lecture when I am in tune",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-stage-002",
      "type": "stage",
      "text": "[Retires.]"
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "That will be never: tune your instrument.",
          "plainText": "That will be never tune your instrument",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "bianca",
        "name": "BIANCA",
        "displayName": "Bianca"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Where left we last?",
          "plainText": "Where left we last",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Here, madam:—",
          "plainText": "Here madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Hic ibat Simois; hic est Sigeia tellus;",
          "plainText": "Hic ibat Simois hic est Sigeia tellus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0029",
          "number": 29,
          "speechLineNumber": 3,
          "text": "Hic steterat Priami regia celsa senis.",
          "plainText": "Hic steterat Priami regia celsa senis",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "bianca",
        "name": "BIANCA",
        "displayName": "Bianca"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Construe them.",
          "plainText": "Construe them",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Hic ibat, as I told you before, Simois, I am Lucentio, hic est, son unto Vincentio of Pisa, Sigeia tellus, disguised thus to get your love, Hic steterat, and that Lucentio that comes a-wooing, Priami, is my man Tranio, regia, bearing my port, celsa senis, that we might beguile the old pantaloon.",
          "plainText": "Hic ibat as I told you before Simois I am Lucentio hic est son unto Vincentio of Pisa Sigeia tellus disguised thus to get your love Hic steterat and that Lucentio that comes awooing Priami is my man Tranio regia bearing my port celsa senis that we might beguile the old pantaloon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "bianca",
        "name": "BIANCA",
        "displayName": "Bianca"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Let's hear.—",
          "plainText": "Let's hear",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-stage-003",
      "type": "stage",
      "text": "[Hortensio plays.]"
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Spit in the hole, man, and tune again.",
          "plainText": "Spit in the hole man and tune again",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "bianca",
        "name": "BIANCA",
        "displayName": "Bianca"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Now let me see if I can construe it: Hic ibat Simois, I know you not; hic est Sigeia tellus, I trust you not; Hic steterat Priami, take heed he hear us not; regia, presume not; celsa senis, despair not.",
          "plainText": "Now let me see if I can construe it Hic ibat Simois I know you not hic est Sigeia tellus I trust you not Hic steterat Priami take heed he hear us not regia presume not celsa senis despair not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Madam, 'tis now in tune.",
          "plainText": "Madam 'tis now in tune",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "All but the base.",
          "plainText": "All but the base",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "The base is right; 'tis the base knave that jars.",
          "plainText": "The base is right 'tis the base knave that jars",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "[Aside] How fiery and forward our pedant is!",
          "plainText": "Aside How fiery and forward our pedant is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "Now, for my life, the knave doth court my love:",
          "plainText": "Now for my life the knave doth court my love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "Pedascule, I'll watch you better yet.",
          "plainText": "Pedascule I'll watch you better yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "bianca",
        "name": "BIANCA",
        "displayName": "Bianca"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "In time I may believe, yet I mistrust.",
          "plainText": "In time I may believe yet I mistrust",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Mistrust it not; for sure, Æacides",
          "plainText": "Mistrust it not for sure acides",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "Was Ajax, call'd so from his grandfather.",
          "plainText": "Was Ajax call'd so from his grandfather",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "bianca",
        "name": "BIANCA",
        "displayName": "Bianca"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "I must believe my master; else, I promise you,",
          "plainText": "I must believe my master else I promise you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "I should be arguing still upon that doubt;",
          "plainText": "I should be arguing still upon that doubt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "But let it rest. Now, Licio, to you.",
          "plainText": "But let it rest Now Licio to you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "Good master, take it not unkindly, pray,",
          "plainText": "Good master take it not unkindly pray",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0048",
          "number": 48,
          "speechLineNumber": 5,
          "text": "That I have been thus pleasant with you both.",
          "plainText": "That I have been thus pleasant with you both",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "[To Lucentio] You may go walk and give me leave a while;",
          "plainText": "To Lucentio You may go walk and give me leave a while",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "My lessons make no music in three parts.",
          "plainText": "My lessons make no music in three parts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Are you so formal, sir? Well, I must wait,",
          "plainText": "Are you so formal sir Well I must wait",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "[Aside] And watch withal; for, but I be deceiv'd,",
          "plainText": "Aside And watch withal for but I be deceiv'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "Our fine musician groweth amorous.",
          "plainText": "Our fine musician groweth amorous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Madam, before you touch the instrument,",
          "plainText": "Madam before you touch the instrument",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "To learn the order of my fingering,",
          "plainText": "To learn the order of my fingering",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0056",
          "number": 56,
          "speechLineNumber": 3,
          "text": "I must begin with rudiments of art;",
          "plainText": "I must begin with rudiments of art",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0057",
          "number": 57,
          "speechLineNumber": 4,
          "text": "To teach you gamut in a briefer sort,",
          "plainText": "To teach you gamut in a briefer sort",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0058",
          "number": 58,
          "speechLineNumber": 5,
          "text": "More pleasant, pithy, and effectual,",
          "plainText": "More pleasant pithy and effectual",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0059",
          "number": 59,
          "speechLineNumber": 6,
          "text": "Than hath been taught by any of my trade:",
          "plainText": "Than hath been taught by any of my trade",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0060",
          "number": 60,
          "speechLineNumber": 7,
          "text": "And there it is in writing, fairly drawn.",
          "plainText": "And there it is in writing fairly drawn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "bianca",
        "name": "BIANCA",
        "displayName": "Bianca"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Why, I am past my gamut long ago.",
          "plainText": "Why I am past my gamut long ago",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Yet read the gamut of Hortensio.",
          "plainText": "Yet read the gamut of Hortensio",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "bianca",
        "name": "BIANCA",
        "displayName": "Bianca"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Gamut I am, the ground of all accord,",
          "plainText": "Gamut I am the ground of all accord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "A re, to plead Hortensio's passion;",
          "plainText": "A re to plead Hortensio's passion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "B mi, Bianca, take him for thy lord,",
          "plainText": "B mi Bianca take him for thy lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "C fa ut, that loves with all affection:",
          "plainText": "C fa ut that loves with all affection",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0067",
          "number": 67,
          "speechLineNumber": 5,
          "text": "D sol re, one clef, two notes have I",
          "plainText": "D sol re one clef two notes have I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0068",
          "number": 68,
          "speechLineNumber": 6,
          "text": "E la mi, show pity or I die.",
          "plainText": "E la mi show pity or I die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0069",
          "number": 69,
          "speechLineNumber": 7,
          "text": "Call you this gamut? Tut, I like it not:",
          "plainText": "Call you this gamut Tut I like it not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0070",
          "number": 70,
          "speechLineNumber": 8,
          "text": "Old fashions please me best; I am not so nice,",
          "plainText": "Old fashions please me best I am not so nice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0071",
          "number": 71,
          "speechLineNumber": 9,
          "text": "To change true rules for odd inventions.",
          "plainText": "To change true rules for odd inventions",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-stage-004",
      "type": "stage",
      "text": "Enter a Servant."
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Mistress, your father prays you leave your books,",
          "plainText": "Mistress your father prays you leave your books",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "And help to dress your sister's chamber up:",
          "plainText": "And help to dress your sister's chamber up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0074",
          "number": 74,
          "speechLineNumber": 3,
          "text": "You know tomorrow is the wedding-day.",
          "plainText": "You know tomorrow is the weddingday",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "bianca",
        "name": "BIANCA",
        "displayName": "Bianca"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Farewell, sweet masters, both: I must be gone.",
          "plainText": "Farewell sweet masters both I must be gone",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-stage-005",
      "type": "stage",
      "text": "[Exeunt Bianca and Servant.]"
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Faith, mistress, then I have no cause to stay.",
          "plainText": "Faith mistress then I have no cause to stay",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-3-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-3-1-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "But I have cause to pry into this pedant:",
          "plainText": "But I have cause to pry into this pedant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "Methinks he looks as though he were in love.",
          "plainText": "Methinks he looks as though he were in love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0079",
          "number": 79,
          "speechLineNumber": 3,
          "text": "Yet if thy thoughts, Bianca, be so humble",
          "plainText": "Yet if thy thoughts Bianca be so humble",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0080",
          "number": 80,
          "speechLineNumber": 4,
          "text": "To cast thy wand'ring eyes on every stale,",
          "plainText": "To cast thy wand'ring eyes on every stale",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0081",
          "number": 81,
          "speechLineNumber": 5,
          "text": "Seize thee that list: if once I find thee ranging,",
          "plainText": "Seize thee that list if once I find thee ranging",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-3-1-line-0082",
          "number": 82,
          "speechLineNumber": 6,
          "text": "Hortensio will be quit with thee by changing.",
          "plainText": "Hortensio will be quit with thee by changing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-3-1-stage-007",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}