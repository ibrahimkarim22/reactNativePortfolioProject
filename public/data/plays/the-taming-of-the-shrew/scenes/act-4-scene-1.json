  "content": [
    {
      "id": "the-taming-of-the-shrew-4-1-stage-001",
      "type": "stage",
      "text": "Enter Grumio."
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-002",
      "type": "stage",
      "text": "Enter Curtis."
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-003",
      "type": "stage",
      "text": "Enter four or five Servants."
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-004",
      "type": "stage",
      "text": "Enter Petruchio and Katherina."
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-005",
      "type": "stage",
      "text": "[Exeunt some of the Servants.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-006",
      "type": "stage",
      "text": "Re-enter Servants with supper."
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-007",
      "type": "stage",
      "text": "[Strikes him.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-008",
      "type": "stage",
      "text": "[Exit Servant.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-009",
      "type": "stage",
      "text": "[Servant lets the ewer fall. Petruchio strikes him.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-010",
      "type": "stage",
      "text": "[Throws the meat, etc., at them.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-011",
      "type": "stage",
      "text": "[Exeunt Petruchio, Katherina and Curtis.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-012",
      "type": "stage",
      "text": "Re-enter Curtis."
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-013",
      "type": "stage",
      "text": "[Exeunt.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-014",
      "type": "stage",
      "text": "Re-enter Petruchio."
    },
    {
      "id": "the-taming-of-the-shrew-4-1-stage-015",
      "type": "stage",
      "text": "[Exit.]"
    }
