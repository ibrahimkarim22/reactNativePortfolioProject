      "type": "stage",
      "text": "Enter Tranio and Hortensio."
    },
    {
      "id": "the-taming-of-the-shrew-4-2-stage-002",
      "type": "stage",
      "text": "[They stand aside.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-2-stage-003",
      "type": "stage",
      "text": "Enter Bianca and Lucentio."
    },
    {
      "id": "the-taming-of-the-shrew-4-2-stage-004",
      "type": "stage",
      "text": "[They retire.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-2-stage-005",
      "type": "stage",
      "text": "[Exit Hortensio. Lucentio and Bianca advance.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-2-stage-006",
      "type": "stage",
      "text": "Enter Biondello, running."
    },
    {
      "id": "the-taming-of-the-shrew-4-2-stage-007",
      "type": "stage",
      "text": "[Exeunt Lucentio and Bianca.]"
