  "scene": {
    "id": "the-taming-of-the-shrew-4-4",
    "act": 4,
    "scene": 4,
    "label": "Act 4, Scene 4",
    "title": "SCENE IV. Padua. Before Baptista's house.",
    "location": "Padua. Before Baptista's house.",
    "orderInPlay": 9
  },
  "content": [
    {
      "id": "the-taming-of-the-shrew-4-4-stage-001",
      "type": "stage",
      "text": "Enter Tranio and the Pedant dressed like Vincentio"
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "tranio",
        "name": "TRANIO",
        "displayName": "Tranio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Sir, this is the house; please it you that I call?",
          "plainText": "Sir this is the house please it you that I call",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "pedant",
        "name": "PEDANT",
        "displayName": "Pedant"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Ay, what else? and, but I be deceived,",
          "plainText": "Ay what else and but I be deceived",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Signior Baptista may remember me,",
          "plainText": "Signior Baptista may remember me",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0004",
          "number": 4,
          "speechLineNumber": 3,
          "text": "Near twenty years ago in Genoa,",
          "plainText": "Near twenty years ago in Genoa",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0005",
          "number": 5,
          "speechLineNumber": 4,
          "text": "Where we were lodgers at the Pegasus.",
          "plainText": "Where we were lodgers at the Pegasus",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "tranio",
        "name": "TRANIO",
        "displayName": "Tranio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "'Tis well; and hold your own, in any case,",
          "plainText": "'Tis well and hold your own in any case",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "With such austerity as 'longeth to a father.",
          "plainText": "With such austerity as 'longeth to a father",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "pedant",
        "name": "PEDANT",
        "displayName": "Pedant"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "I warrant you. But, sir, here comes your boy;",
          "plainText": "I warrant you But sir here comes your boy",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "'Twere good he were school'd.",
          "plainText": "'Twere good he were school'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-stage-002",
      "type": "stage",
      "text": "Enter Biondello."
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "tranio",
        "name": "TRANIO",
        "displayName": "Tranio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Fear you not him. Sirrah Biondello,",
          "plainText": "Fear you not him Sirrah Biondello",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "Now do your duty throughly, I advise you.",
          "plainText": "Now do your duty throughly I advise you",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "Imagine 'twere the right Vincentio.",
          "plainText": "Imagine 'twere the right Vincentio",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "biondello",
        "name": "BIONDELLO",
        "displayName": "Biondello"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Tut! fear not me.",
          "plainText": "Tut fear not me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "tranio",
        "name": "TRANIO",
        "displayName": "Tranio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "But hast thou done thy errand to Baptista?",
          "plainText": "But hast thou done thy errand to Baptista",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "biondello",
        "name": "BIONDELLO",
        "displayName": "Biondello"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "I told him that your father was at Venice,",
          "plainText": "I told him that your father was at Venice",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "And that you look'd for him this day in Padua.",
          "plainText": "And that you look'd for him this day in Padua",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "tranio",
        "name": "TRANIO",
        "displayName": "Tranio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Th'art a tall fellow; hold thee that to drink.",
          "plainText": "Th'art a tall fellow hold thee that to drink",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Here comes Baptista. Set your countenance, sir.",
          "plainText": "Here comes Baptista Set your countenance sir",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-stage-003",
      "type": "stage",
      "text": "Enter Baptista and Lucentio."
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "pedant",
        "name": "PEDANT",
        "displayName": "Pedant"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Soft, son!",
          "plainText": "Soft son",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Sir, by your leave: having come to Padua",
          "plainText": "Sir by your leave having come to Padua",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "To gather in some debts, my son Lucentio",
          "plainText": "To gather in some debts my son Lucentio",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "Made me acquainted with a weighty cause",
          "plainText": "Made me acquainted with a weighty cause",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "Of love between your daughter and himself:",
          "plainText": "Of love between your daughter and himself",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0024",
          "number": 24,
          "speechLineNumber": 6,
          "text": "And,—for the good report I hear of you,",
          "plainText": "Andfor the good report I hear of you",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0025",
          "number": 25,
          "speechLineNumber": 7,
          "text": "And for the love he beareth to your daughter,",
          "plainText": "And for the love he beareth to your daughter",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0026",
          "number": 26,
          "speechLineNumber": 8,
          "text": "And she to him,—to stay him not too long,",
          "plainText": "And she to himto stay him not too long",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0027",
          "number": 27,
          "speechLineNumber": 9,
          "text": "I am content, in a good father's care,",
          "plainText": "I am content in a good father's care",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0028",
          "number": 28,
          "speechLineNumber": 10,
          "text": "To have him match'd; and, if you please to like",
          "plainText": "To have him match'd and if you please to like",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0029",
          "number": 29,
          "speechLineNumber": 11,
          "text": "No worse than I, upon some agreement",
          "plainText": "No worse than I upon some agreement",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0030",
          "number": 30,
          "speechLineNumber": 12,
          "text": "Me shall you find ready and willing",
          "plainText": "Me shall you find ready and willing",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0031",
          "number": 31,
          "speechLineNumber": 13,
          "text": "With one consent to have her so bestow'd;",
          "plainText": "With one consent to have her so bestow'd",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0032",
          "number": 32,
          "speechLineNumber": 14,
          "text": "For curious I cannot be with you,",
          "plainText": "For curious I cannot be with you",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0033",
          "number": 33,
          "speechLineNumber": 15,
          "text": "Signior Baptista, of whom I hear so well.",
          "plainText": "Signior Baptista of whom I hear so well",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "baptista",
        "name": "BAPTISTA",
        "displayName": "Baptista"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Sir, pardon me in what I have to say.",
          "plainText": "Sir pardon me in what I have to say",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "Your plainness and your shortness please me well.",
          "plainText": "Your plainness and your shortness please me well",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Right true it is your son Lucentio here",
          "plainText": "Right true it is your son Lucentio here",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "Doth love my daughter, and she loveth him,",
          "plainText": "Doth love my daughter and she loveth him",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "Or both dissemble deeply their affections;",
          "plainText": "Or both dissemble deeply their affections",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0039",
          "number": 39,
          "speechLineNumber": 6,
          "text": "And therefore, if you say no more than this,",
          "plainText": "And therefore if you say no more than this",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0040",
          "number": 40,
          "speechLineNumber": 7,
          "text": "That like a father you will deal with him,",
          "plainText": "That like a father you will deal with him",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0041",
          "number": 41,
          "speechLineNumber": 8,
          "text": "And pass my daughter a sufficient dower,",
          "plainText": "And pass my daughter a sufficient dower",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0042",
          "number": 42,
          "speechLineNumber": 9,
          "text": "The match is made, and all is done:",
          "plainText": "The match is made and all is done",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0043",
          "number": 43,
          "speechLineNumber": 10,
          "text": "Your son shall have my daughter with consent.",
          "plainText": "Your son shall have my daughter with consent",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "tranio",
        "name": "TRANIO",
        "displayName": "Tranio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "I thank you, sir. Where then do you know best",
          "plainText": "I thank you sir Where then do you know best",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "We be affied, and such assurance ta'en",
          "plainText": "We be affied and such assurance ta'en",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "As shall with either part's agreement stand?",
          "plainText": "As shall with either part's agreement stand",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "baptista",
        "name": "BAPTISTA",
        "displayName": "Baptista"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Not in my house, Lucentio, for you know",
          "plainText": "Not in my house Lucentio for you know",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "Pitchers have ears, and I have many servants;",
          "plainText": "Pitchers have ears and I have many servants",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0049",
          "number": 49,
          "speechLineNumber": 3,
          "text": "Besides, old Gremio is hearkening still,",
          "plainText": "Besides old Gremio is hearkening still",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0050",
          "number": 50,
          "speechLineNumber": 4,
          "text": "And happily we might be interrupted.",
          "plainText": "And happily we might be interrupted",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "tranio",
        "name": "TRANIO",
        "displayName": "Tranio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Then at my lodging, and it like you:",
          "plainText": "Then at my lodging and it like you",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "There doth my father lie; and there this night",
          "plainText": "There doth my father lie and there this night",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "We'll pass the business privately and well.",
          "plainText": "We'll pass the business privately and well",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "Send for your daughter by your servant here;",
          "plainText": "Send for your daughter by your servant here",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0055",
          "number": 55,
          "speechLineNumber": 5,
          "text": "My boy shall fetch the scrivener presently.",
          "plainText": "My boy shall fetch the scrivener presently",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0056",
          "number": 56,
          "speechLineNumber": 6,
          "text": "The worst is this, that at so slender warning",
          "plainText": "The worst is this that at so slender warning",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0057",
          "number": 57,
          "speechLineNumber": 7,
          "text": "You are like to have a thin and slender pittance.",
          "plainText": "You are like to have a thin and slender pittance",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-015",
      "type": "speech",
      "speaker": {
        "id": "baptista",
        "name": "BAPTISTA",
        "displayName": "Baptista"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "It likes me well. Cambio, hie you home,",
          "plainText": "It likes me well Cambio hie you home",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "And bid Bianca make her ready straight;",
          "plainText": "And bid Bianca make her ready straight",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "And, if you will, tell what hath happened:",
          "plainText": "And if you will tell what hath happened",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0061",
          "number": 61,
          "speechLineNumber": 4,
          "text": "Lucentio's father is arriv'd in Padua,",
          "plainText": "Lucentio's father is arriv'd in Padua",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0062",
          "number": 62,
          "speechLineNumber": 5,
          "text": "And how she's like to be Lucentio's wife.",
          "plainText": "And how she's like to be Lucentio's wife",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-016",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "I pray the gods she may, with all my heart!",
          "plainText": "I pray the gods she may with all my heart",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-017",
      "type": "speech",
      "speaker": {
        "id": "tranio",
        "name": "TRANIO",
        "displayName": "Tranio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Dally not with the gods, but get thee gone.",
          "plainText": "Dally not with the gods but get thee gone",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "Signior Baptista, shall I lead the way?",
          "plainText": "Signior Baptista shall I lead the way",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "Welcome! One mess is like to be your cheer;",
          "plainText": "Welcome One mess is like to be your cheer",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0067",
          "number": 67,
          "speechLineNumber": 4,
          "text": "Come, sir; we will better it in Pisa.",
          "plainText": "Come sir we will better it in Pisa",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-018",
      "type": "speech",
      "speaker": {
        "id": "baptista",
        "name": "BAPTISTA",
        "displayName": "Baptista"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "I follow you.",
          "plainText": "I follow you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-stage-004",
      "type": "stage",
      "text": "[Exeunt Tranio, Pedant and Baptista.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-019",
      "type": "speech",
      "speaker": {
        "id": "biondello",
        "name": "BIONDELLO",
        "displayName": "Biondello"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Cambio!",
          "plainText": "Cambio",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-020",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "What say'st thou, Biondello?",
          "plainText": "What say'st thou Biondello",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-021",
      "type": "speech",
      "speaker": {
        "id": "biondello",
        "name": "BIONDELLO",
        "displayName": "Biondello"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "You saw my master wink and laugh upon you?",
          "plainText": "You saw my master wink and laugh upon you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-022",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Biondello, what of that?",
          "plainText": "Biondello what of that",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-023",
      "type": "speech",
      "speaker": {
        "id": "biondello",
        "name": "BIONDELLO",
        "displayName": "Biondello"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Faith, nothing; but has left me here behind to expound the meaning or moral of his signs and tokens.",
          "plainText": "Faith nothing but has left me here behind to expound the meaning or moral of his signs and tokens",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-024",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "I pray thee moralize them.",
          "plainText": "I pray thee moralize them",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-025",
      "type": "speech",
      "speaker": {
        "id": "biondello",
        "name": "BIONDELLO",
        "displayName": "Biondello"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Then thus: Baptista is safe, talking with the deceiving father of a deceitful son.",
          "plainText": "Then thus Baptista is safe talking with the deceiving father of a deceitful son",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-026",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "And what of him?",
          "plainText": "And what of him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-027",
      "type": "speech",
      "speaker": {
        "id": "biondello",
        "name": "BIONDELLO",
        "displayName": "Biondello"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "His daughter is to be brought by you to the supper.",
          "plainText": "His daughter is to be brought by you to the supper",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-028",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "And then?",
          "plainText": "And then",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-029",
      "type": "speech",
      "speaker": {
        "id": "biondello",
        "name": "BIONDELLO",
        "displayName": "Biondello"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "The old priest at Saint Luke's church is at your command at all hours.",
          "plainText": "The old priest at Saint Luke's church is at your command at all hours",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-030",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "And what of all this?",
          "plainText": "And what of all this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-031",
      "type": "speech",
      "speaker": {
        "id": "biondello",
        "name": "BIONDELLO",
        "displayName": "Biondello"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "I cannot tell, except they are busied about a counterfeit assurance. Take your assurance of her, cum privilegio ad imprimendum solum; to the church! take the priest, clerk, and some sufficient honest witnesses.",
          "plainText": "I cannot tell except they are busied about a counterfeit assurance Take your assurance of her cum privilegio ad imprimendum solum to the church take the priest clerk and some sufficient honest witnesses",
          "lineType": "prose"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0082",
          "number": 82,
          "speechLineNumber": 2,
          "text": "If this be not that you look for, I have more to say,",
          "plainText": "If this be not that you look for I have more to say",
          "lineType": "prose"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0083",
          "number": 83,
          "speechLineNumber": 3,
          "text": "But bid Bianca farewell for ever and a day.",
          "plainText": "But bid Bianca farewell for ever and a day",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-stage-005",
      "type": "stage",
      "text": "[Going.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-032",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "Hear'st thou, Biondello?",
          "plainText": "Hear'st thou Biondello",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-033",
      "type": "speech",
      "speaker": {
        "id": "biondello",
        "name": "BIONDELLO",
        "displayName": "Biondello"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0085",
          "number": 85,
          "speechLineNumber": 1,
          "text": "I cannot tarry: I knew a wench married in an afternoon as she went to the garden for parsley to stuff a rabbit; and so may you, sir; and so adieu, sir. My master hath appointed me to go to Saint Luke's to bid the priest be ready to come against you come with your appendix.",
          "plainText": "I cannot tarry I knew a wench married in an afternoon as she went to the garden for parsley to stuff a rabbit and so may you sir and so adieu sir My master hath appointed me to go to Saint Luke's to bid the priest be ready to come against you come with your appendix",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-4-speech-034",
      "type": "speech",
      "speaker": {
        "id": "lucentio",
        "name": "LUCENTIO",
        "displayName": "Lucentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-4-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "I may, and will, if she be so contented.",
          "plainText": "I may and will if she be so contented",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0087",
          "number": 87,
          "speechLineNumber": 2,
          "text": "She will be pleas'd; then wherefore should I doubt?",
          "plainText": "She will be pleas'd then wherefore should I doubt",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0088",
          "number": 88,
          "speechLineNumber": 3,
          "text": "Hap what hap may, I'll roundly go about her;",
          "plainText": "Hap what hap may I'll roundly go about her",
          "lineType": "verse"
        },
        {
          "id": "the-taming-of-the-shrew-4-4-line-0089",
          "number": 89,
          "speechLineNumber": 4,
          "text": "It shall go hard if Cambio go without her:",
          "plainText": "It shall go hard if Cambio go without her",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-4-stage-007",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}