  "content": [
    {
      "id": "the-taming-of-the-shrew-4-5-stage-001",
      "type": "stage",
      "text": "Enter Petruchio, Katherina, Hortensio and Servants."
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Come on, i' God's name; once more toward our father's.",
          "plainText": "Come on i' God's name once more toward our father's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Good Lord, how bright and goodly shines the moon!",
          "plainText": "Good Lord how bright and goodly shines the moon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "katherina",
        "name": "KATHERINA",
        "displayName": "Katherina"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "The moon! The sun; it is not moonlight now.",
          "plainText": "The moon The sun it is not moonlight now",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I say it is the moon that shines so bright.",
          "plainText": "I say it is the moon that shines so bright",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "katherina",
        "name": "KATHERINA",
        "displayName": "Katherina"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "I know it is the sun that shines so bright.",
          "plainText": "I know it is the sun that shines so bright",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Now by my mother's son, and that's myself,",
          "plainText": "Now by my mother's son and that's myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "It shall be moon, or star, or what I list,",
          "plainText": "It shall be moon or star or what I list",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "Or ere I journey to your father's house.",
          "plainText": "Or ere I journey to your father's house",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Go on and fetch our horses back again.",
          "plainText": "Go on and fetch our horses back again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "Evermore cross'd and cross'd; nothing but cross'd!",
          "plainText": "Evermore cross'd and cross'd nothing but cross'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Say as he says, or we shall never go.",
          "plainText": "Say as he says or we shall never go",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "katherina",
        "name": "KATHERINA",
        "displayName": "Katherina"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Forward, I pray, since we have come so far,",
          "plainText": "Forward I pray since we have come so far",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "And be it moon, or sun, or what you please;",
          "plainText": "And be it moon or sun or what you please",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "And if you please to call it a rush-candle,",
          "plainText": "And if you please to call it a rushcandle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "Henceforth I vow it shall be so for me.",
          "plainText": "Henceforth I vow it shall be so for me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "I say it is the moon.",
          "plainText": "I say it is the moon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "katherina",
        "name": "KATHERINA",
        "displayName": "Katherina"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "I know it is the moon.",
          "plainText": "I know it is the moon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Nay, then you lie; it is the blessed sun.",
          "plainText": "Nay then you lie it is the blessed sun",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "katherina",
        "name": "KATHERINA",
        "displayName": "Katherina"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Then, God be bless'd, it is the blessed sun;",
          "plainText": "Then God be bless'd it is the blessed sun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "But sun it is not when you say it is not,",
          "plainText": "But sun it is not when you say it is not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "And the moon changes even as your mind.",
          "plainText": "And the moon changes even as your mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "What you will have it nam'd, even that it is,",
          "plainText": "What you will have it nam'd even that it is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0023",
          "number": 23,
          "speechLineNumber": 5,
          "text": "And so it shall be so for Katherine.",
          "plainText": "And so it shall be so for Katherine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Petruchio, go thy ways; the field is won.",
          "plainText": "Petruchio go thy ways the field is won",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Well, forward, forward! thus the bowl should run,",
          "plainText": "Well forward forward thus the bowl should run",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "And not unluckily against the bias.",
          "plainText": "And not unluckily against the bias",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "But, soft! Company is coming here.",
          "plainText": "But soft Company is coming here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-stage-002",
      "type": "stage",
      "text": "Enter Vincentio, in a travelling dress."
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "A will make the man mad, to make a woman of him.",
          "plainText": "A will make the man mad to make a woman of him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "katherina",
        "name": "KATHERINA",
        "displayName": "Katherina"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Young budding virgin, fair and fresh and sweet,",
          "plainText": "Young budding virgin fair and fresh and sweet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "Whither away, or where is thy abode?",
          "plainText": "Whither away or where is thy abode",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "Happy the parents of so fair a child;",
          "plainText": "Happy the parents of so fair a child",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "Happier the man whom favourable stars",
          "plainText": "Happier the man whom favourable stars",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0033",
          "number": 33,
          "speechLineNumber": 5,
          "text": "Allot thee for his lovely bedfellow.",
          "plainText": "Allot thee for his lovely bedfellow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Why, how now, Kate! I hope thou art not mad:",
          "plainText": "Why how now Kate I hope thou art not mad",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "This is a man, old, wrinkled, faded, wither'd,",
          "plainText": "This is a man old wrinkled faded wither'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "And not a maiden, as thou sayst he is.",
          "plainText": "And not a maiden as thou sayst he is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "katherina",
        "name": "KATHERINA",
        "displayName": "Katherina"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Pardon, old father, my mistaking eyes,",
          "plainText": "Pardon old father my mistaking eyes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "That have been so bedazzled with the sun",
          "plainText": "That have been so bedazzled with the sun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "That everything I look on seemeth green:",
          "plainText": "That everything I look on seemeth green",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "Now I perceive thou art a reverend father;",
          "plainText": "Now I perceive thou art a reverend father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0041",
          "number": 41,
          "speechLineNumber": 5,
          "text": "Pardon, I pray thee, for my mad mistaking.",
          "plainText": "Pardon I pray thee for my mad mistaking",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Do, good old grandsire, and withal make known",
          "plainText": "Do good old grandsire and withal make known",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0043",
          "number": 43,
          "speechLineNumber": 2,
          "text": "Which way thou travellest: if along with us,",
          "plainText": "Which way thou travellest if along with us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0044",
          "number": 44,
          "speechLineNumber": 3,
          "text": "We shall be joyful of thy company.",
          "plainText": "We shall be joyful of thy company",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "vincentio",
        "name": "VINCENTIO",
        "displayName": "Vincentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Fair sir, and you my merry mistress,",
          "plainText": "Fair sir and you my merry mistress",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "That with your strange encounter much amaz'd me,",
          "plainText": "That with your strange encounter much amaz'd me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "My name is called Vincentio; my dwelling Pisa;",
          "plainText": "My name is called Vincentio my dwelling Pisa",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "And bound I am to Padua, there to visit",
          "plainText": "And bound I am to Padua there to visit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0049",
          "number": 49,
          "speechLineNumber": 5,
          "text": "A son of mine, which long I have not seen.",
          "plainText": "A son of mine which long I have not seen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "What is his name?",
          "plainText": "What is his name",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "vincentio",
        "name": "VINCENTIO",
        "displayName": "Vincentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Lucentio, gentle sir.",
          "plainText": "Lucentio gentle sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Happily met; the happier for thy son.",
          "plainText": "Happily met the happier for thy son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "And now by law, as well as reverend age,",
          "plainText": "And now by law as well as reverend age",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "I may entitle thee my loving father:",
          "plainText": "I may entitle thee my loving father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0055",
          "number": 55,
          "speechLineNumber": 4,
          "text": "The sister to my wife, this gentlewoman,",
          "plainText": "The sister to my wife this gentlewoman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0056",
          "number": 56,
          "speechLineNumber": 5,
          "text": "Thy son by this hath married. Wonder not,",
          "plainText": "Thy son by this hath married Wonder not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0057",
          "number": 57,
          "speechLineNumber": 6,
          "text": "Nor be not griev'd: she is of good esteem,",
          "plainText": "Nor be not griev'd she is of good esteem",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0058",
          "number": 58,
          "speechLineNumber": 7,
          "text": "Her dowry wealthy, and of worthy birth;",
          "plainText": "Her dowry wealthy and of worthy birth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0059",
          "number": 59,
          "speechLineNumber": 8,
          "text": "Beside, so qualified as may beseem",
          "plainText": "Beside so qualified as may beseem",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0060",
          "number": 60,
          "speechLineNumber": 9,
          "text": "The spouse of any noble gentleman.",
          "plainText": "The spouse of any noble gentleman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0061",
          "number": 61,
          "speechLineNumber": 10,
          "text": "Let me embrace with old Vincentio;",
          "plainText": "Let me embrace with old Vincentio",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0062",
          "number": 62,
          "speechLineNumber": 11,
          "text": "And wander we to see thy honest son,",
          "plainText": "And wander we to see thy honest son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0063",
          "number": 63,
          "speechLineNumber": 12,
          "text": "Who will of thy arrival be full joyous.",
          "plainText": "Who will of thy arrival be full joyous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "vincentio",
        "name": "VINCENTIO",
        "displayName": "Vincentio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "But is this true? or is it else your pleasure,",
          "plainText": "But is this true or is it else your pleasure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "Like pleasant travellers, to break a jest",
          "plainText": "Like pleasant travellers to break a jest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "Upon the company you overtake?",
          "plainText": "Upon the company you overtake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "I do assure thee, father, so it is.",
          "plainText": "I do assure thee father so it is",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "petruchio",
        "name": "PETRUCHIO",
        "displayName": "Petruchio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Come, go along, and see the truth hereof;",
          "plainText": "Come go along and see the truth hereof",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "For our first merriment hath made thee jealous.",
          "plainText": "For our first merriment hath made thee jealous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-stage-003",
      "type": "stage",
      "text": "[Exeunt all but Hortensio.]"
    },
    {
      "id": "the-taming-of-the-shrew-4-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "hortensio",
        "name": "HORTENSIO",
        "displayName": "Hortensio"
      },
      "lines": [
        {
          "id": "the-taming-of-the-shrew-4-5-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Well, Petruchio, this has put me in heart.",
          "plainText": "Well Petruchio this has put me in heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "Have to my widow! and if she be froward,",
          "plainText": "Have to my widow and if she be froward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-taming-of-the-shrew-4-5-line-0072",
          "number": 72,
          "speechLineNumber": 3,
          "text": "Then hast thou taught Hortensio to be untoward.",
          "plainText": "Then hast thou taught Hortensio to be untoward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-taming-of-the-shrew-4-5-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}