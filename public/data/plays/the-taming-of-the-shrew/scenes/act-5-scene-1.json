  "content": [
    {
      "id": "the-taming-of-the-shrew-5-1-stage-001",
      "type": "stage",
      "text": "Enter on one side Biondello, Lucentio and Bianca; Gremio walking on other side."
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-002",
      "type": "stage",
      "text": "[Exeunt Lucentio, Bianca and Biondello.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-003",
      "type": "stage",
      "text": "Enter Petruchio, Katherina, Vincentio and Attendants."
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-004",
      "type": "stage",
      "text": "[Knocks.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-005",
      "type": "stage",
      "text": "Enter Pedant above, at a window."
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-006",
      "type": "stage",
      "text": "Re-enter Biondello."
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-007",
      "type": "stage",
      "text": "[He beats Biondello.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-008",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-009",
      "type": "stage",
      "text": "[Exit from the window.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-010",
      "type": "stage",
      "text": "[They retire.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-011",
      "type": "stage",
      "text": "Re-enter Pedant, below; Baptista, Tranio and Servants."
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-012",
      "type": "stage",
      "text": "Enter one with an Officer."
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-013",
      "type": "stage",
      "text": "Re-enter Biondello, with Lucentio and Bianca."
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-014",
      "type": "stage",
      "text": "[Biondello, Tranio and Pedant run out.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-015",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-016",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-017",
      "type": "stage",
      "text": "[Exeunt Lucentio and Bianca.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-018",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-019",
      "type": "stage",
      "text": "Petruchio and Katherina advance."
    },
    {
      "id": "the-taming-of-the-shrew-5-1-stage-020",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
