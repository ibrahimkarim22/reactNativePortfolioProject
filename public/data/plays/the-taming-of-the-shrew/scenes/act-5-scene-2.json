  "content": [
    {
      "id": "the-taming-of-the-shrew-5-2-stage-001",
      "type": "stage",
      "text": "Enter Baptista, Vincentio, Gremio, the Pedant, Lucentio, Bianca, Petruchio, Katherina, Hortensio and Widow. Tranio, Biondello and Grumio and Others, attending."
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-002",
      "type": "stage",
      "text": "[They sit at table.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-003",
      "type": "stage",
      "text": "[Drinks to Hortensio.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-004",
      "type": "stage",
      "text": "[Exeunt Bianca, Katherina and Widow.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-005",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-006",
      "type": "stage",
      "text": "Re-enter Biondello."
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-007",
      "type": "stage",
      "text": "[Exit Biondello.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-008",
      "type": "stage",
      "text": "Re-enter Biondello."
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-009",
      "type": "stage",
      "text": "[Exit Grumio.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-010",
      "type": "stage",
      "text": "Re-enter Katherina."
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-011",
      "type": "stage",
      "text": "[Exit Katherina.]"
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-012",
      "type": "stage",
      "text": "Re-enter Katherina with Bianca and Widow."
    },
    {
      "id": "the-taming-of-the-shrew-5-2-stage-013",
