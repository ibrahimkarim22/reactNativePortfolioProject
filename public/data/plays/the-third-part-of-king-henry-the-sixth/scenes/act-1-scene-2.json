  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-stage-001",
      "type": "stage",
      "text": "Enter Edward, Richard and Montague."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Brother, though I be youngest, give me leave.",
          "plainText": "Brother though I be youngest give me leave",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "edward",
        "name": "EDWARD",
        "displayName": "Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "No, I can better play the orator.",
          "plainText": "No I can better play the orator",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "montague",
        "name": "MONTAGUE",
        "displayName": "Montague"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "But I have reasons strong and forcible.",
          "plainText": "But I have reasons strong and forcible",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-stage-002",
      "type": "stage",
      "text": "Enter the Duke of York."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Why, how now, sons and brother, at a strife?",
          "plainText": "Why how now sons and brother at a strife",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "What is your quarrel? How began it first?",
          "plainText": "What is your quarrel How began it first",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "edward",
        "name": "EDWARD",
        "displayName": "Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "No quarrel, but a slight contention.",
          "plainText": "No quarrel but a slight contention",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "About what?",
          "plainText": "About what",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "About that which concerns your Grace and us:",
          "plainText": "About that which concerns your Grace and us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "The crown of England, father, which is yours.",
          "plainText": "The crown of England father which is yours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Mine, boy? Not till King Henry be dead.",
          "plainText": "Mine boy Not till King Henry be dead",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Your right depends not on his life or death.",
          "plainText": "Your right depends not on his life or death",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "edward",
        "name": "EDWARD",
        "displayName": "Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Now you are heir, therefore enjoy it now.",
          "plainText": "Now you are heir therefore enjoy it now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "By giving the house of Lancaster leave to breathe,",
          "plainText": "By giving the house of Lancaster leave to breathe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "It will outrun you, father, in the end.",
          "plainText": "It will outrun you father in the end",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "I took an oath that he should quietly reign.",
          "plainText": "I took an oath that he should quietly reign",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "edward",
        "name": "EDWARD",
        "displayName": "Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "But for a kingdom any oath may be broken.",
          "plainText": "But for a kingdom any oath may be broken",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "I would break a thousand oaths to reign one year.",
          "plainText": "I would break a thousand oaths to reign one year",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "No; God forbid your Grace should be forsworn.",
          "plainText": "No God forbid your Grace should be forsworn",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I shall be, if I claim by open war.",
          "plainText": "I shall be if I claim by open war",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "I'll prove the contrary if you'll hear me speak.",
          "plainText": "I'll prove the contrary if you'll hear me speak",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Thou canst not, son; it is impossible.",
          "plainText": "Thou canst not son it is impossible",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "An oath is of no moment, being not took",
          "plainText": "An oath is of no moment being not took",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Before a true and lawful magistrate",
          "plainText": "Before a true and lawful magistrate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "That hath authority over him that swears.",
          "plainText": "That hath authority over him that swears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "Henry had none, but did usurp the place;",
          "plainText": "Henry had none but did usurp the place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0026",
          "number": 26,
          "speechLineNumber": 5,
          "text": "Then, seeing 'twas he that made you to depose,",
          "plainText": "Then seeing 'twas he that made you to depose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0027",
          "number": 27,
          "speechLineNumber": 6,
          "text": "Your oath, my lord, is vain and frivolous.",
          "plainText": "Your oath my lord is vain and frivolous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0028",
          "number": 28,
          "speechLineNumber": 7,
          "text": "Therefore, to arms! And, father, do but think",
          "plainText": "Therefore to arms And father do but think",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0029",
          "number": 29,
          "speechLineNumber": 8,
          "text": "How sweet a thing it is to wear a crown,",
          "plainText": "How sweet a thing it is to wear a crown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0030",
          "number": 30,
          "speechLineNumber": 9,
          "text": "Within whose circuit is Elysium",
          "plainText": "Within whose circuit is Elysium",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0031",
          "number": 31,
          "speechLineNumber": 10,
          "text": "And all that poets feign of bliss and joy.",
          "plainText": "And all that poets feign of bliss and joy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0032",
          "number": 32,
          "speechLineNumber": 11,
          "text": "Why do we linger thus? I cannot rest",
          "plainText": "Why do we linger thus I cannot rest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0033",
          "number": 33,
          "speechLineNumber": 12,
          "text": "Until the white rose that I wear be dyed",
          "plainText": "Until the white rose that I wear be dyed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0034",
          "number": 34,
          "speechLineNumber": 13,
          "text": "Even in the lukewarm blood of Henry's heart.",
          "plainText": "Even in the lukewarm blood of Henry's heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Richard, enough; I will be king, or die.",
          "plainText": "Richard enough I will be king or die",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "Brother, thou shalt to London presently,",
          "plainText": "Brother thou shalt to London presently",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "And whet on Warwick to this enterprise.",
          "plainText": "And whet on Warwick to this enterprise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0038",
          "number": 38,
          "speechLineNumber": 4,
          "text": "Thou, Richard, shalt to the Duke of Norfolk",
          "plainText": "Thou Richard shalt to the Duke of Norfolk",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0039",
          "number": 39,
          "speechLineNumber": 5,
          "text": "And tell him privily of our intent.",
          "plainText": "And tell him privily of our intent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0040",
          "number": 40,
          "speechLineNumber": 6,
          "text": "You, Edward, shall unto my Lord Cobham,",
          "plainText": "You Edward shall unto my Lord Cobham",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0041",
          "number": 41,
          "speechLineNumber": 7,
          "text": "With whom the Kentishmen will willingly rise.",
          "plainText": "With whom the Kentishmen will willingly rise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0042",
          "number": 42,
          "speechLineNumber": 8,
          "text": "In them I trust; for they are soldiers,",
          "plainText": "In them I trust for they are soldiers",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0043",
          "number": 43,
          "speechLineNumber": 9,
          "text": "Witty, courteous, liberal, full of spirit.",
          "plainText": "Witty courteous liberal full of spirit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0044",
          "number": 44,
          "speechLineNumber": 10,
          "text": "While you are thus employed, what resteth more",
          "plainText": "While you are thus employed what resteth more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0045",
          "number": 45,
          "speechLineNumber": 11,
          "text": "But that I seek occasion how to rise,",
          "plainText": "But that I seek occasion how to rise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0046",
          "number": 46,
          "speechLineNumber": 12,
          "text": "And yet the King not privy to my drift,",
          "plainText": "And yet the King not privy to my drift",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0047",
          "number": 47,
          "speechLineNumber": 13,
          "text": "Nor any of the house of Lancaster?",
          "plainText": "Nor any of the house of Lancaster",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-stage-003",
      "type": "stage",
      "text": "Enter a Messenger."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "The Queen, with all the northern earls and lords",
          "plainText": "The Queen with all the northern earls and lords",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "Intend here to besiege you in your castle.",
          "plainText": "Intend here to besiege you in your castle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "She is hard by with twenty thousand men;",
          "plainText": "She is hard by with twenty thousand men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "And therefore fortify your hold, my lord.",
          "plainText": "And therefore fortify your hold my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Ay, with my sword. What, think'st thou that we fear them?",
          "plainText": "Ay with my sword What think'st thou that we fear them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Edward and Richard, you shall stay with me;",
          "plainText": "Edward and Richard you shall stay with me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "My brother Montague shall post to London.",
          "plainText": "My brother Montague shall post to London",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0055",
          "number": 55,
          "speechLineNumber": 4,
          "text": "Let noble Warwick, Cobham, and the rest,",
          "plainText": "Let noble Warwick Cobham and the rest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0056",
          "number": 56,
          "speechLineNumber": 5,
          "text": "Whom we have left protectors of the King,",
          "plainText": "Whom we have left protectors of the King",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0057",
          "number": 57,
          "speechLineNumber": 6,
          "text": "With powerful policy strengthen themselves,",
          "plainText": "With powerful policy strengthen themselves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0058",
          "number": 58,
          "speechLineNumber": 7,
          "text": "And trust not simple Henry nor his oaths.",
          "plainText": "And trust not simple Henry nor his oaths",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "montague",
        "name": "MONTAGUE",
        "displayName": "Montague"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Brother, I go; I'll win them, fear it not.",
          "plainText": "Brother I go I'll win them fear it not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "And thus most humbly I do take my leave.",
          "plainText": "And thus most humbly I do take my leave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-stage-005",
      "type": "stage",
      "text": "Enter Sir John and Sir Hugh Mortimer."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "Sir John and Sir Hugh Mortimer, mine uncles,",
          "plainText": "Sir John and Sir Hugh Mortimer mine uncles",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "You are come to Sandal in a happy hour;",
          "plainText": "You are come to Sandal in a happy hour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "The army of the Queen mean to besiege us.",
          "plainText": "The army of the Queen mean to besiege us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "sir-john",
        "name": "SIR JOHN",
        "displayName": "Sir John"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "She shall not need; we'll meet her in the field.",
          "plainText": "She shall not need we'll meet her in the field",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "What, with five thousand men?",
          "plainText": "What with five thousand men",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Ay, with five hundred, father, for a need.",
          "plainText": "Ay with five hundred father for a need",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "A woman's general; what should we fear?",
          "plainText": "A woman's general what should we fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-stage-006",
      "type": "stage",
      "text": "[A march afar off.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "edward",
        "name": "EDWARD",
        "displayName": "Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "I hear their drums. Let's set our men in order,",
          "plainText": "I hear their drums Let's set our men in order",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "And issue forth and bid them battle straight.",
          "plainText": "And issue forth and bid them battle straight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "york",
        "name": "YORK",
        "displayName": "York"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Five men to twenty! Though the odds be great,",
          "plainText": "Five men to twenty Though the odds be great",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "I doubt not, uncle, of our victory.",
          "plainText": "I doubt not uncle of our victory",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0072",
          "number": 72,
          "speechLineNumber": 3,
          "text": "Many a battle have I won in France",
          "plainText": "Many a battle have I won in France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0073",
          "number": 73,
          "speechLineNumber": 4,
          "text": "Whenas the enemy hath been ten to one.",
          "plainText": "Whenas the enemy hath been ten to one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-2-line-0074",
          "number": 74,
          "speechLineNumber": 5,
          "text": "Why should I not now have the like success?",
          "plainText": "Why should I not now have the like success",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-2-stage-007",
      "type": "stage",
      "text": "[Alarum. Exeunt.]"
    }
  ]
}