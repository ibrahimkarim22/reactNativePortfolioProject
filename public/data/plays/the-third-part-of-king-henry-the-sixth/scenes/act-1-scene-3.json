  "scene": {
    "id": "the-third-part-of-king-henry-the-sixth-1-3",
    "act": 1,
    "scene": 3,
    "label": "Act 1, Scene 3",
    "title": "SCENE III. Plains near Sandal Castle",
    "location": "Plains near Sandal Castle",
    "orderInPlay": 3
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-stage-001",
      "type": "stage",
      "text": "Alarums. Enter Rutland and his Tutor."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "rutland",
        "name": "RUTLAND",
        "displayName": "Rutland"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Ah, whither shall I fly to scape their hands?",
          "plainText": "Ah whither shall I fly to scape their hands",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Ah, tutor, look where bloody Clifford comes.",
          "plainText": "Ah tutor look where bloody Clifford comes",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-stage-002",
      "type": "stage",
      "text": "Enter Clifford and Soldiers."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Chaplain, away! Thy priesthood saves thy life.",
          "plainText": "Chaplain away Thy priesthood saves thy life",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "As for the brat of this accursed duke",
          "plainText": "As for the brat of this accursed duke",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Whose father slew my father, he shall die.",
          "plainText": "Whose father slew my father he shall die",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "tutor",
        "name": "TUTOR",
        "displayName": "Tutor"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "And I, my lord, will bear him company.",
          "plainText": "And I my lord will bear him company",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Soldiers, away with him!",
          "plainText": "Soldiers away with him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "tutor",
        "name": "TUTOR",
        "displayName": "Tutor"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Ah, Clifford, murder not this innocent child,",
          "plainText": "Ah Clifford murder not this innocent child",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Lest thou be hated both of God and man.",
          "plainText": "Lest thou be hated both of God and man",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-stage-003",
      "type": "stage",
      "text": "[Exit, dragged off by Soldiers.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "How now? Is he dead already? Or is it fear",
          "plainText": "How now Is he dead already Or is it fear",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "That makes him close his eyes? I'll open them.",
          "plainText": "That makes him close his eyes I'll open them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "rutland",
        "name": "RUTLAND",
        "displayName": "Rutland"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "So looks the pent-up lion o'er the wretch",
          "plainText": "So looks the pentup lion o'er the wretch",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "That trembles under his devouring paws;",
          "plainText": "That trembles under his devouring paws",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "And so he walks, insulting o'er his prey,",
          "plainText": "And so he walks insulting o'er his prey",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "And so he comes to rend his limbs asunder.",
          "plainText": "And so he comes to rend his limbs asunder",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "Ah, gentle Clifford, kill me with thy sword,",
          "plainText": "Ah gentle Clifford kill me with thy sword",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "And not with such a cruel threat'ning look.",
          "plainText": "And not with such a cruel threat'ning look",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0018",
          "number": 18,
          "speechLineNumber": 7,
          "text": "Sweet Clifford, hear me speak before I die.",
          "plainText": "Sweet Clifford hear me speak before I die",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0019",
          "number": 19,
          "speechLineNumber": 8,
          "text": "I am too mean a subject for thy wrath;",
          "plainText": "I am too mean a subject for thy wrath",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0020",
          "number": 20,
          "speechLineNumber": 9,
          "text": "Be thou revenged on men, and let me live.",
          "plainText": "Be thou revenged on men and let me live",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "In vain thou speak'st, poor boy; my father's blood",
          "plainText": "In vain thou speak'st poor boy my father's blood",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "Hath stopped the passage where thy words should enter.",
          "plainText": "Hath stopped the passage where thy words should enter",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "rutland",
        "name": "RUTLAND",
        "displayName": "Rutland"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Then let my father's blood open it again;",
          "plainText": "Then let my father's blood open it again",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "He is a man, and, Clifford, cope with him.",
          "plainText": "He is a man and Clifford cope with him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Had I thy brethren here, their lives and thine",
          "plainText": "Had I thy brethren here their lives and thine",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Were not revenge sufficient for me.",
          "plainText": "Were not revenge sufficient for me",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "No, if I digged up thy forefathers' graves",
          "plainText": "No if I digged up thy forefathers' graves",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "And hung their rotten coffins up in chains,",
          "plainText": "And hung their rotten coffins up in chains",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0029",
          "number": 29,
          "speechLineNumber": 5,
          "text": "It could not slake mine ire nor ease my heart.",
          "plainText": "It could not slake mine ire nor ease my heart",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0030",
          "number": 30,
          "speechLineNumber": 6,
          "text": "The sight of any of the house of York",
          "plainText": "The sight of any of the house of York",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0031",
          "number": 31,
          "speechLineNumber": 7,
          "text": "Is as a fury to torment my soul;",
          "plainText": "Is as a fury to torment my soul",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0032",
          "number": 32,
          "speechLineNumber": 8,
          "text": "And till I root out their accursed line",
          "plainText": "And till I root out their accursed line",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0033",
          "number": 33,
          "speechLineNumber": 9,
          "text": "And leave not one alive, I live in hell.",
          "plainText": "And leave not one alive I live in hell",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0034",
          "number": 34,
          "speechLineNumber": 10,
          "text": "Therefore—",
          "plainText": "Therefore",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-stage-004",
      "type": "stage",
      "text": "[Lifting his hand.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "rutland",
        "name": "RUTLAND",
        "displayName": "Rutland"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "O, let me pray before I take my death!",
          "plainText": "O let me pray before I take my death",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "To thee I pray; sweet Clifford, pity me!",
          "plainText": "To thee I pray sweet Clifford pity me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Such pity as my rapier's point affords.",
          "plainText": "Such pity as my rapier's point affords",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "rutland",
        "name": "RUTLAND",
        "displayName": "Rutland"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "I never did thee harm; why wilt thou slay me?",
          "plainText": "I never did thee harm why wilt thou slay me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Thy father hath.",
          "plainText": "Thy father hath",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "rutland",
        "name": "RUTLAND",
        "displayName": "Rutland"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "But 'twas ere I was born.",
          "plainText": "But 'twas ere I was born",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Thou hast one son; for his sake pity me,",
          "plainText": "Thou hast one son for his sake pity me",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Lest in revenge thereof, sith God is just,",
          "plainText": "Lest in revenge thereof sith God is just",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "He be as miserably slain as I.",
          "plainText": "He be as miserably slain as I",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0044",
          "number": 44,
          "speechLineNumber": 5,
          "text": "Ah, let me live in prison all my days,",
          "plainText": "Ah let me live in prison all my days",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0045",
          "number": 45,
          "speechLineNumber": 6,
          "text": "And when I give occasion of offence",
          "plainText": "And when I give occasion of offence",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0046",
          "number": 46,
          "speechLineNumber": 7,
          "text": "Then let me die, for now thou hast no cause.",
          "plainText": "Then let me die for now thou hast no cause",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "No cause? Thy father slew my father; therefore die.",
          "plainText": "No cause Thy father slew my father therefore die",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-stage-005",
      "type": "stage",
      "text": "[Clifford stabs him.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "rutland",
        "name": "RUTLAND",
        "displayName": "Rutland"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Di faciant laudis summa sit ista tuae!",
          "plainText": "Di faciant laudis summa sit ista tuae",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-stage-006",
      "type": "stage",
      "text": "[Dies.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "clifford",
        "name": "CLIFFORD",
        "displayName": "Clifford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Plantagenet! I come, Plantagenet!",
          "plainText": "Plantagenet I come Plantagenet",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "And this thy son's blood cleaving to my blade",
          "plainText": "And this thy son's blood cleaving to my blade",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "Shall rust upon my weapon till thy blood,",
          "plainText": "Shall rust upon my weapon till thy blood",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-1-3-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "Congealed with this, do make me wipe off both.",
          "plainText": "Congealed with this do make me wipe off both",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-1-3-stage-007",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}