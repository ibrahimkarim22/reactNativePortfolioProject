  "scene": {
    "id": "the-third-part-of-king-henry-the-sixth-4-3",
    "act": 4,
    "scene": 3,
    "label": "Act 4, Scene 3",
    "title": "SCENE III. Edward's Camp near Warwick",
    "location": "Edward's Camp near Warwick",
    "orderInPlay": 16
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-stage-001",
      "type": "stage",
      "text": "Enter three Watchmen to guard the King's tent."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "1-watchman",
        "name": "1 WATCHMAN",
        "displayName": "1 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Come on, my masters, each man take his stand.",
          "plainText": "Come on my masters each man take his stand",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The King by this is set him down to sleep.",
          "plainText": "The King by this is set him down to sleep",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "2-watchman",
        "name": "2 WATCHMAN",
        "displayName": "2 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "What, will he not to bed?",
          "plainText": "What will he not to bed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "1-watchman",
        "name": "1 WATCHMAN",
        "displayName": "1 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Why, no; for he hath made a solemn vow",
          "plainText": "Why no for he hath made a solemn vow",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Never to lie and take his natural rest",
          "plainText": "Never to lie and take his natural rest",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "Till Warwick or himself be quite suppressed.",
          "plainText": "Till Warwick or himself be quite suppressed",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "2-watchman",
        "name": "2 WATCHMAN",
        "displayName": "2 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Tomorrow, then, belike shall be the day,",
          "plainText": "Tomorrow then belike shall be the day",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "If Warwick be so near as men report.",
          "plainText": "If Warwick be so near as men report",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "3-watchman",
        "name": "3 WATCHMAN",
        "displayName": "3 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "But say, I pray, what nobleman is that",
          "plainText": "But say I pray what nobleman is that",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "That with the King here resteth in his tent?",
          "plainText": "That with the King here resteth in his tent",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "1-watchman",
        "name": "1 WATCHMAN",
        "displayName": "1 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "'Tis the Lord Hastings, the King's chiefest friend.",
          "plainText": "'Tis the Lord Hastings the King's chiefest friend",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "3-watchman",
        "name": "3 WATCHMAN",
        "displayName": "3 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "O, is it so? But why commands the King",
          "plainText": "O is it so But why commands the King",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "That his chief followers lodge in towns about him,",
          "plainText": "That his chief followers lodge in towns about him",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "While he himself keeps in the cold field?",
          "plainText": "While he himself keeps in the cold field",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "2-watchman",
        "name": "2 WATCHMAN",
        "displayName": "2 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "'Tis the more honour, because more dangerous.",
          "plainText": "'Tis the more honour because more dangerous",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "3-watchman",
        "name": "3 WATCHMAN",
        "displayName": "3 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Ay, but give me worship and quietness;",
          "plainText": "Ay but give me worship and quietness",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "I like it better than dangerous honour.",
          "plainText": "I like it better than dangerous honour",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "If Warwick knew in what estate he stands,",
          "plainText": "If Warwick knew in what estate he stands",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "'Tis to be doubted he would waken him.",
          "plainText": "'Tis to be doubted he would waken him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "1-watchman",
        "name": "1 WATCHMAN",
        "displayName": "1 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Unless our halberds did shut up his passage.",
          "plainText": "Unless our halberds did shut up his passage",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "2-watchman",
        "name": "2 WATCHMAN",
        "displayName": "2 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Ay, wherefore else guard we his royal tent",
          "plainText": "Ay wherefore else guard we his royal tent",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "But to defend his person from night-foes?",
          "plainText": "But to defend his person from nightfoes",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-stage-002",
      "type": "stage",
      "text": "Enter Warwick, George (Duke of Clarence), Oxford, Somerset and French Soldiers, silent all."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "This is his tent; and see where stand his guard.",
          "plainText": "This is his tent and see where stand his guard",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Courage, my masters! Honour now or never!",
          "plainText": "Courage my masters Honour now or never",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "But follow me, and Edward shall be ours.",
          "plainText": "But follow me and Edward shall be ours",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "1-watchman",
        "name": "1 WATCHMAN",
        "displayName": "1 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Who goes there?",
          "plainText": "Who goes there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "2-watchman",
        "name": "2 WATCHMAN",
        "displayName": "2 Watchman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Stay, or thou diest.",
          "plainText": "Stay or thou diest",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-stage-003",
      "type": "stage",
      "text": "[Warwick and the rest cry all, \"Warwick! Warwick!\" and set upon the guard, who fly, crying \"Arm! Arm!\" Warwick and the rest following them.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-stage-004",
      "type": "stage",
      "text": "The drum playing and trumpet sounding, enter Warwick, Somerset, and the rest, bringing the King out in his gown, sitting in a chair. Richard (Duke of Gloucester) and Hastings fly over the stage."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "somerset",
        "name": "SOMERSET",
        "displayName": "Somerset"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "What are they that fly there?",
          "plainText": "What are they that fly there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Richard and Hastings.",
          "plainText": "Richard and Hastings",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "Let them go. Here is the Duke.",
          "plainText": "Let them go Here is the Duke",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "The Duke? Why, Warwick, when we parted,",
          "plainText": "The Duke Why Warwick when we parted",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Thou call'dst me king?",
          "plainText": "Thou call'dst me king",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Ay, but the case is altered.",
          "plainText": "Ay but the case is altered",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "When you disgraced me in my embassade,",
          "plainText": "When you disgraced me in my embassade",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "Then I degraded you from being king,",
          "plainText": "Then I degraded you from being king",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "And come now to create you Duke of York.",
          "plainText": "And come now to create you Duke of York",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0037",
          "number": 37,
          "speechLineNumber": 5,
          "text": "Alas, how should you govern any kingdom",
          "plainText": "Alas how should you govern any kingdom",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0038",
          "number": 38,
          "speechLineNumber": 6,
          "text": "That know not how to use ambassadors,",
          "plainText": "That know not how to use ambassadors",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0039",
          "number": 39,
          "speechLineNumber": 7,
          "text": "Nor how to be contented with one wife,",
          "plainText": "Nor how to be contented with one wife",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0040",
          "number": 40,
          "speechLineNumber": 8,
          "text": "Nor how to use your brothers brotherly,",
          "plainText": "Nor how to use your brothers brotherly",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0041",
          "number": 41,
          "speechLineNumber": 9,
          "text": "Nor how to study for the people's welfare,",
          "plainText": "Nor how to study for the people's welfare",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0042",
          "number": 42,
          "speechLineNumber": 10,
          "text": "Nor how to shroud yourself from enemies?",
          "plainText": "Nor how to shroud yourself from enemies",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Yea, brother of Clarence, art thou here too?",
          "plainText": "Yea brother of Clarence art thou here too",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "Nay, then I see that Edward needs must down.",
          "plainText": "Nay then I see that Edward needs must down",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Yet, Warwick, in despite of all mischance",
          "plainText": "Yet Warwick in despite of all mischance",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "Of thee thyself and all thy complices,",
          "plainText": "Of thee thyself and all thy complices",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0047",
          "number": 47,
          "speechLineNumber": 5,
          "text": "Edward will always bear himself as king.",
          "plainText": "Edward will always bear himself as king",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0048",
          "number": 48,
          "speechLineNumber": 6,
          "text": "Though Fortune's malice overthrow my state,",
          "plainText": "Though Fortune's malice overthrow my state",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0049",
          "number": 49,
          "speechLineNumber": 7,
          "text": "My mind exceeds the compass of her wheel.",
          "plainText": "My mind exceeds the compass of her wheel",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-3-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Then for his mind be Edward England's king;",
          "plainText": "Then for his mind be Edward England's king",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-stage-005",
      "type": "stage",
      "text": "[Takes off his crown.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-stage-006",
      "type": "stage",
      "text": "[They begin to lead him out forcibly.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
