  "scene": {
    "id": "the-third-part-of-king-henry-the-sixth-4-5",
    "act": 4,
    "scene": 5,
    "label": "Act 4, Scene 5",
    "title": "SCENE V. A park near Middleham Castle in Yorkshire",
    "location": "A park near Middleham Castle in Yorkshire",
    "orderInPlay": 18
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-stage-001",
      "type": "stage",
      "text": "Enter Richard (Duke of Gloucester), Lord Hastings, Sir William Stanley and others."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Now, my Lord Hastings and Sir William Stanley,",
          "plainText": "Now my Lord Hastings and Sir William Stanley",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Leave off to wonder why I drew you hither",
          "plainText": "Leave off to wonder why I drew you hither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Into this chiefest thicket of the park.",
          "plainText": "Into this chiefest thicket of the park",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Thus stands the case: you know our King, my brother,",
          "plainText": "Thus stands the case you know our King my brother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Is prisoner to the Bishop here, at whose hands",
          "plainText": "Is prisoner to the Bishop here at whose hands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "He hath good usage and great liberty,",
          "plainText": "He hath good usage and great liberty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "And often but attended with weak guard,",
          "plainText": "And often but attended with weak guard",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Comes hunting this way to disport himself.",
          "plainText": "Comes hunting this way to disport himself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "I have advertised him by secret means",
          "plainText": "I have advertised him by secret means",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "That if about this hour he make this way,",
          "plainText": "That if about this hour he make this way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Under the colour of his usual game,",
          "plainText": "Under the colour of his usual game",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "He shall here find his friends with horse and men",
          "plainText": "He shall here find his friends with horse and men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "To set him free from his captivity.",
          "plainText": "To set him free from his captivity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-stage-002",
      "type": "stage",
      "text": "Enter King Edward and a Huntsman with him."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "huntsman",
        "name": "HUNTSMAN",
        "displayName": "Huntsman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "This way, my lord, for this way lies the game.",
          "plainText": "This way my lord for this way lies the game",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Nay, this way, man. See where the huntsmen stand.",
          "plainText": "Nay this way man See where the huntsmen stand",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Now, brother of Gloucester, Lord Hastings, and the rest,",
          "plainText": "Now brother of Gloucester Lord Hastings and the rest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "Stand you thus close to steal the Bishop's deer?",
          "plainText": "Stand you thus close to steal the Bishop's deer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Brother, the time and case requireth haste;",
          "plainText": "Brother the time and case requireth haste",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Your horse stands ready at the park corner.",
          "plainText": "Your horse stands ready at the park corner",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "But whither shall we then?",
          "plainText": "But whither shall we then",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "hastings",
        "name": "HASTINGS",
        "displayName": "Hastings"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "To Lynn, my lord, and shipped from thence to Flanders.",
          "plainText": "To Lynn my lord and shipped from thence to Flanders",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Well guessed, believe me, for that was my meaning.",
          "plainText": "Well guessed believe me for that was my meaning",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Stanley, I will requite thy forwardness.",
          "plainText": "Stanley I will requite thy forwardness",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "But wherefore stay we? 'Tis no time to talk.",
          "plainText": "But wherefore stay we 'Tis no time to talk",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Huntsman, what sayst thou? Wilt thou go along?",
          "plainText": "Huntsman what sayst thou Wilt thou go along",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "huntsman",
        "name": "HUNTSMAN",
        "displayName": "Huntsman"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Better do so than tarry and be hanged.",
          "plainText": "Better do so than tarry and be hanged",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Come then, away! Let's ha' no more ado.",
          "plainText": "Come then away Let's ha' no more ado",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Bishop, farewell; shield thee from Warwick's frown,",
          "plainText": "Bishop farewell shield thee from Warwick's frown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-5-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "And pray that I may repossess the crown.",
          "plainText": "And pray that I may repossess the crown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-5-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}