    "title": "SCENE VI. London. The Tower",
    "location": "London. The Tower",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-stage-001",
      "type": "stage",
      "text": "Enter King Henry, George (Duke of Clarence), Warwick, Somerset, young Richmond, Oxford, Montague, and Lieutenant of the Tower."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Master Lieutenant, now that God and friends",
          "plainText": "Master Lieutenant now that God and friends",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Have shaken Edward from the regal seat",
          "plainText": "Have shaken Edward from the regal seat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And turned my captive state to liberty,",
          "plainText": "And turned my captive state to liberty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "My fear to hope, my sorrows unto joys,",
          "plainText": "My fear to hope my sorrows unto joys",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "At our enlargement what are thy due fees?",
          "plainText": "At our enlargement what are thy due fees",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lieutenant",
        "name": "LIEUTENANT",
        "displayName": "Lieutenant"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Subjects may challenge nothing of their sovereigns;",
          "plainText": "Subjects may challenge nothing of their sovereigns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "But if an humble prayer may prevail,",
          "plainText": "But if an humble prayer may prevail",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "I then crave pardon of your Majesty.",
          "plainText": "I then crave pardon of your Majesty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "For what, lieutenant? For well using me?",
          "plainText": "For what lieutenant For well using me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Nay, be thou sure I'll well requite thy kindness,",
          "plainText": "Nay be thou sure I'll well requite thy kindness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "For that it made my imprisonment a pleasure;",
          "plainText": "For that it made my imprisonment a pleasure",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "Ay, such a pleasure as incaged birds",
          "plainText": "Ay such a pleasure as incaged birds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "Conceive when, after many moody thoughts,",
          "plainText": "Conceive when after many moody thoughts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0014",
          "number": 14,
          "speechLineNumber": 6,
          "text": "At last by notes of household harmony",
          "plainText": "At last by notes of household harmony",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0015",
          "number": 15,
          "speechLineNumber": 7,
          "text": "They quite forget their loss of liberty.",
          "plainText": "They quite forget their loss of liberty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0016",
          "number": 16,
          "speechLineNumber": 8,
          "text": "But, Warwick, after God thou sett'st me free,",
          "plainText": "But Warwick after God thou sett'st me free",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0017",
          "number": 17,
          "speechLineNumber": 9,
          "text": "And chiefly therefore I thank God and thee;",
          "plainText": "And chiefly therefore I thank God and thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0018",
          "number": 18,
          "speechLineNumber": 10,
          "text": "He was the author, thou the instrument.",
          "plainText": "He was the author thou the instrument",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0019",
          "number": 19,
          "speechLineNumber": 11,
          "text": "Therefore, that I may conquer Fortune's spite,",
          "plainText": "Therefore that I may conquer Fortune's spite",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0020",
          "number": 20,
          "speechLineNumber": 12,
          "text": "By living low where Fortune cannot hurt me,",
          "plainText": "By living low where Fortune cannot hurt me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0021",
          "number": 21,
          "speechLineNumber": 13,
          "text": "And that the people of this blessed land",
          "plainText": "And that the people of this blessed land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0022",
          "number": 22,
          "speechLineNumber": 14,
          "text": "May not be punished with my thwarting stars,",
          "plainText": "May not be punished with my thwarting stars",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0023",
          "number": 23,
          "speechLineNumber": 15,
          "text": "Warwick, although my head still wear the crown,",
          "plainText": "Warwick although my head still wear the crown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0024",
          "number": 24,
          "speechLineNumber": 16,
          "text": "I here resign my government to thee,",
          "plainText": "I here resign my government to thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0025",
          "number": 25,
          "speechLineNumber": 17,
          "text": "For thou art fortunate in all thy deeds.",
          "plainText": "For thou art fortunate in all thy deeds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Your Grace hath still been famed for virtuous,",
          "plainText": "Your Grace hath still been famed for virtuous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "And now may seem as wise as virtuous",
          "plainText": "And now may seem as wise as virtuous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "By spying and avoiding Fortune's malice,",
          "plainText": "By spying and avoiding Fortune's malice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "For few men rightly temper with the stars;",
          "plainText": "For few men rightly temper with the stars",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0030",
          "number": 30,
          "speechLineNumber": 5,
          "text": "Yet in this one thing let me blame your Grace,",
          "plainText": "Yet in this one thing let me blame your Grace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0031",
          "number": 31,
          "speechLineNumber": 6,
          "text": "For choosing me when Clarence is in place.",
          "plainText": "For choosing me when Clarence is in place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "No, Warwick, thou art worthy of the sway,",
          "plainText": "No Warwick thou art worthy of the sway",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "To whom the heavens in thy nativity",
          "plainText": "To whom the heavens in thy nativity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "Adjudged an olive branch and laurel crown,",
          "plainText": "Adjudged an olive branch and laurel crown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "As likely to be blest in peace and war;",
          "plainText": "As likely to be blest in peace and war",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "And therefore I yield thee my free consent.",
          "plainText": "And therefore I yield thee my free consent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "And I choose Clarence only for Protector.",
          "plainText": "And I choose Clarence only for Protector",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-007",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Warwick and Clarence, give me both your hands.",
          "plainText": "Warwick and Clarence give me both your hands",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "Now join your hands, and with your hands your hearts,",
          "plainText": "Now join your hands and with your hands your hearts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "That no dissension hinder government.",
          "plainText": "That no dissension hinder government",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0041",
          "number": 41,
          "speechLineNumber": 4,
          "text": "I make you both Protectors of this land,",
          "plainText": "I make you both Protectors of this land",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0042",
          "number": 42,
          "speechLineNumber": 5,
          "text": "While I myself will lead a private life",
          "plainText": "While I myself will lead a private life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0043",
          "number": 43,
          "speechLineNumber": 6,
          "text": "And in devotion spend my latter days,",
          "plainText": "And in devotion spend my latter days",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0044",
          "number": 44,
          "speechLineNumber": 7,
          "text": "To sin's rebuke and my Creator's praise.",
          "plainText": "To sin's rebuke and my Creator's praise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-008",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "What answers Clarence to his sovereign's will?",
          "plainText": "What answers Clarence to his sovereign's will",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-009",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "That he consents, if Warwick yield consent,",
          "plainText": "That he consents if Warwick yield consent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "For on thy fortune I repose myself.",
          "plainText": "For on thy fortune I repose myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-010",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Why, then, though loath, yet I must be content.",
          "plainText": "Why then though loath yet I must be content",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "We'll yoke together, like a double shadow",
          "plainText": "We'll yoke together like a double shadow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "To Henry's body, and supply his place;",
          "plainText": "To Henry's body and supply his place",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "I mean, in bearing weight of government,",
          "plainText": "I mean in bearing weight of government",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0052",
          "number": 52,
          "speechLineNumber": 5,
          "text": "While he enjoys the honour and his ease.",
          "plainText": "While he enjoys the honour and his ease",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0053",
          "number": 53,
          "speechLineNumber": 6,
          "text": "And, Clarence, now then it is more than needful",
          "plainText": "And Clarence now then it is more than needful",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0054",
          "number": 54,
          "speechLineNumber": 7,
          "text": "Forthwith that Edward be pronounced a traitor",
          "plainText": "Forthwith that Edward be pronounced a traitor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0055",
          "number": 55,
          "speechLineNumber": 8,
          "text": "And all his lands and goods be confiscate.",
          "plainText": "And all his lands and goods be confiscate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-011",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "What else? And that succession be determined.",
          "plainText": "What else And that succession be determined",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-012",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Ay, therein Clarence shall not want his part.",
          "plainText": "Ay therein Clarence shall not want his part",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-013",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "But with the first of all your chief affairs",
          "plainText": "But with the first of all your chief affairs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "Let me entreat—for I command no more—",
          "plainText": "Let me entreatfor I command no more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "That Margaret your Queen and my son Edward",
          "plainText": "That Margaret your Queen and my son Edward",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0061",
          "number": 61,
          "speechLineNumber": 4,
          "text": "Be sent for to return from France with speed;",
          "plainText": "Be sent for to return from France with speed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0062",
          "number": 62,
          "speechLineNumber": 5,
          "text": "For till I see them here, by doubtful fear",
          "plainText": "For till I see them here by doubtful fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0063",
          "number": 63,
          "speechLineNumber": 6,
          "text": "My joy of liberty is half eclipsed.",
          "plainText": "My joy of liberty is half eclipsed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-014",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "It shall be done, my sovereign, with all speed.",
          "plainText": "It shall be done my sovereign with all speed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-015",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "My Lord of Somerset, what youth is that",
          "plainText": "My Lord of Somerset what youth is that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "Of whom you seem to have so tender care?",
          "plainText": "Of whom you seem to have so tender care",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-016",
      "type": "speech",
      "speaker": {
        "id": "somerset",
        "name": "SOMERSET",
        "displayName": "Somerset"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "My liege, it is young Henry, Earl of Richmond.",
          "plainText": "My liege it is young Henry Earl of Richmond",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-017",
      "type": "speech",
      "speaker": {
        "id": "king-henry",
        "name": "KING HENRY",
        "displayName": "King Henry"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Come hither, England's hope. If secret powers",
          "plainText": "Come hither England's hope If secret powers",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-stage-002",
      "type": "stage",
      "text": "[Lays his hand on his head.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-stage-003",
      "type": "stage",
      "text": "Enter a Post."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-018",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "What news, my friend?",
          "plainText": "What news my friend",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-019",
      "type": "speech",
      "speaker": {
        "id": "post",
        "name": "POST",
        "displayName": "Post"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "That Edward is escaped from your brother",
          "plainText": "That Edward is escaped from your brother",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "And fled, as he hears since, to Burgundy.",
          "plainText": "And fled as he hears since to Burgundy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-020",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Unsavoury news! But how made he escape?",
          "plainText": "Unsavoury news But how made he escape",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-021",
      "type": "speech",
      "speaker": {
        "id": "post",
        "name": "POST",
        "displayName": "Post"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "He was conveyed by Richard, Duke of Gloucester",
          "plainText": "He was conveyed by Richard Duke of Gloucester",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0074",
          "number": 74,
          "speechLineNumber": 2,
          "text": "And the Lord Hastings, who attended him",
          "plainText": "And the Lord Hastings who attended him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0075",
          "number": 75,
          "speechLineNumber": 3,
          "text": "In secret ambush on the forest side",
          "plainText": "In secret ambush on the forest side",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0076",
          "number": 76,
          "speechLineNumber": 4,
          "text": "And from the Bishop's huntsmen rescued him,",
          "plainText": "And from the Bishop's huntsmen rescued him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0077",
          "number": 77,
          "speechLineNumber": 5,
          "text": "For hunting was his daily exercise.",
          "plainText": "For hunting was his daily exercise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-022",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "My brother was too careless of his charge.",
          "plainText": "My brother was too careless of his charge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0079",
          "number": 79,
          "speechLineNumber": 2,
          "text": "But let us hence, my sovereign, to provide",
          "plainText": "But let us hence my sovereign to provide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0080",
          "number": 80,
          "speechLineNumber": 3,
          "text": "A salve for any sore that may betide.",
          "plainText": "A salve for any sore that may betide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-stage-004",
      "type": "stage",
      "text": "[Exeunt all but Somerset, Richmond and Oxford.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-023",
      "type": "speech",
      "speaker": {
        "id": "somerset",
        "name": "SOMERSET",
        "displayName": "Somerset"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "My lord, I like not of this flight of Edward's,",
          "plainText": "My lord I like not of this flight of Edward's",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0082",
          "number": 82,
          "speechLineNumber": 2,
          "text": "For doubtless Burgundy will yield him help,",
          "plainText": "For doubtless Burgundy will yield him help",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0083",
          "number": 83,
          "speechLineNumber": 3,
          "text": "And we shall have more wars before 't be long.",
          "plainText": "And we shall have more wars before 't be long",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0084",
          "number": 84,
          "speechLineNumber": 4,
          "text": "As Henry's late presaging prophecy",
          "plainText": "As Henry's late presaging prophecy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0085",
          "number": 85,
          "speechLineNumber": 5,
          "text": "Did glad my heart with hope of this young Richmond,",
          "plainText": "Did glad my heart with hope of this young Richmond",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0086",
          "number": 86,
          "speechLineNumber": 6,
          "text": "So doth my heart misgive me, in these conflicts",
          "plainText": "So doth my heart misgive me in these conflicts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0087",
          "number": 87,
          "speechLineNumber": 7,
          "text": "What may befall him, to his harm and ours.",
          "plainText": "What may befall him to his harm and ours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0088",
          "number": 88,
          "speechLineNumber": 8,
          "text": "Therefore, Lord Oxford, to prevent the worst,",
          "plainText": "Therefore Lord Oxford to prevent the worst",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0089",
          "number": 89,
          "speechLineNumber": 9,
          "text": "Forthwith we'll send him hence to Brittany",
          "plainText": "Forthwith we'll send him hence to Brittany",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0090",
          "number": 90,
          "speechLineNumber": 10,
          "text": "Till storms be past of civil enmity.",
          "plainText": "Till storms be past of civil enmity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-024",
      "type": "speech",
      "speaker": {
        "id": "oxford",
        "name": "OXFORD",
        "displayName": "Oxford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0091",
          "number": 91,
          "speechLineNumber": 1,
          "text": "Ay, for if Edward repossess the crown,",
          "plainText": "Ay for if Edward repossess the crown",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-6-line-0092",
          "number": 92,
          "speechLineNumber": 2,
          "text": "'Tis like that Richmond with the rest shall down.",
          "plainText": "'Tis like that Richmond with the rest shall down",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-6-speech-025",
      "type": "speech",
      "speaker": {
        "id": "somerset",
        "name": "SOMERSET",
        "displayName": "Somerset"
      },
