{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "the-third-part-of-king-henry-the-sixth",
    "title": "The Third Part of King Henry the Sixth",
    "author": "William Shakespeare",
    "genre": "History"
  },
  "source": {
