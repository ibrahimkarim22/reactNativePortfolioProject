  },
  "scene": {
    "id": "the-third-part-of-king-henry-the-sixth-4-7",
    "act": 4,
    "scene": 7,
    "label": "Act 4, Scene 7",
    "title": "SCENE VII. Before York",
    "location": "Before York",
    "orderInPlay": 20
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-stage-001",
      "type": "stage",
      "text": "Flourish. Enter King Edward, Richard (Duke of Gloucester), Hastings and Soldiers."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Now, brother Richard, Lord Hastings, and the rest,",
          "plainText": "Now brother Richard Lord Hastings and the rest",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Yet thus far Fortune maketh us amends,",
          "plainText": "Yet thus far Fortune maketh us amends",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And says that once more I shall interchange",
          "plainText": "And says that once more I shall interchange",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "My waned state for Henry's regal crown.",
          "plainText": "My waned state for Henry's regal crown",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Well have we passed and now repassed the seas,",
          "plainText": "Well have we passed and now repassed the seas",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "And brought desired help from Burgundy.",
          "plainText": "And brought desired help from Burgundy",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "What then remains, we being thus arrived",
          "plainText": "What then remains we being thus arrived",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "From Ravenspurgh haven before the gates of York,",
          "plainText": "From Ravenspurgh haven before the gates of York",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "But that we enter as into our dukedom?",
          "plainText": "But that we enter as into our dukedom",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "The gates made fast! Brother, I like not this;",
          "plainText": "The gates made fast Brother I like not this",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "For many men that stumble at the threshold",
          "plainText": "For many men that stumble at the threshold",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0012",
          "number": 12,
          "speechLineNumber": 3,
          "text": "Are well foretold that danger lurks within.",
          "plainText": "Are well foretold that danger lurks within",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Tush, man, abodements must not now affright us.",
          "plainText": "Tush man abodements must not now affright us",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "By fair or foul means we must enter in,",
          "plainText": "By fair or foul means we must enter in",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "For hither will our friends repair to us.",
          "plainText": "For hither will our friends repair to us",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-004",
      "type": "speech",
      "speaker": {
        "id": "hastings",
        "name": "HASTINGS",
        "displayName": "Hastings"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "My liege, I'll knock once more to summon them.",
          "plainText": "My liege I'll knock once more to summon them",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-stage-002",
      "type": "stage",
      "text": "Enter on the walls, the Mayor of York and his Brethren."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-005",
      "type": "speech",
      "speaker": {
        "id": "mayor",
        "name": "MAYOR",
        "displayName": "Mayor"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "My lords, we were forewarned of your coming",
          "plainText": "My lords we were forewarned of your coming",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "And shut the gates for safety of ourselves,",
          "plainText": "And shut the gates for safety of ourselves",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "For now we owe allegiance unto Henry.",
          "plainText": "For now we owe allegiance unto Henry",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-006",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "But, master Mayor, if Henry be your king,",
          "plainText": "But master Mayor if Henry be your king",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Yet Edward, at the least, is Duke of York.",
          "plainText": "Yet Edward at the least is Duke of York",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-007",
      "type": "speech",
      "speaker": {
        "id": "mayor",
        "name": "MAYOR",
        "displayName": "Mayor"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "True, my good lord, I know you for no less.",
          "plainText": "True my good lord I know you for no less",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-008",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Why, and I challenge nothing but my dukedom,",
          "plainText": "Why and I challenge nothing but my dukedom",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "As being well content with that alone.",
          "plainText": "As being well content with that alone",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-009",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "[Aside.] But when the fox hath once got in his nose,",
          "plainText": "Aside But when the fox hath once got in his nose",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "He'll soon find means to make the body follow.",
          "plainText": "He'll soon find means to make the body follow",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-010",
      "type": "speech",
      "speaker": {
        "id": "hastings",
        "name": "HASTINGS",
        "displayName": "Hastings"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Why, master Mayor, why stand you in a doubt?",
          "plainText": "Why master Mayor why stand you in a doubt",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Open the gates; we are King Henry's friends.",
          "plainText": "Open the gates we are King Henry's friends",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-011",
      "type": "speech",
      "speaker": {
        "id": "mayor",
        "name": "MAYOR",
        "displayName": "Mayor"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Ay, say you so? The gates shall then be opened.",
          "plainText": "Ay say you so The gates shall then be opened",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-stage-003",
      "type": "stage",
      "text": "[He descends.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-012",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "A wise, stout captain, and soon persuaded.",
          "plainText": "A wise stout captain and soon persuaded",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-013",
      "type": "speech",
      "speaker": {
        "id": "hastings",
        "name": "HASTINGS",
        "displayName": "Hastings"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "The good old man would fain that all were well,",
          "plainText": "The good old man would fain that all were well",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "So 'twere not long of him; but, being entered,",
          "plainText": "So 'twere not long of him but being entered",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "I doubt not, I, but we shall soon persuade",
          "plainText": "I doubt not I but we shall soon persuade",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "Both him and all his brothers unto reason.",
          "plainText": "Both him and all his brothers unto reason",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-stage-004",
      "type": "stage",
      "text": "Enter the Mayor and two Aldermen below."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-014",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "So, master Mayor, these gates must not be shut",
          "plainText": "So master Mayor these gates must not be shut",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "But in the night or in the time of war.",
          "plainText": "But in the night or in the time of war",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "What, fear not, man, but yield me up the keys;",
          "plainText": "What fear not man but yield me up the keys",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-stage-005",
      "type": "stage",
      "text": "[Takes his keys.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-stage-006",
      "type": "stage",
      "text": "March. Enter Montgomery with drum and Soldiers."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-015",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Brother, this is Sir John Montgomery,",
          "plainText": "Brother this is Sir John Montgomery",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "Our trusty friend unless I be deceived.",
          "plainText": "Our trusty friend unless I be deceived",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-016",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Welcome, Sir John! But why come you in arms?",
          "plainText": "Welcome Sir John But why come you in arms",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-017",
      "type": "speech",
      "speaker": {
        "id": "montgomery",
        "name": "MONTGOMERY",
        "displayName": "Montgomery"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "To help King Edward in his time of storm,",
          "plainText": "To help King Edward in his time of storm",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "As every loyal subject ought to do.",
          "plainText": "As every loyal subject ought to do",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-018",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Thanks, good Montgomery; but we now forget",
          "plainText": "Thanks good Montgomery but we now forget",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "Our title to the crown, and only claim",
          "plainText": "Our title to the crown and only claim",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Our dukedom till God please to send the rest.",
          "plainText": "Our dukedom till God please to send the rest",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-019",
      "type": "speech",
      "speaker": {
        "id": "montgomery",
        "name": "MONTGOMERY",
        "displayName": "Montgomery"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Then fare you well, for I will hence again.",
          "plainText": "Then fare you well for I will hence again",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "I came to serve a king, and not a duke.",
          "plainText": "I came to serve a king and not a duke",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "Drummer, strike up, and let us march away.",
          "plainText": "Drummer strike up and let us march away",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-stage-007",
      "type": "stage",
      "text": "[The drum begins to march.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-020",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Nay, stay, Sir John, a while, and we'll debate",
          "plainText": "Nay stay Sir John a while and we'll debate",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "By what safe means the crown may be recovered.",
          "plainText": "By what safe means the crown may be recovered",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-021",
      "type": "speech",
      "speaker": {
        "id": "montgomery",
        "name": "MONTGOMERY",
        "displayName": "Montgomery"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "What talk you of debating? In few words,",
          "plainText": "What talk you of debating In few words",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "If you'll not here proclaim yourself our king,",
          "plainText": "If you'll not here proclaim yourself our king",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "I'll leave you to your fortune and be gone",
          "plainText": "I'll leave you to your fortune and be gone",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "To keep them back that come to succour you.",
          "plainText": "To keep them back that come to succour you",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0055",
          "number": 55,
          "speechLineNumber": 5,
          "text": "Why shall we fight if you pretend no title?",
          "plainText": "Why shall we fight if you pretend no title",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-022",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Why, brother, wherefore stand you on nice points?",
          "plainText": "Why brother wherefore stand you on nice points",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-023",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "When we grow stronger, then we'll make our claim.",
          "plainText": "When we grow stronger then we'll make our claim",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "Till then 'tis wisdom to conceal our meaning.",
          "plainText": "Till then 'tis wisdom to conceal our meaning",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-024",
      "type": "speech",
      "speaker": {
        "id": "hastings",
        "name": "HASTINGS",
        "displayName": "Hastings"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Away with scrupulous wit! Now arms must rule.",
          "plainText": "Away with scrupulous wit Now arms must rule",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-025",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "And fearless minds climb soonest unto crowns.",
          "plainText": "And fearless minds climb soonest unto crowns",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0061",
          "number": 61,
          "speechLineNumber": 2,
          "text": "Brother, we will proclaim you out of hand;",
          "plainText": "Brother we will proclaim you out of hand",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0062",
          "number": 62,
          "speechLineNumber": 3,
          "text": "The bruit thereof will bring you many friends.",
          "plainText": "The bruit thereof will bring you many friends",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-026",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Then be it as you will; for 'tis my right,",
          "plainText": "Then be it as you will for 'tis my right",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "And Henry but usurps the diadem.",
          "plainText": "And Henry but usurps the diadem",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-027",
      "type": "speech",
      "speaker": {
        "id": "montgomery",
        "name": "MONTGOMERY",
        "displayName": "Montgomery"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Ay, now my sovereign speaketh like himself,",
          "plainText": "Ay now my sovereign speaketh like himself",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0066",
          "number": 66,
          "speechLineNumber": 2,
          "text": "And now will I be Edward's champion.",
          "plainText": "And now will I be Edward's champion",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-028",
      "type": "speech",
      "speaker": {
        "id": "hastings",
        "name": "HASTINGS",
        "displayName": "Hastings"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Sound, trumpet; Edward shall be here proclaimed.",
          "plainText": "Sound trumpet Edward shall be here proclaimed",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "Come, fellow soldier, make thou proclamation.",
          "plainText": "Come fellow soldier make thou proclamation",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-stage-008",
      "type": "stage",
      "text": "[Gives him a paper. Flourish.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-029",
      "type": "speech",
      "speaker": {
        "id": "soldier",
        "name": "SOLDIER",
        "displayName": "Soldier"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "[Reads.] Edward the Fourth, by the Grace of God, King of England and France, and Lord of Ireland, etc.",
          "plainText": "Reads Edward the Fourth by the Grace of God King of England and France and Lord of Ireland etc",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-030",
      "type": "speech",
      "speaker": {
        "id": "montgomery",
        "name": "MONTGOMERY",
        "displayName": "Montgomery"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "And whoso'er gainsays King Edward's right,",
          "plainText": "And whoso'er gainsays King Edward's right",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "By this I challenge him to single fight.",
          "plainText": "By this I challenge him to single fight",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-stage-009",
      "type": "stage",
      "text": "[Throws down his gauntlet.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-031",
      "type": "speech",
      "speaker": {
        "id": "all",
        "name": "ALL",
        "displayName": "All"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Long live Edward the Fourth!",
          "plainText": "Long live Edward the Fourth",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-speech-032",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Thanks, brave Montgomery, and thanks unto you all.",
          "plainText": "Thanks brave Montgomery and thanks unto you all",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0074",
          "number": 74,
          "speechLineNumber": 2,
          "text": "If Fortune serve me, I'll requite this kindness.",
          "plainText": "If Fortune serve me I'll requite this kindness",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0075",
          "number": 75,
          "speechLineNumber": 3,
          "text": "Now for this night let's harbour here in York,",
          "plainText": "Now for this night let's harbour here in York",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0076",
          "number": 76,
          "speechLineNumber": 4,
          "text": "And when the morning sun shall raise his car",
          "plainText": "And when the morning sun shall raise his car",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0077",
          "number": 77,
          "speechLineNumber": 5,
          "text": "Above the border of this horizon",
          "plainText": "Above the border of this horizon",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0078",
          "number": 78,
          "speechLineNumber": 6,
          "text": "We'll forward towards Warwick and his mates;",
          "plainText": "We'll forward towards Warwick and his mates",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0079",
          "number": 79,
          "speechLineNumber": 7,
          "text": "For well I wot that Henry is no soldier.",
          "plainText": "For well I wot that Henry is no soldier",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0080",
          "number": 80,
          "speechLineNumber": 8,
          "text": "Ah, froward Clarence, how evil it beseems thee",
          "plainText": "Ah froward Clarence how evil it beseems thee",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0081",
          "number": 81,
          "speechLineNumber": 9,
          "text": "To flatter Henry and forsake thy brother!",
          "plainText": "To flatter Henry and forsake thy brother",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0082",
          "number": 82,
          "speechLineNumber": 10,
          "text": "Yet, as we may, we'll meet both thee and Warwick.",
          "plainText": "Yet as we may we'll meet both thee and Warwick",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0083",
          "number": 83,
          "speechLineNumber": 11,
          "text": "Come on, brave soldiers; doubt not of the day,",
          "plainText": "Come on brave soldiers doubt not of the day",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-4-7-line-0084",
          "number": 84,
          "speechLineNumber": 12,
          "text": "And, that once gotten, doubt not of large pay.",
          "plainText": "And that once gotten doubt not of large pay",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-4-7-stage-010",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}