  "scene": {
    "id": "the-third-part-of-king-henry-the-sixth-5-1",
    "act": 5,
    "scene": 1,
    "label": "Act 5, Scene 1",
    "title": "SCENE I. Coventry",
    "location": "Coventry",
    "orderInPlay": 22
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-001",
      "type": "stage",
      "text": "Enter, Warwick, the Mayor of Coventry, two Messengers and others, upon the walls."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Where is the post that came from valiant Oxford?",
          "plainText": "Where is the post that came from valiant Oxford",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "How far hence is thy lord, mine honest fellow?",
          "plainText": "How far hence is thy lord mine honest fellow",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "How far off is our brother Montague?",
          "plainText": "How far off is our brother Montague",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Where is the post that came from Montague?",
          "plainText": "Where is the post that came from Montague",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-002",
      "type": "stage",
      "text": "Enter Sir John Somerville."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Say, Somerville, what says my loving son?",
          "plainText": "Say Somerville what says my loving son",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "And, by thy guess, how nigh is Clarence now?",
          "plainText": "And by thy guess how nigh is Clarence now",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "somerville",
        "name": "SOMERVILLE",
        "displayName": "Somerville"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "At Southam I did leave him with his forces",
          "plainText": "At Southam I did leave him with his forces",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "And do expect him here some two hours hence.",
          "plainText": "And do expect him here some two hours hence",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-003",
      "type": "stage",
      "text": "[Drum heard.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Then Clarence is at hand; I hear his drum.",
          "plainText": "Then Clarence is at hand I hear his drum",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "somerville",
        "name": "SOMERVILLE",
        "displayName": "Somerville"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "It is not his, my lord; here Southam lies.",
          "plainText": "It is not his my lord here Southam lies",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "The drum your honour hears marcheth from Warwick.",
          "plainText": "The drum your honour hears marcheth from Warwick",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Who should that be? Belike, unlooked-for friends.",
          "plainText": "Who should that be Belike unlookedfor friends",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "somerville",
        "name": "SOMERVILLE",
        "displayName": "Somerville"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "They are at hand, and you shall quickly know.",
          "plainText": "They are at hand and you shall quickly know",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-004",
      "type": "stage",
      "text": "March. Flourish. Enter King Edward, Richard (Duke of Gloucester) and Soldiers."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Go, trumpet, to the walls and sound a parle.",
          "plainText": "Go trumpet to the walls and sound a parle",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "See how the surly Warwick mans the wall.",
          "plainText": "See how the surly Warwick mans the wall",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "O, unbid spite! Is sportful Edward come?",
          "plainText": "O unbid spite Is sportful Edward come",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Where slept our scouts, or how are they seduced,",
          "plainText": "Where slept our scouts or how are they seduced",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "That we could hear no news of his repair?",
          "plainText": "That we could hear no news of his repair",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Now, Warwick, wilt thou ope the city gates,",
          "plainText": "Now Warwick wilt thou ope the city gates",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Speak gentle words and humbly bend thy knee?",
          "plainText": "Speak gentle words and humbly bend thy knee",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "Call Edward King and at his hands beg mercy,",
          "plainText": "Call Edward King and at his hands beg mercy",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0022",
          "number": 22,
          "speechLineNumber": 4,
          "text": "And he shall pardon thee these outrages.",
          "plainText": "And he shall pardon thee these outrages",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Nay, rather, wilt thou draw thy forces hence,",
          "plainText": "Nay rather wilt thou draw thy forces hence",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "Confess who set thee up and plucked thee down,",
          "plainText": "Confess who set thee up and plucked thee down",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0025",
          "number": 25,
          "speechLineNumber": 3,
          "text": "Call Warwick patron and be penitent,",
          "plainText": "Call Warwick patron and be penitent",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0026",
          "number": 26,
          "speechLineNumber": 4,
          "text": "And thou shalt still remain the Duke of York.",
          "plainText": "And thou shalt still remain the Duke of York",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "I thought, at least, he would have said the King;",
          "plainText": "I thought at least he would have said the King",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0028",
          "number": 28,
          "speechLineNumber": 2,
          "text": "Or did he make the jest against his will?",
          "plainText": "Or did he make the jest against his will",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Is not a dukedom, sir, a goodly gift?",
          "plainText": "Is not a dukedom sir a goodly gift",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Ay, by my faith, for a poor earl to give;",
          "plainText": "Ay by my faith for a poor earl to give",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "I'll do thee service for so good a gift.",
          "plainText": "I'll do thee service for so good a gift",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "'Twas I that gave the kingdom to thy brother.",
          "plainText": "'Twas I that gave the kingdom to thy brother",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Why, then, 'tis mine, if but by Warwick's gift.",
          "plainText": "Why then 'tis mine if but by Warwick's gift",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Thou art no Atlas for so great a weight;",
          "plainText": "Thou art no Atlas for so great a weight",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "And, weakling, Warwick takes his gift again;",
          "plainText": "And weakling Warwick takes his gift again",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "And Henry is my King, Warwick his subject.",
          "plainText": "And Henry is my King Warwick his subject",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "But Warwick's king is Edward's prisoner;",
          "plainText": "But Warwick's king is Edward's prisoner",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "And, gallant Warwick, do but answer this:",
          "plainText": "And gallant Warwick do but answer this",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "What is the body when the head is off?",
          "plainText": "What is the body when the head is off",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Alas, that Warwick had no more forecast,",
          "plainText": "Alas that Warwick had no more forecast",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "But, whiles he thought to steal the single ten,",
          "plainText": "But whiles he thought to steal the single ten",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "The king was slily fingered from the deck!",
          "plainText": "The king was slily fingered from the deck",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "You left poor Henry at the Bishop's palace,",
          "plainText": "You left poor Henry at the Bishop's palace",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0044",
          "number": 44,
          "speechLineNumber": 5,
          "text": "And ten to one you'll meet him in the Tower.",
          "plainText": "And ten to one you'll meet him in the Tower",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "'Tis even so; yet you are Warwick still.",
          "plainText": "'Tis even so yet you are Warwick still",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Come, Warwick, take the time; kneel down, kneel down.",
          "plainText": "Come Warwick take the time kneel down kneel down",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Nay, when? Strike now, or else the iron cools.",
          "plainText": "Nay when Strike now or else the iron cools",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "I had rather chop this hand off at a blow",
          "plainText": "I had rather chop this hand off at a blow",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "And with the other fling it at thy face,",
          "plainText": "And with the other fling it at thy face",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "Than bear so low a sail to strike to thee.",
          "plainText": "Than bear so low a sail to strike to thee",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Sail how thou canst, have wind and tide thy friend,",
          "plainText": "Sail how thou canst have wind and tide thy friend",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "This hand, fast wound about thy coal-black hair,",
          "plainText": "This hand fast wound about thy coalblack hair",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "Shall, whiles thy head is warm and new cut off,",
          "plainText": "Shall whiles thy head is warm and new cut off",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "Write in the dust this sentence with thy blood:",
          "plainText": "Write in the dust this sentence with thy blood",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0055",
          "number": 55,
          "speechLineNumber": 5,
          "text": "\"Wind-changing Warwick now can change no more.\"",
          "plainText": "Windchanging Warwick now can change no more",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-005",
      "type": "stage",
      "text": "Enter Oxford with drum and colours."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "O cheerful colours! See where Oxford comes!",
          "plainText": "O cheerful colours See where Oxford comes",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "oxford",
        "name": "OXFORD",
        "displayName": "Oxford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Oxford, Oxford, for Lancaster!",
          "plainText": "Oxford Oxford for Lancaster",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-006",
      "type": "stage",
      "text": "[He and his forces enter the city.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "The gates are open; let us enter too.",
          "plainText": "The gates are open let us enter too",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "So other foes may set upon our backs.",
          "plainText": "So other foes may set upon our backs",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "Stand we in good array, for they no doubt",
          "plainText": "Stand we in good array for they no doubt",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "Will issue out again and bid us battle;",
          "plainText": "Will issue out again and bid us battle",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0062",
          "number": 62,
          "speechLineNumber": 4,
          "text": "If not, the city being but of small defence,",
          "plainText": "If not the city being but of small defence",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0063",
          "number": 63,
          "speechLineNumber": 5,
          "text": "We'll quietly rouse the traitors in the same.",
          "plainText": "We'll quietly rouse the traitors in the same",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "O, welcome, Oxford, for we want thy help.",
          "plainText": "O welcome Oxford for we want thy help",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-007",
      "type": "stage",
      "text": "Enter Montague with drum and colours."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-031",
      "type": "speech",
      "speaker": {
        "id": "montague",
        "name": "MONTAGUE",
        "displayName": "Montague"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Montague, Montague, for Lancaster!",
          "plainText": "Montague Montague for Lancaster",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-008",
      "type": "stage",
      "text": "[He and his forces enter the city.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-032",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Thou and thy brother both shall buy this treason",
          "plainText": "Thou and thy brother both shall buy this treason",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0067",
          "number": 67,
          "speechLineNumber": 2,
          "text": "Even with the dearest blood your bodies bear.",
          "plainText": "Even with the dearest blood your bodies bear",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-033",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "The harder matched, the greater victory.",
          "plainText": "The harder matched the greater victory",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "My mind presageth happy gain and conquest.",
          "plainText": "My mind presageth happy gain and conquest",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-009",
      "type": "stage",
      "text": "Enter Somerset with drum and colours."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-034",
      "type": "speech",
      "speaker": {
        "id": "somerset",
        "name": "SOMERSET",
        "displayName": "Somerset"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Somerset, Somerset, for Lancaster!",
          "plainText": "Somerset Somerset for Lancaster",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-010",
      "type": "stage",
      "text": "[He and his forces enter the city.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-035",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Two of thy name, both Dukes of Somerset,",
          "plainText": "Two of thy name both Dukes of Somerset",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "Have sold their lives unto the House of York;",
          "plainText": "Have sold their lives unto the House of York",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0073",
          "number": 73,
          "speechLineNumber": 3,
          "text": "And thou shalt be the third if this sword hold.",
          "plainText": "And thou shalt be the third if this sword hold",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-011",
      "type": "stage",
      "text": "Enter George (Duke of Clarence) with drum and colours."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-036",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "And lo, where George of Clarence sweeps along,",
          "plainText": "And lo where George of Clarence sweeps along",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "Of force enough to bid his brother battle;",
          "plainText": "Of force enough to bid his brother battle",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "With whom an upright zeal to right prevails",
          "plainText": "With whom an upright zeal to right prevails",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0077",
          "number": 77,
          "speechLineNumber": 4,
          "text": "More than the nature of a brother's love.",
          "plainText": "More than the nature of a brother's love",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-012",
      "type": "stage",
      "text": "[Richard and George whisper.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-037",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "Father of Warwick, know you what this means?",
          "plainText": "Father of Warwick know you what this means",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-013",
      "type": "stage",
      "text": "[Taking the red rose from his hat and throws the rose at Warwick.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-038",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Now, welcome more, and ten times more beloved,",
          "plainText": "Now welcome more and ten times more beloved",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0080",
          "number": 80,
          "speechLineNumber": 2,
          "text": "Than if thou never hadst deserved our hate.",
          "plainText": "Than if thou never hadst deserved our hate",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-039",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "Welcome, good Clarence; this is brother-like.",
          "plainText": "Welcome good Clarence this is brotherlike",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-040",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "O passing traitor, perjured and unjust!",
          "plainText": "O passing traitor perjured and unjust",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-041",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "What, Warwick, wilt thou leave the town and fight?",
          "plainText": "What Warwick wilt thou leave the town and fight",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0084",
          "number": 84,
          "speechLineNumber": 2,
          "text": "Or shall we beat the stones about thine ears?",
          "plainText": "Or shall we beat the stones about thine ears",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-042",
      "type": "speech",
      "speaker": {
        "id": "warwick",
        "name": "WARWICK",
        "displayName": "Warwick"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0085",
          "number": 85,
          "speechLineNumber": 1,
          "text": "Alas! I am not cooped here for defence!",
          "plainText": "Alas I am not cooped here for defence",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0086",
          "number": 86,
          "speechLineNumber": 2,
          "text": "I will away towards Barnet presently",
          "plainText": "I will away towards Barnet presently",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0087",
          "number": 87,
          "speechLineNumber": 3,
          "text": "And bid thee battle, Edward, if thou dar'st.",
          "plainText": "And bid thee battle Edward if thou dar'st",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-speech-043",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0088",
          "number": 88,
          "speechLineNumber": 1,
          "text": "Yes, Warwick, Edward dares, and leads the way.",
          "plainText": "Yes Warwick Edward dares and leads the way",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-1-line-0089",
          "number": 89,
          "speechLineNumber": 2,
          "text": "Lords, to the field! Saint George and victory!",
          "plainText": "Lords to the field Saint George and victory",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-1-stage-014",
      "type": "stage",
      "text": "[Exeunt. March. Warwick and his company follows.]"
    }
  ]
}