  "scene": {
    "id": "the-third-part-of-king-henry-the-sixth-5-5",
    "act": 5,
    "scene": 5,
    "label": "Act 5, Scene 5",
    "title": "SCENE V. Another part of the Field",
    "location": "Another part of the Field",
    "orderInPlay": 26
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-stage-001",
      "type": "stage",
      "text": "Flourish. Enter King Edward, Richard, George and Soldiers; with Queen Margaret, Oxford and Somerset as prisoners."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Now here a period of tumultuous broils.",
          "plainText": "Now here a period of tumultuous broils",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Away with Oxford to Hames Castle straight.",
          "plainText": "Away with Oxford to Hames Castle straight",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "For Somerset, off with his guilty head.",
          "plainText": "For Somerset off with his guilty head",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Go, bear them hence; I will not hear them speak.",
          "plainText": "Go bear them hence I will not hear them speak",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "oxford",
        "name": "OXFORD",
        "displayName": "Oxford"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "For my part, I'll not trouble thee with words.",
          "plainText": "For my part I'll not trouble thee with words",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "somerset",
        "name": "SOMERSET",
        "displayName": "Somerset"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Nor I, but stoop with patience to my fortune.",
          "plainText": "Nor I but stoop with patience to my fortune",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-stage-002",
      "type": "stage",
      "text": "[Exeunt Oxford and Somerset, guarded.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "So part we sadly in this troublous world,",
          "plainText": "So part we sadly in this troublous world",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "To meet with joy in sweet Jerusalem.",
          "plainText": "To meet with joy in sweet Jerusalem",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Is proclamation made that who finds Edward",
          "plainText": "Is proclamation made that who finds Edward",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Shall have a high reward, and he his life?",
          "plainText": "Shall have a high reward and he his life",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "It is, and lo where youthful Edward comes.",
          "plainText": "It is and lo where youthful Edward comes",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-stage-003",
      "type": "stage",
      "text": "Enter soldiers with Prince Edward."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Bring forth the gallant; let us hear him speak.",
          "plainText": "Bring forth the gallant let us hear him speak",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "What, can so young a man begin to prick?",
          "plainText": "What can so young a man begin to prick",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Edward, what satisfaction canst thou make",
          "plainText": "Edward what satisfaction canst thou make",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "For bearing arms, for stirring up my subjects,",
          "plainText": "For bearing arms for stirring up my subjects",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "And all the trouble thou hast turned me to?",
          "plainText": "And all the trouble thou hast turned me to",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "prince-edward",
        "name": "PRINCE EDWARD",
        "displayName": "Prince Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Speak like a subject, proud, ambitious York.",
          "plainText": "Speak like a subject proud ambitious York",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Suppose that I am now my father's mouth;",
          "plainText": "Suppose that I am now my father's mouth",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0019",
          "number": 19,
          "speechLineNumber": 3,
          "text": "Resign thy chair, and where I stand kneel thou,",
          "plainText": "Resign thy chair and where I stand kneel thou",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0020",
          "number": 20,
          "speechLineNumber": 4,
          "text": "Whilst I propose the selfsame words to thee",
          "plainText": "Whilst I propose the selfsame words to thee",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0021",
          "number": 21,
          "speechLineNumber": 5,
          "text": "Which, traitor, thou wouldst have me answer to.",
          "plainText": "Which traitor thou wouldst have me answer to",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Ah, thy father had been so resolved!",
          "plainText": "Ah thy father had been so resolved",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "That you might still have worn the petticoat",
          "plainText": "That you might still have worn the petticoat",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "And ne'er have stol'n the breech from Lancaster.",
          "plainText": "And ne'er have stol'n the breech from Lancaster",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "prince-edward",
        "name": "PRINCE EDWARD",
        "displayName": "Prince Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Let Aesop fable in a winter's night;",
          "plainText": "Let Aesop fable in a winter's night",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "His currish riddle sorts not with this place.",
          "plainText": "His currish riddle sorts not with this place",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "By heaven, brat, I'll plague you for that word.",
          "plainText": "By heaven brat I'll plague you for that word",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Ay, thou wast born to be a plague to men.",
          "plainText": "Ay thou wast born to be a plague to men",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "For God's sake, take away this captive scold.",
          "plainText": "For God's sake take away this captive scold",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "prince-edward",
        "name": "PRINCE EDWARD",
        "displayName": "Prince Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Nay, take away this scolding crookback rather.",
          "plainText": "Nay take away this scolding crookback rather",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Peace, wilful boy, or I will charm your tongue.",
          "plainText": "Peace wilful boy or I will charm your tongue",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Untutored lad, thou art too malapert.",
          "plainText": "Untutored lad thou art too malapert",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "prince-edward",
        "name": "PRINCE EDWARD",
        "displayName": "Prince Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "I know my duty; you are all undutiful.",
          "plainText": "I know my duty you are all undutiful",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Lascivious Edward, and thou perjured George,",
          "plainText": "Lascivious Edward and thou perjured George",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "And thou misshapen Dick, I tell ye all",
          "plainText": "And thou misshapen Dick I tell ye all",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0036",
          "number": 36,
          "speechLineNumber": 4,
          "text": "I am your better, traitors as ye are,",
          "plainText": "I am your better traitors as ye are",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0037",
          "number": 37,
          "speechLineNumber": 5,
          "text": "And thou usurp'st my father's right and mine.",
          "plainText": "And thou usurp'st my father's right and mine",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Take that, the likeness of this railer here.",
          "plainText": "Take that the likeness of this railer here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-stage-004",
      "type": "stage",
      "text": "[Stabs him.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Sprawl'st thou? Take that to end thy agony.",
          "plainText": "Sprawl'st thou Take that to end thy agony",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-stage-005",
      "type": "stage",
      "text": "[Stabs him.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "And there's for twitting me with perjury.",
          "plainText": "And there's for twitting me with perjury",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-stage-006",
      "type": "stage",
      "text": "[Stabs him.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "O, kill me too!",
          "plainText": "O kill me too",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Marry, and shall.",
          "plainText": "Marry and shall",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-stage-007",
      "type": "stage",
      "text": "[Offers to kill her.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Hold, Richard, hold; for we have done too much.",
          "plainText": "Hold Richard hold for we have done too much",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Why should she live to fill the world with words?",
          "plainText": "Why should she live to fill the world with words",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "What, doth she swoon? Use means for her recovery.",
          "plainText": "What doth she swoon Use means for her recovery",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-027",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Clarence, excuse me to the King my brother.",
          "plainText": "Clarence excuse me to the King my brother",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "I'll hence to London on a serious matter.",
          "plainText": "I'll hence to London on a serious matter",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "Ere ye come there, be sure to hear some news.",
          "plainText": "Ere ye come there be sure to hear some news",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-028",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "What? What?",
          "plainText": "What What",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-029",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "The Tower, the Tower!",
          "plainText": "The Tower the Tower",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-stage-008",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-030",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "O Ned, sweet Ned, speak to thy mother, boy.",
          "plainText": "O Ned sweet Ned speak to thy mother boy",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "Canst thou not speak? O traitors, murderers!",
          "plainText": "Canst thou not speak O traitors murderers",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "They that stabbed Caesar shed no blood at all,",
          "plainText": "They that stabbed Caesar shed no blood at all",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "Did not offend, nor were not worthy blame,",
          "plainText": "Did not offend nor were not worthy blame",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0055",
          "number": 55,
          "speechLineNumber": 5,
          "text": "If this foul deed were by to equal it.",
          "plainText": "If this foul deed were by to equal it",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0056",
          "number": 56,
          "speechLineNumber": 6,
          "text": "He was a man; this, in respect, a child,",
          "plainText": "He was a man this in respect a child",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0057",
          "number": 57,
          "speechLineNumber": 7,
          "text": "And men ne'er spend their fury on a child.",
          "plainText": "And men ne'er spend their fury on a child",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0058",
          "number": 58,
          "speechLineNumber": 8,
          "text": "What's worse than murderer, that I may name it?",
          "plainText": "What's worse than murderer that I may name it",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0059",
          "number": 59,
          "speechLineNumber": 9,
          "text": "No, no, my heart will burst an if I speak;",
          "plainText": "No no my heart will burst an if I speak",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0060",
          "number": 60,
          "speechLineNumber": 10,
          "text": "And I will speak, that so my heart may burst.",
          "plainText": "And I will speak that so my heart may burst",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0061",
          "number": 61,
          "speechLineNumber": 11,
          "text": "Butchers and villains, bloody cannibals!",
          "plainText": "Butchers and villains bloody cannibals",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0062",
          "number": 62,
          "speechLineNumber": 12,
          "text": "How sweet a plant have you untimely cropped!",
          "plainText": "How sweet a plant have you untimely cropped",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0063",
          "number": 63,
          "speechLineNumber": 13,
          "text": "You have no children, butchers; if you had,",
          "plainText": "You have no children butchers if you had",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0064",
          "number": 64,
          "speechLineNumber": 14,
          "text": "The thought of them would have stirred up remorse.",
          "plainText": "The thought of them would have stirred up remorse",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0065",
          "number": 65,
          "speechLineNumber": 15,
          "text": "But if you ever chance to have a child,",
          "plainText": "But if you ever chance to have a child",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0066",
          "number": 66,
          "speechLineNumber": 16,
          "text": "Look in his youth to have him so cut off",
          "plainText": "Look in his youth to have him so cut off",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0067",
          "number": 67,
          "speechLineNumber": 17,
          "text": "As, deathsmen, you have rid this sweet young prince!",
          "plainText": "As deathsmen you have rid this sweet young prince",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-031",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Away with her; go bear her hence perforce.",
          "plainText": "Away with her go bear her hence perforce",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-032",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Nay, never bear me hence, dispatch me here.",
          "plainText": "Nay never bear me hence dispatch me here",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "Here sheathe thy sword; I'll pardon thee my death.",
          "plainText": "Here sheathe thy sword I'll pardon thee my death",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0071",
          "number": 71,
          "speechLineNumber": 3,
          "text": "What, wilt thou not? Then, Clarence, do it thou.",
          "plainText": "What wilt thou not Then Clarence do it thou",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-033",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "By heaven, I will not do thee so much ease.",
          "plainText": "By heaven I will not do thee so much ease",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-034",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Good Clarence, do; sweet Clarence, do thou do it.",
          "plainText": "Good Clarence do sweet Clarence do thou do it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-035",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Didst thou not hear me swear I would not do it?",
          "plainText": "Didst thou not hear me swear I would not do it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-036",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Ay, but thou usest to forswear thyself.",
          "plainText": "Ay but thou usest to forswear thyself",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "'Twas sin before, but now 'tis charity.",
          "plainText": "'Twas sin before but now 'tis charity",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0077",
          "number": 77,
          "speechLineNumber": 3,
          "text": "What, wilt thou not? Where is that devil's butcher, Richard,",
          "plainText": "What wilt thou not Where is that devil's butcher Richard",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0078",
          "number": 78,
          "speechLineNumber": 4,
          "text": "Hard-favoured Richard? Richard, where art thou?",
          "plainText": "Hardfavoured Richard Richard where art thou",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0079",
          "number": 79,
          "speechLineNumber": 5,
          "text": "Thou art not here. Murder is thy alms-deed;",
          "plainText": "Thou art not here Murder is thy almsdeed",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0080",
          "number": 80,
          "speechLineNumber": 6,
          "text": "Petitioners for blood thou ne'er putt'st back.",
          "plainText": "Petitioners for blood thou ne'er putt'st back",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-037",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "Away, I say! I charge ye, bear her hence.",
          "plainText": "Away I say I charge ye bear her hence",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-038",
      "type": "speech",
      "speaker": {
        "id": "queen-margaret",
        "name": "QUEEN MARGARET",
        "displayName": "Queen Margaret"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "So come to you and yours as to this prince!",
          "plainText": "So come to you and yours as to this prince",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-stage-009",
      "type": "stage",
      "text": "[She is taken out.]"
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-039",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "Where's Richard gone?",
          "plainText": "Where's Richard gone",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-040",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "To London all in post, and, as I guess,",
          "plainText": "To London all in post and as I guess",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0085",
          "number": 85,
          "speechLineNumber": 2,
          "text": "To make a bloody supper in the Tower.",
          "plainText": "To make a bloody supper in the Tower",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-speech-041",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "He's sudden if a thing comes in his head.",
          "plainText": "He's sudden if a thing comes in his head",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0087",
          "number": 87,
          "speechLineNumber": 2,
          "text": "Now march we hence. Discharge the common sort",
          "plainText": "Now march we hence Discharge the common sort",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0088",
          "number": 88,
          "speechLineNumber": 3,
          "text": "With pay and thanks, and let's away to London",
          "plainText": "With pay and thanks and let's away to London",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0089",
          "number": 89,
          "speechLineNumber": 4,
          "text": "And see our gentle Queen how well she fares.",
          "plainText": "And see our gentle Queen how well she fares",
          "lineType": "verse"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-5-line-0090",
          "number": 90,
          "speechLineNumber": 5,
          "text": "By this, I hope, she hath a son for me.",
          "plainText": "By this I hope she hath a son for me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-5-stage-010",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}