  "scene": {
    "id": "the-third-part-of-king-henry-the-sixth-5-7",
    "act": 5,
    "scene": 7,
    "label": "Act 5, Scene 7",
    "title": "SCENE VII. London. The Palace",
    "location": "London. The Palace",
    "orderInPlay": 28
  },
  "content": [
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-stage-001",
      "type": "stage",
      "text": "Flourish. Enter King Edward, Queen Elizabeth, George, Richard, Hastings, Nurse, carrying infant Prince Edward, and Attendants."
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Once more we sit in England's royal throne,",
          "plainText": "Once more we sit in England's royal throne",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Repurchased with the blood of enemies.",
          "plainText": "Repurchased with the blood of enemies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "What valiant foemen, like to autumn's corn,",
          "plainText": "What valiant foemen like to autumn's corn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Have we mowed down in tops of all their pride!",
          "plainText": "Have we mowed down in tops of all their pride",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Three Dukes of Somerset, threefold renowned",
          "plainText": "Three Dukes of Somerset threefold renowned",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "For hardy and undoubted champions;",
          "plainText": "For hardy and undoubted champions",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Two Cliffords, as the father and the son;",
          "plainText": "Two Cliffords as the father and the son",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "And two Northumberlands; two braver men",
          "plainText": "And two Northumberlands two braver men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Ne'er spurred their coursers at the trumpet's sound;",
          "plainText": "Ne'er spurred their coursers at the trumpet's sound",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "With them the two brave bears, Warwick and Montague,",
          "plainText": "With them the two brave bears Warwick and Montague",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "That in their chains fettered the kingly lion",
          "plainText": "That in their chains fettered the kingly lion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "And made the forest tremble when they roared.",
          "plainText": "And made the forest tremble when they roared",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "Thus have we swept suspicion from our seat",
          "plainText": "Thus have we swept suspicion from our seat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "And made our footstool of security.",
          "plainText": "And made our footstool of security",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "Come hither, Bess, and let me kiss my boy.",
          "plainText": "Come hither Bess and let me kiss my boy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "Young Ned, for thee thine uncles and myself",
          "plainText": "Young Ned for thee thine uncles and myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "Have in our armours watched the winter's night,",
          "plainText": "Have in our armours watched the winter's night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Went all afoot in summer's scalding heat,",
          "plainText": "Went all afoot in summer's scalding heat",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "That thou mightst repossess the crown in peace;",
          "plainText": "That thou mightst repossess the crown in peace",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "And of our labours thou shalt reap the gain.",
          "plainText": "And of our labours thou shalt reap the gain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "[Aside.] I'll blast his harvest, if your head were laid;",
          "plainText": "Aside I'll blast his harvest if your head were laid",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "For yet I am not looked on in the world.",
          "plainText": "For yet I am not looked on in the world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "This shoulder was ordained so thick to heave,",
          "plainText": "This shoulder was ordained so thick to heave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0024",
          "number": 24,
          "speechLineNumber": 4,
          "text": "And heave it shall some weight or break my back.",
          "plainText": "And heave it shall some weight or break my back",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0025",
          "number": 25,
          "speechLineNumber": 5,
          "text": "Work thou the way, and that shall execute.",
          "plainText": "Work thou the way and that shall execute",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Clarence and Gloucester, love my lovely Queen;",
          "plainText": "Clarence and Gloucester love my lovely Queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "And kiss your princely nephew, brothers both.",
          "plainText": "And kiss your princely nephew brothers both",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-speech-004",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "The duty that I owe unto your Majesty",
          "plainText": "The duty that I owe unto your Majesty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "I seal upon the lips of this sweet babe.",
          "plainText": "I seal upon the lips of this sweet babe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-speech-005",
      "type": "speech",
      "speaker": {
        "id": "queen-elizabeth",
        "name": "QUEEN ELIZABETH",
        "displayName": "Queen Elizabeth"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Thanks, noble Clarence; worthy brother, thanks.",
          "plainText": "Thanks noble Clarence worthy brother thanks",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-speech-006",
      "type": "speech",
      "speaker": {
        "id": "richard",
        "name": "RICHARD",
        "displayName": "Richard"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "And, that I love the tree from whence thou sprang'st,",
          "plainText": "And that I love the tree from whence thou sprang'st",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Witness the loving kiss I give the fruit.",
          "plainText": "Witness the loving kiss I give the fruit",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "[Aside.] To say the truth, so Judas kissed his master",
          "plainText": "Aside To say the truth so Judas kissed his master",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "And cried \"All hail!\" when as he meant all harm.",
          "plainText": "And cried All hail when as he meant all harm",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-speech-007",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Now am I seated as my soul delights,",
          "plainText": "Now am I seated as my soul delights",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "Having my country's peace and brothers' loves.",
          "plainText": "Having my country's peace and brothers' loves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-speech-008",
      "type": "speech",
      "speaker": {
        "id": "george",
        "name": "GEORGE",
        "displayName": "George"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "What will your Grace have done with Margaret?",
          "plainText": "What will your Grace have done with Margaret",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "Reignier, her father, to the King of France",
          "plainText": "Reignier her father to the King of France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "Hath pawned the Sicils and Jerusalem,",
          "plainText": "Hath pawned the Sicils and Jerusalem",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "And hither have they sent it for her ransom.",
          "plainText": "And hither have they sent it for her ransom",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-speech-009",
      "type": "speech",
      "speaker": {
        "id": "king-edward",
        "name": "KING EDWARD",
        "displayName": "King Edward"
      },
      "lines": [
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Away with her and waft her hence to France.",
          "plainText": "Away with her and waft her hence to France",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "And now what rests but that we spend the time",
          "plainText": "And now what rests but that we spend the time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "With stately triumphs, mirthful comic shows,",
          "plainText": "With stately triumphs mirthful comic shows",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "Such as befits the pleasure of the court?",
          "plainText": "Such as befits the pleasure of the court",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "Sound drums and trumpets! Farewell, sour annoy!",
          "plainText": "Sound drums and trumpets Farewell sour annoy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-third-part-of-king-henry-the-sixth-5-7-line-0046",
          "number": 46,
          "speechLineNumber": 6,
          "text": "For here, I hope, begins our lasting joy.",
          "plainText": "For here I hope begins our lasting joy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-third-part-of-king-henry-the-sixth-5-7-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}