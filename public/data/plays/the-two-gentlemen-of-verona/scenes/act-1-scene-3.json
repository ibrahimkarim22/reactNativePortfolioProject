  "content": [
    {
      "id": "the-two-gentlemen-of-verona-1-3-stage-001",
      "type": "stage",
      "text": "Enter Antonio and Pantino."
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Tell me, Pantino, what sad talk was that",
          "plainText": "Tell me Pantino what sad talk was that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Wherewith my brother held you in the cloister?",
          "plainText": "Wherewith my brother held you in the cloister",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "pantino",
        "name": "PANTINO",
        "displayName": "Pantino"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "'Twas of his nephew Proteus, your son.",
          "plainText": "'Twas of his nephew Proteus your son",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Why, what of him?",
          "plainText": "Why what of him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "pantino",
        "name": "PANTINO",
        "displayName": "Pantino"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "He wondered that your lordship",
          "plainText": "He wondered that your lordship",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Would suffer him to spend his youth at home",
          "plainText": "Would suffer him to spend his youth at home",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0007",
          "number": 7,
          "speechLineNumber": 3,
          "text": "While other men, of slender reputation,",
          "plainText": "While other men of slender reputation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0008",
          "number": 8,
          "speechLineNumber": 4,
          "text": "Put forth their sons to seek preferment out:",
          "plainText": "Put forth their sons to seek preferment out",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0009",
          "number": 9,
          "speechLineNumber": 5,
          "text": "Some to the wars to try their fortune there;",
          "plainText": "Some to the wars to try their fortune there",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0010",
          "number": 10,
          "speechLineNumber": 6,
          "text": "Some to discover islands far away;",
          "plainText": "Some to discover islands far away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0011",
          "number": 11,
          "speechLineNumber": 7,
          "text": "Some to the studious universities.",
          "plainText": "Some to the studious universities",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0012",
          "number": 12,
          "speechLineNumber": 8,
          "text": "For any or for all these exercises",
          "plainText": "For any or for all these exercises",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0013",
          "number": 13,
          "speechLineNumber": 9,
          "text": "He said that Proteus your son was meet,",
          "plainText": "He said that Proteus your son was meet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0014",
          "number": 14,
          "speechLineNumber": 10,
          "text": "And did request me to importune you",
          "plainText": "And did request me to importune you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0015",
          "number": 15,
          "speechLineNumber": 11,
          "text": "To let him spend his time no more at home,",
          "plainText": "To let him spend his time no more at home",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0016",
          "number": 16,
          "speechLineNumber": 12,
          "text": "Which would be great impeachment to his age",
          "plainText": "Which would be great impeachment to his age",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0017",
          "number": 17,
          "speechLineNumber": 13,
          "text": "In having known no travel in his youth.",
          "plainText": "In having known no travel in his youth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Nor need'st thou much importune me to that",
          "plainText": "Nor need'st thou much importune me to that",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Whereon this month I have been hammering.",
          "plainText": "Whereon this month I have been hammering",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "I have considered well his loss of time,",
          "plainText": "I have considered well his loss of time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "And how he cannot be a perfect man,",
          "plainText": "And how he cannot be a perfect man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0022",
          "number": 22,
          "speechLineNumber": 5,
          "text": "Not being tried and tutored in the world.",
          "plainText": "Not being tried and tutored in the world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0023",
          "number": 23,
          "speechLineNumber": 6,
          "text": "Experience is by industry achieved",
          "plainText": "Experience is by industry achieved",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0024",
          "number": 24,
          "speechLineNumber": 7,
          "text": "And perfected by the swift course of time.",
          "plainText": "And perfected by the swift course of time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0025",
          "number": 25,
          "speechLineNumber": 8,
          "text": "Then tell me whither were I best to send him?",
          "plainText": "Then tell me whither were I best to send him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "pantino",
        "name": "PANTINO",
        "displayName": "Pantino"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "I think your lordship is not ignorant",
          "plainText": "I think your lordship is not ignorant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "How his companion, youthful Valentine,",
          "plainText": "How his companion youthful Valentine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "Attends the Emperor in his royal court.",
          "plainText": "Attends the Emperor in his royal court",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I know it well.",
          "plainText": "I know it well",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "pantino",
        "name": "PANTINO",
        "displayName": "Pantino"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "'Twere good, I think, your lordship sent him thither.",
          "plainText": "'Twere good I think your lordship sent him thither",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "There shall he practise tilts and tournaments,",
          "plainText": "There shall he practise tilts and tournaments",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0032",
          "number": 32,
          "speechLineNumber": 3,
          "text": "Hear sweet discourse, converse with noblemen,",
          "plainText": "Hear sweet discourse converse with noblemen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0033",
          "number": 33,
          "speechLineNumber": 4,
          "text": "And be in eye of every exercise",
          "plainText": "And be in eye of every exercise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0034",
          "number": 34,
          "speechLineNumber": 5,
          "text": "Worthy his youth and nobleness of birth.",
          "plainText": "Worthy his youth and nobleness of birth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "I like thy counsel; well hast thou advised,",
          "plainText": "I like thy counsel well hast thou advised",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "And that thou mayst perceive how well I like it,",
          "plainText": "And that thou mayst perceive how well I like it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0037",
          "number": 37,
          "speechLineNumber": 3,
          "text": "The execution of it shall make known.",
          "plainText": "The execution of it shall make known",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0038",
          "number": 38,
          "speechLineNumber": 4,
          "text": "Even with the speediest expedition",
          "plainText": "Even with the speediest expedition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0039",
          "number": 39,
          "speechLineNumber": 5,
          "text": "I will dispatch him to the Emperor's court.",
          "plainText": "I will dispatch him to the Emperor's court",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "pantino",
        "name": "PANTINO",
        "displayName": "Pantino"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Tomorrow, may it please you, Don Alphonso",
          "plainText": "Tomorrow may it please you Don Alphonso",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "With other gentlemen of good esteem",
          "plainText": "With other gentlemen of good esteem",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Are journeying to salute the Emperor",
          "plainText": "Are journeying to salute the Emperor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "And to commend their service to his will.",
          "plainText": "And to commend their service to his will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Good company. With them shall Proteus go.",
          "plainText": "Good company With them shall Proteus go",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-stage-002",
      "type": "stage",
      "text": "Enter Proteus reading a letter."
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Sweet love, sweet lines, sweet life!",
          "plainText": "Sweet love sweet lines sweet life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "Here is her hand, the agent of her heart;",
          "plainText": "Here is her hand the agent of her heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "Here is her oath for love, her honour's pawn.",
          "plainText": "Here is her oath for love her honour's pawn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "O, that our fathers would applaud our loves",
          "plainText": "O that our fathers would applaud our loves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0049",
          "number": 49,
          "speechLineNumber": 5,
          "text": "To seal our happiness with their consents.",
          "plainText": "To seal our happiness with their consents",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0050",
          "number": 50,
          "speechLineNumber": 6,
          "text": "O heavenly Julia!",
          "plainText": "O heavenly Julia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "How now? What letter are you reading there?",
          "plainText": "How now What letter are you reading there",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "May't please your lordship, 'tis a word or two",
          "plainText": "May't please your lordship 'tis a word or two",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Of commendations sent from Valentine,",
          "plainText": "Of commendations sent from Valentine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0054",
          "number": 54,
          "speechLineNumber": 3,
          "text": "Delivered by a friend that came from him.",
          "plainText": "Delivered by a friend that came from him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Lend me the letter. Let me see what news.",
          "plainText": "Lend me the letter Let me see what news",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "There is no news, my lord, but that he writes",
          "plainText": "There is no news my lord but that he writes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0057",
          "number": 57,
          "speechLineNumber": 2,
          "text": "How happily he lives, how well beloved",
          "plainText": "How happily he lives how well beloved",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0058",
          "number": 58,
          "speechLineNumber": 3,
          "text": "And daily graced by the Emperor,",
          "plainText": "And daily graced by the Emperor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0059",
          "number": 59,
          "speechLineNumber": 4,
          "text": "Wishing me with him, partner of his fortune.",
          "plainText": "Wishing me with him partner of his fortune",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "And how stand you affected to his wish?",
          "plainText": "And how stand you affected to his wish",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "As one relying on your lordship's will,",
          "plainText": "As one relying on your lordship's will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "And not depending on his friendly wish.",
          "plainText": "And not depending on his friendly wish",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "My will is something sorted with his wish.",
          "plainText": "My will is something sorted with his wish",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "Muse not that I thus suddenly proceed,",
          "plainText": "Muse not that I thus suddenly proceed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "For what I will, I will, and there an end.",
          "plainText": "For what I will I will and there an end",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "I am resolved that thou shalt spend some time",
          "plainText": "I am resolved that thou shalt spend some time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0067",
          "number": 67,
          "speechLineNumber": 5,
          "text": "With Valentinus in the Emperor's court.",
          "plainText": "With Valentinus in the Emperor's court",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0068",
          "number": 68,
          "speechLineNumber": 6,
          "text": "What maintenance he from his friends receives,",
          "plainText": "What maintenance he from his friends receives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0069",
          "number": 69,
          "speechLineNumber": 7,
          "text": "Like exhibition thou shalt have from me.",
          "plainText": "Like exhibition thou shalt have from me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0070",
          "number": 70,
          "speechLineNumber": 8,
          "text": "Tomorrow be in readiness to go.",
          "plainText": "Tomorrow be in readiness to go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0071",
          "number": 71,
          "speechLineNumber": 9,
          "text": "Excuse it not, for I am peremptory.",
          "plainText": "Excuse it not for I am peremptory",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "My lord, I cannot be so soon provided;",
          "plainText": "My lord I cannot be so soon provided",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0073",
          "number": 73,
          "speechLineNumber": 2,
          "text": "Please you deliberate a day or two.",
          "plainText": "Please you deliberate a day or two",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Look what thou want'st shall be sent after thee.",
          "plainText": "Look what thou want'st shall be sent after thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "No more of stay. Tomorrow thou must go.",
          "plainText": "No more of stay Tomorrow thou must go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "Come on, Pantino, you shall be employed",
          "plainText": "Come on Pantino you shall be employed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0077",
          "number": 77,
          "speechLineNumber": 4,
          "text": "To hasten on his expedition.",
          "plainText": "To hasten on his expedition",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-stage-003",
      "type": "stage",
      "text": "[Exeunt Antonio and Pantino.]"
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "Thus have I shunned the fire for fear of burning",
          "plainText": "Thus have I shunned the fire for fear of burning",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0079",
          "number": 79,
          "speechLineNumber": 2,
          "text": "And drenched me in the sea, where I am drowned.",
          "plainText": "And drenched me in the sea where I am drowned",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0080",
          "number": 80,
          "speechLineNumber": 3,
          "text": "I feared to show my father Julia's letter",
          "plainText": "I feared to show my father Julia's letter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0081",
          "number": 81,
          "speechLineNumber": 4,
          "text": "Lest he should take exceptions to my love,",
          "plainText": "Lest he should take exceptions to my love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0082",
          "number": 82,
          "speechLineNumber": 5,
          "text": "And with the vantage of mine own excuse",
          "plainText": "And with the vantage of mine own excuse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0083",
          "number": 83,
          "speechLineNumber": 6,
          "text": "Hath he excepted most against my love.",
          "plainText": "Hath he excepted most against my love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0084",
          "number": 84,
          "speechLineNumber": 7,
          "text": "O, how this spring of love resembleth",
          "plainText": "O how this spring of love resembleth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0085",
          "number": 85,
          "speechLineNumber": 8,
          "text": "The uncertain glory of an April day,",
          "plainText": "The uncertain glory of an April day",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0086",
          "number": 86,
          "speechLineNumber": 9,
          "text": "Which now shows all the beauty of the sun,",
          "plainText": "Which now shows all the beauty of the sun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0087",
          "number": 87,
          "speechLineNumber": 10,
          "text": "And by an by a cloud takes all away.",
          "plainText": "And by an by a cloud takes all away",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-stage-004",
      "type": "stage",
      "text": "Enter Pantino."
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "pantino",
        "name": "PANTINO",
        "displayName": "Pantino"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0088",
          "number": 88,
          "speechLineNumber": 1,
          "text": "Sir Proteus, your father calls for you.",
          "plainText": "Sir Proteus your father calls for you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0089",
          "number": 89,
          "speechLineNumber": 2,
          "text": "He is in haste. Therefore, I pray you, go.",
          "plainText": "He is in haste Therefore I pray you go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0090",
          "number": 90,
          "speechLineNumber": 1,
          "text": "Why, this it is: my heart accords thereto,",
          "plainText": "Why this it is my heart accords thereto",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-1-3-line-0091",
          "number": 91,
          "speechLineNumber": 2,
          "text": "And yet a thousand times it answers \"No\".",
          "plainText": "And yet a thousand times it answers No",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-1-3-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}