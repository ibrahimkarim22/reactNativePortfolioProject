  "scene": {
    "id": "the-two-gentlemen-of-verona-2-2",
    "act": 2,
    "scene": 2,
    "label": "Act 2, Scene 2",
    "title": "SCENE II. Verona. A room in Julia's house",
    "location": "Verona. A room in Julia's house",
    "orderInPlay": 5
  },
  "content": [
    {
      "id": "the-two-gentlemen-of-verona-2-2-stage-001",
      "type": "stage",
      "text": "Enter Proteus and Julia."
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Have patience, gentle Julia.",
          "plainText": "Have patience gentle Julia",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "I must, where is no remedy.",
          "plainText": "I must where is no remedy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "When possibly I can, I will return.",
          "plainText": "When possibly I can I will return",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "If you turn not, you will return the sooner.",
          "plainText": "If you turn not you will return the sooner",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "Keep this remembrance for thy Julia's sake.",
          "plainText": "Keep this remembrance for thy Julia's sake",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-stage-002",
      "type": "stage",
      "text": "[Gives him a ring.]"
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Why, then we'll make exchange. Here, take you this.",
          "plainText": "Why then we'll make exchange Here take you this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-stage-003",
      "type": "stage",
      "text": "[Gives her a ring.]"
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "And seal the bargain with a holy kiss.",
          "plainText": "And seal the bargain with a holy kiss",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Here is my hand for my true constancy.",
          "plainText": "Here is my hand for my true constancy",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "And when that hour o'erslips me in the day",
          "plainText": "And when that hour o'erslips me in the day",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0010",
          "number": 10,
          "speechLineNumber": 3,
          "text": "Wherein I sigh not, Julia, for thy sake,",
          "plainText": "Wherein I sigh not Julia for thy sake",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0011",
          "number": 11,
          "speechLineNumber": 4,
          "text": "The next ensuing hour some foul mischance",
          "plainText": "The next ensuing hour some foul mischance",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0012",
          "number": 12,
          "speechLineNumber": 5,
          "text": "Torment me for my love's forgetfulness.",
          "plainText": "Torment me for my love's forgetfulness",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0013",
          "number": 13,
          "speechLineNumber": 6,
          "text": "My father stays my coming; answer not.",
          "plainText": "My father stays my coming answer not",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0014",
          "number": 14,
          "speechLineNumber": 7,
          "text": "The tide is now—nay, not thy tide of tears,",
          "plainText": "The tide is nownay not thy tide of tears",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0015",
          "number": 15,
          "speechLineNumber": 8,
          "text": "That tide will stay me longer than I should.",
          "plainText": "That tide will stay me longer than I should",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0016",
          "number": 16,
          "speechLineNumber": 9,
          "text": "Julia, farewell.",
          "plainText": "Julia farewell",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-stage-004",
      "type": "stage",
      "text": "[Exit Julia.]"
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-stage-005",
      "type": "stage",
      "text": "Enter Pantino."
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "pantino",
        "name": "PANTINO",
        "displayName": "Pantino"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Sir Proteus, you are stayed for.",
          "plainText": "Sir Proteus you are stayed for",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Go, I come, I come.",
          "plainText": "Go I come I come",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-2-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Alas, this parting strikes poor lovers dumb.",
          "plainText": "Alas this parting strikes poor lovers dumb",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-2-stage-006",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}