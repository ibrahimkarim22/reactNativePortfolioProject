  "scene": {
    "id": "the-two-gentlemen-of-verona-2-5",
    "act": 2,
    "scene": 5,
    "label": "Act 2, Scene 5",
    "title": "SCENE V. The same. A street",
    "location": "The same. A street",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "the-two-gentlemen-of-verona-2-5-stage-001",
      "type": "stage",
      "text": "Enter Speed and Lance with his dog Crab."
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Lance, by mine honesty, welcome to Milan!",
          "plainText": "Lance by mine honesty welcome to Milan",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Forswear not thyself, sweet youth, for I am not welcome. I reckon this always, that a man is never undone till he be hanged, nor never welcome to a place till some certain shot be paid and the hostess say \"Welcome\".",
          "plainText": "Forswear not thyself sweet youth for I am not welcome I reckon this always that a man is never undone till he be hanged nor never welcome to a place till some certain shot be paid and the hostess say Welcome",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Come on, you madcap. I'll to the alehouse with you presently, where, for one shot of five pence, thou shalt have five thousand welcomes. But, sirrah, how did thy master part with Madam Julia?",
          "plainText": "Come on you madcap I'll to the alehouse with you presently where for one shot of five pence thou shalt have five thousand welcomes But sirrah how did thy master part with Madam Julia",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Marry, after they closed in earnest, they parted very fairly in jest.",
          "plainText": "Marry after they closed in earnest they parted very fairly in jest",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "But shall she marry him?",
          "plainText": "But shall she marry him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "No.",
          "plainText": "No",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "How then? Shall he marry her?",
          "plainText": "How then Shall he marry her",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "No, neither.",
          "plainText": "No neither",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "What, are they broken?",
          "plainText": "What are they broken",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "No, they are both as whole as a fish.",
          "plainText": "No they are both as whole as a fish",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Why then, how stands the matter with them?",
          "plainText": "Why then how stands the matter with them",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Marry, thus: when it stands well with him, it stands well with her.",
          "plainText": "Marry thus when it stands well with him it stands well with her",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "What an ass art thou! I understand thee not.",
          "plainText": "What an ass art thou I understand thee not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "What a block art thou that thou canst not! My staff understands me.",
          "plainText": "What a block art thou that thou canst not My staff understands me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "What thou sayst?",
          "plainText": "What thou sayst",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Ay, and what I do too. Look thee, I'll but lean, and my staff understands me.",
          "plainText": "Ay and what I do too Look thee I'll but lean and my staff understands me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "It stands under thee indeed.",
          "plainText": "It stands under thee indeed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Why, stand-under and under-stand is all one.",
          "plainText": "Why standunder and understand is all one",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "But tell me true, will't be a match?",
          "plainText": "But tell me true will't be a match",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Ask my dog. If he say \"Ay\", it will; if he say \"No\", it will; if he shake his tail and say nothing, it will.",
          "plainText": "Ask my dog If he say Ay it will if he say No it will if he shake his tail and say nothing it will",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "The conclusion is, then, that it will.",
          "plainText": "The conclusion is then that it will",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Thou shalt never get such a secret from me but by a parable.",
          "plainText": "Thou shalt never get such a secret from me but by a parable",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "'Tis well that I get it so. But, Lance, how sayst thou that my master is become a notable lover?",
          "plainText": "'Tis well that I get it so But Lance how sayst thou that my master is become a notable lover",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "I never knew him otherwise.",
          "plainText": "I never knew him otherwise",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Than how?",
          "plainText": "Than how",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "A notable lubber, as thou reportest him to be.",
          "plainText": "A notable lubber as thou reportest him to be",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-027",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Why, thou whoreson ass, thou mistak'st me.",
          "plainText": "Why thou whoreson ass thou mistak'st me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-028",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Why, fool, I meant not thee, I meant thy master.",
          "plainText": "Why fool I meant not thee I meant thy master",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-029",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I tell thee, my master is become a hot lover.",
          "plainText": "I tell thee my master is become a hot lover",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-030",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Why, I tell thee, I care not though he burn himself in love. If thou wilt, go with me to the alehouse; if not, thou art an Hebrew, a Jew, and not worth the name of a Christian.",
          "plainText": "Why I tell thee I care not though he burn himself in love If thou wilt go with me to the alehouse if not thou art an Hebrew a Jew and not worth the name of a Christian",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-031",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Why?",
          "plainText": "Why",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-032",
      "type": "speech",
      "speaker": {
        "id": "lance",
        "name": "LANCE",
        "displayName": "Lance"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Because thou hast not so much charity in thee as to go to the ale with a Christian. Wilt thou go?",
          "plainText": "Because thou hast not so much charity in thee as to go to the ale with a Christian Wilt thou go",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-speech-033",
      "type": "speech",
      "speaker": {
        "id": "speed",
        "name": "SPEED",
        "displayName": "Speed"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-5-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "At thy service.",
          "plainText": "At thy service",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-5-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}