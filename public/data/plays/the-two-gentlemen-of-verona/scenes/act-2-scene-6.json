{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "the-two-gentlemen-of-verona",
    "title": "The Two Gentlemen of Verona",
    "author": "William Shakespeare",
    "genre": "Comedy"
  },
  "source": {
