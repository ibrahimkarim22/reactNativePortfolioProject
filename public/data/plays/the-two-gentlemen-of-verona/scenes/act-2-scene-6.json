  "scene": {
    "id": "the-two-gentlemen-of-verona-2-6",
    "act": 2,
    "scene": 6,
    "label": "Act 2, Scene 6",
    "title": "SCENE VI. The same. The Duke's palace",
    "location": "The same. The Duke's palace",
    "orderInPlay": 9
  },
  "content": [
    {
      "id": "the-two-gentlemen-of-verona-2-6-stage-001",
      "type": "stage",
      "text": "Enter Proteus alone."
    },
    {
      "id": "the-two-gentlemen-of-verona-2-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "To leave my Julia, shall I be forsworn;",
          "plainText": "To leave my Julia shall I be forsworn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "To love fair Silvia, shall I be forsworn;",
          "plainText": "To love fair Silvia shall I be forsworn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "To wrong my friend, I shall be much forsworn.",
          "plainText": "To wrong my friend I shall be much forsworn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And e'en that power which gave me first my oath",
          "plainText": "And e'en that power which gave me first my oath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Provokes me to this threefold perjury.",
          "plainText": "Provokes me to this threefold perjury",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Love bade me swear, and Love bids me forswear.",
          "plainText": "Love bade me swear and Love bids me forswear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "O sweet-suggesting Love, if thou hast sinned,",
          "plainText": "O sweetsuggesting Love if thou hast sinned",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Teach me, thy tempted subject, to excuse it.",
          "plainText": "Teach me thy tempted subject to excuse it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "At first I did adore a twinkling star,",
          "plainText": "At first I did adore a twinkling star",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "But now I worship a celestial sun.",
          "plainText": "But now I worship a celestial sun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Unheedful vows may heedfully be broken,",
          "plainText": "Unheedful vows may heedfully be broken",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "And he wants wit that wants resolved will",
          "plainText": "And he wants wit that wants resolved will",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "To learn his wit t' exchange the bad for better.",
          "plainText": "To learn his wit t' exchange the bad for better",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Fie, fie, unreverend tongue, to call her bad",
          "plainText": "Fie fie unreverend tongue to call her bad",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "Whose sovereignty so oft thou hast preferred",
          "plainText": "Whose sovereignty so oft thou hast preferred",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "With twenty thousand soul-confirming oaths.",
          "plainText": "With twenty thousand soulconfirming oaths",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "I cannot leave to love, and yet I do;",
          "plainText": "I cannot leave to love and yet I do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "But there I leave to love where I should love.",
          "plainText": "But there I leave to love where I should love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "Julia I lose, and Valentine I lose;",
          "plainText": "Julia I lose and Valentine I lose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "If I keep them, I needs must lose myself;",
          "plainText": "If I keep them I needs must lose myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "If I lose them, thus find I by their loss,",
          "plainText": "If I lose them thus find I by their loss",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "For Valentine, myself; for Julia, Silvia.",
          "plainText": "For Valentine myself for Julia Silvia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "I to myself am dearer than a friend,",
          "plainText": "I to myself am dearer than a friend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "For love is still most precious in itself,",
          "plainText": "For love is still most precious in itself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0025",
          "number": 25,
          "speechLineNumber": 25,
          "text": "And Silvia—witness heaven that made her fair—",
          "plainText": "And Silviawitness heaven that made her fair",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0026",
          "number": 26,
          "speechLineNumber": 26,
          "text": "Shows Julia but a swarthy Ethiope.",
          "plainText": "Shows Julia but a swarthy Ethiope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0027",
          "number": 27,
          "speechLineNumber": 27,
          "text": "I will forget that Julia is alive,",
          "plainText": "I will forget that Julia is alive",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0028",
          "number": 28,
          "speechLineNumber": 28,
          "text": "Remembering that my love to her is dead;",
          "plainText": "Remembering that my love to her is dead",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0029",
          "number": 29,
          "speechLineNumber": 29,
          "text": "And Valentine I'll hold an enemy,",
          "plainText": "And Valentine I'll hold an enemy",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0030",
          "number": 30,
          "speechLineNumber": 30,
          "text": "Aiming at Silvia as a sweeter friend.",
          "plainText": "Aiming at Silvia as a sweeter friend",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0031",
          "number": 31,
          "speechLineNumber": 31,
          "text": "I cannot now prove constant to myself",
          "plainText": "I cannot now prove constant to myself",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0032",
          "number": 32,
          "speechLineNumber": 32,
          "text": "Without some treachery used to Valentine.",
          "plainText": "Without some treachery used to Valentine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0033",
          "number": 33,
          "speechLineNumber": 33,
          "text": "This night he meaneth with a corded ladder",
          "plainText": "This night he meaneth with a corded ladder",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0034",
          "number": 34,
          "speechLineNumber": 34,
          "text": "To climb celestial Silvia's chamber window,",
          "plainText": "To climb celestial Silvia's chamber window",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0035",
          "number": 35,
          "speechLineNumber": 35,
          "text": "Myself in counsel, his competitor.",
          "plainText": "Myself in counsel his competitor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0036",
          "number": 36,
          "speechLineNumber": 36,
          "text": "Now presently I'll give her father notice",
          "plainText": "Now presently I'll give her father notice",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0037",
          "number": 37,
          "speechLineNumber": 37,
          "text": "Of their disguising and pretended flight,",
          "plainText": "Of their disguising and pretended flight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0038",
          "number": 38,
          "speechLineNumber": 38,
          "text": "Who, all enraged, will banish Valentine,",
          "plainText": "Who all enraged will banish Valentine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0039",
          "number": 39,
          "speechLineNumber": 39,
          "text": "For Thurio he intends shall wed his daughter.",
          "plainText": "For Thurio he intends shall wed his daughter",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0040",
          "number": 40,
          "speechLineNumber": 40,
          "text": "But Valentine being gone, I'll quickly cross",
          "plainText": "But Valentine being gone I'll quickly cross",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0041",
          "number": 41,
          "speechLineNumber": 41,
          "text": "By some sly trick blunt Thurio's dull proceeding.",
          "plainText": "By some sly trick blunt Thurio's dull proceeding",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0042",
          "number": 42,
          "speechLineNumber": 42,
          "text": "Love, lend me wings to make my purpose swift,",
          "plainText": "Love lend me wings to make my purpose swift",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-6-line-0043",
          "number": 43,
          "speechLineNumber": 43,
          "text": "As thou hast lent me wit to plot this drift.",
          "plainText": "As thou hast lent me wit to plot this drift",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-6-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}