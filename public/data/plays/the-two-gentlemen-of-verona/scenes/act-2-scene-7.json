    "location": "Verona. A room in Julia's house",
    "orderInPlay": 10
  },
  "content": [
    {
      "id": "the-two-gentlemen-of-verona-2-7-stage-001",
      "type": "stage",
      "text": "Enter Julia and Lucetta."
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-001",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Counsel, Lucetta; gentle girl, assist me,",
          "plainText": "Counsel Lucetta gentle girl assist me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And ev'n in kind love I do conjure thee,",
          "plainText": "And ev'n in kind love I do conjure thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Who art the table wherein all my thoughts",
          "plainText": "Who art the table wherein all my thoughts",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Are visibly charactered and engraved,",
          "plainText": "Are visibly charactered and engraved",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "To lesson me and tell me some good mean",
          "plainText": "To lesson me and tell me some good mean",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "How with my honour I may undertake",
          "plainText": "How with my honour I may undertake",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "A journey to my loving Proteus.",
          "plainText": "A journey to my loving Proteus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-002",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Alas, the way is wearisome and long.",
          "plainText": "Alas the way is wearisome and long",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-003",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "A true-devoted pilgrim is not weary",
          "plainText": "A truedevoted pilgrim is not weary",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "To measure kingdoms with his feeble steps;",
          "plainText": "To measure kingdoms with his feeble steps",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "Much less shall she that hath Love's wings to fly,",
          "plainText": "Much less shall she that hath Love's wings to fly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "And when the flight is made to one so dear,",
          "plainText": "And when the flight is made to one so dear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0013",
          "number": 13,
          "speechLineNumber": 5,
          "text": "Of such divine perfection, as Sir Proteus.",
          "plainText": "Of such divine perfection as Sir Proteus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Better forbear till Proteus make return.",
          "plainText": "Better forbear till Proteus make return",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-005",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "O, know'st thou not his looks are my soul's food?",
          "plainText": "O know'st thou not his looks are my soul's food",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Pity the dearth that I have pined in",
          "plainText": "Pity the dearth that I have pined in",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "By longing for that food so long a time.",
          "plainText": "By longing for that food so long a time",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "Didst thou but know the inly touch of love",
          "plainText": "Didst thou but know the inly touch of love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0019",
          "number": 19,
          "speechLineNumber": 5,
          "text": "Thou wouldst as soon go kindle fire with snow",
          "plainText": "Thou wouldst as soon go kindle fire with snow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0020",
          "number": 20,
          "speechLineNumber": 6,
          "text": "As seek to quench the fire of love with words.",
          "plainText": "As seek to quench the fire of love with words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-006",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "I do not seek to quench your love's hot fire,",
          "plainText": "I do not seek to quench your love's hot fire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "But qualify the fire's extreme rage,",
          "plainText": "But qualify the fire's extreme rage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "Lest it should burn above the bounds of reason.",
          "plainText": "Lest it should burn above the bounds of reason",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-007",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "The more thou damm'st it up, the more it burns.",
          "plainText": "The more thou damm'st it up the more it burns",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "The current that with gentle murmur glides,",
          "plainText": "The current that with gentle murmur glides",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "Thou know'st, being stopped, impatiently doth rage;",
          "plainText": "Thou know'st being stopped impatiently doth rage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "But when his fair course is not hindered,",
          "plainText": "But when his fair course is not hindered",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0028",
          "number": 28,
          "speechLineNumber": 5,
          "text": "He makes sweet music with th' enamelled stones,",
          "plainText": "He makes sweet music with th' enamelled stones",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0029",
          "number": 29,
          "speechLineNumber": 6,
          "text": "Giving a gentle kiss to every sedge",
          "plainText": "Giving a gentle kiss to every sedge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0030",
          "number": 30,
          "speechLineNumber": 7,
          "text": "He overtaketh in his pilgrimage;",
          "plainText": "He overtaketh in his pilgrimage",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0031",
          "number": 31,
          "speechLineNumber": 8,
          "text": "And so by many winding nooks he strays",
          "plainText": "And so by many winding nooks he strays",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0032",
          "number": 32,
          "speechLineNumber": 9,
          "text": "With willing sport to the wild ocean.",
          "plainText": "With willing sport to the wild ocean",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0033",
          "number": 33,
          "speechLineNumber": 10,
          "text": "Then let me go and hinder not my course.",
          "plainText": "Then let me go and hinder not my course",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0034",
          "number": 34,
          "speechLineNumber": 11,
          "text": "I'll be as patient as a gentle stream",
          "plainText": "I'll be as patient as a gentle stream",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0035",
          "number": 35,
          "speechLineNumber": 12,
          "text": "And make a pastime of each weary step",
          "plainText": "And make a pastime of each weary step",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0036",
          "number": 36,
          "speechLineNumber": 13,
          "text": "Till the last step have brought me to my love,",
          "plainText": "Till the last step have brought me to my love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0037",
          "number": 37,
          "speechLineNumber": 14,
          "text": "And there I'll rest as after much turmoil",
          "plainText": "And there I'll rest as after much turmoil",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0038",
          "number": 38,
          "speechLineNumber": 15,
          "text": "A blessed soul doth in Elysium.",
          "plainText": "A blessed soul doth in Elysium",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-008",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "But in what habit will you go along?",
          "plainText": "But in what habit will you go along",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-009",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Not like a woman, for I would prevent",
          "plainText": "Not like a woman for I would prevent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "The loose encounters of lascivious men.",
          "plainText": "The loose encounters of lascivious men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Gentle Lucetta, fit me with such weeds",
          "plainText": "Gentle Lucetta fit me with such weeds",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "As may beseem some well-reputed page.",
          "plainText": "As may beseem some wellreputed page",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-010",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Why then, your ladyship must cut your hair.",
          "plainText": "Why then your ladyship must cut your hair",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-011",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "No, girl, I'll knit it up in silken strings",
          "plainText": "No girl I'll knit it up in silken strings",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "With twenty odd-conceited true-love knots.",
          "plainText": "With twenty oddconceited truelove knots",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0047",
          "number": 47,
          "speechLineNumber": 3,
          "text": "To be fantastic may become a youth",
          "plainText": "To be fantastic may become a youth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0048",
          "number": 48,
          "speechLineNumber": 4,
          "text": "Of greater time than I shall show to be.",
          "plainText": "Of greater time than I shall show to be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-012",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "What fashion, madam, shall I make your breeches?",
          "plainText": "What fashion madam shall I make your breeches",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-013",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "That fits as well as \"Tell me, good my lord,",
          "plainText": "That fits as well as Tell me good my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "What compass will you wear your farthingale?\"",
          "plainText": "What compass will you wear your farthingale",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0052",
          "number": 52,
          "speechLineNumber": 3,
          "text": "Why e'en what fashion thou best likes, Lucetta.",
          "plainText": "Why e'en what fashion thou best likes Lucetta",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-014",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "You must needs have them with a codpiece, madam.",
          "plainText": "You must needs have them with a codpiece madam",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-015",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Out, out, Lucetta, that will be ill-favoured.",
          "plainText": "Out out Lucetta that will be illfavoured",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-016",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "A round hose, madam, now's not worth a pin",
          "plainText": "A round hose madam now's not worth a pin",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "Unless you have a codpiece to stick pins on.",
          "plainText": "Unless you have a codpiece to stick pins on",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-017",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Lucetta, as thou lov'st me, let me have",
          "plainText": "Lucetta as thou lov'st me let me have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "What thou think'st meet and is most mannerly.",
          "plainText": "What thou think'st meet and is most mannerly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0059",
          "number": 59,
          "speechLineNumber": 3,
          "text": "But tell me, wench, how will the world repute me",
          "plainText": "But tell me wench how will the world repute me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0060",
          "number": 60,
          "speechLineNumber": 4,
          "text": "For undertaking so unstaid a journey?",
          "plainText": "For undertaking so unstaid a journey",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0061",
          "number": 61,
          "speechLineNumber": 5,
          "text": "I fear me it will make me scandalized.",
          "plainText": "I fear me it will make me scandalized",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-018",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "If you think so, then stay at home and go not.",
          "plainText": "If you think so then stay at home and go not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-019",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Nay, that I will not.",
          "plainText": "Nay that I will not",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-020",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Then never dream on infamy, but go.",
          "plainText": "Then never dream on infamy but go",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "If Proteus like your journey when you come,",
          "plainText": "If Proteus like your journey when you come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "No matter who's displeased when you are gone.",
          "plainText": "No matter who's displeased when you are gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0067",
          "number": 67,
          "speechLineNumber": 4,
          "text": "I fear me he will scarce be pleased withal.",
          "plainText": "I fear me he will scarce be pleased withal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-021",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "That is the least, Lucetta, of my fear.",
          "plainText": "That is the least Lucetta of my fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0069",
          "number": 69,
          "speechLineNumber": 2,
          "text": "A thousand oaths, an ocean of his tears,",
          "plainText": "A thousand oaths an ocean of his tears",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0070",
          "number": 70,
          "speechLineNumber": 3,
          "text": "And instances of infinite of love,",
          "plainText": "And instances of infinite of love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0071",
          "number": 71,
          "speechLineNumber": 4,
          "text": "Warrant me welcome to my Proteus.",
          "plainText": "Warrant me welcome to my Proteus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-022",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "All these are servants to deceitful men.",
          "plainText": "All these are servants to deceitful men",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-023",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Base men that use them to so base effect!",
          "plainText": "Base men that use them to so base effect",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0074",
          "number": 74,
          "speechLineNumber": 2,
          "text": "But truer stars did govern Proteus' birth.",
          "plainText": "But truer stars did govern Proteus' birth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0075",
          "number": 75,
          "speechLineNumber": 3,
          "text": "His words are bonds, his oaths are oracles,",
          "plainText": "His words are bonds his oaths are oracles",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0076",
          "number": 76,
          "speechLineNumber": 4,
          "text": "His love sincere, his thoughts immaculate,",
          "plainText": "His love sincere his thoughts immaculate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0077",
          "number": 77,
          "speechLineNumber": 5,
          "text": "His tears pure messengers sent from his heart,",
          "plainText": "His tears pure messengers sent from his heart",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0078",
          "number": 78,
          "speechLineNumber": 6,
          "text": "His heart as far from fraud as heaven from earth.",
          "plainText": "His heart as far from fraud as heaven from earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-024",
      "type": "speech",
      "speaker": {
        "id": "lucetta",
        "name": "LUCETTA",
        "displayName": "Lucetta"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Pray heav'n he prove so when you come to him.",
          "plainText": "Pray heav'n he prove so when you come to him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-speech-025",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "Now, as thou lov'st me, do him not that wrong",
          "plainText": "Now as thou lov'st me do him not that wrong",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0081",
          "number": 81,
          "speechLineNumber": 2,
          "text": "To bear a hard opinion of his truth.",
          "plainText": "To bear a hard opinion of his truth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0082",
          "number": 82,
          "speechLineNumber": 3,
          "text": "Only deserve my love by loving him.",
          "plainText": "Only deserve my love by loving him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0083",
          "number": 83,
          "speechLineNumber": 4,
          "text": "And presently go with me to my chamber",
          "plainText": "And presently go with me to my chamber",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0084",
          "number": 84,
          "speechLineNumber": 5,
          "text": "To take a note of what I stand in need of",
          "plainText": "To take a note of what I stand in need of",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0085",
          "number": 85,
          "speechLineNumber": 6,
          "text": "To furnish me upon my longing journey.",
          "plainText": "To furnish me upon my longing journey",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0086",
          "number": 86,
          "speechLineNumber": 7,
          "text": "All that is mine I leave at thy dispose,",
          "plainText": "All that is mine I leave at thy dispose",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0087",
          "number": 87,
          "speechLineNumber": 8,
          "text": "My goods, my lands, my reputation;",
          "plainText": "My goods my lands my reputation",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0088",
          "number": 88,
          "speechLineNumber": 9,
          "text": "Only, in lieu thereof, dispatch me hence.",
          "plainText": "Only in lieu thereof dispatch me hence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0089",
          "number": 89,
          "speechLineNumber": 10,
          "text": "Come, answer not, but to it presently.",
          "plainText": "Come answer not but to it presently",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-2-7-line-0090",
          "number": 90,
          "speechLineNumber": 11,
          "text": "I am impatient of my tarriance.",
          "plainText": "I am impatient of my tarriance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-2-7-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}