  },
  "scene": {
    "id": "the-two-gentlemen-of-verona-3-2",
    "act": 3,
    "scene": 2,
    "label": "Act 3, Scene 2",
    "title": "SCENE II. The same. A room in the Duke's palace",
    "location": "The same. A room in the Duke's palace",
    "orderInPlay": 12
  },
  "content": [
    {
      "id": "the-two-gentlemen-of-verona-3-2-stage-001",
      "type": "stage",
      "text": "Enter Duke and Thurio."
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Sir Thurio, fear not but that she will love you",
          "plainText": "Sir Thurio fear not but that she will love you",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Now Valentine is banished from her sight.",
          "plainText": "Now Valentine is banished from her sight",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Since his exile she hath despised me most,",
          "plainText": "Since his exile she hath despised me most",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Forsworn my company and railed at me,",
          "plainText": "Forsworn my company and railed at me",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "That I am desperate of obtaining her.",
          "plainText": "That I am desperate of obtaining her",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "This weak impress of love is as a figure",
          "plainText": "This weak impress of love is as a figure",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "Trenched in ice, which with an hour's heat",
          "plainText": "Trenched in ice which with an hour's heat",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "Dissolves to water and doth lose his form.",
          "plainText": "Dissolves to water and doth lose his form",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "A little time will melt her frozen thoughts,",
          "plainText": "A little time will melt her frozen thoughts",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "And worthless Valentine shall be forgot.",
          "plainText": "And worthless Valentine shall be forgot",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-stage-002",
      "type": "stage",
      "text": "Enter Proteus."
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Gone, my good lord.",
          "plainText": "Gone my good lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "My daughter takes his going grievously.",
          "plainText": "My daughter takes his going grievously",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "A little time, my lord, will kill that grief.",
          "plainText": "A little time my lord will kill that grief",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "So I believe, but Thurio thinks not so.",
          "plainText": "So I believe but Thurio thinks not so",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "Proteus, the good conceit I hold of thee,",
          "plainText": "Proteus the good conceit I hold of thee",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "For thou hast shown some sign of good desert,",
          "plainText": "For thou hast shown some sign of good desert",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "Makes me the better to confer with thee.",
          "plainText": "Makes me the better to confer with thee",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Longer than I prove loyal to your Grace",
          "plainText": "Longer than I prove loyal to your Grace",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "Let me not live to look upon your Grace.",
          "plainText": "Let me not live to look upon your Grace",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Thou know'st how willingly I would effect",
          "plainText": "Thou know'st how willingly I would effect",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "The match between Sir Thurio and my daughter?",
          "plainText": "The match between Sir Thurio and my daughter",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I do, my lord.",
          "plainText": "I do my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "And also, I think, thou art not ignorant",
          "plainText": "And also I think thou art not ignorant",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0024",
          "number": 24,
          "speechLineNumber": 2,
          "text": "How she opposes her against my will?",
          "plainText": "How she opposes her against my will",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "She did, my lord, when Valentine was here.",
          "plainText": "She did my lord when Valentine was here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Ay, and perversely she persevers so.",
          "plainText": "Ay and perversely she persevers so",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "What might we do to make the girl forget",
          "plainText": "What might we do to make the girl forget",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "The love of Valentine, and love Sir Thurio?",
          "plainText": "The love of Valentine and love Sir Thurio",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "The best way is to slander Valentine",
          "plainText": "The best way is to slander Valentine",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "With falsehood, cowardice, and poor descent,",
          "plainText": "With falsehood cowardice and poor descent",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "Three things that women highly hold in hate.",
          "plainText": "Three things that women highly hold in hate",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Ay, but she'll think that it is spoke in hate.",
          "plainText": "Ay but she'll think that it is spoke in hate",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Ay, if his enemy deliver it;",
          "plainText": "Ay if his enemy deliver it",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Therefore it must with circumstance be spoken",
          "plainText": "Therefore it must with circumstance be spoken",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0035",
          "number": 35,
          "speechLineNumber": 3,
          "text": "By one whom she esteemeth as his friend.",
          "plainText": "By one whom she esteemeth as his friend",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Then you must undertake to slander him.",
          "plainText": "Then you must undertake to slander him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "And that, my lord, I shall be loath to do.",
          "plainText": "And that my lord I shall be loath to do",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "'Tis an ill office for a gentleman,",
          "plainText": "'Tis an ill office for a gentleman",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "Especially against his very friend.",
          "plainText": "Especially against his very friend",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Where your good word cannot advantage him,",
          "plainText": "Where your good word cannot advantage him",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "Your slander never can endamage him;",
          "plainText": "Your slander never can endamage him",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0042",
          "number": 42,
          "speechLineNumber": 3,
          "text": "Therefore the office is indifferent,",
          "plainText": "Therefore the office is indifferent",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0043",
          "number": 43,
          "speechLineNumber": 4,
          "text": "Being entreated to it by your friend.",
          "plainText": "Being entreated to it by your friend",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "You have prevailed, my lord. If I can do it",
          "plainText": "You have prevailed my lord If I can do it",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0045",
          "number": 45,
          "speechLineNumber": 2,
          "text": "By aught that I can speak in his dispraise,",
          "plainText": "By aught that I can speak in his dispraise",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0046",
          "number": 46,
          "speechLineNumber": 3,
          "text": "She shall not long continue love to him.",
          "plainText": "She shall not long continue love to him",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0047",
          "number": 47,
          "speechLineNumber": 4,
          "text": "But say this weed her love from Valentine,",
          "plainText": "But say this weed her love from Valentine",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0048",
          "number": 48,
          "speechLineNumber": 5,
          "text": "It follows not that she will love Sir Thurio.",
          "plainText": "It follows not that she will love Sir Thurio",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Therefore, as you unwind her love from him,",
          "plainText": "Therefore as you unwind her love from him",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0050",
          "number": 50,
          "speechLineNumber": 2,
          "text": "Lest it should ravel and be good to none,",
          "plainText": "Lest it should ravel and be good to none",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0051",
          "number": 51,
          "speechLineNumber": 3,
          "text": "You must provide to bottom it on me,",
          "plainText": "You must provide to bottom it on me",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0052",
          "number": 52,
          "speechLineNumber": 4,
          "text": "Which must be done by praising me as much",
          "plainText": "Which must be done by praising me as much",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0053",
          "number": 53,
          "speechLineNumber": 5,
          "text": "As you in worth dispraise Sir Valentine.",
          "plainText": "As you in worth dispraise Sir Valentine",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "And, Proteus, we dare trust you in this kind",
          "plainText": "And Proteus we dare trust you in this kind",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "Because we know, on Valentine's report,",
          "plainText": "Because we know on Valentine's report",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0056",
          "number": 56,
          "speechLineNumber": 3,
          "text": "You are already Love's firm votary",
          "plainText": "You are already Love's firm votary",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0057",
          "number": 57,
          "speechLineNumber": 4,
          "text": "And cannot soon revolt and change your mind.",
          "plainText": "And cannot soon revolt and change your mind",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0058",
          "number": 58,
          "speechLineNumber": 5,
          "text": "Upon this warrant shall you have access",
          "plainText": "Upon this warrant shall you have access",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0059",
          "number": 59,
          "speechLineNumber": 6,
          "text": "Where you with Silvia may confer at large—",
          "plainText": "Where you with Silvia may confer at large",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0060",
          "number": 60,
          "speechLineNumber": 7,
          "text": "For she is lumpish, heavy, melancholy,",
          "plainText": "For she is lumpish heavy melancholy",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0061",
          "number": 61,
          "speechLineNumber": 8,
          "text": "And, for your friend's sake, will be glad of you—",
          "plainText": "And for your friend's sake will be glad of you",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0062",
          "number": 62,
          "speechLineNumber": 9,
          "text": "Where you may temper her by your persuasion",
          "plainText": "Where you may temper her by your persuasion",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0063",
          "number": 63,
          "speechLineNumber": 10,
          "text": "To hate young Valentine and love my friend.",
          "plainText": "To hate young Valentine and love my friend",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "As much as I can do I will effect.",
          "plainText": "As much as I can do I will effect",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "But you, Sir Thurio, are not sharp enough.",
          "plainText": "But you Sir Thurio are not sharp enough",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0066",
          "number": 66,
          "speechLineNumber": 3,
          "text": "You must lay lime to tangle her desires",
          "plainText": "You must lay lime to tangle her desires",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0067",
          "number": 67,
          "speechLineNumber": 4,
          "text": "By wailful sonnets, whose composed rhymes",
          "plainText": "By wailful sonnets whose composed rhymes",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0068",
          "number": 68,
          "speechLineNumber": 5,
          "text": "Should be full-fraught with serviceable vows.",
          "plainText": "Should be fullfraught with serviceable vows",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Ay, much is the force of heaven-bred poesy.",
          "plainText": "Ay much is the force of heavenbred poesy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Say that upon the altar of her beauty",
          "plainText": "Say that upon the altar of her beauty",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0071",
          "number": 71,
          "speechLineNumber": 2,
          "text": "You sacrifice your tears, your sighs, your heart.",
          "plainText": "You sacrifice your tears your sighs your heart",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0072",
          "number": 72,
          "speechLineNumber": 3,
          "text": "Write till your ink be dry, and with your tears",
          "plainText": "Write till your ink be dry and with your tears",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0073",
          "number": 73,
          "speechLineNumber": 4,
          "text": "Moist it again, and frame some feeling line",
          "plainText": "Moist it again and frame some feeling line",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0074",
          "number": 74,
          "speechLineNumber": 5,
          "text": "That may discover such integrity.",
          "plainText": "That may discover such integrity",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0075",
          "number": 75,
          "speechLineNumber": 6,
          "text": "For Orpheus' lute was strung with poets' sinews,",
          "plainText": "For Orpheus' lute was strung with poets' sinews",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0076",
          "number": 76,
          "speechLineNumber": 7,
          "text": "Whose golden touch could soften steel and stones,",
          "plainText": "Whose golden touch could soften steel and stones",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0077",
          "number": 77,
          "speechLineNumber": 8,
          "text": "Make tigers tame, and huge leviathans",
          "plainText": "Make tigers tame and huge leviathans",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0078",
          "number": 78,
          "speechLineNumber": 9,
          "text": "Forsake unsounded deeps to dance on sands.",
          "plainText": "Forsake unsounded deeps to dance on sands",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0079",
          "number": 79,
          "speechLineNumber": 10,
          "text": "After your dire-lamenting elegies,",
          "plainText": "After your direlamenting elegies",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0080",
          "number": 80,
          "speechLineNumber": 11,
          "text": "Visit by night your lady's chamber-window",
          "plainText": "Visit by night your lady's chamberwindow",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0081",
          "number": 81,
          "speechLineNumber": 12,
          "text": "With some sweet consort; to their instruments",
          "plainText": "With some sweet consort to their instruments",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0082",
          "number": 82,
          "speechLineNumber": 13,
          "text": "Tune a deploring dump; the night's dead silence",
          "plainText": "Tune a deploring dump the night's dead silence",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0083",
          "number": 83,
          "speechLineNumber": 14,
          "text": "Will well become such sweet-complaining grievance.",
          "plainText": "Will well become such sweetcomplaining grievance",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0084",
          "number": 84,
          "speechLineNumber": 15,
          "text": "This, or else nothing, will inherit her.",
          "plainText": "This or else nothing will inherit her",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0085",
          "number": 85,
          "speechLineNumber": 1,
          "text": "This discipline shows thou hast been in love.",
          "plainText": "This discipline shows thou hast been in love",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "And thy advice this night I'll put in practice.",
          "plainText": "And thy advice this night I'll put in practice",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0087",
          "number": 87,
          "speechLineNumber": 2,
          "text": "Therefore, sweet Proteus, my direction-giver,",
          "plainText": "Therefore sweet Proteus my directiongiver",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0088",
          "number": 88,
          "speechLineNumber": 3,
          "text": "Let us into the city presently",
          "plainText": "Let us into the city presently",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0089",
          "number": 89,
          "speechLineNumber": 4,
          "text": "To sort some gentlemen well skilled in music.",
          "plainText": "To sort some gentlemen well skilled in music",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0090",
          "number": 90,
          "speechLineNumber": 5,
          "text": "I have a sonnet that will serve the turn",
          "plainText": "I have a sonnet that will serve the turn",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0091",
          "number": 91,
          "speechLineNumber": 6,
          "text": "To give the onset to thy good advice.",
          "plainText": "To give the onset to thy good advice",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "About it, gentlemen!",
          "plainText": "About it gentlemen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "We'll wait upon your Grace till after supper,",
          "plainText": "We'll wait upon your Grace till after supper",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0094",
          "number": 94,
          "speechLineNumber": 2,
          "text": "And afterward determine our proceedings.",
          "plainText": "And afterward determine our proceedings",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-3-2-line-0095",
          "number": 95,
          "speechLineNumber": 1,
          "text": "Even now about it! I will pardon you.",
          "plainText": "Even now about it I will pardon you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-3-2-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}