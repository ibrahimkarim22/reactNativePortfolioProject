  "scene": {
    "id": "the-two-gentlemen-of-verona-4-3",
    "act": 4,
    "scene": 3,
    "label": "Act 4, Scene 3",
    "title": "SCENE III. The same",
    "location": "The same",
    "orderInPlay": 15
  },
  "content": [
    {
      "id": "the-two-gentlemen-of-verona-4-3-stage-001",
      "type": "stage",
      "text": "Enter Eglamour."
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "eglamour",
        "name": "EGLAMOUR",
        "displayName": "Eglamour"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "This is the hour that Madam Silvia",
          "plainText": "This is the hour that Madam Silvia",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Entreated me to call and know her mind;",
          "plainText": "Entreated me to call and know her mind",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "There's some great matter she'd employ me in.",
          "plainText": "There's some great matter she'd employ me in",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Madam, madam!",
          "plainText": "Madam madam",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-stage-002",
      "type": "stage",
      "text": "Enter Silvia above."
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "silvia",
        "name": "SILVIA",
        "displayName": "Silvia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Who calls?",
          "plainText": "Who calls",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "eglamour",
        "name": "EGLAMOUR",
        "displayName": "Eglamour"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Your servant and your friend;",
          "plainText": "Your servant and your friend",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "One that attends your ladyship's command.",
          "plainText": "One that attends your ladyship's command",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "silvia",
        "name": "SILVIA",
        "displayName": "Silvia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Sir Eglamour, a thousand times good morrow.",
          "plainText": "Sir Eglamour a thousand times good morrow",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "eglamour",
        "name": "EGLAMOUR",
        "displayName": "Eglamour"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "As many, worthy lady, to yourself.",
          "plainText": "As many worthy lady to yourself",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "According to your ladyship's impose,",
          "plainText": "According to your ladyship's impose",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "I am thus early come to know what service",
          "plainText": "I am thus early come to know what service",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 4,
          "text": "It is your pleasure to command me in.",
          "plainText": "It is your pleasure to command me in",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "silvia",
        "name": "SILVIA",
        "displayName": "Silvia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "O Eglamour, thou art a gentleman—",
          "plainText": "O Eglamour thou art a gentleman",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Think not I flatter, for I swear I do not—",
          "plainText": "Think not I flatter for I swear I do not",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 3,
          "text": "Valiant, wise, remorseful, well accomplished.",
          "plainText": "Valiant wise remorseful well accomplished",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 4,
          "text": "Thou art not ignorant what dear good will",
          "plainText": "Thou art not ignorant what dear good will",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 5,
          "text": "I bear unto the banished Valentine,",
          "plainText": "I bear unto the banished Valentine",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 6,
          "text": "Nor how my father would enforce me marry",
          "plainText": "Nor how my father would enforce me marry",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 7,
          "text": "Vain Thurio, whom my very soul abhorred.",
          "plainText": "Vain Thurio whom my very soul abhorred",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0020",
          "number": 20,
          "speechLineNumber": 8,
          "text": "Thyself hast loved, and I have heard thee say",
          "plainText": "Thyself hast loved and I have heard thee say",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0021",
          "number": 21,
          "speechLineNumber": 9,
          "text": "No grief did ever come so near thy heart",
          "plainText": "No grief did ever come so near thy heart",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0022",
          "number": 22,
          "speechLineNumber": 10,
          "text": "As when thy lady and thy true love died,",
          "plainText": "As when thy lady and thy true love died",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0023",
          "number": 23,
          "speechLineNumber": 11,
          "text": "Upon whose grave thou vowed'st pure chastity.",
          "plainText": "Upon whose grave thou vowed'st pure chastity",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0024",
          "number": 24,
          "speechLineNumber": 12,
          "text": "Sir Eglamour, I would to Valentine,",
          "plainText": "Sir Eglamour I would to Valentine",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0025",
          "number": 25,
          "speechLineNumber": 13,
          "text": "To Mantua, where I hear he makes abode;",
          "plainText": "To Mantua where I hear he makes abode",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0026",
          "number": 26,
          "speechLineNumber": 14,
          "text": "And for the ways are dangerous to pass,",
          "plainText": "And for the ways are dangerous to pass",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0027",
          "number": 27,
          "speechLineNumber": 15,
          "text": "I do desire thy worthy company,",
          "plainText": "I do desire thy worthy company",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0028",
          "number": 28,
          "speechLineNumber": 16,
          "text": "Upon whose faith and honour I repose.",
          "plainText": "Upon whose faith and honour I repose",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0029",
          "number": 29,
          "speechLineNumber": 17,
          "text": "Urge not my father's anger, Eglamour,",
          "plainText": "Urge not my father's anger Eglamour",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0030",
          "number": 30,
          "speechLineNumber": 18,
          "text": "But think upon my grief, a lady's grief,",
          "plainText": "But think upon my grief a lady's grief",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0031",
          "number": 31,
          "speechLineNumber": 19,
          "text": "And on the justice of my flying hence",
          "plainText": "And on the justice of my flying hence",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0032",
          "number": 32,
          "speechLineNumber": 20,
          "text": "To keep me from a most unholy match,",
          "plainText": "To keep me from a most unholy match",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0033",
          "number": 33,
          "speechLineNumber": 21,
          "text": "Which heaven and fortune still rewards with plagues.",
          "plainText": "Which heaven and fortune still rewards with plagues",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0034",
          "number": 34,
          "speechLineNumber": 22,
          "text": "I do desire thee, even from a heart",
          "plainText": "I do desire thee even from a heart",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0035",
          "number": 35,
          "speechLineNumber": 23,
          "text": "As full of sorrows as the sea of sands,",
          "plainText": "As full of sorrows as the sea of sands",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0036",
          "number": 36,
          "speechLineNumber": 24,
          "text": "To bear me company and go with me;",
          "plainText": "To bear me company and go with me",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0037",
          "number": 37,
          "speechLineNumber": 25,
          "text": "If not, to hide what I have said to thee,",
          "plainText": "If not to hide what I have said to thee",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0038",
          "number": 38,
          "speechLineNumber": 26,
          "text": "That I may venture to depart alone.",
          "plainText": "That I may venture to depart alone",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "eglamour",
        "name": "EGLAMOUR",
        "displayName": "Eglamour"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Madam, I pity much your grievances,",
          "plainText": "Madam I pity much your grievances",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0040",
          "number": 40,
          "speechLineNumber": 2,
          "text": "Which, since I know they virtuously are placed,",
          "plainText": "Which since I know they virtuously are placed",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0041",
          "number": 41,
          "speechLineNumber": 3,
          "text": "I give consent to go along with you,",
          "plainText": "I give consent to go along with you",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0042",
          "number": 42,
          "speechLineNumber": 4,
          "text": "Recking as little what betideth me",
          "plainText": "Recking as little what betideth me",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0043",
          "number": 43,
          "speechLineNumber": 5,
          "text": "As much I wish all good befortune you.",
          "plainText": "As much I wish all good befortune you",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0044",
          "number": 44,
          "speechLineNumber": 6,
          "text": "When will you go?",
          "plainText": "When will you go",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "silvia",
        "name": "SILVIA",
        "displayName": "Silvia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "This evening coming.",
          "plainText": "This evening coming",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "eglamour",
        "name": "EGLAMOUR",
        "displayName": "Eglamour"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Where shall I meet you?",
          "plainText": "Where shall I meet you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "silvia",
        "name": "SILVIA",
        "displayName": "Silvia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "At Friar Patrick's cell,",
          "plainText": "At Friar Patrick's cell",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "Where I intend holy confession.",
          "plainText": "Where I intend holy confession",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "eglamour",
        "name": "EGLAMOUR",
        "displayName": "Eglamour"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "I will not fail your ladyship. Good morrow, gentle lady.",
          "plainText": "I will not fail your ladyship Good morrow gentle lady",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "silvia",
        "name": "SILVIA",
        "displayName": "Silvia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-4-3-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Good morrow, kind Sir Eglamour.",
          "plainText": "Good morrow kind Sir Eglamour",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-4-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}