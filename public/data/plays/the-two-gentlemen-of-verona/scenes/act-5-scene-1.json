  "content": [
    {
      "id": "the-two-gentlemen-of-verona-5-1-stage-001",
      "type": "stage",
      "text": "Enter Eglamour."
    },
    {
      "id": "the-two-gentlemen-of-verona-5-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "eglamour",
        "name": "EGLAMOUR",
        "displayName": "Eglamour"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The sun begins to gild the western sky,",
          "plainText": "The sun begins to gild the western sky",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And now it is about the very hour",
          "plainText": "And now it is about the very hour",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "That Silvia at Friar Patrick's cell should meet me.",
          "plainText": "That Silvia at Friar Patrick's cell should meet me",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "She will not fail, for lovers break not hours,",
          "plainText": "She will not fail for lovers break not hours",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Unless it be to come before their time,",
          "plainText": "Unless it be to come before their time",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "So much they spur their expedition.",
          "plainText": "So much they spur their expedition",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-1-stage-002",
      "type": "stage",
      "text": "Enter Silvia."
    },
    {
      "id": "the-two-gentlemen-of-verona-5-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "silvia",
        "name": "SILVIA",
        "displayName": "Silvia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Amen, amen. Go on, good Eglamour,",
          "plainText": "Amen amen Go on good Eglamour",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Out at the postern by the abbey wall.",
          "plainText": "Out at the postern by the abbey wall",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "I fear I am attended by some spies.",
          "plainText": "I fear I am attended by some spies",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "eglamour",
        "name": "EGLAMOUR",
        "displayName": "Eglamour"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Fear not. The forest is not three leagues off;",
          "plainText": "Fear not The forest is not three leagues off",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-1-line-0011",
          "number": 11,
          "speechLineNumber": 2,
          "text": "If we recover that, we are sure enough.",
          "plainText": "If we recover that we are sure enough",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-1-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}