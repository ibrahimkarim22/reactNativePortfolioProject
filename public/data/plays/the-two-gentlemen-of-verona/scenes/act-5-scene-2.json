  "scene": {
    "id": "the-two-gentlemen-of-verona-5-2",
    "act": 5,
    "scene": 2,
    "label": "Act 5, Scene 2",
    "title": "SCENE II. The same. A room in the Duke's palace",
    "location": "The same. A room in the Duke's palace",
    "orderInPlay": 18
  },
  "content": [
    {
      "id": "the-two-gentlemen-of-verona-5-2-stage-001",
      "type": "stage",
      "text": "Enter Thurio, Proteus and Julia."
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Sir Proteus, what says Silvia to my suit?",
          "plainText": "Sir Proteus what says Silvia to my suit",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "O, sir, I find her milder than she was,",
          "plainText": "O sir I find her milder than she was",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "And yet she takes exceptions at your person.",
          "plainText": "And yet she takes exceptions at your person",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "What? That my leg is too long?",
          "plainText": "What That my leg is too long",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "No, that it is too little.",
          "plainText": "No that it is too little",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "I'll wear a boot to make it somewhat rounder.",
          "plainText": "I'll wear a boot to make it somewhat rounder",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "[Aside.] But love will not be spurred to what it loathes.",
          "plainText": "Aside But love will not be spurred to what it loathes",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "What says she to my face?",
          "plainText": "What says she to my face",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "She says it is a fair one.",
          "plainText": "She says it is a fair one",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Nay, then, the wanton lies; my face is black.",
          "plainText": "Nay then the wanton lies my face is black",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "But pearls are fair; and the old saying is,",
          "plainText": "But pearls are fair and the old saying is",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "\"Black men are pearls in beauteous ladies' eyes.\"",
          "plainText": "Black men are pearls in beauteous ladies' eyes",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "[Aside.] 'Tis true, such pearls as put out ladies' eyes,",
          "plainText": "Aside 'Tis true such pearls as put out ladies' eyes",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "For I had rather wink than look on them.",
          "plainText": "For I had rather wink than look on them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "How likes she my discourse?",
          "plainText": "How likes she my discourse",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Ill, when you talk of war.",
          "plainText": "Ill when you talk of war",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "But well when I discourse of love and peace.",
          "plainText": "But well when I discourse of love and peace",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "[Aside.] But better, indeed, when you hold your peace.",
          "plainText": "Aside But better indeed when you hold your peace",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "What says she to my valour?",
          "plainText": "What says she to my valour",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "O, sir, she makes no doubt of that.",
          "plainText": "O sir she makes no doubt of that",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "[Aside.] She needs not, when she knows it cowardice.",
          "plainText": "Aside She needs not when she knows it cowardice",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "What says she to my birth?",
          "plainText": "What says she to my birth",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "That you are well derived.",
          "plainText": "That you are well derived",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "[Aside.] True, from a gentleman to a fool.",
          "plainText": "Aside True from a gentleman to a fool",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Considers she my possessions?",
          "plainText": "Considers she my possessions",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "O, ay, and pities them.",
          "plainText": "O ay and pities them",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Wherefore?",
          "plainText": "Wherefore",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "[Aside.] That such an ass should owe them.",
          "plainText": "Aside That such an ass should owe them",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "That they are out by lease.",
          "plainText": "That they are out by lease",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Here comes the Duke.",
          "plainText": "Here comes the Duke",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-stage-002",
      "type": "stage",
      "text": "Enter Duke."
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "How now, Sir Proteus! How now, Thurio!",
          "plainText": "How now Sir Proteus How now Thurio",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Which of you saw Sir Eglamour of late?",
          "plainText": "Which of you saw Sir Eglamour of late",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Not I.",
          "plainText": "Not I",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Nor I.",
          "plainText": "Nor I",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Saw you my daughter?",
          "plainText": "Saw you my daughter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Neither.",
          "plainText": "Neither",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-033",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Why then, she's fled unto that peasant Valentine,",
          "plainText": "Why then she's fled unto that peasant Valentine",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "And Eglamour is in her company.",
          "plainText": "And Eglamour is in her company",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "'Tis true, for Friar Lawrence met them both",
          "plainText": "'Tis true for Friar Lawrence met them both",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "As he in penance wandered through the forest;",
          "plainText": "As he in penance wandered through the forest",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0041",
          "number": 41,
          "speechLineNumber": 5,
          "text": "Him he knew well, and guessed that it was she,",
          "plainText": "Him he knew well and guessed that it was she",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0042",
          "number": 42,
          "speechLineNumber": 6,
          "text": "But, being masked, he was not sure of it.",
          "plainText": "But being masked he was not sure of it",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0043",
          "number": 43,
          "speechLineNumber": 7,
          "text": "Besides, she did intend confession",
          "plainText": "Besides she did intend confession",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0044",
          "number": 44,
          "speechLineNumber": 8,
          "text": "At Patrick's cell this even, and there she was not.",
          "plainText": "At Patrick's cell this even and there she was not",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0045",
          "number": 45,
          "speechLineNumber": 9,
          "text": "These likelihoods confirm her flight from hence.",
          "plainText": "These likelihoods confirm her flight from hence",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0046",
          "number": 46,
          "speechLineNumber": 10,
          "text": "Therefore, I pray you, stand not to discourse,",
          "plainText": "Therefore I pray you stand not to discourse",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0047",
          "number": 47,
          "speechLineNumber": 11,
          "text": "But mount you presently and meet with me",
          "plainText": "But mount you presently and meet with me",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0048",
          "number": 48,
          "speechLineNumber": 12,
          "text": "Upon the rising of the mountain foot",
          "plainText": "Upon the rising of the mountain foot",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0049",
          "number": 49,
          "speechLineNumber": 13,
          "text": "That leads toward Mantua, whither they are fled.",
          "plainText": "That leads toward Mantua whither they are fled",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0050",
          "number": 50,
          "speechLineNumber": 14,
          "text": "Dispatch, sweet gentlemen, and follow me.",
          "plainText": "Dispatch sweet gentlemen and follow me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-stage-003",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-034",
      "type": "speech",
      "speaker": {
        "id": "thurio",
        "name": "THURIO",
        "displayName": "Thurio"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Why, this it is to be a peevish girl",
          "plainText": "Why this it is to be a peevish girl",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0052",
          "number": 52,
          "speechLineNumber": 2,
          "text": "That flies her fortune when it follows her.",
          "plainText": "That flies her fortune when it follows her",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0053",
          "number": 53,
          "speechLineNumber": 3,
          "text": "I'll after, more to be revenged on Eglamour",
          "plainText": "I'll after more to be revenged on Eglamour",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0054",
          "number": 54,
          "speechLineNumber": 4,
          "text": "Than for the love of reckless Silvia.",
          "plainText": "Than for the love of reckless Silvia",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-stage-004",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-035",
      "type": "speech",
      "speaker": {
        "id": "proteus",
        "name": "PROTEUS",
        "displayName": "Proteus"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "And I will follow, more for Silvia's love",
          "plainText": "And I will follow more for Silvia's love",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "Than hate of Eglamour that goes with her.",
          "plainText": "Than hate of Eglamour that goes with her",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-stage-005",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-speech-036",
      "type": "speech",
      "speaker": {
        "id": "julia",
        "name": "JULIA",
        "displayName": "Julia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "And I will follow, more to cross that love",
          "plainText": "And I will follow more to cross that love",
          "lineType": "verse"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-2-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "Than hate for Silvia, that is gone for love.",
          "plainText": "Than hate for Silvia that is gone for love",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-2-stage-006",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
