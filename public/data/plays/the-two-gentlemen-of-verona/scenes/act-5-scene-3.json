  "content": [
    {
      "id": "the-two-gentlemen-of-verona-5-3-stage-001",
      "type": "stage",
      "text": "Enter Silvia and Outlaws."
    },
    {
      "id": "the-two-gentlemen-of-verona-5-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Come, come, be patient. We must bring you to our captain.",
          "plainText": "Come come be patient We must bring you to our captain",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "silvia",
        "name": "SILVIA",
        "displayName": "Silvia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "A thousand more mischances than this one",
          "plainText": "A thousand more mischances than this one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "Have learned me how to brook this patiently.",
          "plainText": "Have learned me how to brook this patiently",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Come, bring her away.",
          "plainText": "Come bring her away",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Where is the gentleman that was with her?",
          "plainText": "Where is the gentleman that was with her",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "second-outlaw",
        "name": "SECOND OUTLAW",
        "displayName": "Second Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Being nimble-footed, he hath outrun us.",
          "plainText": "Being nimblefooted he hath outrun us",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "But Moyses and Valerius follow him.",
          "plainText": "But Moyses and Valerius follow him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "Go thou with her to the west end of the wood;",
          "plainText": "Go thou with her to the west end of the wood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "There is our captain. We'll follow him that's fled.",
          "plainText": "There is our captain We'll follow him that's fled",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "The thicket is beset; he cannot 'scape.",
          "plainText": "The thicket is beset he cannot 'scape",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-3-stage-002",
      "type": "stage",
      "text": "[Exeunt Second and Third Outlaws.]"
    },
    {
      "id": "the-two-gentlemen-of-verona-5-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "first-outlaw",
        "name": "FIRST OUTLAW",
        "displayName": "First Outlaw"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Come, I must bring you to our captain's cave.",
          "plainText": "Come I must bring you to our captain's cave",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Fear not; he bears an honourable mind",
          "plainText": "Fear not he bears an honourable mind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "And will not use a woman lawlessly.",
          "plainText": "And will not use a woman lawlessly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "silvia",
        "name": "SILVIA",
        "displayName": "Silvia"
      },
      "lines": [
        {
          "id": "the-two-gentlemen-of-verona-5-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "O Valentine, this I endure for thee!",
          "plainText": "O Valentine this I endure for thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-gentlemen-of-verona-5-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
