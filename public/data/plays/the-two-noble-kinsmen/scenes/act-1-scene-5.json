  "content": [
    {
      "id": "the-two-noble-kinsmen-1-5-stage-001",
      "type": "stage",
      "text": "Music. Enter the Queens with the hearses of their knights, in a funeral solemnity, &c."
    },
    {
      "id": "the-two-noble-kinsmen-1-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "third-queen",
        "name": "THIRD QUEEN",
        "displayName": "Third Queen"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-1-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "This funeral path brings to your household's grave.",
          "plainText": "This funeral path brings to your household's grave",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-1-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Joy seize on you again; peace sleep with him.",
          "plainText": "Joy seize on you again peace sleep with him",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-1-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "second-queen",
        "name": "SECOND QUEEN",
        "displayName": "Second Queen"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-1-5-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "And this to yours.",
          "plainText": "And this to yours",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-1-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "first-queen",
        "name": "FIRST QUEEN",
        "displayName": "First Queen"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-1-5-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Yours this way. Heavens lend",
          "plainText": "Yours this way Heavens lend",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-1-5-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "A thousand differing ways to one sure end.",
          "plainText": "A thousand differing ways to one sure end",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-1-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "third-queen",
        "name": "THIRD QUEEN",
        "displayName": "Third Queen"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-1-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "This world's a city full of straying streets,",
          "plainText": "This world's a city full of straying streets",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-1-5-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "And death's the market-place where each one meets.",
          "plainText": "And death's the marketplace where each one meets",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-1-5-stage-002",
      "type": "stage",
      "text": "[Exeunt severally.]"
    }
  ]
}