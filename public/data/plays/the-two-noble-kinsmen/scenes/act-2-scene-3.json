  "scene": {
    "id": "the-two-noble-kinsmen-2-3",
    "act": 2,
    "scene": 3,
    "label": "Act 2, Scene 3",
    "title": "SCENE III. The country near Athens",
    "location": "The country near Athens",
    "orderInPlay": 8
  },
  "content": [
    {
      "id": "the-two-noble-kinsmen-2-3-stage-001",
      "type": "stage",
      "text": "Enter Arcite."
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Banished the kingdom? 'Tis a benefit,",
          "plainText": "Banished the kingdom 'Tis a benefit",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "A mercy I must thank 'em for; but banished",
          "plainText": "A mercy I must thank 'em for but banished",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "The free enjoying of that face I die for,",
          "plainText": "The free enjoying of that face I die for",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "O, 'twas a studied punishment, a death",
          "plainText": "O 'twas a studied punishment a death",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Beyond imagination, such a vengeance",
          "plainText": "Beyond imagination such a vengeance",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "That, were I old and wicked, all my sins",
          "plainText": "That were I old and wicked all my sins",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Could never pluck upon me. Palamon,",
          "plainText": "Could never pluck upon me Palamon",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Thou hast the start now; thou shalt stay and see",
          "plainText": "Thou hast the start now thou shalt stay and see",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Her bright eyes break each morning 'gainst thy window",
          "plainText": "Her bright eyes break each morning 'gainst thy window",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "And let in life into thee; thou shalt feed",
          "plainText": "And let in life into thee thou shalt feed",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Upon the sweetness of a noble beauty",
          "plainText": "Upon the sweetness of a noble beauty",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "That nature ne'er exceeded nor ne'er shall.",
          "plainText": "That nature ne'er exceeded nor ne'er shall",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "Good gods, what happiness has Palamon!",
          "plainText": "Good gods what happiness has Palamon",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Twenty to one, he'll come to speak to her;",
          "plainText": "Twenty to one he'll come to speak to her",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "And if she be as gentle as she's fair,",
          "plainText": "And if she be as gentle as she's fair",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "I know she's his; he has a tongue will tame",
          "plainText": "I know she's his he has a tongue will tame",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "Tempests and make the wild rocks wanton.",
          "plainText": "Tempests and make the wild rocks wanton",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Come what can come,",
          "plainText": "Come what can come",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "The worst is death; I will not leave the kingdom.",
          "plainText": "The worst is death I will not leave the kingdom",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "I know mine own is but a heap of ruins,",
          "plainText": "I know mine own is but a heap of ruins",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "And no redress there. If I go, he has her.",
          "plainText": "And no redress there If I go he has her",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "I am resolved another shape shall make me",
          "plainText": "I am resolved another shape shall make me",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "Or end my fortunes. Either way I am happy.",
          "plainText": "Or end my fortunes Either way I am happy",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "I'll see her and be near her, or no more.",
          "plainText": "I'll see her and be near her or no more",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-stage-002",
      "type": "stage",
      "text": "Enter four Countrymen, and one with a garland before them."
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "first-countryman",
        "name": "FIRST COUNTRYMAN",
        "displayName": "First Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "My masters, I'll be there, that's certain.",
          "plainText": "My masters I'll be there that's certain",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "second-countryman",
        "name": "SECOND COUNTRYMAN",
        "displayName": "Second Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "And I'll be there.",
          "plainText": "And I'll be there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "third-countryman",
        "name": "THIRD COUNTRYMAN",
        "displayName": "Third Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "And I.",
          "plainText": "And I",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "fourth-countryman",
        "name": "FOURTH COUNTRYMAN",
        "displayName": "Fourth Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Why, then, have with you, boys. 'Tis but a chiding.",
          "plainText": "Why then have with you boys 'Tis but a chiding",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "Let the plough play today; I'll tickle 't out",
          "plainText": "Let the plough play today I'll tickle 't out",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "Of the jades' tails tomorrow.",
          "plainText": "Of the jades' tails tomorrow",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "first-countryman",
        "name": "FIRST COUNTRYMAN",
        "displayName": "First Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "I am sure",
          "plainText": "I am sure",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "To have my wife as jealous as a turkey,",
          "plainText": "To have my wife as jealous as a turkey",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "But that's all one. I'll go through; let her mumble.",
          "plainText": "But that's all one I'll go through let her mumble",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "second-countryman",
        "name": "SECOND COUNTRYMAN",
        "displayName": "Second Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Clap her aboard tomorrow night, and stow her,",
          "plainText": "Clap her aboard tomorrow night and stow her",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "And all's made up again.",
          "plainText": "And all's made up again",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "third-countryman",
        "name": "THIRD COUNTRYMAN",
        "displayName": "Third Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Ay, do but put",
          "plainText": "Ay do but put",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0037",
          "number": 37,
          "speechLineNumber": 2,
          "text": "A fescue in her fist and you shall see her",
          "plainText": "A fescue in her fist and you shall see her",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0038",
          "number": 38,
          "speechLineNumber": 3,
          "text": "Take a new lesson out and be a good wench.",
          "plainText": "Take a new lesson out and be a good wench",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0039",
          "number": 39,
          "speechLineNumber": 4,
          "text": "Do we all hold against the Maying?",
          "plainText": "Do we all hold against the Maying",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "fourth-countryman",
        "name": "FOURTH COUNTRYMAN",
        "displayName": "Fourth Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Hold?",
          "plainText": "Hold",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0041",
          "number": 41,
          "speechLineNumber": 2,
          "text": "What should ail us?",
          "plainText": "What should ail us",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "third-countryman",
        "name": "THIRD COUNTRYMAN",
        "displayName": "Third Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Arcas will be there.",
          "plainText": "Arcas will be there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "second-countryman",
        "name": "SECOND COUNTRYMAN",
        "displayName": "Second Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "And Sennois.",
          "plainText": "And Sennois",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "And Rycas; and three better lads ne'er danced",
          "plainText": "And Rycas and three better lads ne'er danced",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Under green tree. And ye know what wenches, ha?",
          "plainText": "Under green tree And ye know what wenches ha",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "But will the dainty domine, the schoolmaster,",
          "plainText": "But will the dainty domine the schoolmaster",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0047",
          "number": 47,
          "speechLineNumber": 5,
          "text": "Keep touch, do you think? For he does all, ye know.",
          "plainText": "Keep touch do you think For he does all ye know",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "third-countryman",
        "name": "THIRD COUNTRYMAN",
        "displayName": "Third Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "He'll eat a hornbook ere he fail. Go to;",
          "plainText": "He'll eat a hornbook ere he fail Go to",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0049",
          "number": 49,
          "speechLineNumber": 2,
          "text": "The matter's too far driven between him",
          "plainText": "The matter's too far driven between him",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0050",
          "number": 50,
          "speechLineNumber": 3,
          "text": "And the tanner's daughter to let slip now;",
          "plainText": "And the tanner's daughter to let slip now",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0051",
          "number": 51,
          "speechLineNumber": 4,
          "text": "And she must see the Duke, and she must dance too.",
          "plainText": "And she must see the Duke and she must dance too",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "fourth-countryman",
        "name": "FOURTH COUNTRYMAN",
        "displayName": "Fourth Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Shall we be lusty?",
          "plainText": "Shall we be lusty",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "second-countryman",
        "name": "SECOND COUNTRYMAN",
        "displayName": "Second Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "All the boys in Athens",
          "plainText": "All the boys in Athens",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "Blow wind i' th' breech on 's. And here I'll be,",
          "plainText": "Blow wind i' th' breech on 's And here I'll be",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0055",
          "number": 55,
          "speechLineNumber": 3,
          "text": "And there I'll be, for our town, and here again,",
          "plainText": "And there I'll be for our town and here again",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0056",
          "number": 56,
          "speechLineNumber": 4,
          "text": "And there again. Ha, boys, hey for the weavers!",
          "plainText": "And there again Ha boys hey for the weavers",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "first-countryman",
        "name": "FIRST COUNTRYMAN",
        "displayName": "First Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "This must be done i' th' woods.",
          "plainText": "This must be done i' th' woods",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "fourth-countryman",
        "name": "FOURTH COUNTRYMAN",
        "displayName": "Fourth Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "O, pardon me.",
          "plainText": "O pardon me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "second-countryman",
        "name": "SECOND COUNTRYMAN",
        "displayName": "Second Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "By any means; our thing of learning says so—",
          "plainText": "By any means our thing of learning says so",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "Where he himself will edify the Duke",
          "plainText": "Where he himself will edify the Duke",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "Most parlously in our behalfs. He's excellent i' th' woods;",
          "plainText": "Most parlously in our behalfs He's excellent i' th' woods",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0062",
          "number": 62,
          "speechLineNumber": 4,
          "text": "Bring him to th' plains, his learning makes no cry.",
          "plainText": "Bring him to th' plains his learning makes no cry",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "third-countryman",
        "name": "THIRD COUNTRYMAN",
        "displayName": "Third Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "We'll see the sports, then every man to 's tackle;",
          "plainText": "We'll see the sports then every man to 's tackle",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "And, sweet companions, let's rehearse, by any means,",
          "plainText": "And sweet companions let's rehearse by any means",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "Before the ladies see us, and do sweetly,",
          "plainText": "Before the ladies see us and do sweetly",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "And God knows what may come on 't.",
          "plainText": "And God knows what may come on 't",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "fourth-countryman",
        "name": "FOURTH COUNTRYMAN",
        "displayName": "Fourth Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Content; the sports once ended, we'll perform.",
          "plainText": "Content the sports once ended we'll perform",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0068",
          "number": 68,
          "speechLineNumber": 2,
          "text": "Away, boys, and hold.",
          "plainText": "Away boys and hold",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "By your leaves, honest friends: pray you, whither go you?",
          "plainText": "By your leaves honest friends pray you whither go you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "fourth-countryman",
        "name": "FOURTH COUNTRYMAN",
        "displayName": "Fourth Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Whither? Why, what a question's that?",
          "plainText": "Whither Why what a question's that",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "Yes, 'tis a question",
          "plainText": "Yes 'tis a question",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0072",
          "number": 72,
          "speechLineNumber": 2,
          "text": "To me that know not.",
          "plainText": "To me that know not",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "third-countryman",
        "name": "THIRD COUNTRYMAN",
        "displayName": "Third Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "To the games, my friend.",
          "plainText": "To the games my friend",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "second-countryman",
        "name": "SECOND COUNTRYMAN",
        "displayName": "Second Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Where were you bred, you know it not?",
          "plainText": "Where were you bred you know it not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Not far, sir;",
          "plainText": "Not far sir",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0076",
          "number": 76,
          "speechLineNumber": 2,
          "text": "Are there such games today?",
          "plainText": "Are there such games today",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "first-countryman",
        "name": "FIRST COUNTRYMAN",
        "displayName": "First Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Yes, marry, are there,",
          "plainText": "Yes marry are there",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "And such as you never saw; the Duke himself",
          "plainText": "And such as you never saw the Duke himself",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0079",
          "number": 79,
          "speechLineNumber": 3,
          "text": "Will be in person there.",
          "plainText": "Will be in person there",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "What pastimes are they?",
          "plainText": "What pastimes are they",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "second-countryman",
        "name": "SECOND COUNTRYMAN",
        "displayName": "Second Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "Wrestling, and running.—'Tis a pretty fellow.",
          "plainText": "Wrestling and running'Tis a pretty fellow",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "third-countryman",
        "name": "THIRD COUNTRYMAN",
        "displayName": "Third Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "Thou wilt not go along?",
          "plainText": "Thou wilt not go along",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "Not yet, sir.",
          "plainText": "Not yet sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-031",
      "type": "speech",
      "speaker": {
        "id": "fourth-countryman",
        "name": "FOURTH COUNTRYMAN",
        "displayName": "Fourth Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0084",
          "number": 84,
          "speechLineNumber": 1,
          "text": "Well, sir,",
          "plainText": "Well sir",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0085",
          "number": 85,
          "speechLineNumber": 2,
          "text": "Take your own time. Come, boys.",
          "plainText": "Take your own time Come boys",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-032",
      "type": "speech",
      "speaker": {
        "id": "first-countryman",
        "name": "FIRST COUNTRYMAN",
        "displayName": "First Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "My mind misgives me,",
          "plainText": "My mind misgives me",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0087",
          "number": 87,
          "speechLineNumber": 2,
          "text": "This fellow has a vengeance trick o' th' hip;",
          "plainText": "This fellow has a vengeance trick o' th' hip",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0088",
          "number": 88,
          "speechLineNumber": 3,
          "text": "Mark how his body's made for 't.",
          "plainText": "Mark how his body's made for 't",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-033",
      "type": "speech",
      "speaker": {
        "id": "second-countryman",
        "name": "SECOND COUNTRYMAN",
        "displayName": "Second Countryman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "I'll be hanged, though,",
          "plainText": "I'll be hanged though",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0090",
          "number": 90,
          "speechLineNumber": 2,
          "text": "If he dare venture. Hang him, plum porridge!",
          "plainText": "If he dare venture Hang him plum porridge",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0091",
          "number": 91,
          "speechLineNumber": 3,
          "text": "He wrestle? He roast eggs! Come, let's be gone, lads.",
          "plainText": "He wrestle He roast eggs Come let's be gone lads",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-stage-003",
      "type": "stage",
      "text": "[Exeunt Countrymen.]"
    },
    {
      "id": "the-two-noble-kinsmen-2-3-speech-034",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-3-line-0092",
          "number": 92,
          "speechLineNumber": 1,
          "text": "This is an offered opportunity",
          "plainText": "This is an offered opportunity",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0093",
          "number": 93,
          "speechLineNumber": 2,
          "text": "I durst not wish for. Well I could have wrestled—",
          "plainText": "I durst not wish for Well I could have wrestled",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0094",
          "number": 94,
          "speechLineNumber": 3,
          "text": "The best men called it excellent—and run",
          "plainText": "The best men called it excellentand run",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0095",
          "number": 95,
          "speechLineNumber": 4,
          "text": "Swifter than wind upon a field of corn,",
          "plainText": "Swifter than wind upon a field of corn",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0096",
          "number": 96,
          "speechLineNumber": 5,
          "text": "Curling the wealthy ears, never flew. I'll venture,",
          "plainText": "Curling the wealthy ears never flew I'll venture",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0097",
          "number": 97,
          "speechLineNumber": 6,
          "text": "And in some poor disguise be there. Who knows",
          "plainText": "And in some poor disguise be there Who knows",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0098",
          "number": 98,
          "speechLineNumber": 7,
          "text": "Whether my brows may not be girt with garlands,",
          "plainText": "Whether my brows may not be girt with garlands",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0099",
          "number": 99,
          "speechLineNumber": 8,
          "text": "And happiness prefer me to a place",
          "plainText": "And happiness prefer me to a place",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-2-3-line-0100",
          "number": 100,
          "speechLineNumber": 9,
          "text": "Where I may ever dwell in sight of her?",
          "plainText": "Where I may ever dwell in sight of her",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-3-stage-004",
      "type": "stage",
      "text": "[Exit Arcite.]"
    }
  ]
}