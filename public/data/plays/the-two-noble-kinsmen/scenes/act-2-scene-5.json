  },
  "content": [
    {
      "id": "the-two-noble-kinsmen-2-5-stage-001",
      "type": "stage",
      "text": "A short flourish of cornets and shouts within. Enter Theseus, Hippolyta, Pirithous, Emilia; Arcite in disguise as a countryman, with a garland, Attendants, and others."
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "You have done worthily. I have not seen,",
          "plainText": "You have done worthily I have not seen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Since Hercules, a man of tougher sinews.",
          "plainText": "Since Hercules a man of tougher sinews",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Whate'er you are, you run the best and wrestle,",
          "plainText": "Whate'er you are you run the best and wrestle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "That these times can allow.",
          "plainText": "That these times can allow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "I am proud to please you.",
          "plainText": "I am proud to please you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "What country bred you?",
          "plainText": "What country bred you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "This; but far off, Prince.",
          "plainText": "This but far off Prince",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Are you a gentleman?",
          "plainText": "Are you a gentleman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "My father said so;",
          "plainText": "My father said so",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "And to those gentle uses gave me life.",
          "plainText": "And to those gentle uses gave me life",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Are you his heir?",
          "plainText": "Are you his heir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "His youngest, sir.",
          "plainText": "His youngest sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Your father",
          "plainText": "Your father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0014",
          "number": 14,
          "speechLineNumber": 2,
          "text": "Sure is a happy sire then. What profess you?",
          "plainText": "Sure is a happy sire then What profess you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-010",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "A little of all noble qualities.",
          "plainText": "A little of all noble qualities",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "I could have kept a hawk and well have hallowed",
          "plainText": "I could have kept a hawk and well have hallowed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0017",
          "number": 17,
          "speechLineNumber": 3,
          "text": "To a deep cry of dogs. I dare not praise",
          "plainText": "To a deep cry of dogs I dare not praise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0018",
          "number": 18,
          "speechLineNumber": 4,
          "text": "My feat in horsemanship, yet they that knew me",
          "plainText": "My feat in horsemanship yet they that knew me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0019",
          "number": 19,
          "speechLineNumber": 5,
          "text": "Would say it was my best piece; last, and greatest,",
          "plainText": "Would say it was my best piece last and greatest",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0020",
          "number": 20,
          "speechLineNumber": 6,
          "text": "I would be thought a soldier.",
          "plainText": "I would be thought a soldier",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-011",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "You are perfect.",
          "plainText": "You are perfect",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-012",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Upon my soul, a proper man.",
          "plainText": "Upon my soul a proper man",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-013",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "He is so.",
          "plainText": "He is so",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-014",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "How do you like him, lady?",
          "plainText": "How do you like him lady",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-015",
      "type": "speech",
      "speaker": {
        "id": "hippolyta",
        "name": "HIPPOLYTA",
        "displayName": "Hippolyta"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "I admire him.",
          "plainText": "I admire him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "I have not seen so young a man so noble,",
          "plainText": "I have not seen so young a man so noble",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "If he say true, of his sort.",
          "plainText": "If he say true of his sort",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-016",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Believe,",
          "plainText": "Believe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "His mother was a wondrous handsome woman;",
          "plainText": "His mother was a wondrous handsome woman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0030",
          "number": 30,
          "speechLineNumber": 3,
          "text": "His face, methinks, goes that way.",
          "plainText": "His face methinks goes that way",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-017",
      "type": "speech",
      "speaker": {
        "id": "hippolyta",
        "name": "HIPPOLYTA",
        "displayName": "Hippolyta"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "But his body",
          "plainText": "But his body",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "And fiery mind illustrate a brave father.",
          "plainText": "And fiery mind illustrate a brave father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-018",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Mark how his virtue, like a hidden sun,",
          "plainText": "Mark how his virtue like a hidden sun",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0034",
          "number": 34,
          "speechLineNumber": 2,
          "text": "Breaks through his baser garments.",
          "plainText": "Breaks through his baser garments",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-019",
      "type": "speech",
      "speaker": {
        "id": "hippolyta",
        "name": "HIPPOLYTA",
        "displayName": "Hippolyta"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "He's well got, sure.",
          "plainText": "He's well got sure",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-020",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "What made you seek this place, sir?",
          "plainText": "What made you seek this place sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-021",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Noble Theseus,",
          "plainText": "Noble Theseus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0038",
          "number": 38,
          "speechLineNumber": 2,
          "text": "To purchase name and do my ablest service",
          "plainText": "To purchase name and do my ablest service",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0039",
          "number": 39,
          "speechLineNumber": 3,
          "text": "To such a well-found wonder as thy worth;",
          "plainText": "To such a wellfound wonder as thy worth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0040",
          "number": 40,
          "speechLineNumber": 4,
          "text": "For only in thy court, of all the world,",
          "plainText": "For only in thy court of all the world",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0041",
          "number": 41,
          "speechLineNumber": 5,
          "text": "Dwells fair-eyed Honour.",
          "plainText": "Dwells faireyed Honour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-022",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "All his words are worthy.",
          "plainText": "All his words are worthy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-023",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Sir, we are much indebted to your travel,",
          "plainText": "Sir we are much indebted to your travel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "Nor shall you lose your wish.—Pirithous,",
          "plainText": "Nor shall you lose your wishPirithous",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "Dispose of this fair gentleman.",
          "plainText": "Dispose of this fair gentleman",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-024",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Thanks, Theseus.",
          "plainText": "Thanks Theseus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0047",
          "number": 47,
          "speechLineNumber": 2,
          "text": "Whate'er you are, you're mine, and I shall give you",
          "plainText": "Whate'er you are you're mine and I shall give you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0048",
          "number": 48,
          "speechLineNumber": 3,
          "text": "To a most noble service: to this lady,",
          "plainText": "To a most noble service to this lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0049",
          "number": 49,
          "speechLineNumber": 4,
          "text": "This bright young virgin; pray, observe her goodness.",
          "plainText": "This bright young virgin pray observe her goodness",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0050",
          "number": 50,
          "speechLineNumber": 5,
          "text": "You have honoured her fair birthday with your virtues,",
          "plainText": "You have honoured her fair birthday with your virtues",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0051",
          "number": 51,
          "speechLineNumber": 6,
          "text": "And, as your due, you're hers; kiss her fair hand, sir.",
          "plainText": "And as your due you're hers kiss her fair hand sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-025",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Sir, you're a noble giver.—Dearest beauty,",
          "plainText": "Sir you're a noble giverDearest beauty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Thus let me seal my vowed faith.",
          "plainText": "Thus let me seal my vowed faith",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-stage-002",
      "type": "stage",
      "text": "[He kisses her hand.]"
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-026",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "That were too cruel.",
          "plainText": "That were too cruel",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0055",
          "number": 55,
          "speechLineNumber": 2,
          "text": "If you deserve well, sir, I shall soon see 't.",
          "plainText": "If you deserve well sir I shall soon see 't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0056",
          "number": 56,
          "speechLineNumber": 3,
          "text": "You're mine, and somewhat better than your rank",
          "plainText": "You're mine and somewhat better than your rank",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0057",
          "number": 57,
          "speechLineNumber": 4,
          "text": "I'll use you.",
          "plainText": "I'll use you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-027",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "I'll see you furnished, and because you say",
          "plainText": "I'll see you furnished and because you say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0059",
          "number": 59,
          "speechLineNumber": 2,
          "text": "You are a horseman, I must needs entreat you",
          "plainText": "You are a horseman I must needs entreat you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0060",
          "number": 60,
          "speechLineNumber": 3,
          "text": "This afternoon to ride, but 'tis a rough one.",
          "plainText": "This afternoon to ride but 'tis a rough one",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-028",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "I like him better, Prince; I shall not then",
          "plainText": "I like him better Prince I shall not then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "Freeze in my saddle.",
          "plainText": "Freeze in my saddle",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-029",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Sweet, you must be ready,—",
          "plainText": "Sweet you must be ready",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0064",
          "number": 64,
          "speechLineNumber": 2,
          "text": "And you, Emilia,—and you, friend,—and all,",
          "plainText": "And you Emiliaand you friendand all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0065",
          "number": 65,
          "speechLineNumber": 3,
          "text": "Tomorrow by the sun, to do observance",
          "plainText": "Tomorrow by the sun to do observance",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0066",
          "number": 66,
          "speechLineNumber": 4,
          "text": "To flowery May, in Dian's wood.—Wait well, sir,",
          "plainText": "To flowery May in Dian's woodWait well sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0067",
          "number": 67,
          "speechLineNumber": 5,
          "text": "Upon your mistress.—Emily, I hope",
          "plainText": "Upon your mistressEmily I hope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0068",
          "number": 68,
          "speechLineNumber": 6,
          "text": "He shall not go afoot.",
          "plainText": "He shall not go afoot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-030",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "That were a shame, sir,",
          "plainText": "That were a shame sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "While I have horses.—Take your choice, and what",
          "plainText": "While I have horsesTake your choice and what",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0071",
          "number": 71,
          "speechLineNumber": 3,
          "text": "You want at any time, let me but know it.",
          "plainText": "You want at any time let me but know it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0072",
          "number": 72,
          "speechLineNumber": 4,
          "text": "If you serve faithfully, I dare assure you",
          "plainText": "If you serve faithfully I dare assure you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0073",
          "number": 73,
          "speechLineNumber": 5,
          "text": "You'll find a loving mistress.",
          "plainText": "You'll find a loving mistress",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-031",
      "type": "speech",
      "speaker": {
        "id": "arcite",
        "name": "ARCITE",
        "displayName": "Arcite"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "If I do not,",
          "plainText": "If I do not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0075",
          "number": 75,
          "speechLineNumber": 2,
          "text": "Let me find that my father ever hated,",
          "plainText": "Let me find that my father ever hated",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0076",
          "number": 76,
          "speechLineNumber": 3,
          "text": "Disgrace and blows.",
          "plainText": "Disgrace and blows",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-032",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Go lead the way; you have won it.",
          "plainText": "Go lead the way you have won it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "It shall be so; you shall receive all dues",
          "plainText": "It shall be so you shall receive all dues",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0079",
          "number": 79,
          "speechLineNumber": 3,
          "text": "Fit for the honour you have won; 'twere wrong else.",
          "plainText": "Fit for the honour you have won 'twere wrong else",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0080",
          "number": 80,
          "speechLineNumber": 4,
          "text": "Sister, beshrew my heart, you have a servant,",
          "plainText": "Sister beshrew my heart you have a servant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0081",
          "number": 81,
          "speechLineNumber": 5,
          "text": "That, if I were a woman, would be master.",
          "plainText": "That if I were a woman would be master",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-5-line-0082",
          "number": 82,
          "speechLineNumber": 6,
          "text": "But you are wise.",
          "plainText": "But you are wise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-speech-033",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-5-line-0083",
          "number": 83,
          "speechLineNumber": 1,
          "text": "I hope too wise for that, sir.",
          "plainText": "I hope too wise for that sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-5-stage-003",
      "type": "stage",
      "text": "[Flourish. Exeunt.]"
    }
  ]
}