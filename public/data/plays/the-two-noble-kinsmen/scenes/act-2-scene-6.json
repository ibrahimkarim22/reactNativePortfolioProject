  "scene": {
    "id": "the-two-noble-kinsmen-2-6",
    "act": 2,
    "scene": 6,
    "label": "Act 2, Scene 6",
    "title": "SCENE VI. Athens. Before the prison",
    "location": "Athens. Before the prison",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "the-two-noble-kinsmen-2-6-stage-001",
      "type": "stage",
      "text": "Enter Jailer's Daughter alone."
    },
    {
      "id": "the-two-noble-kinsmen-2-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "daughter",
        "name": "DAUGHTER",
        "displayName": "Daughter"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-2-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Let all the dukes and all the devils roar,",
          "plainText": "Let all the dukes and all the devils roar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "He is at liberty! I have ventured for him",
          "plainText": "He is at liberty I have ventured for him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And out I have brought him; to a little wood",
          "plainText": "And out I have brought him to a little wood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "A mile hence I have sent him, where a cedar",
          "plainText": "A mile hence I have sent him where a cedar",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Higher than all the rest spreads like a plane",
          "plainText": "Higher than all the rest spreads like a plane",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Fast by a brook, and there he shall keep close",
          "plainText": "Fast by a brook and there he shall keep close",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Till I provide him files and food, for yet",
          "plainText": "Till I provide him files and food for yet",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "His iron bracelets are not off. O Love,",
          "plainText": "His iron bracelets are not off O Love",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "What a stout-hearted child thou art! My father",
          "plainText": "What a stouthearted child thou art My father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "Durst better have endured cold iron than done it.",
          "plainText": "Durst better have endured cold iron than done it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "I love him beyond love and beyond reason,",
          "plainText": "I love him beyond love and beyond reason",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "Or wit, or safety. I have made him know it;",
          "plainText": "Or wit or safety I have made him know it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "I care not, I am desperate. If the law",
          "plainText": "I care not I am desperate If the law",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Find me and then condemn me for 't, some wenches,",
          "plainText": "Find me and then condemn me for 't some wenches",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "Some honest-hearted maids, will sing my dirge",
          "plainText": "Some honesthearted maids will sing my dirge",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "And tell to memory my death was noble,",
          "plainText": "And tell to memory my death was noble",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "Dying almost a martyr. That way he takes,",
          "plainText": "Dying almost a martyr That way he takes",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "I purpose is my way too. Sure he cannot",
          "plainText": "I purpose is my way too Sure he cannot",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "Be so unmanly as to leave me here.",
          "plainText": "Be so unmanly as to leave me here",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "If he do, maids will not so easily",
          "plainText": "If he do maids will not so easily",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "Trust men again. And yet he has not thanked me",
          "plainText": "Trust men again And yet he has not thanked me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "For what I have done; no, not so much as kissed me,",
          "plainText": "For what I have done no not so much as kissed me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "And that, methinks, is not so well; nor scarcely",
          "plainText": "And that methinks is not so well nor scarcely",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "Could I persuade him to become a free man,",
          "plainText": "Could I persuade him to become a free man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0025",
          "number": 25,
          "speechLineNumber": 25,
          "text": "He made such scruples of the wrong he did",
          "plainText": "He made such scruples of the wrong he did",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0026",
          "number": 26,
          "speechLineNumber": 26,
          "text": "To me and to my father. Yet I hope,",
          "plainText": "To me and to my father Yet I hope",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0027",
          "number": 27,
          "speechLineNumber": 27,
          "text": "When he considers more, this love of mine",
          "plainText": "When he considers more this love of mine",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0028",
          "number": 28,
          "speechLineNumber": 28,
          "text": "Will take more root within him. Let him do",
          "plainText": "Will take more root within him Let him do",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0029",
          "number": 29,
          "speechLineNumber": 29,
          "text": "What he will with me, so he use me kindly;",
          "plainText": "What he will with me so he use me kindly",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0030",
          "number": 30,
          "speechLineNumber": 30,
          "text": "For use me so he shall, or I'll proclaim him,",
          "plainText": "For use me so he shall or I'll proclaim him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0031",
          "number": 31,
          "speechLineNumber": 31,
          "text": "And to his face, no man. I'll presently",
          "plainText": "And to his face no man I'll presently",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0032",
          "number": 32,
          "speechLineNumber": 32,
          "text": "Provide him necessaries and pack my clothes up,",
          "plainText": "Provide him necessaries and pack my clothes up",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0033",
          "number": 33,
          "speechLineNumber": 33,
          "text": "And where there is a path of ground I'll venture,",
          "plainText": "And where there is a path of ground I'll venture",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0034",
          "number": 34,
          "speechLineNumber": 34,
          "text": "So he be with me. By him, like a shadow",
          "plainText": "So he be with me By him like a shadow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0035",
          "number": 35,
          "speechLineNumber": 35,
          "text": "I'll ever dwell. Within this hour the hubbub",
          "plainText": "I'll ever dwell Within this hour the hubbub",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0036",
          "number": 36,
          "speechLineNumber": 36,
          "text": "Will be all o'er the prison. I am then",
          "plainText": "Will be all o'er the prison I am then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0037",
          "number": 37,
          "speechLineNumber": 37,
          "text": "Kissing the man they look for. Farewell, father!",
          "plainText": "Kissing the man they look for Farewell father",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0038",
          "number": 38,
          "speechLineNumber": 38,
          "text": "Get many more such prisoners and such daughters,",
          "plainText": "Get many more such prisoners and such daughters",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-two-noble-kinsmen-2-6-line-0039",
          "number": 39,
          "speechLineNumber": 39,
          "text": "And shortly you may keep yourself. Now to him.",
          "plainText": "And shortly you may keep yourself Now to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-2-6-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}