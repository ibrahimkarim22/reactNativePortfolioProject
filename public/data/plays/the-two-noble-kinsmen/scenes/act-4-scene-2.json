  "scene": {
    "id": "the-two-noble-kinsmen-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. A Room in the Palace",
    "location": "A Room in the Palace",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "the-two-noble-kinsmen-4-2-stage-001",
      "type": "stage",
      "text": "Enter Emilia alone, with two pictures."
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Yet I may bind those wounds up, that must open",
          "plainText": "Yet I may bind those wounds up that must open",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "And bleed to death for my sake else. I'll choose,",
          "plainText": "And bleed to death for my sake else I'll choose",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And end their strife. Two such young handsome men",
          "plainText": "And end their strife Two such young handsome men",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Shall never fall for me; their weeping mothers,",
          "plainText": "Shall never fall for me their weeping mothers",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Following the dead cold ashes of their sons,",
          "plainText": "Following the dead cold ashes of their sons",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "Shall never curse my cruelty.",
          "plainText": "Shall never curse my cruelty",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-stage-002",
      "type": "stage",
      "text": "[Looks at one of the pictures.]"
    },
    {
      "id": "the-two-noble-kinsmen-4-2-stage-003",
      "type": "stage",
      "text": "[Looks at the other picture.]"
    },
    {
      "id": "the-two-noble-kinsmen-4-2-stage-004",
      "type": "stage",
      "text": "[She puts aside his picture.]"
    },
    {
      "id": "the-two-noble-kinsmen-4-2-stage-005",
      "type": "stage",
      "text": "Enter a Gentleman."
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "How now, sir?",
          "plainText": "How now sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "From the noble Duke your brother,",
          "plainText": "From the noble Duke your brother",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 2,
          "text": "Madam, I bring you news. The knights are come.",
          "plainText": "Madam I bring you news The knights are come",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "To end the quarrel?",
          "plainText": "To end the quarrel",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Yes.",
          "plainText": "Yes",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Would I might end first!",
          "plainText": "Would I might end first",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "What sins have I committed, chaste Diana,",
          "plainText": "What sins have I committed chaste Diana",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "That my unspotted youth must now be soiled",
          "plainText": "That my unspotted youth must now be soiled",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 4,
          "text": "With blood of princes, and my chastity",
          "plainText": "With blood of princes and my chastity",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 5,
          "text": "Be made the altar where the lives of lovers—",
          "plainText": "Be made the altar where the lives of lovers",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 6,
          "text": "Two greater and two better never yet",
          "plainText": "Two greater and two better never yet",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 7,
          "text": "Made mothers joy—must be the sacrifice",
          "plainText": "Made mothers joymust be the sacrifice",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 8,
          "text": "To my unhappy beauty?",
          "plainText": "To my unhappy beauty",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-stage-006",
      "type": "stage",
      "text": "Enter Theseus, Hippolyta, Pirithous and Attendants."
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Bring 'em in",
          "plainText": "Bring 'em in",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Quickly, by any means; I long to see 'em.",
          "plainText": "Quickly by any means I long to see 'em",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "Your two contending lovers are returned,",
          "plainText": "Your two contending lovers are returned",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "And with them their fair knights. Now, my fair sister,",
          "plainText": "And with them their fair knights Now my fair sister",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "You must love one of them.",
          "plainText": "You must love one of them",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "I had rather both,",
          "plainText": "I had rather both",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "So neither for my sake should fall untimely.",
          "plainText": "So neither for my sake should fall untimely",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Who saw 'em?",
          "plainText": "Who saw 'em",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "I a while.",
          "plainText": "I a while",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "gentleman",
        "name": "GENTLEMAN",
        "displayName": "Gentleman"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "And I.",
          "plainText": "And I",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-stage-007",
      "type": "stage",
      "text": "Enter Messenger."
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "From whence come you, sir?",
          "plainText": "From whence come you sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "From the knights.",
          "plainText": "From the knights",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Pray, speak,",
          "plainText": "Pray speak",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "You that have seen them, what they are.",
          "plainText": "You that have seen them what they are",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "I will, sir,",
          "plainText": "I will sir",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0035",
          "number": 35,
          "speechLineNumber": 2,
          "text": "And truly what I think. Six braver spirits",
          "plainText": "And truly what I think Six braver spirits",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0036",
          "number": 36,
          "speechLineNumber": 3,
          "text": "Than these they have brought, if we judge by the outside,",
          "plainText": "Than these they have brought if we judge by the outside",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0037",
          "number": 37,
          "speechLineNumber": 4,
          "text": "I never saw nor read of. He that stands",
          "plainText": "I never saw nor read of He that stands",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0038",
          "number": 38,
          "speechLineNumber": 5,
          "text": "In the first place with Arcite, by his seeming",
          "plainText": "In the first place with Arcite by his seeming",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0039",
          "number": 39,
          "speechLineNumber": 6,
          "text": "Should be a stout man, by his face a prince,",
          "plainText": "Should be a stout man by his face a prince",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0040",
          "number": 40,
          "speechLineNumber": 7,
          "text": "His very looks so say him; his complexion",
          "plainText": "His very looks so say him his complexion",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0041",
          "number": 41,
          "speechLineNumber": 8,
          "text": "Nearer a brown than black, stern and yet noble,",
          "plainText": "Nearer a brown than black stern and yet noble",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0042",
          "number": 42,
          "speechLineNumber": 9,
          "text": "Which shows him hardy, fearless, proud of dangers;",
          "plainText": "Which shows him hardy fearless proud of dangers",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0043",
          "number": 43,
          "speechLineNumber": 10,
          "text": "The circles of his eyes show fire within him,",
          "plainText": "The circles of his eyes show fire within him",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0044",
          "number": 44,
          "speechLineNumber": 11,
          "text": "And as a heated lion so he looks.",
          "plainText": "And as a heated lion so he looks",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0045",
          "number": 45,
          "speechLineNumber": 12,
          "text": "His hair hangs long behind him, black and shining",
          "plainText": "His hair hangs long behind him black and shining",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0046",
          "number": 46,
          "speechLineNumber": 13,
          "text": "Like ravens' wings; his shoulders broad and strong;",
          "plainText": "Like ravens' wings his shoulders broad and strong",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0047",
          "number": 47,
          "speechLineNumber": 14,
          "text": "Armed long and round; and on his thigh a sword",
          "plainText": "Armed long and round and on his thigh a sword",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0048",
          "number": 48,
          "speechLineNumber": 15,
          "text": "Hung by a curious baldric, when he frowns",
          "plainText": "Hung by a curious baldric when he frowns",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0049",
          "number": 49,
          "speechLineNumber": 16,
          "text": "To seal his will with. Better, o' my conscience,",
          "plainText": "To seal his will with Better o' my conscience",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0050",
          "number": 50,
          "speechLineNumber": 17,
          "text": "Was never soldier's friend.",
          "plainText": "Was never soldier's friend",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "Thou hast well described him.",
          "plainText": "Thou hast well described him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Yet a great deal short,",
          "plainText": "Yet a great deal short",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0053",
          "number": 53,
          "speechLineNumber": 2,
          "text": "Methinks, of him that's first with Palamon.",
          "plainText": "Methinks of him that's first with Palamon",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "Pray, speak him, friend.",
          "plainText": "Pray speak him friend",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "I guess he is a prince too,",
          "plainText": "I guess he is a prince too",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0056",
          "number": 56,
          "speechLineNumber": 2,
          "text": "And, if it may be, greater; for his show",
          "plainText": "And if it may be greater for his show",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0057",
          "number": 57,
          "speechLineNumber": 3,
          "text": "Has all the ornament of honour in 't:",
          "plainText": "Has all the ornament of honour in 't",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0058",
          "number": 58,
          "speechLineNumber": 4,
          "text": "He's somewhat bigger than the knight he spoke of,",
          "plainText": "He's somewhat bigger than the knight he spoke of",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0059",
          "number": 59,
          "speechLineNumber": 5,
          "text": "But of a face far sweeter; his complexion",
          "plainText": "But of a face far sweeter his complexion",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0060",
          "number": 60,
          "speechLineNumber": 6,
          "text": "Is, as a ripe grape, ruddy. He has felt",
          "plainText": "Is as a ripe grape ruddy He has felt",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0061",
          "number": 61,
          "speechLineNumber": 7,
          "text": "Without doubt what he fights for, and so apter",
          "plainText": "Without doubt what he fights for and so apter",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0062",
          "number": 62,
          "speechLineNumber": 8,
          "text": "To make this cause his own. In 's face appears",
          "plainText": "To make this cause his own In 's face appears",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0063",
          "number": 63,
          "speechLineNumber": 9,
          "text": "All the fair hopes of what he undertakes",
          "plainText": "All the fair hopes of what he undertakes",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0064",
          "number": 64,
          "speechLineNumber": 10,
          "text": "And when he's angry, then a settled valour,",
          "plainText": "And when he's angry then a settled valour",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0065",
          "number": 65,
          "speechLineNumber": 11,
          "text": "Not tainted with extremes, runs through his body",
          "plainText": "Not tainted with extremes runs through his body",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0066",
          "number": 66,
          "speechLineNumber": 12,
          "text": "And guides his arm to brave things. Fear he cannot;",
          "plainText": "And guides his arm to brave things Fear he cannot",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0067",
          "number": 67,
          "speechLineNumber": 13,
          "text": "He shows no such soft temper. His head's yellow,",
          "plainText": "He shows no such soft temper His head's yellow",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0068",
          "number": 68,
          "speechLineNumber": 14,
          "text": "Hard-haired and curled, thick-twined like ivy tods,",
          "plainText": "Hardhaired and curled thicktwined like ivy tods",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0069",
          "number": 69,
          "speechLineNumber": 15,
          "text": "Not to undo with thunder. In his face",
          "plainText": "Not to undo with thunder In his face",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0070",
          "number": 70,
          "speechLineNumber": 16,
          "text": "The livery of the warlike maid appears,",
          "plainText": "The livery of the warlike maid appears",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0071",
          "number": 71,
          "speechLineNumber": 17,
          "text": "Pure red and white, for yet no beard has blessed him;",
          "plainText": "Pure red and white for yet no beard has blessed him",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0072",
          "number": 72,
          "speechLineNumber": 18,
          "text": "And in his rolling eyes sits Victory,",
          "plainText": "And in his rolling eyes sits Victory",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0073",
          "number": 73,
          "speechLineNumber": 19,
          "text": "As if she ever meant to crown his valour.",
          "plainText": "As if she ever meant to crown his valour",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0074",
          "number": 74,
          "speechLineNumber": 20,
          "text": "His nose stands high, a character of honour;",
          "plainText": "His nose stands high a character of honour",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0075",
          "number": 75,
          "speechLineNumber": 21,
          "text": "His red lips, after fights, are fit for ladies.",
          "plainText": "His red lips after fights are fit for ladies",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Must these men die too?",
          "plainText": "Must these men die too",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "When he speaks, his tongue",
          "plainText": "When he speaks his tongue",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "Sounds like a trumpet. All his lineaments",
          "plainText": "Sounds like a trumpet All his lineaments",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0079",
          "number": 79,
          "speechLineNumber": 3,
          "text": "Are as a man would wish 'em, strong and clean.",
          "plainText": "Are as a man would wish 'em strong and clean",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0080",
          "number": 80,
          "speechLineNumber": 4,
          "text": "He wears a well-steeled axe, the staff of gold;",
          "plainText": "He wears a wellsteeled axe the staff of gold",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0081",
          "number": 81,
          "speechLineNumber": 5,
          "text": "His age some five-and-twenty.",
          "plainText": "His age some fiveandtwenty",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "There's another,",
          "plainText": "There's another",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0083",
          "number": 83,
          "speechLineNumber": 2,
          "text": "A little man, but of a tough soul, seeming",
          "plainText": "A little man but of a tough soul seeming",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0084",
          "number": 84,
          "speechLineNumber": 3,
          "text": "As great as any; fairer promises",
          "plainText": "As great as any fairer promises",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0085",
          "number": 85,
          "speechLineNumber": 4,
          "text": "In such a body yet I never looked on.",
          "plainText": "In such a body yet I never looked on",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0086",
          "number": 86,
          "speechLineNumber": 1,
          "text": "O, he that's freckle-faced?",
          "plainText": "O he that's frecklefaced",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0087",
          "number": 87,
          "speechLineNumber": 1,
          "text": "The same, my lord;",
          "plainText": "The same my lord",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0088",
          "number": 88,
          "speechLineNumber": 2,
          "text": "Are they not sweet ones?",
          "plainText": "Are they not sweet ones",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "Yes, they are well.",
          "plainText": "Yes they are well",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0090",
          "number": 90,
          "speechLineNumber": 1,
          "text": "Methinks,",
          "plainText": "Methinks",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0091",
          "number": 91,
          "speechLineNumber": 2,
          "text": "Being so few and well disposed, they show",
          "plainText": "Being so few and well disposed they show",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0092",
          "number": 92,
          "speechLineNumber": 3,
          "text": "Great and fine art in nature. He's white-haired,",
          "plainText": "Great and fine art in nature He's whitehaired",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0093",
          "number": 93,
          "speechLineNumber": 4,
          "text": "Not wanton white, but such a manly colour",
          "plainText": "Not wanton white but such a manly colour",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0094",
          "number": 94,
          "speechLineNumber": 5,
          "text": "Next to an auburn; tough and nimble-set,",
          "plainText": "Next to an auburn tough and nimbleset",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0095",
          "number": 95,
          "speechLineNumber": 6,
          "text": "Which shows an active soul. His arms are brawny,",
          "plainText": "Which shows an active soul His arms are brawny",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0096",
          "number": 96,
          "speechLineNumber": 7,
          "text": "Lined with strong sinews. To the shoulder-piece",
          "plainText": "Lined with strong sinews To the shoulderpiece",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0097",
          "number": 97,
          "speechLineNumber": 8,
          "text": "Gently they swell, like women new-conceived,",
          "plainText": "Gently they swell like women newconceived",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0098",
          "number": 98,
          "speechLineNumber": 9,
          "text": "Which speaks him prone to labour, never fainting",
          "plainText": "Which speaks him prone to labour never fainting",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0099",
          "number": 99,
          "speechLineNumber": 10,
          "text": "Under the weight of arms; stout-hearted still,",
          "plainText": "Under the weight of arms stouthearted still",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0100",
          "number": 100,
          "speechLineNumber": 11,
          "text": "But when he stirs, a tiger. He's grey-eyed,",
          "plainText": "But when he stirs a tiger He's greyeyed",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0101",
          "number": 101,
          "speechLineNumber": 12,
          "text": "Which yields compassion where he conquers; sharp",
          "plainText": "Which yields compassion where he conquers sharp",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0102",
          "number": 102,
          "speechLineNumber": 13,
          "text": "To spy advantages, and where he finds 'em,",
          "plainText": "To spy advantages and where he finds 'em",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0103",
          "number": 103,
          "speechLineNumber": 14,
          "text": "He's swift to make 'em his. He does no wrongs,",
          "plainText": "He's swift to make 'em his He does no wrongs",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0104",
          "number": 104,
          "speechLineNumber": 15,
          "text": "Nor takes none. He's round-faced, and when he smiles",
          "plainText": "Nor takes none He's roundfaced and when he smiles",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0105",
          "number": 105,
          "speechLineNumber": 16,
          "text": "He shows a lover; when he frowns, a soldier.",
          "plainText": "He shows a lover when he frowns a soldier",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0106",
          "number": 106,
          "speechLineNumber": 17,
          "text": "About his head he wears the winner's oak,",
          "plainText": "About his head he wears the winner's oak",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0107",
          "number": 107,
          "speechLineNumber": 18,
          "text": "And in it stuck the favour of his lady.",
          "plainText": "And in it stuck the favour of his lady",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0108",
          "number": 108,
          "speechLineNumber": 19,
          "text": "His age some six-and-thirty. In his hand",
          "plainText": "His age some sixandthirty In his hand",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0109",
          "number": 109,
          "speechLineNumber": 20,
          "text": "He bears a charging-staff embossed with silver.",
          "plainText": "He bears a chargingstaff embossed with silver",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0110",
          "number": 110,
          "speechLineNumber": 1,
          "text": "Are they all thus?",
          "plainText": "Are they all thus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0111",
          "number": 111,
          "speechLineNumber": 1,
          "text": "They are all the sons of honour.",
          "plainText": "They are all the sons of honour",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0112",
          "number": 112,
          "speechLineNumber": 1,
          "text": "Now, as I have a soul, I long to see'em.",
          "plainText": "Now as I have a soul I long to see'em",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0113",
          "number": 113,
          "speechLineNumber": 2,
          "text": "Lady, you shall see men fight now.",
          "plainText": "Lady you shall see men fight now",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "hippolyta",
        "name": "HIPPOLYTA",
        "displayName": "Hippolyta"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0114",
          "number": 114,
          "speechLineNumber": 1,
          "text": "I wish it,",
          "plainText": "I wish it",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0115",
          "number": 115,
          "speechLineNumber": 2,
          "text": "But not the cause, my lord. They would show",
          "plainText": "But not the cause my lord They would show",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0116",
          "number": 116,
          "speechLineNumber": 3,
          "text": "Bravely about the titles of two kingdoms.",
          "plainText": "Bravely about the titles of two kingdoms",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0117",
          "number": 117,
          "speechLineNumber": 4,
          "text": "'Tis pity love should be so tyrannous.—",
          "plainText": "'Tis pity love should be so tyrannous",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0118",
          "number": 118,
          "speechLineNumber": 5,
          "text": "O, my soft-hearted sister, what think you?",
          "plainText": "O my softhearted sister what think you",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0119",
          "number": 119,
          "speechLineNumber": 6,
          "text": "Weep not till they weep blood. Wench, it must be.",
          "plainText": "Weep not till they weep blood Wench it must be",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0120",
          "number": 120,
          "speechLineNumber": 1,
          "text": "You have steeled 'em with your beauty.",
          "plainText": "You have steeled 'em with your beauty",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0121",
          "number": 121,
          "speechLineNumber": 2,
          "text": "Honoured friend,",
          "plainText": "Honoured friend",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0122",
          "number": 122,
          "speechLineNumber": 3,
          "text": "To you I give the field; pray order it",
          "plainText": "To you I give the field pray order it",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0123",
          "number": 123,
          "speechLineNumber": 4,
          "text": "Fitting the persons that must use it.",
          "plainText": "Fitting the persons that must use it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0124",
          "number": 124,
          "speechLineNumber": 1,
          "text": "Yes, sir.",
          "plainText": "Yes sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-033",
      "type": "speech",
      "speaker": {
        "id": "theseus",
        "name": "THESEUS",
        "displayName": "Theseus"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0125",
          "number": 125,
          "speechLineNumber": 1,
          "text": "Come, I'll go visit 'em. I cannot stay,",
          "plainText": "Come I'll go visit 'em I cannot stay",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0126",
          "number": 126,
          "speechLineNumber": 2,
          "text": "Their fame has fired me so; till they appear.",
          "plainText": "Their fame has fired me so till they appear",
          "lineType": "verse"
        },
        {
          "id": "the-two-noble-kinsmen-4-2-line-0127",
          "number": 127,
          "speechLineNumber": 3,
          "text": "Good friend, be royal.",
          "plainText": "Good friend be royal",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-speech-034",
      "type": "speech",
      "speaker": {
        "id": "pirithous",
        "name": "PIRITHOUS",
        "displayName": "Pirithous"
      },
      "lines": [
        {
          "id": "the-two-noble-kinsmen-4-2-line-0128",
          "number": 128,
          "speechLineNumber": 1,
          "text": "There shall want no bravery.",
          "plainText": "There shall want no bravery",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "the-two-noble-kinsmen-4-2-stage-008",
      "type": "stage",
      "text": "[Exeunt all but Emilia.]"
    },
    {
