    "title": "SCENE II. The same. The outer Room of a Prison.",
    "location": "The same. The outer Room of a Prison.",
    "orderInPlay": 4
  },
  "content": [
    {
      "id": "the-winters-tale-2-2-stage-001",
      "type": "stage",
      "text": "Enter Paulina, a Gentleman and Attendants."
    },
    {
      "id": "the-winters-tale-2-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "paulina",
        "name": "PAULINA",
        "displayName": "Paulina"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The keeper of the prison, call to him;",
          "plainText": "The keeper of the prison call to him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Let him have knowledge who I am.",
          "plainText": "Let him have knowledge who I am",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-stage-002",
      "type": "stage",
      "text": "[Exit the Gentleman.]"
    },
    {
      "id": "the-winters-tale-2-2-stage-003",
      "type": "stage",
      "text": "Enter Gentleman with the Gaoler."
    },
    {
      "id": "the-winters-tale-2-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "gaoler",
        "name": "GAOLER",
        "displayName": "Gaoler"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "For a worthy lady",
          "plainText": "For a worthy lady",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "And one who much I honour.",
          "plainText": "And one who much I honour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "paulina",
        "name": "PAULINA",
        "displayName": "Paulina"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Pray you then,",
          "plainText": "Pray you then",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Conduct me to the queen.",
          "plainText": "Conduct me to the queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "gaoler",
        "name": "GAOLER",
        "displayName": "Gaoler"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "I may not, madam.",
          "plainText": "I may not madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "To the contrary I have express commandment.",
          "plainText": "To the contrary I have express commandment",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "paulina",
        "name": "PAULINA",
        "displayName": "Paulina"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Here's ado, to lock up honesty and honour from",
          "plainText": "Here's ado to lock up honesty and honour from",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0010",
          "number": 10,
          "speechLineNumber": 2,
          "text": "Th' access of gentle visitors! Is't lawful, pray you,",
          "plainText": "Th' access of gentle visitors Is't lawful pray you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0011",
          "number": 11,
          "speechLineNumber": 3,
          "text": "To see her women? any of them? Emilia?",
          "plainText": "To see her women any of them Emilia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "gaoler",
        "name": "GAOLER",
        "displayName": "Gaoler"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "So please you, madam,",
          "plainText": "So please you madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0013",
          "number": 13,
          "speechLineNumber": 2,
          "text": "To put apart these your attendants, I",
          "plainText": "To put apart these your attendants I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0014",
          "number": 14,
          "speechLineNumber": 3,
          "text": "Shall bring Emilia forth.",
          "plainText": "Shall bring Emilia forth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "paulina",
        "name": "PAULINA",
        "displayName": "Paulina"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "I pray now, call her.",
          "plainText": "I pray now call her",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0016",
          "number": 16,
          "speechLineNumber": 2,
          "text": "Withdraw yourselves.",
          "plainText": "Withdraw yourselves",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-stage-004",
      "type": "stage",
      "text": "[Exeunt Gentleman and Attendants.]"
    },
    {
      "id": "the-winters-tale-2-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "gaoler",
        "name": "GAOLER",
        "displayName": "Gaoler"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "And, madam,",
          "plainText": "And madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "I must be present at your conference.",
          "plainText": "I must be present at your conference",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "paulina",
        "name": "PAULINA",
        "displayName": "Paulina"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Well, be't so, prithee.",
          "plainText": "Well be't so prithee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-stage-005",
      "type": "stage",
      "text": "[Exit Gaoler.]"
    },
    {
      "id": "the-winters-tale-2-2-stage-006",
      "type": "stage",
      "text": "Re-enter Gaoler with Emilia."
    },
    {
      "id": "the-winters-tale-2-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "As well as one so great and so forlorn",
          "plainText": "As well as one so great and so forlorn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "May hold together: on her frights and griefs,",
          "plainText": "May hold together on her frights and griefs",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "(Which never tender lady hath borne greater)",
          "plainText": "Which never tender lady hath borne greater",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "She is, something before her time, deliver'd.",
          "plainText": "She is something before her time deliver'd",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "paulina",
        "name": "PAULINA",
        "displayName": "Paulina"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "A boy?",
          "plainText": "A boy",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "A daughter; and a goodly babe,",
          "plainText": "A daughter and a goodly babe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0026",
          "number": 26,
          "speechLineNumber": 2,
          "text": "Lusty, and like to live: the queen receives",
          "plainText": "Lusty and like to live the queen receives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0027",
          "number": 27,
          "speechLineNumber": 3,
          "text": "Much comfort in 't; says \"My poor prisoner,",
          "plainText": "Much comfort in 't says My poor prisoner",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0028",
          "number": 28,
          "speechLineNumber": 4,
          "text": "I am as innocent as you.\"",
          "plainText": "I am as innocent as you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "paulina",
        "name": "PAULINA",
        "displayName": "Paulina"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "I dare be sworn.",
          "plainText": "I dare be sworn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "These dangerous unsafe lunes i' th' king, beshrew them!",
          "plainText": "These dangerous unsafe lunes i' th' king beshrew them",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "He must be told on't, and he shall: the office",
          "plainText": "He must be told on't and he shall the office",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "Becomes a woman best. I'll take't upon me.",
          "plainText": "Becomes a woman best I'll take't upon me",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0033",
          "number": 33,
          "speechLineNumber": 5,
          "text": "If I prove honey-mouth'd, let my tongue blister,",
          "plainText": "If I prove honeymouth'd let my tongue blister",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0034",
          "number": 34,
          "speechLineNumber": 6,
          "text": "And never to my red-look'd anger be",
          "plainText": "And never to my redlook'd anger be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0035",
          "number": 35,
          "speechLineNumber": 7,
          "text": "The trumpet any more. Pray you, Emilia,",
          "plainText": "The trumpet any more Pray you Emilia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0036",
          "number": 36,
          "speechLineNumber": 8,
          "text": "Commend my best obedience to the queen.",
          "plainText": "Commend my best obedience to the queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0037",
          "number": 37,
          "speechLineNumber": 9,
          "text": "If she dares trust me with her little babe,",
          "plainText": "If she dares trust me with her little babe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0038",
          "number": 38,
          "speechLineNumber": 10,
          "text": "I'll show't the king, and undertake to be",
          "plainText": "I'll show't the king and undertake to be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0039",
          "number": 39,
          "speechLineNumber": 11,
          "text": "Her advocate to th' loud'st. We do not know",
          "plainText": "Her advocate to th' loud'st We do not know",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0040",
          "number": 40,
          "speechLineNumber": 12,
          "text": "How he may soften at the sight o' th' child:",
          "plainText": "How he may soften at the sight o' th' child",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0041",
          "number": 41,
          "speechLineNumber": 13,
          "text": "The silence often of pure innocence",
          "plainText": "The silence often of pure innocence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0042",
          "number": 42,
          "speechLineNumber": 14,
          "text": "Persuades, when speaking fails.",
          "plainText": "Persuades when speaking fails",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Most worthy madam,",
          "plainText": "Most worthy madam",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0044",
          "number": 44,
          "speechLineNumber": 2,
          "text": "Your honour and your goodness is so evident,",
          "plainText": "Your honour and your goodness is so evident",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0045",
          "number": 45,
          "speechLineNumber": 3,
          "text": "That your free undertaking cannot miss",
          "plainText": "That your free undertaking cannot miss",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0046",
          "number": 46,
          "speechLineNumber": 4,
          "text": "A thriving issue: there is no lady living",
          "plainText": "A thriving issue there is no lady living",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0047",
          "number": 47,
          "speechLineNumber": 5,
          "text": "So meet for this great errand. Please your ladyship",
          "plainText": "So meet for this great errand Please your ladyship",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0048",
          "number": 48,
          "speechLineNumber": 6,
          "text": "To visit the next room, I'll presently",
          "plainText": "To visit the next room I'll presently",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0049",
          "number": 49,
          "speechLineNumber": 7,
          "text": "Acquaint the queen of your most noble offer,",
          "plainText": "Acquaint the queen of your most noble offer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0050",
          "number": 50,
          "speechLineNumber": 8,
          "text": "Who but today hammer'd of this design,",
          "plainText": "Who but today hammer'd of this design",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0051",
          "number": 51,
          "speechLineNumber": 9,
          "text": "But durst not tempt a minister of honour,",
          "plainText": "But durst not tempt a minister of honour",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0052",
          "number": 52,
          "speechLineNumber": 10,
          "text": "Lest she should be denied.",
          "plainText": "Lest she should be denied",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "paulina",
        "name": "PAULINA",
        "displayName": "Paulina"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Tell her, Emilia,",
          "plainText": "Tell her Emilia",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0054",
          "number": 54,
          "speechLineNumber": 2,
          "text": "I'll use that tongue I have: if wit flow from 't",
          "plainText": "I'll use that tongue I have if wit flow from 't",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0055",
          "number": 55,
          "speechLineNumber": 3,
          "text": "As boldness from my bosom, let't not be doubted",
          "plainText": "As boldness from my bosom let't not be doubted",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0056",
          "number": 56,
          "speechLineNumber": 4,
          "text": "I shall do good.",
          "plainText": "I shall do good",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "emilia",
        "name": "EMILIA",
        "displayName": "Emilia"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "Now be you blest for it!",
          "plainText": "Now be you blest for it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0058",
          "number": 58,
          "speechLineNumber": 2,
          "text": "I'll to the queen: please you come something nearer.",
          "plainText": "I'll to the queen please you come something nearer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "gaoler",
        "name": "GAOLER",
        "displayName": "Gaoler"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Madam, if 't please the queen to send the babe,",
          "plainText": "Madam if 't please the queen to send the babe",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "I know not what I shall incur to pass it,",
          "plainText": "I know not what I shall incur to pass it",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0061",
          "number": 61,
          "speechLineNumber": 3,
          "text": "Having no warrant.",
          "plainText": "Having no warrant",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "paulina",
        "name": "PAULINA",
        "displayName": "Paulina"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "You need not fear it, sir:",
          "plainText": "You need not fear it sir",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0063",
          "number": 63,
          "speechLineNumber": 2,
          "text": "This child was prisoner to the womb, and is,",
          "plainText": "This child was prisoner to the womb and is",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0064",
          "number": 64,
          "speechLineNumber": 3,
          "text": "By law and process of great nature thence",
          "plainText": "By law and process of great nature thence",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0065",
          "number": 65,
          "speechLineNumber": 4,
          "text": "Freed and enfranchis'd: not a party to",
          "plainText": "Freed and enfranchis'd not a party to",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0066",
          "number": 66,
          "speechLineNumber": 5,
          "text": "The anger of the king, nor guilty of,",
          "plainText": "The anger of the king nor guilty of",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0067",
          "number": 67,
          "speechLineNumber": 6,
          "text": "If any be, the trespass of the queen.",
          "plainText": "If any be the trespass of the queen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "gaoler",
        "name": "GAOLER",
        "displayName": "Gaoler"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "I do believe it.",
          "plainText": "I do believe it",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "paulina",
        "name": "PAULINA",
        "displayName": "Paulina"
      },
      "lines": [
        {
          "id": "the-winters-tale-2-2-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Do not you fear: upon mine honour, I",
          "plainText": "Do not you fear upon mine honour I",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-2-2-line-0070",
          "number": 70,
          "speechLineNumber": 2,
          "text": "Will stand betwixt you and danger.",
          "plainText": "Will stand betwixt you and danger",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-2-2-stage-007",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}