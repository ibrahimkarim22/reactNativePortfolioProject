      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Sweet sir, much better than I was. I can stand and walk: I will even take my leave of you and pace softly towards my kinsman's.",
          "plainText": "Sweet sir much better than I was I can stand and walk I will even take my leave of you and pace softly towards my kinsman's",
          "lineType": "prose",
