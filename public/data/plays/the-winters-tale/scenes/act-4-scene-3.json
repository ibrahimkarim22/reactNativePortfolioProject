  "content": [
    {
      "id": "the-winters-tale-4-3-stage-001",
      "type": "stage",
      "text": "Enter Autolycus, singing."
    },
    {
      "id": "the-winters-tale-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "When daffodils begin to peer,",
          "plainText": "When daffodils begin to peer",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "With, hey! the doxy over the dale,",
          "plainText": "With hey the doxy over the dale",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Why, then comes in the sweet o' the year,",
          "plainText": "Why then comes in the sweet o' the year",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "the-winters-tale-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "For the red blood reigns in the winter's pale.",
          "plainText": "For the red blood reigns in the winter's pale",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-stage-002",
      "type": "stage",
      "text": "Enter Clown."
    },
    {
      "id": "the-winters-tale-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Let me see: every 'leven wether tods; every tod yields pound and odd shilling; fifteen hundred shorn, what comes the wool to?",
          "plainText": "Let me see every 'leven wether tods every tod yields pound and odd shilling fifteen hundred shorn what comes the wool to",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "[Aside.] If the springe hold, the cock's mine.",
          "plainText": "Aside If the springe hold the cock's mine",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "I cannot do't without counters. Let me see; what am I to buy for our sheep-shearing feast? \"Three pound of sugar, five pound of currants, rice\"—what will this sister of mine do with rice? But my father hath made her mistress of the feast, and she lays it on. She hath made me four-and-twenty nosegays for the shearers, three-man song-men all, and very good ones; but they are most of them means and basses, but one puritan amongst them, and he sings psalms to hornpipes. I must have saffron to colour the warden pies; \"mace; dates\", none, that's out of my note; \"nutmegs, seven; a race or two of ginger\", but that I may beg; \"four pound of prunes, and as many of raisins o' th' sun.\"",
          "plainText": "I cannot do't without counters Let me see what am I to buy for our sheepshearing feast Three pound of sugar five pound of currants ricewhat will this sister of mine do with rice But my father hath made her mistress of the feast and she lays it on She hath made me fourandtwenty nosegays for the shearers threeman songmen all and very good ones but they are most of them means and basses but one puritan amongst them and he sings psalms to hornpipes I must have saffron to colour the warden pies mace dates none that's out of my note nutmegs seven a race or two of ginger but that I may beg four pound of prunes and as many of raisins o' th' sun",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "[Grovelling on the ground.] O that ever I was born!",
          "plainText": "Grovelling on the ground O that ever I was born",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "I' th' name of me!",
          "plainText": "I' th' name of me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "O, help me, help me! Pluck but off these rags; and then, death, death!",
          "plainText": "O help me help me Pluck but off these rags and then death death",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Alack, poor soul! thou hast need of more rags to lay on thee, rather than have these off.",
          "plainText": "Alack poor soul thou hast need of more rags to lay on thee rather than have these off",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "O sir, the loathsomeness of them offends me more than the stripes I have received, which are mighty ones and millions.",
          "plainText": "O sir the loathsomeness of them offends me more than the stripes I have received which are mighty ones and millions",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Alas, poor man! a million of beating may come to a great matter.",
          "plainText": "Alas poor man a million of beating may come to a great matter",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "I am robbed, sir, and beaten; my money and apparel ta'en from me, and these detestable things put upon me.",
          "plainText": "I am robbed sir and beaten my money and apparel ta'en from me and these detestable things put upon me",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "What, by a horseman or a footman?",
          "plainText": "What by a horseman or a footman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "A footman, sweet sir, a footman.",
          "plainText": "A footman sweet sir a footman",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Indeed, he should be a footman by the garments he has left with thee: if this be a horseman's coat, it hath seen very hot service. Lend me thy hand, I'll help thee: come, lend me thy hand.",
          "plainText": "Indeed he should be a footman by the garments he has left with thee if this be a horseman's coat it hath seen very hot service Lend me thy hand I'll help thee come lend me thy hand",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-stage-003",
      "type": "stage",
      "text": "[Helping him up.]"
    },
    {
      "id": "the-winters-tale-4-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "O, good sir, tenderly, O!",
          "plainText": "O good sir tenderly O",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Alas, poor soul!",
          "plainText": "Alas poor soul",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "O, good sir, softly, good sir. I fear, sir, my shoulder blade is out.",
          "plainText": "O good sir softly good sir I fear sir my shoulder blade is out",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "How now! canst stand?",
          "plainText": "How now canst stand",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Softly, dear sir! [Picks his pocket.] good sir, softly. You ha' done me a charitable office.",
          "plainText": "Softly dear sir Picks his pocket good sir softly You ha' done me a charitable office",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Dost lack any money? I have a little money for thee.",
          "plainText": "Dost lack any money I have a little money for thee",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "No, good sweet sir; no, I beseech you, sir: I have a kinsman not past three-quarters of a mile hence, unto whom I was going. I shall there have money or anything I want. Offer me no money, I pray you; that kills my heart.",
          "plainText": "No good sweet sir no I beseech you sir I have a kinsman not past threequarters of a mile hence unto whom I was going I shall there have money or anything I want Offer me no money I pray you that kills my heart",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "What manner of fellow was he that robbed you?",
          "plainText": "What manner of fellow was he that robbed you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "A fellow, sir, that I have known to go about with troll-my-dames. I knew him once a servant of the prince; I cannot tell, good sir, for which of his virtues it was, but he was certainly whipped out of the court.",
          "plainText": "A fellow sir that I have known to go about with trollmydames I knew him once a servant of the prince I cannot tell good sir for which of his virtues it was but he was certainly whipped out of the court",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "His vices, you would say; there's no virtue whipped out of the court. They cherish it to make it stay there; and yet it will no more but abide.",
          "plainText": "His vices you would say there's no virtue whipped out of the court They cherish it to make it stay there and yet it will no more but abide",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Vices, I would say, sir. I know this man well. He hath been since an ape-bearer, then a process-server, a bailiff. Then he compassed a motion of the Prodigal Son, and married a tinker's wife within a mile where my land and living lies; and, having flown over many knavish professions, he settled only in rogue. Some call him Autolycus.",
          "plainText": "Vices I would say sir I know this man well He hath been since an apebearer then a processserver a bailiff Then he compassed a motion of the Prodigal Son and married a tinker's wife within a mile where my land and living lies and having flown over many knavish professions he settled only in rogue Some call him Autolycus",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Out upon him! prig, for my life, prig: he haunts wakes, fairs, and bear-baitings.",
          "plainText": "Out upon him prig for my life prig he haunts wakes fairs and bearbaitings",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "autolycus",
        "name": "AUTOLYCUS",
        "displayName": "Autolycus"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Very true, sir; he, sir, he; that's the rogue that put me into this apparel.",
          "plainText": "Very true sir he sir he that's the rogue that put me into this apparel",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "the-winters-tale-4-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "clown",
        "name": "CLOWN",
        "displayName": "Clown"
      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Not a more cowardly rogue in all Bohemia. If you had but looked big and spit at him, he'd have run.",
          "plainText": "Not a more cowardly rogue in all Bohemia If you had but looked big and spit at him he'd have run",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
