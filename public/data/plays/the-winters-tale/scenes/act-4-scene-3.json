      },
      "lines": [
        {
          "id": "the-winters-tale-4-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "I must confess to you, sir, I am no fighter. I am false of heart that way; and that he knew, I warrant him.",
          "plainText": "I must confess to you sir I am no fighter I am false of heart that way and that he knew I warrant him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
