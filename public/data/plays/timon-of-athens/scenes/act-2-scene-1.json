  "scene": {
    "id": "timon-of-athens-2-1",
    "act": 2,
    "scene": 1,
    "label": "Act 2, Scene 1",
    "title": "SCENE I. Athens. A room in a senator's house",
    "location": "Athens. A room in a senator's house",
    "orderInPlay": 3
  },
  "content": [
    {
      "id": "timon-of-athens-2-1-stage-001",
      "type": "stage",
      "text": "Enter a Senator with papers."
    },
    {
      "id": "timon-of-athens-2-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "senator",
        "name": "SENATOR",
        "displayName": "Senator"
      },
      "lines": [
        {
          "id": "timon-of-athens-2-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "And late five thousand. To Varro and to Isidore",
          "plainText": "And late five thousand To Varro and to Isidore",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "He owes nine thousand, besides my former sum,",
          "plainText": "He owes nine thousand besides my former sum",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Which makes it five-and-twenty. Still in motion",
          "plainText": "Which makes it fiveandtwenty Still in motion",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Of raging waste! It cannot hold; it will not.",
          "plainText": "Of raging waste It cannot hold it will not",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "If I want gold, steal but a beggar's dog",
          "plainText": "If I want gold steal but a beggar's dog",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "And give it Timon, why, the dog coins gold.",
          "plainText": "And give it Timon why the dog coins gold",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "If I would sell my horse, and buy twenty more",
          "plainText": "If I would sell my horse and buy twenty more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Better than he, why, give my horse to Timon—",
          "plainText": "Better than he why give my horse to Timon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Ask nothing, give it him—it foals me straight,",
          "plainText": "Ask nothing give it himit foals me straight",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "And able horses. No porter at his gate,",
          "plainText": "And able horses No porter at his gate",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "But rather one that smiles and still invites",
          "plainText": "But rather one that smiles and still invites",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "All that pass by. It cannot hold; no reason",
          "plainText": "All that pass by It cannot hold no reason",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "Can sound his state in safety. Caphis, ho!",
          "plainText": "Can sound his state in safety Caphis ho",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Caphis, I say!",
          "plainText": "Caphis I say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-2-1-stage-002",
      "type": "stage",
      "text": "Enter Caphis."
    },
    {
      "id": "timon-of-athens-2-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "caphis",
        "name": "CAPHIS",
        "displayName": "Caphis"
      },
      "lines": [
        {
          "id": "timon-of-athens-2-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Here, sir, what is your pleasure?",
          "plainText": "Here sir what is your pleasure",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-2-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "senator",
        "name": "SENATOR",
        "displayName": "Senator"
      },
      "lines": [
        {
          "id": "timon-of-athens-2-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Get on your cloak and haste you to Lord Timon.",
          "plainText": "Get on your cloak and haste you to Lord Timon",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Importune him for my moneys; be not ceased",
          "plainText": "Importune him for my moneys be not ceased",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "With slight denial, nor then silenced when",
          "plainText": "With slight denial nor then silenced when",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "\"Commend me to your master\", and the cap",
          "plainText": "Commend me to your master and the cap",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "Plays in the right hand, thus; but tell him,",
          "plainText": "Plays in the right hand thus but tell him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0021",
          "number": 21,
          "speechLineNumber": 6,
          "text": "My uses cry to me, I must serve my turn",
          "plainText": "My uses cry to me I must serve my turn",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0022",
          "number": 22,
          "speechLineNumber": 7,
          "text": "Out of mine own, his days and times are past,",
          "plainText": "Out of mine own his days and times are past",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0023",
          "number": 23,
          "speechLineNumber": 8,
          "text": "And my reliances on his fracted dates",
          "plainText": "And my reliances on his fracted dates",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0024",
          "number": 24,
          "speechLineNumber": 9,
          "text": "Have smit my credit. I love and honour him,",
          "plainText": "Have smit my credit I love and honour him",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0025",
          "number": 25,
          "speechLineNumber": 10,
          "text": "But must not break my back to heal his finger.",
          "plainText": "But must not break my back to heal his finger",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0026",
          "number": 26,
          "speechLineNumber": 11,
          "text": "Immediate are my needs, and my relief",
          "plainText": "Immediate are my needs and my relief",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0027",
          "number": 27,
          "speechLineNumber": 12,
          "text": "Must not be tossed and turned to me in words,",
          "plainText": "Must not be tossed and turned to me in words",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0028",
          "number": 28,
          "speechLineNumber": 13,
          "text": "But find supply immediate. Get you gone.",
          "plainText": "But find supply immediate Get you gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0029",
          "number": 29,
          "speechLineNumber": 14,
          "text": "Put on a most importunate aspect,",
          "plainText": "Put on a most importunate aspect",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0030",
          "number": 30,
          "speechLineNumber": 15,
          "text": "A visage of demand, for I do fear",
          "plainText": "A visage of demand for I do fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0031",
          "number": 31,
          "speechLineNumber": 16,
          "text": "When every feather sticks in his own wing,",
          "plainText": "When every feather sticks in his own wing",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0032",
          "number": 32,
          "speechLineNumber": 17,
          "text": "Lord Timon will be left a naked gull,",
          "plainText": "Lord Timon will be left a naked gull",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0033",
          "number": 33,
          "speechLineNumber": 18,
          "text": "Which flashes now a phoenix. Get you gone.",
          "plainText": "Which flashes now a phoenix Get you gone",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-2-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "caphis",
        "name": "CAPHIS",
        "displayName": "Caphis"
      },
      "lines": [
        {
          "id": "timon-of-athens-2-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "I go, sir.",
          "plainText": "I go sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-2-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "senator",
        "name": "SENATOR",
        "displayName": "Senator"
      },
      "lines": [
        {
          "id": "timon-of-athens-2-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Take the bonds along with you,",
          "plainText": "Take the bonds along with you",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-2-1-line-0036",
          "number": 36,
          "speechLineNumber": 2,
          "text": "And have the dates in. Come.",
          "plainText": "And have the dates in Come",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-2-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "caphis",
        "name": "CAPHIS",
        "displayName": "Caphis"
      },
      "lines": [
        {
          "id": "timon-of-athens-2-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "I will, sir.",
          "plainText": "I will sir",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-2-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "senator",
        "name": "SENATOR",
        "displayName": "Senator"
      },
      "lines": [
        {
          "id": "timon-of-athens-2-1-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Go.",
          "plainText": "Go",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "timon-of-athens-2-1-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}