  "scene": {
    "id": "timon-of-athens-4-1",
    "act": 4,
    "scene": 1,
    "label": "Act 4, Scene 1",
    "title": "SCENE I. Without the walls of Athens",
    "location": "Without the walls of Athens",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "timon-of-athens-4-1-stage-001",
      "type": "stage",
      "text": "Enter Timon."
    },
    {
      "id": "timon-of-athens-4-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "timon",
        "name": "TIMON",
        "displayName": "Timon"
      },
      "lines": [
        {
          "id": "timon-of-athens-4-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Let me look back upon thee. O thou wall",
          "plainText": "Let me look back upon thee O thou wall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "That girdles in those wolves, dive in the earth",
          "plainText": "That girdles in those wolves dive in the earth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "And fence not Athens! Matrons, turn incontinent!",
          "plainText": "And fence not Athens Matrons turn incontinent",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Obedience fail in children! Slaves and fools,",
          "plainText": "Obedience fail in children Slaves and fools",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "Pluck the grave wrinkled senate from the bench",
          "plainText": "Pluck the grave wrinkled senate from the bench",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "And minister in their steads! To general filths",
          "plainText": "And minister in their steads To general filths",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Convert, o' th' instant, green virginity,",
          "plainText": "Convert o' th' instant green virginity",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "Do't in your parents' eyes! Bankrupts, hold fast;",
          "plainText": "Do't in your parents' eyes Bankrupts hold fast",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "Rather than render back, out with your knives",
          "plainText": "Rather than render back out with your knives",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "And cut your trusters' throats! Bound servants, steal!",
          "plainText": "And cut your trusters' throats Bound servants steal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0011",
          "number": 11,
          "speechLineNumber": 11,
          "text": "Large-handed robbers your grave masters are,",
          "plainText": "Largehanded robbers your grave masters are",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0012",
          "number": 12,
          "speechLineNumber": 12,
          "text": "And pill by law. Maid, to thy master's bed,",
          "plainText": "And pill by law Maid to thy master's bed",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0013",
          "number": 13,
          "speechLineNumber": 13,
          "text": "Thy mistress is o' th' brothel. Son of sixteen,",
          "plainText": "Thy mistress is o' th' brothel Son of sixteen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0014",
          "number": 14,
          "speechLineNumber": 14,
          "text": "Pluck the lined crutch from thy old limping sire,",
          "plainText": "Pluck the lined crutch from thy old limping sire",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0015",
          "number": 15,
          "speechLineNumber": 15,
          "text": "With it beat out his brains! Piety and fear,",
          "plainText": "With it beat out his brains Piety and fear",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0016",
          "number": 16,
          "speechLineNumber": 16,
          "text": "Religion to the gods, peace, justice, truth,",
          "plainText": "Religion to the gods peace justice truth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0017",
          "number": 17,
          "speechLineNumber": 17,
          "text": "Domestic awe, night-rest and neighbourhood,",
          "plainText": "Domestic awe nightrest and neighbourhood",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0018",
          "number": 18,
          "speechLineNumber": 18,
          "text": "Instruction, manners, mysteries and trades,",
          "plainText": "Instruction manners mysteries and trades",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0019",
          "number": 19,
          "speechLineNumber": 19,
          "text": "Degrees, observances, customs and laws,",
          "plainText": "Degrees observances customs and laws",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0020",
          "number": 20,
          "speechLineNumber": 20,
          "text": "Decline to your confounding contraries,",
          "plainText": "Decline to your confounding contraries",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0021",
          "number": 21,
          "speechLineNumber": 21,
          "text": "And let confusion live! Plagues incident to men,",
          "plainText": "And let confusion live Plagues incident to men",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0022",
          "number": 22,
          "speechLineNumber": 22,
          "text": "Your potent and infectious fevers heap",
          "plainText": "Your potent and infectious fevers heap",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0023",
          "number": 23,
          "speechLineNumber": 23,
          "text": "On Athens, ripe for stroke! Thou cold sciatica,",
          "plainText": "On Athens ripe for stroke Thou cold sciatica",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0024",
          "number": 24,
          "speechLineNumber": 24,
          "text": "Cripple our senators, that their limbs may halt",
          "plainText": "Cripple our senators that their limbs may halt",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0025",
          "number": 25,
          "speechLineNumber": 25,
          "text": "As lamely as their manners! Lust and liberty,",
          "plainText": "As lamely as their manners Lust and liberty",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0026",
          "number": 26,
          "speechLineNumber": 26,
          "text": "Creep in the minds and marrows of our youth,",
          "plainText": "Creep in the minds and marrows of our youth",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0027",
          "number": 27,
          "speechLineNumber": 27,
          "text": "That 'gainst the stream of virtue they may strive",
          "plainText": "That 'gainst the stream of virtue they may strive",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0028",
          "number": 28,
          "speechLineNumber": 28,
          "text": "And drown themselves in riot! Itches, blains,",
          "plainText": "And drown themselves in riot Itches blains",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0029",
          "number": 29,
          "speechLineNumber": 29,
          "text": "Sow all th' Athenian bosoms, and their crop",
          "plainText": "Sow all th' Athenian bosoms and their crop",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0030",
          "number": 30,
          "speechLineNumber": 30,
          "text": "Be general leprosy! Breath infect breath,",
          "plainText": "Be general leprosy Breath infect breath",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0031",
          "number": 31,
          "speechLineNumber": 31,
          "text": "That their society, as their friendship, may",
          "plainText": "That their society as their friendship may",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0032",
          "number": 32,
          "speechLineNumber": 32,
          "text": "Be merely poison! Nothing I'll bear from thee",
          "plainText": "Be merely poison Nothing I'll bear from thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0033",
          "number": 33,
          "speechLineNumber": 33,
          "text": "But nakedness, thou detestable town!",
          "plainText": "But nakedness thou detestable town",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0034",
          "number": 34,
          "speechLineNumber": 34,
          "text": "Take thou that too, with multiplying bans!",
          "plainText": "Take thou that too with multiplying bans",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0035",
          "number": 35,
          "speechLineNumber": 35,
          "text": "Timon will to the woods, where he shall find",
          "plainText": "Timon will to the woods where he shall find",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0036",
          "number": 36,
          "speechLineNumber": 36,
          "text": "Th' unkindest beast more kinder than mankind.",
          "plainText": "Th' unkindest beast more kinder than mankind",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0037",
          "number": 37,
          "speechLineNumber": 37,
          "text": "The gods confound—hear me, you good gods all!—",
          "plainText": "The gods confoundhear me you good gods all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0038",
          "number": 38,
          "speechLineNumber": 38,
          "text": "Th' Athenians both within and out that wall,",
          "plainText": "Th' Athenians both within and out that wall",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0039",
          "number": 39,
          "speechLineNumber": 39,
          "text": "And grant, as Timon grows, his hate may grow",
          "plainText": "And grant as Timon grows his hate may grow",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0040",
          "number": 40,
          "speechLineNumber": 40,
          "text": "To the whole race of mankind, high and low!",
          "plainText": "To the whole race of mankind high and low",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "timon-of-athens-4-1-line-0041",
          "number": 41,
          "speechLineNumber": 41,
          "text": "Amen.",
          "plainText": "Amen",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "timon-of-athens-4-1-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    }
  ]
}