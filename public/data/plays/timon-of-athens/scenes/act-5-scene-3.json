  "scene": {
    "id": "timon-of-athens-5-3",
    "act": 5,
    "scene": 3,
    "label": "Act 5, Scene 3",
    "title": "SCENE III. Before the walls of Athens",
    "location": "Before the walls of Athens",
    "orderInPlay": 16
  },
  "content": [
    {
      "id": "timon-of-athens-5-3-stage-001",
      "type": "stage",
      "text": "Enter two other Senators, with a Messenger."
    },
    {
      "id": "timon-of-athens-5-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "first-senator",
        "name": "FIRST SENATOR",
        "displayName": "First Senator"
      },
      "lines": [
        {
          "id": "timon-of-athens-5-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Thou hast painfully discovered. Are his files",
          "plainText": "Thou hast painfully discovered Are his files",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "As full as thy report?",
          "plainText": "As full as thy report",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "timon-of-athens-5-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "timon-of-athens-5-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "I have spoke the least.",
          "plainText": "I have spoke the least",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0004",
          "number": 4,
          "speechLineNumber": 2,
          "text": "Besides, his expedition promises",
          "plainText": "Besides his expedition promises",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0005",
          "number": 5,
          "speechLineNumber": 3,
          "text": "Present approach.",
          "plainText": "Present approach",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "timon-of-athens-5-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "second-senator",
        "name": "SECOND SENATOR",
        "displayName": "Second Senator"
      },
      "lines": [
        {
          "id": "timon-of-athens-5-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "We stand much hazard if they bring not Timon.",
          "plainText": "We stand much hazard if they bring not Timon",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "timon-of-athens-5-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "messenger",
        "name": "MESSENGER",
        "displayName": "Messenger"
      },
      "lines": [
        {
          "id": "timon-of-athens-5-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "I met a courier, one mine ancient friend,",
          "plainText": "I met a courier one mine ancient friend",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Whom, though in general part we were opposed,",
          "plainText": "Whom though in general part we were opposed",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Yet our old love made a particular force",
          "plainText": "Yet our old love made a particular force",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "And made us speak like friends. This man was riding",
          "plainText": "And made us speak like friends This man was riding",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "From Alcibiades to Timon's cave",
          "plainText": "From Alcibiades to Timon's cave",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "With letters of entreaty, which imported",
          "plainText": "With letters of entreaty which imported",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0013",
          "number": 13,
          "speechLineNumber": 7,
          "text": "His fellowship i' th' cause against your city,",
          "plainText": "His fellowship i' th' cause against your city",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0014",
          "number": 14,
          "speechLineNumber": 8,
          "text": "In part for his sake moved.",
          "plainText": "In part for his sake moved",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "timon-of-athens-5-3-stage-002",
      "type": "stage",
      "text": "Enter the other Senators from Timon."
    },
    {
      "id": "timon-of-athens-5-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "third-senator",
        "name": "THIRD SENATOR",
        "displayName": "Third Senator"
      },
      "lines": [
        {
          "id": "timon-of-athens-5-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Here come our brothers.",
          "plainText": "Here come our brothers",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "timon-of-athens-5-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "first-senator",
        "name": "FIRST SENATOR",
        "displayName": "First Senator"
      },
      "lines": [
        {
          "id": "timon-of-athens-5-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "No talk of Timon, nothing of him expect.",
          "plainText": "No talk of Timon nothing of him expect",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "The enemy's drum is heard, and fearful scouring",
          "plainText": "The enemy's drum is heard and fearful scouring",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Doth choke the air with dust. In, and prepare.",
          "plainText": "Doth choke the air with dust In and prepare",
          "lineType": "verse"
        },
        {
          "id": "timon-of-athens-5-3-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "Ours is the fall, I fear, our foe's the snare.",
          "plainText": "Ours is the fall I fear our foe's the snare",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "timon-of-athens-5-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}