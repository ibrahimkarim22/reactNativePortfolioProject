  "scene": {
    "id": "titus-andronicus-2-2",
    "act": 2,
    "scene": 2,
    "label": "Act 2, Scene 2",
    "title": "SCENE II. A Forest near Rome; a Lodge seen at a distance. Horns and cry of hounds heard",
    "location": "A Forest near Rome; a Lodge seen at a distance. Horns and cry of hounds heard",
    "orderInPlay": 3
  },
  "content": [
    {
      "id": "titus-andronicus-2-2-stage-001",
      "type": "stage",
      "text": "Enter Titus Andronicus and his three sons, and Marcus, making a noise with hounds and horns."
    },
    {
      "id": "titus-andronicus-2-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-2-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "The hunt is up, the morn is bright and grey,",
          "plainText": "The hunt is up the morn is bright and grey",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "The fields are fragrant, and the woods are green.",
          "plainText": "The fields are fragrant and the woods are green",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Uncouple here, and let us make a bay,",
          "plainText": "Uncouple here and let us make a bay",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "And wake the emperor and his lovely bride,",
          "plainText": "And wake the emperor and his lovely bride",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "And rouse the prince, and ring a hunter's peal,",
          "plainText": "And rouse the prince and ring a hunter's peal",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0006",
          "number": 6,
          "speechLineNumber": 6,
          "text": "That all the court may echo with the noise.",
          "plainText": "That all the court may echo with the noise",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0007",
          "number": 7,
          "speechLineNumber": 7,
          "text": "Sons, let it be your charge, as it is ours,",
          "plainText": "Sons let it be your charge as it is ours",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0008",
          "number": 8,
          "speechLineNumber": 8,
          "text": "To attend the emperor's person carefully.",
          "plainText": "To attend the emperor's person carefully",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0009",
          "number": 9,
          "speechLineNumber": 9,
          "text": "I have been troubled in my sleep this night,",
          "plainText": "I have been troubled in my sleep this night",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0010",
          "number": 10,
          "speechLineNumber": 10,
          "text": "But dawning day new comfort hath inspired.",
          "plainText": "But dawning day new comfort hath inspired",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-2-2-stage-002",
      "type": "stage",
      "text": "Here a cry of hounds, and wind horns in a peal. Then enter Saturninus, Tamora, Bassianus, Lavinia, Chiron, Demetrius, and their Attendants."
    },
    {
      "id": "titus-andronicus-2-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "saturninus",
        "name": "SATURNINUS",
        "displayName": "Saturninus"
      },
      "lines": [
        {
          "id": "titus-andronicus-2-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "And you have rung it lustily, my lords;",
          "plainText": "And you have rung it lustily my lords",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Somewhat too early for new-married ladies.",
          "plainText": "Somewhat too early for newmarried ladies",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-2-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "bassianus",
        "name": "BASSIANUS",
        "displayName": "Bassianus"
      },
      "lines": [
        {
          "id": "titus-andronicus-2-2-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Lavinia, how say you?",
          "plainText": "Lavinia how say you",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "titus-andronicus-2-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "lavinia",
        "name": "LAVINIA",
        "displayName": "Lavinia"
      },
      "lines": [
        {
          "id": "titus-andronicus-2-2-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "I say no;",
          "plainText": "I say no",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "I have been broad awake two hours and more.",
          "plainText": "I have been broad awake two hours and more",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-2-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "saturninus",
        "name": "SATURNINUS",
        "displayName": "Saturninus"
      },
      "lines": [
        {
          "id": "titus-andronicus-2-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Come on then; horse and chariots let us have,",
          "plainText": "Come on then horse and chariots let us have",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "And to our sport. [To Tamora.] Madam, now shall ye see",
          "plainText": "And to our sport To Tamora Madam now shall ye see",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "Our Roman hunting.",
          "plainText": "Our Roman hunting",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-2-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "marcus",
        "name": "MARCUS",
        "displayName": "Marcus"
      },
      "lines": [
        {
          "id": "titus-andronicus-2-2-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "I have dogs, my lord,",
          "plainText": "I have dogs my lord",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0020",
          "number": 20,
          "speechLineNumber": 2,
          "text": "Will rouse the proudest panther in the chase,",
          "plainText": "Will rouse the proudest panther in the chase",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0021",
          "number": 21,
          "speechLineNumber": 3,
          "text": "And climb the highest promontory top.",
          "plainText": "And climb the highest promontory top",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-2-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "titus",
        "name": "TITUS",
        "displayName": "Titus"
      },
      "lines": [
        {
          "id": "titus-andronicus-2-2-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "And I have horse will follow where the game",
          "plainText": "And I have horse will follow where the game",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "Makes way, and run like swallows o'er the plain.",
          "plainText": "Makes way and run like swallows o'er the plain",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-2-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "demetrius",
        "name": "DEMETRIUS",
        "displayName": "Demetrius"
      },
      "lines": [
        {
          "id": "titus-andronicus-2-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Chiron, we hunt not, we, with horse nor hound,",
          "plainText": "Chiron we hunt not we with horse nor hound",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "titus-andronicus-2-2-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "But hope to pluck a dainty doe to ground.",
          "plainText": "But hope to pluck a dainty doe to ground",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "titus-andronicus-2-2-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}