  "scene": {
    "id": "troilus-and-cressida-3-1",
    "act": 3,
    "scene": 1,
    "label": "Act 3, Scene 1",
    "title": "SCENE I. Troy. Priam's palace.",
    "location": "Troy. Priam's palace.",
    "orderInPlay": 7
  },
  "content": [
    {
      "id": "troilus-and-cressida-3-1-stage-001",
      "type": "stage",
      "text": "Music sounds within. Enter Pandarus and a Servant."
    },
    {
      "id": "troilus-and-cressida-3-1-speech-001",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Friend, you—pray you, a word. Do you not follow the young Lord Paris?",
          "plainText": "Friend youpray you a word Do you not follow the young Lord Paris",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-002",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Ay, sir, when he goes before me.",
          "plainText": "Ay sir when he goes before me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-003",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "You depend upon him, I mean?",
          "plainText": "You depend upon him I mean",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-004",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Sir, I do depend upon the Lord.",
          "plainText": "Sir I do depend upon the Lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-005",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "You depend upon a notable gentleman; I must needs praise him.",
          "plainText": "You depend upon a notable gentleman I must needs praise him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-006",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "The Lord be praised!",
          "plainText": "The Lord be praised",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-007",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "You know me, do you not?",
          "plainText": "You know me do you not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-008",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Faith, sir, superficially.",
          "plainText": "Faith sir superficially",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-009",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Friend, know me better: I am the Lord Pandarus.",
          "plainText": "Friend know me better I am the Lord Pandarus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-010",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "I hope I shall know your honour better.",
          "plainText": "I hope I shall know your honour better",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-011",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "I do desire it.",
          "plainText": "I do desire it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-012",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "You are in the state of grace?",
          "plainText": "You are in the state of grace",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-013",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Grace? Not so, friend; honour and lordship are my titles. What music is this?",
          "plainText": "Grace Not so friend honour and lordship are my titles What music is this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-014",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "I do but partly know, sir; it is music in parts.",
          "plainText": "I do but partly know sir it is music in parts",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-015",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Know you the musicians?",
          "plainText": "Know you the musicians",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-016",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Wholly, sir.",
          "plainText": "Wholly sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-017",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Who play they to?",
          "plainText": "Who play they to",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-018",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "To the hearers, sir.",
          "plainText": "To the hearers sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-019",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "At whose pleasure, friend?",
          "plainText": "At whose pleasure friend",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-020",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "At mine, sir, and theirs that love music.",
          "plainText": "At mine sir and theirs that love music",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-021",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Command, I mean, friend.",
          "plainText": "Command I mean friend",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-022",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Who shall I command, sir?",
          "plainText": "Who shall I command sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-023",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "Friend, we understand not one another: I am too courtly, and thou art too cunning. At whose request do these men play?",
          "plainText": "Friend we understand not one another I am too courtly and thou art too cunning At whose request do these men play",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-024",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "That's to't, indeed, sir. Marry, sir, at the request of Paris my lord, who is there in person; with him the mortal Venus, the heart-blood of beauty, love's invisible soul—",
          "plainText": "That's to't indeed sir Marry sir at the request of Paris my lord who is there in person with him the mortal Venus the heartblood of beauty love's invisible soul",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-025",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Who, my cousin, Cressida?",
          "plainText": "Who my cousin Cressida",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-026",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "No, sir, Helen. Could not you find out that by her attributes?",
          "plainText": "No sir Helen Could not you find out that by her attributes",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-027",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "It should seem, fellow, that thou hast not seen the Lady Cressida. I come to speak with Paris from the Prince Troilus; I will make a complimental assault upon him, for my business seethes.",
          "plainText": "It should seem fellow that thou hast not seen the Lady Cressida I come to speak with Paris from the Prince Troilus I will make a complimental assault upon him for my business seethes",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-028",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "Sodden business! There's a stew'd phrase indeed!",
          "plainText": "Sodden business There's a stew'd phrase indeed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-stage-002",
      "type": "stage",
      "text": "Enter Paris and Helen, attended."
    },
    {
      "id": "troilus-and-cressida-3-1-speech-029",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Fair be to you, my lord, and to all this fair company! Fair desires, in all fair measure, fairly guide them—especially to you, fair queen! Fair thoughts be your fair pillow.",
          "plainText": "Fair be to you my lord and to all this fair company Fair desires in all fair measure fairly guide themespecially to you fair queen Fair thoughts be your fair pillow",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-030",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Dear lord, you are full of fair words.",
          "plainText": "Dear lord you are full of fair words",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-031",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "You speak your fair pleasure, sweet queen. Fair prince, here is good broken music.",
          "plainText": "You speak your fair pleasure sweet queen Fair prince here is good broken music",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-032",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "You have broke it, cousin; and by my life, you shall make it whole again; you shall piece it out with a piece of your performance.",
          "plainText": "You have broke it cousin and by my life you shall make it whole again you shall piece it out with a piece of your performance",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-033",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "He is full of harmony.",
          "plainText": "He is full of harmony",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-034",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Truly, lady, no.",
          "plainText": "Truly lady no",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-035",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "O, sir—",
          "plainText": "O sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-036",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Rude, in sooth; in good sooth, very rude.",
          "plainText": "Rude in sooth in good sooth very rude",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-037",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Well said, my lord. Well, you say so in fits.",
          "plainText": "Well said my lord Well you say so in fits",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-038",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "I have business to my lord, dear queen. My lord, will you vouchsafe me a word?",
          "plainText": "I have business to my lord dear queen My lord will you vouchsafe me a word",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-039",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Nay, this shall not hedge us out. We'll hear you sing, certainly—",
          "plainText": "Nay this shall not hedge us out We'll hear you sing certainly",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-040",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Well sweet queen, you are pleasant with me. But, marry, thus, my lord: my dear lord and most esteemed friend, your brother Troilus—",
          "plainText": "Well sweet queen you are pleasant with me But marry thus my lord my dear lord and most esteemed friend your brother Troilus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-041",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "My Lord Pandarus, honey-sweet lord—",
          "plainText": "My Lord Pandarus honeysweet lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-042",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "Go to, sweet queen, go to—commends himself most affectionately to you—",
          "plainText": "Go to sweet queen go tocommends himself most affectionately to you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-043",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "You shall not bob us out of our melody. If you do, our melancholy upon your head!",
          "plainText": "You shall not bob us out of our melody If you do our melancholy upon your head",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-044",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Sweet queen, sweet queen; that's a sweet queen, i' faith.",
          "plainText": "Sweet queen sweet queen that's a sweet queen i' faith",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-045",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "And to make a sweet lady sad is a sour offence.",
          "plainText": "And to make a sweet lady sad is a sour offence",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-046",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Nay, that shall not serve your turn; that shall it not, in truth, la. Nay, I care not for such words; no, no.—And, my lord, he desires you that, if the King call for him at supper, you will make his excuse.",
          "plainText": "Nay that shall not serve your turn that shall it not in truth la Nay I care not for such words no noAnd my lord he desires you that if the King call for him at supper you will make his excuse",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-047",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "My Lord Pandarus!",
          "plainText": "My Lord Pandarus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-048",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "What says my sweet queen, my very very sweet queen?",
          "plainText": "What says my sweet queen my very very sweet queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-049",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "What exploit's in hand? Where sups he tonight?",
          "plainText": "What exploit's in hand Where sups he tonight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-050",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Nay, but, my lord—",
          "plainText": "Nay but my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-051",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "What says my sweet queen?—My cousin will fall out with you.",
          "plainText": "What says my sweet queenMy cousin will fall out with you",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-052",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "You must not know where he sups.",
          "plainText": "You must not know where he sups",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-053",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "I'll lay my life, with my disposer Cressida.",
          "plainText": "I'll lay my life with my disposer Cressida",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-054",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "No, no, no such matter; you are wide. Come, your disposer is sick.",
          "plainText": "No no no such matter you are wide Come your disposer is sick",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-055",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "Well, I'll make's excuse.",
          "plainText": "Well I'll make's excuse",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-056",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Ay, good my lord. Why should you say Cressida?",
          "plainText": "Ay good my lord Why should you say Cressida",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-3-1-line-0057",
          "number": 57,
          "speechLineNumber": 2,
          "text": "No, your poor disposer's sick.",
          "plainText": "No your poor disposer's sick",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-057",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "I spy.",
          "plainText": "I spy",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-058",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "You spy! What do you spy?—Come, give me an instrument. Now, sweet queen.",
          "plainText": "You spy What do you spyCome give me an instrument Now sweet queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-059",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "Why, this is kindly done.",
          "plainText": "Why this is kindly done",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-060",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "My niece is horribly in love with a thing you have, sweet queen.",
          "plainText": "My niece is horribly in love with a thing you have sweet queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-061",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "She shall have it, my lord, if it be not my Lord Paris.",
          "plainText": "She shall have it my lord if it be not my Lord Paris",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-062",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "He? No, she'll none of him; they two are twain.",
          "plainText": "He No she'll none of him they two are twain",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-063",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Falling in, after falling out, may make them three.",
          "plainText": "Falling in after falling out may make them three",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-064",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Come, come. I'll hear no more of this; I'll sing you a song now.",
          "plainText": "Come come I'll hear no more of this I'll sing you a song now",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-065",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Ay, ay, prithee now. By my troth, sweet lord, thou hast a fine forehead.",
          "plainText": "Ay ay prithee now By my troth sweet lord thou hast a fine forehead",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-066",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "Ay, you may, you may.",
          "plainText": "Ay you may you may",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-067",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Let thy song be love. This love will undo us all. O Cupid, Cupid, Cupid!",
          "plainText": "Let thy song be love This love will undo us all O Cupid Cupid Cupid",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-068",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Love! Ay, that it shall, i' faith.",
          "plainText": "Love Ay that it shall i' faith",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-069",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Ay, good now, love, love, nothing but love.",
          "plainText": "Ay good now love love nothing but love",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-070",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "In good troth, it begins so.",
          "plainText": "In good troth it begins so",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-stage-003",
      "type": "stage",
      "text": "[Sings.]"
    },
    {
      "id": "troilus-and-cressida-3-1-speech-071",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "In love, i' faith, to the very tip of the nose.",
          "plainText": "In love i' faith to the very tip of the nose",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-072",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "He eats nothing but doves, love; and that breeds hot blood, and hot blood begets hot thoughts, and hot thoughts beget hot deeds, and hot deeds is love.",
          "plainText": "He eats nothing but doves love and that breeds hot blood and hot blood begets hot thoughts and hot thoughts beget hot deeds and hot deeds is love",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-073",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Is this the generation of love: hot blood, hot thoughts, and hot deeds? Why, they are vipers. Is love a generation of vipers? Sweet lord, who's a-field today?",
          "plainText": "Is this the generation of love hot blood hot thoughts and hot deeds Why they are vipers Is love a generation of vipers Sweet lord who's afield today",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-074",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "Hector, Deiphobus, Helenus, Antenor, and all the gallantry of Troy. I would fain have arm'd today, but my Nell would not have it so. How chance my brother Troilus went not?",
          "plainText": "Hector Deiphobus Helenus Antenor and all the gallantry of Troy I would fain have arm'd today but my Nell would not have it so How chance my brother Troilus went not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-075",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "He hangs the lip at something. You know all, Lord Pandarus.",
          "plainText": "He hangs the lip at something You know all Lord Pandarus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-076",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "Not I, honey-sweet queen. I long to hear how they spend today. You'll remember your brother's excuse?",
          "plainText": "Not I honeysweet queen I long to hear how they spend today You'll remember your brother's excuse",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-077",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0078",
          "number": 78,
          "speechLineNumber": 1,
          "text": "To a hair.",
          "plainText": "To a hair",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-078",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0079",
          "number": 79,
          "speechLineNumber": 1,
          "text": "Farewell, sweet queen.",
          "plainText": "Farewell sweet queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-079",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0080",
          "number": 80,
          "speechLineNumber": 1,
          "text": "Commend me to your niece.",
          "plainText": "Commend me to your niece",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-080",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0081",
          "number": 81,
          "speechLineNumber": 1,
          "text": "I will, sweet queen.",
          "plainText": "I will sweet queen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-stage-004",
      "type": "stage",
      "text": "[Exit. Sound a retreat.]"
    },
    {
      "id": "troilus-and-cressida-3-1-speech-081",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0082",
          "number": 82,
          "speechLineNumber": 1,
          "text": "They're come from the field. Let us to Priam's hall",
          "plainText": "They're come from the field Let us to Priam's hall",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-3-1-line-0083",
          "number": 83,
          "speechLineNumber": 2,
          "text": "To greet the warriors. Sweet Helen, I must woo you",
          "plainText": "To greet the warriors Sweet Helen I must woo you",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-3-1-line-0084",
          "number": 84,
          "speechLineNumber": 3,
          "text": "To help unarm our Hector. His stubborn buckles,",
          "plainText": "To help unarm our Hector His stubborn buckles",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-3-1-line-0085",
          "number": 85,
          "speechLineNumber": 4,
          "text": "With these your white enchanting fingers touch'd,",
          "plainText": "With these your white enchanting fingers touch'd",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-3-1-line-0086",
          "number": 86,
          "speechLineNumber": 5,
          "text": "Shall more obey than to the edge of steel",
          "plainText": "Shall more obey than to the edge of steel",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-3-1-line-0087",
          "number": 87,
          "speechLineNumber": 6,
          "text": "Or force of Greekish sinews; you shall do more",
          "plainText": "Or force of Greekish sinews you shall do more",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-3-1-line-0088",
          "number": 88,
          "speechLineNumber": 7,
          "text": "Than all the island kings—disarm great Hector.",
          "plainText": "Than all the island kingsdisarm great Hector",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-082",
      "type": "speech",
      "speaker": {
        "id": "helen",
        "name": "HELEN",
        "displayName": "Helen"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0089",
          "number": 89,
          "speechLineNumber": 1,
          "text": "'Twill make us proud to be his servant, Paris;",
          "plainText": "'Twill make us proud to be his servant Paris",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-3-1-line-0090",
          "number": 90,
          "speechLineNumber": 2,
          "text": "Yea, what he shall receive of us in duty",
          "plainText": "Yea what he shall receive of us in duty",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-3-1-line-0091",
          "number": 91,
          "speechLineNumber": 3,
          "text": "Gives us more palm in beauty than we have,",
          "plainText": "Gives us more palm in beauty than we have",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-3-1-line-0092",
          "number": 92,
          "speechLineNumber": 4,
          "text": "Yea, overshines ourself.",
          "plainText": "Yea overshines ourself",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-speech-083",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-3-1-line-0093",
          "number": 93,
          "speechLineNumber": 1,
          "text": "Sweet, above thought I love thee.",
          "plainText": "Sweet above thought I love thee",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-3-1-stage-005",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}