  "scene": {
    "id": "troilus-and-cressida-4-2",
    "act": 4,
    "scene": 2,
    "label": "Act 4, Scene 2",
    "title": "SCENE II. Troy. The court of Pandarus' house.",
    "location": "Troy. The court of Pandarus' house.",
    "orderInPlay": 11
  },
  "content": [
    {
      "id": "troilus-and-cressida-4-2-stage-001",
      "type": "stage",
      "text": "Enter Troilus and Cressida."
    },
    {
      "id": "troilus-and-cressida-4-2-speech-001",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Dear, trouble not yourself; the morn is cold.",
          "plainText": "Dear trouble not yourself the morn is cold",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-002",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Then, sweet my lord, I'll call mine uncle down;",
          "plainText": "Then sweet my lord I'll call mine uncle down",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0003",
          "number": 3,
          "speechLineNumber": 2,
          "text": "He shall unbolt the gates.",
          "plainText": "He shall unbolt the gates",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-003",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Trouble him not;",
          "plainText": "Trouble him not",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "To bed, to bed! Sleep kill those pretty eyes,",
          "plainText": "To bed to bed Sleep kill those pretty eyes",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "And give as soft attachment to thy senses",
          "plainText": "And give as soft attachment to thy senses",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "As infants empty of all thought!",
          "plainText": "As infants empty of all thought",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-004",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Good morrow, then.",
          "plainText": "Good morrow then",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-005",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "I prithee now, to bed.",
          "plainText": "I prithee now to bed",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-006",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "Are you aweary of me?",
          "plainText": "Are you aweary of me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-007",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "O Cressida! but that the busy day,",
          "plainText": "O Cressida but that the busy day",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "Wak'd by the lark, hath rous'd the ribald crows,",
          "plainText": "Wak'd by the lark hath rous'd the ribald crows",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "And dreaming night will hide our joys no longer,",
          "plainText": "And dreaming night will hide our joys no longer",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0014",
          "number": 14,
          "speechLineNumber": 4,
          "text": "I would not from thee.",
          "plainText": "I would not from thee",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-008",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Night hath been too brief.",
          "plainText": "Night hath been too brief",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-009",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "Beshrew the witch! with venomous wights she stays",
          "plainText": "Beshrew the witch with venomous wights she stays",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "As tediously as hell, but flies the grasps of love",
          "plainText": "As tediously as hell but flies the grasps of love",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "With wings more momentary-swift than thought.",
          "plainText": "With wings more momentaryswift than thought",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "You will catch cold, and curse me.",
          "plainText": "You will catch cold and curse me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-010",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Prithee tarry.",
          "plainText": "Prithee tarry",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "You men will never tarry.",
          "plainText": "You men will never tarry",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "O foolish Cressid! I might have still held off,",
          "plainText": "O foolish Cressid I might have still held off",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "And then you would have tarried. Hark! there's one up.",
          "plainText": "And then you would have tarried Hark there's one up",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-011",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "[Within.] What's all the doors open here?",
          "plainText": "Within What's all the doors open here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-012",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "It is your uncle.",
          "plainText": "It is your uncle",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-stage-002",
      "type": "stage",
      "text": "Enter Pandarus."
    },
    {
      "id": "troilus-and-cressida-4-2-speech-013",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "A pestilence on him! Now will he be mocking.",
          "plainText": "A pestilence on him Now will he be mocking",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "I shall have such a life!",
          "plainText": "I shall have such a life",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-014",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "How now, how now! How go maidenheads?",
          "plainText": "How now how now How go maidenheads",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0029",
          "number": 29,
          "speechLineNumber": 2,
          "text": "Here, you maid! Where's my cousin Cressid?",
          "plainText": "Here you maid Where's my cousin Cressid",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-015",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Go hang yourself, you naughty mocking uncle.",
          "plainText": "Go hang yourself you naughty mocking uncle",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0031",
          "number": 31,
          "speechLineNumber": 2,
          "text": "You bring me to do, and then you flout me too.",
          "plainText": "You bring me to do and then you flout me too",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-016",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "To do what? to do what? Let her say what.",
          "plainText": "To do what to do what Let her say what",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "What have I brought you to do?",
          "plainText": "What have I brought you to do",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-017",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Come, come, beshrew your heart! You'll ne'er be good, nor suffer others.",
          "plainText": "Come come beshrew your heart You'll ne'er be good nor suffer others",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-018",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Ha, ha! Alas, poor wretch! Ah, poor capocchia! Hast not slept tonight? Would he not, a naughty man, let it sleep? A bugbear take him!",
          "plainText": "Ha ha Alas poor wretch Ah poor capocchia Hast not slept tonight Would he not a naughty man let it sleep A bugbear take him",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-019",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Did not I tell you? Would he were knock'd i' th' head!",
          "plainText": "Did not I tell you Would he were knock'd i' th' head",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-stage-003",
      "type": "stage",
      "text": "[One knocks.]"
    },
    {
      "id": "troilus-and-cressida-4-2-speech-020",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "Ha! ha!",
          "plainText": "Ha ha",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-021",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Come, you are deceiv'd, I think of no such thing.",
          "plainText": "Come you are deceiv'd I think of no such thing",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-stage-004",
      "type": "stage",
      "text": "[Knock.]"
    },
    {
      "id": "troilus-and-cressida-4-2-stage-005",
      "type": "stage",
      "text": "[Exeunt Troilus and Cressida.]"
    },
    {
      "id": "troilus-and-cressida-4-2-speech-022",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "Who's there? What's the matter? Will you beat down the door? How now? What's the matter?",
          "plainText": "Who's there What's the matter Will you beat down the door How now What's the matter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-stage-006",
      "type": "stage",
      "text": "Enter Aeneas."
    },
    {
      "id": "troilus-and-cressida-4-2-speech-023",
      "type": "speech",
      "speaker": {
        "id": "aeneas",
        "name": "AENEAS",
        "displayName": "Aeneas"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Good morrow, lord, good morrow.",
          "plainText": "Good morrow lord good morrow",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-024",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Who's there? My lord Aeneas? By my troth,",
          "plainText": "Who's there My lord Aeneas By my troth",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "I knew you not. What news with you so early?",
          "plainText": "I knew you not What news with you so early",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-025",
      "type": "speech",
      "speaker": {
        "id": "aeneas",
        "name": "AENEAS",
        "displayName": "Aeneas"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Is not Prince Troilus here?",
          "plainText": "Is not Prince Troilus here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-026",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Here! What should he do here?",
          "plainText": "Here What should he do here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-027",
      "type": "speech",
      "speaker": {
        "id": "aeneas",
        "name": "AENEAS",
        "displayName": "Aeneas"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Come, he is here, my lord; do not deny him.",
          "plainText": "Come he is here my lord do not deny him",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0046",
          "number": 46,
          "speechLineNumber": 2,
          "text": "It doth import him much to speak with me.",
          "plainText": "It doth import him much to speak with me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-028",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Is he here, say you? It's more than I know, I'll be sworn. For my own part, I came in late. What should he do here?",
          "plainText": "Is he here say you It's more than I know I'll be sworn For my own part I came in late What should he do here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-029",
      "type": "speech",
      "speaker": {
        "id": "aeneas",
        "name": "AENEAS",
        "displayName": "Aeneas"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Who, nay then! Come, come, you'll do him wrong ere you are ware; you'll be so true to him to be false to him. Do not you know of him, but yet go fetch him hither; go.",
          "plainText": "Who nay then Come come you'll do him wrong ere you are ware you'll be so true to him to be false to him Do not you know of him but yet go fetch him hither go",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-stage-007",
      "type": "stage",
      "text": "Re-enter Troilus."
    },
    {
      "id": "troilus-and-cressida-4-2-speech-030",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "How now! What's the matter?",
          "plainText": "How now What's the matter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-031",
      "type": "speech",
      "speaker": {
        "id": "aeneas",
        "name": "AENEAS",
        "displayName": "Aeneas"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "My lord, I scarce have leisure to salute you,",
          "plainText": "My lord I scarce have leisure to salute you",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0051",
          "number": 51,
          "speechLineNumber": 2,
          "text": "My matter is so rash. There is at hand",
          "plainText": "My matter is so rash There is at hand",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0052",
          "number": 52,
          "speechLineNumber": 3,
          "text": "Paris your brother, and Deiphobus,",
          "plainText": "Paris your brother and Deiphobus",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0053",
          "number": 53,
          "speechLineNumber": 4,
          "text": "The Grecian Diomed, and our Antenor",
          "plainText": "The Grecian Diomed and our Antenor",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0054",
          "number": 54,
          "speechLineNumber": 5,
          "text": "Deliver'd to us; and for him forthwith,",
          "plainText": "Deliver'd to us and for him forthwith",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0055",
          "number": 55,
          "speechLineNumber": 6,
          "text": "Ere the first sacrifice, within this hour,",
          "plainText": "Ere the first sacrifice within this hour",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0056",
          "number": 56,
          "speechLineNumber": 7,
          "text": "We must give up to Diomedes' hand",
          "plainText": "We must give up to Diomedes' hand",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0057",
          "number": 57,
          "speechLineNumber": 8,
          "text": "The Lady Cressida.",
          "plainText": "The Lady Cressida",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-032",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "Is it so concluded?",
          "plainText": "Is it so concluded",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-033",
      "type": "speech",
      "speaker": {
        "id": "aeneas",
        "name": "AENEAS",
        "displayName": "Aeneas"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "By Priam and the general state of Troy.",
          "plainText": "By Priam and the general state of Troy",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0060",
          "number": 60,
          "speechLineNumber": 2,
          "text": "They are at hand, and ready to effect it.",
          "plainText": "They are at hand and ready to effect it",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-034",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "How my achievements mock me!",
          "plainText": "How my achievements mock me",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0062",
          "number": 62,
          "speechLineNumber": 2,
          "text": "I will go meet them; and, my Lord Aeneas,",
          "plainText": "I will go meet them and my Lord Aeneas",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0063",
          "number": 63,
          "speechLineNumber": 3,
          "text": "We met by chance; you did not find me here.",
          "plainText": "We met by chance you did not find me here",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-035",
      "type": "speech",
      "speaker": {
        "id": "aeneas",
        "name": "AENEAS",
        "displayName": "Aeneas"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "Good, good, my lord, the secrets of neighbour Pandar",
          "plainText": "Good good my lord the secrets of neighbour Pandar",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0065",
          "number": 65,
          "speechLineNumber": 2,
          "text": "Have not more gift in taciturnity.",
          "plainText": "Have not more gift in taciturnity",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-stage-008",
      "type": "stage",
      "text": "[Exeunt Troilus and Aeneas.]"
    },
    {
      "id": "troilus-and-cressida-4-2-speech-036",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "Is't possible? No sooner got but lost? The devil take Antenor! The young prince will go mad. A plague upon Antenor! I would they had broke's neck.",
          "plainText": "Is't possible No sooner got but lost The devil take Antenor The young prince will go mad A plague upon Antenor I would they had broke's neck",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-stage-009",
      "type": "stage",
      "text": "Re-enter Cressida."
    },
    {
      "id": "troilus-and-cressida-4-2-speech-037",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0067",
          "number": 67,
          "speechLineNumber": 1,
          "text": "How now! What's the matter? Who was here?",
          "plainText": "How now What's the matter Who was here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-038",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0068",
          "number": 68,
          "speechLineNumber": 1,
          "text": "Ah, ah!",
          "plainText": "Ah ah",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-039",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0069",
          "number": 69,
          "speechLineNumber": 1,
          "text": "Why sigh you so profoundly? Where's my lord? Gone? Tell me, sweet uncle, what's the matter?",
          "plainText": "Why sigh you so profoundly Where's my lord Gone Tell me sweet uncle what's the matter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-040",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0070",
          "number": 70,
          "speechLineNumber": 1,
          "text": "Would I were as deep under the earth as I am above!",
          "plainText": "Would I were as deep under the earth as I am above",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-041",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0071",
          "number": 71,
          "speechLineNumber": 1,
          "text": "O the gods! What's the matter?",
          "plainText": "O the gods What's the matter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-042",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0072",
          "number": 72,
          "speechLineNumber": 1,
          "text": "Pray thee get thee in. Would thou hadst ne'er been born! I knew thou wouldst be his death! O, poor gentleman! A plague upon Antenor!",
          "plainText": "Pray thee get thee in Would thou hadst ne'er been born I knew thou wouldst be his death O poor gentleman A plague upon Antenor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-043",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0073",
          "number": 73,
          "speechLineNumber": 1,
          "text": "Good uncle, I beseech you, on my knees I beseech you, what's the matter?",
          "plainText": "Good uncle I beseech you on my knees I beseech you what's the matter",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-044",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0074",
          "number": 74,
          "speechLineNumber": 1,
          "text": "Thou must be gone, wench, thou must be gone; thou art chang'd for Antenor; thou must to thy father, and be gone from Troilus. 'Twill be his death; 'twill be his bane; he cannot bear it.",
          "plainText": "Thou must be gone wench thou must be gone thou art chang'd for Antenor thou must to thy father and be gone from Troilus 'Twill be his death 'twill be his bane he cannot bear it",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-045",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0075",
          "number": 75,
          "speechLineNumber": 1,
          "text": "O you immortal gods! I will not go.",
          "plainText": "O you immortal gods I will not go",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-046",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0076",
          "number": 76,
          "speechLineNumber": 1,
          "text": "Thou must.",
          "plainText": "Thou must",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-047",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0077",
          "number": 77,
          "speechLineNumber": 1,
          "text": "I will not, uncle. I have forgot my father;",
          "plainText": "I will not uncle I have forgot my father",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0078",
          "number": 78,
          "speechLineNumber": 2,
          "text": "I know no touch of consanguinity,",
          "plainText": "I know no touch of consanguinity",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0079",
          "number": 79,
          "speechLineNumber": 3,
          "text": "No kin, no love, no blood, no soul so near me",
          "plainText": "No kin no love no blood no soul so near me",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0080",
          "number": 80,
          "speechLineNumber": 4,
          "text": "As the sweet Troilus. O you gods divine,",
          "plainText": "As the sweet Troilus O you gods divine",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0081",
          "number": 81,
          "speechLineNumber": 5,
          "text": "Make Cressid's name the very crown of falsehood,",
          "plainText": "Make Cressid's name the very crown of falsehood",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0082",
          "number": 82,
          "speechLineNumber": 6,
          "text": "If ever she leave Troilus! Time, force, and death,",
          "plainText": "If ever she leave Troilus Time force and death",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0083",
          "number": 83,
          "speechLineNumber": 7,
          "text": "Do to this body what extremes you can,",
          "plainText": "Do to this body what extremes you can",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0084",
          "number": 84,
          "speechLineNumber": 8,
          "text": "But the strong base and building of my love",
          "plainText": "But the strong base and building of my love",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0085",
          "number": 85,
          "speechLineNumber": 9,
          "text": "Is as the very centre of the earth,",
          "plainText": "Is as the very centre of the earth",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0086",
          "number": 86,
          "speechLineNumber": 10,
          "text": "Drawing all things to it. I'll go in and weep—",
          "plainText": "Drawing all things to it I'll go in and weep",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-048",
      "type": "speech",
      "speaker": {
        "id": "pandarus",
        "name": "PANDARUS",
        "displayName": "Pandarus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0087",
          "number": 87,
          "speechLineNumber": 1,
          "text": "Do, do.",
          "plainText": "Do do",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-speech-049",
      "type": "speech",
      "speaker": {
        "id": "cressida",
        "name": "CRESSIDA",
        "displayName": "Cressida"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-2-line-0088",
          "number": 88,
          "speechLineNumber": 1,
          "text": "Tear my bright hair, and scratch my praised cheeks,",
          "plainText": "Tear my bright hair and scratch my praised cheeks",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0089",
          "number": 89,
          "speechLineNumber": 2,
          "text": "Crack my clear voice with sobs and break my heart,",
          "plainText": "Crack my clear voice with sobs and break my heart",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-2-line-0090",
          "number": 90,
          "speechLineNumber": 3,
          "text": "With sounding 'Troilus.' I will not go from Troy.",
          "plainText": "With sounding 'Troilus' I will not go from Troy",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-2-stage-010",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}