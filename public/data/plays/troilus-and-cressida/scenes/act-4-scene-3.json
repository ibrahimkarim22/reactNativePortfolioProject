  "scene": {
    "id": "troilus-and-cressida-4-3",
    "act": 4,
    "scene": 3,
    "label": "Act 4, Scene 3",
    "title": "SCENE III. Troy. A street before Pandarus' house.",
    "location": "Troy. A street before Pandarus' house.",
    "orderInPlay": 12
  },
  "content": [
    {
      "id": "troilus-and-cressida-4-3-stage-001",
      "type": "stage",
      "text": "Enter Paris, Troilus, Aeneas, Deiphobus, Antenor and Diomedes."
    },
    {
      "id": "troilus-and-cressida-4-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "It is great morning; and the hour prefix'd",
          "plainText": "It is great morning and the hour prefix'd",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "For her delivery to this valiant Greek",
          "plainText": "For her delivery to this valiant Greek",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Comes fast upon. Good my brother Troilus,",
          "plainText": "Comes fast upon Good my brother Troilus",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-3-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Tell you the lady what she is to do",
          "plainText": "Tell you the lady what she is to do",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-3-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "And haste her to the purpose.",
          "plainText": "And haste her to the purpose",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "Walk into her house.",
          "plainText": "Walk into her house",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-3-line-0007",
          "number": 7,
          "speechLineNumber": 2,
          "text": "I'll bring her to the Grecian presently;",
          "plainText": "I'll bring her to the Grecian presently",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-3-line-0008",
          "number": 8,
          "speechLineNumber": 3,
          "text": "And to his hand when I deliver her,",
          "plainText": "And to his hand when I deliver her",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-3-line-0009",
          "number": 9,
          "speechLineNumber": 4,
          "text": "Think it an altar, and thy brother Troilus",
          "plainText": "Think it an altar and thy brother Troilus",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-3-line-0010",
          "number": 10,
          "speechLineNumber": 5,
          "text": "A priest, there off'ring to it his own heart.",
          "plainText": "A priest there off'ring to it his own heart",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-3-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "troilus-and-cressida-4-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "paris",
        "name": "PARIS",
        "displayName": "Paris"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-4-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "I know what 'tis to love,",
          "plainText": "I know what 'tis to love",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-3-line-0012",
          "number": 12,
          "speechLineNumber": 2,
          "text": "And would, as I shall pity, I could help!",
          "plainText": "And would as I shall pity I could help",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-4-3-line-0013",
          "number": 13,
          "speechLineNumber": 3,
          "text": "Please you walk in, my lords?",
          "plainText": "Please you walk in my lords",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-4-3-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}