  },
  "scene": {
    "id": "troilus-and-cressida-5-5",
    "act": 5,
    "scene": 5,
    "label": "Act 5, Scene 5",
    "title": "SCENE V. Another part of the plain.",
    "location": "Another part of the plain.",
    "orderInPlay": 19
  },
  "content": [
    {
      "id": "troilus-and-cressida-5-5-stage-001",
      "type": "stage",
      "text": "Enter Diomedes and a Servant."
    },
    {
      "id": "troilus-and-cressida-5-5-speech-001",
      "type": "speech",
      "speaker": {
        "id": "diomedes",
        "name": "DIOMEDES",
        "displayName": "Diomedes"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-5-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Go, go, my servant, take thou Troilus' horse;",
          "plainText": "Go go my servant take thou Troilus' horse",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "Present the fair steed to my lady Cressid.",
          "plainText": "Present the fair steed to my lady Cressid",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "Fellow, commend my service to her beauty;",
          "plainText": "Fellow commend my service to her beauty",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0004",
          "number": 4,
          "speechLineNumber": 4,
          "text": "Tell her I have chastis'd the amorous Trojan,",
          "plainText": "Tell her I have chastis'd the amorous Trojan",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0005",
          "number": 5,
          "speechLineNumber": 5,
          "text": "And am her knight by proof.",
          "plainText": "And am her knight by proof",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-5-speech-002",
      "type": "speech",
      "speaker": {
        "id": "servant",
        "name": "SERVANT",
        "displayName": "Servant"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-5-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "I go, my lord.",
          "plainText": "I go my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-5-stage-002",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "troilus-and-cressida-5-5-stage-003",
      "type": "stage",
      "text": "Enter Agamemnon."
    },
    {
      "id": "troilus-and-cressida-5-5-speech-003",
      "type": "speech",
      "speaker": {
        "id": "agamemnon",
        "name": "AGAMEMNON",
        "displayName": "Agamemnon"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-5-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Renew, renew! The fierce Polydamas",
          "plainText": "Renew renew The fierce Polydamas",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Hath beat down Menon; bastard Margarelon",
          "plainText": "Hath beat down Menon bastard Margarelon",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "Hath Doreus prisoner,",
          "plainText": "Hath Doreus prisoner",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "And stands colossus-wise, waving his beam,",
          "plainText": "And stands colossuswise waving his beam",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "Upon the pashed corses of the kings",
          "plainText": "Upon the pashed corses of the kings",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "Epistrophus and Cedius. Polixenes is slain;",
          "plainText": "Epistrophus and Cedius Polixenes is slain",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0013",
          "number": 13,
          "speechLineNumber": 7,
          "text": "Amphimacus and Thoas deadly hurt;",
          "plainText": "Amphimacus and Thoas deadly hurt",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0014",
          "number": 14,
          "speechLineNumber": 8,
          "text": "Patroclus ta'en, or slain; and Palamedes",
          "plainText": "Patroclus ta'en or slain and Palamedes",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0015",
          "number": 15,
          "speechLineNumber": 9,
          "text": "Sore hurt and bruis'd. The dreadful Sagittary",
          "plainText": "Sore hurt and bruis'd The dreadful Sagittary",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0016",
          "number": 16,
          "speechLineNumber": 10,
          "text": "Appals our numbers. Haste we, Diomed,",
          "plainText": "Appals our numbers Haste we Diomed",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0017",
          "number": 17,
          "speechLineNumber": 11,
          "text": "To reinforcement, or we perish all.",
          "plainText": "To reinforcement or we perish all",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-5-stage-004",
      "type": "stage",
      "text": "Enter Nestor."
    },
    {
      "id": "troilus-and-cressida-5-5-speech-004",
      "type": "speech",
      "speaker": {
        "id": "nestor",
        "name": "NESTOR",
        "displayName": "Nestor"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-5-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Go, bear Patroclus' body to Achilles,",
          "plainText": "Go bear Patroclus' body to Achilles",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0019",
          "number": 19,
          "speechLineNumber": 2,
          "text": "And bid the snail-pac'd Ajax arm for shame.",
          "plainText": "And bid the snailpac'd Ajax arm for shame",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0020",
          "number": 20,
          "speechLineNumber": 3,
          "text": "There is a thousand Hectors in the field;",
          "plainText": "There is a thousand Hectors in the field",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0021",
          "number": 21,
          "speechLineNumber": 4,
          "text": "Now here he fights on Galathe his horse,",
          "plainText": "Now here he fights on Galathe his horse",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0022",
          "number": 22,
          "speechLineNumber": 5,
          "text": "And there lacks work; anon he's there afoot,",
          "plainText": "And there lacks work anon he's there afoot",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0023",
          "number": 23,
          "speechLineNumber": 6,
          "text": "And there they fly or die, like scaled sculls",
          "plainText": "And there they fly or die like scaled sculls",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0024",
          "number": 24,
          "speechLineNumber": 7,
          "text": "Before the belching whale; then is he yonder,",
          "plainText": "Before the belching whale then is he yonder",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0025",
          "number": 25,
          "speechLineNumber": 8,
          "text": "And there the strawy Greeks, ripe for his edge,",
          "plainText": "And there the strawy Greeks ripe for his edge",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0026",
          "number": 26,
          "speechLineNumber": 9,
          "text": "Fall down before him like the mower's swath.",
          "plainText": "Fall down before him like the mower's swath",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0027",
          "number": 27,
          "speechLineNumber": 10,
          "text": "Here, there, and everywhere, he leaves and takes;",
          "plainText": "Here there and everywhere he leaves and takes",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0028",
          "number": 28,
          "speechLineNumber": 11,
          "text": "Dexterity so obeying appetite",
          "plainText": "Dexterity so obeying appetite",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0029",
          "number": 29,
          "speechLineNumber": 12,
          "text": "That what he will he does, and does so much",
          "plainText": "That what he will he does and does so much",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0030",
          "number": 30,
          "speechLineNumber": 13,
          "text": "That proof is call'd impossibility.",
          "plainText": "That proof is call'd impossibility",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-5-stage-005",
      "type": "stage",
      "text": "Enter Ulysses."
    },
    {
      "id": "troilus-and-cressida-5-5-speech-005",
      "type": "speech",
      "speaker": {
        "id": "ulysses",
        "name": "ULYSSES",
        "displayName": "Ulysses"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-5-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "O, courage, courage, courage, Princes! Great Achilles",
          "plainText": "O courage courage courage Princes Great Achilles",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0032",
          "number": 32,
          "speechLineNumber": 2,
          "text": "Is arming, weeping, cursing, vowing vengeance.",
          "plainText": "Is arming weeping cursing vowing vengeance",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0033",
          "number": 33,
          "speechLineNumber": 3,
          "text": "Patroclus' wounds have rous'd his drowsy blood,",
          "plainText": "Patroclus' wounds have rous'd his drowsy blood",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0034",
          "number": 34,
          "speechLineNumber": 4,
          "text": "Together with his mangled Myrmidons,",
          "plainText": "Together with his mangled Myrmidons",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0035",
          "number": 35,
          "speechLineNumber": 5,
          "text": "That noseless, handless, hack'd and chipp'd, come to him,",
          "plainText": "That noseless handless hack'd and chipp'd come to him",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0036",
          "number": 36,
          "speechLineNumber": 6,
          "text": "Crying on Hector. Ajax hath lost a friend",
          "plainText": "Crying on Hector Ajax hath lost a friend",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0037",
          "number": 37,
          "speechLineNumber": 7,
          "text": "And foams at mouth, and he is arm'd and at it,",
          "plainText": "And foams at mouth and he is arm'd and at it",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0038",
          "number": 38,
          "speechLineNumber": 8,
          "text": "Roaring for Troilus; who hath done today",
          "plainText": "Roaring for Troilus who hath done today",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0039",
          "number": 39,
          "speechLineNumber": 9,
          "text": "Mad and fantastic execution,",
          "plainText": "Mad and fantastic execution",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0040",
          "number": 40,
          "speechLineNumber": 10,
          "text": "Engaging and redeeming of himself",
          "plainText": "Engaging and redeeming of himself",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0041",
          "number": 41,
          "speechLineNumber": 11,
          "text": "With such a careless force and forceless care",
          "plainText": "With such a careless force and forceless care",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0042",
          "number": 42,
          "speechLineNumber": 12,
          "text": "As if that lust, in very spite of cunning,",
          "plainText": "As if that lust in very spite of cunning",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0043",
          "number": 43,
          "speechLineNumber": 13,
          "text": "Bade him win all.",
          "plainText": "Bade him win all",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-5-stage-006",
      "type": "stage",
      "text": "Enter Ajax."
    },
    {
      "id": "troilus-and-cressida-5-5-speech-006",
      "type": "speech",
      "speaker": {
        "id": "ajax",
        "name": "AJAX",
        "displayName": "Ajax"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-5-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "Troilus! thou coward Troilus!",
          "plainText": "Troilus thou coward Troilus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-5-stage-007",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "troilus-and-cressida-5-5-speech-007",
      "type": "speech",
      "speaker": {
        "id": "diomedes",
        "name": "DIOMEDES",
        "displayName": "Diomedes"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-5-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "Ay, there, there.",
          "plainText": "Ay there there",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-5-speech-008",
      "type": "speech",
      "speaker": {
        "id": "nestor",
        "name": "NESTOR",
        "displayName": "Nestor"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-5-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "So, so, we draw together.",
          "plainText": "So so we draw together",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-5-stage-008",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "troilus-and-cressida-5-5-stage-009",
      "type": "stage",
      "text": "Enter Achilles."
    },
    {
      "id": "troilus-and-cressida-5-5-speech-009",
      "type": "speech",
      "speaker": {
        "id": "achilles",
        "name": "ACHILLES",
        "displayName": "Achilles"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-5-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Where is this Hector?",
          "plainText": "Where is this Hector",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "Come, come, thou boy-queller, show thy face;",
          "plainText": "Come come thou boyqueller show thy face",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0049",
          "number": 49,
          "speechLineNumber": 3,
          "text": "Know what it is to meet Achilles angry.",
          "plainText": "Know what it is to meet Achilles angry",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-5-line-0050",
          "number": 50,
          "speechLineNumber": 4,
          "text": "Hector! where's Hector? I will none but Hector.",
          "plainText": "Hector where's Hector I will none but Hector",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-5-stage-010",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}