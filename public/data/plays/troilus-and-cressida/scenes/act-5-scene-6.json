  "scene": {
    "id": "troilus-and-cressida-5-6",
    "act": 5,
    "scene": 6,
    "label": "Act 5, Scene 6",
    "title": "SCENE VI. Another part of the plain.",
    "location": "Another part of the plain.",
    "orderInPlay": 20
  },
  "content": [
    {
      "id": "troilus-and-cressida-5-6-stage-001",
      "type": "stage",
      "text": "Enter Ajax."
    },
    {
      "id": "troilus-and-cressida-5-6-speech-001",
      "type": "speech",
      "speaker": {
        "id": "ajax",
        "name": "AJAX",
        "displayName": "Ajax"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Troilus, thou coward Troilus, show thy head.",
          "plainText": "Troilus thou coward Troilus show thy head",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-stage-002",
      "type": "stage",
      "text": "Enter Diomedes."
    },
    {
      "id": "troilus-and-cressida-5-6-speech-002",
      "type": "speech",
      "speaker": {
        "id": "diomedes",
        "name": "DIOMEDES",
        "displayName": "Diomedes"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Troilus, I say! Where's Troilus?",
          "plainText": "Troilus I say Where's Troilus",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-speech-003",
      "type": "speech",
      "speaker": {
        "id": "ajax",
        "name": "AJAX",
        "displayName": "Ajax"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "What wouldst thou?",
          "plainText": "What wouldst thou",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-speech-004",
      "type": "speech",
      "speaker": {
        "id": "diomedes",
        "name": "DIOMEDES",
        "displayName": "Diomedes"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I would correct him.",
          "plainText": "I would correct him",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-speech-005",
      "type": "speech",
      "speaker": {
        "id": "ajax",
        "name": "AJAX",
        "displayName": "Ajax"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Were I the general, thou shouldst have my office",
          "plainText": "Were I the general thou shouldst have my office",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Ere that correction. Troilus, I say! What, Troilus!",
          "plainText": "Ere that correction Troilus I say What Troilus",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-stage-003",
      "type": "stage",
      "text": "Enter Troilus."
    },
    {
      "id": "troilus-and-cressida-5-6-speech-006",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "O traitor Diomed! Turn thy false face, thou traitor,",
          "plainText": "O traitor Diomed Turn thy false face thou traitor",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "And pay thy life thou owest me for my horse.",
          "plainText": "And pay thy life thou owest me for my horse",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-speech-007",
      "type": "speech",
      "speaker": {
        "id": "diomedes",
        "name": "DIOMEDES",
        "displayName": "Diomedes"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "Ha! art thou there?",
          "plainText": "Ha art thou there",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-speech-008",
      "type": "speech",
      "speaker": {
        "id": "ajax",
        "name": "AJAX",
        "displayName": "Ajax"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "I'll fight with him alone. Stand, Diomed.",
          "plainText": "I'll fight with him alone Stand Diomed",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-speech-009",
      "type": "speech",
      "speaker": {
        "id": "diomedes",
        "name": "DIOMEDES",
        "displayName": "Diomedes"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "He is my prize. I will not look upon.",
          "plainText": "He is my prize I will not look upon",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-speech-010",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Come, both, you cogging Greeks; have at you both!",
          "plainText": "Come both you cogging Greeks have at you both",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-stage-004",
      "type": "stage",
      "text": "[Exeunt fighting.]"
    },
    {
      "id": "troilus-and-cressida-5-6-stage-005",
      "type": "stage",
      "text": "Enter Hector."
    },
    {
      "id": "troilus-and-cressida-5-6-speech-011",
      "type": "speech",
      "speaker": {
        "id": "hector",
        "name": "HECTOR",
        "displayName": "Hector"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Yea, Troilus? O, well fought, my youngest brother!",
          "plainText": "Yea Troilus O well fought my youngest brother",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-stage-006",
      "type": "stage",
      "text": "Enter Achilles."
    },
    {
      "id": "troilus-and-cressida-5-6-speech-012",
      "type": "speech",
      "speaker": {
        "id": "achilles",
        "name": "ACHILLES",
        "displayName": "Achilles"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Now do I see thee. Ha! have at thee, Hector!",
          "plainText": "Now do I see thee Ha have at thee Hector",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-speech-013",
      "type": "speech",
      "speaker": {
        "id": "hector",
        "name": "HECTOR",
        "displayName": "Hector"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "Pause, if thou wilt.",
          "plainText": "Pause if thou wilt",
          "lineType": "prose",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "single-line speech block"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-speech-014",
      "type": "speech",
      "speaker": {
        "id": "achilles",
        "name": "ACHILLES",
        "displayName": "Achilles"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "I do disdain thy courtesy, proud Trojan.",
          "plainText": "I do disdain thy courtesy proud Trojan",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0017",
          "number": 17,
          "speechLineNumber": 2,
          "text": "Be happy that my arms are out of use;",
          "plainText": "Be happy that my arms are out of use",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0018",
          "number": 18,
          "speechLineNumber": 3,
          "text": "My rest and negligence befriend thee now,",
          "plainText": "My rest and negligence befriend thee now",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0019",
          "number": 19,
          "speechLineNumber": 4,
          "text": "But thou anon shalt hear of me again;",
          "plainText": "But thou anon shalt hear of me again",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0020",
          "number": 20,
          "speechLineNumber": 5,
          "text": "Till when, go seek thy fortune.",
          "plainText": "Till when go seek thy fortune",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-stage-007",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "troilus-and-cressida-5-6-speech-015",
      "type": "speech",
      "speaker": {
        "id": "hector",
        "name": "HECTOR",
        "displayName": "Hector"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Fare thee well.",
          "plainText": "Fare thee well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0022",
          "number": 22,
          "speechLineNumber": 2,
          "text": "I would have been much more a fresher man,",
          "plainText": "I would have been much more a fresher man",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0023",
          "number": 23,
          "speechLineNumber": 3,
          "text": "Had I expected thee.",
          "plainText": "Had I expected thee",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-stage-008",
      "type": "stage",
      "text": "Re-enter Troilus."
    },
    {
      "id": "troilus-and-cressida-5-6-speech-016",
      "type": "speech",
      "speaker": {
        "id": "troilus",
        "name": "TROILUS",
        "displayName": "Troilus"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "Ajax hath ta'en Aeneas. Shall it be?",
          "plainText": "Ajax hath ta'en Aeneas Shall it be",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0025",
          "number": 25,
          "speechLineNumber": 2,
          "text": "No, by the flame of yonder glorious heaven,",
          "plainText": "No by the flame of yonder glorious heaven",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0026",
          "number": 26,
          "speechLineNumber": 3,
          "text": "He shall not carry him; I'll be ta'en too,",
          "plainText": "He shall not carry him I'll be ta'en too",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0027",
          "number": 27,
          "speechLineNumber": 4,
          "text": "Or bring him off. Fate, hear me what I say:",
          "plainText": "Or bring him off Fate hear me what I say",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0028",
          "number": 28,
          "speechLineNumber": 5,
          "text": "I reck not though thou end my life today.",
          "plainText": "I reck not though thou end my life today",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-stage-009",
      "type": "stage",
      "text": "[Exit.]"
    },
    {
      "id": "troilus-and-cressida-5-6-stage-010",
      "type": "stage",
      "text": "Enter one in armour."
    },
    {
      "id": "troilus-and-cressida-5-6-speech-017",
      "type": "speech",
      "speaker": {
        "id": "hector",
        "name": "HECTOR",
        "displayName": "Hector"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-6-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "Stand, stand, thou Greek; thou art a goodly mark.",
          "plainText": "Stand stand thou Greek thou art a goodly mark",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0030",
          "number": 30,
          "speechLineNumber": 2,
          "text": "No? wilt thou not? I like thy armour well;",
          "plainText": "No wilt thou not I like thy armour well",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0031",
          "number": 31,
          "speechLineNumber": 3,
          "text": "I'll frush it and unlock the rivets all",
          "plainText": "I'll frush it and unlock the rivets all",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0032",
          "number": 32,
          "speechLineNumber": 4,
          "text": "But I'll be master of it. Wilt thou not, beast, abide?",
          "plainText": "But I'll be master of it Wilt thou not beast abide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        },
        {
          "id": "troilus-and-cressida-5-6-line-0033",
          "number": 33,
          "speechLineNumber": 5,
          "text": "Why then, fly on; I'll hunt thee for thy hide.",
          "plainText": "Why then fly on I'll hunt thee for thy hide",
          "lineType": "verse",
          "lineTypeDetection": "auto",
          "lineTypeConfidence": "medium",
          "lineTypeReason": "multiple short line breaks"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-6-stage-011",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}