    "id": "troilus-and-cressida-5-9",
    "act": 5,
    "scene": 9,
    "label": "Act 5, Scene 9",
    "title": "SCENE IX. Another part of the plain.",
    "location": "Another part of the plain.",
    "orderInPlay": 23
  },
  "content": [
    {
      "id": "troilus-and-cressida-5-9-stage-001",
      "type": "stage",
      "text": "Sound retreat. Shout. Enter Agamemnon, Ajax, Menelaus, Nestor, Diomedes and the rest, marching."
    },
    {
      "id": "troilus-and-cressida-5-9-speech-001",
      "type": "speech",
      "speaker": {
        "id": "agamemnon",
        "name": "AGAMEMNON",
        "displayName": "Agamemnon"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-9-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "Hark! hark! what shout is this?",
          "plainText": "Hark hark what shout is this",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-9-speech-002",
      "type": "speech",
      "speaker": {
        "id": "nestor",
        "name": "NESTOR",
        "displayName": "Nestor"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-9-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "Peace, drums!",
          "plainText": "Peace drums",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-9-speech-003",
      "type": "speech",
      "speaker": {
        "id": "soldiers",
        "name": "SOLDIERS",
        "displayName": "Soldiers"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-9-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "[Within.] Achilles! Achilles! Hector's slain. Achilles!",
          "plainText": "Within Achilles Achilles Hector's slain Achilles",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-9-speech-004",
      "type": "speech",
      "speaker": {
        "id": "diomedes",
        "name": "DIOMEDES",
        "displayName": "Diomedes"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-9-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "The bruit is, Hector's slain, and by Achilles.",
          "plainText": "The bruit is Hector's slain and by Achilles",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-9-speech-005",
      "type": "speech",
      "speaker": {
        "id": "ajax",
        "name": "AJAX",
        "displayName": "Ajax"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-9-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "If it be so, yet bragless let it be;",
          "plainText": "If it be so yet bragless let it be",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-9-line-0006",
          "number": 6,
          "speechLineNumber": 2,
          "text": "Great Hector was as good a man as he.",
          "plainText": "Great Hector was as good a man as he",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-9-speech-006",
      "type": "speech",
      "speaker": {
        "id": "agamemnon",
        "name": "AGAMEMNON",
        "displayName": "Agamemnon"
      },
      "lines": [
        {
          "id": "troilus-and-cressida-5-9-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "March patiently along. Let one be sent",
          "plainText": "March patiently along Let one be sent",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-9-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "To pray Achilles see us at our tent.",
          "plainText": "To pray Achilles see us at our tent",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-9-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "If in his death the gods have us befriended;",
          "plainText": "If in his death the gods have us befriended",
          "lineType": "verse"
        },
        {
          "id": "troilus-and-cressida-5-9-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "Great Troy is ours, and our sharp wars are ended.",
          "plainText": "Great Troy is ours and our sharp wars are ended",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "troilus-and-cressida-5-9-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}