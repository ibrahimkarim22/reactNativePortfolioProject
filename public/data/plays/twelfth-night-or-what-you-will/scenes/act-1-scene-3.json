  "scene": {
    "id": "twelfth-night-or-what-you-will-1-3",
    "act": 1,
    "scene": 3,
    "label": "Act 1, Scene 3",
    "title": "SCENE III. A Room in Olivia's House.",
    "location": "A Room in Olivia's House.",
    "orderInPlay": 3
  },
  "content": [
    {
      "id": "twelfth-night-or-what-you-will-1-3-stage-001",
      "type": "stage",
      "text": "Enter Sir Toby and Maria."
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "What a plague means my niece to take the death of her brother thus? I am sure care's an enemy to life.",
          "plainText": "What a plague means my niece to take the death of her brother thus I am sure care's an enemy to life",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "By my troth, Sir Toby, you must come in earlier o' nights; your cousin, my lady, takes great exceptions to your ill hours.",
          "plainText": "By my troth Sir Toby you must come in earlier o' nights your cousin my lady takes great exceptions to your ill hours",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "Why, let her except, before excepted.",
          "plainText": "Why let her except before excepted",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "Ay, but you must confine yourself within the modest limits of order.",
          "plainText": "Ay but you must confine yourself within the modest limits of order",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Confine? I'll confine myself no finer than I am. These clothes are good enough to drink in, and so be these boots too; and they be not, let them hang themselves in their own straps.",
          "plainText": "Confine I'll confine myself no finer than I am These clothes are good enough to drink in and so be these boots too and they be not let them hang themselves in their own straps",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "That quaffing and drinking will undo you: I heard my lady talk of it yesterday; and of a foolish knight that you brought in one night here to be her wooer.",
          "plainText": "That quaffing and drinking will undo you I heard my lady talk of it yesterday and of a foolish knight that you brought in one night here to be her wooer",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Who? Sir Andrew Aguecheek?",
          "plainText": "Who Sir Andrew Aguecheek",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0008",
          "number": 8,
          "speechLineNumber": 1,
          "text": "Ay, he.",
          "plainText": "Ay he",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0009",
          "number": 9,
          "speechLineNumber": 1,
          "text": "He's as tall a man as any's in Illyria.",
          "plainText": "He's as tall a man as any's in Illyria",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0010",
          "number": 10,
          "speechLineNumber": 1,
          "text": "What's that to th' purpose?",
          "plainText": "What's that to th' purpose",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0011",
          "number": 11,
          "speechLineNumber": 1,
          "text": "Why, he has three thousand ducats a year.",
          "plainText": "Why he has three thousand ducats a year",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0012",
          "number": 12,
          "speechLineNumber": 1,
          "text": "Ay, but he'll have but a year in all these ducats. He's a very fool, and a prodigal.",
          "plainText": "Ay but he'll have but a year in all these ducats He's a very fool and a prodigal",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0013",
          "number": 13,
          "speechLineNumber": 1,
          "text": "Fie, that you'll say so! he plays o' the viol-de-gamboys, and speaks three or four languages word for word without book, and hath all the good gifts of nature.",
          "plainText": "Fie that you'll say so he plays o' the violdegamboys and speaks three or four languages word for word without book and hath all the good gifts of nature",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "He hath indeed, almost natural: for, besides that he's a fool, he's a great quarreller; and, but that he hath the gift of a coward to allay the gust he hath in quarrelling, 'tis thought among the prudent he would quickly have the gift of a grave.",
          "plainText": "He hath indeed almost natural for besides that he's a fool he's a great quarreller and but that he hath the gift of a coward to allay the gust he hath in quarrelling 'tis thought among the prudent he would quickly have the gift of a grave",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0015",
          "number": 15,
          "speechLineNumber": 1,
          "text": "By this hand, they are scoundrels and substractors that say so of him. Who are they?",
          "plainText": "By this hand they are scoundrels and substractors that say so of him Who are they",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-016",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0016",
          "number": 16,
          "speechLineNumber": 1,
          "text": "They that add, moreover, he's drunk nightly in your company.",
          "plainText": "They that add moreover he's drunk nightly in your company",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-017",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "With drinking healths to my niece; I'll drink to her as long as there is a passage in my throat, and drink in Illyria. He's a coward and a coystril that will not drink to my niece till his brains turn o' the toe like a parish top. What, wench! Castiliano vulgo: for here comes Sir Andrew Agueface.",
          "plainText": "With drinking healths to my niece I'll drink to her as long as there is a passage in my throat and drink in Illyria He's a coward and a coystril that will not drink to my niece till his brains turn o' the toe like a parish top What wench Castiliano vulgo for here comes Sir Andrew Agueface",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-stage-002",
      "type": "stage",
      "text": "Enter Sir Andrew."
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-018",
      "type": "speech",
      "speaker": {
        "id": "aguecheek",
        "name": "AGUECHEEK",
        "displayName": "Aguecheek"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0018",
          "number": 18,
          "speechLineNumber": 1,
          "text": "Sir Toby Belch! How now, Sir Toby Belch?",
          "plainText": "Sir Toby Belch How now Sir Toby Belch",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-019",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Sweet Sir Andrew!",
          "plainText": "Sweet Sir Andrew",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-020",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "Bless you, fair shrew.",
          "plainText": "Bless you fair shrew",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-021",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "And you too, sir.",
          "plainText": "And you too sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-022",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "Accost, Sir Andrew, accost.",
          "plainText": "Accost Sir Andrew accost",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-023",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0023",
          "number": 23,
          "speechLineNumber": 1,
          "text": "What's that?",
          "plainText": "What's that",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-024",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0024",
          "number": 24,
          "speechLineNumber": 1,
          "text": "My niece's chamber-maid.",
          "plainText": "My niece's chambermaid",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-025",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "Good Mistress Accost, I desire better acquaintance.",
          "plainText": "Good Mistress Accost I desire better acquaintance",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-026",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "My name is Mary, sir.",
          "plainText": "My name is Mary sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-027",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0027",
          "number": 27,
          "speechLineNumber": 1,
          "text": "Good Mistress Mary Accost,—",
          "plainText": "Good Mistress Mary Accost",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-028",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0028",
          "number": 28,
          "speechLineNumber": 1,
          "text": "You mistake, knight: accost is front her, board her, woo her, assail her.",
          "plainText": "You mistake knight accost is front her board her woo her assail her",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-029",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0029",
          "number": 29,
          "speechLineNumber": 1,
          "text": "By my troth, I would not undertake her in this company. Is that the meaning of accost?",
          "plainText": "By my troth I would not undertake her in this company Is that the meaning of accost",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-030",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0030",
          "number": 30,
          "speechLineNumber": 1,
          "text": "Fare you well, gentlemen.",
          "plainText": "Fare you well gentlemen",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-031",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "And thou let part so, Sir Andrew, would thou mightst never draw sword again.",
          "plainText": "And thou let part so Sir Andrew would thou mightst never draw sword again",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-032",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "And you part so, mistress, I would I might never draw sword again. Fair lady, do you think you have fools in hand?",
          "plainText": "And you part so mistress I would I might never draw sword again Fair lady do you think you have fools in hand",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-033",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0033",
          "number": 33,
          "speechLineNumber": 1,
          "text": "Sir, I have not you by the hand.",
          "plainText": "Sir I have not you by the hand",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-034",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0034",
          "number": 34,
          "speechLineNumber": 1,
          "text": "Marry, but you shall have, and here's my hand.",
          "plainText": "Marry but you shall have and here's my hand",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-035",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0035",
          "number": 35,
          "speechLineNumber": 1,
          "text": "Now, sir, thought is free. I pray you, bring your hand to th' buttery bar and let it drink.",
          "plainText": "Now sir thought is free I pray you bring your hand to th' buttery bar and let it drink",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-036",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0036",
          "number": 36,
          "speechLineNumber": 1,
          "text": "Wherefore, sweetheart? What's your metaphor?",
          "plainText": "Wherefore sweetheart What's your metaphor",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-037",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0037",
          "number": 37,
          "speechLineNumber": 1,
          "text": "It's dry, sir.",
          "plainText": "It's dry sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-038",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "Why, I think so; I am not such an ass but I can keep my hand dry. But what's your jest?",
          "plainText": "Why I think so I am not such an ass but I can keep my hand dry But what's your jest",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-039",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0039",
          "number": 39,
          "speechLineNumber": 1,
          "text": "A dry jest, sir.",
          "plainText": "A dry jest sir",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-040",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Are you full of them?",
          "plainText": "Are you full of them",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-041",
      "type": "speech",
      "speaker": {
        "id": "maria",
        "name": "MARIA",
        "displayName": "Maria"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "Ay, sir, I have them at my fingers' ends: marry, now I let go your hand, I am barren.",
          "plainText": "Ay sir I have them at my fingers' ends marry now I let go your hand I am barren",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-stage-003",
      "type": "stage",
      "text": "[Exit Maria.]"
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-042",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0042",
          "number": 42,
          "speechLineNumber": 1,
          "text": "O knight, thou lack'st a cup of canary: When did I see thee so put down?",
          "plainText": "O knight thou lack'st a cup of canary When did I see thee so put down",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-043",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0043",
          "number": 43,
          "speechLineNumber": 1,
          "text": "Never in your life, I think, unless you see canary put me down. Methinks sometimes I have no more wit than a Christian or an ordinary man has; but I am a great eater of beef, and I believe that does harm to my wit.",
          "plainText": "Never in your life I think unless you see canary put me down Methinks sometimes I have no more wit than a Christian or an ordinary man has but I am a great eater of beef and I believe that does harm to my wit",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-044",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0044",
          "number": 44,
          "speechLineNumber": 1,
          "text": "No question.",
          "plainText": "No question",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-045",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0045",
          "number": 45,
          "speechLineNumber": 1,
          "text": "And I thought that, I'd forswear it. I'll ride home tomorrow, Sir Toby.",
          "plainText": "And I thought that I'd forswear it I'll ride home tomorrow Sir Toby",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-046",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Pourquoy, my dear knight?",
          "plainText": "Pourquoy my dear knight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-047",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "What is pourquoy? Do, or not do? I would I had bestowed that time in the tongues that I have in fencing, dancing, and bear-baiting. O, had I but followed the arts!",
          "plainText": "What is pourquoy Do or not do I would I had bestowed that time in the tongues that I have in fencing dancing and bearbaiting O had I but followed the arts",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-048",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0048",
          "number": 48,
          "speechLineNumber": 1,
          "text": "Then hadst thou had an excellent head of hair.",
          "plainText": "Then hadst thou had an excellent head of hair",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-049",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0049",
          "number": 49,
          "speechLineNumber": 1,
          "text": "Why, would that have mended my hair?",
          "plainText": "Why would that have mended my hair",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-050",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "Past question; for thou seest it will not curl by nature.",
          "plainText": "Past question for thou seest it will not curl by nature",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-051",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "But it becomes me well enough, does't not?",
          "plainText": "But it becomes me well enough does't not",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-052",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "Excellent, it hangs like flax on a distaff; and I hope to see a huswife take thee between her legs, and spin it off.",
          "plainText": "Excellent it hangs like flax on a distaff and I hope to see a huswife take thee between her legs and spin it off",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-053",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0053",
          "number": 53,
          "speechLineNumber": 1,
          "text": "Faith, I'll home tomorrow, Sir Toby; your niece will not be seen, or if she be, it's four to one she'll none of me; the Count himself here hard by woos her.",
          "plainText": "Faith I'll home tomorrow Sir Toby your niece will not be seen or if she be it's four to one she'll none of me the Count himself here hard by woos her",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-054",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0054",
          "number": 54,
          "speechLineNumber": 1,
          "text": "She'll none o' the Count; she'll not match above her degree, neither in estate, years, nor wit; I have heard her swear't. Tut, there's life in't, man.",
          "plainText": "She'll none o' the Count she'll not match above her degree neither in estate years nor wit I have heard her swear't Tut there's life in't man",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-055",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0055",
          "number": 55,
          "speechLineNumber": 1,
          "text": "I'll stay a month longer. I am a fellow o' the strangest mind i' the world; I delight in masques and revels sometimes altogether.",
          "plainText": "I'll stay a month longer I am a fellow o' the strangest mind i' the world I delight in masques and revels sometimes altogether",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-056",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0056",
          "number": 56,
          "speechLineNumber": 1,
          "text": "Art thou good at these kick-shawses, knight?",
          "plainText": "Art thou good at these kickshawses knight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-057",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0057",
          "number": 57,
          "speechLineNumber": 1,
          "text": "As any man in Illyria, whatsoever he be, under the degree of my betters; and yet I will not compare with an old man.",
          "plainText": "As any man in Illyria whatsoever he be under the degree of my betters and yet I will not compare with an old man",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-058",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0058",
          "number": 58,
          "speechLineNumber": 1,
          "text": "What is thy excellence in a galliard, knight?",
          "plainText": "What is thy excellence in a galliard knight",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-059",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0059",
          "number": 59,
          "speechLineNumber": 1,
          "text": "Faith, I can cut a caper.",
          "plainText": "Faith I can cut a caper",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-060",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0060",
          "number": 60,
          "speechLineNumber": 1,
          "text": "And I can cut the mutton to't.",
          "plainText": "And I can cut the mutton to't",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-061",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0061",
          "number": 61,
          "speechLineNumber": 1,
          "text": "And I think I have the back-trick simply as strong as any man in Illyria.",
          "plainText": "And I think I have the backtrick simply as strong as any man in Illyria",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-062",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0062",
          "number": 62,
          "speechLineNumber": 1,
          "text": "Wherefore are these things hid? Wherefore have these gifts a curtain before 'em? Are they like to take dust, like Mistress Mall's picture? Why dost thou not go to church in a galliard, and come home in a coranto? My very walk should be a jig; I would not so much as make water but in a sink-a-pace. What dost thou mean? Is it a world to hide virtues in? I did think, by the excellent constitution of thy leg, it was formed under the star of a galliard.",
          "plainText": "Wherefore are these things hid Wherefore have these gifts a curtain before 'em Are they like to take dust like Mistress Mall's picture Why dost thou not go to church in a galliard and come home in a coranto My very walk should be a jig I would not so much as make water but in a sinkapace What dost thou mean Is it a world to hide virtues in I did think by the excellent constitution of thy leg it was formed under the star of a galliard",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-063",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0063",
          "number": 63,
          "speechLineNumber": 1,
          "text": "Ay, 'tis strong, and it does indifferent well in a dam'd-colour'd stock. Shall we set about some revels?",
          "plainText": "Ay 'tis strong and it does indifferent well in a dam'dcolour'd stock Shall we set about some revels",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-064",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0064",
          "number": 64,
          "speechLineNumber": 1,
          "text": "What shall we do else? Were we not born under Taurus?",
          "plainText": "What shall we do else Were we not born under Taurus",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-065",
      "type": "speech",
      "speaker": {
        "id": "sir-andrew",
        "name": "SIR ANDREW",
        "displayName": "Sir Andrew"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0065",
          "number": 65,
          "speechLineNumber": 1,
          "text": "Taurus? That's sides and heart.",
          "plainText": "Taurus That's sides and heart",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-speech-066",
      "type": "speech",
      "speaker": {
        "id": "sir-toby",
        "name": "SIR TOBY",
        "displayName": "Sir Toby"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-3-line-0066",
          "number": 66,
          "speechLineNumber": 1,
          "text": "No, sir, it is legs and thighs. Let me see thee caper. Ha, higher: ha, ha, excellent!",
          "plainText": "No sir it is legs and thighs Let me see thee caper Ha higher ha ha excellent",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-3-stage-004",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}