{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "twelfth-night-or-what-you-will",
    "title": "Twelfth Night; or, What You Will",
    "author": "William Shakespeare",
    "genre": "Comedy"
  },
  "source": {
    "name": "Project Gutenberg",
    "ebookNumber": 100,
    "rights": "Public domain in the USA",
    "sourceFile": "pg100-images.html"
  },
  "scene": {
    "id": "twelfth-night-or-what-you-will-1-4",
    "act": 1,
    "scene": 4,
    "label": "Act 1, Scene 4",
    "title": "SCENE IV. A Room in the Duke's Palace.",
    "location": "A Room in the Duke's Palace.",
    "orderInPlay": 4
  },
  "content": [
    {
      "id": "twelfth-night-or-what-you-will-1-4-stage-001",
      "type": "stage",
      "text": "Enter Valentine and Viola in man's attire."
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-001",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "If the duke continue these favours towards you, Cesario, you are like to be much advanced; he hath known you but three days, and already you are no stranger.",
          "plainText": "If the duke continue these favours towards you Cesario you are like to be much advanced he hath known you but three days and already you are no stranger",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-002",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0002",
          "number": 2,
          "speechLineNumber": 1,
          "text": "You either fear his humour or my negligence, that you call in question the continuance of his love. Is he inconstant, sir, in his favours?",
          "plainText": "You either fear his humour or my negligence that you call in question the continuance of his love Is he inconstant sir in his favours",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-003",
      "type": "speech",
      "speaker": {
        "id": "valentine",
        "name": "VALENTINE",
        "displayName": "Valentine"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0003",
          "number": 3,
          "speechLineNumber": 1,
          "text": "No, believe me.",
          "plainText": "No believe me",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-stage-002",
      "type": "stage",
      "text": "Enter Duke, Curio and Attendants."
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-004",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I thank you. Here comes the Count.",
          "plainText": "I thank you Here comes the Count",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-005",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0005",
          "number": 5,
          "speechLineNumber": 1,
          "text": "Who saw Cesario, ho?",
          "plainText": "Who saw Cesario ho",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-006",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0006",
          "number": 6,
          "speechLineNumber": 1,
          "text": "On your attendance, my lord, here.",
          "plainText": "On your attendance my lord here",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-007",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0007",
          "number": 7,
          "speechLineNumber": 1,
          "text": "Stand you awhile aloof.—Cesario,",
          "plainText": "Stand you awhile aloofCesario",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0008",
          "number": 8,
          "speechLineNumber": 2,
          "text": "Thou know'st no less but all; I have unclasp'd",
          "plainText": "Thou know'st no less but all I have unclasp'd",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0009",
          "number": 9,
          "speechLineNumber": 3,
          "text": "To thee the book even of my secret soul.",
          "plainText": "To thee the book even of my secret soul",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0010",
          "number": 10,
          "speechLineNumber": 4,
          "text": "Therefore, good youth, address thy gait unto her,",
          "plainText": "Therefore good youth address thy gait unto her",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0011",
          "number": 11,
          "speechLineNumber": 5,
          "text": "Be not denied access, stand at her doors,",
          "plainText": "Be not denied access stand at her doors",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0012",
          "number": 12,
          "speechLineNumber": 6,
          "text": "And tell them, there thy fixed foot shall grow",
          "plainText": "And tell them there thy fixed foot shall grow",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0013",
          "number": 13,
          "speechLineNumber": 7,
          "text": "Till thou have audience.",
          "plainText": "Till thou have audience",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-008",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "Sure, my noble lord,",
          "plainText": "Sure my noble lord",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "If she be so abandon'd to her sorrow",
          "plainText": "If she be so abandon'd to her sorrow",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "As it is spoke, she never will admit me.",
          "plainText": "As it is spoke she never will admit me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-009",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0017",
          "number": 17,
          "speechLineNumber": 1,
          "text": "Be clamorous and leap all civil bounds,",
          "plainText": "Be clamorous and leap all civil bounds",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0018",
          "number": 18,
          "speechLineNumber": 2,
          "text": "Rather than make unprofited return.",
          "plainText": "Rather than make unprofited return",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-010",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0019",
          "number": 19,
          "speechLineNumber": 1,
          "text": "Say I do speak with her, my lord, what then?",
          "plainText": "Say I do speak with her my lord what then",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-011",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0020",
          "number": 20,
          "speechLineNumber": 1,
          "text": "O then unfold the passion of my love,",
          "plainText": "O then unfold the passion of my love",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0021",
          "number": 21,
          "speechLineNumber": 2,
          "text": "Surprise her with discourse of my dear faith;",
          "plainText": "Surprise her with discourse of my dear faith",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0022",
          "number": 22,
          "speechLineNumber": 3,
          "text": "It shall become thee well to act my woes;",
          "plainText": "It shall become thee well to act my woes",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0023",
          "number": 23,
          "speechLineNumber": 4,
          "text": "She will attend it better in thy youth,",
          "plainText": "She will attend it better in thy youth",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0024",
          "number": 24,
          "speechLineNumber": 5,
          "text": "Than in a nuncio's of more grave aspect.",
          "plainText": "Than in a nuncio's of more grave aspect",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-012",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0025",
          "number": 25,
          "speechLineNumber": 1,
          "text": "I think not so, my lord.",
          "plainText": "I think not so my lord",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-013",
      "type": "speech",
      "speaker": {
        "id": "duke",
        "name": "DUKE",
        "displayName": "Duke"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Dear lad, believe it;",
          "plainText": "Dear lad believe it",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "For they shall yet belie thy happy years,",
          "plainText": "For they shall yet belie thy happy years",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "That say thou art a man: Diana's lip",
          "plainText": "That say thou art a man Diana's lip",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "Is not more smooth and rubious; thy small pipe",
          "plainText": "Is not more smooth and rubious thy small pipe",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0030",
          "number": 30,
          "speechLineNumber": 5,
          "text": "Is as the maiden's organ, shrill and sound,",
          "plainText": "Is as the maiden's organ shrill and sound",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0031",
          "number": 31,
          "speechLineNumber": 6,
          "text": "And all is semblative a woman's part.",
          "plainText": "And all is semblative a woman's part",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0032",
          "number": 32,
          "speechLineNumber": 7,
          "text": "I know thy constellation is right apt",
          "plainText": "I know thy constellation is right apt",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0033",
          "number": 33,
          "speechLineNumber": 8,
          "text": "For this affair. Some four or five attend him:",
          "plainText": "For this affair Some four or five attend him",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0034",
          "number": 34,
          "speechLineNumber": 9,
          "text": "All, if you will; for I myself am best",
          "plainText": "All if you will for I myself am best",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0035",
          "number": 35,
          "speechLineNumber": 10,
          "text": "When least in company. Prosper well in this,",
          "plainText": "When least in company Prosper well in this",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0036",
          "number": 36,
          "speechLineNumber": 11,
          "text": "And thou shalt live as freely as thy lord,",
          "plainText": "And thou shalt live as freely as thy lord",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0037",
          "number": 37,
          "speechLineNumber": 12,
          "text": "To call his fortunes thine.",
          "plainText": "To call his fortunes thine",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-speech-014",
      "type": "speech",
      "speaker": {
        "id": "viola",
        "name": "VIOLA",
        "displayName": "Viola"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0038",
          "number": 38,
          "speechLineNumber": 1,
          "text": "I'll do my best",
          "plainText": "I'll do my best",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0039",
          "number": 39,
          "speechLineNumber": 2,
          "text": "To woo your lady. [Aside.] Yet, a barful strife!",
          "plainText": "To woo your lady Aside Yet a barful strife",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-1-4-line-0040",
          "number": 40,
          "speechLineNumber": 3,
          "text": "Whoe'er I woo, myself would be his wife.",
          "plainText": "Whoe'er I woo myself would be his wife",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-1-4-stage-003",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}