{
  "schemaVersion": "1.0.0",
  "work": {
    "id": "twelfth-night-or-what-you-will",
    "title": "Twelfth Night; Or, What You Will",
    "author": "William Shakespeare",
    "genre": "Comedy"
  },
  "source": {
    "name": "Project Gutenberg",
    "ebookNumber": 100,
    "rights": "Public domain in the USA",
    "sourceFile": "pg100-images.html"
  },
  "scene": {
    "id": "twelfth-night-or-what-you-will-3-3",
    "act": 3,
    "scene": 3,
    "label": "Act 3, Scene 3",
    "title": "SCENE III. A street.",
    "location": "A street.",
    "orderInPlay": 13
  },
  "content": [
    {
      "id": "twelfth-night-or-what-you-will-3-3-stage-001",
      "type": "stage",
      "text": "Enter Sebastian and Antonio."
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-001",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0001",
          "number": 1,
          "speechLineNumber": 1,
          "text": "I would not by my will have troubled you,",
          "plainText": "I would not by my will have troubled you",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0002",
          "number": 2,
          "speechLineNumber": 2,
          "text": "But since you make your pleasure of your pains,",
          "plainText": "But since you make your pleasure of your pains",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0003",
          "number": 3,
          "speechLineNumber": 3,
          "text": "I will no further chide you.",
          "plainText": "I will no further chide you",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-002",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0004",
          "number": 4,
          "speechLineNumber": 1,
          "text": "I could not stay behind you: my desire,",
          "plainText": "I could not stay behind you my desire",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0005",
          "number": 5,
          "speechLineNumber": 2,
          "text": "More sharp than filed steel, did spur me forth;",
          "plainText": "More sharp than filed steel did spur me forth",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0006",
          "number": 6,
          "speechLineNumber": 3,
          "text": "And not all love to see you, though so much,",
          "plainText": "And not all love to see you though so much",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0007",
          "number": 7,
          "speechLineNumber": 4,
          "text": "As might have drawn one to a longer voyage,",
          "plainText": "As might have drawn one to a longer voyage",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0008",
          "number": 8,
          "speechLineNumber": 5,
          "text": "But jealousy what might befall your travel,",
          "plainText": "But jealousy what might befall your travel",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0009",
          "number": 9,
          "speechLineNumber": 6,
          "text": "Being skilless in these parts; which to a stranger,",
          "plainText": "Being skilless in these parts which to a stranger",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0010",
          "number": 10,
          "speechLineNumber": 7,
          "text": "Unguided and unfriended, often prove",
          "plainText": "Unguided and unfriended often prove",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0011",
          "number": 11,
          "speechLineNumber": 8,
          "text": "Rough and unhospitable. My willing love,",
          "plainText": "Rough and unhospitable My willing love",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0012",
          "number": 12,
          "speechLineNumber": 9,
          "text": "The rather by these arguments of fear,",
          "plainText": "The rather by these arguments of fear",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0013",
          "number": 13,
          "speechLineNumber": 10,
          "text": "Set forth in your pursuit.",
          "plainText": "Set forth in your pursuit",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-003",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0014",
          "number": 14,
          "speechLineNumber": 1,
          "text": "My kind Antonio,",
          "plainText": "My kind Antonio",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0015",
          "number": 15,
          "speechLineNumber": 2,
          "text": "I can no other answer make but thanks,",
          "plainText": "I can no other answer make but thanks",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0016",
          "number": 16,
          "speechLineNumber": 3,
          "text": "And thanks, and ever thanks; and oft good turns",
          "plainText": "And thanks and ever thanks and oft good turns",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0017",
          "number": 17,
          "speechLineNumber": 4,
          "text": "Are shuffled off with such uncurrent pay.",
          "plainText": "Are shuffled off with such uncurrent pay",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0018",
          "number": 18,
          "speechLineNumber": 5,
          "text": "But were my worth, as is my conscience, firm,",
          "plainText": "But were my worth as is my conscience firm",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0019",
          "number": 19,
          "speechLineNumber": 6,
          "text": "You should find better dealing. What's to do?",
          "plainText": "You should find better dealing What's to do",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0020",
          "number": 20,
          "speechLineNumber": 7,
          "text": "Shall we go see the relics of this town?",
          "plainText": "Shall we go see the relics of this town",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-004",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0021",
          "number": 21,
          "speechLineNumber": 1,
          "text": "Tomorrow, sir; best first go see your lodging.",
          "plainText": "Tomorrow sir best first go see your lodging",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-005",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0022",
          "number": 22,
          "speechLineNumber": 1,
          "text": "I am not weary, and 'tis long to night;",
          "plainText": "I am not weary and 'tis long to night",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0023",
          "number": 23,
          "speechLineNumber": 2,
          "text": "I pray you, let us satisfy our eyes",
          "plainText": "I pray you let us satisfy our eyes",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0024",
          "number": 24,
          "speechLineNumber": 3,
          "text": "With the memorials and the things of fame",
          "plainText": "With the memorials and the things of fame",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0025",
          "number": 25,
          "speechLineNumber": 4,
          "text": "That do renown this city.",
          "plainText": "That do renown this city",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-006",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0026",
          "number": 26,
          "speechLineNumber": 1,
          "text": "Would you'd pardon me.",
          "plainText": "Would you'd pardon me",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0027",
          "number": 27,
          "speechLineNumber": 2,
          "text": "I do not without danger walk these streets.",
          "plainText": "I do not without danger walk these streets",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0028",
          "number": 28,
          "speechLineNumber": 3,
          "text": "Once in a sea-fight, 'gainst the Count his galleys,",
          "plainText": "Once in a seafight 'gainst the Count his galleys",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0029",
          "number": 29,
          "speechLineNumber": 4,
          "text": "I did some service, of such note indeed,",
          "plainText": "I did some service of such note indeed",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0030",
          "number": 30,
          "speechLineNumber": 5,
          "text": "That were I ta'en here, it would scarce be answer'd.",
          "plainText": "That were I ta'en here it would scarce be answer'd",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-007",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0031",
          "number": 31,
          "speechLineNumber": 1,
          "text": "Belike you slew great number of his people.",
          "plainText": "Belike you slew great number of his people",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-008",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0032",
          "number": 32,
          "speechLineNumber": 1,
          "text": "Th' offence is not of such a bloody nature,",
          "plainText": "Th' offence is not of such a bloody nature",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0033",
          "number": 33,
          "speechLineNumber": 2,
          "text": "Albeit the quality of the time and quarrel",
          "plainText": "Albeit the quality of the time and quarrel",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0034",
          "number": 34,
          "speechLineNumber": 3,
          "text": "Might well have given us bloody argument.",
          "plainText": "Might well have given us bloody argument",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0035",
          "number": 35,
          "speechLineNumber": 4,
          "text": "It might have since been answered in repaying",
          "plainText": "It might have since been answered in repaying",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0036",
          "number": 36,
          "speechLineNumber": 5,
          "text": "What we took from them, which for traffic's sake,",
          "plainText": "What we took from them which for traffic's sake",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0037",
          "number": 37,
          "speechLineNumber": 6,
          "text": "Most of our city did. Only myself stood out,",
          "plainText": "Most of our city did Only myself stood out",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0038",
          "number": 38,
          "speechLineNumber": 7,
          "text": "For which, if I be lapsed in this place,",
          "plainText": "For which if I be lapsed in this place",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0039",
          "number": 39,
          "speechLineNumber": 8,
          "text": "I shall pay dear.",
          "plainText": "I shall pay dear",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-009",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0040",
          "number": 40,
          "speechLineNumber": 1,
          "text": "Do not then walk too open.",
          "plainText": "Do not then walk too open",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-010",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0041",
          "number": 41,
          "speechLineNumber": 1,
          "text": "It doth not fit me. Hold, sir, here's my purse.",
          "plainText": "It doth not fit me Hold sir here's my purse",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0042",
          "number": 42,
          "speechLineNumber": 2,
          "text": "In the south suburbs, at the Elephant,",
          "plainText": "In the south suburbs at the Elephant",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0043",
          "number": 43,
          "speechLineNumber": 3,
          "text": "Is best to lodge. I will bespeak our diet",
          "plainText": "Is best to lodge I will bespeak our diet",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0044",
          "number": 44,
          "speechLineNumber": 4,
          "text": "Whiles you beguile the time and feed your knowledge",
          "plainText": "Whiles you beguile the time and feed your knowledge",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0045",
          "number": 45,
          "speechLineNumber": 5,
          "text": "With viewing of the town. There shall you have me.",
          "plainText": "With viewing of the town There shall you have me",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-011",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0046",
          "number": 46,
          "speechLineNumber": 1,
          "text": "Why I your purse?",
          "plainText": "Why I your purse",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-012",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0047",
          "number": 47,
          "speechLineNumber": 1,
          "text": "Haply your eye shall light upon some toy",
          "plainText": "Haply your eye shall light upon some toy",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0048",
          "number": 48,
          "speechLineNumber": 2,
          "text": "You have desire to purchase; and your store,",
          "plainText": "You have desire to purchase and your store",
          "lineType": "verse"
        },
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0049",
          "number": 49,
          "speechLineNumber": 3,
          "text": "I think, is not for idle markets, sir.",
          "plainText": "I think is not for idle markets sir",
          "lineType": "verse"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-013",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0050",
          "number": 50,
          "speechLineNumber": 1,
          "text": "I'll be your purse-bearer, and leave you for an hour.",
          "plainText": "I'll be your pursebearer and leave you for an hour",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-014",
      "type": "speech",
      "speaker": {
        "id": "antonio",
        "name": "ANTONIO",
        "displayName": "Antonio"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0051",
          "number": 51,
          "speechLineNumber": 1,
          "text": "To th' Elephant.",
          "plainText": "To th' Elephant",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-speech-015",
      "type": "speech",
      "speaker": {
        "id": "sebastian",
        "name": "SEBASTIAN",
        "displayName": "Sebastian"
      },
      "lines": [
        {
          "id": "twelfth-night-or-what-you-will-3-3-line-0052",
          "number": 52,
          "speechLineNumber": 1,
          "text": "I do remember.",
          "plainText": "I do remember",
          "lineType": "prose"
        }
      ]
    },
    {
      "id": "twelfth-night-or-what-you-will-3-3-stage-002",
      "type": "stage",
      "text": "[Exeunt.]"
    }
  ]
}